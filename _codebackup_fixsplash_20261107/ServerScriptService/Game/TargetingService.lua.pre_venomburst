-- HELPERS
--------------------------------------------------

local function getMovementRange(unit)
	-- One shared calculation (StatCalcService, 2026-10-28): base + race + armor (incl. situational
	-- FT-011 / FT-012) + trait + status + imposed penalty, min 1. The Info panels call the same
	-- function, so the panel value and the reachable tiles cannot disagree.
	return StatCalcService.GetMovementRange(unit, "battle")
end

local function getJump(unit)
	-- One shared calculation (StatCalcService, 2026-10-28): base + race + armor + status + trait.
	return StatCalcService.GetJump(unit, "battle")
end

local function getDownwardJump(unit)
	-- HALFLING — Nimble Steps (races row 'Halfling', 2026-10-02): Jump -1 when moving
	-- to a lower elevation. Only the voluntary-move BFS uses this (forced
	-- displacement never reads it), so it is voluntary downward movement only.
	return math.max(0, getJump(unit) + 2 + RacePassiveService.GetDownwardJumpModifier(unit))
end

local function buildOccupancyMap(units)
	local map = {}
	for _, unit in ipairs(units) do
		if unit.isAlive then
			local key = unit.tileX .. "," .. unit.tileY
			map[key] = unit
		end
	end
	return map
end

local function tileKey(x, y)
	return x .. "," .. y
end

local function isInsideMap(x, y, mapWidth, mapHeight)
	return x >= 1 and x <= mapWidth
		and y >= 1 and y <= mapHeight
end

local function chebyshevDistance(ax, ay, bx, by)
	return math.max(math.abs(ax - bx), math.abs(ay - by))
end

-- DIAGONAL CORNER-CUTTING (strict, user decision 2026-10-11): a diagonal step is
-- blocked only when BOTH orthogonal corner tiles it passes between are corner-blockers.
-- A corner-blocker is a solid wall/object (IsBlocked) OR a standing unit NOT on the
-- actor's side (enemies/neutrals). Allies NEVER seal a corner (consistent with LoS id 38).
-- Impassable terrain (e.g. Quicksand) is deliberately NOT a corner-blocker: Quicksand is
-- deadly-but-enterable terrain by design, not a wall. Occupancy is prebuilt by the caller.
local function isCornerBlocker(x, y, occupancy, actor)
	if GameConstants.IsBlocked(x, y) then
		return true
	end
	local occupant = occupancy[x .. "," .. y]
	if occupant ~= nil and occupant ~= actor and occupant.side ~= actor.side then
		return true
	end
	return false
end

-- RABBIT FOLK — Hop Step gap tile: a deliberate chasm / gap floor (Slice 5
-- CHASM_FLOOR_MAP). Blockers (walls / objects) are NOT gaps — a hop never clears
-- a wall. UPDATED 2026-10-11: Quicksand is no longer a hop gap — it is now passable
-- deadly terrain (walk onto it and sink), so only true depth-based chasm floors count.
local function isHopGapTile(x, y)
	if GameConstants.IsBlocked(x, y) then return false end
	if GameConstants.IsChasmFloor and GameConstants.IsChasmFloor(x, y) then return true end
	return false
end

-- OBS objects (map_gen_rules rows 82 / 87-89, 2026-10-12): the two blocker-form OBS
-- objects — "OBS Blocker" and "Ad Billboard" — both carry the ObjectData "OBS" tag.
-- They differ from real walls / Stone Pillars (no "OBS" tag) in two runtime ways:
--   (G) flight "pass over, never land": a flying mover may TRAVERSE the tile but can
--       never END on it; walkers stay fully blocked.
--   (H) direct-LoS: they block direct line of sight, but an attacker 3+ elevation
--       levels ABOVE the object's tile can see over them (mirrors the enemy-unit LoS
--       bypass and the elevation convention).
-- Reuses blocker metadata (GetBlockerData.objectType -> ObjectData tags); invents no
-- new flag. Returns false for non-blocked tiles and for non-OBS blockers.
local function isObsObjectTile(x, y)
	local b = GameConstants.GetBlockerData(x, y)
	if not b or not b.objectType then return false end
	local def = ObjectData.Objects[b.objectType]
	if not def or not def.tags then return false end
	for _, tag in ipairs(def.tags) do
		if tag == "OBS" then return true end
	end
	return false
end

-- Cost to ENTER a tile before mover traits (flight / Pathfinder / Bogged Down): base terrain,
-- then the active tile effect (Tar Pit stores the full cost -> max), a road cut (never below 1),
-- then an ENV-003 slow zone (+N). One formula (DAT-001) for walking steps and Rabbit Folk hop
-- landings (user ruling 2026-10-27: the landing tile counts in full).
local function tileEntryCost(x: number, y: number): number
	local terrainCost = GameConstants.GetTerrainCost(x, y)
	if _tileEffectService and _tileEffectService.GetTileEffect then
		local teff = _tileEffectService.GetTileEffect(x, y)
		if teff then
			local edef = GameConstants.TILE_EFFECTS[teff.id]
			if edef and edef.crossCostBonus then
				terrainCost = math.max(terrainCost, edef.crossCostBonus)
			end
		end
	end
	if _tileEffectService and _tileEffectService.GetRoadCut then
		local cut = _tileEffectService.GetRoadCut(x, y)
		if cut > 0 and terrainCost > 1 then
			terrainCost = math.max(1, terrainCost - cut)
		end
	end
	if _tileEffectService and _tileEffectService.GetMoveCostAdd then
		terrainCost = terrainCost + _tileEffectService.GetMoveCostAdd(x, y)
	end
	return terrainCost
end


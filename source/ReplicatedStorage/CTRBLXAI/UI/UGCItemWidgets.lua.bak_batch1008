--!strict
-- UGCItemWidgets.lua
-- CTRBLXAI | UGC — shared display pieces for the Outfit tab (UGCOutfitTab) and
-- the UGC merchant (UGCMerchantScreen). Presentation only (ARC-001 / ARC-003):
-- every action goes through UGCClient to the server; nothing here decides
-- prices, ownership or access.
--
-- Mobile (loadout_ui_spec 73): tap-only (Activated, no hover), every button at
-- least 44 x 44 px (UGCClient.MakeTextButton), Scale-based widths, layouts via
-- UIListLayout / UIGridLayout. Filters (loadout_ui_spec 69/70): Type + Status.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CTRBLXAI = ReplicatedStorage:WaitForChild("CTRBLXAI", 10) :: Instance
local UI = CTRBLXAI:WaitForChild("UI", 10) :: Instance
local Content = ReplicatedStorage:WaitForChild("Content", 10) :: Instance
local Theme = require(UI:WaitForChild("Theme", 10) :: ModuleScript) :: any
local UGCClient = require(UI:WaitForChild("UGCClient", 10) :: ModuleScript) :: any
local UGCCatalogData = require(Content:WaitForChild("UGCCatalogData", 10) :: ModuleScript) :: any

local UGCItemWidgets = {}

export type FilterState = { type: string, status: string, search: string?, sort: string? } -- "All" or a filter value

local MIN_TOUCH = Theme.MinSize.TouchTarget -- 44 px
local CARD_HEIGHT = 210 -- fits name, status, note and two wrapped rows of 44 px buttons
local THUMB_SIZE = 44
local ALL = "All"

--------------------------------------------------
-- SMALL HELPERS
--------------------------------------------------

function UGCItemWidgets.FormatGold(n: number?): string
	local s = tostring(math.floor(n or 0))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (out:gsub("^,", ""))
end

function UGCItemWidgets.Label(parent: Instance, text: string, opts: any?): TextLabel
	local o = opts or {}
	local lbl = Instance.new("TextLabel")
	lbl.Name = o.name or "Label"
	lbl.Text = text
	lbl.Font = if o.bold then Theme.Font.PrimaryBold else Theme.Font.Primary
	lbl.TextSize = o.textSize or Theme.Text.Small()
	lbl.TextColor3 = o.color or Theme.Colors.TextPrimary
	lbl.TextXAlignment = o.align or Enum.TextXAlignment.Left
	lbl.TextWrapped = o.wrap == true
	lbl.TextTruncate = if o.wrap then Enum.TextTruncate.None else Enum.TextTruncate.AtEnd
	lbl.BackgroundTransparency = 1
	lbl.BorderSizePixel = 0
	lbl.Size = o.size or UDim2.fromScale(1, 0)
	lbl.AutomaticSize = o.autoSize or Enum.AutomaticSize.Y
	lbl.LayoutOrder = o.order or 0
	lbl.Parent = parent -- NET-004
	return lbl
end

-- Plain frame holding a list layout. dir: Horizontal rows wrap (mobile widths).
function UGCItemWidgets.Row(parent: Instance, order: number, dir: Enum.FillDirection?, padPx: number?): Frame
	local row = Instance.new("Frame")
	row.Name = "Row"
	row.BackgroundTransparency = 1
	row.Size = UDim2.fromScale(1, 0)
	row.AutomaticSize = Enum.AutomaticSize.Y
	row.LayoutOrder = order
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = dir or Enum.FillDirection.Horizontal
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, padPx or Theme.Spacing.sm)
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	if layout.FillDirection == Enum.FillDirection.Horizontal then layout.Wraps = true end
	layout.Parent = row
	row.Parent = parent
	return row
end

-- Status line under the header: success / error feedback for the last action.
function UGCItemWidgets.MakeMessage(parent: Instance, order: number): TextLabel
	return UGCItemWidgets.Label(parent, "", { name = "Message", order = order, wrap = true, color = Theme.Colors.TextSecondary })
end

function UGCItemWidgets.SetMessage(lbl: TextLabel?, text: string, isError: boolean?)
	if not lbl or lbl.Parent == nil then return end
	lbl.Text = text
	lbl.TextColor3 = if isError then Theme.Colors.Danger else Theme.Colors.TextGold
end

--------------------------------------------------
-- FILTERS (loadout_ui_spec 69/70)
--------------------------------------------------

function UGCItemWidgets.NewFilterState(): FilterState
	return { type = ALL, status = ALL, search = "", sort = "NameAsc" }
end

function UGCItemWidgets.PassesFilter(item: any, f: FilterState): boolean
	if f.type ~= ALL and item.typeCategory ~= f.type then return false end
	if f.status ~= ALL and item.statusCategory ~= f.status then return false end
	local q = f.search
	if q and q ~= "" and not string.find(string.lower(item.name or ""), string.lower(q), 1, true) then
		return false
	end
	return true
end

-- COMPACT TOOLBAR (user ruling 2026-10-08): one 24 px row like the Equipment tab —
-- Search box + Type / Status / Sort drop-down buttons. Exception to the 44 px touch
-- rule (loadout_ui_spec 73), matching the Equipment inventory toolbar.
UGCItemWidgets.COMPACT_H = 24
local SORT_OPTIONS = {
	{ id = "NameAsc", label = "Name A-Z" },
	{ id = "NameDesc", label = "Name Z-A" },
	{ id = "Status", label = "Status" },
}
local STATUS_ORDER = { Permanent = 1, Rented = 2, OutOfUse = 3 }
local _openMenu: ScreenGui? = nil

local function closeMenu()
	if _openMenu then _openMenu:Destroy(); _openMenu = nil end -- MEM-002
end
UGCItemWidgets.CloseMenu = closeMenu

-- Drop-down list under an anchor button. options: { { label, value, active } }.
local function showMenu(anchor: GuiObject, options: { any }, onPick: (any) -> ())
	closeMenu()
	local Players = game:GetService("Players")
	local player = Players.LocalPlayer
	local pg = player and player:FindFirstChildOfClass("PlayerGui")
	if not pg then return end
	local rowH = 22
	local gui = Instance.new("ScreenGui")
	gui.Name = "UGCDropdown"
	gui.DisplayOrder = 300 -- above the loadout and the UGC merchant
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	local backdrop = Instance.new("TextButton")
	backdrop.Size = UDim2.fromScale(1, 1)
	backdrop.BackgroundTransparency = 1
	backdrop.Text = ""
	backdrop.Activated:Connect(closeMenu)
	backdrop.Parent = gui
	local menu = Instance.new("Frame")
	menu.BackgroundColor3 = Theme.Colors.Panel
	menu.BorderSizePixel = 0
	menu.Size = UDim2.fromOffset(math.max(anchor.AbsoluteSize.X, 96), #options * rowH + 4)
	menu.Position = UDim2.fromOffset(anchor.AbsolutePosition.X, anchor.AbsolutePosition.Y + anchor.AbsoluteSize.Y + 2)
	local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0, 4); corner.Parent = menu
	local stroke = Instance.new("UIStroke"); stroke.Color = Theme.Colors.Border; stroke.Thickness = 1; stroke.Parent = menu
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 2); pad.PaddingBottom = UDim.new(0, 2)
	pad.PaddingLeft = UDim.new(0, 2); pad.PaddingRight = UDim.new(0, 2)
	pad.Parent = menu
	local layout = Instance.new("UIListLayout"); layout.SortOrder = Enum.SortOrder.LayoutOrder; layout.Parent = menu
	for i, opt in options do
		local row = Instance.new("TextButton")
		row.Size = UDim2.new(1, 0, 0, rowH)
		row.BackgroundColor3 = Theme.Colors.PanelRaised
		row.BackgroundTransparency = if opt.active then 0.2 else 0.6
		row.BorderSizePixel = 0
		row.Font = Theme.Font.Primary
		row.TextSize = Theme.Text.Small()
		row.TextColor3 = if opt.active then Theme.Colors.TextGold else Theme.Colors.TextPrimary
		row.Text = opt.label
		row.LayoutOrder = i
		if opt.icon and opt.icon ~= "" then
			-- Optional left icon (Type filter slot icons, 2026-10-08).
			local ico = Instance.new("ImageLabel")
			ico.Size = UDim2.fromOffset(rowH - 6, rowH - 6)
			ico.Position = UDim2.new(0, 3, 0.5, -(rowH - 6) / 2)
			ico.BackgroundTransparency = 1
			ico.ScaleType = Enum.ScaleType.Fit
			ico.Image = opt.icon
			ico.Parent = row -- NET-004
		end
		row.Activated:Connect(function()
			closeMenu()
			onPick(opt.value)
		end)
		row.Parent = menu
	end
	menu.Parent = gui
	gui.Parent = pg -- NET-004
	_openMenu = gui
end

local function toolbarButton(parent: Instance, text: string, order: number, isActive: boolean, icon: string?): TextButton
	local btn = Instance.new("TextButton")
	btn.Name = "Tool_" .. text
	btn.Size = UDim2.new(0, 72, 1, 0)
	btn.BackgroundColor3 = Theme.Colors.Surface
	btn.BackgroundTransparency = 0.2
	btn.BorderSizePixel = 0
	btn.Text = ""
	btn.LayoutOrder = order
	local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0, 3); corner.Parent = btn
	local color = if isActive then Theme.Colors.TextGold else Theme.Colors.TextSecondary
	local x = 4
	if icon then
		local ico = Instance.new("ImageLabel")
		ico.Size = UDim2.fromOffset(14, 14)
		ico.Position = UDim2.new(0, 3, 0.5, -7)
		ico.BackgroundTransparency = 1
		ico.Image = icon
		ico.ScaleType = Enum.ScaleType.Fit
		ico.ImageColor3 = color
		ico.Parent = btn
		x = 19
	end
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -(x + 2), 1, 0)
	lbl.Position = UDim2.fromOffset(x, 0)
	lbl.BackgroundTransparency = 1
	lbl.Font = Theme.Font.Primary
	lbl.TextSize = Theme.Text.Small()
	lbl.TextColor3 = color
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.TextTruncate = Enum.TextTruncate.AtEnd
	lbl.Text = text
	lbl.Parent = btn
	btn.Parent = parent
	return btn
end

-- Search + Type + Status + Sort in one row. onChanged() runs after the state changes.
function UGCItemWidgets.MakeFilterBar(parent: Instance, f: FilterState, order: number, onChanged: () -> ()): Frame
	closeMenu()
	local bar = Instance.new("Frame")
	bar.Name = "FilterBar"
	bar.BackgroundTransparency = 1
	bar.Size = UDim2.new(1, 0, 0, UGCItemWidgets.COMPACT_H)
	bar.LayoutOrder = order
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 3)
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Parent = bar

	local search = Instance.new("TextBox")
	search.Name = "Search"
	search.Size = UDim2.new(1, -(72 * 3 + 3 * 3), 1, 0)
	search.BackgroundColor3 = Theme.Colors.Surface
	search.BackgroundTransparency = 0.2
	search.BorderSizePixel = 0
	search.Font = Theme.Font.Primary
	search.TextSize = Theme.Text.Small()
	search.TextColor3 = Theme.Colors.TextPrimary
	search.PlaceholderText = "Search items..."
	search.PlaceholderColor3 = Theme.Colors.TextDisabled
	search.Text = f.search or ""
	search.ClearTextOnFocus = false
	search.LayoutOrder = 1
	local sc = Instance.new("UICorner"); sc.CornerRadius = UDim.new(0, 3); sc.Parent = search
	search.FocusLost:Connect(function()
		if search.Text ~= (f.search or "") then
			f.search = search.Text
			onChanged()
		end
	end)
	search.Parent = bar

	local typeBtn = toolbarButton(bar, if f.type == ALL then "Type" else f.type, 2, f.type ~= ALL, Theme.Icons and Theme.Icons.Filter)
	typeBtn.Activated:Connect(function()
		local opts = { { label = "All types", value = ALL, active = f.type == ALL } }
		for _, v in UGCCatalogData.FILTER_TYPES do
			table.insert(opts, { label = v, value = v, active = f.type == v, icon = UGCCatalogData.SLOT_ICONS[v] })
		end
		showMenu(typeBtn, opts, function(v) f.type = v; onChanged() end)
	end)

	local labels = UGCCatalogData.STATUS_FILTER_LABELS or {}
	local statusBtn = toolbarButton(bar, if f.status == ALL then "Status" else (labels[f.status] or f.status), 3,
		f.status ~= ALL, Theme.Icons and Theme.Icons.Filter)
	statusBtn.Activated:Connect(function()
		local opts = { { label = "All statuses", value = ALL, active = f.status == ALL } }
		for _, v in UGCCatalogData.STATUS_FILTERS do
			table.insert(opts, { label = labels[v] or v, value = v, active = f.status == v })
		end
		showMenu(statusBtn, opts, function(v) f.status = v; onChanged() end)
	end)

	local sortLabel = "Sort"
	for _, s in SORT_OPTIONS do if s.id == f.sort then sortLabel = s.label end end
	local sortBtn = toolbarButton(bar, sortLabel, 4, false, Theme.Icons and Theme.Icons.Sort)
	sortBtn.Activated:Connect(function()
		local opts = {}
		for _, s in SORT_OPTIONS do table.insert(opts, { label = s.label, value = s.id, active = f.sort == s.id }) end
		showMenu(sortBtn, opts, function(v) f.sort = v; onChanged() end)
	end)

	bar.Parent = parent -- NET-004
	return bar
end

-- Sort a filtered list in place by the toolbar's sort choice.
function UGCItemWidgets.SortItems(list: { any }, f: FilterState)
	local function nm(x: any): string return string.lower(x.name or "") end
	if f.sort == "NameDesc" then
		table.sort(list, function(a, b) return nm(a) > nm(b) end)
	elseif f.sort == "Status" then
		table.sort(list, function(a, b)
			local sa = STATUS_ORDER[a.statusCategory or ""] or 9
			local sb = STATUS_ORDER[b.statusCategory or ""] or 9
			if sa ~= sb then return sa < sb end
			return nm(a) < nm(b)
		end)
	else
		table.sort(list, function(a, b) return nm(a) < nm(b) end)
	end
end

-- Shrink a header button (sub-tab / text button) to the compact height.
function UGCItemWidgets.Compact(btn: GuiObject, h: number?)
	local height = h or UGCItemWidgets.COMPACT_H
	btn.Size = UDim2.new(btn.Size.X.Scale, btn.Size.X.Offset, 0, height)
	for _, c in btn:GetChildren() do
		if c:IsA("UISizeConstraint") then c.MinSize = Vector2.new(height, height) end
	end
end


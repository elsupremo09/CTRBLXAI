--!strict
-- UGCItemWidgets.lua
-- CTRBLXAI | UGC — shared display pieces for the Outfit tab (UGCOutfitTab) and
-- the UGC merchant (UGCMerchantScreen). Presentation only (ARC-001 / ARC-003):
-- every action goes through UGCClient to the server; nothing here decides
-- prices, ownership or access.
--
-- Mobile (loadout_ui_spec 73): tap-only (Activated, no hover), every button at
-- least 44 x 44 px (UGCClient.MakeTextButton), Scale-based widths, layouts via
-- UIListLayout / UIGridLayout. Filters (loadout_ui_spec 69/70): Type + Status.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CTRBLXAI = ReplicatedStorage:WaitForChild("CTRBLXAI", 10) :: Instance
local UI = CTRBLXAI:WaitForChild("UI", 10) :: Instance
local Content = ReplicatedStorage:WaitForChild("Content", 10) :: Instance
local Theme = require(UI:WaitForChild("Theme", 10) :: ModuleScript) :: any
local UGCClient = require(UI:WaitForChild("UGCClient", 10) :: ModuleScript) :: any
local UGCCatalogData = require(Content:WaitForChild("UGCCatalogData", 10) :: ModuleScript) :: any

local UGCItemWidgets = {}

export type FilterState = { type: string, status: string } -- "All" or a filter value

local MIN_TOUCH = Theme.MinSize.TouchTarget -- 44 px
local CARD_HEIGHT = 210 -- fits name, status, note and two wrapped rows of 44 px buttons
local THUMB_SIZE = 44
local ALL = "All"

--------------------------------------------------
-- SMALL HELPERS
--------------------------------------------------

function UGCItemWidgets.FormatGold(n: number?): string
	local s = tostring(math.floor(n or 0))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (out:gsub("^,", ""))
end

function UGCItemWidgets.Label(parent: Instance, text: string, opts: any?): TextLabel
	local o = opts or {}
	local lbl = Instance.new("TextLabel")
	lbl.Name = o.name or "Label"
	lbl.Text = text
	lbl.Font = if o.bold then Theme.Font.PrimaryBold else Theme.Font.Primary
	lbl.TextSize = o.textSize or Theme.Text.Small()
	lbl.TextColor3 = o.color or Theme.Colors.TextPrimary
	lbl.TextXAlignment = o.align or Enum.TextXAlignment.Left
	lbl.TextWrapped = o.wrap == true
	lbl.TextTruncate = if o.wrap then Enum.TextTruncate.None else Enum.TextTruncate.AtEnd
	lbl.BackgroundTransparency = 1
	lbl.BorderSizePixel = 0
	lbl.Size = o.size or UDim2.fromScale(1, 0)
	lbl.AutomaticSize = o.autoSize or Enum.AutomaticSize.Y
	lbl.LayoutOrder = o.order or 0
	lbl.Parent = parent -- NET-004
	return lbl
end

-- Plain frame holding a list layout. dir: Horizontal rows wrap (mobile widths).
function UGCItemWidgets.Row(parent: Instance, order: number, dir: Enum.FillDirection?, padPx: number?): Frame
	local row = Instance.new("Frame")
	row.Name = "Row"
	row.BackgroundTransparency = 1
	row.Size = UDim2.fromScale(1, 0)
	row.AutomaticSize = Enum.AutomaticSize.Y
	row.LayoutOrder = order
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = dir or Enum.FillDirection.Horizontal
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, padPx or Theme.Spacing.sm)
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	if layout.FillDirection == Enum.FillDirection.Horizontal then layout.Wraps = true end
	layout.Parent = row
	row.Parent = parent
	return row
end

-- Status line under the header: success / error feedback for the last action.
function UGCItemWidgets.MakeMessage(parent: Instance, order: number): TextLabel
	return UGCItemWidgets.Label(parent, "", { name = "Message", order = order, wrap = true, color = Theme.Colors.TextSecondary })
end

function UGCItemWidgets.SetMessage(lbl: TextLabel?, text: string, isError: boolean?)
	if not lbl or lbl.Parent == nil then return end
	lbl.Text = text
	lbl.TextColor3 = if isError then Theme.Colors.Danger else Theme.Colors.TextGold
end

--------------------------------------------------
-- FILTERS (loadout_ui_spec 69/70)
--------------------------------------------------

function UGCItemWidgets.NewFilterState(): FilterState
	return { type = ALL, status = ALL }
end

function UGCItemWidgets.PassesFilter(item: any, f: FilterState): boolean
	if f.type ~= ALL and item.typeCategory ~= f.type then return false end
	if f.status ~= ALL and item.statusCategory ~= f.status then return false end
	return true
end

local function chipRow(parent: Instance, order: number, title: string, values: { string },
	labels: { [string]: string }?, current: string, onPick: (string) -> ())
	local row = UGCItemWidgets.Row(parent, order)
	UGCItemWidgets.Label(row, title, { size = UDim2.fromOffset(56, MIN_TOUCH), autoSize = Enum.AutomaticSize.None,
		bold = true, color = Theme.Colors.TextSecondary, order = 0 })
	local all = { ALL }
	for _, v in values do table.insert(all, v) end
	for i, v in all do
		local isActive = v == current
		local text = if labels and labels[v] then labels[v] else v
		local chip = UGCClient.MakeTextButton(row, text, if isActive then Theme.Colors.Info else Theme.Colors.Surface,
			function() onPick(v) end)
		chip.LayoutOrder = i
		if isActive then chip.TextColor3 = Theme.Colors.TextPrimary end
	end
end

-- Type + Status chip rows. onChanged() runs after the state changes.
function UGCItemWidgets.MakeFilterBar(parent: Instance, f: FilterState, order: number, onChanged: () -> ()): Frame
	local bar = UGCItemWidgets.Row(parent, order, Enum.FillDirection.Vertical)
	bar.Name = "FilterBar"
	chipRow(bar, 1, "Type", UGCCatalogData.FILTER_TYPES, nil, f.type, function(v)
		f.type = v
		onChanged()
	end)
	chipRow(bar, 2, "Status", UGCCatalogData.STATUS_FILTERS, UGCCatalogData.STATUS_FILTER_LABELS, f.status, function(v)
		f.status = v
		onChanged()
	end)
	return bar
end

--------------------------------------------------
-- GRID + CARDS
--------------------------------------------------

-- Scrolling card grid that fills the rest of a vertical list (UIFlexItem Fill).
function UGCItemWidgets.MakeGrid(parent: Instance, order: number): ScrollingFrame
	local sf = Instance.new("ScrollingFrame")
	sf.Name = "ItemGrid"
	sf.BackgroundTransparency = 1
	sf.BorderSizePixel = 0
	sf.Size = UDim2.fromScale(1, 0)
	sf.CanvasSize = UDim2.new()
	sf.AutomaticCanvasSize = Enum.AutomaticSize.Y
	sf.ScrollingDirection = Enum.ScrollingDirection.Y
	sf.ScrollBarThickness = 6
	sf.LayoutOrder = order
	local flex = Instance.new("UIFlexItem")
	flex.FlexMode = Enum.UIFlexMode.Fill
	flex.Parent = sf
	local columns = if Theme.GetMode() == "Mobile" then 2 else 3
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.new(1 / columns, -Theme.Spacing.md, 0, CARD_HEIGHT)
	grid.CellPadding = UDim2.fromOffset(Theme.Spacing.sm, Theme.Spacing.sm)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = sf
	sf.Parent = parent
	return sf
end

local function thumbnail(item: any): string
	if item.bundleId then
		return `rbxthumb://type=BundleThumbnail&id={item.bundleId}&w=150&h=150`
	end
	return `rbxthumb://type=Asset&id={item.assetId}&w=150&h=150`
end

export type CardAction = { text: string, color: Color3?, onPress: () -> (), enabled: boolean? }
-- opts: actions { CardAction }, note string?, showBuy boolean (default true),
--       isBattleActive boolean?, onBuyResult (Result) -> ()?, isHighlighted boolean?
function UGCItemWidgets.MakeItemCard(parent: Instance, item: any, order: number, opts: any): Frame
	local card = Instance.new("Frame")
	card.Name = `UGCCard_{item.assetId}`
	card.BackgroundColor3 = Theme.Colors.PanelRaised
	card.BackgroundTransparency = 0.1
	card.BorderSizePixel = 0
	card.LayoutOrder = order
	local corner = Instance.new("UICorner")
	corner.CornerRadius = Theme.CornerRadius.md
	corner.Parent = card
	local stroke = Instance.new("UIStroke")
	-- Out-of-use items are red (loadout_ui_spec 64 / ugc_rules on_expiry).
	stroke.Color = if item.status == "expired" then Theme.Colors.Danger
		elseif opts.isHighlighted then Theme.Colors.BorderSelected else Theme.Colors.Border
	stroke.Thickness = if item.status == "expired" or opts.isHighlighted then 2 else 1
	stroke.Parent = card
	local pad = Instance.new("UIPadding")
	for _, side in { "PaddingTop", "PaddingBottom", "PaddingLeft", "PaddingRight" } do
		(pad :: any)[side] = UDim.new(0, Theme.Spacing.sm)
	end
	pad.Parent = card
	local list = Instance.new("UIListLayout")
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, Theme.Spacing.xs)
	list.Parent = card

	local top = UGCItemWidgets.Row(card, 1)
	local img = Instance.new("ImageLabel")
	img.Name = "Thumb"
	img.Image = thumbnail(item)
	img.BackgroundColor3 = Theme.Colors.Surface
	img.BorderSizePixel = 0
	img.Size = UDim2.fromOffset(THUMB_SIZE, THUMB_SIZE)
	img.LayoutOrder = 1
	img.Parent = top
	local names = UGCItemWidgets.Row(top, 2, Enum.FillDirection.Vertical, 0)
	names.Size = UDim2.new(1, -(THUMB_SIZE + Theme.Spacing.sm), 0, 0)
	UGCItemWidgets.Label(names, item.name or tostring(item.assetId), { bold = true, order = 1 })
	UGCItemWidgets.Label(names, `{item.typeCategory or item.slot} · {item.slot}`,
		{ order = 2, color = Theme.Colors.TextSecondary, textSize = Theme.Text.Tiny() })

	local statusText = UGCClient.GetStatusLabel(item)
	if item.isOffSale then statusText ..= " · Off sale" end
	UGCItemWidgets.Label(card, statusText, { order = 2, bold = true, color = UGCClient.GetStatusColor(item.status) })
	if opts.note and opts.note ~= "" then
		UGCItemWidgets.Label(card, opts.note, { order = 3, wrap = true, color = Theme.Colors.TextSecondary,
			textSize = Theme.Text.Tiny() })
	end

	local actions = UGCItemWidgets.Row(card, 4)
	actions.Name = "Actions"
	for i, a in (opts.actions or {}) :: { CardAction } do
		local btn = UGCClient.MakeTextButton(actions, a.text, a.color, a.onPress, a.enabled)
		btn.LayoutOrder = i
	end
	if opts.showBuy ~= false then
		-- Buy for Roblox Avatar on every unowned item, trials included (loadout_ui_spec 65);
		-- "Off sale" marker instead when it can't be bought (ugc_rules 41/47).
		local buy = UGCClient.CreateBuyButton(actions, item, opts.onBuyResult, opts.isBattleActive)
		if buy then buy.LayoutOrder = 50 end
	end
	local badge = UGCClient.CreateOwnedBadge(actions, item.status == "owned")
	if badge then badge.LayoutOrder = 60 end
	card.Parent = parent -- NET-004: built off-tree, parented once
	return card
end

-- Put this in the vertical content list (not inside the grid).
function UGCItemWidgets.EmptyState(parent: Instance, text: string): TextLabel
	return UGCItemWidgets.Label(parent, text, { name = "Empty", wrap = true, color = Theme.Colors.TextSecondary,
		align = Enum.TextXAlignment.Center })
end

--------------------------------------------------
-- SHARED ACTION FEEDBACK
-- Screens rebuild their content on every refresh, so feedback goes through a
-- report(text, isError) callback that the screen shows on its next render.
--------------------------------------------------

export type Reporter = (string, boolean?) -> ()

-- Cart checkout (outside battle only — the server refuses it in battle).
function UGCItemWidgets.Checkout(report: Reporter, refresh: () -> ())
	local res = UGCClient.Checkout(function(done: any)
		local d = done and done.data
		if done and done.ok and type(d) == "table" and d.next then
			report("Purchase window closed — tap Checkout again for the next item")
		elseif done and done.ok and type(d) == "table" and type(d.purchased) == "table" then
			report(`{#d.purchased} item(s) bought — free forever`)
		elseif done and not done.ok then
			report(done.error or "Could not check the purchase", true)
		end
		refresh()
	end)
	if not res.ok then
		report(res.error or "Checkout failed", true)
	else
		report("Finish the purchase in the Roblox window")
	end
	refresh()
end

-- Result handler for one "Buy for Roblox Avatar" press. For an unbundled pair it
-- runs again after the server verifies (UGCClient.BuyAndVerify).
function UGCItemWidgets.OnBuyResult(report: Reporter, refresh: () -> ()): (any) -> ()
	return function(res: any)
		if res and res.ok and type(res.data) == "table" and type(res.data.purchased) == "table" then
			report(`{#res.data.purchased} item(s) bought — free forever`)
		elseif res and res.ok then
			report("Finish the purchase in the Roblox window")
		else
			report((res and res.error) or "Could not open the purchase window", true)
		end
		refresh()
	end
end

-- Server push (UGCStateChanged) -> message text, or nil.
function UGCItemWidgets.DescribeChange(change: any): string?
	if type(change) ~= "table" then return nil end
	local n = if type(change.assetIds) == "table" then #change.assetIds else 0
	if change.reason == "refunded" and type(change.extra) == "table" then
		return `Bought in game — {UGCItemWidgets.FormatGold(change.extra.gold)} gold rent refunded`
	elseif change.reason == "purchased" and n > 0 then
		return `{n} item(s) bought — free forever`
	elseif change.reason == "expired" and n > 0 then
		return `{n} rental(s) ran out — rent again or buy to keep using them`
	end
	return nil
end

return UGCItemWidgets

	GridMinCell      = 48,        -- px
	GridMaxCell      = 96,        -- px
	GridAspect       = 1.2,       -- cell height = width * this
	GridGap          = 4,         -- px between rows
	GridRows         = 3,         -- height-first: at least this many rows fit
	GridFallbackH    = 300,       -- px, used while the container has no real size yet (< 100)
}

--- Loadout-size inventory grid cell for a container of the given height (px). Height-first:
--- GridRows rows always fit, width clamped to GridMinCell..GridMaxCell. Returns cellW, cellH.
function Theme.ItemTileCell(containerH: number?): (number, number)
	local t = Theme.ItemTile
	local h = containerH or 0
	if h < 100 then h = t.GridFallbackH end
	local maxCellH = math.floor((h - 2 * t.GridGap) / t.GridRows)
	local cellW = math.clamp(math.floor(maxCellH / t.GridAspect), t.GridMinCell, t.GridMaxCell)
	return cellW, math.floor(cellW * t.GridAspect)
end

--- SHARED INVENTORY ITEM TILE (2026-10-20). The single source of truth for the
--- inventory tile look the user approved on the Loadout Consumables grid (which itself
--- mirrors the Gears tile): a category/rarity-colored background tint + UIStroke border,
--- an INSET square icon in the upper area, an optional top-right count badge, and a
--- bottom name strip (accent-colored, left-aligned, truncated). Built so merchant screens
--- and any future inventory screen render tiles identically by calling this one function
--- instead of re-deriving the layout. Creates its own instances (does NOT depend on any
--- screen-local makeLabel). Returns the tile TextButton so callers may parent extra
--- overlays onto it (e.g. the Gears equipped "E" marker / NEW badge) without this builder
--- needing to know about them.
---
--- opts:
---   parent      Instance   (required) where the tile is parented (a UIGridLayout container)
---   accentColor Color3     tints the bg, border, and name text (rarity color or category color)
---   cellW       number     current grid cell width in px; drives the inset icon square
---   icon        string?    rbxassetid for the icon image; if absent/non-asset, iconText is used
---   iconText    string?    fallback glyph/letter shown when there is no image icon
---   name        string?    bottom-strip label text
---   countText   string?    top-right badge text (e.g. "x5"); nil = no badge
---   selected    boolean?   selection highlight (gold stroke + highlight bg)
---   layoutOrder number?    LayoutOrder within the grid
---   onClick     function?  Activated (tap) handler
---   portrait    boolean?   (2026-11-09, Loadout Consumables) Skills/Augments-tile layout:
---                          a full-width SQUARE icon (side cellW - 2*inset) at the top inset,
---                          and a bottom name strip that always reserves TWO rows (bold Tiny
---                          text, shrinks to the phone floor only if a long name needs it).
---                          Off = the original layout (Merchant / Runeforge gems unchanged).
--- Returns: the tile TextButton.
-- Inner padding of an item tile = drawn thickness of its ornate frame border (2026-11-17).
function Theme.ItemTileFramePad(): number
	local pf = Theme.PanelFrame
	return math.ceil(pf.SliceCenter.Min.X * (Theme.ItemTile.FrameSliceScale or pf.SliceScale))
end

function Theme.MakeItemTile(opts)
	opts = opts or {}
	local t = Theme.ItemTile
	local accent = opts.accentColor or Theme.Colors.TextSecondary
	local cellW = opts.cellW or 72
	local iconInset = math.max(t.IconInsetMin, math.round(cellW * t.IconInsetFactor))

	local tile = Instance.new("TextButton")
	tile.Size = UDim2.new(1, 0, 1, 0)  -- sized by the container UIGridLayout CellSize
	-- 2026-11-16 (user ruling): item tiles use the ornate panel frame, dark fill like panels.
	-- Rarity now shows through the name colour only; selected keeps the gold stroke/highlight.
	if opts.selected then
		tile.BackgroundColor3 = t.SelectedBgColor
		tile.BackgroundTransparency = t.SelectedBgTransparency
	else
		tile.BackgroundColor3 = Theme.PanelFrame.BgColor
		tile.BackgroundTransparency = Theme.PanelFrame.BgTransparency
	end
	tile.BorderSizePixel = 0
	tile.Text = ""
	tile.AutoButtonColor = false -- project rule 243: no mouse-over colour change (2026-11-09)
	tile.LayoutOrder = opts.layoutOrder or 0
	tile.Parent = opts.parent
	Instance.new("UICorner", tile).CornerRadius = UDim.new(0, t.CornerRadius)
	-- 2026-11-17 (user): text/badges sit INSIDE the ornate frame, not on it.
	local framePad = Theme.ItemTileFramePad()
	local pad = Instance.new("UIPadding", tile)
	pad.PaddingTop = UDim.new(0, framePad); pad.PaddingBottom = UDim.new(0, framePad)
	pad.PaddingLeft = UDim.new(0, framePad); pad.PaddingRight = UDim.new(0, framePad)
	if opts.selected then
		local stroke = Instance.new("UIStroke", tile)
		stroke.Color = Theme.Colors.TextGold
		stroke.Thickness = t.SelectedStrokeThickness
	end
	-- Ornate frame overlay (same art as Theme.MakePanel), above icon/name, ignores taps.
	do
		local pf = Theme.PanelFrame
		local fr = Instance.new("ImageLabel")
		fr.Name = "ItemFrame"
		-- Cancels the tile UIPadding so the frame still covers the full tile edge.
		fr.Size = UDim2.new(1, framePad * 2, 1, framePad * 2)
		fr.Position = UDim2.fromOffset(-framePad, -framePad)
		fr.BackgroundTransparency = 1
		fr.BorderSizePixel = 0
		fr.Image = pf.Asset
		fr.ScaleType = Enum.ScaleType.Slice
		fr.SliceCenter = pf.SliceCenter
		fr.SliceScale = t.FrameSliceScale or pf.SliceScale
		fr.ImageTransparency = pf.ImageTransparency
		fr.Active = false
		fr.Interactable = false
		fr.ZIndex = 4
		fr.Parent = tile
	end

	-- Count badge (top-right)
	if opts.countText then
		local badge = Instance.new("Frame")
		badge.Size = UDim2.new(0, t.CountBadgeW, 0, t.CountBadgeH)
		badge.Position = UDim2.new(1, -t.CountBadgeFromRight, 0, 2)
		badge.BackgroundColor3 = t.CountBadgeBg
		badge.BackgroundTransparency = t.CountBadgeBgTransparency
		badge.BorderSizePixel = 0
		badge.ZIndex = 3
		badge.Parent = tile
		Instance.new("UICorner", badge).CornerRadius = UDim.new(0, 3)
		local bl = Instance.new("TextLabel")
		bl.Size = UDim2.fromScale(1, 1)
		bl.BackgroundTransparency = 1
		bl.BorderSizePixel = 0
		bl.Font = Theme.Font.Mono
		bl.TextSize = Theme.Text.Badge()
		bl.TextColor3 = Theme.Colors.TextPrimary
		bl.Text = opts.countText
		bl.TextXAlignment = Enum.TextXAlignment.Center
		bl.ZIndex = 3
		bl.Parent = badge
	end

	-- Icon: inset square in the upper area (image), else a centered text fallback.
	if opts.icon and string.find(opts.icon, "rbxassetid://") then
		-- Icon fills the area from the top inset down to just above the name strip (2026-10-20:
		-- was a fixed cellW square; a 2-line name bar would have overlapped it). ScaleType.Fit
		-- keeps the image aspect-correct and centered inside this box, and it self-adjusts to
		-- any cell height (the tile fills the grid cell, so scale-1 height = full cell).
		local ico = Instance.new("ImageLabel")
		-- Per-image fit (2026-11-12, user ruling): some icon art fills its whole canvas (StatMP) and
		-- looks oversized/off-centre beside icons with built-in margin. s < 1 shrinks the icon box
		-- around its own centre (Theme.FitIconBox); s = 1 is the unchanged layout.
		local baseSize: UDim2
		if opts.portrait then
			-- Same box as the Loadout Skills/Augments tiles: full-width square from the top inset.
			baseSize = UDim2.new(1, -iconInset * 2, 0, cellW - iconInset * 2 - framePad * 2)
		else
			baseSize = UDim2.new(1, -iconInset * 2, 1, -(iconInset + t.NameBarHeight + 2))
		end
		ico.Size, ico.Position = Theme.FitIconBox(opts.icon, baseSize, UDim2.fromOffset(iconInset, iconInset))
		ico.BackgroundTransparency = 1
		ico.Image = opts.icon
		ico.ScaleType = Enum.ScaleType.Fit
		ico.ZIndex = 2
		ico.Parent = tile
	elseif opts.iconText then
		local il = Instance.new("TextLabel")
		il.Size = UDim2.new(1, 0, 0, 28)
		il.Position = UDim2.new(0, 0, t.IconYScale, 0)
		il.BackgroundTransparency = 1
		il.BorderSizePixel = 0
		il.Font = Theme.Font.Primary
		il.TextSize = 24
		il.TextColor3 = Theme.Colors.TextPrimary
		il.Text = opts.iconText
		il.TextXAlignment = Enum.TextXAlignment.Center
		il.ZIndex = 2
		il.Parent = tile
	end

	-- Name strip (bottom)
	if opts.name and opts.portrait then
		-- Two-row name strip (2026-11-09): rows of PortraitNameLineH px; text is bold Tiny,
		-- stepped down (never below the phone floor / desktop min) until the name fits 2 rows.
		local rowH = t.PortraitNameLineH
		local barH = rowH * 2
		local nameBg = Instance.new("Frame")
		nameBg.Size = UDim2.new(1, 0, 0, barH)
		nameBg.Position = UDim2.new(0, 0, 1, -barH)
		nameBg.BackgroundColor3 = t.NameBgColor
		nameBg.BackgroundTransparency = t.NameBgTransparency
		nameBg.BorderSizePixel = 0
		nameBg.ZIndex = 3
		nameBg.Parent = tile
		local font = Theme.Font.Primary -- 2026-11-17 (user): normal weight, not bold
		local labelW = math.max(10, cellW - 4 - framePad * 2)
		local minSize = (Theme.GetMode() == "Mobile") and 10 or t.PortraitNameMinDesktop
		local size = Theme.Text.Tiny()
		while size > minSize and Theme.MeasureText(opts.name, size, font, labelW).Y > barH do
			size -= 1
		end
		local nl = Instance.new("TextLabel")
		nl.Size = UDim2.new(1, -4, 1, 0)
		nl.Position = UDim2.new(0, 2, 0, 0)
		nl.BackgroundTransparency = 1
		nl.BorderSizePixel = 0
		nl.Font = font
		nl.TextSize = size
		nl.TextColor3 = accent
		nl.Text = opts.name
		nl.TextXAlignment = Enum.TextXAlignment.Left
		nl.TextYAlignment = Enum.TextYAlignment.Center
		nl.TextWrapped = true
		nl.TextTruncate = Enum.TextTruncate.AtEnd
		nl.ZIndex = 3
		nl.Parent = nameBg
	elseif opts.name then
		local nameBg = Instance.new("Frame")
		nameBg.Size = UDim2.new(1, 0, 0, t.NameBarHeight)
		nameBg.Position = UDim2.new(0, 0, 1, -t.NameBarHeight)
		nameBg.BackgroundColor3 = t.NameBgColor
		nameBg.BackgroundTransparency = t.NameBgTransparency
		nameBg.BorderSizePixel = 0
		nameBg.ZIndex = 3
		nameBg.Parent = tile
		local nl = Instance.new("TextLabel")
		nl.Size = UDim2.new(1, -4, 1, 0)
		nl.Position = UDim2.new(0, 2, 0, 0)
		nl.BackgroundTransparency = 1
		nl.BorderSizePixel = 0
		nl.Font = Theme.Font.Primary
		nl.TextSize = Theme.Text.Small()
		nl.TextColor3 = accent
		nl.Text = opts.name
		nl.TextXAlignment = Enum.TextXAlignment.Left
		nl.TextYAlignment = Enum.TextYAlignment.Center
		nl.TextWrapped = true   -- 2026-10-20: wrap long names onto a second line instead of clipping
		nl.TextTruncate = Enum.TextTruncate.AtEnd
		nl.ZIndex = 3
		nl.Parent = nameBg
	end

	if opts.onClick then
		tile.Activated:Connect(opts.onClick)
	end
	return tile
end

--- Creates a standard full-screen ScreenGui + root Frame + decorative border.
--- Returns screenGui, rootFrame.
--- Usage:
---   local sg, root = Theme.MakeFullScreen("LoadoutScreen", parent)
function Theme.MakeFullScreen(name, parent)
	local sg = Instance.new("ScreenGui")
	sg.Name = name or "FullScreen"
	sg.ResetOnSpawn = false
	sg.DisplayOrder = Theme.FullScreen.DisplayOrder
	sg.IgnoreGuiInset = Theme.FullScreen.IgnoreGuiInset
	sg.Parent = parent

	local root = Instance.new("Frame")
	root.Name = "Root"
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundColor3 = Theme.FullScreen.BackgroundColor
	root.BackgroundTransparency = Theme.FullScreen.BackgroundTransparency
	root.Parent = sg

	Theme.MakeScreenBorder(root)

	return sg, root
end


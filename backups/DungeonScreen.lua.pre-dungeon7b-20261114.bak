--!strict
-- DungeonScreen.lua
-- CTRBLXAI | Dungeon full screen (Dungeon build step 5, 2026-11-13; project_rules 258-274).
-- All player text = the 62 strings approved 2026-11-13 10:08 PM
-- (workspace/artifacts/DRAFT_dungeon_screen_text_20261113.md), ids in comments (DG-...).
--
-- Views (GuildScreen, fullMain):
--   board : dungeon cards (biome, difficulty word + level, fixed weather, floors), used = "Explored"
--   party : pick 1-7 home units, Enter (confirm)
--   map   : Slay the Spire style rows / paths, bottom to top, Boss on top. Legal next rooms glow
--           and are tappable; the current room shows "You are here"; cleared rooms "Cleared".
--           Top line: Floor n/total, Loot xN (tap = explanation). Buttons: ? / Bag / Leave / Back.
--   room panels (Rest, Treasure) and the end-of-run result. Escape rooms removed 2026-11-13 11:36 PM.
-- Display + input only (ARC-001 / SEC-002): every change goes through ctx.action (the server's
-- DungeonAction remote) and the screen re-renders from the server's answer. Context is nil-safe.

local WAIT = 10

local uiFolder = script.Parent
local themeModule = uiFolder:WaitForChild("Theme", WAIT)
local guildScreenModule = uiFolder:WaitForChild("GuildScreen", WAIT)
if not themeModule or not guildScreenModule then
	error("[DungeonScreen] Theme / GuildScreen module not found")
end
local Theme: any = (require :: any)(themeModule)
local GuildScreen: any = (require :: any)(guildScreenModule)
local MerchantPanel: any = (require :: any)(uiFolder:WaitForChild("DungeonMerchantPanel", WAIT)) -- step 6
local EventPanel: any = (require :: any)(uiFolder:WaitForChild("DungeonEventPanel", WAIT)) -- step 7a

local DungeonScreen = {}

export type Context = {
	parent: Instance,
	action: (data: { [string]: any }) -> any?,  -- DungeonAction (nil on error; error shown in status)
	getUnits: () -> any?,                         -- GetGuildUnits (fresh)
	launchBattle: () -> (),                       -- play the current battle room
	requestBack: (close: () -> ()) -> (),
	onClosed: () -> (),
	setStatus: (text: string, isError: boolean?) -> (),
}

local MAX_PARTY = 7
local ROW_STEP = 66       -- map row spacing (room circle + gap)
local ROOM_D = 52         -- room circle (>= 44 px touch target)
local BOSS_D = 62
local MAP_PAD = 12        -- canvas padding top and bottom so no row is cut off
local NODE_H = 44 -- touch target
local DIM = 0.5

-- Difficulty words (USER RULING 2026-11-13 10:08 PM; 5-step mapping = agent default).
local DIFF_WORDS = { "Very Easy", "Easy", "Normal", "Hard", "Very Hard" }

-- DG-ROOM-* + map key labels (USER RULING 2026-11-14 2:51 AM: "Event", "Mystery" approved).
-- Event rooms show "Event" even though they still play as battles; a Mystery shows "Mystery" until
-- entered, then the type it became.
local ROOM_LABEL = {
	Battle = "Battle", Elite = "Elite", Boss = "Boss", Rest = "Rest",
	Merchant = "Merchant", Treasure = "Treasure", Event = "Event", Mystery = "Mystery",
}
local KEY_ORDER = { "Battle", "Elite", "Boss", "Rest", "Merchant", "Treasure", "Event", "Mystery" }

-- "?" help (6 bullets, approved by user 2026-11-14 1:43 AM).
local HELP = {
	"Pick a dungeon and up to 7 units. They stay inside until the run ends.",
	"Move up the map one room at a time. The Boss waits at the top.",
	"No healing or refills between battles. Rest rooms heal your party.",
	"Loot grows with every battle you win.",
	"Leave any time, but you only keep EXP, 75% of gold and normal materials.",
	"Beat the Boss or leave from a Rest room to bring everything home.",
}

local ctx: Context? = nil
local screen: any = nil
local isOpen = false
local view = "board"         -- board | party | map
local st: any = nil          -- last server state
local pickedCard: any = nil
local picked: { [string]: boolean } = {}
local partyUnits: any = nil -- unit list fetched once when the party view opens (no re-fetch per tap)
local overlay: Instance? = nil
local overlayTaps: { () -> () } = {} -- the open popup's button actions (test hook = same path as a tap)
local shownRoom: string? = nil -- room whose panel was already shown on arrival
local render: () -> () = function() end
local legendOpen = false

--------------------------------------------------
-- HELPERS (properties before Parent, NET-004)
--------------------------------------------------

local function makeText(parent: Instance?, text: string, size: number, color: Color3, bold: boolean?): TextLabel
	local lbl = Instance.new("TextLabel")
	lbl.BackgroundTransparency = 1
	lbl.BorderSizePixel = 0
	lbl.Font = if bold then Theme.Font.PrimaryBold else Theme.Font.Primary
	lbl.TextSize = size
	lbl.TextColor3 = color
	lbl.TextWrapped = true
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.TextYAlignment = Enum.TextYAlignment.Center
	lbl.Text = text
	lbl.ZIndex = 2
	lbl.TextScaled = true
	local fit = Instance.new("UITextSizeConstraint")
	fit.MaxTextSize = size
	fit.MinTextSize = math.min(size, 10) -- 10 px phone floor
	fit.Parent = lbl
	lbl.Parent = parent
	return lbl
end

local function ts(): number return math.max(10, Theme.Text.Small()) end
local function body(): number return math.max(10, Theme.Text.Body()) end

local function corner(parent: Instance, r: UDim?)
	local c = Instance.new("UICorner")
	c.CornerRadius = r or Theme.CornerRadius.sm
	c.Parent = parent
end

local function stroke(parent: Instance, color: Color3, th: number)
	local s = Instance.new("UIStroke")
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Color = color
	s.Thickness = th
	s.Parent = parent
end

local function closeOverlay()
	MerchantPanel.Close(); EventPanel.Close()
	if overlay then
		overlay:Destroy()
		overlay = nil
	end
end

-- Modal box: lines = { { text, size?, color?, bold? } }; buttons = { { text? | icon?, style?, onTap } }.
local function popup(name: string, lines: { any }, buttons: { any })
	if not screen then return end
	closeOverlay()
	overlayTaps = {}
	local o = Instance.new("TextButton")
	o.Name = name
	o.Text = ""
	o.AutoButtonColor = false
	o.Modal = true
	o.Size = UDim2.fromScale(1, 1)
	o.BackgroundColor3 = Color3.new(0, 0, 0)
	o.BackgroundTransparency = 0.4
	o.BorderSizePixel = 0
	o.ZIndex = 20
	local box = Instance.new("Frame")
	box.Name = "Box"
	box.AnchorPoint = Vector2.new(0.5, 0.5)
	box.Position = UDim2.fromScale(0.5, 0.5)
	box.Size = UDim2.new(0.8, 0, 0, 0)
	box.AutomaticSize = Enum.AutomaticSize.Y
	box.BackgroundColor3 = Theme.Colors.PanelRaised
	box.BorderSizePixel = 0
	local maxW = Instance.new("UISizeConstraint")
	maxW.MaxSize = Vector2.new(460, math.huge)
	maxW.Parent = box
	corner(box, Theme.CornerRadius.md)
	stroke(box, Theme.Colors.Border, Theme.BorderThickness.Default)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 14)
	pad.PaddingRight = UDim.new(0, 14)
	pad.PaddingTop = UDim.new(0, 10)
	pad.PaddingBottom = UDim.new(0, 10)
	pad.Parent = box
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 4)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = box
	for i, l in lines do
		local lbl = makeText(nil, l[1], l[2] or body(), l[3] or Theme.Colors.TextPrimary, l[4])
		lbl.TextScaled = false
		lbl.TextSize = l[2] or body()
		lbl.Size = UDim2.new(1, 0, 0, 0)
		lbl.AutomaticSize = Enum.AutomaticSize.Y
		lbl.LayoutOrder = i
		lbl.ZIndex = 21
		lbl.Parent = box
	end
	local row = Instance.new("Frame")
	row.Name = "Buttons"
	row.Size = UDim2.new(1, 0, 0, GuildScreen.ROW_H)
	row.BackgroundTransparency = 1
	row.BorderSizePixel = 0
	row.LayoutOrder = 100
	local rl = Instance.new("UIListLayout")
	rl.FillDirection = Enum.FillDirection.Horizontal
	rl.HorizontalAlignment = Enum.HorizontalAlignment.Right
	rl.VerticalAlignment = Enum.VerticalAlignment.Center
	rl.Padding = UDim.new(0, 6)
	rl.SortOrder = Enum.SortOrder.LayoutOrder
	rl.Parent = row
	for i, bt in buttons do
		local b: any
		if bt.icon then
			b = Theme.MakeIconButton(nil, bt.icon, bt.onTap, {
				name = "Btn_" .. bt.icon, size = UDim2.fromOffset(GuildScreen.ROW_H, GuildScreen.ROW_H) })
		else
			b = Theme.MakeBarButton(nil, bt.text, bt.style or "Primary", bt.onTap, {
				name = "Btn_" .. tostring(i), minHeight = GuildScreen.ROW_H })
		end
		b.LayoutOrder = i
		b.Parent = row
		overlayTaps[i] = bt.onTap
	end
	row.Parent = box
	box.Parent = o
	o.Parent = screen.Gui -- parent last (NET-004)
	overlay = o
end

local function act(data: { [string]: any }): any?
	local c = ctx
	if not c then return nil end
	local res = c.action(data)
	if res then
		st = res
		if screen then screen.SetStatus("") end
	end
	return res
end

local function nodeOf(id: string?): any
	if not st or not st.run or not id then return nil end
	for _, n in st.run.nodes do
		if n.id == id then return n end
	end
	return nil
end

local function isCleared(id: string): boolean
	if not st or not st.run then return false end
	for _, c in st.run.cleared do
		if c == id then return true end
	end
	return false
end

-- Shown / effective room type: a Mystery that was entered acts as what it became.
local function shownType(n: any): string
	return (n and (n.resolved or n.type)) or "Battle"
end

--------------------------------------------------
-- BOARD (no run)
--------------------------------------------------

local function buildBoard()
	local main = screen.Main
	local intro = makeText(main, "Pick a dungeon, then choose your party.", ts(), Theme.Colors.TextSecondary) -- DG-INTRO
	intro.Size = UDim2.new(1, 0, 0, ts() + 4)
	local grid = Instance.new("ScrollingFrame")
	grid.Name = "Grid"
	grid.Position = UDim2.fromOffset(0, ts() + 8)
	grid.Size = UDim2.new(1, 0, 1, -(ts() * 2 + 16))
	grid.BackgroundTransparency = 1
	grid.BorderSizePixel = 0
	grid.ScrollBarThickness = 4
	grid.ScrollingDirection = Enum.ScrollingDirection.Y
	grid.AutomaticCanvasSize = Enum.AutomaticSize.Y
	grid.CanvasSize = UDim2.new()
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.new(1 / 3, -6, 0, ts() * 4 + 30)
	layout.CellPadding = UDim2.fromOffset(4, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = grid
	local choices = (st and st.choices) or {}
	for i, c in choices do
		local card = Instance.new("TextButton")
		card.Name = "Card_" .. tostring(c.id)
		card.Text = ""
		card.AutoButtonColor = false
		card.BackgroundColor3 = Theme.Colors.Surface
		card.BackgroundTransparency = 0.2
		card.BorderSizePixel = 0
		card.LayoutOrder = i
		corner(card)
		local h = ts() + 4
		local lines = {
			{ tostring(c.biome), Theme.Colors.TextGold, true },                                         -- DG-CARD-BIOME
			{ `Difficulty {DIFF_WORDS[c.difficulty] or "?"} · Lv {c.level or "?"}`, Theme.Colors.TextPrimary }, -- DG-CARD-DIFF
			{ `Weather: {tostring(c.condition)}`, Theme.Colors.TextSecondary },                          -- DG-CARD-COND
			{ `{c.floors} floors + Boss`, Theme.Colors.TextSecondary },                                  -- DG-CARD-FLOORS
		}
		for j, l in lines do
			local t = makeText(card, l[1], ts(), l[2], l[3])
			t.TextWrapped = false
			t.TextTruncate = Enum.TextTruncate.AtEnd
			t.Size = UDim2.new(1, -12, 0, h)
			t.Position = UDim2.fromOffset(6, 6 + (j - 1) * (h + 2))
		end
		if c.used then
			local dim = Instance.new("Frame")
			dim.Size = UDim2.fromScale(1, 1)
			dim.BackgroundColor3 = Color3.new(0, 0, 0)
			dim.BackgroundTransparency = DIM
			dim.BorderSizePixel = 0
			dim.ZIndex = 5
			corner(dim)
			local tag = makeText(dim, "Explored", ts(), Theme.Colors.TextPrimary, true) -- DG-CARD-USED
			tag.TextXAlignment = Enum.TextXAlignment.Right
			tag.TextYAlignment = Enum.TextYAlignment.Bottom
			tag.Size = UDim2.new(1, -6, 1, -4)
			tag.ZIndex = 6
			dim.Parent = card
		else
			local cc = c
			card.Activated:Connect(function()
				pickedCard = cc
				picked = {}
				partyUnits = nil
				view = "party"
				render()
			end)
		end
		card.Parent = grid
	end
	grid.Parent = main
	local foot = makeText(main,
		if #choices == 0 then `No dungeons right now. New ones in {st and st.rerollIn or "?"} battles.` -- DG-NONE
		else `New dungeons in {st and st.rerollIn or "?"} battles`, ts(), Theme.Colors.TextSecondary)   -- DG-REROLL
	foot.AnchorPoint = Vector2.new(0, 1)
	foot.Position = UDim2.fromScale(0, 1)
	foot.Size = UDim2.new(1, 0, 0, ts() + 4)
end

--------------------------------------------------
-- PARTY PICK
--------------------------------------------------

local function pickedCount(): number
	local n = 0
	for _ in picked do n += 1 end
	return n
end

local function buildParty()
	local c = ctx
	if not c then return end
	local main = screen.Main
	local n = pickedCount()
	local top = makeText(main, "Choose your party", body(), Theme.Colors.TextGold, true) -- DG-PARTY-TITLE
	top.Size = UDim2.new(0.6, 0, 0, body() + 4)
	local cnt = makeText(main, `{n} / {MAX_PARTY} units`, body(), Theme.Colors.TextPrimary, true) -- DG-PARTY-COUNT
	cnt.TextXAlignment = Enum.TextXAlignment.Right
	cnt.Position = UDim2.fromScale(0.6, 0)
	cnt.Size = UDim2.new(0.4, 0, 0, body() + 4)
	local hint = makeText(main, "They can't be used anywhere else until the run ends.", ts(), Theme.Colors.TextSecondary) -- DG-PARTY-HINT
	hint.Position = UDim2.fromOffset(0, body() + 6)
	hint.Size = UDim2.new(1, 0, 0, ts() + 4)
	local y0 = body() + ts() + 14
	local grid = Instance.new("ScrollingFrame")
	grid.Name = "Grid"
	grid.Position = UDim2.fromOffset(0, y0)
	grid.Size = UDim2.new(1, 0, 1, -y0)
	grid.BackgroundTransparency = 1
	grid.BorderSizePixel = 0
	grid.ScrollBarThickness = 4
	grid.ScrollingDirection = Enum.ScrollingDirection.Y
	grid.AutomaticCanvasSize = Enum.AutomaticSize.Y
	grid.CanvasSize = UDim2.new()
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.new(1 / 3, -6, 0, NODE_H + 4)
	layout.CellPadding = UDim2.fromOffset(4, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = grid
	if not partyUnits then partyUnits = c.getUnits() end
	local res = partyUnits
	for i, u in (res and res.units) or {} do
		local on = picked[u.id] == true
		local b = Instance.new("TextButton")
		b.Name = "Unit_" .. tostring(u.id)
		b.Text = ""
		b.AutoButtonColor = false
		b.BackgroundColor3 = if on then Theme.Colors.SelectedItem else Theme.Colors.Surface
		b.BackgroundTransparency = 0.2
		b.BorderSizePixel = 0
		b.LayoutOrder = i
		corner(b)
		if on then stroke(b, Theme.Colors.TextGold, 2) end
		local nm = makeText(b, `{u.name or "?"}  Lv.{u.unitLevel or "?"}`, ts(), Theme.Colors.TextPrimary, true)
		nm.TextWrapped = false
		nm.TextTruncate = Enum.TextTruncate.AtEnd
		nm.Size = UDim2.new(1, -10, 0, ts() + 2)
		nm.Position = UDim2.fromOffset(5, 4)
		local hp = makeText(b, `HP {u.hp or 0}/{u.maxHp or 0}`, ts(), Theme.Colors.TextSecondary)
		hp.Font = Theme.Font.Mono
		hp.Size = UDim2.new(1, -10, 0, ts() + 2)
		hp.Position = UDim2.fromOffset(5, ts() + 8)
		if u.away then
			local dim = Instance.new("Frame")
			dim.Size = UDim2.fromScale(1, 1)
			dim.BackgroundColor3 = Color3.new(0, 0, 0)
			dim.BackgroundTransparency = DIM
			dim.BorderSizePixel = 0
			dim.ZIndex = 5
			corner(dim)
			-- DG-AWAY-DUNGEON / DG-AWAY-DISPATCH (approved)
			local tag = makeText(dim, if u.awayReason == "dungeon" then "Exploring a dungeon" else "AWAY", ts(), Theme.Colors.TextPrimary, true)
			tag.TextXAlignment = Enum.TextXAlignment.Right
			tag.TextYAlignment = Enum.TextYAlignment.Bottom
			tag.Size = UDim2.new(1, -6, 1, -3)
			tag.ZIndex = 6
			dim.Parent = b
		else
			local id = u.id
			b.Activated:Connect(function()
				if picked[id] then picked[id] = nil
				elseif pickedCount() < MAX_PARTY then picked[id] = true end
				render()
			end)
		end
		b.Parent = grid
	end
	grid.Parent = main
end

local function confirmEnter()
	local card = pickedCard
	local n = pickedCount()
	if not card or n < 1 or not screen then return end
	popup("EnterConfirm", {
		{ `Enter {card.biome} with {n} units? No healing or refills between battles.` }, -- DG-START-CONFIRM
	}, {
		{ text = "Stay", style = "Secondary", onTap = closeOverlay },                   -- DG-ESCAPE-NO
		{ text = "Enter", style = "Primary", onTap = function()                          -- DG-START
			closeOverlay()
			local ids: { string } = {}
			for id in picked do table.insert(ids, id) end
			table.sort(ids)
			if act({ action = "Start", cardId = card.id, unitIds = ids }) then
				pickedCard = nil
				picked = {}
				view = "map"
			end
			render()
		end },
	})
end

--------------------------------------------------
-- MAP
--------------------------------------------------

local function bagLines(): { any }
	local b = (st and st.run and st.run.bag) or {}
	return {
		{ "Kept if you leave early", body(), Theme.Colors.Success, true },           -- DG-BAG-SAFE
		{ `Gold {b.gold or 0} (75% kept if you leave early)` },                        -- DG-BAG-GOLD
		{ `Materials {b.normalMats or 0}` },                                            -- DG-BAG-MATS
		{ "Lost if you leave early", body(), Theme.Colors.Danger, true },              -- DG-BAG-RISK
		{ `Elite/Boss materials {b.eliteMats or 0}` },                                  -- DG-BAG-ELITEMATS
		{ `Gear {b.gear or 0}` },                                                       -- DG-BAG-GEAR
		{ `Cards {b.cards or 0}` },                                                     -- DG-BAG-CARDS
	}
end

local function goHome()
	closeOverlay()
	act({ action = "Escape" })
	render()
end

local function confirmLeave()
	popup("LeaveConfirm", {
		{ "Leave the dungeon?", Theme.Text.Heading(), Theme.Colors.TextGold, true },      -- DG-ESCAPE-CONFIRM-T
		{ "You keep: unit EXP, 75% of gold, normal materials." },                         -- DG-ESCAPE-CONFIRM-1
		{ "You lose: Elite/Boss materials, gear and cards." },                            -- DG-ESCAPE-CONFIRM-2
		{ "Leave from a Rest room or beat the Boss to keep everything." },                  -- DG-ESCAPE-CONFIRM-3
	}, {
		{ text = "Stay", style = "Secondary", onTap = closeOverlay },                      -- DG-ESCAPE-NO
		{ text = "Leave", style = "Primary", onTap = function()                             -- DG-ESCAPE-YES
			closeOverlay()
			act({ action = "Leave" })
			render()
		end },
	})
end

local function showRoomPanel(n: any)
	if not n or not st or not st.run then return end
	local cleared = isCleared(n.id)
	if shownType(n) == "Rest" then
		local btns: { any } = {}
		if not cleared then
			table.insert(btns, { text = "Keep exploring", style = "Secondary", onTap = function() -- DG-ESCROOM-STAY (reused)
				closeOverlay()
				act({ action = "Continue" })
				render()
			end })
			table.insert(btns, { text = "Rest", style = "Secondary", onTap = function()      -- DG-REST-HEAL
				closeOverlay()
				act({ action = "Rest" })
				render()
			end })
		end
		-- Rest leave = full escape, all loot home (USER RULING 2026-11-13 10:08 PM).
		table.insert(btns, { text = "Go home with all loot", style = "Primary", onTap = goHome }) -- DG-REST-LEAVE
		if cleared then table.insert(btns, 1, { icon = "Back", onTap = closeOverlay }) end
		popup("RestPanel", {
			{ "Rest", Theme.Text.Heading(), Theme.Colors.TextGold, true },                     -- DG-REST-T
			{ `Your party heals {st.run.restHealPct or "?"}% HP and MP. Fallen units return at 1 HP.` }, -- DG-REST-1
		}, btns)
	end
end

local function arrive(n: any)
	if not n then return end
	local c = ctx
	if n.played == "Battle" or n.played == "Elite" or n.played == "Boss" then
		if c and not isCleared(n.id) then c.launchBattle() end
	elseif shownType(n) == "Treasure" and not isCleared(n.id) then
		local res = act({ action = "Treasure" })
		render()
		-- Only when the server confirms the item (Tester thread-7492a118c395): a refused call shows
		-- the server error in the status line instead of a false "You found" popup.
		if not (res and res.ok and type(res.treasure) == "table") then return end
		local name = res.treasure.itemName or "an item"
		popup("TreasurePanel", {
			{ "Treasure", Theme.Text.Heading(), Theme.Colors.TextGold, true },                 -- DG-TREASURE-T
			{ `You found {name}! It's in your bag.` },                                         -- DG-TREASURE-1
		}, { { icon = "Back", onTap = closeOverlay } })
	elseif shownType(n) == "Event" and not isCleared(n.id) then -- step 7a: the event (a fight launches the battle)
		EventPanel.Open({ gui = screen.Gui, act = act, onFight = function() if c then c.launchBattle() end end,
			onDone = function() render() end })
	elseif shownType(n) == "Merchant" and not isCleared(n.id) then
		MerchantPanel.Open({ gui = screen.Gui, act = act, setStatus = function(t, e) screen.SetStatus(t, e) end, -- step 6
			onLeave = function() act({ action = "Continue" }); render() end })
	else
		showRoomPanel(n)
	end
end

local function buildMap()
	local run = st.run
	local main = screen.Main
	local here = nodeOf(run.at)
	local floorN = if here then math.min(here.row, run.floors) else 1
	local info = Instance.new("Frame")
	info.Name = "Info"
	info.BackgroundTransparency = 1
	info.Size = UDim2.new(1, 0, 0, NODE_H)
	local fl = makeText(info, `Floor {floorN}/{run.floors}`, body(), Theme.Colors.TextGold, true) -- DG-FLOOR
	fl.Size = UDim2.new(0.25, 0, 1, 0)
	local hint = makeText(info, "Tap a glowing room to go there.", ts(), Theme.Colors.TextSecondary) -- DG-PICK
	hint.TextXAlignment = Enum.TextXAlignment.Center
	hint.Position = UDim2.fromScale(0.25, 0)
	hint.Size = UDim2.new(0.5, 0, 1, 0)
	local loot = Instance.new("TextButton")
	loot.Name = "Loot"
	loot.Text = ""
	loot.AutoButtonColor = false
	loot.BackgroundTransparency = 1
	loot.AnchorPoint = Vector2.new(1, 0)
	loot.Position = UDim2.fromScale(1, 0)
	loot.Size = UDim2.new(0.25, 0, 1, 0)
	local lt = makeText(loot, string.format("Loot ×%.2f", run.dropMultiplier or 1), body(), Theme.Colors.TextPrimary, true) -- DG-DROPRATE
	lt.TextXAlignment = Enum.TextXAlignment.Right
	lt.Size = UDim2.fromScale(1, 1)
	loot.Activated:Connect(function()
		if screen then screen.SetStatus("Loot grows with every battle you win, up to ×2.5.") end -- DG-DROPRATE-HELP
	end)
	loot.Parent = info
	info.Parent = main

	local grid = Instance.new("ScrollingFrame")
	grid.Name = "Grid"
	grid.Position = UDim2.fromOffset(0, NODE_H + 2)
	grid.Size = UDim2.new(1, 0, 1, -(NODE_H + 2))
	grid.BackgroundTransparency = 1
	grid.BorderSizePixel = 0
	grid.ScrollBarThickness = 4
	grid.ScrollingDirection = Enum.ScrollingDirection.Y
	local rows = run.floors + 1
	local canvasH = (rows - 1) * ROW_STEP + BOSS_D + MAP_PAD * 2 -- top and bottom padding: no row cut off
	grid.CanvasSize = UDim2.fromOffset(0, canvasH)

	local W = math.max(240, main.AbsoluteSize.X - 8) -- fit the width; vertical scroll for the rest
	local width = run.width or 4
	local colW = W / width
	local d = math.max(44, math.min(ROOM_D, colW - 10))
	local legal: { [string]: boolean } = {}
	for _, id in run.next do legal[id] = true end
	local pos: { [string]: Vector2 } = {}
	for _, n in run.nodes do
		local x = if n.id == "boss" then W / 2 else (n.col - 0.5) * colW
		local y = MAP_PAD + BOSS_D / 2 + (rows - n.row) * ROW_STEP
		pos[n.id] = Vector2.new(x, y)
	end
	-- Paths first, at the lowest ZIndex, so they run BEHIND the rooms.
	for _, n in run.nodes do
		local a = pos[n.id]
		for _, nid in n.next do
			local q = pos[nid]
			if a and q then
				local dv = q - a
				local hot = n.id == run.at and legal[nid]
				local line = Instance.new("Frame")
				line.Name = "Path"
				line.AnchorPoint = Vector2.new(0.5, 0.5)
				line.Position = UDim2.fromOffset((a.X + q.X) / 2, (a.Y + q.Y) / 2)
				line.Size = UDim2.fromOffset(dv.Magnitude, if hot then 3 else 2)
				line.Rotation = math.deg(math.atan2(dv.Y, dv.X))
				line.BorderSizePixel = 0
				line.BackgroundColor3 = if hot then Theme.Colors.TextGold else Theme.Colors.Border
				line.BackgroundTransparency = if hot then 0 else 0.3
				line.ZIndex = 1
				line.Parent = grid
			end
		end
	end
	for _, n in run.nodes do
		local p = pos[n.id]
		local isHere = n.id == run.at
		local done = isCleared(n.id)
		local glow = legal[n.id] == true
		local t = shownType(n)
		local size = if n.id == "boss" then BOSS_D else d
		local col = Theme.DungeonRoomColors[t] or Theme.DungeonRoomColors.Battle
		local icon = Theme.DungeonRoomIcons[t] or ""
		local fade = done and not isHere
		local btn = Instance.new("TextButton")
		btn.Name = "Room_" .. n.id
		btn.Text = ""
		btn.AutoButtonColor = false
		btn.AnchorPoint = Vector2.new(0.5, 0.5)
		btn.Position = UDim2.fromOffset(p.X, p.Y)
		btn.Size = UDim2.fromOffset(size, size)
		btn.BackgroundColor3 = if icon == "" then col else Theme.Colors.PanelRaised
		btn.BackgroundTransparency = if fade then 0.65 else (if icon == "" then 0.15 else 0.05)
		btn.BorderSizePixel = 0
		btn.ZIndex = 3
		corner(btn, UDim.new(0.5, 0))
		-- Ring: type colour; gold when you can go there; white on the room you're in.
		local ringCol = if glow then Theme.Colors.TextGold elseif isHere then Theme.Colors.TextPrimary else col
		local ring = Instance.new("UIStroke")
		ring.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		ring.Color = ringCol
		ring.Thickness = if glow or isHere then 3 else 2
		ring.Transparency = if fade then 0.6 else 0
		ring.Parent = btn
		if icon ~= "" then
			local img = Instance.new("ImageLabel")
			img.Name = "Icon"
			img.BackgroundTransparency = 1
			img.AnchorPoint = Vector2.new(0.5, 0.5)
			img.Position = UDim2.fromScale(0.5, 0.5)
			img.Size = UDim2.fromScale(0.8, 0.8)
			img.Image = icon
			img.ScaleType = Enum.ScaleType.Fit
			img.ImageTransparency = if fade then 0.6 else 0
			img.ZIndex = 4
			img.Parent = btn
		else
			-- Fallback until the art is uploaded: coloured circle + the approved one-word label.
			local label = makeText(btn, ROOM_LABEL[t] or "?", 10, Theme.Colors.TextPrimary, true)
			label.TextXAlignment = Enum.TextXAlignment.Center
			label.TextWrapped = false
			label.AnchorPoint = Vector2.new(0.5, 0.5)
			label.Position = UDim2.fromScale(0.5, 0.5)
			label.Size = UDim2.new(1, -4, 0, 12)
			label.TextTransparency = if fade then 0.5 else 0
			label.ZIndex = 4
		end
		local sub = if isHere then "You are here" elseif done then "Cleared" else nil -- DG-HERE / DG-CLEARED
		if sub then
			local sl = makeText(grid, sub, 10, if isHere then Theme.Colors.TextGold else Theme.Colors.TextSecondary, isHere)
			sl.TextWrapped = false
			sl.AnchorPoint = Vector2.new(0, 0.5)
			sl.Position = UDim2.fromOffset(p.X + size / 2 + 3, p.Y)
			sl.Size = UDim2.fromOffset(math.max(40, colW / 2 - size / 2 - 4), 12)
			sl.ZIndex = 4
		end
		local nid = n.id
		btn.Activated:Connect(function()
			if glow then
				if act({ action = "Move", nodeId = nid }) then
					render()
					arrive(nodeOf(nid))
				end
			elseif isHere then
				arrive(nodeOf(nid)) -- re-open the room (e.g. a battle left unfinished)
			end
		end)
		btn.Parent = grid
	end

	-- Map key (legend): toggled by a 44 px swatch button, no new text (labels = the approved names).
	local keyBtn = Instance.new("TextButton")
	keyBtn.Name = "KeyToggle"
	keyBtn.Text = ""
	keyBtn.AutoButtonColor = false
	keyBtn.AnchorPoint = Vector2.new(0, 1)
	keyBtn.Position = UDim2.new(0, 2, 1, -2)
	keyBtn.Size = UDim2.fromOffset(NODE_H, NODE_H)
	keyBtn.BackgroundColor3 = Theme.Colors.PanelRaised
	keyBtn.BackgroundTransparency = 0.1
	keyBtn.BorderSizePixel = 0
	keyBtn.ZIndex = 8
	corner(keyBtn)
	stroke(keyBtn, if legendOpen then Theme.Colors.TextGold else Theme.Colors.Border, 2)
	for i = 1, 4 do
		local sw = Instance.new("Frame")
		sw.Size = UDim2.fromOffset(12, 12)
		sw.Position = UDim2.fromOffset(if i % 2 == 1 then 8 else 24, if i <= 2 then 8 else 24)
		sw.BackgroundColor3 = Theme.DungeonRoomColors[KEY_ORDER[({ 1, 4, 6, 8 })[i]]]
		sw.BorderSizePixel = 0
		sw.ZIndex = 9
		corner(sw, UDim.new(0.5, 0))
		sw.Parent = keyBtn
	end
	keyBtn.Activated:Connect(function()
		legendOpen = not legendOpen
		render()
	end)
	keyBtn.Parent = main
	if legendOpen then
		local panel = Instance.new("Frame")
		panel.Name = "MapKey"
		panel.AnchorPoint = Vector2.new(0, 1)
		panel.Position = UDim2.new(0, NODE_H + 8, 1, -2)
		panel.Size = UDim2.fromOffset(2 * 104 + 12, 4 * 26 + 10)
		panel.BackgroundColor3 = Theme.Colors.PanelRaised
		panel.BackgroundTransparency = 0.05
		panel.BorderSizePixel = 0
		panel.ZIndex = 8
		corner(panel)
		stroke(panel, Theme.Colors.Border, 1)
		for i, kt in KEY_ORDER do
			local cx = 6 + ((i - 1) // 4) * 104
			local cy = 5 + ((i - 1) % 4) * 26
			local dot = Instance.new("Frame")
			dot.Size = UDim2.fromOffset(20, 20)
			dot.Position = UDim2.fromOffset(cx, cy + 2)
			dot.BackgroundColor3 = Theme.DungeonRoomColors[kt]
			dot.BorderSizePixel = 0
			dot.ZIndex = 9
			corner(dot, UDim.new(0.5, 0))
			local ic = Theme.DungeonRoomIcons[kt]
			if ic ~= "" then
				local img = Instance.new("ImageLabel")
				img.BackgroundTransparency = 1
				img.Size = UDim2.fromScale(1, 1)
				img.Image = ic
				img.ScaleType = Enum.ScaleType.Fit
				img.ZIndex = 10
				img.Parent = dot
			end
			dot.Parent = panel
			local kl = makeText(panel, ROOM_LABEL[kt], ts(), Theme.Colors.TextPrimary)
			kl.TextWrapped = false
			kl.Position = UDim2.fromOffset(cx + 24, cy)
			kl.Size = UDim2.fromOffset(76, 24)
			kl.ZIndex = 9
		end
		panel.Parent = main
	end
	grid.Parent = main -- parent last (NET-004): rooms and paths are added before the grid goes live

	-- Redraw when the width changes (rotate / resize). The connection lives on the grid, which is
	-- destroyed by the next render, so nothing leaks.
	local drawnW = main.AbsoluteSize.X
	grid:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if math.abs(main.AbsoluteSize.X - drawnW) > 2 then
			drawnW = main.AbsoluteSize.X
			task.defer(render)
		end
	end)

	-- Scroll so the current floor sits in view.
	local focusY = if here then pos[here.id].Y else canvasH
	task.defer(function()
		if grid.Parent then
			grid.CanvasPosition = Vector2.new(0, math.clamp(focusY - grid.AbsoluteSize.Y * 0.6, 0, math.max(0, canvasH - grid.AbsoluteSize.Y)))
		end
	end)
end

--------------------------------------------------
-- RESULT
--------------------------------------------------

local function listOf(v: any, withExp: boolean): string
	local parts: { string } = {}
	if withExp then table.insert(parts, "unit EXP") end
	if not v then return table.concat(parts, ", ") end
	if (v.normalMats or 0) > 0 then table.insert(parts, `Materials {v.normalMats}`) end
	if (v.eliteMats or 0) > 0 then table.insert(parts, `Elite/Boss materials {v.eliteMats}`) end
	if (v.gear or 0) > 0 then table.insert(parts, `Gear {v.gear}`) end
	if (v.cards or 0) > 0 then table.insert(parts, `Cards {v.cards}`) end
	return if #parts > 0 then table.concat(parts, ", ") else "-"
end

local function showResult(r: any)
	local titles = {
		Boss = "Boss defeated! All loot comes home.",     -- DG-END-BOSS
		EscapeNode = "You made it out. All loot comes home.", -- DG-END-ESCROOM
		EarlyEscape = "You left early.",                  -- DG-END-EARLY
		Wipeout = "Your party fell.",                     -- DG-END-WIPE
	}
	local lines: { any } = {
		{ titles[r.kind] or "", Theme.Text.Heading(), Theme.Colors.TextGold, true },
		{ `+{(r.kept and r.kept.gold) or 0} gold ({r.goldPct or 100}% kept)` },  -- DG-END-GOLD
		{ `Kept: {listOf(r.kept, true)}` },                                       -- DG-END-KEPT
	}
	local lostTxt = listOf(r.lost, false)
	if lostTxt ~= "-" then table.insert(lines, { `Lost: {lostTxt}`, nil, Theme.Colors.Danger }) end -- DG-END-LOST
	popup("Result", lines, {
		{ text = "Back to base", style = "Primary", onTap = function()            -- DG-END-OK
			closeOverlay()
			act({ action = "AckResult" })
			view = "board"
			render()
		end },
	})
end

--------------------------------------------------
-- BUTTONS
--------------------------------------------------

local function iconButton(row: Instance, kind: string, name: string, order: number, onTap: () -> ())
	local b = Theme.MakeIconButton(nil, kind, onTap, {
		name = name, size = UDim2.fromOffset(GuildScreen.ROW_H, GuildScreen.ROW_H) })
	b.LayoutOrder = order
	b.Parent = row
end

local function buildButtons()
	local c = ctx
	if not c then return end
	local row = Instance.new("Frame")
	row.Name = "Row1"
	row.Size = UDim2.new(1, 0, 0, GuildScreen.ROW_H)
	row.BackgroundTransparency = 1
	row.BorderSizePixel = 0
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Padding = UDim.new(0, GuildScreen.ROW_GAP)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = row
	iconButton(row, "Help", "Btn_Help", 1, function()
		local lines: { any } = {}
		for _, h in HELP do table.insert(lines, { `•  {h}` }) end
		popup("DungeonHelp", lines, { { icon = "Back", onTap = closeOverlay } })
	end)
	if view == "map" then
		Theme.MakeBarButton(row, "Bag", "Secondary", function()                    -- DG-BAG
			popup("Bag", bagLines(), { { icon = "Back", onTap = closeOverlay } })
		end, { name = "Btn_Bag", minHeight = GuildScreen.ROW_H, layoutOrder = 2 })
		Theme.MakeBarButton(row, "Leave", "Primary", confirmLeave,                  -- DG-ESCAPE-BTN
			{ name = "Btn_Leave", minHeight = GuildScreen.ROW_H, layoutOrder = 3 })
	elseif view == "party" then
		Theme.MakeBarButton(row, "Enter", if pickedCount() > 0 then "Primary" else "Disabled", confirmEnter, -- DG-START
			{ name = "Btn_Enter", minHeight = GuildScreen.ROW_H, layoutOrder = 3 })
	end
	iconButton(row, "Back", "Btn_BACK", 4, function()
		if view == "party" then
			view = "board"
			render()
		else
			c.requestBack(DungeonScreen.Close)
		end
	end)
	row.Parent = screen.Buttons
end

render = function()
	local c = ctx
	if not c or not screen or not isOpen then return end
	if st and st.run then view = "map"
	elseif view == "map" then view = "board" end
	screen.Clear(view)
	if view == "board" then buildBoard()
	elseif view == "party" then buildParty()
	elseif st and st.run then buildMap() end
	buildButtons()
	if st and st.result and not overlay then showResult(st.result) end
end

--------------------------------------------------
-- PUBLIC (same shape as the other guild screens)
--------------------------------------------------

function DungeonScreen.Init(c: Context)
	ctx = c
end

function DungeonScreen.IsOpen(): boolean
	return isOpen
end

function DungeonScreen.GetGui(): ScreenGui?
	return if isOpen and screen then screen.Gui else nil
end

--- Fetch fresh state; returns it (the opener checks the facility level before opening).
function DungeonScreen.Refresh(): any?
	local c = ctx
	if not c then return nil end
	local res = c.action({ action = "State" })
	if res then st = res end
	return res
end

function DungeonScreen.Open()
	local c = ctx
	if not c then
		warn("[DungeonScreen] Open called before Init")
		return
	end
	if not screen then
		screen = GuildScreen.Create({ name = "DungeonScreen", title = "DUNGEON", parent = c.parent, fullMain = true }) -- DG-TITLE
		screen.SetButtonRows(1)
	end
	isOpen = true
	closeOverlay()
	screen.SetStatus("")
	screen.Show()
	DungeonScreen.Refresh()
	view = if st and st.run then "map" else "board"
	task.defer(function()
		render() -- after layout, so the map knows its width
		-- Back from a battle that didn't clear its room: nothing to do. A non-battle room the
		-- player stands on (e.g. after a reload) shows its panel once.
		if st and st.run and st.run.at and shownRoom ~= st.run.at then
			shownRoom = st.run.at
			local n = nodeOf(st.run.at)
			if n and shownType(n) == "Rest" then showRoomPanel(n) end
		end
	end)
end

function DungeonScreen.Close()
	if not isOpen then return end
	isOpen = false
	closeOverlay()
	if screen then screen.ClosePrompt(); screen.Hide() end
	local c = ctx
	if c then c.onClosed() end
end

function DungeonScreen.Hide()
	if not isOpen then return end
	isOpen = false
	closeOverlay()
	if screen then screen.ClosePrompt(); screen.Hide() end
end

function DungeonScreen.Render()
	render()
end

function DungeonScreen.SetGold(text: string)
	if screen then screen.SetGold(text) end
end

function DungeonScreen.SetStatus(text: string, isError: boolean?)
	if screen then screen.SetStatus(text, isError) end
end

-- Test hooks for the scripted Studio check (simulated taps do not register): same paths as taps.
DungeonScreen._Test = table.freeze({
	state = function() return st end,
	view = function() return view end,
	pickCard = function(cardId: string)
		for _, c in (st and st.choices) or {} do
			if c.id == cardId and not c.used then pickedCard = c; picked = {}; partyUnits = nil; view = "party"; render() end
		end
	end,
	pickUnit = function(id: string) picked[id] = true; render() end,
	enter = function() confirmEnter() end,
	move = function(nodeId: string)
		if act({ action = "Move", nodeId = nodeId }) then render(); arrive(nodeOf(nodeId)) end
	end,
	leave = function() confirmLeave() end,
	tapHere = function() if st and st.run and st.run.at then arrive(nodeOf(st.run.at)) end end, -- = tap the room you stand on
	tapOverlayButton = function(index: number)
		local f = overlay and overlayTaps[index]
		if not f then return false end
		f()
		return true
	end,
	overlayName = function() return overlay and overlay.Name or nil end,
	closeOverlay = closeOverlay,
})

return table.freeze(DungeonScreen)

		-- Primary stats
		baseStats = {
			STR = unit.baseStats.STR, AGI = unit.baseStats.AGI,
			INT = unit.baseStats.INT, VIT = unit.baseStats.VIT,
			DEX = unit.baseStats.DEX, LUK = unit.baseStats.LUK,
		},
		effectiveStats = {
			STR = unit.effectiveStats.STR, AGI = unit.effectiveStats.AGI,
			INT = unit.effectiveStats.INT, VIT = unit.effectiveStats.VIT,
			DEX = unit.effectiveStats.DEX, LUK = unit.effectiveStats.LUK,
		},
		derivedStats = StatCalcService.BuildDisplay(unit, "permanent") or {}, -- panel values (2026-10-28)
		statAllocation = unit.statAllocation or {},
		unallocatedPoints = getUnallocatedPoints(unit),
		-- Resources
		currentHp = unit.currentHp, maxHp = unit.maxHp,
		currentMp = unit.currentMp, maxMp = unit.maxMp,
		-- Race
		raceId = unit.raceId,
		raceName = raceEntry and raceEntry.name or nil,
		-- Current player-chosen 2D portrait (nil = none). Lets the Info-tab picker
		-- highlight the selected face.
		portraitAssetId = unit.portraitAssetId or nil,
		-- Current player-chosen body tint {r,g,b} (nil = none) for the swatch picker.
		bodyColor = unit.bodyColor or nil,
		racePassiveName = raceEntry and raceEntry.passiveName or nil,
		racePassiveEffect = raceEntry and raceEntry.passiveEffect or nil,
		-- Doctrine
		doctrineId = unit.doctrineId,
		doctrineName = docEntry and docEntry.name or nil,
		doctrinePassiveName = docEntry and docEntry.passiveName or nil,
		doctrinePassiveEffect = docEntry and docEntry.passiveEffect or nil,
		-- Personal perk + flaw (2026-10-20)
		perkName = perkEntry and perkEntry.name or nil,
		perkEffect = perkEntry and perkEntry.effect or nil,
		flawName = flawEntry and flawEntry.name or nil,
		flawEffect = flawEntry and flawEntry.effect or nil,
		-- Every passive from equipped gear, merged (2026-10-29). Same builder as the battle inspector.
		gearPassives = GearPassiveSummary.Build(unit),
	}
end

BattleEvents.GetEquipmentComparison.OnServerInvoke = function(player, unitId, instanceId)
	local unit = playerUnits[unitId]
	if not unit then return { ok = false, reason = "Unknown unit" } end
	local item = InventoryService.GetItem(PLAYER_ID, instanceId)
	if not item then return { ok = false, reason = "Item not found" } end
	-- Snapshot current stats
	local before = {
		STR = unit.effectiveStats.STR, AGI = unit.effectiveStats.AGI,
		INT = unit.effectiveStats.INT, VIT = unit.effectiveStats.VIT,
		DEX = unit.effectiveStats.DEX, LUK = unit.effectiveStats.LUK,
		maxHp = unit.maxHp, maxMp = unit.maxMp,
		weaponDamage = unit.weaponDamage, weaponWt = unit.weaponWt,
		weaponDefense = unit.weaponDefense,
		armorDefense = unit.armorDefense or 0,
		armorWt = unit.armorWt or 0,
	}
	-- Determine target slot
	local slot = EquipmentService.DetermineSlot(item)
	if not slot then return { ok = false, reason = "Cannot determine slot" } end
	-- Save current equipped item in that slot
	local savedItem = unit.equipmentSlots and unit.equipmentSlots[slot] or nil
	-- Temporarily equip the new item
	if not unit.equipmentSlots then unit.equipmentSlots = {} end
	unit.equipmentSlots[slot] = item
	EquipmentService.RebuildUnitStats(unit)
	-- Snapshot after
	local after = {
		STR = unit.effectiveStats.STR, AGI = unit.effectiveStats.AGI,
		INT = unit.effectiveStats.INT, VIT = unit.effectiveStats.VIT,
		DEX = unit.effectiveStats.DEX, LUK = unit.effectiveStats.LUK,
		maxHp = unit.maxHp, maxMp = unit.maxMp,
		weaponDamage = unit.weaponDamage, weaponWt = unit.weaponWt,
		weaponDefense = unit.weaponDefense,
		armorDefense = unit.armorDefense or 0,
		armorWt = unit.armorWt or 0,
	}
	-- Restore original
	unit.equipmentSlots[slot] = savedItem
	EquipmentService.RebuildUnitStats(unit)
	-- Compute deltas
	local deltas = {}
	for key, val in pairs(after) do
		local diff = val - (before[key] or 0)
		if diff ~= 0 then
			deltas[key] = diff
		end
	end
	return { ok = true, slot = slot, before = before, after = after, deltas = deltas }
end

BattleEvents.GetDoctrineComparison.OnServerInvoke = function(player, unitId, newDoctrineId)
	local unit = playerUnits[unitId]
	if not unit then return { ok = false, reason = "Unknown unit" } end
	local newDoc = DoctrineData[newDoctrineId]
	if not newDoc then return { ok = false, reason = "Unknown doctrine" } end
	-- Snapshot current
	local before = {
		STR = unit.effectiveStats.STR, AGI = unit.effectiveStats.AGI,
		INT = unit.effectiveStats.INT, VIT = unit.effectiveStats.VIT,
		DEX = unit.effectiveStats.DEX, LUK = unit.effectiveStats.LUK,
		maxHp = unit.maxHp, maxMp = unit.maxMp,
		doctrineName = unit.doctrineId and DoctrineData[unit.doctrineId] and DoctrineData[unit.doctrineId].name or "none",
	}
	-- Temporarily swap doctrine
	local savedDoc = unit.doctrineId
	unit.doctrineId = newDoctrineId
	EquipmentService.RebuildUnitStats(unit)
	local after = {
		STR = unit.effectiveStats.STR, AGI = unit.effectiveStats.AGI,
		INT = unit.effectiveStats.INT, VIT = unit.effectiveStats.VIT,
		DEX = unit.effectiveStats.DEX, LUK = unit.effectiveStats.LUK,
		maxHp = unit.maxHp, maxMp = unit.maxMp,
		doctrineName = newDoc.name,
	}
	-- Restore
	unit.doctrineId = savedDoc
	EquipmentService.RebuildUnitStats(unit)
	-- Deltas
	local deltas = {}
	for _, stat in ipairs(STATS_LIST) do
		local diff = after[stat] - before[stat]
		if diff ~= 0 then deltas[stat] = diff end
	end
	local hpDiff = after.maxHp - before.maxHp
	local mpDiff = after.maxMp - before.maxMp
	if hpDiff ~= 0 then deltas.maxHp = hpDiff end
	if mpDiff ~= 0 then deltas.maxMp = mpDiff end
	return { ok = true, before = before, after = after, deltas = deltas }
end

end

--- Save-load cleanup (user ruling 2026-10-26): any equipped augment that no longer fits its
--- skill under the tags-only rule is unequipped and returned to the augment card inventory.
--- Idempotent (a second pass finds nothing). Player-side units only; enemies are generated
--- fresh from the same rule every battle. Returns the removed entries so the caller can tell
--- the player what came off ({ unitName, skillName, augmentName }).
function LoadoutRequestHandlers.UnequipIncompatibleAugments(units: any): { any }
	local removed = {}
	if type(units) ~= "table" or type(cardInventory) ~= "table" or type(cardInventory.augmentCards) ~= "table" then
		return removed
	end
	local function sweep(unit: any, skillId: any, augList: any)
		if not skillId or type(augList) ~= "table" then return end
		local weapon = AugmentCompatibility.WeaponProfileFromUnit(unit)
		for i = 1, 2 do
			local augId = augList[i]
			if augId and not AugmentCompatibility.Check(skillId, augId, weapon) then
				augList[i] = nil
				cardInventory.augmentCards[augId] = (cardInventory.augmentCards[augId] or 0) + 1
				local skillDef = SkillData[skillId]
				local augDef = AugmentData[augId]
				table.insert(removed, {
					unitName = unit.name,
					skillName = (skillDef and skillDef.name) or skillId,
					augmentName = (augDef and augDef.name) or augId,
				})
				print(`[LoadoutRequestHandlers] Unequipped {augId} from {unit.name}'s {skillId}: no longer fits (tags-only rule); returned to inventory`)
			end
		end
		-- Conflict rule (user ruling 2026-10-28): a skill holding two conflicting augments keeps the
		-- one in augment slot 1; the other goes back to the inventory.
		-- Locked 2nd slot (USER DECISION 2026-11-04): the augment goes back to storage.
		if augList[2] and not TrainingGroundsService.IsSlot2Open(unit) then
			local locked = augList[2]
			augList[2] = nil
			cardInventory.augmentCards[locked] = (cardInventory.augmentCards[locked] or 0) + 1
			local skillDef = SkillData[skillId]
			local augDef = AugmentData[locked]
			table.insert(removed, {
				unitName = unit.name,
				skillName = (skillDef and skillDef.name) or skillId,
				augmentName = (augDef and augDef.name) or locked,
				lockedSlot = true,
			})
			print(`[LoadoutRequestHandlers] Moved {locked} from {unit.name}'s {skillId} to storage: 2nd augment slot is locked`)
		end
		local first, second = augList[1], augList[2]
		if first and second and AugmentCompatibility.ConflictsWith(first, second) then
			augList[2] = nil
			cardInventory.augmentCards[second] = (cardInventory.augmentCards[second] or 0) + 1
			local skillDef = SkillData[skillId]
			local augDef = AugmentData[second]
			table.insert(removed, {
				unitName = unit.name,
				skillName = (skillDef and skillDef.name) or skillId,
				augmentName = (augDef and augDef.name) or second,
			})
			print(`[LoadoutRequestHandlers] Unequipped {second} from {unit.name}'s {skillId}: conflicts with {first}; returned to inventory`)
		end
	end
	for _, unit in units do
		if type(unit) == "table" and unit.side == "Player" and not unit.isSummon then
			sweep(unit, unit.selectedDoctrineSkill, unit.doctrineAugments)
			for _, slotKey in ipairs({ "slot2", "slot3", "slot4" }) do
				local slot = unit.skillLoadout and unit.skillLoadout[slotKey]
				if slot then
					sweep(unit, slot.skillId, slot.augments)
				end
			end
		end
	end
	if #removed > 0 then
		markLoadoutDirty()
	end
	return removed
end

return LoadoutRequestHandlers

			makeLabel(r, { Text = l, Size = UDim2.new(0.3, 0, 1, 0), TextSize = Theme.Text.Small(), TextColor3 = Theme.Colors.TextSecondary })
			makeLabel(r, { Text = v, Size = UDim2.new(0.7, -4, 1, 0), Position = UDim2.new(0.3, 4, 0, 0),

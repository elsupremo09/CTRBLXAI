				lbl.Position = UDim2.new(0, 22, 0, 0)
				lbl.BackgroundTransparency = 1
				lbl.Font = Theme.Font.Primary
				lbl.TextSize = Theme.Text.Small()
				lbl.TextColor3 = opt.active and Theme.Colors.TextGold or Theme.Colors.TextPrimary

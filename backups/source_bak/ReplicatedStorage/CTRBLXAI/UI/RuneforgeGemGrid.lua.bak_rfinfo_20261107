--!strict
-- RuneforgeGemGrid.lua
-- CTRBLXAI | Runeforge "Gems" tab on the LEFT inventory panel (2026-11-07, user request: one
-- inventory panel with a Gears | Gems swap; the right panel only shows the forge details).
-- Split out of RuneforgeScreen (ARC-005, file size). Display + input only (ARC-001): the
-- screen decides which gems fit (its shared checkPick + the server's CheckForgeGems answer)
-- and passes ready-made cells; this module only draws them and reports taps.
--
-- Tiles: Loadout size (Theme.ItemTileCell, same as the Gears grid) built with the shared
-- Theme.MakeItemTile look. Each gem tile: name strip (name includes the tier), count badge
-- (xN, top right), point cost badge (bottom left, above the name). No icon glyph: at the 48 px
-- minimum tile the two badges fill the space above the name strip. A gem that can't be added is dimmed, takes
-- no taps and shows a short reason. Tap-only (.Activated, project_rules 243); phone sizes
-- (project_rules 244): 44 px controls, text >= 10 px.

local WAIT = 10

local themeModule = script.Parent:WaitForChild("Theme", WAIT)
if not themeModule then
	error("[RuneforgeGemGrid] Theme module not found")
end
-- Found at runtime via WaitForChild; the editor cannot follow that path (editor-only cast).
local Theme: any = (require :: any)(themeModule)

local RuneforgeGemGrid = {}

export type Cell = {
	key: string,          -- gem id
	name: string,
	rarity: string?,      -- the gem's minimum rarity (tile colour)
	countText: string?,   -- "x3"
	ptsText: string?,     -- "40 pts"
	reason: string?,      -- why it can't be added (dimmed tile)
	enabled: boolean,
	onTap: (() -> ())?,
}

export type Browse = {
	search: string,
	filter: string,       -- "All" | "Stats" | "Passives"
	fitsOnly: boolean,
}

local GRID_GAP = 4
local DIM = 0.5
local FILTERS = { "All", "Stats", "Passives" }

local function controlH(): number
	return if Theme.GetMode() == "Mobile" then Theme.MinSize.TouchTarget else Theme.MinSize.TabButton + 4
end
RuneforgeGemGrid.ControlHeight = controlH

-- Tab width that keeps its label at full size (MakeTabButton shrinks text that doesn't fit):
-- measured text + the tab art's 10 px side padding, at least the 44 px touch target.
local function tabW(text: string): number
	local w = Theme.MeasureText(text, Theme.Text.Small(), Theme.Font.PrimaryBold).X
	return math.max(Theme.MinSize.TouchTarget, math.ceil(w) + 26)
end
RuneforgeGemGrid.TabWidth = tabW

-- One row: [Search gems...][All][Stats][Passives][Fits only]. onChange(field, value).
function RuneforgeGemGrid.BuildControls(parent: Instance, order: number, browse: Browse, showFitsOnly: boolean,
	onChange: (field: string, value: any) -> ())
	local h = controlH()
	local fixedW = 4 * #FILTERS
	for _, f in FILTERS do fixedW += tabW(f) end
	if showFitsOnly then fixedW += tabW("Fits only") + 4 end
	-- W-3: the search box needs a usable width. If the row can't give it MIN_SEARCH_W next to
	-- the buttons, the search box goes on its own line above them (narrow phones).
	local MIN_SEARCH_W = 120
	local availW = if parent:IsA("GuiObject") then (parent :: GuiObject).AbsoluteSize.X else 0
	local stacked = availW > 0 and (availW - fixedW) < MIN_SEARCH_W
	local row = Instance.new("Frame")
	row.Name = "GemControls"
	row.Size = UDim2.new(1, 0, 0, if stacked then h * 2 + 4 else h)
	row.BackgroundTransparency = 1
	row.BorderSizePixel = 0
	row.LayoutOrder = order
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = if stacked then Enum.FillDirection.Vertical else Enum.FillDirection.Horizontal
	layout.Padding = UDim.new(0, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Parent = row
	local btnRow: Instance = row
	if stacked then
		local br = Instance.new("Frame")
		br.Name = "GemFilterRow"
		br.Size = UDim2.new(1, 0, 0, h)
		br.BackgroundTransparency = 1
		br.BorderSizePixel = 0
		br.LayoutOrder = 2
		local bl = Instance.new("UIListLayout")
		bl.FillDirection = Enum.FillDirection.Horizontal
		bl.Padding = UDim.new(0, 4)
		bl.SortOrder = Enum.SortOrder.LayoutOrder
		bl.VerticalAlignment = Enum.VerticalAlignment.Center
		bl.Parent = br
		br.Parent = row
		btnRow = br
	end

	local search = Instance.new("TextBox")
	search.Name = "GemSearch"
	search.Size = if stacked then UDim2.new(1, 0, 0, h) else UDim2.new(1, -fixedW, 1, 0)
	search.BackgroundColor3 = Theme.Colors.Surface
	search.BackgroundTransparency = 0.2
	search.BorderSizePixel = 0
	search.Font = Theme.Font.Primary
	search.TextSize = Theme.Text.Small()
	search.TextColor3 = Theme.Colors.TextPrimary
	search.PlaceholderText = "Search gems..."
	search.PlaceholderColor3 = Theme.Colors.TextDisabled
	search.Text = browse.search
	search.ClearTextOnFocus = false
	search.TextTruncate = Enum.TextTruncate.AtEnd
	search.LayoutOrder = 1
	local sc = Instance.new("UICorner")
	sc.CornerRadius = UDim.new(0, 3)
	sc.Parent = search
	search.FocusLost:Connect(function()
		if search.Text ~= browse.search then
			onChange("search", search.Text)
		end
	end)
	search.Parent = row

	for i, f in FILTERS do
		Theme.MakeTabButton(btnRow, f, if browse.filter == f then "Active" else "Inactive", function()
			if browse.filter ~= f then onChange("filter", f) end
		end, { name = `Btn_GemFilter_{f}`, size = UDim2.new(0, tabW(f), 1, 0), layoutOrder = 1 + i })
	end
	if showFitsOnly then
		Theme.MakeTabButton(btnRow, "Fits only", if browse.fitsOnly then "Active" else "Inactive", function()
			onChange("fitsOnly", not browse.fitsOnly)
		end, { name = "Btn_FitsOnly", size = UDim2.new(0, tabW("Fits only"), 1, 0), layoutOrder = 10 })
	end
	row.Parent = parent
end

-- White text with a black outline (readable over any tile colour).
local function outlinedLabel(parent: Instance, text: string, size: number): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.BorderSizePixel = 0
	l.Font = Theme.Font.PrimaryBold
	l.TextSize = size
	l.TextColor3 = Color3.new(1, 1, 1)
	l.TextStrokeColor3 = Color3.new(0, 0, 0)
	l.TextStrokeTransparency = 0
	l.Text = text
	l.Parent = parent
	return l
end

local function addPtsBadge(tile: Instance, text: string)
	local t = Theme.ItemTile
	local h = Theme.Text.BadgeLineH()
	local badge = Instance.new("TextLabel")
	badge.Name = "Pts"
	badge.AutomaticSize = Enum.AutomaticSize.X
	badge.Size = UDim2.new(0, 0, 0, h)
	badge.AnchorPoint = Vector2.new(0, 1)
	badge.Position = UDim2.new(0, 2, 1, -(t.NameBarHeight + 1))
	badge.BackgroundColor3 = t.CountBadgeBg
	badge.BackgroundTransparency = t.CountBadgeBgTransparency
	badge.BorderSizePixel = 0
	badge.Font = Theme.Font.Mono
	badge.TextSize = Theme.Text.Badge()
	badge.TextColor3 = Theme.Colors.TextPrimary
	badge.Text = text
	badge.ZIndex = 4
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 3)
	pad.PaddingRight = UDim.new(0, 3)
	pad.Parent = badge
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 3)
	corner.Parent = badge
	badge.Parent = tile
end

local function addReason(tile: Instance, text: string)
	local t = Theme.ItemTile
	local dim = Instance.new("Frame")
	dim.Name = "Dim"
	dim.Size = UDim2.fromScale(1, 1)
	dim.BackgroundColor3 = Color3.new(0, 0, 0)
	dim.BackgroundTransparency = DIM
	dim.BorderSizePixel = 0
	dim.Active = false
	dim.ZIndex = 5
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, t.CornerRadius)
	corner.Parent = dim
	dim.Parent = tile
	local l = outlinedLabel(tile, text, Theme.Text.Small())
	l.Name = "Reason"
	l.Size = UDim2.new(1, -4, 1, -(t.NameBarHeight + 4))
	l.Position = UDim2.fromOffset(2, 2)
	l.TextWrapped = true
	l.TextTruncate = Enum.TextTruncate.AtEnd
	l.TextXAlignment = Enum.TextXAlignment.Center
	l.TextYAlignment = Enum.TextYAlignment.Center
	l.ZIndex = 6
end

-- Fills `grid` (a ScrollingFrame named "Grid" made by the caller) with gem tiles.
-- heightHint: px grid height to use until the real height is known (UI-001).
function RuneforgeGemGrid.BuildGrid(grid: ScrollingFrame, cells: { Cell }, heightHint: number?)
	local h = grid.AbsoluteSize.Y
	if h < 100 then h = heightHint or 0 end
	local cellW, cellH = Theme.ItemTileCell(h)

	local gridPad = Instance.new("UIPadding")
	gridPad.PaddingTop = UDim.new(0, 3)
	gridPad.PaddingLeft = UDim.new(0, 3)
	gridPad.PaddingRight = UDim.new(0, 3)
	gridPad.PaddingBottom = UDim.new(0, 3)
	gridPad.Parent = grid
	local gl = Instance.new("UIGridLayout")
	gl.CellSize = UDim2.fromOffset(cellW, cellH)
	gl.CellPadding = UDim2.fromOffset(GRID_GAP, GRID_GAP)
	gl.SortOrder = Enum.SortOrder.LayoutOrder
	gl.Parent = grid
	-- Same re-fit as the Gears grid (MerchantInspector loadoutTiles); owned by the grid.
	grid:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		local gh = grid.AbsoluteSize.Y
		if gh < 100 then return end
		local w2, h2 = Theme.ItemTileCell(gh)
		if gl.CellSize.X.Offset ~= w2 or gl.CellSize.Y.Offset ~= h2 then
			gl.CellSize = UDim2.fromOffset(w2, h2)
		end
	end)

	for i, c in cells do
		local tile = Theme.MakeItemTile({
			parent = grid,
			accentColor = Theme.GetRarityColor(c.rarity or "Common"),
			cellW = cellW,
			name = c.name,
			-- A greyed tile drops its count badge so the reason has the whole upper area.
			countText = if c.reason and not c.enabled then nil else c.countText,
			layoutOrder = i,
			onClick = if c.enabled then c.onTap else nil,
		})
		tile.Name = `Gem_{c.key}`
		if not c.enabled then
			tile.Active = false        -- greyed gems take no taps
			tile.AutoButtonColor = false
		end
		-- A greyed tile shows its reason in that space instead ("over budget by N" carries the
		-- cost); at the 48 px minimum tile both don't fit above the name strip.
		if c.reason and not c.enabled then
			addReason(tile, c.reason)
		elseif c.ptsText then
			addPtsBadge(tile, c.ptsText)
		end
	end
end

return table.freeze(RuneforgeGemGrid)

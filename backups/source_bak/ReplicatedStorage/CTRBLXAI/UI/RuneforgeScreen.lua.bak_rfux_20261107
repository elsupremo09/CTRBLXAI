	lbl.Parent = parent
end

-- One tappable list row (current line / gem / pick / reroll set). Tap-only (.Activated).
local function listButton(parent: Instance, text: string, order: number, selected: boolean, enabled: boolean, onTap: () -> ())
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, 0, 0, 0)
	b.AutomaticSize = Enum.AutomaticSize.Y
	b.BackgroundColor3 = if selected then Theme.Colors.SelectedItem else Theme.Colors.PanelRaised
	b.BackgroundTransparency = if enabled then 0.1 else 0.5
	b.BorderSizePixel = 0
	b.AutoButtonColor = enabled
	b.Font = Theme.Font.Primary
	b.TextSize = Theme.Text.Small()
	b.TextColor3 = if enabled then Theme.Colors.TextPrimary else Theme.Colors.TextDisabled
	b.TextWrapped = true
	b.TextXAlignment = Enum.TextXAlignment.Left
	b.Text = text
	b.LayoutOrder = order
	local minH = Instance.new("UISizeConstraint")
	minH.MinSize = Vector2.new(0, LIST_ROW_H)
	minH.Parent = b
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.Parent = b
	local corner = Instance.new("UICorner")
	corner.CornerRadius = Theme.CornerRadius.md
	corner.Parent = b
	if selected then
		local stroke = Instance.new("UIStroke")
		stroke.Color = Theme.Colors.TextGold
		stroke.Thickness = 1.5
		stroke.Parent = b
	end
	if enabled then
		b.Activated:Connect(onTap)
	end
	b.Parent = parent
end

local function lineNames(lines: { any }?): string
	local names = {}
	for _, l in lines or {} do
		table.insert(names, tostring(l.name or l.id))
	end
	return if #names > 0 then table.concat(names, ", ") else "no bonus lines"
end

local function findItem(state: any, instanceId: string?): any?
	if not state or not instanceId then return nil end
	for _, it in state.items or {} do
		if it.instanceId == instanceId then return it end
	end
	return nil
end

local function gemInfo(state: any, gemId: string): any?
	for _, g in state.gems or {} do
		if g.id == gemId then return g end
	end
	return nil
end

local function pickedCount(gemId: string): number
	local n = 0
	for _, p in picks do
		if p.gem == gemId then n += 1 end
	end
	return n
end

-- FORGE RULE MIRROR (2026-11-06). Replays picks with the same checks, in the same order, as
-- the server's RuneforgeService.PlanForge, so the screen greys out every gem the server would
-- refuse. The server still decides (SEC-002); this only avoids a refusal after the tap.
-- ONE helper for both the gem list and revalidatePicks so the two can never disagree.
local function newForgeSim(it: any): any
	local sim = { lines = {}, passives = {}, original = {}, replaced = {}, families = {}, used = {},
		slots = (it and it.passiveSlots) or 1, count = 0 }
	for _, line in (it and it.lines) or {} do
		sim.original[line.id] = true
		if line.kind == "passive" then
			table.insert(sim.passives, { id = line.id, group = line.group })
		else
			table.insert(sim.lines, { id = line.id, family = if line.kind == "stat" then line.family else nil })
		end
	end
	return sim
end

-- Would the server accept gem `gemId` replacing `rep` (nil = new line) after the picks already
-- applied to `sim`? Returns ok and the line it really replaces (a gem of a family the item
-- already has always replaces that family's line, server rule).
local function checkPick(sim: any, state: any, gemId: string, rep: string?, fit: { [string]: any }?): (boolean, string?)
	local g = gemInfo(state, gemId)
	if not g then return false, nil end
	if (sim.used[gemId] or 0) >= (g.count or 0) then return false, nil end
	-- Gems per forge: the limit comes from the server (state.maxInstalls), never hard-coded.
	local cap = state and state.maxInstalls
	if type(cap) == "number" and sim.count >= cap then return false, nil end
	if rep ~= nil then
		if not sim.original[rep] then return false, nil end           -- line not on the item
		if sim.replaced[rep] then return false, nil end               -- already being replaced
	end
	if g.kind == "stat" then
		if g.family == nil or sim.families[g.family] then return false, nil end -- two of one family
		local same: string? = nil
		for _, l in sim.lines do
			if l.family == g.family then same = l.id end
		end
		if same then
			if rep ~= nil and rep ~= same then return false, nil end   -- must replace its family's line
			rep = same
		end
		if fit and fit[`{gemId}|{rep or ""}`] ~= nil and fit[`{gemId}|{rep or ""}`] ~= true then
			return false, nil                                         -- server: over budget / cap
		end
		return true, rep
	elseif g.kind == "passive" then
		if sim.families[gemId] then return false, nil end
		for _, ps in sim.passives do
			if ps.id == gemId then return false, nil end               -- item already has that passive
		end
		-- The replaced line comes off first, then the slot and exclusive-group checks.
		local count = 0
		for _, ps in sim.passives do
			if ps.id ~= rep then count += 1 end
		end
		if count >= sim.slots then return false, nil end              -- no free passive slot
		if g.group ~= nil then
			for _, ps in sim.passives do
				if ps.id ~= rep and ps.group == g.group then return false, nil end -- one elemental / shape change
			end
		end
		if fit and fit[`{gemId}|{rep or ""}`] ~= nil and fit[`{gemId}|{rep or ""}`] ~= true then
			return false, nil                                         -- server: over budget / cap
		end
		return true, rep
	end
	return false, nil
end

local function applyPick(sim: any, state: any, gemId: string, rep: string?)
	local g = gemInfo(state, gemId)
	if rep ~= nil then
		for i, l in sim.lines do
			if l.id == rep then table.remove(sim.lines, i); break end
		end
		for i, ps in sim.passives do
			if ps.id == rep then table.remove(sim.passives, i); break end
		end
		sim.replaced[rep] = true
	end
	if g and g.kind == "stat" then
		table.insert(sim.lines, { id = gemId, family = g.family })
		if g.family then sim.families[g.family] = true end
	elseif g then
		table.insert(sim.passives, { id = gemId, group = g.group })
		sim.families[gemId] = true
	end
	sim.used[gemId] = (sim.used[gemId] or 0) + 1
	sim.count += 1
end

-- The forge state after the current picks (all already valid).
local function simAfterPicks(state: any, it: any): any
	local sim = newForgeSim(it)
	for _, p in picks do
		local ok, rep = checkPick(sim, state, p.gem, p.replace)
		if ok then applyPick(sim, state, p.gem, rep) end
	end
	return sim
end

-- After a pick is removed, replay the remaining picks in order with the same rules and drop
-- any that are no longer valid (e.g. a passive's own gem whose line-replacing swap was just
-- undone). Returns the names of dropped gems.
local function revalidatePicks(state: any, it: any?): { string }
	local dropped = {}
	if not it then return dropped end
	local sim = newForgeSim(it)
	local kept = {}
	for _, p in picks do
		local ok, rep = checkPick(sim, state, p.gem, p.replace)
		if ok then
			applyPick(sim, state, p.gem, rep)
			table.insert(kept, { gem = p.gem, replace = rep })
		else
			local g = gemInfo(state, p.gem)
			table.insert(dropped, if g then g.name else p.gem)
		end
	end
	table.clear(picks)
	for _, p in kept do table.insert(picks, p) end
	if #dropped > 0 and screen then
		screen.SetStatus(`Removed {table.concat(dropped, ", ")}: it needed that swap`, false)
	end
	return dropped
end

local function resetPicks(instanceId: string?)
	pickFor = instanceId
	table.clear(picks)
	replaceTarget = nil
	previewRes = nil
	previewToken += 1
	previewBusy = false
	fitSig, fitMap, fitAskedSig = nil, nil, nil
	fitToken += 1
end

--------------------------------------------------
-- RENDER
--------------------------------------------------

local render: () -> () -- forward declaration (callbacks re-render)

-- Load the reroll offer OUTSIDE render (D-1 fix 2026-11-01): render never waits on the server
-- for it. Deferred so the answer can never re-enter a render that is still building.
local function startRerollFetch(instanceId: string)
	local c = ctx
	resetReroll()
	local token = rerollToken
	rerollFor = instanceId
	if not c then return end
	rerollLoading = true
	task.defer(function()
		local res = c.getRerollSets(instanceId)
		if token ~= rerollToken then return end
		rerollRes = res
		rerollLoading = false
		if isOpen then render() end
	end)
end

-- Ask the server what the current picks cost. Fast taps are coalesced into one request.
local function schedulePreview()
	local c = ctx
	previewToken += 1
	local token = previewToken
	previewRes = nil
	if not c or not pickFor or #picks == 0 then
		previewBusy = false
		return
	end
	previewBusy = true
	local iid = pickFor :: string
	local installs = table.clone(picks)
	task.delay(PREVIEW_DELAY, function()
		if token ~= previewToken or not isOpen then return end
		local res = c.preview(iid, installs)
		if token ~= previewToken then return end
		previewRes = res
		previewBusy = false
		render()
	end)
end

-- Identity of what a gem check was asked for: the item, the picks in order, the armed line.
local function pickSig(): string
	local parts = { tostring(pickFor), tostring(replaceTarget) }
	for _, p in picks do table.insert(parts, `{p.gem}>{p.replace or ""}`) end
	return table.concat(parts, "|")
end

-- Ask the server which of the gems the screen would allow are still accepted next (budget,
-- rarity / level caps). One request per pick state; fast taps coalesce like the preview.
-- Until the answer arrives nothing extra is greyed out (the server still checks on Confirm).
local function scheduleFitCheck(sig: string, candidates: { any })
	local c = ctx
	if not c or not c.checkGems or not pickFor or fitAskedSig == sig then return end
	fitAskedSig = sig
	fitToken += 1
	local token = fitToken
	local checkGems = c.checkGems :: any
	local iid = pickFor :: string
	local installs = table.clone(picks)
	local cands = table.clone(candidates)
	task.delay(PREVIEW_DELAY, function()
		if token ~= fitToken or not isOpen then return end
		local res = checkGems(iid, installs, cands)
		if token ~= fitToken then return end
		if res then
			local map = {}
			for i, cand in cands do map[`{cand.gem}|{cand.replace or ""}`] = res[i] end
			fitSig, fitMap = sig, map
			render()
		else
			fitAskedSig = nil -- e.g. "Too fast": ask again on the next redraw
		end
	end)
end

local function buildEntries(state: any, isForge: boolean): { any }
	local entries = {}
	if not state then return entries end
	for _, it in state.items or {} do
		local show = if isForge then it.forgeable == true else it.reroll ~= nil
		if show then
			table.insert(entries, {
				key = it.instanceId, detail = it.detail, name = it.name, level = it.level,
				rarity = it.rarity, price = nil, queued = false, row = it,
			})
		end
	end
	return entries
end

local function buildMain(state: any, isForge: boolean, entries: { any }, selected: any?)
	local main = screen.Main
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 4)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = main

	if state then
		if state.lockedReason then
			makeNote(main, tostring(state.lockedReason), 1, Theme.Colors.Warning, true)
		elseif isForge then
			makeNote(main, `Runeforge L{state.level}: forges items up to {state.capacity or "Uncommon"}. Pick an item, then the rune gems to install. Raising rarity costs crystals for every step.`, 1)
		else
			makeNote(main, "Items above Epic change only with sulfur rerolls (Runeforge L8 and up). You pick one of the offered sets or keep the current lines. The sulfur is paid either way.", 1)
		end
		if toolbar then toolbar.Build(main, 2, function() screen.ResetScroll(); render() end) end
		if #entries == 0 then
			makeNote(main, if toolbar and toolbar.IsFiltering() then "No items match the search or filters."
				elseif isForge then "No items that can be forged." else "No items above Epic.", 3)
		end
	end
	if #entries == 0 then return end

	local grid = Instance.new("ScrollingFrame")
	grid.Name = "Grid"
	grid.Size = UDim2.fromScale(1, 0)
	grid.BackgroundTransparency = 1
	grid.BorderSizePixel = 0
	grid.ScrollBarThickness = 4
	grid.AutomaticCanvasSize = Enum.AutomaticSize.Y
	grid.CanvasSize = UDim2.new()
	grid.LayoutOrder = 10
	local flex = Instance.new("UIFlexItem")
	flex.FlexMode = Enum.UIFlexMode.Fill
	flex.Parent = grid
	MerchantInspector.BuildGrid(grid, {
		entries = entries,
		selectedKey = if selected then selected.key else nil,
		width = math.max(240, main.AbsoluteSize.X - 6),
		onSelect = function(key: any)
			-- Tapping the same item again after a failed load retries it.
			if currentTab == "Reroll" and key == rerollFor and not rerollLoading and rerollRes == nil then
				resetReroll()
			end
			selectedKey[currentTab] = key
			render()
		end,
	})
	grid.Parent = main
end

-- Forge side panel content (inside the scroll list).
local function fillForge(list: Instance, state: any, it: any)
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end
	local locked = state.lockedReason ~= nil

	makeNote(list, "CURRENT LINES (tap one to replace it with the next gem)", nextOrder(), Theme.Colors.TextGold, true)
	if #(it.lines or {}) == 0 then
		makeNote(list, "No bonus lines yet.", nextOrder())
	end
	-- A line can be replaced by ONE gem per forge (the server refuses a second one).
	-- Lines already queued for replacement show which gem takes them; tapping undoes it.
	local queuedFor: { [string]: number } = {}
	for i, p in picks do
		if p.replace then queuedFor[p.replace] = i end
	end
	for _, line in it.lines or {} do
		local qi = queuedFor[line.id]
		if qi then
			local qg = gemInfo(state, picks[qi].gem)
			local qname = if qg then qg.name else picks[qi].gem
			listButton(list, `{line.name} -> {qname} (tap to undo)`, nextOrder(), true, not locked, function()
				table.remove(picks, qi)
				revalidatePicks(state, it)
				schedulePreview()
				render()
			end)
		else
			local armed = replaceTarget == line.id
			local label = if armed then `Replace: {line.name}` else tostring(line.name)
			listButton(list, label, nextOrder(), armed, not locked, function()
				replaceTarget = if replaceTarget == line.id then nil else line.id
				render()
			end)
		end
	end

	makeNote(list, "RUNE GEMS THAT FIT (tap to add)", nextOrder(), Theme.Colors.TextGold, true)
	local anyGem = false
	-- Every server forge rule (family, owned passive, passive slots, one elemental /
	-- attack-shape change, same-family line replacement) comes from the shared checkPick.
	local sim = simAfterPicks(state, it)
	-- Bonus-point budget and rarity / level caps: only the server knows (one formula). It is
	-- asked about every gem the rules above allow; its answer greys out the rest.
	local sig = pickSig()
	local fit = if fitSig == sig then fitMap else nil
	local candidates = {}
	for _, gid in it.compatibleGems or {} do
		local cg = gemInfo(state, gid)
		if cg and (cg.count or 0) - pickedCount(gid) > 0 then
			local ok0, rep0 = checkPick(sim, state, gid, replaceTarget)
			if ok0 then table.insert(candidates, { gem = gid, replace = rep0 }) end
		end
	end
	if not locked and #candidates > 0 then scheduleFitCheck(sig, candidates) end
	for _, gid in it.compatibleGems or {} do
		local g = gemInfo(state, gid)
		if g then
			anyGem = true
			local left = (g.count or 0) - pickedCount(gid)
			local fits, effRep = checkPick(sim, state, gid, replaceTarget, fit)
			listButton(list, `{g.name}  x{left}`, nextOrder(), false, left > 0 and not locked and fits, function()
				-- A gem of a family the item already has always replaces that line (server
				-- rule); queue it that way so the line shows "line -> gem (tap to undo)".
				table.insert(picks, { gem = gid, replace = effRep })
				replaceTarget = nil
				schedulePreview()
				render()
			end)
		end
	end
	if not anyGem then
		makeNote(list, "You have no rune gems that fit this item. Dismantle items at the Blacksmith to get gems.", nextOrder())
	end

	if #picks > 0 then
		makeNote(list, "TO INSTALL (tap to remove)", nextOrder(), Theme.Colors.TextGold, true)
		for i, p in picks do
			local g = gemInfo(state, p.gem)
			local name = if g then g.name else p.gem
			local text = name
			if p.replace then
				for _, line in it.lines or {} do
					if line.id == p.replace then text = `{name} (replaces {line.name})` end
				end
			end
			listButton(list, text, nextOrder(), false, true, function()
				table.remove(picks, i)
				revalidatePicks(state, it)
				schedulePreview()
				render()
			end)
		end
		local text
		if previewBusy then
			text = "Working out the cost..."
		elseif previewRes then
			local parts = { `Result: {previewRes.newRarity}{if previewRes.raised then " (rarity up)" else ""}` }
			table.insert(parts, `Cost: {previewRes.gold} gold + {previewRes.crystals} crystals`)
			if (previewRes.catchUp or 0) > 0 then
				table.insert(parts, `(includes {previewRes.catchUp} gold to bring its past levels up to {previewRes.newRarity})`)
			end
			if #(previewRes.replaced or {}) > 0 then
				table.insert(parts, `Destroyed (no gem back): {lineNames(previewRes.replaced)}`)
			end
			if previewRes.newName then table.insert(parts, `New name: {previewRes.newName}`) end
			if previewRes.canAfford == false then table.insert(parts, "Not enough gold or crystals.") end
			text = table.concat(parts, "\n")
		else
			text = "This combination can't be forged. See the message at the top."
		end
		makeNote(list, text, nextOrder(), Theme.Colors.TextPrimary, true)
	end
end

-- Reroll side panel content.
local function fillReroll(list: Instance, state: any, it: any)
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end
	makeNote(list, `CURRENT LINES: {lineNames(it.lines)}`, nextOrder(), Theme.Colors.TextSecondary)

	local info = it.reroll
	if not info or not info.setCount then
		makeNote(list, `{it.rarity} rerolls need Runeforge L{(info and info.unlockLevel) or 8} (yours is L{state.level or 0}).`, nextOrder(), Theme.Colors.Warning, true)
		return
	end
	if rerollFor ~= it.instanceId then
		startRerollFetch(it.instanceId)
	end
	if rerollLoading then
		makeNote(list, "Loading the reroll options...", nextOrder())
		return
	end
	local res = rerollRes
	if not res then
		makeNote(list, "Could not load the reroll options. Tap the item again to retry.", nextOrder(), Theme.Colors.Warning)
		return
	end
	makeNote(list, `Each reroll costs {res.sulfur} sulfur (you have {res.haveSulfur}). The sulfur is paid even if you keep the current lines. The options stay the same until you pay for a reroll.`, nextOrder())
	makeNote(list, "PICK ONE", nextOrder(), Theme.Colors.TextGold, true)
	listButton(list, `Keep current: {lineNames(res.current and res.current.lines)}`, nextOrder(), rerollChoice == 0, true, function()
		rerollChoice = 0
		render()
	end)
	for _, set in res.sets or {} do
		local title = if set.name then `{set.name}: ` else ""
		listButton(list, `Set {set.choice}: {title}{lineNames(set.lines)}`, nextOrder(), rerollChoice == set.choice, true, function()
			rerollChoice = set.choice
			render()
		end)
	end
end

local function buildSide(state: any, selected: any?, isForge: boolean)
	local side = screen.Side
	local tabs = Instance.new("Frame")
	tabs.Name = "SubTabs"
	tabs.Size = UDim2.new(1, 0, 0, SUBTAB_H)
	tabs.BackgroundTransparency = 1
	tabs.BorderSizePixel = 0
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.Padding = UDim.new(0, SUBTAB_GAP)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = tabs
	for i, tab in { "Forge", "Reroll" } do
		Theme.MakeTabButton(tabs, tab, if currentTab == tab then "Active" else "Inactive", function()
			if currentTab == tab then return end
			currentTab = tab
			render()
		end, {
			name = `SubTab_{tab}`,
			size = UDim2.new(0.5, -SUBTAB_GAP // 2, 1, 0),
			layoutOrder = i,
		})
	end
	tabs.Parent = side

	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "Panel"
	scroll.Size = UDim2.new(1, 0, 1, -(SUBTAB_H + SUBTAB_GAP))
	scroll.Position = UDim2.fromOffset(0, SUBTAB_H + SUBTAB_GAP)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 4
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.new()
	local pad = Instance.new("UIPadding")
	pad.PaddingRight = UDim.new(0, 8)
	pad.Parent = scroll
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 4)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = scroll

	if selected and state then
		local it = selected.row
		local tag = if it.runeForged then "  (rune-forged)" else ""
		makeNote(scroll, `{it.name}  Lv{it.level}  {it.rarity}{tag}`, -2, Theme.GetRarityColor(it.rarity or "Common"), true)
		if it.equippedBy then
			makeNote(scroll, `Equipped by {it.equippedBy}.`, -1)
		end
		local body = Instance.new("Frame")
		body.Name = "Body"
		body.Size = UDim2.new(1, 0, 0, 0)
		body.AutomaticSize = Enum.AutomaticSize.Y
		body.BackgroundTransparency = 1
		body.BorderSizePixel = 0
		body.LayoutOrder = 1
		local bodyList = Instance.new("UIListLayout")
		bodyList.Padding = UDim.new(0, 4)
		bodyList.SortOrder = Enum.SortOrder.LayoutOrder
		bodyList.Parent = body
		if isForge then
			fillForge(body, state, it)
		else
			fillReroll(body, state, it)
		end
		body.Parent = scroll
	end
	scroll.Parent = side
end

local function promptForge(it: any)
	local c = ctx
	if not c or not screen or not previewRes then return end
	local p = previewRes
	local lines = { `Forge {it.name}?` }
	table.insert(lines, `It becomes {p.newRarity}. Costs {p.gold} gold and {p.crystals} crystals.`)
	if #(p.replaced or {}) > 0 then
		table.insert(lines, `Destroyed, no gem back: {lineNames(p.replaced)}.`)
	end
	table.insert(lines, "This can't be undone.")
	local iid: string = it.instanceId
	local installs = table.clone(picks)
	screen.Prompt(table.concat(lines, "\n"), "Confirm", "Primary", function()
		commitBusy = true
		local res = c.commitForge(iid, installs)
		commitBusy = false
		if res then
			resetPicks(iid)
			c.onChanged()
		end
		render()
	end)
end

local function promptReroll(it: any)
	local c = ctx
	local res = rerollRes
	if not c or not screen or not res or rerollChoice == nil then return end
	local choice = rerollChoice :: number
	local msg = if choice == 0
		then `Pay {res.sulfur} sulfur and keep the current lines of {it.name}? The next reroll will offer new sets.`
		else `Pay {res.sulfur} sulfur and replace ALL bonus lines of {it.name} with set {choice}? This can't be undone.`
	local iid: string = it.instanceId
	screen.Prompt(msg, "Confirm", "Primary", function()
		commitBusy = true
		local done = c.commitReroll(iid, choice)
		commitBusy = false
		if done then
			resetReroll() -- the sets change after a paid reroll
			c.onChanged()
		end
		render()
	end)
end

local function buildButtons(state: any, selected: any?, isForge: boolean)
	local c = ctx
	if not c then return end
	local row = makeRow(screen.Buttons, 1)
	local it = selected and selected.row or nil
	if isForge then
		local hasPicks = #picks > 0
		iconButton(row, "Minus", "Btn_RemovePick", 1, hasPicks, function()
			table.remove(picks)
			revalidatePicks(state, it)
			schedulePreview()
			render()
		end)
		local canForge = it ~= nil and hasPicks and not previewBusy and previewRes ~= nil
			and previewRes.canAfford ~= false and state and state.lockedReason == nil
		iconButton(row, "Confirm", "Btn_Forge", 2, canForge, function()
			if it and not commitBusy then promptForge(it) end
		end)
		iconButton(row, "X", "Btn_ClearPicks", 3, hasPicks, function()
			resetPicks(pickFor)
			render()
		end)
	else
		local res = rerollRes
		local canPay = res ~= nil and (res.haveSulfur or 0) >= (res.sulfur or math.huge)
		iconButton(row, "Confirm", "Btn_Reroll", 2, it ~= nil and rerollChoice ~= nil and canPay, function()
			if it and not commitBusy then promptReroll(it) end
		end)
	end
	iconButton(row, "Back", "Btn_BACK", 10, true, function()
		RuneforgeScreen.Close()
	end)
end

render = function()
	local c = ctx
	if not c or not screen or not isOpen then return end
	renderSeq += 1
	local mySeq = renderSeq
	-- getState may wait on the server (empty cache). Fetch BEFORE clearing, and stop if a newer
	-- render started meanwhile, so two renders can never both build the screen (D-1 fix).
	local state = c.getState()
	if mySeq ~= renderSeq or not isOpen then return end
	-- R-3 (2026-11-01): an empty answer (usually the 0.2 s "Too fast" limit right after a
	-- Confirm) redraws once more shortly after, up to 3 times, instead of staying empty.
	if state == nil and stateRetries > 0 then
		stateRetries -= 1
		task.delay(STATE_RETRY_DELAY, function()
			if isOpen and mySeq == renderSeq then render() end
		end)
	elseif state ~= nil then
		stateRetries = STATE_RETRY_MAX
	end
	screen.Clear(currentTab) -- same tab keeps the grid's scroll position
	local isForge = currentTab == "Forge"
	local entries = buildEntries(state, isForge)
	if toolbar then entries = toolbar.Apply(entries) end
	local selected = MerchantInspector.ResolveSelected(entries, selectedKey[currentTab])
	local selId = if selected then selected.key else nil
	if isForge and selId ~= pickFor then
		resetPicks(selId)
	end
	if not isForge and selId ~= rerollFor then
		resetReroll()
	end
	buildMain(state, isForge, entries, selected)
	buildSide(state, selected, isForge)
	buildButtons(state, selected, isForge)
end

--------------------------------------------------
-- PUBLIC
--------------------------------------------------

function RuneforgeScreen.Init(c: Context)
	ctx = c
end

function RuneforgeScreen.IsOpen(): boolean
	return isOpen
end

function RuneforgeScreen.GetGui(): ScreenGui?
	return if isOpen and screen then screen.Gui else nil
end

function RuneforgeScreen.Open()
	local c = ctx
	if not c then
		warn("[RuneforgeScreen] Open called before Init")
		return
	end
	if not screen then
		screen = GuildScreen.Create({ name = "RuneforgeScreen", title = "RUNEFORGE", parent = c.parent })
		screen.SetButtonRows(BUTTON_ROWS)
	end
	currentTab = "Forge"
	resetPicks(nil)
	resetReroll()
	stateRetries = STATE_RETRY_MAX
	if toolbar then toolbar.Reset() end -- each visit starts unfiltered
	isOpen = true
	screen.SetStatus("")
	screen.Show()
	render()
	print("[RuneforgeScreen] Opened")
end

-- Unsent picks are only a selection (nothing is charged until Confirm), so Back just closes.
function RuneforgeScreen.Close()
	if not isOpen then return end
	isOpen = false
	if toolbar then toolbar.Close() end
	resetPicks(nil)
	resetReroll()
	if screen then screen.Hide() end
	local c = ctx
	if c then c.onClosed() end
	print("[RuneforgeScreen] Closed")
end

function RuneforgeScreen.Hide()
	if not isOpen then return end
	isOpen = false
	if toolbar then toolbar.Close() end
	resetPicks(nil)
	resetReroll()
	if screen then screen.Hide() end
end

function RuneforgeScreen.Render()
	render()
end

function RuneforgeScreen.SetGold(text: string)
	if screen then screen.SetGold(text) end
end

function RuneforgeScreen.SetStatus(text: string, isError: boolean?)
	if screen then screen.SetStatus(text, isError) end
end

return table.freeze(RuneforgeScreen)

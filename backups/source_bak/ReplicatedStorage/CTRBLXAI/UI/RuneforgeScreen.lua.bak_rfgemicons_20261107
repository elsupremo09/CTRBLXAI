-- What the forge rules + the server say about the next gem for the selected item. Shared by
-- the side panel (asks the server, shows the budget) and the Gems tab (greys out tiles).
local function forgeFit(state: any, it: any): (string, any, { [string]: any }?, { [string]: number }?, { any })
	local sig = pickSig()
	-- Every server forge rule (family, owned passive, passive slots, one elemental /
	-- attack-shape change, same-family line replacement) comes from the shared checkPick.
	local sim = simAfterPicks(state, it)
	-- Bonus-point budget and rarity / level caps: only the server knows (one formula). It is
	-- asked about every gem the rules above allow; its answer greys out the rest.
	local fit = if fitSig == sig then fitMap else nil
	local over = if fitSig == sig then fitOver else nil
	local candidates = {}
	for _, gid in it.compatibleGems or {} do
		local cg = gemInfo(state, gid)
		if cg and (cg.count or 0) - pickedCount(gid) > 0 then
			local ok0, rep0 = checkPick(sim, state, gid, replaceTarget)
			if ok0 then table.insert(candidates, { gem = gid, replace = rep0 }) end
		end
	end
	return sig, sim, fit, over, candidates
end

local function gemPasses(g: any, needle: string): boolean
	local kindOk = gemFilter == "All" or (gemFilter == "Stats" and g.kind == "stat")
		or (gemFilter == "Passives" and g.kind == "passive")
	local nameOk = needle == "" or string.find(string.lower(tostring(g.name)), needle, 1, true) ~= nil
	return kindOk and nameOk
end

-- Bonus inspector for one bonus (a gem, or a line already on the item). The info comes from
-- the server's description (DescribeGem + DescribeBonusEffect); actions are the buttons.
local function inspectBonus(d: any, onItem: boolean, actions: { any }?)
	if not screen or not d then return end
	BonusInspector.Open(screen.Gui, {
		name = tostring(d.name or d.id), kind = d.kind, tier = d.tier, bp = d.bp,
		effect = d.effect, effectLevel = d.effectLevel, effectScales = d.effectScales, onItem = onItem, desc = d.desc,
		family = d.family, group = d.group, minRarity = d.minRarity,
	}, actions)
end

local function gemCell(g: any, left: number): any
	local cell: any = {
		key = tostring(g.id), name = tostring(g.name), rarity = g.minRarity,
		countText = `x{left}`, ptsText = `{tonumber(g.bp) or 0} pts`,
		enabled = false,
	}
	-- Hold the tile: what the gem does (plus Add when it can be added right now).
	cell.onHold = function()
		inspectBonus(g, false, if cell.enabled and cell.onTap then
			{ { text = "Add", style = "Primary", onTap = cell.onTap } } else nil)
	end
	return cell
end

-- Gems tab cells. Returns cells, hidden count (Fits only), and a note (or nil).
local function gemCells(state: any, it: any?): ({ any }, number, string?)
	local cells = {}
	local hidden = 0
	local needle = string.lower(gemSearch)
	local locked = state.lockedReason ~= nil
	if not it then
		-- No gear picked: every owned gem, no fit / budget info, nothing to tap.
		for _, g in state.gems or {} do
			if gemPasses(g, needle) then table.insert(cells, gemCell(g, g.count or 0)) end
		end
		-- How-to text lives in the (?) guide; only "nothing to show" stays on screen.
		local note = if #(state.gems or {}) == 0 then "No rune gems." else nil
		return cells, 0, note
	end
	local _, sim, fit, over = forgeFit(state, it)
	local anyGem = false
	for _, gid in it.compatibleGems or {} do
		local g = gemInfo(state, gid)
		if g then
			anyGem = true
			if gemPasses(g, needle) then
				local left = (g.count or 0) - pickedCount(gid)
				local fits, effRep, why = checkPick(sim, state, gid, replaceTarget, fit, over)
				local enabled = left > 0 and not locked and fits
				if enabled or not fitsOnly then
					local cell = gemCell(g, left)
					cell.enabled = enabled
					if not enabled then
						cell.reason = if left <= 0 then REASON_TEXT.none_left elseif locked then "locked"
							else why or REASON_TEXT.unknown
					else
						cell.onTap = function()
							-- Re-check against the CURRENT state (the inspector's Add can be pressed
							-- after the picks or the fit answer changed, 2026-11-07).
							if currentTab ~= "Forge" or selectedKey.Forge ~= it.instanceId then return end
							local _, sim2, fit2, over2 = forgeFit(state, it)
							local ok2, rep2, why2 = checkPick(sim2, state, gid, replaceTarget, fit2, over2)
							if (g.count or 0) - pickedCount(gid) <= 0 then
								ok2, why2 = false, REASON_TEXT.none_left
							end
							if not ok2 then
								if screen then screen.SetStatus(`Can't add {g.name}: {why2 or REASON_TEXT.unknown}`, true) end
								render()
								return
							end
							-- A gem of a family the item already has always replaces that line
							-- (server rule); queue it that way so the line shows "line -> gem".
							table.insert(picks, { gem = gid, replace = rep2 })
							replaceTarget = nil
							schedulePreview()
							render()
						end
					end
					table.insert(cells, cell)
				else
					hidden += 1
				end
			end
		end
	end
	local note: string? = nil
	if not anyGem then
		note = "No gems fit." -- where gems come from is in the (?) guide
	elseif #cells == 0 and hidden == 0 then
		note = "No gems match the search or filter."
	elseif hidden > 0 then
		note = `{hidden} hidden by Fits only`
	end
	-- The line being replaced is shown gold ("Replace: <line>") on the right panel; no
	-- "Replacing ...: tap a gem" helper text here (2026-11-07).
	return cells, hidden, note
end

local function buildMain(state: any, isForge: boolean, entries: { any }, selected: any?)
	local main = screen.Main
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 4)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = main

	local gemsView = isForge and leftTab == "Gems"
	if state then
		if state.lockedReason then
			makeNote(main, tostring(state.lockedReason), 1, Theme.Colors.Warning, true)
		end
		if isForge then
			buildLeftTabs(main, 2, state)
		end -- Reroll how-to: (?) guide
	end

	if gemsView then
		if not state then return end
		local it = if selected then selected.row else nil
		RuneforgeGemGrid.BuildControls(main, 3, { search = gemSearch, filter = gemFilter, fitsOnly = fitsOnly },
			it ~= nil, function(field: string, value: any)
				if field == "search" then gemSearch = value
				elseif field == "filter" then gemFilter = value
				else fitsOnly = value == true end
				resetGridScroll("Forge|Gems") -- new search / filter: the list starts at the top
				render()
			end)
		local cells, _, note = gemCells(state, it)
		if note then makeNote(main, note, 4) end
		if #cells == 0 then return end
		local grid, hint = makeGridFrame(main, list)
		RuneforgeGemGrid.BuildGrid(grid, cells, hint)
		grid.Parent = main
		return
	end

	if state then
		if toolbar then toolbar.Build(main, 3, function()
			resetGridScroll(`{currentTab}|Gears`) -- new search / filter: back to the top
			render()
		end) end
		if #entries == 0 then
			makeNote(main, if toolbar and toolbar.IsFiltering() then "No items match the search or filters."
				elseif isForge then "No items that can be forged." else "No items above Epic.", 4)
		end
	end
	if #entries == 0 then return end

	-- Loadout-size tiles (user 2026-11-07): smaller tiles, more items on screen.
	local grid, hint = makeGridFrame(main, list)
	MerchantInspector.BuildGrid(grid, {
		entries = entries,
		selectedKey = if selected then selected.key else nil,
		width = math.max(240, main.AbsoluteSize.X - 6),
		loadoutTiles = true,
		heightHint = hint,
		onSelect = function(key: any)
			-- Tapping the same item again after a failed load retries it.
			if currentTab == "Reroll" and key == rerollFor and not rerollLoading and rerollRes == nil then
				resetReroll()
			end
			selectedKey[currentTab] = key
			-- Forge: picking a gear goes straight to its gems (user 2026-11-07).
			if currentTab == "Forge" then leftTab = "Gems" end
			render()
		end,
	})
	grid.Parent = main
end

-- Forge side panel content (inside the scroll list).
local function fillForge(list: Instance, state: any, it: any)
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end
	local locked = state.lockedReason ~= nil

	makeNote(list, "CURRENT LINES", nextOrder(), Theme.Colors.TextGold, true)
	if #(it.lines or {}) == 0 then
		makeNote(list, "No bonus lines yet.", nextOrder())
	end
	-- A line can be replaced by ONE gem per forge (the server refuses a second one).
	-- Lines already queued for replacement show which gem takes them; tapping undoes it.
	local queuedFor: { [string]: number } = {}
	local removedFor: { [string]: any } = {}
	for i, p in picks do
		if p.replace then queuedFor[p.replace] = i end
		if p.remove then removedFor[p.remove] = p end
	end
	-- Undo one pick: remove it, then replay the rest (same as every other undo).
	local function undoPick(pk: any)
		local at = table.find(picks, pk)
		if at then table.remove(picks, at) end
		revalidatePicks(state, it)
		schedulePreview()
		render()
	end
	-- Remove a line (gf 84): queued like a gem; the server prices and checks it.
	local function removeAction(line: any): any
		return { text = "Remove", style = "Secondary", onTap = function()
			if currentTab ~= "Forge" or selectedKey.Forge ~= it.instanceId then return end
			local ok, _, why = checkRemove(simAfterPicks(state, it), state, line.id)
			if not ok then
				if screen then screen.SetStatus(`Can't remove {line.name}: {why or REASON_TEXT.unknown}`, true) end
				render()
				return
			end
			table.insert(picks, { remove = line.id })
			if replaceTarget == line.id then replaceTarget = nil end
			schedulePreview()
			render()
		end }
	end
	for _, line in it.lines or {} do
		local qi = queuedFor[line.id]
		local rm = removedFor[line.id]
		if rm then
			-- Removed in this forge: dimmed, tap for the inspector with Undo.
			listButton(list, `{line.name} (removed)`, nextOrder(), false, true, function()
				inspectBonus(line, true, if locked then nil else { { text = "Undo", style = "Primary", onTap = function()
					undoPick(rm)
				end } })
			end, true)
		elseif qi then
			local pk = picks[qi]
			local qg = gemInfo(state, pk.gem)
			local qname = if qg then qg.name else pk.gem
			-- Tap: the line's inspector with Undo (2026-11-07).
			listButton(list, `{line.name} -> {qname}`, nextOrder(), true, true, function()
				inspectBonus(line, true, if locked then nil else { { text = "Undo", style = "Primary", onTap = function()
					local at = table.find(picks, pk)
					if at then table.remove(picks, at) end
					revalidatePicks(state, it)
					schedulePreview()
					render()
				end } })
			end)
		else
			local armed = replaceTarget == line.id
			local label = if armed then `Replace: {line.name}` else tostring(line.name)
			-- Tap: what the line does, with Replace (or Keep when it is already armed). The gem
			-- that replaces it is then picked on the left Gems tab (2026-11-07).
			listButton(list, label, nextOrder(), armed, true, function()
				local action = if locked then nil
					elseif armed then { text = "Keep", style = "Secondary", onTap = function()
						replaceTarget = nil
						render()
					end }
					else { text = "Replace", style = "Primary", onTap = function()
						replaceTarget = line.id
						leftTab = "Gems"
						render()
					end }
				inspectBonus(line, true, if action then { action, removeAction(line) } else nil)
			end)
		end
	end

	-- Bonus-point budget (2026-11-07): numbers from the server only (GetRuneforge / preview /
	-- gem check, all from RuneforgeService); the screen never works them out.
	local sig = pickSig()
	local budget: any = nil
	if #picks == 0 then
		budget = it.budget
	elseif previewRes and previewRes.maxBp then
		budget = { used = previewRes.totalBp, max = previewRes.maxBp }
	elseif fitSig == sig then
		budget = fitBudget
	end
	if type(budget) == "table" and type(budget.used) == "number" and type(budget.max) == "number" then
		local left = budget.max - budget.used
		makeNote(list, `Bonus budget: {budget.used} / {budget.max} pts used ({if left >= 0 then `{left} left` else `{-left} over`})`,
			nextOrder(), if left >= 0 then Theme.Colors.TextPrimary else Theme.Colors.Warning, true)
	elseif #picks > 0 then
		makeNote(list, "Bonus budget: updating...", nextOrder())
	end

	-- Gems are picked on the left Gems tab (2026-11-07). The server is still asked here, every
	-- redraw, so the budget line above stays current whichever left tab is showing.
	local _, _, _, _, candidates = forgeFit(state, it)
	if not locked and (#candidates > 0 or #picks > 0) then scheduleFitCheck(sig, candidates) end

	if #picks > 0 then
		makeNote(list, "TO INSTALL", nextOrder(), Theme.Colors.TextGold, true)
		for i, p in picks do
			if p.remove then
				local rl: any = nil
				for _, line in it.lines or {} do
					if line.id == p.remove then rl = line end
				end
				local rname = if rl then tostring(rl.name) else tostring(p.remove)
				listButton(list, `- {rname} (removed)`, nextOrder(), false, true, function()
					if rl then
						inspectBonus(rl, true, { { text = "Undo", style = "Primary", onTap = function() undoPick(p) end } })
					else
						undoPick(p)
					end
				end, true)
			else
				local g = gemInfo(state, p.gem :: string)
				local name = if g then g.name else tostring(p.gem)
				local text = name
				if p.replace then
					for _, line in it.lines or {} do
						if line.id == p.replace then text = `{name} (replaces {line.name})` end
					end
				end
				-- Tap: the gem's inspector with Undo, same as a replaced line (2026-11-07).
				listButton(list, text, nextOrder(), false, true, function()
					local function undo()
						local at = table.find(picks, p)
						if at then table.remove(picks, at) end
						revalidatePicks(state, it)
						schedulePreview()
						render()
					end
					if g then
						inspectBonus(g, false, { { text = "Undo", style = "Primary", onTap = undo } })
					else
						undo()
					end
				end)
			end
		end
		local text
		if previewBusy then
			text = "Working out the cost..."
		elseif previewRes then
			local parts = { `Result: {previewRes.newRarity}{if previewRes.raised then " (rarity up)" elseif previewRes.dropped then " (rarity down)" else ""}` }
			table.insert(parts, `Cost: {previewRes.gold} gold + {previewRes.crystals} crystals`)
			if (previewRes.catchUp or 0) > 0 then
				table.insert(parts, `(includes {previewRes.catchUp} gold to bring its past levels up to {previewRes.newRarity})`)
			end
			local gone = {}
			for _, l in previewRes.replaced or {} do table.insert(gone, l) end
			for _, l in previewRes.removed or {} do table.insert(gone, l) end
			if #gone > 0 then
				table.insert(parts, `Destroyed (no gem back): {lineNames(gone)}`)
			end
			if previewRes.newName then table.insert(parts, `New name: {previewRes.newName}`) end
			if previewRes.canAfford == false then table.insert(parts, "Not enough gold or crystals.") end
			text = table.concat(parts, "\n")
		else
			text = "This combination can't be forged. See the message at the top."
		end
		makeNote(list, text, nextOrder(), Theme.Colors.TextPrimary, true)
	end
end

-- Reroll tab: every option is ONE grouped card (2026-11-07, user request: "a set needs to look
-- grouped together"). Card = header (Keep current / Set N + total points + line count), the
-- set's new item name, a divider, then its bonus lines as compact rows inside the card.
-- Tap the card = select that option; tap a line = the bonus inspector (with "Pick this set").
local CARD_GAP = 10          -- space between two cards
local CARD_LINE_H = 32       -- compact line row inside a card

local function lineText(line: any): string
	local text = tostring(line.name or line.id)
	if type(line.effect) == "string" and line.effect ~= "" then
		text = `{text}: {line.effect}`
	elseif type(line.desc) == "string" and line.desc ~= "" then
		text = `{text}: {line.desc}`
	end
	return text
end

local function linesPoints(lines: { any }): number
	local pts = 0
	for _, l in lines do
		pts += tonumber(l.bp) or 0
	end
	return pts
end

local function cardLabel(parent: Instance, text: string, order: number, color: Color3, bold: boolean, size: number): TextLabel
	local lbl = Instance.new("TextLabel")

-- One option card. onSelect nil = display only (the current lines before paying).
local function rerollCard(parent: Instance, order: number, title: string, subtitle: string?, lines: { any },
	selected: boolean, onSelect: (() -> ())?, pick: (() -> ())?)
	local card = Instance.new("TextButton")
	card.Name = "RerollCard"
	card.Text = ""
	card.AutoButtonColor = false
	card.Size = UDim2.new(1, 0, 0, 0)
	card.AutomaticSize = Enum.AutomaticSize.Y
	card.BackgroundColor3 = if selected then Theme.Colors.SelectedItem else Theme.Colors.PanelRaised
	card.BackgroundTransparency = 0
	card.BorderSizePixel = 0
	card.LayoutOrder = order
	local corner = Instance.new("UICorner")
	corner.CornerRadius = Theme.CornerRadius.lg
	corner.Parent = card
	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = if selected then Theme.Colors.TextGold else Theme.Colors.Border
	stroke.Thickness = if selected then 2 else 1
	stroke.Parent = card
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.Parent = card
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 2)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = card
	local minH = Instance.new("UISizeConstraint")
	minH.MinSize = Vector2.new(0, LIST_ROW_H)
	minH.Parent = card

	local n = #lines
	local summary = `{linesPoints(lines)} pts · {n} {if n == 1 then "line" else "lines"}`
	cardLabel(card, `{title}   {summary}`, 1,
		if selected then Theme.Colors.TextGold else Theme.Colors.TextPrimary, true, Theme.Text.Small())
	if subtitle and subtitle ~= "" then
		cardLabel(card, subtitle, 2, Theme.Colors.TextSecondary, false, Theme.Text.Tiny())
	end
	cardDivider(card, 3, 0.2)

	local o = 3
	for i, line in lines do
		if i > 1 then
			o += 1
			cardDivider(card, o, 0.6)
		end
		o += 1
		local row = Instance.new("TextButton")
		row.Name = "Line"
		row.Size = UDim2.new(1, 0, 0, 0)
		row.AutomaticSize = Enum.AutomaticSize.Y
		row.BackgroundTransparency = 1
		row.BorderSizePixel = 0
		row.AutoButtonColor = false
		row.Font = Theme.Font.Primary
		row.TextSize = Theme.Text.Tiny()
		row.TextScaled = false
		row.TextColor3 = Theme.Colors.TextPrimary
		row.TextWrapped = true
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.Text = lineText(line)
		row.LayoutOrder = o
		local rowMin = Instance.new("UISizeConstraint")
		rowMin.MinSize = Vector2.new(0, CARD_LINE_H)
		rowMin.Parent = row
		local rowPad = Instance.new("UIPadding")
		rowPad.PaddingLeft = UDim.new(0, 10)
		rowPad.PaddingTop = UDim.new(0, 4)
		rowPad.PaddingBottom = UDim.new(0, 4)
		rowPad.Parent = row
		row.Activated:Connect(function()
			inspectBonus(line, true, if pick then { { text = "Pick this set", style = "Primary", onTap = pick } } else nil)
		end)
		row.Parent = card
	end
	if n == 0 then
		o += 1
		cardLabel(card, "No bonus lines.", o, Theme.Colors.TextSecondary, false, Theme.Text.Tiny())
	end

	if onSelect then
		card.Activated:Connect(onSelect)
	end
	card.Parent = parent
end

-- Holder for the cards: its own list layout, so the cards get a clear gap between them.
local function cardHolder(list: Instance, order: number): Frame
	local holder = Instance.new("Frame")
	holder.Name = "RerollCards"
	holder.Size = UDim2.new(1, 0, 0, 0)
	holder.AutomaticSize = Enum.AutomaticSize.Y
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.LayoutOrder = order
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, CARD_GAP)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = holder
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 4)
	pad.PaddingLeft = UDim.new(0, 2)
	pad.PaddingRight = UDim.new(0, 2)   -- room for the 2 px gold stroke
	pad.Parent = holder
	holder.Parent = list
	return holder
end

-- Reroll side panel content. Pay first (USER RULING 2026-11-07): before paying it shows the
-- cost and the current lines only; the new sets appear after the sulfur is paid.
local function fillReroll(list: Instance, state: any, it: any)
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end

	local info = it.reroll
	if not info or not (info.setCount or info.pending) then
		makeNote(list, `CURRENT LINES: {lineNames(it.lines)}`, nextOrder(), Theme.Colors.TextSecondary)
		makeNote(list, `{it.rarity} rerolls need Runeforge L{(info and info.unlockLevel) or 8} (yours is L{state.level or 0}).`, nextOrder(), Theme.Colors.Warning, true)
		return
	end
	if rerollFor ~= it.instanceId then
		startRerollFetch(it.instanceId)
	end
	if rerollLoading then
		makeNote(list, "Loading the reroll...", nextOrder())
		return
	end
	local res = rerollRes
	if not res then
		makeNote(list, "Couldn't load the reroll.", nextOrder(), Theme.Colors.Warning)
		return
	end
	local current = (res.current and res.current.lines) or it.lines or {}

	if not res.pending then
		makeNote(list, `Reroll: {res.sulfur} sulfur (you have {res.haveSulfur}) for {res.setCount} new sets`, nextOrder())
		if (res.haveSulfur or 0) < (res.sulfur or 0) then
			makeNote(list, "Not enough sulfur.", nextOrder(), Theme.Colors.Warning)
		end
		local holder = cardHolder(list, nextOrder())
		rerollCard(holder, 1, "Current lines", nil, current, false, nil, nil)
		return
	end

	makeNote(list, `PAID {res.sulfur} SULFUR - PICK ONE`, nextOrder(), Theme.Colors.TextGold, true)
	local function choose(n: number): () -> ()
		return function()
			rerollChoice = n
			render()
		end
	end
	local holder = cardHolder(list, nextOrder())
	rerollCard(holder, 0, "Keep current", it.name, current, rerollChoice == 0, choose(0), choose(0))
	for i, set in res.sets or {} do
		local c = tonumber(set.choice) or i
		rerollCard(holder, c, `Set {c}`, set.name, set.lines or {}, rerollChoice == c, choose(c), choose(c))
	end
end


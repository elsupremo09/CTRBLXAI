	tabs.Parent = side

	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "Panel"
	scroll.Size = UDim2.new(1, 0, 1, -(SUBTAB_H + SUBTAB_GAP))
	scroll.Position = UDim2.fromOffset(0, SUBTAB_H + SUBTAB_GAP)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 4
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.new()
	local pad = Instance.new("UIPadding")
	pad.PaddingRight = UDim.new(0, 8)
	pad.Parent = scroll
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 4)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = scroll

	if selected and state then
		local it = selected.row
		local tag = if it.runeForged then "  (rune-forged)" else ""
		makeNote(scroll, `{it.name}  Lv{it.level}  {it.rarity}{tag}`, -2, Theme.GetRarityColor(it.rarity or "Common"), true)
		if it.equippedBy then
			makeNote(scroll, `Equipped by {it.equippedBy}.`, -1)
		end
		local body = Instance.new("Frame")
		body.Name = "Body"
		body.Size = UDim2.new(1, 0, 0, 0)
		body.AutomaticSize = Enum.AutomaticSize.Y
		body.BackgroundTransparency = 1
		body.BorderSizePixel = 0
		body.LayoutOrder = 1
		local bodyList = Instance.new("UIListLayout")
		bodyList.Padding = UDim.new(0, 4)
		bodyList.SortOrder = Enum.SortOrder.LayoutOrder
		bodyList.Parent = body
		if isForge then
			fillForge(body, state, it)
		else
			fillReroll(body, state, it)
		end
		body.Parent = scroll
	end
	scroll.Parent = side
end

local function promptForge(it: any)
	local c = ctx
	if not c or not screen or not previewRes then return end
	local p = previewRes
	local lines = { `Forge {it.name}?` }
	if p.fromRarity and p.newRarity ~= p.fromRarity then
		table.insert(lines, `Rarity: {p.fromRarity} -> {p.newRarity}`)
	end
	if p.newName then table.insert(lines, `New name: {p.newName}`) end
	table.insert(lines, if (p.crystals or 0) > 0 then `Costs {p.gold} gold and {p.crystals} crystals.` else `Costs {p.gold} gold.`)
	local gone = {}
	for _, l in p.replaced or {} do table.insert(gone, l) end
	for _, l in p.removed or {} do table.insert(gone, l) end
	if #gone > 0 then
		table.insert(lines, `Destroyed, no gem back: {lineNames(gone)}.`)
	end
	table.insert(lines, "This can't be undone.")
	local iid: string = it.instanceId
	local installs = table.clone(picks)
	screen.Prompt(table.concat(lines, "\n"), "Confirm", "Primary", function()
		commitBusy = true
		local res = c.commitForge(iid, installs)
		commitBusy = false
		if res then
			resetPicks(iid)
			c.onChanged()
		end
		render()
	end)
end

local function promptReroll(it: any)
	local c = ctx
	local res = rerollRes
	if not c or not screen or not res then return end
	local iid: string = it.instanceId
	if not res.pending then
		-- Step 1: pay. The new sets only exist once this is paid (USER RULING 2026-11-07).
		local pay = c.payReroll
		if not pay then return end
		local msg = `Pay {res.sulfur} sulfur to reroll {it.name}? You then pick one of {res.setCount} new sets or keep the current lines. The sulfur is spent either way.`
		screen.Prompt(msg, "Confirm", "Primary", function()
			commitBusy = true
			local paid = pay(iid)
			commitBusy = false
			if paid then
				resetReroll()
				rerollFor = iid
				rerollRes = paid -- the saved sets, straight from the server
				c.onChanged()
			else
				-- Refused or no answer: ask the server again, so sets that WERE paid for (answer
				-- lost on the way back) still show up. Paying twice is refused by the server.
				resetReroll()
			end
			render()
		end)
		return
	end
	-- Step 2: close the paid choice. Nothing more is charged.
	if rerollChoice == nil then return end
	local choice = rerollChoice :: number
	local msg = if choice == 0
		then `Keep the current lines of {it.name}? The new sets are thrown away.`
		else `Replace ALL bonus lines of {it.name} with set {choice}? This can't be undone.`
	screen.Prompt(msg, "Confirm", "Primary", function()
		commitBusy = true
		local done = c.commitReroll(iid, choice)
		commitBusy = false
		-- Done: the choice is closed and the tab shows the pay step again. Failed: reload the
		-- open choice from the server either way.
		resetReroll()
		if done then
			c.onChanged()
		end
		render()
	end)
end

-- The (?) guide: how the Runeforge works and what every greyed reason means (2026-11-07, user
-- request: no helper text on the screen). Level / limit numbers come from the server state.
local function openGuide(state: any)
	if not screen then return end
	local lvl = if state then state.level or 0 else 0
	local cap = if state then state.capacity or "Uncommon" else "Uncommon"
	local maxGems = if state then state.maxInstalls or 8 else 8
	-- Level caps and the reroll level come from the server (RuneforgeService), not typed in.
	local steps, needLevels = {}, {}
	for i, s in (if state then state.capacitySteps else nil) or {} do
		table.insert(steps, `L{s.level} {s.rarity}`)
		if i > 1 then table.insert(needLevels, `L{s.level}`) end
	end
	local capsText = if #steps > 0 then ` Limits: {table.concat(steps, ", ")}.` else ""
	local rerollMin = if state then state.rerollMinLevel else nil
	local rerollText = if rerollMin then ` (Runeforge L{rerollMin} and up)` else ""
	local group = BonusInspector.GROUP_TEXT or {}
	local oneChange = `{group.transform or ""} {group.pattern or ""}`
	-- Every reason a tile can show, built from the reason tables so none is missed.
	local reasons = { "over by N: the item would go N points over its bonus budget." }
	local listed: { [string]: boolean } = { ["over by N"] = true }
	local function addReason(label: string, help: string)
		if listed[label] then return end
		listed[label] = true
		table.insert(reasons, `{label}: {help}`)
	end
	local order = table.clone(REASON_ORDER)
	for code in REASON_TEXT do
		if not table.find(order, code) then table.insert(order, code) end
	end
	for _, code in order do
		local help = if code == "one_change" then oneChange
			else (string.gsub(REASON_HELP[code] or "the forge refused it.", "{max}", tostring(maxGems)))
		addReason(REASON_TEXT[code], help)
	end
	for _, m in SERVER_REASONS do
		local label = if m.text == "needs L%1" then `needs {if #needLevels > 0 then table.concat(needLevels, " / ") else "LN"}` else m.text
		addReason(label, SERVER_HELP[m.text] or REASON_HELP[m.text] or "the forge refused it.")
	end
	addReason("locked", "the Runeforge is locked.")
	FacilityInfo.Open(screen.Gui, "RUNEFORGE GUIDE", {
		{ heading = "Your Runeforge", body = `Level {lvl}: forges items up to {cap}.{capsText}` },
		{ heading = "Pick a gear", body = "On the Gears tab, tap an item. The left panel then switches to Gems and shows the rune gems that fit it. Search and filters work like the Loadout inventory." },
		{ heading = "Gears | Gems", body = "Swap the left panel between your items and your rune gems. Each tab keeps its place in the list." },
		{ heading = "Add a gem", body = "Tap a gem tile to queue it. A tile shows how many you own (xN) and its bonus-point cost. Press and hold a tile to see what the bonus does without adding it. Rune gems come from dismantling items at the Blacksmith." },
		{ heading = "Fits only", body = "On: gems that can't be added right now are hidden. Off: they show greyed, with the reason on the tile." },
		{ heading = "What a line does", body = "Tap one of the gear's current lines on the right to see what it does on this item." },
		{ heading = "Replace a line", body = "Tap a current line, then Replace. The line turns gold (\"Replace: ...\"); tap a gem on the Gems tab to put in its place. Keep cancels. The old line is destroyed, no gem back. A gem of a family the item already has always replaces that family's line." },
		{ heading = "Remove a line", body = "Tap a current line, then Remove. The line is destroyed (no gem back) and its bonus points are freed. Removing costs gold only. If the points left fall below the item's rarity, the rarity drops and the item is renamed; an item with no lines becomes Common. The preview shows the result before you Confirm." },
		{ heading = "Undo", body = "Tap a gem under TO INSTALL, a removed line, or a replaced line (it reads \"line -> gem\"), then Undo. Minus removes the last gem, X clears them all. Nothing is spent until you Confirm." },
		{ heading = "Bonus budget", body = "Every bonus line costs points. The item's rarity sets how many points it can hold; two-handed items hold twice as many. When the total goes above the current rarity, the item moves up a rarity, up to your Runeforge's limit." },
		{ heading = "Cost", body = "Forging costs gold. Raising the rarity also costs crystals for every step. The cost preview shows the exact price, the result rarity and the new name before you Confirm." },
		{ heading = "Forge vs Reroll", body = `Forge adds or replaces lines on Common to Epic items. Items above Epic can only be rerolled{rerollText}: first pay sulfur, then the new sets of lines appear: pick a set or keep the current lines. The sulfur is spent either way. If you leave before choosing, the same sets wait for you; until you choose, the item can't be rerolled, sold, dismantled or merged. Tap a line to see what it does.` },
		{ heading = "Why a gem is greyed out", body = table.concat(reasons, "\n") },
	})
end

local function buildButtons(state: any, selected: any?, isForge: boolean)
	local c = ctx
	if not c then return end
	local row = makeRow(screen.Buttons, 1)
	local it = selected and selected.row or nil
	iconButton(row, "Help", "Btn_Info", 0, true, function()
		openGuide(state)
	end)
	if isForge then
		local hasPicks = #picks > 0
		iconButton(row, "Minus", "Btn_RemovePick", 1, hasPicks, function()
			table.remove(picks)
			revalidatePicks(state, it)
			schedulePreview()
			render()
		end)
		local canForge = it ~= nil and hasPicks and not previewBusy and previewRes ~= nil
			and previewRes.canAfford ~= false and state and state.lockedReason == nil
		iconButton(row, "Confirm", "Btn_Forge", 2, canForge, function()
			if it and not commitBusy then promptForge(it) end
		end)
		iconButton(row, "X", "Btn_ClearPicks", 3, hasPicks, function()
			resetPicks(pickFor)
			render()
		end)
	else
		local res = rerollRes
		-- Before paying: Confirm pays (needs enough sulfur). After: Confirm closes the choice.
		local enabled = if res ~= nil and res.pending
			then it ~= nil and rerollChoice ~= nil
			else it ~= nil and res ~= nil and c.payReroll ~= nil and (res.haveSulfur or 0) >= (res.sulfur or math.huge)
		iconButton(row, "Confirm", "Btn_Reroll", 2, enabled, function()
			if it and not commitBusy then promptReroll(it) end
		end)
	end
	iconButton(row, "Back", "Btn_BACK", 10, true, function()
		RuneforgeScreen.Close()
	end)
end

render = function()
	local c = ctx
	if not c or not screen or not isOpen then return end
	renderSeq += 1
	local mySeq = renderSeq
	-- getState may wait on the server (empty cache). Fetch BEFORE clearing, and stop if a newer
	-- render started meanwhile, so two renders can never both build the screen (D-1 fix).
	local state = c.getState()
	if mySeq ~= renderSeq or not isOpen then return end
	-- R-3 (2026-11-01): an empty answer (usually the 0.2 s "Too fast" limit right after a
	-- Confirm) redraws once more shortly after, up to 3 times, instead of staying empty.
	if state == nil and stateRetries > 0 then
		stateRetries -= 1
		task.delay(STATE_RETRY_DELAY, function()
			if isOpen and mySeq == renderSeq then render() end
		end)
	elseif state ~= nil then
		stateRetries = STATE_RETRY_MAX
	end
	local isForge = currentTab == "Forge"
	-- Left grid keeps its scroll per view (Gears / Gems / Reroll), saved before the rebuild.
	local oldGrid = screen.Main:FindFirstChild("Grid", true)
	if lastGridKey and oldGrid and oldGrid:IsA("ScrollingFrame") then
		savedScroll[lastGridKey] = oldGrid.CanvasPosition
	end
	for key in scrollReset do savedScroll[key] = nil end
	table.clear(scrollReset)
	-- Side panel keeps its scroll on a pick (2026-11-07); a different item or tab starts it
	-- at the top.
	local sideKey = `{currentTab}|{tostring(selectedKey[currentTab])}`
	local oldPanel = screen.Side:FindFirstChild("Panel")
	local sidePos: Vector2? = if sideKey == lastSideKey and oldPanel and oldPanel:IsA("ScrollingFrame")
		then oldPanel.CanvasPosition else nil
	screen.Clear(nil) -- this screen restores the left grid itself (one position per view)
	local entries = buildEntries(state, isForge)
	if toolbar then entries = toolbar.Apply(entries) end
	local selected = MerchantInspector.ResolveSelected(entries, selectedKey[currentTab])
	local selId = if selected then selected.key else nil
	if isForge and selId ~= pickFor then
		resetPicks(selId)
		savedScroll["Forge|Gems"] = nil -- another item: its gem list starts at the top
	end
	if not isForge and selId ~= rerollFor then
		resetReroll()
	end
	local gridKey = `{currentTab}|{if isForge then leftTab else "Gears"}`
	buildMain(state, isForge, entries, selected)
	buildSide(state, selected, isForge)
	lastGridKey = gridKey
	local newGrid = screen.Main:FindFirstChild("Grid", true)
	local gridPos = savedScroll[gridKey]
	if gridPos and newGrid and newGrid:IsA("ScrollingFrame") and screen.RestoreScroll then
		screen.RestoreScroll(newGrid, gridPos)
	end
	lastSideKey = sideKey
	local newPanel = screen.Side:FindFirstChild("Panel")
	if sidePos and newPanel and newPanel:IsA("ScrollingFrame") and screen.RestoreScroll then
		screen.RestoreScroll(newPanel, sidePos)
	end
	buildButtons(state, selected, isForge)
end


local function lineNames(lines: { any }?): string
	local names = {}
	for _, l in lines or {} do
		table.insert(names, tostring(l.name or l.id))
	end
	return if #names > 0 then table.concat(names, ", ") else "no bonus lines"
end

local function findItem(state: any, instanceId: string?): any?
	if not state or not instanceId then return nil end
	for _, it in state.items or {} do
		if it.instanceId == instanceId then return it end
	end
	return nil
end

local function gemInfo(state: any, gemId: string): any?
	for _, g in state.gems or {} do
		if g.id == gemId then return g end
	end
	return nil
end

local function pickedCount(gemId: string): number
	local n = 0
	for _, p in picks do
		if p.gem == gemId then n += 1 end
	end
	return n
end

-- WHY A GEM IS GREYED OUT (2026-11-07). ONE table: client rule codes, plus the server's
-- refusal reasons matched by pattern. Wording follows the server's meaning (PlanForge). Short:
-- it is drawn on the gem tile (two lines at the 48 px minimum tile, Gems tab 2026-11-07).
local REASON_TEXT: { [string]: string } = {
	none_left = "none left",
	gem_limit = "gem limit",
	line_missing = "line gone",
	line_replaced = "line queued", -- that line is already being replaced in this forge
	family_queued = "family queued",
	family_line = "replaces own line", -- must replace the line of its own family
	has_passive = "has it",
	slots_full = "slots full",
	one_change = "1 change only",
	unknown = "can't add",
}
local SERVER_REASONS: { { pattern: string, text: string } } = {
	{ pattern = "^Too many bonus points", text = "over budget" },
	{ pattern = "forging needs Runeforge L(%d+)", text = "needs L%1" },
	{ pattern = "rarer than Epic", text = "above Epic" },
	{ pattern = "No free bonus passive slot", text = REASON_TEXT.slots_full },
	{ pattern = "already has that passive", text = REASON_TEXT.has_passive },
	{ pattern = "Only one elemental", text = REASON_TEXT.one_change },
	{ pattern = "already being replaced", text = REASON_TEXT.line_replaced },
	{ pattern = "Too many rune gems", text = REASON_TEXT.gem_limit },
	{ pattern = "^Two .+ gems", text = REASON_TEXT.family_queued },
	{ pattern = "already has a .+ line", text = REASON_TEXT.family_line },
	{ pattern = "cannot go on this item", text = "doesn't fit" },
}
-- What each reason means, for the (?) guide. Built next to the reason tables so the guide
-- explains every label the tiles can show (2026-11-07). One-change wording is shared with
-- the bonus inspector (BonusInspector.GROUP_TEXT).
local REASON_ORDER = { "family_queued", "family_line", "line_replaced", "line_missing", "slots_full",
	"has_passive", "one_change", "gem_limit", "none_left", "unknown" }
local REASON_HELP: { [string]: string } = {
	none_left = "all of these gems are already queued.",
	gem_limit = "at most {max} gems per forge.",
	line_missing = "the line it should replace is no longer on the item.",
	line_replaced = "that line is already being replaced in this forge.",
	family_queued = "a gem of the same family is already queued.",
	family_line = "this gem must replace the item's line of the same family.",
	has_passive = "the item already has this passive.",
	slots_full = "no free bonus passive slot (1, or 2 on two-handed items).",
	one_change = "", -- filled from BonusInspector.GROUP_TEXT
	unknown = "the forge refused it for another reason.",
}
local SERVER_HELP: { [string]: string } = {
	["over budget"] = "the item would go over its bonus budget.",
	["needs L%1"] = "the result needs a higher Runeforge level.",
	["above Epic"] = "the result would be rarer than Epic.",
	["doesn't fit"] = "this gem can't go on this kind of item.",
}
local function serverReasonText(raw: any, over: number?): string
	if type(over) == "number" and over > 0 then return `over by {over}` end
	local r = tostring(raw)
	for _, m in SERVER_REASONS do
		local a, _, cap = string.find(r, m.pattern)
		if a then return (string.gsub(m.text, "%%1", cap or "")) end
	end
	return REASON_TEXT.unknown
end

-- FORGE RULE MIRROR (2026-11-06). Replays picks with the same checks, in the same order, as
-- the server's RuneforgeService.PlanForge, so the screen greys out every gem the server would
-- refuse. The server still decides (SEC-002); this only avoids a refusal after the tap.
-- ONE helper for both the gem list and revalidatePicks so the two can never disagree.
local function newForgeSim(it: any): any
	local sim = { lines = {}, passives = {}, original = {}, replaced = {}, families = {}, used = {},
		slots = (it and it.passiveSlots) or 1, count = 0 }
	for _, line in (it and it.lines) or {} do
		sim.original[line.id] = true
		if line.kind == "passive" then
			table.insert(sim.passives, { id = line.id, group = line.group })
		else
			table.insert(sim.lines, { id = line.id, family = if line.kind == "stat" then line.family else nil })
		end
	end
	return sim
end

-- Would the server accept gem `gemId` replacing `rep` (nil = new line) after the picks already
-- applied to `sim`? Returns ok and the line it really replaces (a gem of a family the item
-- already has always replaces that family's line, server rule).
-- On a refusal the second result is a reason code (REASON_TEXT) and the third the text.
local function checkPick(sim: any, state: any, gemId: string, rep: string?, fit: { [string]: any }?,
	over: { [string]: number }?): (boolean, string?, string?)
	local function no(code: string): (boolean, string?, string?)
		return false, code, REASON_TEXT[code]
	end
	local function server(key: string): (boolean, string?, string?)
		return false, "server", serverReasonText(fit and fit[key], over and over[key])
	end
	local g = gemInfo(state, gemId)
	if not g then return no("unknown") end
	if (sim.used[gemId] or 0) >= (g.count or 0) then return no("none_left") end
	-- Gems per forge: the limit comes from the server (state.maxInstalls), never hard-coded.
	local cap = state and state.maxInstalls
	if type(cap) == "number" and sim.count >= cap then return no("gem_limit") end
	if rep ~= nil then
		if not sim.original[rep] then return no("line_missing") end     -- line not on the item
		if sim.replaced[rep] then return no("line_replaced") end        -- already being replaced
	end
	if g.kind == "stat" then
		if g.family == nil then return no("unknown") end
		if sim.families[g.family] then return no("family_queued") end    -- two of one family
		local same: string? = nil
		for _, l in sim.lines do
			if l.family == g.family then same = l.id end
		end
		if same then
			if rep ~= nil and rep ~= same then return no("family_line") end -- must replace its family's line
			rep = same
		end
		local key = `{gemId}|{rep or ""}`
		if fit and fit[key] ~= nil and fit[key] ~= true then
			return server(key)                                          -- server: over budget / cap
		end
		return true, rep
	elseif g.kind == "passive" then
		if sim.families[gemId] then return no("family_queued") end
		for _, ps in sim.passives do
			if ps.id == gemId then return no("has_passive") end          -- item already has that passive
		end
		-- The replaced line comes off first, then the slot and exclusive-group checks.
		local count = 0
		for _, ps in sim.passives do
			if ps.id ~= rep then count += 1 end
		end
		if count >= sim.slots then return no("slots_full") end           -- no free passive slot
		if g.group ~= nil then
			for _, ps in sim.passives do
				if ps.id ~= rep and ps.group == g.group then return no("one_change") end
			end
		end
		local key = `{gemId}|{rep or ""}`
		if fit and fit[key] ~= nil and fit[key] ~= true then
			return server(key)                                          -- server: over budget / cap
		end
		return true, rep
	end
	return no("unknown")
end

local function applyPick(sim: any, state: any, gemId: string, rep: string?)
	local g = gemInfo(state, gemId)
	if rep ~= nil then
		for i, l in sim.lines do
			if l.id == rep then table.remove(sim.lines, i); break end
		end
		for i, ps in sim.passives do
			if ps.id == rep then table.remove(sim.passives, i); break end
		end
		sim.replaced[rep] = true
	end
	if g and g.kind == "stat" then
		table.insert(sim.lines, { id = gemId, family = g.family })
		if g.family then sim.families[g.family] = true end
	elseif g then
		table.insert(sim.passives, { id = gemId, group = g.group })
		sim.families[gemId] = true
	end
	sim.used[gemId] = (sim.used[gemId] or 0) + 1
	sim.count += 1
end

-- Can line `lineId` be removed after the picks already applied to `sim`? Same checks, same
-- order as the server (PlanForge, gf 84): on the item, not already taken, within the pick limit.
local function checkRemove(sim: any, state: any, lineId: string): (boolean, string?, string?)
	local cap = state and state.maxInstalls
	if type(cap) == "number" and sim.count >= cap then return false, "gem_limit", REASON_TEXT.gem_limit end
	if not sim.original[lineId] then return false, "line_missing", REASON_TEXT.line_missing end
	if sim.replaced[lineId] then return false, "line_replaced", REASON_TEXT.line_replaced end
	return true
end

-- A removed line comes off like a replaced one: its family, passive slot and exclusive group
-- are free again for the gems after it (server: removeLine + replacedSet).
local function applyRemove(sim: any, lineId: string)
	for i, l in sim.lines do
		if l.id == lineId then table.remove(sim.lines, i); break end
	end
	for i, ps in sim.passives do
		if ps.id == lineId then table.remove(sim.passives, i); break end
	end
	sim.replaced[lineId] = true
	sim.count += 1
end

-- The forge state after the current picks (all already valid).
local function simAfterPicks(state: any, it: any): any
	local sim = newForgeSim(it)
	for _, p in picks do
		if p.remove then
			if checkRemove(sim, state, p.remove) then applyRemove(sim, p.remove) end
		else
			local ok, rep = checkPick(sim, state, p.gem :: string, p.replace)
			if ok then applyPick(sim, state, p.gem :: string, rep) end
		end
	end
	return sim
end

-- After a pick is removed, replay the remaining picks in order with the same rules and drop
-- any that are no longer valid (e.g. a passive's own gem whose line-replacing swap was just
-- undone). Returns the names of dropped gems.
local function revalidatePicks(state: any, it: any?): { string }
	local dropped = {}
	if not it then return dropped end
	local sim = newForgeSim(it)
	local kept = {}
	for _, p in picks do
		if p.remove then
			if checkRemove(sim, state, p.remove) then
				applyRemove(sim, p.remove)
				table.insert(kept, p)
			else
				table.insert(dropped, `removing {p.remove}`)
			end
		else
			local ok, rep = checkPick(sim, state, p.gem :: string, p.replace)
			if ok then
				applyPick(sim, state, p.gem :: string, rep)
				table.insert(kept, { gem = p.gem, replace = rep })
			else
				local g = gemInfo(state, p.gem :: string)
				table.insert(dropped, if g then g.name else tostring(p.gem))
			end
		end
	end
	table.clear(picks)
	for _, p in kept do table.insert(picks, p) end
	if #dropped > 0 and screen then
		screen.SetStatus(`Removed {table.concat(dropped, ", ")}: it needed that swap`, false)
	end
	return dropped
end

local function resetPicks(instanceId: string?)
	pickFor = instanceId
	table.clear(picks)
	replaceTarget = nil
	previewRes = nil
	previewToken += 1
	previewBusy = false
	fitSig, fitMap, fitAskedSig = nil, nil, nil
	fitOver, fitBudget = nil, nil
	fitToken += 1
end

--------------------------------------------------
-- RENDER
--------------------------------------------------

local render: () -> () -- forward declaration (callbacks re-render)

-- Load the reroll offer OUTSIDE render (D-1 fix 2026-11-01): render never waits on the server
-- for it. Deferred so the answer can never re-enter a render that is still building.
local function startRerollFetch(instanceId: string)
	local c = ctx
	resetReroll()
	local token = rerollToken
	rerollFor = instanceId
	if not c then return end
	rerollLoading = true
	task.defer(function()
		local res = c.getRerollSets(instanceId)
		if token ~= rerollToken then return end
		rerollRes = res
		rerollLoading = false
		if isOpen then render() end
	end)
end

-- Ask the server what the current picks cost. Fast taps are coalesced into one request.
local function schedulePreview()
	local c = ctx
	previewToken += 1
	local token = previewToken
	previewRes = nil
	if not c or not pickFor or #picks == 0 then
		previewBusy = false
		return
	end
	previewBusy = true
	local iid = pickFor :: string
	local installs = table.clone(picks)
	task.delay(PREVIEW_DELAY, function()
		if token ~= previewToken or not isOpen then return end
		local res = c.preview(iid, installs)
		if token ~= previewToken then return end
		previewRes = res
		previewBusy = false
		render()
	end)
end

-- Identity of what a gem check was asked for: the item, the picks in order, the armed line.
local function pickSig(): string
	local parts = { tostring(pickFor), tostring(replaceTarget) }
	for _, p in picks do
		table.insert(parts, if p.remove then `-{p.remove}` else `{p.gem}>{p.replace or ""}`)
	end
	return table.concat(parts, "|")
end

-- Ask the server which of the gems the screen would allow are still accepted next (budget,
-- rarity / level caps). One request per pick state; fast taps coalesce like the preview.
-- Until the answer arrives nothing extra is greyed out (the server still checks on Confirm).
local function scheduleFitCheck(sig: string, candidates: { any })
	local c = ctx
	if not c or not c.checkGems or not pickFor or fitAskedSig == sig then return end
	fitAskedSig = sig
	fitToken += 1
	local token = fitToken
	local checkGems = c.checkGems :: any
	local iid = pickFor :: string
	local installs = table.clone(picks)
	local cands = table.clone(candidates)
	task.delay(PREVIEW_DELAY, function()
		if token ~= fitToken or not isOpen then return end
		local res = checkGems(iid, installs, cands)
		if token ~= fitToken then return end
		if res and type(res.fits) == "table" then
			local map, over = {}, {}
			for i, cand in cands do
				local key = `{cand.gem}|{cand.replace or ""}`
				map[key] = res.fits[i]
				local n = res.over and res.over[i]
				if type(n) == "number" then over[key] = n end
			end
			fitSig, fitMap, fitOver = sig, map, over
			fitBudget = if type(res.budget) == "table" then res.budget else nil
			render()
		else
			fitAskedSig = nil -- e.g. "Too fast": ask again on the next redraw
		end
	end)
end

local function buildEntries(state: any, isForge: boolean): { any }
	local entries = {}
	if not state then return entries end
	for _, it in state.items or {} do
		local show = if isForge then it.forgeable == true else it.reroll ~= nil
		if show then
			table.insert(entries, {
				key = it.instanceId, detail = it.detail, name = it.name, level = it.level,
				rarity = it.rarity, price = nil, queued = false, row = it,
			})
		end
	end
	return entries
end


--!strict
-- GemCraftService.lua
-- CTRBLXAI | Rune gem crafting at the Runeforge ("Gem Craft" tab), server rules only.
-- USER RULING 2026-11-12 1:54 PM (PROPOSAL_gem_crafting_20261112.md defaults, approved).
-- Kept next to RuneforgeService instead of inside it so that file stays under 1000 lines
-- (ARC-005). The discount and the Runeforge level come FROM RuneforgeService.GetState (reused,
-- not copied). All numbers and refusal texts come from Shared/GemCraftRules (DAT-001).
--
-- OWNS: the craft transaction - check gems + gold, take them, give the result. Atomic: every
--       check runs first, then ONE CurrencyService.Debit (all-or-nothing), then the Credit.
--       Random results are drawn on the server only (SEC-002).
-- READS: rune gem storage + gold (currency provider), BonusData (families, tiers, passives).
-- MUST NOT OWN: forging, gem drops, prices outside GemCraftRules.
-- DEPENDENCIES ARE INJECTED (no circular require); missing wiring refuses (ARC-006).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GemCraftRules = require(ReplicatedStorage:WaitForChild("CTRBLXAI", 10)
	:WaitForChild("Shared", 10):WaitForChild("GemCraftRules", 10))

local GemCraftService = {}

local REASONS = GemCraftRules.REASONS
local MAX_TIER = GemCraftRules.MAX_TIER
local INVALID = "Invalid rune gem selection" -- existing Runeforge refusal text
local NO_GEMS = "Not enough rune gems"       -- existing CurrencyService refusal text

local _currency: any = nil -- CurrencyService.AsProvider(): GetGold / CanAfford / Debit / Credit
local _bonusData: any = nil
local _state: any = nil    -- RuneforgeService.GetState: () -> { level, discountPct }
local _rng: any = Random.new()
local index: any = nil

function GemCraftService.SetCurrencyProvider(p: any) _currency = p end
function GemCraftService.SetBonusData(d: any) _bonusData = d; index = nil end
function GemCraftService.SetStateProvider(fn: any) _state = fn end
-- Tests only: a seeded Random. nil restores a fresh unseeded one.
function GemCraftService.SetRandom(r: any) _rng = r or Random.new() end

-- Lookups built once from BonusData. Pools are sorted so a seeded test is repeatable.
--   byFamilyTier[family][tier] = gem id (T1-T4)
--   statPool[tier]   = every stat gem id of that tier (one per in-game family)
--   passivePool[rarity] = passive gem ids of that rarity (only Uncommon-Epic passives are
--                         gems; the 2 Legendary / Mythic passives never become gems)
local function getIndex(): any
	if index then return index end
	if not _bonusData then return nil end
	local byFamilyTier, statPool, passivePool = {}, {}, {}
	for id, a in _bonusData.NumericalAttributes or {} do
		local t = if type(a) == "table" then tonumber(a.tier) else nil
		if t and t >= 1 and t <= MAX_TIER and type(a.family) == "string" then
			byFamilyTier[a.family] = byFamilyTier[a.family] or {}
			byFamilyTier[a.family][t] = id
			statPool[t] = statPool[t] or {}
			table.insert(statPool[t], id)
		end
	end
	local epic = _bonusData.RARITY_ORDER and _bonusData.RARITY_ORDER.Epic or 4
	for id, p in _bonusData.BonusPassives or {} do
		local r = if type(p) == "table" then p.minRarity else nil
		local o = r and _bonusData.RARITY_ORDER and _bonusData.RARITY_ORDER[r]
		if o and o <= epic then
			passivePool[r] = passivePool[r] or {}
			table.insert(passivePool[r], id)
		end
	end
	for _, l in statPool do table.sort(l) end
	for _, l in passivePool do table.sort(l) end
	index = { byFamilyTier = byFamilyTier, statPool = statPool, passivePool = passivePool }
	return index
end

local function statGem(id: any): any?
	if type(id) ~= "string" or not _bonusData then return nil end
	local a = _bonusData.GetAttribute(id)
	if a and type(a.tier) == "number" and a.tier >= 1 and a.tier <= MAX_TIER then return a end
	return nil
end

local function passiveRarity(id: any, idx: any): string?
	if type(id) ~= "string" or not _bonusData then return nil end
	local p = _bonusData.GetPassive(id)
	if not p or not idx.passivePool[p.minRarity] then return nil end
	return p.minRarity
end

local function countOf(list: { string }): { [string]: number }
	local out = {}
	for _, id in list do out[id] = (out[id] or 0) + 1 end
	return out
end

--------------------------------------------------
-- PLAN (pure: changes nothing). req = { action, gem?, times?, gems? }.
-- Returns { action, gold, spend = { [id] = n }, gain = { [id] = n }?, pool = { id }?, times } or
-- nil + the refusal text.
--------------------------------------------------
function GemCraftService.Plan(playerId: string, req: any): (any?, string?)
	if not (_currency and _currency.CanAfford and _currency.GetGold and _bonusData and _state) then
		return nil, "Gem crafting is not wired"
	end
	local idx = getIndex()
	if not idx then return nil, "Gem crafting is not wired" end
	if type(req) ~= "table" or not GemCraftRules.ACTIONS[req.action] then return nil, INVALID end
	local st = _state() or {}
	if (tonumber(st.level) or 0) < 1 then return nil, "Runeforge is locked" end
	local d = tonumber(st.discountPct) or 0
	local action = req.action
	local times = 1
	local spend: { [string]: number } = {}
	local gain: { [string]: number }? = nil
	local pool: { string }? = nil
	local base = 0

	if action == "Upgrade" or action == "BreakDown" then
		times = math.floor(tonumber(req.times) or 1)
		if times < 1 or times > GemCraftRules.MAX_TIMES then return nil, INVALID end
		local a = statGem(req.gem)
		if not a then return nil, INVALID end
		local tier = a.tier
		if action == "Upgrade" then
			if tier >= MAX_TIER then return nil, REASONS.TopTier end
			local up = idx.byFamilyTier[a.family] and idx.byFamilyTier[a.family][tier + 1]
			if not up then return nil, REASONS.TopTier end
			spend[req.gem] = GemCraftRules.UPGRADE_INPUTS * times
			if not _currency.CanAfford(playerId, { gems = spend }) then return nil, REASONS.NeedThree end
			gain = { [up] = times }
			base = GemCraftRules.GOLD.Upgrade[tier]
		else
			if tier <= 1 then return nil, REASONS.NoBreakT1 end
			local down = idx.byFamilyTier[a.family] and idx.byFamilyTier[a.family][tier - 1]
			if not down then return nil, REASONS.NoBreakT1 end
			spend[req.gem] = times
			if not _currency.CanAfford(playerId, { gems = spend }) then return nil, NO_GEMS end
			gain = { [down] = GemCraftRules.BREAK_DOWN_OUTPUTS * times }
			base = GemCraftRules.GOLD.BreakDown[tier]
		end
	else
		local list = req.gems
		if type(list) ~= "table" or #list ~= GemCraftRules.MIX_INPUTS then return nil, INVALID end
		if action == "Mix" then
			local tier: number? = nil
			for _, id in list do
				local a = statGem(id)
				if not a then return nil, INVALID end
				if tier == nil then tier = a.tier elseif a.tier ~= tier then return nil, REASONS.SameTier end
			end
			local t = tier :: number
			if t >= MAX_TIER then return nil, REASONS.TopTier end
			pool = idx.statPool[t + 1]
			base = GemCraftRules.GOLD.Mix[t]
		else
			local rarity: string? = nil
			for _, id in list do
				local r = passiveRarity(id, idx)
				if not r then return nil, INVALID end
				if rarity == nil then rarity = r elseif r ~= rarity then return nil, REASONS.SameRarity end
			end
			pool = idx.passivePool[rarity :: string]
			base = GemCraftRules.GOLD.MixPassives
		end
		if not pool or #pool == 0 then return nil, INVALID end
		spend = countOf(list)
		if not _currency.CanAfford(playerId, { gems = spend }) then return nil, NO_GEMS end
	end

	local gold = GemCraftRules.Price(base, d) * times
	if (tonumber(_currency.GetGold(playerId)) or 0) < gold then return nil, REASONS.Gold end
	return { action = action, gold = gold, spend = spend, gain = gain, pool = pool, times = times,
		discountPct = d }, nil
end

--------------------------------------------------
-- CRAFT (atomic). Returns true, { action, gold, spent, gained, times } | false, reason.
--------------------------------------------------
function GemCraftService.Craft(playerId: string, req: any): (boolean, any)
	local plan, why = GemCraftService.Plan(playerId, req)
	if not plan then return false, why or INVALID end
	if not (_currency.Debit and _currency.Credit) then return false, "Gem crafting is not wired" end
	local gain = plan.gain
	if plan.pool then
		local pool = plan.pool
		gain = { [pool[_rng:NextInteger(1, #pool)]] = 1 } -- equal odds, server-side (SEC-002)
	end
	local paid, payWhy = _currency.Debit(playerId, { gold = plan.gold, gems = plan.spend })
	if not paid then
		-- Debit checks everything before charging anything: nothing was taken.
		return false, if payWhy == "Insufficient gold" then REASONS.Gold else tostring(payWhy or NO_GEMS)
	end
	_currency.Credit(playerId, { gems = gain })
	local outIds = {}
	for id, n in gain :: any do table.insert(outIds, `{id}x{n}`) end
	local inIds = {}
	for id, n in plan.spend do table.insert(inIds, `{id}x{n}`) end
	print(string.format("[GemCraftService] %s x%d | -%dg (discount %d%%) | in %s | out %s", plan.action,
		plan.times, plan.gold, plan.discountPct, table.concat(inIds, ","), table.concat(outIds, ",")))
	return true, { action = plan.action, gold = plan.gold, spent = plan.spend, gained = gain, times = plan.times }
end

return GemCraftService

--!strict
-- QuestGoalService.lua
-- CTRBLXAI | Quest main goals in battle (game_flow 41; build steps 1-3, 2026-11-17).
--
-- Holds the battle's main goal (state.questGoal) and decides goal wins/losses. BattleCoordinator's
-- battle-end check calls Evaluate after the "all Player units down = loss" check (so a loss always
-- wins a tie) and before the "all enemies down = win" check. Built: Wipe out, Slay, Kill target
-- (step 1), Survive, Reach, Activate (step 3). Any other goal id plays as Wipe out (warned once).
-- No AI changes (the Activate leash is step 7). The Activate object uses the Obelisk model/data;
-- players will see it named "Ancient Mechanism" when the goal text ships (step 8). Numbers come from ReplicatedStorage Content
-- QuestGoalData (DAT-001).
--
-- Evaluate verdicts: "Win" / "Loss" end the battle; "Hold" = the goal is still running and an
-- empty enemy side must NOT end it (Survive); nil = the normal side checks decide.
--
-- Runtime services (EnemyGenerator, ObjectEffectService, BattleVisualBroadcaster) are injected by
-- Main through Init, so this module requires nothing from the Game folder (cycle-free).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Content = ReplicatedStorage:WaitForChild("Content")
local QuestGoalData = require(Content:WaitForChild("QuestGoalData"))
local TerrainData = require(Content:WaitForChild("TerrainData"))
local ObjectData = require(Content:WaitForChild("ObjectData"))

local QuestGoalService = {}

local MARKER_KEY = "questGoal" -- BattleVisualBroadcaster.ObjectMarker key for the goal tile

local deps: any = {}
-- Main (battle wiring): { enemyGenerator, objectEffectService, broadcaster }. Missing deps make the
-- goals that need them fall back to Wipe out (logged), never error.
function QuestGoalService.Init(d: any)
	deps = d or {}
end

local warned: { [string]: boolean } = {}
local function warnOnce(key: string, msg: string)
	if warned[key] then return end
	warned[key] = true
	warn("[QuestGoalService] " .. msg)
end

-- An enemy that counts for Slay / the Survive cap: still on the Enemy side (a recruited enemy
-- turns Neutral and no longer counts), not a summon, not an item device. Reinforcements count.
local function isCountedEnemy(u: any): boolean
	return u.side == "Enemy" and not u.isSummon and not u.isItemDevice
end

-- A unit that can satisfy Reach / Activate: a living Player-side unit that isn't a summon or an
-- item device (recruits are Neutral, the Protect NPC will be Neutral too).
local function isGoalPlayer(u: any): boolean
	return u.isAlive == true and u.side == "Player" and not u.isSummon and not u.isItemDevice
end

-- Slay count: counted enemies that are KO'd right now. A revived enemy is alive again and stops
-- counting; if it falls again it counts once. A KO'd unit waiting on a revive counts (same rule as
-- the battle-end side count). Kills from any source count (AoE overshoot, terrain, friendly fire).
local function slainCount(state: any): number
	local n = 0
	for _, u in ipairs(state.units or {}) do
		if isCountedEnemy(u) and not u.isAlive then n += 1 end
	end
	return n
end

local function aliveEnemyCount(state: any): number
	local n = 0
	for _, u in ipairs(state.units or {}) do
		if isCountedEnemy(u) and u.isAlive then n += 1 end
	end
	return n
end

-- Tier / difficulty number for a goal (data rows are keyed by tier).
local function roundsFor(id: string, params: any, quest: any): number
	local fixed = tonumber(params and params.rounds)
	if fixed and fixed >= 1 then return math.floor(fixed) end
	local def: any = (QuestGoalData.Goals :: any)[id]
	local tier = QuestGoalData.TierOf(quest and quest.difficulty)
	local r = def and def.rounds and (def.rounds[tier] or def.rounds.Normal)
	return math.max(1, math.floor(tonumber(r) or 6))
end

--------------------------------------------------------------------
-- MAP: goal tile choice (Reach tile, Activate object). Uses the generated map's tiles
-- (tiles[y][x] with marker / terrain / elevation / object) and the same walking rule as
-- MapService's PD->ED connectivity check: passable terrain, elevation step <= 1, no blocking object.
--------------------------------------------------------------------
local CARDINAL = { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }

local function tileAt(tiles: any, x: number, y: number): any
	local row = tiles[y]
	return row and row[x]
end

local function walkable(t: any): boolean
	if not t then return false end
	local tDef = (TerrainData.Types :: any)[t.terrain]
	if not tDef or tDef.passable == false then return false end
	if t.object ~= nil then
		local oDef = (ObjectData.Objects :: any)[t.object]
		if not (oDef and oDef.passable) then return false end
	end
	return true
end

-- Walking distance from the nearest PD tile, for every reachable tile. Returns dist[y][x].
local function pdDistances(tiles: any): { [number]: { [number]: number } }
	local dist: { [number]: { [number]: number } } = {}
	local queue: { { number } } = {}
	for y, row in pairs(tiles) do
		for x, t in pairs(row) do
			if t.marker == "PD" and walkable(t) then
				dist[y] = dist[y] or {}
				dist[y][x] = 0
				table.insert(queue, { x, y })
			end
		end
	end
	local head = 1
	while head <= #queue do
		local cur = queue[head]
		head += 1
		local cx, cy = cur[1], cur[2]
		local ct = tileAt(tiles, cx, cy)
		local d = dist[cy][cx]
		for _, dir in ipairs(CARDINAL) do
			local nx, ny = cx + dir[1], cy + dir[2]
			local nt = tileAt(tiles, nx, ny)
			if nt and not (dist[ny] and dist[ny][nx]) and walkable(nt)
				and math.abs((tonumber(ct.elevation) or 0) - (tonumber(nt.elevation) or 0)) <= 1 then
				dist[ny] = dist[ny] or {}
				dist[ny][nx] = d + 1
				table.insert(queue, { nx, ny })
			end
		end
	end
	return dist
end

-- POI tiles reachable from PD, as candidates { x, y, d }, best first: candidates at least minDist
-- steps away come first in a seeded shuffle; if none are that far, the farthest come first.
-- forObject = the tile will hold a solid object, so it also needs a cardinal neighbour that is
-- reached BEFORE it (a closer neighbour), which stays reachable once the tile is blocked.
local function poiCandidates(map: any, minDist: number, rng: Random, forObject: boolean): { any }
	local tiles = map and map.tiles
	if type(tiles) ~= "table" then return {} end
	local dist = pdDistances(tiles)
	local list: { any } = {}
	for y, row in pairs(tiles) do
		for x, t in pairs(row) do
			local d = dist[y] and dist[y][x]
			if t.marker == "POI" and d and d > 0 and t.object == nil then
				local ok = true
				if forObject then
					ok = false
					for _, dir in ipairs(CARDINAL) do
						local nd = dist[y + dir[2]] and dist[y + dir[2]][x + dir[1]]
						if nd and nd < d then ok = true; break end
					end
				end
				if ok then table.insert(list, { x = x, y = y, d = d }) end
			end
		end
	end
	-- Stable order before the seeded shuffle (pairs order is not guaranteed).
	table.sort(list, function(a, b)
		if a.y ~= b.y then return a.y < b.y end
		return a.x < b.x
	end)
	local far, near = {}, {}
	for _, c in ipairs(list) do
		if c.d >= minDist then table.insert(far, c) else table.insert(near, c) end
	end
	for i = #far, 2, -1 do
		local j = rng:NextInteger(1, i)
		far[i], far[j] = far[j], far[i]
	end
	table.sort(near, function(a, b)
		if a.d ~= b.d then return a.d > b.d end
		if a.y ~= b.y then return a.y < b.y end
		return a.x < b.x
	end)
	for _, c in ipairs(near) do table.insert(far, c) end
	return far
end

-- A goal that can't be set up on this map plays as Wipe out, and the saved quest follows so a card
-- or briefing never promises a goal the battle doesn't run (same rule as Kill target, W3).
local function fallBack(quest: any, g: any, why: string)
	warn(string.format("[QuestGoalService] %s: %s; battle plays as Wipe out", g.id, why))
	if quest then
		quest.goalRolled = g.id
		quest.goal = "WipeOut"
		quest.goalParams = {}
	end
	g.id = "WipeOut"
	g.markerTiles = nil
end

-- Spawn time (Main, right after the enemies are generated, before any battlefield event can add
-- units): mark the Kill target. Boss quests use the Boss; other Kill target quests use their one
-- Elite (the roster leader QuestGenerator added), also tagged isEliteLeader like an elite encounter.
function QuestGoalService.TagTarget(quest: any, enemies: { any }?)
	if not quest or quest.goal ~= "KillTarget" then return end
	local want = if quest.goalParams and quest.goalParams.target == "Boss" then "Boss" else "Elite"
	for _, eu in ipairs(enemies or {}) do
		if eu.enemyType == want then
			eu.isGoalTarget = true
			if want == "Elite" then eu.isEliteLeader = true end
			return
		end
	end
	warn(string.format("[QuestGoalService] Kill target: no %s spawned for %s; battle plays as Wipe out",
		want, tostring(quest.name)))
	-- W3 (step 2): the saved quest follows the battle, so a card / briefing never promises a goal
	-- the battle doesn't run. goalRolled keeps the rolled id for logs.
	quest.goalRolled = "KillTarget"
	quest.goal = "WipeOut"
	quest.goalParams = {}
end

-- Battlefield events this quest's goal blocks (conflict rule, QuestGoalData.Conflicts), as a set
-- for BattlefieldEventService.SelectEventsForBattle. Uses the goal the battle really runs.
function QuestGoalService.BlockedEvents(quest: any): { [string]: boolean }
	local out: { [string]: boolean } = {}
	local gid = quest and quest.goal
	local c = gid and (QuestGoalData.Conflicts :: any)[gid]
	for _, name in ipairs((c and c.events) or {}) do out[name] = true end
	return out
end

-- Battle start (after CreateBattleState): build state.questGoal from the quest. Unknown, unbuilt
-- or broken goals fall back to Wipe out. `map` = the generated map (Reach / Activate tiles).
function QuestGoalService.BeginBattle(state: any, quest: any, map: any?)
	local id: string = (quest and quest.goal) or "WipeOut"
	if not QuestGoalData.IsBuilt(id) then
		if id ~= "WipeOut" then warnOnce("unbuilt_" .. id, "Goal " .. id .. " is not built yet; playing as Wipe out") end
		id = "WipeOut"
	end
	local params: any = table.clone((quest and quest.goalParams) or {})
	-- round follows the clock (1 at battle start; correct again after a dev map Regenerate).
	local g: any = { id = id, params = params, round = math.floor((tonumber(state.ct) or 0) / 1000) + 1 }
	local def: any = (QuestGoalData.Goals :: any)[id]
	-- Clear a goal tile marker left from an earlier pick (dev Regenerate); battle start already
	-- cleared every marker (ObjectEffectService reset), so this is a no-op there.
	if deps.broadcaster and deps.broadcaster.ObjectMarker then pcall(deps.broadcaster.ObjectMarker, MARKER_KEY, {}) end
	local rng = Random.new((tonumber(state.battleSeed) or 0) + 424242)

	if id == "KillTarget" then
		for _, u in ipairs(state.units or {}) do
			if u.isGoalTarget and u.side == "Enemy" then g.targetId = u.id; break end
		end
		if g.targetId == nil then
			warn("[QuestGoalService] Kill target not found at battle start; playing as Wipe out")
			g.id = "WipeOut"
		end
	elseif id == "Slay" then
		local want = tonumber(params.killTarget)
		if not want or want < 1 then
			-- Fallback (old quest without the number): share of the enemies on the field now.
			local start = 0
			for _, u in ipairs(state.units or {}) do
				if isCountedEnemy(u) and u.isAlive then start += 1 end
			end
			local share = QuestGoalData.Goals.Slay.killShare[QuestGoalData.TierOf(quest and quest.difficulty)]
			want = math.max(1, math.ceil(start * share))
		end
		params.killTarget = want
	elseif id == "Survive" then
		g.rounds = roundsFor(id, params, quest)
		params.rounds = g.rounds
		g.maxAlive = tonumber(def.maxAlive) or 12
		g.every = math.max(1, tonumber(def.spawnEveryCt) or 400)
		g.lastSpawnK = math.floor((tonumber(state.ct) or 0) / g.every)
		g.questLevel = tonumber(quest and quest.recommendedLvl) or 1
		if not (deps.enemyGenerator and deps.enemyGenerator.SpawnReinforcement) then
			warnOnce("survive_noeg", "Survive: EnemyGenerator not injected; no reinforcements will spawn")
		end
	elseif id == "Reach" then
		g.rounds = roundsFor(id, params, quest)
		params.rounds = g.rounds
		local cands = poiCandidates(map, QuestGoalData.MinPath(id, quest and quest.difficulty), rng, false)
		local pick = cands[1]
		if pick then
			g.tile = { x = pick.x, y = pick.y }
			g.markerTiles = { { x = pick.x, y = pick.y } }
			print(string.format("[QuestGoalService] Reach tile (%d,%d), %d steps from the deploy area",
				pick.x, pick.y, pick.d))
		else
			fallBack(quest, g, "no reachable POI tile on this map")
		end
	elseif id == "Activate" then
		g.rounds = roundsFor(id, params, quest)
		params.rounds = g.rounds
		local oes = deps.objectEffectService
		if not (oes and oes.PlaceObjectInstance) then
			fallBack(quest, g, "ObjectEffectService not injected")
		else
			local objType = def.objectType or "Obelisk"
			local placed: any = nil
			for _, c in ipairs(poiCandidates(map, QuestGoalData.MinPath(id, quest and quest.difficulty), rng, true)) do
				local okP, inst = pcall(oes.PlaceObjectInstance, state, objType, c.x, c.y, nil, nil)
				if okP and inst then
					inst.isGoalObject = true -- unbreakable / unpushable / Player-only Interact (ObjectEffectService)
					placed = inst
					g.tile = { x = c.x, y = c.y }
					print(string.format("[QuestGoalService] Activate object %s at (%d,%d), %d steps from the deploy area",
						objType, c.x, c.y, c.d))
					break
				end
			end
			if placed then
				g.objectId = placed.id
				g.markerTiles = { { x = g.tile.x, y = g.tile.y } }
			else
				fallBack(quest, g, "no POI tile could take the object")
			end
		end
	end

	state.questGoal = g
	print(string.format("[QuestGoalService] Main goal: %s%s", g.id,
		if g.id == "Slay" then " (" .. tostring(params.killTarget) .. " enemies)"
		elseif g.id == "KillTarget" then " (" .. tostring(params.target or "Elite") .. ")"
		elseif g.rounds then " (" .. tostring(g.rounds) .. " rounds)"
		else ""))
end

-- Per 1000-CT round hook (BattleCoordinator). Rounds are counted from 1.
function QuestGoalService.OnRoundStart(state: any, roundIndex: number)
	local g = state.questGoal
	if g then g.round = (tonumber(roundIndex) or 0) + 1 end
end

-- Survive: one reinforcement on a free ED tile. k = which 400-CT step this is (seed).
local function spawnSurvivor(state: any, g: any, k: number)
	local eg = deps.enemyGenerator
	if not (eg and eg.SpawnReinforcement) then return end
	local rng = Random.new((tonumber(state.battleSeed) or 0) + k * 7919 + 90001)
	local free: { any } = {}
	for _, t in ipairs(state.enemyDeployTiles or {}) do
		if type(t) == "table" and t.x and t.y then
			local isFree = true
			if eg.IsSpawnTileFree then isFree = eg.IsSpawnTileFree(state, t.x, t.y) end
			if isFree then table.insert(free, t) end
		end
	end
	if #free == 0 then
		print("[QuestGoalService] Survive: no free enemy deploy tile; spawn skipped")
		return
	end
	local tile = free[rng:NextInteger(1, #free)]
	local def: any = QuestGoalData.Goals.Survive
	local total = 0
	for _, e in ipairs(def.spawnTypes) do total += e.weight end
	local roll, kind = rng:NextNumber() * total, def.spawnTypes[1].type
	for _, e in ipairs(def.spawnTypes) do
		roll -= e.weight
		if roll < 0 then kind = e.type; break end
	end
	local level = math.max(1, g.questLevel + rng:NextInteger(def.levelOffset.min, def.levelOffset.max))
	local unit = eg.SpawnReinforcement({ type = kind, level = level }, { x = tile.x, y = tile.y }, state, rng, "Enemy")
	if not unit then return end
	unit.isGoalReinforcement = true
	local bvb = deps.broadcaster
	if bvb and bvb.UnitSpawned then pcall(bvb.UnitSpawned, unit) end
	print(string.format("[QuestGoalService] Survive reinforcement: %s Lv%d at (%d,%d), %d enemies alive",
		kind, level, tile.x, tile.y, aliveEnemyCount(state)))
end

-- Every clock step (BattleCoordinator, after the round hook): send the goal tile marker once, and
-- run the Survive spawn clock (one spawn per 400-CT step crossed while fewer than 12 are alive).
function QuestGoalService.OnClock(state: any)
	local g = state and state.questGoal
	if not g then return end
	if g.markerTiles and not g.markerSent then
		g.markerSent = true
		local bvb = deps.broadcaster
		if bvb and bvb.ObjectMarker then pcall(bvb.ObjectMarker, MARKER_KEY, g.markerTiles) end
	end
	if g.id == "Survive" and g.every then
		local k = math.floor((tonumber(state.ct) or 0) / g.every)
		while g.lastSpawnK < k do
			g.lastSpawnK += 1
			if g.round <= g.rounds and aliveEnemyCount(state) < g.maxAlive then
				spawnSurvivor(state, g, g.lastSpawnK)
			end
		end
	end
end

-- "Win", "Loss", "Hold" or nil (see header). Never errors on bad data.
function QuestGoalService.Evaluate(state: any): string?
	local g = state and state.questGoal
	if not g or g.id == "WipeOut" then return nil end
	if g.id == "Slay" then
		local want = tonumber(g.params and g.params.killTarget)
		if want and slainCount(state) >= want then return "Win" end
		return nil
	end
	if g.id == "KillTarget" then
		for _, u in ipairs(state.units or {}) do
			if u.id == g.targetId then
				if not u.isAlive or u.side ~= "Enemy" then return "Win" end
				return nil
			end
		end
		return nil
	end
	if g.id == "Survive" then
		if (tonumber(g.round) or 1) >= (tonumber(g.rounds) or 6) + 1 then return "Win" end
		return "Hold"
	end
	if g.id == "Reach" then
		local tile = g.tile
		if tile then
			for _, u in ipairs(state.units or {}) do
				if isGoalPlayer(u) and u.tileX == tile.x and u.tileY == tile.y then return "Win" end
			end
		end
		if (tonumber(g.round) or 1) > (tonumber(g.rounds) or 6) then return "Loss" end
		return nil
	end
	if g.id == "Activate" then
		if g.activated then return "Win" end
		if (tonumber(g.round) or 1) > (tonumber(g.rounds) or 6) then return "Loss" end
		return nil
	end
	warnOnce("eval_" .. tostring(g.id), "No evaluator for goal " .. tostring(g.id))
	return nil
end

function QuestGoalService.IsDecided(state: any): boolean
	local v = QuestGoalService.Evaluate(state)
	return v == "Win" or v == "Loss"
end

-- True while the goal must keep running even with no enemy left (Survive).
function QuestGoalService.HoldsWipe(state: any): boolean
	return QuestGoalService.Evaluate(state) == "Hold"
end

-- Map Details data (no player text; the client formats it at build step 8).
function QuestGoalService.Describe(state: any): any
	local g = state and state.questGoal
	if not g then return nil end
	local out: any = { id = g.id, round = g.round }
	if g.id == "Slay" then
		out.progress = slainCount(state)
		out.total = g.params and g.params.killTarget
	elseif g.id == "KillTarget" then
		out.target = g.params and g.params.target or "Elite"
	elseif g.id == "Survive" or g.id == "Reach" or g.id == "Activate" then
		out.rounds = g.rounds
		if g.tile then out.tile = { x = g.tile.x, y = g.tile.y } end
		if g.id == "Survive" then out.alive = aliveEnemyCount(state) end
	end
	return out
end

return QuestGoalService

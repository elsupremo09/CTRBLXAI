--!strict
-- QuestBoardScreen.lua
-- CTRBLXAI | Quest Board full screen, Board view (Quest Board redesign step 2, 2026-11-17).
-- Rules: docs\CTRBLXAI.db game_flow 34-41; plan PLAN_questboard_redesign_20261117.md sections 2/6.
--
-- Layout (GuildScreen, framed header like the guild base): crest + "QUEST BOARD" | status | currencies.
--   Main : the painted wood board (Theme.QuestBoardArt.Board) with one info line on top
--          ("{n} quests available", "New day in ...", "Boss rewards left today ...") and the quest
--          cards below it: the user's parchment sheet (Theme.QuestBoardArt.Card, 9-sliced) in a
--          2-column scrolling grid. The tapped card gets a gold glow.
--   Side : the inspector for the tapped card (full details, goal, rewards, promised gear, the
--          cancel-fee warning).
--   Buttons (lower right): Accept quest | Back.
--
-- Display + input only (ARC-001 / SEC-002): the server builds every quest (QuestGenerator), its
-- level range / cancel fee (Main.server) and the promised gear; Accept fires the existing
-- QuestSelected flow and Back the existing QuestBoardCancel flow through the guild menu (ctx).
-- The Quest accepted / Choose Party views are build steps 3 and 4 (today the guild menu's
-- sortie pages still run them).
--
-- Text: ONLY approved lines, used verbatim:
--   game_flow 39: "{n} quests available", "Level {a} – {b}" / "Level {n}", "Biome: {biome}",
--     "Rewards", promised gear "{Rarity} {gear type}", "Accept quest",
--     "Accepting sends scouts ahead. Cancelling later costs {fee} gold.", "Goal: {goal}" (17).
--   game_flow 41: the goal labels / sentences (QuestGoalText, the one place for them).
--   rule 275 (11:39 AM): "Battle Field Condition: {condition}".
--   Existing Quest Board lines (old page): "Consulting the board for available quests...",
--     "New day in {h}h {m}m", "Boss rewards left today: {n}/{m}" (built by the guild menu),
--     the Daily Contract note, the elite war band note, "{g} gold + kills" / "{a}-{b} gold",
--     " + {n} mercury", "+{n} Renown" / " (too easy)", "Deploy up to {n} units".

local WAIT = 10

local uiFolder = script.Parent
local themeModule = uiFolder:WaitForChild("Theme", WAIT)
local guildScreenModule = uiFolder:WaitForChild("GuildScreen", WAIT)
local goalTextModule = uiFolder:WaitForChild("QuestGoalText", WAIT)
if not themeModule or not guildScreenModule then
	error("[QuestBoardScreen] Theme / GuildScreen module not found")
end
-- Found at runtime via WaitForChild; the editor cannot follow that path (editor-only cast).
local Theme: any = (require :: any)(themeModule)
local GuildScreen: any = (require :: any)(guildScreenModule)
local QuestGoalText: any = if goalTextModule then (require :: any)(goalTextModule) else nil
if not QuestGoalText then warn("[QuestBoardScreen] QuestGoalText missing -- no goal lines") end

-- Gear names for the promised gear line ("{Rarity} {gear type}" = rarity + archetype name).
-- WeaponData / ArmorData are plain data in ReplicatedStorage.Content (also read by the client
-- inventory screens). Missing -> the promised gear line is hidden (never a stand-in word).
local WeaponData: any, ArmorData: any = nil, nil
do
	local rs = game:GetService("ReplicatedStorage")
	local content = rs:WaitForChild("Content", WAIT)
	if content then
		local w = content:WaitForChild("WeaponData", WAIT)
		local a = content:WaitForChild("ArmorData", WAIT)
		local okW, W = pcall(function() return if w then (require :: any)(w) else nil end)
		local okA, A = pcall(function() return if a then (require :: any)(a) else nil end)
		WeaponData = if okW then W else nil
		ArmorData = if okA then A else nil
	end
	if not WeaponData or not ArmorData then
		warn("[QuestBoardScreen] WeaponData / ArmorData missing -- promised gear lines hidden")
	end
end

local QuestBoardScreen = {}

export type Context = {
	parent: Instance,                         -- PlayerGui
	isBusy: () -> boolean,
	requestBack: (close: () -> ()) -> (),     -- Confirm/Discard prompt, then close
	onClosed: () -> (),                       -- Back: the guild menu cancels the board and goes home
	onAccept: (quest: any) -> (),             -- fires the existing QuestSelected flow
}

-- The board's data, as the guild menu got it from QuestBoardOpen.
export type BoardData = {
	quests: { any }?,
	newDayText: string?,        -- "New day in {h}h {m}m" (built by the guild menu, existing line)
	bossRewardsText: string?,   -- "Boss rewards left today: {n}/{m}" (existing line)
}

local ART: any = Theme.QuestBoardArt or {}
local INK: Color3 = ART.Ink or Color3.fromRGB(52, 34, 18)
local INK_SOFT: Color3 = ART.InkSoft or INK
local COLS = 2
local GAP = 8
local INFO_H = 18
local CARD_PAD_X = 12
local CARD_PAD_TOP = 18
local CARD_PAD_BOTTOM = 12
local ICON = 14
local BOSS_BADGE = 22

-- Existing Quest Board lines (old guild-menu page), verbatim.
local TXT_LOADING = "Consulting the board for available quests..."
local TXT_DAILY = "Daily Contract (one a day): win it for 3 mercury. Every 3rd one also gives 1 sulfur."
local TXT_ELITE = "Scouts report an elite war band! An Elite leads it, with one extra enemy. Win for extra rewards: mercury, crystals, maybe a rune gem, and a chance at better gear."

local ctx: Context? = nil
local screen: any = nil
local isOpen = false
local data: BoardData = {}
local selId: any = nil
local accepting = false   -- Accept sent; the guild menu re-opens in PreBattle (or closes) next
local curGold: number? = nil
local curRes: any = nil
local render: () -> () = function() end

--------------------------------------------------
-- TEXT (approved lines only; "" = hide the line)
--------------------------------------------------

local function levelText(q: any): string
	local lo = tonumber(q.levelMin)
	local hi = tonumber(q.levelMax)
	if lo and hi then
		if lo > hi then lo, hi = hi, lo end
		if lo == hi then return `Level {lo}` end
		return `Level {lo} – {hi}`
	end
	local one = tonumber(q.recommendedLvl)
	return if one then `Level {one}` else ""
end

local function biomeText(q: any): string
	return if type(q.biome) == "string" and q.biome ~= "" then `Biome: {q.biome}` else ""
end

local function goalLine(q: any): string
	if not QuestGoalText or not q.goal then return "" end
	return QuestGoalText.CardLine(q.goal)
end

local function goalSentence(q: any): string
	if not QuestGoalText or not q.goal then return "" end
	-- Capture / Kill target name their unit only in battle; the card keeps the 1-word goal
	-- (same rule as the old Quest details page).
	if q.goal == "Capture" or q.goal == "KillTarget" then return "" end
	local gp = q.goalParams or {}
	return QuestGoalText.Sentence({ id = q.goal, rounds = gp.rounds, total = gp.objects or gp.killTarget,
		lossAt = gp.lossAt })
end

local function goldText(q: any): string
	local g = q.rewards and q.rewards.gold
	if type(g) ~= "table" or g.min == nil then return "" end
	return if g.min == g.max then `{g.min} gold + kills` else `{g.min}-{g.max} gold`
end

local function mercuryOf(q: any): number
	return if q.rewards then (tonumber(q.rewards.mercury) or 0) else 0
end

local function renownText(q: any): string
	local rp = q.renownPreview
	if type(rp) ~= "table" or not tonumber(rp.amount) then return "" end
	return `+{rp.amount} Renown` .. (if rp.tooEasy then " (too easy)" else "")
end

-- Promised gear "{Rarity} {gear type}" (game_flow 36 / 39 line 5). Returns text + rarity.
local function promisedText(q: any): (string, string?)
	local pg = q.rewards and q.rewards.promisedGear
	if type(pg) ~= "table" or type(pg.archetypeId) ~= "string" or type(pg.rarity) ~= "string" then return "", nil end
	local def = (WeaponData and WeaponData.GetByArchetypeId and WeaponData.GetByArchetypeId(pg.archetypeId))
		or (ArmorData and ArmorData.GetByArchetypeId and ArmorData.GetByArchetypeId(pg.archetypeId))
	if type(def) ~= "table" or type(def.name) ~= "string" then return "", nil end
	return `{pg.rarity} {def.name}`, pg.rarity
end

local function conditionText(q: any): string
	return if type(q.condition) == "string" and q.condition ~= "" then `Battle Field Condition: {q.condition}` else ""
end

local function isBoss(q: any): boolean
	return q.questType == "Boss"
end

local function rarityColor(r: string?): Color3
	if r and Theme.GetRarityColor then
		local ok, c = pcall(Theme.GetRarityColor, r)
		if ok and typeof(c) == "Color3" then return c end
	end
	return Theme.Colors.TextPrimary
end

--------------------------------------------------
-- HELPERS (properties before Parent, NET-004)
--------------------------------------------------

local function makeText(parent: Instance?, text: string, size: number, color: Color3, bold: boolean?): TextLabel
	local lbl = Instance.new("TextLabel")
	lbl.BackgroundTransparency = 1
	lbl.BorderSizePixel = 0
	lbl.Font = if bold then Theme.Font.PrimaryBold else Theme.Font.Primary
	lbl.TextSize = size
	lbl.TextColor3 = color
	lbl.TextWrapped = true
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.TextYAlignment = Enum.TextYAlignment.Top
	lbl.Size = UDim2.new(1, 0, 0, 0)
	lbl.AutomaticSize = Enum.AutomaticSize.Y
	lbl.Text = text
	lbl.Parent = parent
	return lbl
end

local function makeIcon(parent: Instance, image: string?, size: number, order: number): ImageLabel?
	if type(image) ~= "string" or image == "" then return nil end
	local ic = Instance.new("ImageLabel")
	ic.BackgroundTransparency = 1
	ic.BorderSizePixel = 0
	ic.ScaleType = Enum.ScaleType.Fit
	ic.Image = image
	ic.Size = UDim2.fromOffset(size, size)
	ic.LayoutOrder = order
	ic.Parent = parent
	return ic
end

-- Inspector panel: a scrolling list of lines (filled by the caller through add()).
local function makeInspector(): (ScrollingFrame, (text: string, size: number, color: Color3, bold: boolean?) -> ())
	local sc = Instance.new("ScrollingFrame")
	sc.Name = "Detail"
	sc.Size = UDim2.fromScale(1, 1)
	sc.BackgroundTransparency = 1
	sc.BorderSizePixel = 0
	sc.ScrollBarThickness = 4
	sc.AutomaticCanvasSize = Enum.AutomaticSize.Y
	sc.CanvasSize = UDim2.new()
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 4)
	pad.PaddingRight = UDim.new(0, 8)
	pad.PaddingTop = UDim.new(0, 2)
	pad.Parent = sc
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 3)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = sc
	local order = 0
	local function add(text: string, size: number, color: Color3, bold: boolean?)
		if text == "" then return end
		order += 1
		local l = makeText(sc, text, size, color, bold)
		l.LayoutOrder = order
	end
	return sc, add
end

local function buttonRow(): Frame
	local row = Instance.new("Frame")
	row.Name = "Row1"
	row.Size = UDim2.new(1, 0, 0, GuildScreen.ROW_H)
	row.BackgroundTransparency = 1
	row.BorderSizePixel = 0
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Padding = UDim.new(0, GuildScreen.ROW_GAP)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = row
	return row
end

local function questKey(q: any, i: number): any
	return if q.id ~= nil then q.id else i
end

local function findSelected(quests: { any }): any?
	for i, q in quests do
		if questKey(q, i) == selId then return q end
	end
	local first = quests[1]
	selId = if first then questKey(first, 1) else nil
	return first
end

--------------------------------------------------
-- CARDS
--------------------------------------------------

-- One line on the parchment (ink colour, 1 line, shrinks to fit).
local function cardLine(parent: Instance, text: string, size: number, color: Color3, bold: boolean?, order: number,
	lines: number?): TextLabel?
	if text == "" then return nil end
	local h = size * (lines or 1) + 2
	local lbl = Instance.new("TextLabel")
	lbl.BackgroundTransparency = 1
	lbl.BorderSizePixel = 0
	lbl.Font = if bold then Theme.Font.PrimaryBold else Theme.Font.Primary
	lbl.TextSize = size
	lbl.TextColor3 = color
	lbl.TextWrapped = (lines or 1) > 1
	lbl.TextTruncate = Enum.TextTruncate.AtEnd
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.TextYAlignment = Enum.TextYAlignment.Top
	lbl.Size = UDim2.new(1, 0, 0, h)
	lbl.Text = text
	lbl.LayoutOrder = order
	lbl.Parent = parent
	return lbl
end

local function buildCard(q: any, i: number, w: number, h: number, small: number, body: number, sliceScale: number): TextButton
	local key = questKey(q, i)
	local selected = key == selId
	local card = Instance.new("TextButton")
	card.Name = "Quest_" .. tostring(i)
	card.Text = ""
	card.AutoButtonColor = false
	card.BackgroundTransparency = 1
	card.BorderSizePixel = 0
	card.Size = UDim2.fromOffset(w, h)
	card.LayoutOrder = i

	local sheet = Instance.new("ImageLabel")
	sheet.Name = "Parchment"
	sheet.BackgroundTransparency = 1
	sheet.BorderSizePixel = 0
	sheet.Image = ART.Card or ""
	sheet.ScaleType = Enum.ScaleType.Slice
	sheet.SliceCenter = ART.CardSlice or Rect.new(100, 140, 583, 850)
	sheet.SliceScale = sliceScale
	sheet.Size = UDim2.fromScale(1, 1)
	sheet.Active = false
	sheet.Parent = card

	if selected then
		-- Selected card: gold glow (same gold as the guild selection outlines).
		local glow = Instance.new("UIStroke")
		glow.Name = "Selected"
		glow.Color = Theme.Colors.TextGold
		glow.Thickness = 3
		glow.Transparency = 0.1
		glow.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		glow.Parent = card
	end

	local body_ = Instance.new("Frame")
	body_.Name = "Body"
	body_.BackgroundTransparency = 1
	body_.BorderSizePixel = 0
	body_.Position = UDim2.fromOffset(CARD_PAD_X, CARD_PAD_TOP)
	body_.Size = UDim2.new(1, -CARD_PAD_X * 2, 1, -(CARD_PAD_TOP + CARD_PAD_BOTTOM))
	body_.ClipsDescendants = true
	body_.Active = false
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 1)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = body_

	cardLine(body_, tostring(q.name or ""), body, INK, true, 1, 2)
	cardLine(body_, levelText(q), small, INK, false, 2)
	cardLine(body_, biomeText(q), small, INK_SOFT, false, 3)
	cardLine(body_, goalLine(q), small, INK, true, 4)

	-- Gold (+ mercury icon and number): the approved gold text, then the material icon.
	local gt = goldText(q)
	local merc = mercuryOf(q)
	if gt ~= "" or merc > 0 then
		local row = Instance.new("Frame")
		row.Name = "Rewards"
		row.BackgroundTransparency = 1
		row.BorderSizePixel = 0
		row.Size = UDim2.new(1, 0, 0, math.max(ICON, small + 2))
		row.LayoutOrder = 5
		local rl = Instance.new("UIListLayout")
		rl.FillDirection = Enum.FillDirection.Horizontal
		rl.VerticalAlignment = Enum.VerticalAlignment.Center
		rl.Padding = UDim.new(0, 3)
		rl.SortOrder = Enum.SortOrder.LayoutOrder
		rl.Parent = row
		if gt ~= "" then
			makeIcon(row, Theme.GuildIcons and Theme.GuildIcons.Gold, ICON, 1)
			local t = Instance.new("TextLabel")
			t.BackgroundTransparency = 1
			t.Font = Theme.Font.Primary
			t.TextSize = small
			t.TextColor3 = INK
			t.TextXAlignment = Enum.TextXAlignment.Left
			t.AutomaticSize = Enum.AutomaticSize.X
			t.Size = UDim2.fromOffset(0, small + 2)
			t.Text = gt
			t.LayoutOrder = 2
			t.Parent = row
		end
		if merc > 0 then
			makeIcon(row, Theme.GuildIcons and Theme.GuildIcons.Mercury, ICON, 3)
			local t = Instance.new("TextLabel")
			t.BackgroundTransparency = 1
			t.Font = Theme.Font.Primary
			t.TextSize = small
			t.TextColor3 = INK
			t.AutomaticSize = Enum.AutomaticSize.X
			t.Size = UDim2.fromOffset(0, small + 2)
			t.Text = tostring(merc)
			t.LayoutOrder = 4
			t.Parent = row
		end
		row.Parent = body_
	end

	-- Promised gear in its rarity colour, dark outline so light rarities read on parchment.
	local pText, pRarity = promisedText(q)
	local pl = cardLine(body_, pText, small, rarityColor(pRarity), true, 6)
	if pl then
		pl.TextStrokeColor3 = INK
		pl.TextStrokeTransparency = 0.35
	end
	body_.Parent = card

	-- Boss card: the existing Boss skull icon in the top-right corner (no text).
	if isBoss(q) and Theme.DungeonRoomIcons and Theme.DungeonRoomIcons.Boss then
		local b = Instance.new("ImageLabel")
		b.Name = "BossBadge"
		b.BackgroundTransparency = 1
		b.ScaleType = Enum.ScaleType.Fit
		b.Image = Theme.DungeonRoomIcons.Boss
		b.AnchorPoint = Vector2.new(1, 0)
		b.Position = UDim2.new(1, -CARD_PAD_X, 0, CARD_PAD_TOP - 6)
		b.Size = UDim2.fromOffset(BOSS_BADGE, BOSS_BADGE)
		b.ZIndex = 3
		b.Parent = card
	end

	card.Activated:Connect(function()
		if selId == key then return end
		selId = key
		render()
	end)
	return card
end

--------------------------------------------------
-- RENDER
--------------------------------------------------

local function renderBoard()
	local c = ctx
	if not c then return end
	local main = screen.Main
	local quests: { any }? = if type(data.quests) == "table" then data.quests else nil
	local small = Theme.Text.Small()
	local body = Theme.Text.Body()

	-- Wood board behind everything in Main.
	local board = Instance.new("ImageLabel")
	board.Name = "Board"
	board.BackgroundTransparency = 1
	board.BorderSizePixel = 0
	board.Image = ART.Board or ""
	board.ScaleType = Enum.ScaleType.Crop
	board.Size = UDim2.fromScale(1, 1)
	board.ZIndex = 0
	board.Parent = main

	-- Info line: "{n} quests available" · "New day in ..." · "Boss rewards left today ...".
	local parts: { string } = {}
	if quests then table.insert(parts, `{#quests} quests available`) end
	if type(data.newDayText) == "string" and data.newDayText ~= "" then table.insert(parts, data.newDayText) end
	if type(data.bossRewardsText) == "string" and data.bossRewardsText ~= "" then table.insert(parts, data.bossRewardsText) end
	local info = Instance.new("TextLabel")
	info.Name = "Info"
	info.BackgroundTransparency = 1
	info.BorderSizePixel = 0
	info.Font = Theme.Font.PrimaryBold
	info.TextColor3 = Theme.Colors.TextGold
	info.TextStrokeColor3 = Color3.new(0, 0, 0)
	info.TextStrokeTransparency = 0.4
	info.TextXAlignment = Enum.TextXAlignment.Left
	info.TextTruncate = Enum.TextTruncate.AtEnd
	info.TextScaled = true
	local cap = Instance.new("UITextSizeConstraint")
	cap.MaxTextSize = small
	cap.MinTextSize = 9
	cap.Parent = info
	info.Position = UDim2.fromOffset(GAP, 4)
	info.Size = UDim2.new(1, -GAP * 2, 0, INFO_H)
	info.Text = if quests then table.concat(parts, "  ·  ") else TXT_LOADING
	info.ZIndex = 2
	info.Parent = main

	if not quests then return end
	local top = INFO_H + 8
	local grid = Instance.new("ScrollingFrame")
	grid.Name = "Grid" -- GuildScreen keeps the scroll position for a frame named Grid
	grid.BackgroundTransparency = 1
	grid.BorderSizePixel = 0
	grid.Position = UDim2.fromOffset(GAP, top)
	grid.Size = UDim2.new(1, -GAP * 2, 1, -(top + GAP))
	grid.ScrollBarThickness = 4
	grid.ScrollingDirection = Enum.ScrollingDirection.Y
	grid.AutomaticCanvasSize = Enum.AutomaticSize.Y
	grid.CanvasSize = UDim2.new()
	grid.ZIndex = 2
	local pad = Instance.new("UIPadding")
	pad.PaddingBottom = UDim.new(0, GAP)
	pad.PaddingRight = UDim.new(0, 6) -- room for the scroll bar
	pad.Parent = grid

	-- 2 columns sized from the real panel width; card height fits the 6 card lines.
	local mainW = (main :: any).AbsoluteSize.X
	if mainW <= 0 then mainW = 430 end
	local gridW = mainW - GAP * 2 - 6
	local cardW = math.max(140, math.floor((gridW - GAP * (COLS - 1)) / COLS))
	local needH = CARD_PAD_TOP + CARD_PAD_BOTTOM + (body * 2 + 2) + (small + 2) * 4 + math.max(ICON, small + 2) + 8
	local cardH = math.max(needH, math.floor(cardW * 0.55))
	local phone = (main :: any).AbsoluteSize.Y > 0 and (main :: any).AbsoluteSize.Y < 320
	local sliceScale = if phone then (ART.CardSliceScalePhone or 0.25) else (ART.CardSliceScale or 0.35)
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.fromOffset(cardW, cardH)
	layout.CellPadding = UDim2.fromOffset(GAP, GAP)
	layout.FillDirectionMaxCells = COLS
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = grid

	for i, q in quests do
		buildCard(q, i, cardW, cardH, small, body, sliceScale).Parent = grid
	end
	grid.Parent = main
end

local function renderInspector(q: any?)
	local sc, add = makeInspector()
	if q then
		local small = Theme.Text.Small()
		local bodyT = Theme.Text.Body()
		add(tostring(q.name or ""), Theme.Text.Heading(), Theme.Colors.TextGold, true)
		add(levelText(q), bodyT, Theme.Colors.TextPrimary)
		add(biomeText(q), bodyT, Theme.Colors.TextPrimary)
		add(conditionText(q), bodyT, Theme.Colors.TextPrimary)
		if tonumber(q.playerSlots) then add(`Deploy up to {q.playerSlots} units`, bodyT, Theme.Colors.TextPrimary) end
		add(goalLine(q), bodyT, Theme.Colors.TextGold, true)
		add(goalSentence(q), bodyT, Theme.Colors.TextPrimary)
		if q.elite then add(TXT_ELITE, small, Theme.Colors.TextSecondary) end
		if q.isDailyContract then add(TXT_DAILY, small, Theme.Colors.TextSecondary) end
		-- Rewards
		local gt = goldText(q)
		local merc = mercuryOf(q)
		local rt = renownText(q)
		local pText, pRarity = promisedText(q)
		if gt ~= "" or merc > 0 or rt ~= "" or pText ~= "" then
			add("Rewards", bodyT, Theme.Colors.TextGold, true)
			local reward = gt
			if merc > 0 then reward = if reward ~= "" then `{reward} + {merc} mercury` else `{merc} mercury` end
			add(reward, bodyT, Theme.Colors.TextPrimary)
			add(rt, bodyT, Theme.Colors.TextPrimary)
			add(pText, bodyT, rarityColor(pRarity), true)
		end
		local fee = tonumber(q.cancelFee)
		-- fee 0 / missing: line hidden (user 2026-11-18 12:03 AM)
		if fee and fee > 0 then
			add(`Accepting sends scouts ahead. Cancelling later costs {fee} gold.`, small, Theme.Colors.TextSecondary)
		end
	end
	sc.Parent = screen.Side
end

local function renderButtons(q: any?)
	local c = ctx
	if not c then return end
	local row = buttonRow()
	local canAccept = q ~= nil and not accepting
	Theme.MakeBarButton(row, "Accept quest", if canAccept then "Primary" else "Disabled", function()
		local cc = ctx
		if not canAccept or not q or not cc or cc.isBusy() or accepting then return end
		accepting = true
		render()
		cc.onAccept(q)
	end, { name = "Btn_AcceptQuest", minHeight = GuildScreen.ROW_H, layoutOrder = 1 })
	local back = Theme.MakeIconButton(nil, "Back", function()
		local cc = ctx
		if cc then cc.requestBack(QuestBoardScreen.Close) end
	end, { name = "Btn_BACK", size = UDim2.fromOffset(GuildScreen.ROW_H, GuildScreen.ROW_H) })
	back.LayoutOrder = 99
	back.Parent = row
	row.Parent = screen.Buttons
end

local function applyCurrencies()
	if not screen or curGold == nil or not screen.SetCurrencies then return end
	local okS, CurrencyStrip = pcall(function()
		local m = uiFolder:FindFirstChild("CurrencyStrip")
		return if m then (require :: any)(m) else nil
	end)
	local wc = if okS and CurrencyStrip and CurrencyStrip.WithCommas then CurrencyStrip.WithCommas
		else function(n: any): string return tostring(n) end
	local res = curRes or {}
	screen.SetCurrencies({
		{ "Gold", wc(curGold) },
		{ "Mercury", wc(res.mercury or 0) },
		{ "Crystal", wc(res.crystals or 0) },
		{ "Sulfur", wc(res.sulfur or 0) },
	}, { Crystal = true, Sulfur = true }) -- same keys / rows as the guild base header
end

render = function()
	if not ctx or not screen or not isOpen then return end
	screen.Clear("Board")
	local quests: { any } = if type(data.quests) == "table" then data.quests else {}
	local q = findSelected(quests)
	renderBoard()
	renderInspector(q)
	renderButtons(q)
end

--------------------------------------------------
-- PUBLIC (same shape as the other guild screens)
--------------------------------------------------

function QuestBoardScreen.Init(c: Context)
	ctx = c
end

function QuestBoardScreen.IsOpen(): boolean
	return isOpen
end

function QuestBoardScreen.GetGui(): ScreenGui?
	return if isOpen and screen then screen.Gui else nil
end

function QuestBoardScreen.Open(d: BoardData?)
	local c = ctx
	if not c then
		warn("[QuestBoardScreen] Open called before Init")
		return
	end
	if not screen then
		screen = GuildScreen.Create({ name = "QuestBoardScreen", title = "QUEST BOARD", parent = c.parent, -- renamed 11-13
			crest = Theme.GuildIcons.AdventurersGuild }) -- same icon as the guild menu Quest Board button
		screen.SetButtonRows(1)
		-- Card sizes come from Main's real width: redraw once when it settles / the window resizes.
		-- The connection lives with Main (destroyed with the ScreenGui, PRF-004).
		local lastW = 0
		screen.Main:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			local w = screen.Main.AbsoluteSize.X
			if not isOpen or math.abs(w - lastW) < 4 then return end
			lastW = w
			render()
		end)
	end
	data = d or {}
	selId = nil
	accepting = false
	isOpen = true
	screen.SetStatus("")
	screen.Show()
	applyCurrencies()
	render()
end

-- New board data while open (QuestBoardOpen arrived, or the guild menu re-rendered). Keeps the
-- selection when the same quest is still on the board.
function QuestBoardScreen.SetData(d: BoardData?)
	data = d or {}
	if isOpen then render() end
end

-- Back path: hide and hand control back to the opener (it cancels the board and goes home).
function QuestBoardScreen.Close()
	if not isOpen then return end
	isOpen = false
	accepting = false
	if screen then screen.ClosePrompt(); screen.Hide() end
	local c = ctx
	if c then c.onClosed() end
end

-- Forced hide (menu re-opened / closed by the server, quest accepted): no onClosed.
function QuestBoardScreen.Hide()
	if not isOpen then return end
	isOpen = false
	accepting = false
	if screen then screen.ClosePrompt(); screen.Hide() end
end

function QuestBoardScreen.SetGold(text: string)
	if screen then screen.SetGold(text) end
end

function QuestBoardScreen.SetCurrencies(gold: number, res: any)
	curGold = gold
	curRes = res
	if isOpen then applyCurrencies() end
end

function QuestBoardScreen.SetStatus(text: string, isError: boolean?)
	if screen then screen.SetStatus(text, isError) end
end

return table.freeze(QuestBoardScreen)

--!strict
-- DungeonRelicBar.lua
-- CTRBLXAI | Dungeon relics on the map screen (Dungeon build step 8, 2026-11-14; project_rules 271/275).
-- Display only: relic list comes from the server state (run.relics), nothing is sent back except
-- the AckRelic action when a "Relic found" popup closes. Only approved text (rule 275):
--   RL-UI-HEAD "Relics", RL-UI-NONE "No relics yet", RL-UI-RARITY "{rarity} relic", RL-UI-USED "Used",
--   RL-UI-FOUND-T "Relic found!", RL-UI-FOUND-1 "{name}", RL-UI-FOUND-2 "{effect}",
--   RL-UI-FOUND-3 "Lasts until this run ends.", Boss handover "The Boss's hoard glints. Relic found: {name}!",
--   RL-UI-END "Relics fade when you leave the dungeon."
-- Placeholder icons: a round gem coloured by rarity (Theme.GetRarityColor), no new art.

local uiFolder = script.Parent
local Theme: any = (require :: any)(uiFolder:WaitForChild("Theme", 10))

local Bar = {}

Bar.END_LINE = "Relics fade when you leave the dungeon." -- RL-UI-END

local GEM_D = 30 -- gem size; each gem sits in a 44 px tap target

--- Draw the relic bar into `parent` (a frame NODE_H tall). deps = { makeText, popup, closeOverlay, ts }.
function Bar.Draw(parent: Instance, relics: { any }?, deps: any)
	local list = relics or {}
	local head = deps.makeText(parent, "Relics", deps.ts(), Theme.Colors.TextSecondary, true) -- RL-UI-HEAD
	head.Size = UDim2.new(0, 56, 1, 0)
	if #list == 0 then
		local none = deps.makeText(parent, "No relics yet", deps.ts(), Theme.Colors.TextSecondary) -- RL-UI-NONE
		none.Position = UDim2.fromOffset(58, 0)
		none.Size = UDim2.new(1, -58, 1, 0)
		return
	end
	local strip = Instance.new("ScrollingFrame")
	strip.Name = "RelicStrip"
	strip.BackgroundTransparency = 1
	strip.BorderSizePixel = 0
	strip.Position = UDim2.fromOffset(58, 0)
	strip.Size = UDim2.new(1, -58, 1, 0)
	strip.ScrollBarThickness = 3
	strip.ScrollingDirection = Enum.ScrollingDirection.X
	strip.CanvasSize = UDim2.fromOffset(#list * 46, 0)
	local lay = Instance.new("UIListLayout")
	lay.FillDirection = Enum.FillDirection.Horizontal
	lay.VerticalAlignment = Enum.VerticalAlignment.Center
	lay.Padding = UDim.new(0, 2)
	lay.SortOrder = Enum.SortOrder.LayoutOrder
	lay.Parent = strip
	for i, r in list do
		local b = Instance.new("TextButton")
		b.Name = "Relic_" .. tostring(r.id)
		b.Text = ""
		b.AutoButtonColor = false
		b.BackgroundTransparency = 1
		b.Size = UDim2.fromOffset(44, 44)
		b.LayoutOrder = i
		local gem = Instance.new("Frame")
		gem.AnchorPoint = Vector2.new(0.5, 0.5)
		gem.Position = UDim2.fromScale(0.5, 0.5)
		gem.Size = UDim2.fromOffset(GEM_D, GEM_D)
		gem.Rotation = 45
		gem.BackgroundColor3 = Theme.GetRarityColor(r.rarity or "Common") or Theme.Colors.TextPrimary
		gem.BackgroundTransparency = if r.used then 0.6 else 0
		gem.BorderSizePixel = 0
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, 5)
		c.Parent = gem
		local s = Instance.new("UIStroke")
		s.Color = Theme.Colors.TextPrimary
		s.Thickness = 1
		s.Transparency = 0.4
		s.Parent = gem
		gem.Parent = b
		b.Activated:Connect(function()
			local lines: { any } = {
				{ tostring(r.name), Theme.Text.Heading(), Theme.GetRarityColor(r.rarity or "Common"), true }, -- RL-UI-FOUND-1
				{ `{r.rarity} relic`, nil, Theme.Colors.TextSecondary },                                      -- RL-UI-RARITY
				{ tostring(r.text) },                                                                       -- RL-UI-FOUND-2
			}
			if r.used then table.insert(lines, { "Used", nil, Theme.Colors.TextSecondary }) end            -- RL-UI-USED
			deps.popup("RelicInfo", lines, { { icon = "Back", onTap = deps.closeOverlay } })
		end)
		b.Parent = strip
	end
	strip.Parent = parent
end

--- "Relic found" popup for run.relicFound = { id, boss }. onClose sends AckRelic.
function Bar.ShowFound(found: any, relics: { any }?, deps: any, onClose: () -> ())
	local r: any = nil
	for _, x in relics or {} do if x.id == found.id then r = x end end
	if not r then onClose() return end
	local lines: { any }
	if found.boss then
		lines = {
			{ `The Boss's hoard glints. Relic found: {r.name}!`, Theme.Text.Heading(), Theme.Colors.TextGold, true },
			{ tostring(r.text) },
			{ "Lasts until this run ends.", nil, Theme.Colors.TextSecondary },                  -- RL-UI-FOUND-3
		}
	else
		lines = {
			{ "Relic found!", Theme.Text.Heading(), Theme.Colors.TextGold, true },             -- RL-UI-FOUND-T
			{ tostring(r.name), nil, Theme.GetRarityColor(r.rarity or "Common"), true },      -- RL-UI-FOUND-1
			{ `{r.rarity} relic`, nil, Theme.Colors.TextSecondary },                           -- RL-UI-RARITY
			{ tostring(r.text) },                                                            -- RL-UI-FOUND-2
			{ "Lasts until this run ends.", nil, Theme.Colors.TextSecondary },                 -- RL-UI-FOUND-3
		}
	end
	deps.popup("RelicFound", lines, { { icon = "Back", onTap = function() deps.closeOverlay(); onClose() end } })
end

return table.freeze(Bar)

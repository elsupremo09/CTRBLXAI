--!strict
-- FurnitureService.lua
-- CTRBLXAI | Guild Hall furniture. v4 rebuild STEP 2 of 5 (2026-11-16): rolled piece INSTANCES,
-- room spots, save format v2 + old-save conversion. Rules: docs\CTRBLXAI.db guild_facilities 91-108
-- (v4 APPROVED 7:02 PM; data in FurnitureData.V4).
--
-- STEP 2 SCOPE (deliberate):
--   * Owns piece instances { uid, id, rarity, lines, sig, fixed } instead of owned flags.
--   * Rolls instances with the V4 rarity / pool / point tables (seeded; Fortune never applies).
--   * Places them in ROOM SPOTS (V4.Rooms by Guild Hall level; floor spots by category, wall
--     spots take Wall pieces). Pieces that don't fit go to storage. Nothing is ever deleted.
--   * Computes the V4 totals (cap 8 x GH, 40 per kind, threshold +2 / +1 per kind shared by
--     player and enemy lines) and exposes them via V4Totals() / State().v4 -- NOT applied yet
--     (unit stats = step 3, enemies = step 4).
--   * Units keep TODAY'S stats: BonusFor() returns the legacy (block 1) totals computed from the
--     placed instances' piece ids, exactly as before (cap 6 x GH, family 30, same piece once).
--   * Old remotes keep working (Buy / Place / Remove / Craft / CraftRows / Seen / State); State()
--     still sends the old fields (slots = floor spots, decor = wall spots, owned ids, shop).
--
-- OWNS: piece instances, room placements, the computed totals, the notice flag.
-- MUST NOT OWN: gold (CurrencyService), Guild Hall level (GuildMenuService), Rank (RenownService),
-- unit stats (EquipmentService reads BonusFor). All injected via Init (ARC-004 / ARC-006).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local FurnitureData = require(ReplicatedStorage:WaitForChild("Content"):WaitForChild("FurnitureData"))
local V4: any = FurnitureData.V4

local FurnitureService = {}

local SAVE_VERSION = 2
local WELCOME_GIFT = table.freeze({ "FUR-01", "FUR-06" }) -- Straw Cot + Scribe's Desk (row 97)
local BANNER_ID = "FUR-22"
local PEDESTAL_ID = "FUR-21"
local PEDESTAL_RANK = 32
local MAX_INSTANCES = 400 -- save sanity bound
local STEP = 0.5           -- value step for percent / percentage-point kinds

-- Approved text (guild_facilities 98).
local TXT_DUP = "You already have this piece out."
local TXT_LOCKED_RUN = "You can't change furniture during a battle or dungeon run."

type Deps = {
	getGuildHallLevel: (() -> number)?,
	getRank: (() -> number)?,
	getGold: (() -> number)?,
	spendGold: ((number) -> (boolean, string?))?,
	canChangeNow: (() -> boolean)?,
	canBuyNow: (() -> boolean)?,
	isPlayerUnit: ((any) -> boolean)?,
	rebuildAll: (() -> ())?,
	markDirty: (() -> ())?,
	getMaterials: (() -> { [string]: number })?,
	spendCost: (({ [string]: number }) -> (boolean, string?))?,
	isBuildingOpen: ((string) -> boolean)?,
}
local deps: Deps = {}

type Line = { kind: string, value: number, points: number, enemy: boolean?, threshold: boolean?, signature: boolean? }
type Inst = { uid: string, id: string, rarity: string, lines: { Line }, fixed: boolean?, looks: boolean?, src: string? }

local instances: { [string]: Inst } = {}
local placement: { [string]: string } = {}   -- spotKey -> uid
local nextUid = 1
local noticePending = false
local convSeed = 0
local pendingPlace: { string }? = nil         -- old-save conversion: uids to place at Init (GH known)

-- Computed.
local legacyBonus: { [string]: number } = {}
local legacyStatus: { [string]: string } = {} -- spotKey -> ok | capped | invalid
local legacyPoints = 0
local v4Totals: any = { player = {}, enemy = {}, threshold = {}, points = 0, cap = 8, status = {} }

--------------------------------------------------
-- helpers
--------------------------------------------------

local function ghLevel(): number
	local l = deps.getGuildHallLevel and deps.getGuildHallLevel() or 1
	return math.clamp(math.floor(tonumber(l) or 1), 1, 10)
end

local function rank(): number
	local r = deps.getRank and deps.getRank() or 1
	return math.max(1, math.floor(tonumber(r) or 1))
end

local function hash(s: string): number
	local h = 7
	for i = 1, #s do h = (h * 31 + string.byte(s, i)) % 2147483647 end
	return h
end

local function newUid(): string
	local u = "f" .. tostring(nextUid)
	nextUid += 1
	return u
end

type Spot = { key: string, room: string, roomName: string, wall: boolean, accepts: { string }? }

--- Open spots for a Guild Hall level: floor spots first (room order), then wall spots.
local function spotsFor(gh: number): ({ Spot }, { Spot })
	local floor, wall = {}, {}
	for _, r in V4.RoomsFor(gh) do
		for i, acc in r.floor do
			table.insert(floor, { key = `{r.id}/f{i}`, room = r.id, roomName = r.name, wall = false, accepts = acc })
		end
		for i = 1, (r.wall or 0) do
			table.insert(wall, { key = `{r.id}/w{i}`, room = r.id, roomName = r.name, wall = true })
		end
	end
	return floor, wall
end

local function fits(inst: Inst, spot: Spot): boolean
	local p = V4.Get(inst.id)
	if not p then return false end
	if spot.wall then return p.category == "Wall" end
	return spot.accepts ~= nil and table.find(spot.accepts, p.category) ~= nil
end

local function placedKey(uid: string): string?
	for k, u in placement do if u == uid then return k end end
	return nil
end

local FLAT_KINDS: { [string]: boolean } = {
	STR = true, AGI = true, DEX = true, INT = true, VIT = true, LUK = true,
	maxHp = true, maxMp = true, attack = true, defense = true, hpLoss = true, mpLoss = true,
}
local function isStepKind(kind: string): boolean
	return not FLAT_KINDS[kind]
end

--------------------------------------------------
-- ROLLER (V4 rows 101-104, 107, 108). Fortune never applies (row 101 / D: FortuneAffectsRarity=false).
--------------------------------------------------

local SOURCE_KEY = { Shop = "shop", Crafted = "craft", DungeonDrop = "dungeon", BossDrop = "boss" }

local function highestOpenAtOrBelow(rar: string, gh: number): string
	local order = V4.RarityOrder
	local idx = table.find(order, rar) or 1
	for i = idx, 1, -1 do
		if V4.RarityOpen(order[i], gh) then return order[i] end
	end
	return "Common"
end

local function rollRarity(rng: Random, src: string, gh: number, stepBonus: number?): string
	local total = 0
	for _, name in V4.RarityOrder do total += (V4.Rarities[name].weights[src] or 0) end
	local pick = "Common"
	if total > 0 then
		local x = rng:NextNumber() * total
		for _, name in V4.RarityOrder do
			local w = V4.Rarities[name].weights[src] or 0
			if w > 0 then
				if x < w then pick = name break end
				x -= w
			end
		end
	end
	if stepBonus and stepBonus > 0 then
		local idx = math.min((table.find(V4.RarityOrder, pick) or 1) + stepBonus, #V4.RarityOrder)
		pick = V4.RarityOrder[idx]
	end
	-- row 104: a locked rarity rolls the highest open one instead.
	return highestOpenAtOrBelow(pick, gh)
end

local function pick(rng: Random, list: { string }?): string?
	if not list or #list == 0 then return nil end
	return list[rng:NextInteger(1, #list)]
end

local function makeLine(rng: Random, kind: string, ptsRange: { number }, enemy: boolean): Line?
	local price = if enemy then V4.Enemy.PointPrice[kind] else V4.PointPrice[kind]
	if type(price) ~= "number" or price <= 0 then return nil end
	local pts = rng:NextInteger(ptsRange[1], ptsRange[2])
	local raw = pts / price
	local value: number
	if isStepKind(kind) then
		value = math.max(STEP, math.floor(raw / STEP) * STEP)
	else
		value = math.max(1, math.floor(raw))
	end
	local cap = if enemy then V4.Enemy.Max[kind] else V4.SecondaryMax[kind]
	if type(cap) == "number" then value = math.min(value, cap) end
	return { kind = kind, value = value, points = value * price, enemy = if enemy then true else nil }
end

local function thresholdPool(typeName: string, enemy: boolean): { string }
	-- W-B: enemy threshold kinds come ONLY from row 108 (V4.Enemy.Threshold); never the player list.
	local src = if enemy then V4.Enemy.Threshold[typeName] else V4.Types[typeName].threshold
	local out = {}
	for _, k in src or {} do
		if k ~= "range" or V4.Threshold.RangeEnabled then table.insert(out, k) end
	end
	local t = V4.Types[typeName]
	if V4.Threshold.RangeEnabled and t.thresholdIfRangeOn then table.insert(out, t.thresholdIfRangeOn) end
	return out
end

--- Roll one new instance of a piece. forcedRarity (old-save conversion / dev) skips the rarity roll.
local function rollInstance(id: string, src: string, rng: Random, forcedRarity: string?): Inst?
	local p = V4.Get(id)
	if not p then return nil end
	local inst: Inst = { uid = newUid(), id = id, rarity = "None", lines = {}, src = src }
	if p.looksOnly then inst.looks = true return inst end
	if p.fixed then inst.fixed = true inst.rarity = "Fixed" return inst end
	local gh = ghLevel()
	local rar = forcedRarity or rollRarity(rng, src, gh, p.rarityStepBonus)
	inst.rarity = rar
	local r = V4.Rarities[rar]
	local T = V4.Types[p.type]
	if not (r and T) then return inst end
	-- signature line (always present; old block-1 point price toward the cap)
	if p.signature then
		for k, v in p.signature do
			local old = FurnitureData.Get(id)
			table.insert(inst.lines, { kind = k, value = v, points = if old then old.points else (v * (V4.PointPrice[k] or 0)), signature = true })
		end
	end
	for _ = 1, r.lines do
		local enemy = rng:NextNumber() < V4.Enemy.LineChance
		local secondary = r.secondaryShare > 0 and rng:NextNumber() < r.secondaryShare
		local kind: string?
		if enemy then
			kind = if secondary then pick(rng, V4.Enemy.Secondary[p.type]) else pick(rng, V4.Enemy.Basic[p.type])
			if secondary and V4.Enemy.SecondarySignature[p.type] and rng:NextNumber() < V4.SignatureShare then
				kind = V4.Enemy.SecondarySignature[p.type]
			end
		else
			if secondary and T.signature and rng:NextNumber() < V4.SignatureShare then
				kind = T.signature
			else
				kind = if secondary then pick(rng, T.secondary) else pick(rng, T.basic)
			end
		end
		local line = kind and makeLine(rng, kind, r.pts, enemy) or nil
		if line then table.insert(inst.lines, line) end
	end
	for _ = 1, (r.threshold or 0) do
		local enemy = rng:NextNumber() < V4.Enemy.LineChance
		local pool = thresholdPool(p.type, enemy)
		if enemy and #pool == 0 then -- W-B: type has no enemy threshold kind -> player threshold line
			enemy = false
			pool = thresholdPool(p.type, false)
		end
		local kind = pick(rng, pool)
		if kind then
			table.insert(inst.lines, { kind = kind, value = if enemy then -1 else 1, points = 0, threshold = true, enemy = if enemy then true else nil })
		end
	end
	return inst
end

--------------------------------------------------
-- TOTALS
--------------------------------------------------

local MULTIPLIER_KEYS: { [string]: boolean } = { rtDelayResist = true, collision = true }

local function orderedPlaced(gh: number): { { spot: Spot, inst: Inst } }
	local floor, wall = spotsFor(gh)
	local out = {}
	for _, list in { floor, wall } do
		for _, s in list do
			local u = placement[s.key]
			local inst = u and instances[u] or nil
			if inst then table.insert(out, { spot = s, inst = inst }) end
		end
	end
	return out
end

-- Legacy totals (block 1): what units get TODAY. Same logic as before the rebuild.
local function recomputeLegacy(gh: number)
	local cap = FurnitureData.CapFor(gh)
	local out: { [string]: number } = {}
	local status: { [string]: string } = {}
	local fam: { [string]: number } = {}
	local seen: { [string]: boolean } = {}
	local used = 0
	for _, e in orderedPlaced(gh) do
		local p = FurnitureData.Get(e.inst.id)
		local key = e.spot.key
		if not p then
			status[key] = "ok" -- v4-only piece (no legacy effect yet)
		elseif seen[p.id] or p.looksOnly then
			status[key] = if p.looksOnly then "ok" else "invalid"
		else
			seen[p.id] = true
			local famKey: string? = nil
			for k in p.effect do famKey = k break end
			local okFit = true
			if p.points > 0 then
				if used + p.points > cap then okFit = false end
				if famKey and (fam[famKey] or 0) + p.points > FurnitureData.FamilyCap then okFit = false end
			end
			if okFit then
				for k, v in p.effect do
					if MULTIPLIER_KEYS[k] then out[k] = (out[k] or 1) * v else out[k] = (out[k] or 0) + v end
				end
				if p.points > 0 then
					used += p.points
					if famKey then fam[famKey] = (fam[famKey] or 0) + p.points end
				end
				status[key] = "ok"
			else
				status[key] = "capped"
			end
		end
	end
	legacyBonus, legacyStatus, legacyPoints = out, status, used
end

-- V4 totals (rows 92, 107, 108). Computed and exposed only (applied in steps 3 / 4).
-- Defaults: total cap is checked per PIECE in spot order (a piece that doesn't fit is capped whole);
-- the 40-per-kind cap is checked per LINE (the line that would pass 40 is skipped); every bed
-- counts, other pieces once per name; threshold lines: +2 total, +1 per kind, player and enemy
-- lines share kinds and the total.
local function recomputeV4(gh: number)
	local cap = V4.CapFor(gh)
	local player: { [string]: number } = {}
	local enemy: { [string]: number } = {}
	local thr: { [string]: number } = {}
	local kindPts: { [string]: number } = {}
	local status: { [string]: string } = {}
	local seen: { [string]: boolean } = {}
	local used, thrTotal = 0, 0
	for _, e in orderedPlaced(gh) do
		local inst, key = e.inst, e.spot.key
		local p = V4.Get(inst.id)
		if not p or inst.looks then
			status[key] = "ok"
		elseif seen[inst.id] and p.category ~= "Bed" then
			status[key] = "invalid"
		else
			seen[inst.id] = true
			local pts = 0
			if inst.fixed then
				local old = FurnitureData.Get(inst.id)
				pts = old and old.points or 0
			else
				for _, l in inst.lines do pts += l.points end
			end
			if used + pts > cap then
				status[key] = "capped"
			else
				used += pts
				status[key] = "ok"
				if inst.fixed then
					for k, v in p.fixed do player[k] = if MULTIPLIER_KEYS[k] or k == "collisionTaken" then (player[k] or 1) * v else (player[k] or 0) + v end
				else
					for _, l in inst.lines do
						if l.threshold then
							local tk = l.kind
							if thrTotal < V4.Threshold.TotalCap and (thr[tk] or 0) == 0 then
								thr[tk] = l.value
								thrTotal += 1
							end
						else
							local kk = (if l.enemy then "enemy:" else "") .. l.kind
							local kcap = if l.enemy then V4.Enemy.KindCap else V4.KindCap
							if (kindPts[kk] or 0) + l.points <= kcap then
								kindPts[kk] = (kindPts[kk] or 0) + l.points
								local bucket = if l.enemy then enemy else player
								bucket[l.kind] = (bucket[l.kind] or 0) + l.value
							end
						end
					end
				end
			end
		end
	end
	v4Totals = { player = player, enemy = enemy, threshold = thr, points = used, cap = cap, status = status }
end

local function recompute()
	local gh = ghLevel()
	recomputeLegacy(gh)
	recomputeV4(gh)
end

local function changed()
	recompute()
	if deps.markDirty then deps.markDirty() end
	if deps.rebuildAll then
		local ok, err = pcall(deps.rebuildAll)
		if not ok then warn("[FurnitureService] rebuild failed: " .. tostring(err)) end
	end
end

--------------------------------------------------
-- placement
--------------------------------------------------

local function nameOut(inst: Inst): boolean
	local p = V4.Get(inst.id)
	if p and p.category == "Bed" then return false end -- every bed counts (D5)
	for _, u in placement do
		local o = instances[u]
		if o and o.uid ~= inst.uid and o.id == inst.id then return true end
	end
	return false
end

--- First free spot that fits, or nil. preferWall: try wall spots first.
local function firstFreeSpot(inst: Inst, gh: number): Spot?
	local floor, wall = spotsFor(gh)
	for _, list in { floor, wall } do
		for _, s in list do
			if placement[s.key] == nil and fits(inst, s) then return s end
		end
	end
	return nil
end

local function placeFirstFree(inst: Inst): boolean
	if placedKey(inst.uid) then return true end
	if nameOut(inst) then return false end
	local s = firstFreeSpot(inst, ghLevel())
	if not s then return false end
	placement[s.key] = inst.uid
	return true
end

local function addInstance(inst: Inst)
	instances[inst.uid] = inst
end

local function firstInstanceOf(id: string, unplacedOnly: boolean): Inst?
	local best: Inst? = nil
	for _, inst in instances do
		if inst.id == id and (not unplacedOnly or placedKey(inst.uid) == nil) then
			if best == nil or inst.uid < best.uid then best = inst end
		end
	end
	return best
end

local function owns(id: string): boolean
	for _, inst in instances do if inst.id == id then return true end end
	return false
end

--------------------------------------------------
-- grants (Pedestal at Rank 32, Banner at Guild Hall 10)
--------------------------------------------------

local function grantFixed(id: string, why: string): boolean
	if owns(id) then return false end
	local inst = rollInstance(id, "grant", Random.new(hash(id .. tostring(convSeed))), "Common")
	if not inst then return false end
	addInstance(inst)
	placeFirstFree(inst)
	print(`[FurnitureService] {why}`)
	return true
end

local function ensureGrants(): (boolean, boolean)
	local any, pedestalNow = false, false
	if rank() >= PEDESTAL_RANK and grantFixed(PEDESTAL_ID, `Trophy Pedestal granted (Renown Rank {PEDESTAL_RANK})`) then
		any, pedestalNow = true, true
	end
	if ghLevel() >= 10 and grantFixed(BANNER_ID, "Guild Banner granted (Guild Hall L10)") then any = true end
	return any, pedestalNow
end

-- W-C: drop placements whose room/spot is not open at this Guild Hall level, whose category
-- doesn't fit, or that break the one-per-name rule (beds exempt). The piece goes to storage
-- (stays owned); nothing is deleted.
local function validatePlacement(): number
	local gh = ghLevel()
	local floor, wall = spotsFor(gh)
	local byKey: { [string]: Spot } = {}
	for _, s in floor do byKey[s.key] = s end
	for _, s in wall do byKey[s.key] = s end
	local keys = {}
	for k in placement do table.insert(keys, k) end
	table.sort(keys)
	local seenName: { [string]: boolean } = {}
	local moved = 0
	for _, k in keys do
		local inst = instances[placement[k]]
		local s = byKey[k]
		local p = inst and V4.Get(inst.id)
		local ok = inst ~= nil and s ~= nil and p ~= nil and fits(inst, s)
		if ok and p and p.category ~= "Bed" then
			if seenName[p.id] then ok = false else seenName[p.id] = true end
		end
		if not ok then
			placement[k] = nil
			moved += 1
			print(`[FurnitureService] Saved spot {k} invalid -> {inst and inst.id or "?"} to storage`)
		end
	end
	return moved
end

local function runPendingPlacement()
	local list = pendingPlace
	if not list then return end
	pendingPlace = nil
	for _, uid in list do
		local inst = instances[uid]
		if inst and not placeFirstFree(inst) then
			print(`[FurnitureService] Conversion: {inst.id} {inst.rarity} -> storage (no fitting spot)`)
		end
	end
end

function FurnitureService.Init(d: Deps)
	deps = d
	local placedNow = pendingPlace ~= nil
	local moved = validatePlacement() -- W-C: saved spots checked against the real Guild Hall level
	if moved > 0 then placedNow = true end
	runPendingPlacement() -- old-save conversion places once the real Guild Hall level is known
	local granted = ensureGrants()
	if (placedNow or granted) and deps.markDirty then pcall(deps.markDirty) end
	recompute()
	if next(legacyBonus) ~= nil and deps.rebuildAll then
		local ok, err = pcall(deps.rebuildAll)
		if not ok then warn("[FurnitureService] rebuild at Init failed: " .. tostring(err)) end
	end
	local n = 0
	for _ in instances do n += 1 end
	print(`[FurnitureService] Initialized | Guild Hall L{ghLevel()} | pieces {n} | bonus points {legacyPoints}/{FurnitureData.CapFor(ghLevel())} | v4 points {v4Totals.points}/{v4Totals.cap}`)
end

--------------------------------------------------
-- READ
--------------------------------------------------

--- Legacy furniture bonus for a unit (unchanged until step 3).
function FurnitureService.BonusFor(unit: any): { [string]: number }?
	if type(unit) ~= "table" or unit.side == "Enemy" then return nil end
	if not (deps.isPlayerUnit and deps.isPlayerUnit(unit)) then return nil end
	if next(legacyBonus) == nil then return nil end
	return legacyBonus
end

function FurnitureService.DispatchFeeDelta(): number
	return math.floor(legacyBonus.dispatchFee or 0)
end

--- V4 totals (computed only; steps 3 / 4 apply them).
function FurnitureService.V4Totals(): any
	return v4Totals
end

local function shopRows(): { any }
	local gh, r = ghLevel(), rank()
	local gold = deps.getGold and deps.getGold() or 0
	local rows = {}
	for _, p in FurnitureData.Pieces do
		if p.source == "Shop" and not p.notInShop and not owns(p.id) then
			local reason: string? = nil
			if p.needRank and r < p.needRank then
				reason = `Unlocks at Renown Rank {p.needRank}`
			elseif p.needGuildHall and gh < p.needGuildHall then
				reason = `Also needs Guild Hall level {p.needGuildHall}`
			elseif gold < (p.price or 0) then
				reason = `Not enough gold ({gold} / {p.price})`
			end
			table.insert(rows, { id = p.id, price = p.price, canBuy = reason == nil, reason = reason })
		end
	end
	return rows
end

local function instView(inst: Inst): any
	local lines = {}
	for _, l in inst.lines do
		table.insert(lines, { kind = l.kind, value = l.value, points = l.points, enemy = l.enemy, threshold = l.threshold, signature = l.signature })
	end
	return { uid = inst.uid, id = inst.id, rarity = inst.rarity, lines = lines, fixed = inst.fixed, looks = inst.looks, spot = placedKey(inst.uid) }
end

function FurnitureService.State(): any
	if ensureGrants() then changed() end
	local gh = ghLevel()
	local floor, wall = spotsFor(gh)
	local s, st, dc = {}, {}, {}
	for i, sp in floor do
		local u = placement[sp.key]
		s[i] = (u and instances[u] and instances[u].id) or false
		st[i] = legacyStatus[sp.key] or ""
	end
	for i, sp in wall do
		local u = placement[sp.key]
		dc[i] = (u and instances[u] and instances[u].id) or false
	end
	local ownedSet: { [string]: boolean } = {}
	local insts = {}
	for _, inst in instances do
		ownedSet[inst.id] = true
		table.insert(insts, instView(inst))
	end
	table.sort(insts, function(a, b) return a.uid < b.uid end)
	local ownedList = {}
	for id in ownedSet do table.insert(ownedList, id) end
	table.sort(ownedList)
	local spots = {}
	for _, list in { floor, wall } do
		for _, sp in list do
			local u = placement[sp.key]
			table.insert(spots, { key = sp.key, room = sp.room, roomName = sp.roomName, wall = sp.wall, accepts = sp.accepts,
				uid = u, status = v4Totals.status[sp.key] })
		end
	end
	return {
		-- old fields (UI until step 5)
		guildHallLevel = gh, slots = s, slotStatus = st, decor = dc,
		points = legacyPoints, cap = FurnitureData.CapFor(gh),
		owned = ownedList, shop = shopRows(),
		locked = not (deps.canChangeNow and deps.canChangeNow()),
		notice = noticePending,
		-- v4 (step 2): rooms / spots / instances / totals (not applied yet)
		v4 = { spots = spots, instances = insts, totals = v4Totals },
	}
end

--------------------------------------------------
-- ACTIONS (SEC-001: the client sends ids / slot numbers only; the server checks + prices)
--------------------------------------------------

local function validSlot(n: any): number?
	if type(n) ~= "number" or n ~= n or n % 1 ~= 0 or n < 1 or n > 64 then return nil end
	return n
end

local function rngFor(tag: string): Random
	return Random.new(hash(tag .. ":" .. tostring(nextUid) .. ":" .. tostring(os.clock())))
end

function FurnitureService.Buy(id: any): (boolean, string?)
	local p = FurnitureData.Get(id)
	if not p or p.source ~= "Shop" or p.notInShop or not p.price then return false, "Unknown piece" end
	if owns(p.id) then return false, "Already owned" end -- step 2: legacy shop (each piece once); daily offers = step 5
	if not (deps.canBuyNow and deps.canBuyNow()) then return false, TXT_LOCKED_RUN end
	if p.needRank and rank() < p.needRank then return false, `Unlocks at Renown Rank {p.needRank}` end
	if p.needGuildHall and ghLevel() < p.needGuildHall then return false, `Also needs Guild Hall level {p.needGuildHall}` end
	local gold = deps.getGold and deps.getGold() or 0
	if gold < p.price then return false, `Not enough gold ({gold} / {p.price})` end
	if not deps.spendGold then return false, "Gold unavailable" end
	local okPay, why = deps.spendGold(p.price)
	if not okPay then return false, tostring(why or "Not enough gold") end
	local inst = rollInstance(p.id, "shop", rngFor("buy" .. p.id))
	if not inst then return false, "Unknown piece" end
	addInstance(inst)
	if deps.canChangeNow and deps.canChangeNow() then placeFirstFree(inst) end
	print(`[FurnitureService] Bought {p.id} {p.name} ({inst.rarity}) for {p.price} gold`)
	changed()
	return true, nil
end

--- Put a piece into a spot. id = instance uid or piece id (first unplaced copy). slot = index in
--- the floor list (isDecor false) or wall list (isDecor true). If the spot doesn't fit the piece,
--- the first free fitting spot is used instead (keeps the step-1 UI working).
function FurnitureService.Place(id: any, slot: any, isDecor: any): (boolean, string?)
	if not (deps.canChangeNow and deps.canChangeNow()) then return false, TXT_LOCKED_RUN end
	if type(id) ~= "string" then return false, "Unknown piece" end
	local inst = instances[id] or firstInstanceOf(id, true) or firstInstanceOf(id, false)
	if not inst then return false, "Unknown piece" end
	local n = validSlot(slot)
	if not n then return false, "Unknown slot" end
	local floor, wall = spotsFor(ghLevel())
	local list = if isDecor == true then wall else floor
	local target: Spot? = list[n]
	if target == nil or not fits(inst, target) then
		if placedKey(inst.uid) then return true, nil end -- already out and the asked spot doesn't fit: keep it
		target = nil
		for _, l2 in { floor, wall } do
			for _, s in l2 do
				if placement[s.key] == nil and fits(inst, s) then target = s break end
			end
			if target then break end
		end
	end
	if not target then return false, "Unknown slot" end
	local cur = placedKey(inst.uid)
	if cur == target.key then return true, nil end
	if nameOut(inst) and not cur then return false, TXT_DUP end
	if cur then placement[cur] = nil end
	placement[target.key] = inst.uid -- replaces what was there (that piece goes to storage)
	changed()
	return true, nil
end

function FurnitureService.Remove(slot: any, isDecor: any): (boolean, string?)
	if not (deps.canChangeNow and deps.canChangeNow()) then return false, TXT_LOCKED_RUN end
	local floor, wall = spotsFor(ghLevel())
	local key: string? = nil
	if type(slot) == "string" then
		key = slot
	else
		local n = validSlot(slot)
		if not n then return false, "Unknown slot" end
		local sp = (if isDecor == true then wall else floor)[n]
		key = sp and sp.key or nil
	end
	if not key then return false, "Unknown slot" end
	placement[key] = nil
	changed()
	return true, nil
end

--------------------------------------------------
-- STEP 3 flows (crafting, drops, rank rewards) now create rolled instances
--------------------------------------------------

local function matName(k: string, n: number): string
	if k == "mercury" then return "Mercury" end
	if k == "crystals" then return if n == 1 then "Crystal" else "Crystals" end
	return k
end

function FurnitureService.Owns(id: any): boolean
	return type(id) == "string" and owns(id)
end

--- A dropped piece (dungeon payout / quest boss). Step 2 keeps "each piece once" (unowned-only
--- drops change in step 5). Rolled with dungeon or boss weights.
function FurnitureService.GrantDrop(id: any, why: string?): boolean
	local p = FurnitureData.Get(id)
	if not p or owns(p.id) then return false end
	local src = if p.source == "BossDrop" then "boss" else "dungeon"
	local inst = rollInstance(p.id, src, rngFor("drop" .. p.id))
	if not inst then return false end
	addInstance(inst)
	if not inst.looks and deps.canChangeNow and deps.canChangeNow() then placeFirstFree(inst) end
	print(`[FurnitureService] Drop granted | {p.id} {p.name} ({inst.rarity}) | {tostring(why)}`)
	changed()
	return true
end

function FurnitureService.RollBossPiece(chance: number): string?
	if type(chance) ~= "number" or math.random() >= chance then return nil end
	local pool: { string } = {}
	for _, p in FurnitureData.Pieces do
		if p.source == "BossDrop" and not owns(p.id) then table.insert(pool, p.id) end
	end
	if #pool == 0 then return nil end
	local id = pool[math.random(1, #pool)]
	if not FurnitureService.GrantDrop(id, "quest boss") then return nil end
	local p = FurnitureData.Get(id)
	return p and p.name or id
end

function FurnitureService.GrantRankRewards(): boolean
	local any, pedestalNow = ensureGrants()
	if any then changed() end
	return pedestalNow
end

local function craftReason(p: FurnitureData.Piece): string?
	if owns(p.id) then return "Already owned" end
	if not (deps.canChangeNow and deps.canChangeNow()) then return TXT_LOCKED_RUN end
	local gold = deps.getGold and deps.getGold() or 0
	if gold < (p.price or 0) then return `Not enough gold ({gold} / {p.price})` end
	local have = deps.getMaterials and deps.getMaterials() or {}
	for k, need in (p.mats or {}) do
		local h = tonumber(have[k]) or 0
		if h < need then return `Not enough {matName(k, need)} ({h} / {need})` end
	end
	return nil
end

function FurnitureService.CraftRows(building: any): { any }
	local rows = {}
	if type(building) ~= "string" then return rows end
	for _, p in FurnitureData.Pieces do
		if p.source == "Crafted" and p.craftAt == building then
			local mk, mn = next(p.mats or {})
			local reason = craftReason(p)
			table.insert(rows, { id = p.id, name = p.name, text = p.text, price = p.price,
				matName = if mk then matName(mk, mn :: number) else nil, matN = mn,
				owned = owns(p.id), canCraft = reason == nil, reason = reason })
		end
	end
	return rows
end

function FurnitureService.Craft(id: any, building: any): (boolean, string?)
	local p = FurnitureData.Get(id)
	if not p or p.source ~= "Crafted" or type(building) ~= "string" or p.craftAt ~= building then return false, "Unknown piece" end
	if not (deps.isBuildingOpen and deps.isBuildingOpen(building)) then return false, "Unknown piece" end
	if not (deps.canChangeNow and deps.canChangeNow()) then return false, TXT_LOCKED_RUN end
	local why = craftReason(p)
	if why then return false, why end
	if not deps.spendCost then return false, "Gold unavailable" end
	local cost: { [string]: number } = { gold = p.price or 0 }
	for k, v in (p.mats or {}) do cost[k] = v end
	local okPay, err = deps.spendCost(cost)
	if not okPay then return false, tostring(err or "Not enough gold") end
	local inst = rollInstance(p.id, "craft", rngFor("craft" .. p.id))
	if not inst then return false, "Unknown piece" end
	addInstance(inst)
	placeFirstFree(inst)
	print(`[FurnitureService] Crafted {p.id} {p.name} ({inst.rarity}) at {building} | {p.price} gold`)
	changed()
	return true, `{p.name} crafted! It's in your Guild Hall.`
end

function FurnitureService.ClearNotice()
	if noticePending then
		noticePending = false
		if deps.markDirty then deps.markDirty() end
	end
end

function FurnitureService.OnGuildHallChanged()
	ensureGrants()
	changed()
end

--------------------------------------------------
-- SAVE (format v2) + old-save conversion
--------------------------------------------------

function FurnitureService.Export(): any
	local list = {}
	for _, inst in instances do
		local lines = {}
		for _, l in inst.lines do
			table.insert(lines, { k = l.kind, v = l.value, p = l.points, e = l.enemy, t = l.threshold, s = l.signature })
		end
		table.insert(list, { u = inst.uid, id = inst.id, r = inst.rarity, l = lines, f = inst.fixed, lo = inst.looks, src = inst.src })
	end
	table.sort(list, function(a, b) return a.u < b.u end)
	local place = {}
	for k, u in placement do place[k] = u end
	return { v = SAVE_VERSION, instances = list, place = place, nextUid = nextUid, notice = noticePending,
		convSeed = convSeed, shop = {} }
end

local function validKind(k: any): boolean
	if type(k) ~= "string" or #k > 32 then return false end
	if V4.PointPrice[k] or V4.Enemy.PointPrice[k] then return true end
	if table.find(V4.Threshold.Kinds, k) or k == "range" then return true end
	return false
end

-- W-C: one saved line checked against its piece/rarity (row 101/107/108). Returns a clean Line or nil.
local function cleanLine(l: any, p: any, rar: string): Line?
	if type(l) ~= "table" or not validKind(l.k) or type(l.v) ~= "number" or l.v ~= l.v then return nil end
	local enemy = l.e == true
	if l.s == true then
		local sv = p.signature and p.signature[l.k]
		if type(sv) ~= "number" or enemy then return nil end
		local old = FurnitureData.Get(p.id)
		return { kind = l.k, value = sv, points = if old then old.points else (sv * (V4.PointPrice[l.k] or 0)), signature = true }
	end
	local r = V4.Rarities[rar]
	if not r then return nil end
	if l.t == true then
		if (r.threshold or 0) <= 0 then return nil end
		local pool = if enemy then V4.Enemy.Threshold[p.type] else V4.Types[p.type].threshold
		local ok = pool ~= nil and table.find(pool, l.k) ~= nil
		if not ok and not enemy and l.k == V4.Types[p.type].thresholdIfRangeOn and V4.Threshold.RangeEnabled then ok = true end
		if l.k == "range" and not V4.Threshold.RangeEnabled then ok = false end
		if not ok then return nil end
		return { kind = l.k, value = if enemy then -1 else 1, points = 0, threshold = true, enemy = if enemy then true else nil }
	end
	local price = if enemy then V4.Enemy.PointPrice[l.k] else V4.PointPrice[l.k]
	if type(price) ~= "number" or price <= 0 or l.v <= 0 then return nil end
	local value = l.v
	local cap = if enemy then V4.Enemy.Max[l.k] else V4.SecondaryMax[l.k]
	if type(cap) == "number" then value = math.min(value, cap) end
	value = math.min(value, r.pts[2] / price) -- clamp into the rarity's point range (top)
	if isStepKind(l.k) then value = math.floor(value / STEP + 1e-6) * STEP else value = math.floor(value + 1e-6) end
	if value <= 0 then return nil end
	return { kind = l.k, value = value, points = value * price, enemy = if enemy then true else nil }
end

local function importV2(data: any)
	for _, e in (type(data.instances) == "table" and data.instances or {}) do
		local n = 0
		for _ in instances do n += 1 end
		if n >= MAX_INSTANCES then break end
		local p = if type(e) == "table" then V4.Get(e.id) else nil
		if p and type(e.u) == "string" and #e.u <= 16 and not instances[e.u] then
			local rar: string
			local lines: { Line } = {}
			if p.looksOnly then
				rar = "None"
			elseif p.fixed then
				rar = "Fixed"
			else
				rar = if type(e.r) == "string" and V4.Rarities[e.r] then e.r else "Common"
				local r = V4.Rarities[rar]
				local nRolled, nThr, nSig = 0, 0, 0
				local maxSig = 0
				if p.signature then for _ in p.signature do maxSig += 1 end end
				for _, raw in (type(e.l) == "table" and e.l or {}) do
					local l = cleanLine(raw, p, rar)
					if l then
						if l.signature then
							if nSig < maxSig then nSig += 1 table.insert(lines, l) end
						elseif l.threshold then
							if nThr < (r.threshold or 0) then nThr += 1 table.insert(lines, l) end
						elseif nRolled < r.lines then
							nRolled += 1
							table.insert(lines, l)
						end
					end
				end
			end
			instances[e.u] = { uid = e.u, id = e.id, rarity = rar, lines = lines,
				fixed = if p.fixed then true else nil, looks = if p.looksOnly then true else nil,
				src = if type(e.src) == "string" and #e.src <= 16 then e.src else nil }
		end
	end
	local used: { [string]: boolean } = {}
	for k, u in (type(data.place) == "table" and data.place or {}) do
		if type(k) == "string" and #k <= 40 and string.find(k, "^%a+/[fw]%d+$") and type(u) == "string"
			and instances[u] and not used[u] then
			placement[k] = u
			used[u] = true
		end
	end
	nextUid = math.max(1, math.floor(tonumber(data.nextUid) or 1))
	for u in instances do
		local num = tonumber(string.match(u, "^f(%d+)$"))
		if num and num >= nextUid then nextUid = num + 1 end
	end
	noticePending = data.notice == true
	convSeed = math.floor(tonumber(data.convSeed) or 0)
end

-- Old v1 save -> v2 (row 97 / V4.Migration): every owned piece -> one instance of the same type,
-- rolled once with a fixed seed per save (never re-rolls). Shop-bought -> Common; crafted /
-- dropped / boss / welcome gift -> Uncommon. Fixed and looks-only pieces stay as they are.
-- Placement happens at Init (needs the real Guild Hall level): old slots first, then decor,
-- each into the first free spot that fits; everything else to storage. Nothing is lost.
local function convertV1(data: any)
	local ids: { string } = {}
	local seenId: { [string]: boolean } = {}
	for _, id in (type(data.owned) == "table" and data.owned or {}) do
		if type(id) == "string" and V4.Get(id) and not seenId[id] then table.insert(ids, id) seenId[id] = true end
	end
	table.sort(ids)
	convSeed = hash("conv:" .. table.concat(ids, ","))
	local rng = Random.new(convSeed)
	local byId: { [string]: string } = {}
	for _, id in ids do
		local p = V4.Get(id)
		local rar: string = V4.Migration.ShopBought
		if p.source ~= "Shop" or table.find(WELCOME_GIFT, id) then rar = V4.Migration.CraftedDroppedBossGift end
		local inst = rollInstance(id, SOURCE_KEY[p.source] or "shop", rng, rar)
		if inst then
			addInstance(inst)
			byId[id] = inst.uid
		end
	end
	local order: { string } = {}
	local queued: { [string]: boolean } = {}
	for _, list in { data.slots, data.decor } do
		for _, id in (type(list) == "table" and list or {}) do
			local u = type(id) == "string" and byId[id] or nil
			if u and not queued[u] then table.insert(order, u) queued[u] = true end
		end
	end
	pendingPlace = order
	noticePending = data.notice == true
	print(`[FurnitureService] Old save converted to v2: {#ids} piece(s), {#order} to place at Init`)
end

function FurnitureService.Import(data: any, saveExisted: boolean?)
	instances, placement, nextUid, noticePending, convSeed, pendingPlace = {}, {}, 1, false, 0, nil
	if type(data) == "table" and data.v == SAVE_VERSION then
		importV2(data)
	elseif type(data) == "table" then
		convertV1(data)
	elseif saveExisted then
		convSeed = hash("gift")
		local rng = Random.new(convSeed)
		local order = {}
		for _, id in WELCOME_GIFT do
			local inst = rollInstance(id, "shop", rng, V4.Migration.CraftedDroppedBossGift)
			if inst then addInstance(inst) table.insert(order, inst.uid) end
		end
		pendingPlace = order
		noticePending = true
		print("[FurnitureService] Old save: welcome gift Straw Cot + Scribe's Desk (Uncommon), notice pending")
	end
	recompute()
end

-- Dev only (Main DevDungeon op "furn", memory-mode saves only).
function FurnitureService.DevSetOwned(id: any, own: boolean): boolean
	if type(id) ~= "string" or not V4.Get(id) then return false end
	if own then
		local inst = rollInstance(id, "dungeon", rngFor("dev" .. id))
		if not inst then return false end
		addInstance(inst)
		placeFirstFree(inst)
	else
		for u, inst in instances do
			if inst.id == id then
				local k = placedKey(u)
				if k then placement[k] = nil end
				instances[u] = nil
			end
		end
	end
	changed()
	return true
end

return FurnitureService

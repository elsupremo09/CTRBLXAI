--!strict
-- FurnitureRoll.lua
-- CTRBLXAI | Furniture v4 roller, split out of FurnitureService.lua (furniture v5 build step A,
-- 2026-11-16). Code moved word-for-word; no behaviour change. Rules: guild_facilities 101-104, 107, 108.
-- OWNS: nothing (pure functions). The caller passes the uid generator and the Guild Hall level.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local FurnitureData = require(ReplicatedStorage:WaitForChild("Content"):WaitForChild("FurnitureData"))
local V4: any = FurnitureData.V4

local FurnitureRoll = {}

local STEP = 0.5           -- value step for percent / percentage-point kinds

type Line = { kind: string, value: number, points: number, enemy: boolean?, threshold: boolean?, signature: boolean? }
type Inst = { uid: string, id: string, rarity: string, lines: { Line }, fixed: boolean?, looks: boolean?, src: string?, welcome: boolean? }

local function hash(s: string): number
	local h = 7
	for i = 1, #s do h = (h * 31 + string.byte(s, i)) % 2147483647 end
	return h
end

local FLAT_KINDS: { [string]: boolean } = {
	STR = true, AGI = true, DEX = true, INT = true, VIT = true, LUK = true,
	maxHp = true, maxMp = true, attack = true, defense = true, hpLoss = true, mpLoss = true,
}
local function isStepKind(kind: string): boolean
	return not FLAT_KINDS[kind]
end

--------------------------------------------------
-- ROLLER (V4 rows 101-104, 107, 108). Fortune never applies (row 101 / D: FortuneAffectsRarity=false).
--------------------------------------------------

local SOURCE_KEY = { Shop = "shop", Crafted = "craft", DungeonDrop = "dungeon", BossDrop = "boss" }

local function highestOpenAtOrBelow(rar: string, gh: number): string
	local order = V4.RarityOrder
	local idx = table.find(order, rar) or 1
	for i = idx, 1, -1 do
		if V4.RarityOpen(order[i], gh) then return order[i] end
	end
	return "Common"
end

local function rollRarity(rng: Random, src: string, gh: number, stepBonus: number?): string
	local total = 0
	for _, name in V4.RarityOrder do total += (V4.Rarities[name].weights[src] or 0) end
	local pick = "Common"
	if total > 0 then
		local x = rng:NextNumber() * total
		for _, name in V4.RarityOrder do
			local w = V4.Rarities[name].weights[src] or 0
			if w > 0 then
				if x < w then pick = name break end
				x -= w
			end
		end
	end
	if stepBonus and stepBonus > 0 then
		local idx = math.min((table.find(V4.RarityOrder, pick) or 1) + stepBonus, #V4.RarityOrder)
		pick = V4.RarityOrder[idx]
	end
	-- row 104: a locked rarity rolls the highest open one instead.
	return highestOpenAtOrBelow(pick, gh)
end

local function pick(rng: Random, list: { string }?): string?
	if not list or #list == 0 then return nil end
	return list[rng:NextInteger(1, #list)]
end

local function makeLine(rng: Random, kind: string, ptsRange: { number }, enemy: boolean): Line?
	local price = if enemy then V4.Enemy.PointPrice[kind] else V4.PointPrice[kind]
	if type(price) ~= "number" or price <= 0 then return nil end
	local pts = rng:NextInteger(ptsRange[1], ptsRange[2])
	local raw = pts / price
	local value: number
	if isStepKind(kind) then
		value = math.max(STEP, math.floor(raw / STEP) * STEP)
	else
		value = math.max(1, math.floor(raw))
	end
	local cap = if enemy then V4.Enemy.Max[kind] else V4.SecondaryMax[kind]
	if type(cap) == "number" then value = math.min(value, cap) end
	return { kind = kind, value = value, points = value * price, enemy = if enemy then true else nil }
end

local function thresholdPool(typeName: string, enemy: boolean): { string }
	-- W-B: enemy threshold kinds come ONLY from row 108 (V4.Enemy.Threshold); never the player list.
	local src = if enemy then V4.Enemy.Threshold[typeName] else V4.Types[typeName].threshold
	local out = {}
	for _, k in src or {} do
		if k ~= "range" or V4.Threshold.RangeEnabled then table.insert(out, k) end
	end
	local t = V4.Types[typeName]
	if V4.Threshold.RangeEnabled and t.thresholdIfRangeOn then table.insert(out, t.thresholdIfRangeOn) end
	return out
end

--- Roll one new instance of a piece. forcedRarity (old-save conversion / dev) skips the rarity roll.
local function rollInstance(id: string, src: string, rng: Random, forcedRarity: string?, newUid: () -> string, ghLevel: () -> number): Inst?
	local p = V4.Get(id)
	if not p then return nil end
	local inst: Inst = { uid = newUid(), id = id, rarity = "None", lines = {}, src = src }
	if p.looksOnly then inst.looks = true return inst end
	if p.fixed then inst.fixed = true inst.rarity = "Fixed" return inst end
	local gh = ghLevel()
	local rar = forcedRarity or rollRarity(rng, src, gh, p.rarityStepBonus)
	inst.rarity = rar
	local r = V4.Rarities[rar]
	local T = V4.Types[p.type]
	if not (r and T) then return inst end
	-- signature line (always present; old block-1 point price toward the cap)
	if p.signature then
		for k, v in p.signature do
			local old = FurnitureData.Get(id)
			table.insert(inst.lines, { kind = k, value = v, points = if old then old.points else (v * (V4.PointPrice[k] or 0)), signature = true })
		end
	end
	for _ = 1, r.lines do
		local enemy = rng:NextNumber() < V4.Enemy.LineChance
		local secondary = r.secondaryShare > 0 and rng:NextNumber() < r.secondaryShare
		local kind: string?
		if enemy then
			kind = if secondary then pick(rng, V4.Enemy.Secondary[p.type]) else pick(rng, V4.Enemy.Basic[p.type])
			if secondary and V4.Enemy.SecondarySignature[p.type] and rng:NextNumber() < V4.SignatureShare then
				kind = V4.Enemy.SecondarySignature[p.type]
			end
		else
			if secondary and T.signature and rng:NextNumber() < V4.SignatureShare then
				kind = T.signature
			else
				kind = if secondary then pick(rng, T.secondary) else pick(rng, T.basic)
			end
		end
		local line = kind and makeLine(rng, kind, r.pts, enemy) or nil
		if line then table.insert(inst.lines, line) end
	end
	for _ = 1, (r.threshold or 0) do
		local enemy = rng:NextNumber() < V4.Enemy.LineChance
		local pool = thresholdPool(p.type, enemy)
		if enemy and #pool == 0 then -- W-B: type has no enemy threshold kind -> player threshold line
			enemy = false
			pool = thresholdPool(p.type, false)
		end
		local kind = pick(rng, pool)
		if kind then
			table.insert(inst.lines, { kind = kind, value = if enemy then -1 else 1, points = 0, threshold = true, enemy = if enemy then true else nil })
		end
	end
	return inst
end

FurnitureRoll.STEP = STEP
FurnitureRoll.SOURCE_KEY = SOURCE_KEY
FurnitureRoll.Hash = hash
FurnitureRoll.IsStepKind = isStepKind
FurnitureRoll.RollRarity = rollRarity
FurnitureRoll.RollInstance = rollInstance

return FurnitureRoll

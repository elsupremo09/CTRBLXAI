--!strict
-- DungeonFurniture.lua
-- CTRBLXAI | Guild Hall furniture found in the Dungeon (furniture step 3, USER RULING 2026-11-16 3:40 PM;
-- PROPOSAL_furniture_step3_20261116 P2/P3, guild_facilities 94/95, project_rules 122/264/272).
--
--   * Room drops (P2): FUR-05 Padded Wall, FUR-08 Star Chart, FUR-14 Iron Training Weights,
--     FUR-15 Dodge Course, FUR-17 Clover Planter. Chance per room = the facility level's relic rate R
--     (DungeonRules.Level(lv).relicRatePct, 6% at L1 ... 15% at L10) x room factor: Treasure 1,
--     Elite 0.5, good Event 0.25. Normal battles: none. One roll per room per stage (saved, no re-roll
--     on rejoin). Not changed by the growing drop multiplier or Fortune (same as Prospector's chest).
--   * Dungeon boss drops (P3): FUR-09 Tome Stack, FUR-18 Gilded Chest, 10% on a rewarded boss win
--     (Main calls BossDrop inside the 3-a-day boss reward branch; quest bosses 25% are granted by Main).
--   * Only pieces the player doesn't own yet and hasn't found / sent this run can roll.
--   * A found piece is LOOT with NO Bag slot: comes home on a full-loot exit (Boss / Rest leave), lost on
--     wipeout or early escape (rule 264). Courier's Rest sends it home free with any send (default).
-- Pure on the run table (run.dgFurn, saved by DungeonSave). No require of DungeonService (no cycle).
-- Ownership is asked through SetHooks (Main wires FurnitureService); nil-safe (ARC-006).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local FurnitureData = require(ReplicatedStorage:WaitForChild("Content"):WaitForChild("FurnitureData"))
local DungeonRules = require(script.Parent:WaitForChild("DungeonRules"))

local F = {}

-- Room factor on the relic rate R (P2, approved 3:40 PM).
local ROOM_FACTOR: { [string]: number } = table.freeze({ T = 1, E = 0.5, V = 0.25 })

local hooks: { isOwned: ((string) -> boolean)? } = {}
function F.SetHooks(h: any) hooks = if type(h) == "table" then h else {} end

local function ensure(run: any): any
	local st = run.dgFurn
	if type(st) ~= "table" then
		st = { found = {}, sent = {}, rolled = {}, popup = nil }
		run.dgFurn = st
	end
	return st
end

local function stageKey(run: any, roomId: string): string
	return tostring(run.stage or 1) .. ":" .. roomId
end

local function seedOf(run: any, roomId: string, source: string): number
	local h = 0
	for i = 1, #roomId do h = (h * 31 + string.byte(roomId, i)) % 1000003 end
	return ((run.sseed or run.card.seed or 1) * 23 + h * 131 + string.byte(source, 1) * 11 + (run.stage or 1) * 977 + 907) % 2147483647
end

local function owned(id: string): boolean
	local fn = hooks.isOwned
	if not fn then return false end
	local ok, v = pcall(fn, id)
	return ok and v == true
end

--- Pieces of `source` ("DungeonDrop" | "BossDrop") the player can still get this run.
local function candidates(run: any, source: string): { string }
	local st = ensure(run)
	local out: { string } = {}
	for _, p in FurnitureData.Pieces do
		if p.source == source and not owned(p.id) and not table.find(st.found, p.id) and not table.find(st.sent, p.id) then
			table.insert(out, p.id)
		end
	end
	return out
end

local function addFound(run: any, id: string)
	local st = ensure(run)
	table.insert(st.found, id)
	st.popup = id
	local p = FurnitureData.Get(id)
	print(`[DungeonFurniture] Furniture found | {id} {p and p.name or "?"} | {#st.found} this run`)
end

--- Roll (once per room per stage) a room drop. source = "T" Treasure | "E" Elite | "V" good Event.
function F.Roll(run: any, roomId: any, source: string): string?
	if type(run) ~= "table" or type(roomId) ~= "string" then return nil end
	local f = ROOM_FACTOR[source]
	if not f then return nil end
	local st = ensure(run)
	local key = stageKey(run, roomId)
	if st.rolled[key] then return nil end
	st.rolled[key] = true
	local lv = DungeonRules.Level(run.card.facilityLevel)
	local chance = (tonumber(lv and lv.relicRatePct) or 0) / 100 * f
	local rng = Random.new(seedOf(run, roomId, source))
	if rng:NextNumber() >= chance then return nil end
	local pool = candidates(run, "DungeonDrop")
	if #pool == 0 then return nil end
	local id = pool[rng:NextInteger(1, #pool)]
	addFound(run, id)
	return id
end

--- Dungeon boss drop (P3): chance (0-1) on a rewarded boss win. Follows the room-drop loot rule.
function F.BossDrop(run: any, chance: number): string?
	if type(run) ~= "table" or type(chance) ~= "number" then return nil end
	if math.random() >= chance then return nil end
	local pool = candidates(run, "BossDrop")
	if #pool == 0 then return nil end
	local id = pool[math.random(1, #pool)]
	addFound(run, id)
	return id
end

--- Courier's Rest (default): every found piece goes home with any send, free, no slot.
function F.SendAll(run: any): number
	local st = run and run.dgFurn
	if type(st) ~= "table" or #st.found == 0 then return 0 end
	local n = #st.found
	for _, id in st.found do table.insert(st.sent, id) end
	st.found = {}
	print(`[DungeonFurniture] Sent home with the Courier | {n} piece(s)`)
	return n
end

--- Run end: sent pieces always come home; found pieces only on a full-loot exit (rule 264).
function F.OnRunEnd(run: any, outcome: any, kind: string)
	local st = run and run.dgFurn
	if type(st) ~= "table" or type(outcome) ~= "table" or type(outcome.kept) ~= "table" then return end
	local keep = kind == "Boss" or kind == "EscapeNode"
	local kept, lost = {}, {}
	for _, id in st.sent do table.insert(kept, id) end
	for _, id in st.found do table.insert(if keep then kept else lost, id) end
	outcome.kept.furniture = kept
	if type(outcome.lost) == "table" then outcome.lost.furniture = lost end
	if #kept + #lost > 0 then
		print(`[DungeonFurniture] Run end ({kind}) | furniture home {#kept} | lost {#lost}`)
	end
	run.dgFurn = nil
end

--- Screen view: { found = { { id, name } }, popup = name? } (nil when nothing found this run).
function F.View(run: any): any
	local st = run and run.dgFurn
	if type(st) ~= "table" then return nil end
	local found = {}
	for _, id in st.found do
		local p = FurnitureData.Get(id)
		table.insert(found, { id = id, name = p and p.name or id })
	end
	local pp = st.popup and FurnitureData.Get(st.popup)
	if #found == 0 and not pp then return nil end
	return { found = found, popup = pp and pp.name or nil }
end

--- The client showed "Furniture found: {Piece}!": forget the popup.
function F.Ack(run: any)
	local st = run and run.dgFurn
	if type(st) == "table" then st.popup = nil end
end

--------------------------------------------------
-- SAVE (DungeonSave)
--------------------------------------------------

function F.Export(run: any): any
	local st = run and run.dgFurn
	if type(st) ~= "table" then return nil end
	local rolled = {}
	for k in st.rolled do table.insert(rolled, k) end
	table.sort(rolled)
	return { found = table.clone(st.found), sent = table.clone(st.sent), rolled = rolled, popup = st.popup }
end

local function idList(t: any): { string }
	local out: { string } = {}
	if type(t) ~= "table" then return out end
	for _, id in t do
		if #out >= 32 then break end
		local p = FurnitureData.Get(id)
		if p and (p.source == "DungeonDrop" or p.source == "BossDrop") and not table.find(out, id) then table.insert(out, id) end
	end
	return out
end

function F.Import(run: any, d: any)
	run.dgFurn = nil
	if type(d) ~= "table" then return end -- old saves: nothing found
	local st = { found = idList(d.found), sent = idList(d.sent), rolled = {}, popup = nil }
	for _, k in (if type(d.rolled) == "table" then d.rolled else {}) do
		if type(k) == "string" and #k <= 32 then st.rolled[k] = true end
	end
	if type(d.popup) == "string" and FurnitureData.Get(d.popup) then st.popup = d.popup end
	run.dgFurn = st
end

-- Dev only (Main DevDungeon op "furnDrop", DevAccess-gated, memory-mode only): force a found piece.
function F.DevFound(run: any, id: any): boolean
	if type(run) ~= "table" or not FurnitureData.Get(id) then return false end
	addFound(run, id)
	return true
end

return table.freeze(F)

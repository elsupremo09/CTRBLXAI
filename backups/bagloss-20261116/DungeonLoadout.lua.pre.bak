--!strict
-- DungeonLoadout.lua
-- CTRBLXAI | Loadout management inside a dungeon run (silver/Bag redesign step 3, 2026-11-16;
-- project_rules 265 locked loadouts, 266 map consumables, 267 bring-ins, 268 bought items, 279 Bag).
--
-- The normal Loadout screen is reused in "dungeon mode". Every request from that screen still goes to the
-- normal loadout remotes (LoadoutRequestHandlers); for a unit in the active run's party those remotes are
-- routed here by LoadoutRequestHandlers.SetGate(DungeonLoadout.Gate). The original handler code still runs
-- (all its checks stay the same: item level, weapon retention, augment tags, conflicts, slot locks), but on
-- a run-only card inventory built from the Bag, and gear is moved between the Bag and the unit around it.
--
--   * Only Bag items (found or bought this run) and the unit's own equipped items can be used. Home
--     inventory is locked: "Locked in the dungeon." (SB-22).
--   * Equipping a Bag item takes it out of the Bag onto the unit; anything it replaces goes into the Bag.
--   * Home items taken off go into the Bag view (1 slot each, always kept, rule 279). They never leave home
--     storage (inventory / card stash), so they come home on every run end.
--   * Found items on units come home with the loot: kept on a full-loot exit, lost on early escape / wipeout
--     (bought ones are always kept, rule 268). On a loss a found gear piece is replaced by the home gear it
--     replaced when that is still free.
--   * Map consumables (rule 266): UseItem uses one charge of a Bag consumable on a party unit between rooms.
--     Heal / MP / revive items only (Shared/DungeonMapUse); others: "Only usable in battle." (SB-24).
--   * Not during a battle: changes only while the guild menu is open at the base (the dungeon screen rule).
-- Run state: run.dgLoad = { origin = { [key] = "bag" }, home = { gear = { [id] = true }, cards = { [key] = n } },
--   open = { [consumableId] = { charges left, one entry per opened copy } }, prevHome = { ["unitId|slot"] = home
--   instanceId } } (saved). Fixes 2026-11-16 (Tester thread-456fa97ca2c1 F1/F2) + USER RULINGS 2:30 AM:
--   * F1: every opened copy keeps its own charges (no free refill when several copies are opened).
--   * F2: a home off-hand pushed out by a found two-handed weapon goes back on when the weapon comes off.
--   * R1: home units can't equip home items a party unit took off; they stay reserved for the run.
--   * R2: a unit sent home with a full Bag: its found items wait in run.bagHeld for the full-Bag pick.
--   * R3: opened Bag copies: bought ones always come home with their charges left; found ones follow the
--     loot rule. Home storage only holds full copies, so a copy that comes home goes into a free
--     consumable slot of a party unit (refilled at base like any equipped item); no free slot: a normal copy.
-- Dependencies: DungeonService binds stateOf / persist; Main injects the game hooks (ARC-004 / ARC-006).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Content = ReplicatedStorage:WaitForChild("Content")
local WeaponData: any = require(Content:WaitForChild("WeaponData"))
local ArmorData: any = require(Content:WaitForChild("ArmorData"))
local MapUse: any = require(ReplicatedStorage:WaitForChild("CTRBLXAI"):WaitForChild("Shared"):WaitForChild("DungeonMapUse"))
local DungeonBag = require(script.Parent:WaitForChild("DungeonBag"))
local DungeonSilver = require(script.Parent:WaitForChild("DungeonSilver"))
local ItemDisplay: any = require(script.Parent:WaitForChild("ItemDisplay"))

local LOCKED = "Locked in the dungeon." -- SB-22 (approved 2026-11-15 9:09 PM)
local FULL = "Your bag is full" -- SB-13
local BATTLE_ONLY = "Only usable in battle." -- SB-24
local GENERIC = "Something went wrong. Try again." -- approved generic error
local RATE_LIMIT = 0.2 -- SEC-001: seconds between two dungeon loadout changes
local CATS = table.freeze({ skillCards = true, augmentCards = true, consumables = true })

local L = {}

local C: any = nil -- DungeonService: stateOf, persist
local H: any = {} -- Main hooks
function L.Bind(ctx: any) C = ctx end
function L.SetHooks(h: any) H = h or {} end

local lastAt: { [string]: number } = {}

local function runOf(): any
	if not (C and H.playerId) then return nil end
	return C.stateOf(H.playerId).run
end

local function dl(run: any): any
	local d = run.dgLoad
	if type(d) ~= "table" then
		d = { origin = {}, home = { gear = {}, cards = {} }, open = {}, prevHome = {} }
		run.dgLoad = d
	end
	return d
end

local function split(key: string): (string?, string?)
	local cat, id = string.match(key, "^(%w+):(.+)$")
	return cat, id
end

local function call(name: string, ...: any): (any, any)
	local f = H[name]
	if type(f) ~= "function" then return nil, nil end
	local ok, a, b = pcall(f, ...)
	if not ok then warn(`[DungeonLoadout] hook {name} failed: {a}`) return nil, nil end
	return a, b
end

-- Home gear in the Bag view is valid only while it is still in the inventory and not on any unit.
local function homeGearFree(id: string): boolean
	return call("inventoryGet", id) ~= nil and call("holderOf", id) == nil
end

local function maxOf(cid: string): number
	return math.max(1, math.floor(tonumber(call("maxCharges", cid)) or 1))
end

-- Opened Bag copies of one consumable (F1), emptiest first. Full-again (refilled) or empty entries are dropped,
-- and there are never more opened copies than copies in the Bag. Writes the cleaned list back.
local function openList(run: any, cid: string): { number }
	local d = dl(run)
	local raw = d.open[cid]
	local maxC = maxOf(cid)
	local copies = (run.bag.cards or {})["consumables:" .. cid] or 0
	local out: { number } = {}
	if type(raw) == "table" then
		for _, c in raw do
			if type(c) == "number" and c >= 1 and c < maxC then table.insert(out, math.floor(c)) end
		end
	end
	table.sort(out)
	while #out > copies do table.remove(out) end
	d.open[cid] = if #out > 0 then out else nil
	return out
end

-- Drop stale home entries (an item used at the base meanwhile); cards are clamped to the stash.
local function cleanHome(run: any)
	local d = dl(run)
	for id in d.home.gear do if not homeGearFree(id) then d.home.gear[id] = nil end end
	local stash = call("cardStash") or {}
	for key, n in d.home.cards do
		local cat, id = split(key)
		local have = (cat and id and type(stash[cat]) == "table" and stash[cat][id]) or 0
		local m = math.min(n, have)
		d.home.cards[key] = if m > 0 then m else nil
	end
end

-- Slots the Bag would use with these counts (same rule as DungeonBag.SlotsUsed: gear 1, card 1 per copy,
-- consumable stack 1). Home items count the same way.
local function slotsOf(gearN: number, cards: { [string]: number }, homeGearN: number, homeCards: { [string]: number }): number
	local n = gearN + homeGearN
	for _, t in { cards, homeCards } do
		for key, q in t do
			if q > 0 then n += if string.sub(key, 1, 12) == "consumables:" then 1 else q end
		end
	end
	return n
end

local function countGear(t: any): number local n = 0 for _ in t do n += 1 end return n end

-- True when the Bag can take the change (only checked while the Bag limit is live, rule 279).
local function fits(run: any, gearDelta: number, homeGearDelta: number, cardDeltas: { [string]: number }, homeCardDeltas: { [string]: number }): boolean
	if not DungeonBag.IsLive() then return true end
	local d = dl(run)
	local cards = table.clone(run.bag.cards or {})
	for k, v in cardDeltas do cards[k] = math.max(0, (cards[k] or 0) + v) end
	local hc = table.clone(d.home.cards)
	for k, v in homeCardDeltas do hc[k] = math.max(0, (hc[k] or 0) + v) end
	local used = slotsOf(#run.bag.gear + gearDelta, cards, countGear(d.home.gear) + homeGearDelta, hc)
	local before = slotsOf(#run.bag.gear, run.bag.cards or {}, countGear(d.home.gear), d.home.cards)
	return used <= before or used <= DungeonBag.Capacity(run.card and run.card.facilityLevel or 1)
end

--------------------------------------------------
-- GEAR
--------------------------------------------------

local function archetypeOf(item: any): (any, boolean)
	local w = WeaponData.GetByArchetypeId(item.baseArchetypeId)
	if w then return w, false end
	return ArmorData.GetByArchetypeId(item.baseArchetypeId), true
end

-- Same slot rule as RequestEquip.
local function slotFor(item: any, slotOverride: any): string?
	local arch, isArmor = archetypeOf(item)
	if not arch then return nil end
	local slot = if isArmor then arch.slot else (if arch.category == "OffHand" then "OffHand" else "MainHand")
	if slotOverride == "OffHand" and not isArmor and arch.category == "Weapon" then slot = "OffHand" end
	return slot
end

local function removeFromBagGear(run: any, id: string)
	run.bag.gearItems[id] = nil
	local ix = table.find(run.bag.gear, id)
	if ix then table.remove(run.bag.gear, ix) end
end

-- An item that left a unit goes back to where it came from: found -> the Bag, home -> the Bag view.
local function stash(run: any, item: any)
	local d = dl(run)
	local id = item.instanceId
	if d.origin["g:" .. id] == "bag" then
		d.origin["g:" .. id] = nil
		call("inventoryRemove", id)
		run.bag.gearItems[id] = item
		if not table.find(run.bag.gear, id) then table.insert(run.bag.gear, id) end
	else
		d.home.gear[id] = true
	end
end

local function gearEquip(run: any, fn: any, player: any, unitId: string, instanceId: any, slotOverride: any): any
	local d = dl(run)
	if type(instanceId) ~= "string" or #instanceId > 128 then return { ok = false, reason = GENERIC } end
	local unit = call("getUnit", unitId)
	if not unit then return { ok = false, reason = GENERIC } end
	cleanHome(run)
	local bagItem = run.bag.gearItems[instanceId]
	local holder = call("holderOf", instanceId)
	local fromHome = d.home.gear[instanceId] == true
	local fromParty = holder ~= nil and run.partySet[holder] == true
	if not bagItem and not fromHome and not fromParty then return { ok = false, reason = LOCKED } end
	local item = bagItem or call("inventoryGet", instanceId)
	if not item then return { ok = false, reason = GENERIC } end
	local slot = slotFor(item, slotOverride)
	if not slot then return { ok = false, reason = GENERIC } end
	-- Bag room: what this unit drops (the slot, plus its off-hand for a two-handed weapon) minus what leaves the Bag.
	local before: { [string]: any } = table.clone(unit.equipmentSlots or {})
	local drops = 0
	if before[slot] and before[slot].instanceId ~= instanceId then drops += 1 end
	local arch = archetypeOf(item)
	if slot == "MainHand" and arch and arch.handClass == "2H" and before.OffHand then drops += 1 end
	local gearIn = if bagItem then -1 else 0
	local homeIn = if fromHome and not bagItem then -1 else 0
	if not fits(run, drops + gearIn, homeIn, {}, {}) then return { ok = false, reason = FULL } end
	if bagItem and not call("inventoryAdd", bagItem) then return { ok = false, reason = GENERIC } end
	local res = fn(player, unitId, instanceId, slotOverride)
	if not (type(res) == "table" and res.ok) then
		if bagItem then call("inventoryRemove", instanceId) end -- refused: the item stays in the Bag
		return res
	end
	if bagItem then
		removeFromBagGear(run, instanceId)
		d.origin["g:" .. instanceId] = "bag"
	end
	d.home.gear[instanceId] = nil
	-- What this unit no longer wears goes to the Bag (found) or the Bag view (home).
	local still: { [string]: boolean } = {}
	for _, it in unit.equipmentSlots or {} do still[it.instanceId] = true end
	for s, it in before do
		if not still[it.instanceId] then
			local wasHome = d.origin["g:" .. it.instanceId] ~= "bag"
			stash(run, it)
			if d.origin["g:" .. instanceId] == "bag" and wasHome then
				d.prevHome[unitId .. "|" .. s] = it.instanceId -- restored on a lost run
			end
		end
	end
	print(`[DungeonLoadout] {unit.name} equipped {instanceId} in {res.slot or slot} ({if bagItem then "from Bag" elseif fromHome then "home item" else "from party"})`)
	if C and C.persist then C.persist() end
	return res
end

local function gearUnequip(run: any, fn: any, player: any, unitId: string, slot: any): any
	local unit = call("getUnit", unitId)
	local cur = unit and unit.equipmentSlots and type(slot) == "string" and unit.equipmentSlots[slot]
	if cur and not fits(run, if dl(run).origin["g:" .. cur.instanceId] == "bag" then 1 else 0,
		if dl(run).origin["g:" .. cur.instanceId] == "bag" then 0 else 1, {}, {}) then
		return { ok = false, reason = FULL }
	end
	local res = fn(player, unitId, slot)
	if cur and type(res) == "table" and res.ok then
		stash(run, cur)
		print(`[DungeonLoadout] {unit.name} took off {cur.instanceId} into the Bag`)
		if C and C.persist then C.persist() end
	end
	return res
end

--------------------------------------------------
-- CARDS + CONSUMABLES (run-only card inventory)
--------------------------------------------------

--- The run's card inventory: Bag cards plus home cards taken off this run (still in the home stash).
local function snapshot(run: any): any
	cleanHome(run)
	local inv: any = { skillCards = {}, augmentCards = {}, consumables = {} }
	for _, src in { run.bag.cards or {}, dl(run).home.cards } do
		for key, q in src do
			local cat, id = split(key)
			if cat and id and CATS[cat] and q > 0 then inv[cat][id] = (inv[cat][id] or 0) + q end
		end
	end
	return inv
end

local function flat(inv: any): { [string]: number }
	local out: { [string]: number } = {}
	for cat in CATS do for id, q in inv[cat] or {} do if q > 0 then out[cat .. ":" .. id] = q end end end
	return out
end

-- Origin keys of what a card action touches, and what it gives back (key -> list of origins).
local function slotKeyOf(slotIndex: number): string return if slotIndex == 1 then "_doctrine" else "slot" .. slotIndex end

local function cardTargets(name: string, unit: any, a: any, b: any, c: any): ({ { key: string, origin: string } }, string?, string?)
	-- returns: items that may come back (card key + origin key), the origin key the new item takes, its card key
	local back: { { key: string, origin: string } } = {}
	local uid = unit.id
	local function addSkill(slotIndex: number)
		local sk = slotKeyOf(slotIndex)
		local sd = if slotIndex == 1 then nil else (unit.skillLoadout or {})[sk]
		if sd and sd.skillId then table.insert(back, { key = "skillCards:" .. sd.skillId, origin = `s:{uid}:{sk}` }) end
		local augs = if slotIndex == 1 then (unit.doctrineAugments or {}) else (sd and sd.augments or {})
		for j = 1, 2 do
			if slotIndex ~= 1 and not sd then break end
			local aid = augs[j]
			if aid then table.insert(back, { key = "augmentCards:" .. aid, origin = `a:{uid}:{sk}:{j}` }) end
		end
	end
	if name == "RequestEquipSkillCard" or name == "RequestUnequipSkillCard" then
		if type(a) ~= "number" then return back, nil, nil end
		addSkill(a)
		if name == "RequestEquipSkillCard" and type(b) == "string" then return back, `s:{uid}:slot{a}`, "skillCards:" .. b end
		return back, nil, nil
	elseif name == "RequestAttachAugment" or name == "RequestDetachAugment" then
		if type(a) ~= "number" or type(b) ~= "number" then return back, nil, nil end
		local sk = slotKeyOf(a)
		local augs = if a == 1 then (unit.doctrineAugments or {}) else (((unit.skillLoadout or {})[sk] or {}).augments or {})
		if augs[b] then table.insert(back, { key = "augmentCards:" .. augs[b], origin = `a:{uid}:{sk}:{b}` }) end
		if name == "RequestAttachAugment" and type(c) == "string" then return back, `a:{uid}:{sk}:{b}`, "augmentCards:" .. c end
		return back, nil, nil
	elseif name == "RequestEquipConsumable" or name == "RequestUnequipConsumable" then
		if type(a) ~= "number" then return back, nil, nil end
		local s = unit.consumableSlots and unit.consumableSlots[a]
		if s and s.consumableId then table.insert(back, { key = "consumables:" .. s.consumableId, origin = `c:{uid}:{a}` }) end
		if name == "RequestEquipConsumable" and type(b) == "string" then return back, `c:{uid}:{a}`, "consumables:" .. b end
		return back, nil, nil
	end
	return back, nil, nil
end

local function cardAction(run: any, name: string, fn: any, withInv: any, player: any, unitId: string, a: any, b: any, c: any): any
	local d = dl(run)
	local unit = call("getUnit", unitId)
	if not unit then return { ok = false, reason = GENERIC } end
	local back, newOrigin, newKey = cardTargets(name, unit, a, b, c)
	local inv = snapshot(run)
	local before = flat(inv)
	-- Bag room check (rule 279): what comes back minus what leaves the Bag.
	if DungeonBag.IsLive() then
		local cd: { [string]: number }, hd: { [string]: number } = {}, {}
		for _, e in back do
			local t = if d.origin[e.origin] == "bag" then cd else hd
			t[e.key] = (t[e.key] or 0) + 1
		end
		if newKey then
			if ((run.bag.cards or {})[newKey] or 0) > 0 then cd[newKey] = (cd[newKey] or 0) - 1
			else hd[newKey] = (hd[newKey] or 0) - 1 end
		end
		if not fits(run, 0, 0, cd, hd) then return { ok = false, reason = FULL } end
	end
	local partly: { [string]: number }? = nil -- a consumable slot's charges before (partly used items can't come back)
	local res = withInv(inv, fn, player, unitId, a, b, c)
	if not (type(res) == "table" and res.ok) then return res end
	local after = flat(inv)
	local stashT = call("cardStash") or {}
	local function stashAdd(key: string, n: number)
		local cat, id = split(key)
		if not (cat and id and type(stashT[cat]) == "table") then return end
		local v = (stashT[cat][id] or 0) + n
		stashT[cat][id] = if v > 0 then v else nil
	end
	-- Returned copies go back to where they came from (found -> Bag, home -> Bag view + home stash).
	local backByKey: { [string]: { string } } = {}
	for _, e in back do
		backByKey[e.key] = backByKey[e.key] or {}
		table.insert(backByKey[e.key], d.origin[e.origin] or "home")
		d.origin[e.origin] = nil
	end
	local takenFrom: string? = nil
	local keys: { [string]: boolean } = {}
	for k in before do keys[k] = true end
	for k in after do keys[k] = true end
	for key in keys do
		local delta = (after[key] or 0) - (before[key] or 0)
		if delta > 0 then
			for _ = 1, delta do
				local list = backByKey[key]
				local o = if list and #list > 0 then table.remove(list, 1) else "bag"
				if o == "bag" then
					run.bag.cards[key] = (run.bag.cards[key] or 0) + 1
				else
					d.home.cards[key] = (d.home.cards[key] or 0) + 1
					stashAdd(key, 1)
				end
			end
		elseif delta < 0 then
			local need = -delta
			local inBag = run.bag.cards[key] or 0
			local t = math.min(need, inBag)
			if t > 0 then
				local cat, id = split(key)
				if cat == "consumables" and id then
					-- opened Bag copies are taken last (F1: each one is tracked); the one that goes onto a unit
					-- keeps its charges left
					local list = openList(run, id)
					local take = math.max(0, #list - (inBag - t))
					for _ = 1, take do
						local ch = table.remove(list) -- the fullest opened copy
						if ch and not partly then partly = { [key] = ch } end
					end
					d.open[id] = if #list > 0 then list else nil
				end
				run.bag.cards[key] = if inBag - t > 0 then inBag - t else nil
				takenFrom = "bag"
			end
			local rest = need - t
			if rest > 0 then
				d.home.cards[key] = math.max(0, (d.home.cards[key] or 0) - rest)
				if d.home.cards[key] == 0 then d.home.cards[key] = nil end
				stashAdd(key, -rest)
				takenFrom = takenFrom or "home"
			end
		end
	end
	if newOrigin and newKey and (before[newKey] or 0) > (after[newKey] or 0) then
		if takenFrom == "bag" then d.origin[newOrigin] = "bag" end
		local pl = partly
		local charges = pl and pl[newKey]
		if charges and name == "RequestEquipConsumable" and type(a) == "number" then
			local s = unit.consumableSlots and unit.consumableSlots[a]
			if s then s.currentCharges = math.min(charges, s.maxCharges or charges) end
		end
	end
	print(`[DungeonLoadout] {unit.name} {name} | {if takenFrom then "took from " .. takenFrom else "returned"}`)
	if C and C.persist then C.persist() end
	return res
end

--------------------------------------------------
-- VIEWS (dungeon mode of the Loadout screen)
--------------------------------------------------

--- GetInventoryData("dungeon"): Bag gear + home gear taken off this run + gear on party units.
function L.InventoryView(run: any): { any }
	local d = dl(run)
	cleanHome(run)
	local out = {}
	local bought = run.boughtKeep and run.boughtKeep.gear or {}
	for _, id in run.bag.gear do
		local it = run.bag.gearItems[id]
		if it then
			local e = ItemDisplay.buildItemEntry(it)
			e.bagTag = if bought[id] then "bought" else "found"
			table.insert(out, e)
		end
	end
	for id in d.home.gear do
		local it = call("inventoryGet", id)
		if it then
			local e = ItemDisplay.buildItemEntry(it)
			e.bagTag = "home"
			table.insert(out, e)
		end
	end
	for _, uid in run.party do
		local u = call("getUnit", uid)
		for slot, it in (u and u.equipmentSlots) or {} do
			local e = ItemDisplay.buildItemEntry(it)
			e.equippedBy, e.equippedSlot = uid, slot
			table.insert(out, e)
		end
	end
	return out
end

--- Bag screen (steps 4-5): home items taken off this run, as item tables / card counts (always kept, SB-20).
function L.HomeItems(run: any): any
	if type(run) ~= "table" or type(run.dgLoad) ~= "table" then return { gear = {}, cards = {} } end
	cleanHome(run)
	local gear = {}
	for id in run.dgLoad.home.gear do local it = call("inventoryGet", id) if it then table.insert(gear, it) end end
	return { gear = gear, cards = table.clone(run.dgLoad.home.cards) }
end

--- Card / consumable Bag tags for the dungeon-mode Loadout details (SB-19 / SB-20), same rule as the Bag
--- screen: "bought" only when every copy (Bag + taken-off home) was bought; "home" only when all copies are home ones; any mix = no tag.
function L.CardTags(run: any): { [string]: string }
	local out: { [string]: string } = {}
	local bc = (run.boughtKeep and run.boughtKeep.cards) or {}
	for key, q in run.bag.cards or {} do
		if type(q) == "number" and q > 0 and (bc[key] or 0) >= q then out[key] = "bought" end
	end
	local home = (type(run.dgLoad) == "table" and run.dgLoad.home and run.dgLoad.home.cards) or {}
	for key, q in home do
		if (q or 0) > 0 then
			-- Mixed = no tag (rule 279): home copies taken off plus any Bag copy (bought or found).
			if ((run.bag.cards or {})[key] or 0) <= 0 then out[key] = "home" else out[key] = nil end
		end
	end
	return out
end

--- Bag consumable copies that can be used on the map (found / bought, not home items).
function L.MapUsable(run: any): { [string]: number }
	local out: { [string]: number } = {}
	for key, q in run.bag.cards or {} do
		local cat, id = split(key)
		if cat == "consumables" and id and q > 0 then out[id] = q end
	end
	return out
end

--------------------------------------------------
-- GATE (LoadoutRequestHandlers routes every loadout remote through this)
--------------------------------------------------

local MUTATE = table.freeze({
	RequestEquip = true, RequestUnequip = true, RequestEquipDoctrine = true,
	RequestEquipSkillCard = true, RequestUnequipSkillCard = true,
	RequestAttachAugment = true, RequestDetachAugment = true,
	RequestEquipConsumable = true, RequestUnequipConsumable = true,
	RequestDoctrineSkillSelect = true, -- W3 default 2026-11-16: locked like the doctrine swap
})

--- Returns handled, result. handled = false: the normal handler runs unchanged.
function L.Gate(name: string, fn: any, withInv: any, player: any, ...: any): (boolean, any)
	local run = runOf()
	if not run then return false, nil end
	local a, b, c, e = ...
	-- Home units (rule 265; R1 USER RULING 2026-11-16 2:30 AM): they can't take gear off a unit in the dungeon,
	-- and home items a party unit took off stay reserved for the run until it ends (they come home then).
	if type(a) == "string" and not run.partySet[a] and MUTATE[name] then
		local dg = run.dgLoad
		if name == "RequestEquip" then
			local holder = call("holderOf", b)
			if holder and run.partySet[holder] then return true, { ok = false, reason = LOCKED } end
			if type(b) == "string" and type(dg) == "table" and dg.home.gear[b] then
				cleanHome(run)
				if dg.home.gear[b] then return true, { ok = false, reason = LOCKED } end
			end
		elseif type(dg) == "table" then
			-- args after the unit: skill card (slot, skillId); augment (slot, augIndex, augId); consumable (slot, id)
			local key = if name == "RequestEquipSkillCard" and type(c) == "string" then "skillCards:" .. c
				elseif name == "RequestAttachAugment" and type(e) == "string" then "augmentCards:" .. e
				elseif name == "RequestEquipConsumable" and type(c) == "string" then "consumables:" .. c
				else nil
			if key then
				cleanHome(run)
				local reserved = dg.home.cards[key] or 0
				local cat, id = split(key)
				local stashT = call("cardStash") or {}
				local have = (cat and id and type(stashT[cat]) == "table" and stashT[cat][id]) or 0
				if reserved > 0 and have - reserved < 1 then return true, { ok = false, reason = LOCKED } end
			end
		end
		return false, nil
	end
	if name == "GetInventoryData" then
		if a ~= "dungeon" then return false, nil end
		return true, L.InventoryView(run)
	elseif name == "GetRosterData" then
		if a ~= "dungeon" then return false, nil end
		local r = fn(player)
		for id in r or {} do if not run.partySet[id] then r[id] = nil end end
		return true, r
	elseif name == "GetConsumableSlots" then
		if a ~= "dungeon" then return false, nil end
		local r = withInv(snapshot(run), fn, player)
		for id in r or {} do if id ~= "_owned" and not run.partySet[id] then r[id] = nil end end
		r._mapUsable = L.MapUsable(run)
		r._bagTags = L.CardTags(run) -- small-gaps 2026-11-16: tags on card details
		return true, r
	elseif name == "GetEquipmentComparison" then -- a Bag item isn't in the inventory: add it just for the compare
		local it = type(b) == "string" and run.bag.gearItems[b]
		if not it or not call("inventoryAdd", it) then return false, nil end
		local ok, res = pcall(fn, player, a, b)
		call("inventoryRemove", b)
		if not ok then warn("[DungeonLoadout] compare failed: " .. tostring(res)) return true, nil end
		return true, res
	elseif name == "GetSkillLoadout" then
		if type(a) ~= "string" or not run.partySet[a] then return false, nil end
		return true, withInv(snapshot(run), fn, player, a)
	end
	if not MUTATE[name] then return false, nil end
	if type(a) ~= "string" or not run.partySet[a] then return false, nil end
	-- A unit in the dungeon party: run rules from here on.
	if not call("isAtBase") then return true, { ok = false, reason = GENERIC } end -- never during a battle
	local now = os.clock()
	if lastAt[name] and now - lastAt[name] < RATE_LIMIT then return true, { ok = false, reason = "Too fast — try again" } end
	lastAt[name] = now
	if name == "RequestEquipDoctrine" or name == "RequestDoctrineSkillSelect" then return true, { ok = false, reason = LOCKED } end
	if name == "RequestEquip" then return true, gearEquip(run, fn, player, a, b, c) end
	if name == "RequestUnequip" then return true, gearUnequip(run, fn, player, a, b) end
	return true, cardAction(run, name, fn, withInv, player, a, b, c, e)
end

--------------------------------------------------
-- MAP CONSUMABLES (rule 266)
--------------------------------------------------

--- Use one charge of a Bag consumable on a party unit. Returns ok, { name?, left } | error.
function L.UseItem(playerId: string, consumableId: any, unitId: any): (boolean, any)
	local run = C and C.stateOf(playerId).run
	if not run then return false, "No dungeon run in progress" end
	if type(consumableId) ~= "string" or #consumableId > 32 or type(unitId) ~= "string" or #unitId > 64 then return false, "Invalid request" end
	if not run.partySet[unitId] then return false, "Invalid request" end
	local key = "consumables:" .. consumableId
	local have = (run.bag.cards or {})[key] or 0
	if have <= 0 then return false, "Invalid request" end
	local eff = MapUse.Get(consumableId)
	if not eff then return false, BATTLE_ONLY end
	local targets: { string } = {}
	if eff.party then
		for _, id in run.party do local st = call("unitState", id) if st and not st.isKO then table.insert(targets, id) end end
	else
		targets = { unitId }
	end
	local changed = false
	for _, id in targets do
		local st = call("unitState", id)
		if st then
			if eff.revive then
				if st.isKO then call("revive", id, eff.revive); changed = true end
			elseif not st.isKO then
				local hpGap = (eff.hp or 0) > 0 and (st.hp or 0) < (st.maxHp or 0)
				local mpGap = (eff.mp or 0) > 0 and (st.mp or 0) < (st.maxMp or 0)
				if hpGap or mpGap then call("heal", id, eff.hp or 0, eff.mp or 0); changed = true end
			end
		end
	end
	if not changed then return false, "Invalid request" end -- nothing to heal / revive: no charge spent
	-- One charge: an opened copy keeps its charges left; when it is empty the copy is gone.
	local d = dl(run)
	local list = openList(run, consumableId)
	local left: number
	if #list > 0 then -- F1: finish the emptiest opened copy first
		left = list[1] - 1
		if left <= 0 then table.remove(list, 1) else list[1] = left end
	else
		left = maxOf(consumableId) - 1
		if left > 0 then table.insert(list, left) end
	end
	table.sort(list)
	d.open[consumableId] = if #list > 0 then list else nil
	if left <= 0 then -- that copy is used up
		run.bag.cards[key] = if have - 1 > 0 then have - 1 else nil
		-- found copies are used first: bought marks only drop when there are more marks than copies
		local marks = run.boughtKeep and run.boughtKeep.cards and run.boughtKeep.cards[key] or 0
		if marks > have - 1 then DungeonSilver.UnmarkBought(run, "card", key, "used", marks - (have - 1)) end
	end
	local open = d.open[consumableId]
	print(`[DungeonLoadout] Map use {consumableId} on {unitId} | copies {run.bag.cards[key] or 0}, opened copies {if open then #open else 0}`)
	if C and C.persist then C.persist() end
	return true, { left = run.bag.cards[key] or 0, open = if open then open[1] else nil }
end

-- (Campfire "Search the camp" clears run.dgLoad.open in DungeonRooms: opened Bag copies are full again.)

-- Merchant / Peddler silver refill (rule 268): opened Bag copies as extra charge slots. idx 101.. (numbers,
-- so the refill sort works); setOpen maps them back.
local openIdx: { [number]: { id: string, i: number } } = {}
function L.OpenSlots(playerId: string, tierOf: (string) -> string?): { any }
	local run = C and C.stateOf(playerId).run
	local out = {}
	table.clear(openIdx)
	if not (run and run.dgLoad) then return out end
	local ids = {}
	for id in run.dgLoad.open do table.insert(ids, id) end
	table.sort(ids)
	local n = 0
	for _, id in ids do
		local maxC = maxOf(id)
		for i, ch in openList(run, id) do -- F1: one refill line per opened copy
			n += 1
			openIdx[100 + n] = { id = id, i = i }
			table.insert(out, { uid = "_bag", idx = 100 + n, tier = tierOf(id), cur = ch, slotMax = maxC, paidMax = maxC })
		end
	end
	return out
end
function L.SetOpen(playerId: string, idx: number, n: number)
	local run = C and C.stateOf(playerId).run
	local e = openIdx[idx]
	local list = run and run.dgLoad and e and run.dgLoad.open[e.id]
	if not (e and type(list) == "table" and list[e.i] ~= nil) then return end
	-- full again = a normal copy: dropped from the opened list on the next read (openList); not removed here
	-- so the other refill lines of the same item keep their index
	list[e.i] = math.clamp(math.floor(n), 1, maxOf(e.id))
end

--------------------------------------------------
-- RUN END
--------------------------------------------------

-- Bought marks protect what is on units too (rule 268); a used mark is taken off.
local function useMark(run: any, kind: string, key: string): boolean
	local k = run.boughtKeep
	if not k then return false end
	if kind == "gear" then
		if k.gear[key] then k.gear[key] = nil return true end
		return false
	end
	local n = k.cards[key] or 0
	if n <= 0 then return false end
	k.cards[key] = if n > 1 then n - 1 else nil
	return true
end

-- Found items (origin "bag") come off one party unit. mode "lose": gone (bought ones stay, rule 268) and the
-- home gear they replaced comes back when free; mode "bag": back into the Bag (unit sent home mid-run).
-- Returns gear, cards removed.
local function stripFound(run: any, uid: string, mode: string): (number, number)
	local d = dl(run)
	local u = call("getUnit", uid)
	if not u then return 0, 0 end
	local nG, nC = 0, 0
	local stashT = call("cardStash") or {}
	for slot, it in table.clone(u.equipmentSlots or {}) do
		local id = it.instanceId
		if d.origin["g:" .. id] == "bag" and not (mode == "lose" and useMark(run, "gear", id)) then
			call("forceUnequip", u, slot)
			if mode == "bag" and DungeonBag.Admit(run, "gearItem", it, 1) >= 1 then
				stash(run, it)
			else -- lost, or (R2: sent home with a full Bag) waiting in run.bagHeld for the full-Bag pick
				d.origin["g:" .. id] = nil; call("inventoryRemove", id)
			end
			nG += 1
			local prev = d.prevHome[uid .. "|" .. slot]
			local pit = prev and homeGearFree(prev) and call("inventoryGet", prev)
			if pit then call("equip", u, pit, slot); d.home.gear[prev] = nil end -- the home gear it replaced comes back
			d.prevHome[uid .. "|" .. slot] = nil
		end
	end
	-- F2: home gear pushed out by a found piece into a slot that is now empty (a home off-hand displaced by a
	-- found two-handed weapon) goes back on too. Never next to a two-handed weapon still in the main hand.
	local prefix = uid .. "|"
	for k, prev in table.clone(d.prevHome) do
		if string.sub(k, 1, #prefix) == prefix then
			local s = string.sub(k, #prefix + 1)
			local slots = u.equipmentSlots or {}
			local main = slots.MainHand
			local mainArch = main and archetypeOf(main)
			local blocked = s == "OffHand" and mainArch and mainArch.handClass == "2H"
			if slots[s] == nil and not blocked and homeGearFree(prev) then
				local pit = call("inventoryGet", prev)
				if pit and call("equip", u, pit, s) then
					d.home.gear[prev] = nil
					d.prevHome[k] = nil
					print(`[DungeonLoadout] {u.name} home {s} {prev} back on`)
				end
			end
		end
	end
	-- true when this card comes off the unit (found, and not saved by a bought mark on a loss).
	-- charges: a partly used consumable's charges left (F1: it goes back as one more opened copy).
	local function off(originKey: string, key: string, charges: number?): boolean
		if d.origin[originKey] ~= "bag" then return false end
		if mode == "lose" and useMark(run, "card", key) then return false end
		d.origin[originKey] = nil
		nC += 1
		if mode == "bag" then
			-- R2: into the Bag when it fits; otherwise it waits in run.bagHeld for the full-Bag pick
			if DungeonBag.Admit(run, "cards", key, 1, charges) >= 1 then
				run.bag.cards[key] = (run.bag.cards[key] or 0) + 1
				local cat, cid = split(key)
				if charges and cat == "consumables" and cid then
					local list = d.open[cid] or {}
					table.insert(list, charges)
					d.open[cid] = list
				end
			end
		end
		return true
	end
	local function homeBack(originKey: string, cat: string, id: string) -- a home augment on a removed card
		if d.origin[originKey] ~= "bag" and type(stashT[cat]) == "table" then
			stashT[cat][id] = (stashT[cat][id] or 0) + 1
			d.home.cards[cat .. ":" .. id] = (d.home.cards[cat .. ":" .. id] or 0) + 1
		end
	end
	for i = 2, 4 do
		local sk = "slot" .. i
		local sd = u.skillLoadout and u.skillLoadout[sk]
		if sd and sd.skillId and off(`s:{uid}:{sk}`, "skillCards:" .. sd.skillId) then
			for j, aid in pairs(sd.augments or {}) do
				if aid and not off(`a:{uid}:{sk}:{j}`, "augmentCards:" .. aid) then homeBack(`a:{uid}:{sk}:{j}`, "augmentCards", aid) end
				d.origin[`a:{uid}:{sk}:{j}`] = nil
			end
			u.skillLoadout[sk] = nil
		elseif sd then
			for j, aid in pairs(sd.augments or {}) do
				if aid and off(`a:{uid}:{sk}:{j}`, "augmentCards:" .. aid) then sd.augments[j] = nil end
			end
		end
	end
	for j, aid in pairs(u.doctrineAugments or {}) do
		if aid and off(`a:{uid}:_doctrine:{j}`, "augmentCards:" .. aid) then u.doctrineAugments[j] = nil end
	end
	for idx, s in pairs(u.consumableSlots or {}) do
		-- F1: a partly used found consumable sent back to the Bag keeps its own charges as one more opened copy
		local partlyC = if type(s) == "table" and (s.currentCharges or 0) < (s.maxCharges or 0)
			then math.max(1, s.currentCharges or 1) else nil
		if type(s) == "table" and s.consumableId and off(`c:{uid}:{idx}`, "consumables:" .. s.consumableId, partlyC) then
			u.consumableSlots[idx] = nil
		end
	end
	if nC > 0 then call("rebuildSkills", u) end
	call("rebuild", u)
	return nG, nC
end

-- R3: put an opened copy that comes home into a free consumable slot of a party unit, at its charges left.
local function placeOpened(run: any, cid: string, charges: number): boolean
	local maxC = maxOf(cid)
	for _, uid in run.party do
		local u = call("getUnit", uid)
		if u then
			u.consumableSlots = u.consumableSlots or {}
			local dup = false
			for _, s in u.consumableSlots do if type(s) == "table" and s.consumableId == cid then dup = true end end
			if not dup then
				for idx = 1, math.min(6, u.consumableSlotCount or 3) do
					if u.consumableSlots[idx] == nil then
						u.consumableSlots[idx] = { consumableId = cid, currentCharges = math.clamp(math.floor(charges), 1, maxC),
							maxCharges = maxC, _ownMaxGiven = maxC }
						call("rebuild", u)
						return true
					end
				end
			end
		end
	end
	return false
end

L.PlaceOpened = placeOpened -- steps 4-5: EV-17 sent opened copies come home at their charges left (DungeonCourier)

--- Edit party "send home" (rule 267): found items on that unit stay in the run and go back into the Bag.
function L.OnSendHome(run: any, unitId: string)
	if not (run and type(run.dgLoad) == "table") then return end
	local g, c = stripFound(run, unitId, "bag")
	if g + c > 0 then print(`[DungeonLoadout] {unitId} sent home: {g} gear, {c} card(s) back into the Bag`) end
end

--- Called by DungeonService.EndRun before KeepBought. rule = OUTCOME_KEEP[kind] (gear / cards kept?).
function L.OnRunEnd(run: any, outcome: any, rule: any)
	local d = run and run.dgLoad
	if type(d) ~= "table" then return end
	local keepGear, keepCards = rule and rule.gear == true, rule and rule.cards == true
	local lostGear, lostCards = 0, 0
	if not (keepGear and keepCards) then
		for _, uid in run.party do
			local u = call("getUnit", uid)
			if u then
				-- keep what the outcome keeps: strip only the lost kind(s)
				if keepGear then for k in d.origin do if string.sub(k, 1, 2) == "g:" then d.origin[k] = nil end end end
				if keepCards then for k in d.origin do if string.sub(k, 1, 2) ~= "g:" then d.origin[k] = nil end end end
				local g, c = stripFound(run, uid, "lose")
				lostGear += g; lostCards += c
			end
		end
	end
	-- R3 (USER RULING 2026-11-16 2:30 AM): opened (partly used) Bag copies. Bought ones always come home with
	-- their charges left (rule 268); found ones follow the loot rule (kept on a full-loot exit, else lost and
	-- left in the lost list). Found copies are used first, so the emptiest opened copies count as found.
	if outcome and outcome.kept then
		outcome.kept.cards = outcome.kept.cards or {}
		for cid in table.clone(d.open) do
			local key = "consumables:" .. cid
			local list = openList(run, cid)
			local copies = (run.bag.cards or {})[key] or 0
			local marks = run.boughtKeep and run.boughtKeep.cards and run.boughtKeep.cards[key] or 0
			local found = copies - math.min(marks, copies)
			for i, ch in list do
				local isBought = i > found
				if isBought or keepCards then
					local side = if keepCards then outcome.kept else outcome.lost
					local q = side and side.cards and side.cards[key]
					if q and q > 0 then
						side.cards[key] = if q > 1 then q - 1 else nil -- this copy comes home here, not as a full copy
						if isBought then useMark(run, "card", key) end
						if placeOpened(run, cid, ch) then
							print(`[DungeonLoadout] Run end: opened {cid} ({ch} charges, {if isBought then "bought" else "found"}) comes home on a party unit`)
						else
							outcome.kept.cards[key] = (outcome.kept.cards[key] or 0) + 1 -- no free slot: a normal copy (default)
							print(`[DungeonLoadout] Run end: opened {cid} comes home as a normal copy (no free consumable slot)`)
						end
					end
				end
			end
		end
	end
	if lostGear + lostCards > 0 then print(`[DungeonLoadout] Run end: found items lost from units | gear {lostGear}, cards {lostCards}`) end
	run.dgLoad = nil
end

--------------------------------------------------
-- SAVE
--------------------------------------------------

function L.Export(run: any): any
	local d = run and run.dgLoad
	if type(d) ~= "table" then return nil end
	local hg = {}
	for id in d.home.gear do table.insert(hg, id) end
	table.sort(hg)
	local op = {}
	for cid in table.clone(d.open) do
		local list = openList(run, cid)
		if #list > 0 then op[cid] = table.clone(list) end
	end
	return { origin = table.clone(d.origin), homeGear = hg, homeCards = table.clone(d.home.cards), open = op, prevHome = table.clone(d.prevHome) }
end

local function strMap(t: any, maxK: number, check: (any) -> boolean): { [string]: any }
	local out = {}
	if type(t) ~= "table" then return out end
	local n = 0
	for k, v in t do
		if type(k) == "string" and #k <= maxK and check(v) then
			out[k] = v
			n += 1
			if n >= 500 then break end
		end
	end
	return out
end

function L.Import(run: any, s: any)
	run.dgLoad = nil
	if type(s) ~= "table" then return end -- old saves: nothing moved yet
	local function count(v: any): boolean return type(v) == "number" and v >= 1 and v <= 999 and v % 1 == 0 end
	local d = dl(run)
	d.origin = strMap(s.origin, 200, function(v) return v == "bag" end)
	for _, id in (if type(s.homeGear) == "table" then s.homeGear else {}) do
		if type(id) == "string" and #id <= 128 then d.home.gear[id] = true end
	end
	d.home.cards = strMap(s.homeCards, 80, count)
	d.open = {}
	if type(s.open) == "table" then
		local n = 0
		for k, v in s.open do
			if type(k) == "string" and #k <= 32 then
				local list: { number } = {}
				if count(v) then table.insert(list, v) -- old saves (one opened copy per item)
				elseif type(v) == "table" then
					for _, ch in v do if count(ch) and #list < 99 then table.insert(list, ch) end end
				end
				if #list > 0 then d.open[k] = list; n += 1 end
				if n >= 500 then break end
			end
		end
	end
	d.prevHome = strMap(s.prevHome, 200, function(v) return type(v) == "string" and #v <= 128 end)
end

return L

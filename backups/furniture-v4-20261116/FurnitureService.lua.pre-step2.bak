--!strict
-- FurnitureService.lua
-- CTRBLXAI | Guild Hall furniture, phase 1 (Slice 8 step 2, 2026-11-16).
--
-- Rules (docs\CTRBLXAI.db guild_facilities 91-97, approved text 98; USER RULING 2026-11-16 1:53 PM):
--   * The Guild Hall holds furniture. Bonus slots by Guild Hall level 2 -> 12; wall-decoration
--     slots (looks-only pieces only) at L5 / L8 / L10.
--   * Combat bonuses: total cap 6 points x Guild Hall level, family cap 30, same piece counts
--     once. Over cap: applied in slot order, the piece that does not fit is dropped ("capped").
--     Logistics pieces never count toward the caps. Never AP / movement / jump / RT / CT.
--   * Bonuses apply to the player's own units (quests + dungeon runs), never enemies.
--   * Furniture is changed freely at the base and locked during a battle or dungeon run.
--   * Phase 1 sources: the gold shop (each piece once). Step 3 (USER RULING 2026-11-16 3:40 PM):
--     crafting (Craft / CraftRows; Blacksmith, Runeforge, Apothecary), drops (GrantDrop: dungeon payout,
--     quest bosses 25% via RollBossPiece), Trophy Pedestal at Renown Rank 32 (GrantRankRewards).
--   * Old saves (made before this build) get Straw Cot + Scribe's Desk once, placed, plus a
--     one-time notice. The Guild Banner is free at Guild Hall L10.
--
-- OWNS: owned pieces, placed slots, the computed bonus, the notice flag.
-- MUST NOT OWN: gold (CurrencyService), Guild Hall level (GuildMenuService), Rank (RenownService),
-- unit stats (EquipmentService reads BonusFor). All injected via Init (ARC-004 / ARC-006).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local FurnitureData = require(ReplicatedStorage:WaitForChild("Content"):WaitForChild("FurnitureData"))

local FurnitureService = {}

local MAX_BONUS_SLOTS = 12
local MAX_DECOR_SLOTS = 3
local WELCOME_GIFT = table.freeze({ "FUR-01", "FUR-06" }) -- Straw Cot + Scribe's Desk (row 97)
local BANNER_ID = "FUR-22"
local PEDESTAL_ID = "FUR-21"
local PEDESTAL_RANK = 32 -- P4: the Trophy Hall's unlock Rank (interim until the Trophy Hall is designed)

-- Approved text (guild_facilities 98).
local TXT_DUP = "You already have this piece out."
local TXT_LOCKED_RUN = "You can't change furniture during a battle or dungeon run."

type Deps = {
	getGuildHallLevel: (() -> number)?,
	getRank: (() -> number)?,
	getGold: (() -> number)?,
	spendGold: ((number) -> (boolean, string?))?,
	canChangeNow: (() -> boolean)?,   -- at the base, no battle, no dungeon run
	canBuyNow: (() -> boolean)?,      -- at the base, no battle
	isPlayerUnit: ((any) -> boolean)?,
	rebuildAll: (() -> ())?,
	markDirty: (() -> ())?,
	getMaterials: (() -> { [string]: number })?,            -- step 3: mercury / crystals balance
	spendCost: (({ [string]: number }) -> (boolean, string?))?, -- step 3: gold + materials charged together
	isBuildingOpen: ((string) -> boolean)?,                -- step 3: the crafting building is open
}
local deps: Deps = {}

local owned: { [string]: boolean } = {}
local slots: { string? } = {}   -- bonus slots, index 1..MAX_BONUS_SLOTS (nil = empty)
local decor: { string? } = {}   -- wall-decoration slots, index 1..MAX_DECOR_SLOTS
local noticePending = false

-- Computed (recompute() after every change).
local bonus: { [string]: number } = {}
local slotStatus: { string } = {}   -- "ok" | "capped" | "invalid" per bonus slot
local pointsUsed = 0

local function ghLevel(): number
	local l = deps.getGuildHallLevel and deps.getGuildHallLevel() or 1
	return math.clamp(math.floor(tonumber(l) or 1), 1, 10)
end

local function rank(): number
	local r = deps.getRank and deps.getRank() or 1
	return math.max(1, math.floor(tonumber(r) or 1))
end

local function familyOf(p: FurnitureData.Piece): string?
	for k in p.effect do return k end
	return nil
end

local MULTIPLIER_KEYS: { [string]: boolean } = { rtDelayResist = true, collision = true }

-- Slot order, cap order (row 92). Pure: reads state, writes bonus / slotStatus / pointsUsed.
local function recompute()
	local gh = ghLevel()
	local nSlots = FurnitureData.SlotsFor(gh)
	local cap = FurnitureData.CapFor(gh)
	local out: { [string]: number } = {}
	local status: { string } = {}
	local fam: { [string]: number } = {}
	local seen: { [string]: boolean } = {}
	local used = 0
	for i = 1, nSlots do
		local id = slots[i]
		if id then
			local p = FurnitureData.Get(id)
			if not p or seen[id] or p.looksOnly or not owned[id] then
				status[i] = "invalid"
			else
				seen[id] = true
				local key = familyOf(p)
				local fits = true
				if p.points > 0 then
					if used + p.points > cap then fits = false end
					if key and (fam[key] or 0) + p.points > FurnitureData.FamilyCap then fits = false end
				end
				if fits then
					for k, v in p.effect do
						if MULTIPLIER_KEYS[k] then out[k] = (out[k] or 1) * v else out[k] = (out[k] or 0) + v end
					end
					if p.points > 0 then
						used += p.points
						if key then fam[key] = (fam[key] or 0) + p.points end
					end
					status[i] = "ok"
				else
					status[i] = "capped"
				end
			end
		end
	end
	bonus, slotStatus, pointsUsed = out, status, used
end

local function changed()
	recompute()
	if deps.markDirty then deps.markDirty() end
	if deps.rebuildAll then
		local ok, err = pcall(deps.rebuildAll)
		if not ok then warn("[FurnitureService] rebuild failed: " .. tostring(err)) end
	end
end

-- Guild Banner is free at Guild Hall L10 (row 94). Placed in the first free decoration slot.
local function ensureGrants(): (boolean, boolean)
	local any, pedestalNow = false, false
	-- P4 (step 3): Trophy Pedestal once at Renown Rank 32, placed in the first free decoration slot.
	if rank() >= PEDESTAL_RANK and not owned[PEDESTAL_ID] then
		owned[PEDESTAL_ID] = true
		any, pedestalNow = true, true
		for i = 1, FurnitureData.DecorSlots(ghLevel()) do
			if decor[i] == nil then decor[i] = PEDESTAL_ID break end
		end
		print("[FurnitureService] Trophy Pedestal granted (Renown Rank " .. PEDESTAL_RANK .. ")")
	end
	if ghLevel() >= 10 and not owned[BANNER_ID] then
		owned[BANNER_ID] = true
		any = true
		local n = FurnitureData.DecorSlots(ghLevel())
		for i = 1, n do
			if decor[i] == nil then decor[i] = BANNER_ID break end
		end
		print("[FurnitureService] Guild Banner granted (Guild Hall L10)")
	end
	return any, pedestalNow
end

function FurnitureService.Init(d: Deps)
	deps = d
	-- Saves already at Rank 32+ get the Trophy Pedestal right after load, quietly (no banner).
	-- Import runs before Init (no Rank yet), so the load-time grant happens here.
	if ensureGrants() and deps.markDirty then pcall(deps.markDirty) end
	recompute()
	-- Units built before Init (boot) had no furniture yet: rebuild them once (idempotent).
	if next(bonus) ~= nil and deps.rebuildAll then
		local ok, err = pcall(deps.rebuildAll)
		if not ok then warn("[FurnitureService] rebuild at Init failed: " .. tostring(err)) end
	end
	if pointsUsed > 0 or next(bonus) ~= nil then
		print(`[FurnitureService] Initialized | Guild Hall L{ghLevel()} | bonus points {pointsUsed}/{FurnitureData.CapFor(ghLevel())}`)
	end
end

--------------------------------------------------
-- READ
--------------------------------------------------

--- The furniture bonus for a unit (nil for anything that is not the player's own unit).
--- EquipmentService.RebuildUnitStats folds it in from scratch every rebuild (never stacks).
function FurnitureService.BonusFor(unit: any): { [string]: number }?
	if type(unit) ~= "table" or unit.side == "Enemy" then return nil end
	if not (deps.isPlayerUnit and deps.isPlayerUnit(unit)) then return nil end
	if next(bonus) == nil then return nil end
	return bonus
end

--- Gold change per dispatch mission (War Table Map, Logistics).
function FurnitureService.DispatchFeeDelta(): number
	return math.floor(bonus.dispatchFee or 0)
end

local function shopRows(): { any }
	local gh, r = ghLevel(), rank()
	local gold = deps.getGold and deps.getGold() or 0
	local rows = {}
	for _, p in FurnitureData.Pieces do
		if p.source == "Shop" and not p.notInShop and not owned[p.id] then
			local reason: string? = nil
			if p.needRank and r < p.needRank then
				reason = `Unlocks at Renown Rank {p.needRank}` -- approved rank text 5
			elseif p.needGuildHall and gh < p.needGuildHall then
				reason = `Also needs Guild Hall level {p.needGuildHall}` -- approved rank text 6
			elseif gold < (p.price or 0) then
				reason = `Not enough gold ({gold} / {p.price})` -- approved rank text 9
			end
			table.insert(rows, { id = p.id, price = p.price, canBuy = reason == nil, reason = reason })
		end
	end
	return rows
end

--- Everything the Furnish tab shows.
function FurnitureService.State(): any
	if ensureGrants() then changed() end
	local gh = ghLevel()
	local nSlots = FurnitureData.SlotsFor(gh)
	local nDecor = FurnitureData.DecorSlots(gh)
	local s, st, dc = {}, {}, {}
	for i = 1, nSlots do s[i] = slots[i] or false; st[i] = slotStatus[i] or "" end
	for i = 1, nDecor do dc[i] = decor[i] or false end
	local ownedList = {}
	for id in owned do table.insert(ownedList, id) end
	table.sort(ownedList)
	return {
		guildHallLevel = gh, slots = s, slotStatus = st, decor = dc,
		points = pointsUsed, cap = FurnitureData.CapFor(gh),
		owned = ownedList, shop = shopRows(),
		locked = not (deps.canChangeNow and deps.canChangeNow()),
		notice = noticePending,
	}
end

--------------------------------------------------
-- ACTIONS (SEC-001: the client sends ids / slot numbers only; the server checks + prices)
--------------------------------------------------

local function placedAnywhere(id: string): boolean
	for i = 1, MAX_BONUS_SLOTS do if slots[i] == id then return true end end
	for i = 1, MAX_DECOR_SLOTS do if decor[i] == id then return true end end
	return false
end

local function validSlot(n: any, max: number): number?
	if type(n) ~= "number" or n ~= n or n % 1 ~= 0 or n < 1 or n > max then return nil end
	return n
end

function FurnitureService.Buy(id: any): (boolean, string?)
	local p = FurnitureData.Get(id)
	if not p or p.source ~= "Shop" or p.notInShop or not p.price then return false, "Unknown piece" end
	if owned[p.id] then return false, "Already owned" end
	if not (deps.canBuyNow and deps.canBuyNow()) then return false, TXT_LOCKED_RUN end
	if p.needRank and rank() < p.needRank then return false, `Unlocks at Renown Rank {p.needRank}` end
	if p.needGuildHall and ghLevel() < p.needGuildHall then return false, `Also needs Guild Hall level {p.needGuildHall}` end
	local gold = deps.getGold and deps.getGold() or 0
	if gold < p.price then return false, `Not enough gold ({gold} / {p.price})` end
	if not deps.spendGold then return false, "Gold unavailable" end
	local okPay, why = deps.spendGold(p.price)
	if not okPay then return false, tostring(why or "Not enough gold") end
	owned[p.id] = true
	-- Default (listed): a bought piece goes into the first free bonus slot when changes are allowed.
	if deps.canChangeNow and deps.canChangeNow() then
		for i = 1, FurnitureData.SlotsFor(ghLevel()) do
			if slots[i] == nil then slots[i] = p.id break end
		end
	end
	print(`[FurnitureService] Bought {p.id} {p.name} for {p.price} gold`)
	changed()
	return true, nil
end

--- Put an owned piece into a slot (decor = wall-decoration slot). Replaces what was there.
function FurnitureService.Place(id: any, slot: any, isDecor: any): (boolean, string?)
	if not (deps.canChangeNow and deps.canChangeNow()) then return false, TXT_LOCKED_RUN end
	local p = FurnitureData.Get(id)
	if not p or not owned[p.id] then return false, "Unknown piece" end
	local gh = ghLevel()
	local decorSlot = isDecor == true
	local n = validSlot(slot, if decorSlot then FurnitureData.DecorSlots(gh) else FurnitureData.SlotsFor(gh))
	if not n then return false, "Unknown slot" end
	if decorSlot ~= (p.looksOnly == true) then return false, "Unknown slot" end
	if placedAnywhere(p.id) then return false, TXT_DUP end
	if decorSlot then decor[n] = p.id else slots[n] = p.id end
	changed()
	return true, nil
end

function FurnitureService.Remove(slot: any, isDecor: any): (boolean, string?)
	if not (deps.canChangeNow and deps.canChangeNow()) then return false, TXT_LOCKED_RUN end
	local decorSlot = isDecor == true
	local n = validSlot(slot, if decorSlot then MAX_DECOR_SLOTS else MAX_BONUS_SLOTS)
	if not n then return false, "Unknown slot" end
	if decorSlot then decor[n] = nil else slots[n] = nil end
	changed()
	return true, nil
end

--------------------------------------------------
-- STEP 3: CRAFTING, DROPS, RANK REWARDS (USER RULING 2026-11-16 3:40 PM)
--------------------------------------------------

local function matName(k: string, n: number): string
	if k == "mercury" then return "Mercury" end
	if k == "crystals" then return if n == 1 then "Crystal" else "Crystals" end
	return k
end

-- Default (row 99 default 1): a new piece goes into the first free bonus slot when changes are allowed.
local function placeFirstFree(id: string)
	if not (deps.canChangeNow and deps.canChangeNow()) then return end
	for i = 1, FurnitureData.SlotsFor(ghLevel()) do
		if slots[i] == nil then slots[i] = id break end
	end
end

function FurnitureService.Owns(id: any): boolean
	return type(id) == "string" and owned[id] == true
end

--- A dropped piece (dungeon payout / quest boss). Each piece once. Returns true when newly owned.
function FurnitureService.GrantDrop(id: any, why: string?): boolean
	local p = FurnitureData.Get(id)
	if not p or owned[p.id] then return false end
	owned[p.id] = true
	if not p.looksOnly then placeFirstFree(p.id) end
	print(`[FurnitureService] Drop granted | {p.id} {p.name} | {tostring(why)}`)
	changed()
	return true
end

--- Quest boss (P3, user ruling: 25%): roll once on a rewarded boss win; an unowned Boss piece is
--- granted at once. Returns the piece name or nil. (Dungeon bosses use DungeonFurniture.BossDrop, 10%.)
function FurnitureService.RollBossPiece(chance: number): string?
	if type(chance) ~= "number" or math.random() >= chance then return nil end
	local pool: { string } = {}
	for _, p in FurnitureData.Pieces do
		if p.source == "BossDrop" and not owned[p.id] then table.insert(pool, p.id) end
	end
	if #pool == 0 then return nil end
	local id = pool[math.random(1, #pool)]
	if not FurnitureService.GrantDrop(id, "quest boss") then return nil end
	local p = FurnitureData.Get(id)
	return p and p.name or id
end

--- Rank-up hook (Main): the Trophy Pedestal at Rank 32, once. True when it was granted just now.
function FurnitureService.GrantRankRewards(): boolean
	local any, pedestalNow = ensureGrants()
	if any then changed() end
	return pedestalNow
end

local function craftReason(p: FurnitureData.Piece): string?
	if owned[p.id] then return "Already owned" end
	if not (deps.canChangeNow and deps.canChangeNow()) then return TXT_LOCKED_RUN end -- row shows why Craft is off
	local gold = deps.getGold and deps.getGold() or 0
	if gold < (p.price or 0) then return `Not enough gold ({gold} / {p.price})` end
	local have = deps.getMaterials and deps.getMaterials() or {}
	for k, need in (p.mats or {}) do
		local h = tonumber(have[k]) or 0
		if h < need then return `Not enough {matName(k, need)} ({h} / {need})` end -- approved step 3 line 3
	end
	return nil
end

--- The building's Furniture row (Blacksmith / Runeforge / Apothecary).
function FurnitureService.CraftRows(building: any): { any }
	local rows = {}
	if type(building) ~= "string" then return rows end
	for _, p in FurnitureData.Pieces do
		if p.source == "Crafted" and p.craftAt == building then
			local mk, mn = next(p.mats or {})
			local reason = craftReason(p)
			table.insert(rows, { id = p.id, name = p.name, text = p.text, price = p.price,
				matName = if mk then matName(mk, mn :: number) else nil, matN = mn,
				owned = owned[p.id] == true, canCraft = reason == nil, reason = reason })
		end
	end
	return rows
end

--- Craft a piece at its building: gold + materials charged together (CurrencyService.Debit is atomic).
function FurnitureService.Craft(id: any, building: any): (boolean, string?)
	local p = FurnitureData.Get(id)
	if not p or p.source ~= "Crafted" or type(building) ~= "string" or p.craftAt ~= building then return false, "Unknown piece" end
	if not (deps.isBuildingOpen and deps.isBuildingOpen(building)) then return false, "Unknown piece" end
	if not (deps.canChangeNow and deps.canChangeNow()) then return false, TXT_LOCKED_RUN end
	local why = craftReason(p)
	if why then return false, why end
	if not deps.spendCost then return false, "Gold unavailable" end
	local cost: { [string]: number } = { gold = p.price or 0 }
	for k, v in (p.mats or {}) do cost[k] = v end
	local okPay, err = deps.spendCost(cost)
	if not okPay then return false, tostring(err or "Not enough gold") end
	owned[p.id] = true
	placeFirstFree(p.id)
	print(`[FurnitureService] Crafted {p.id} {p.name} at {building} | {p.price} gold`)
	changed()
	return true, `{p.name} crafted! It's in your Guild Hall.` -- approved step 3 line 4
end

function FurnitureService.ClearNotice()
	if noticePending then
		noticePending = false
		if deps.markDirty then deps.markDirty() end
	end
end

--- Guild Hall level changed (upgrade or dev tool): slot count + cap change the bonus.
function FurnitureService.OnGuildHallChanged()
	ensureGrants()
	changed()
end

--------------------------------------------------
-- SAVE (rides GuildMenuService's payload)
--------------------------------------------------

function FurnitureService.Export(): any
	local o = {}
	for id in owned do table.insert(o, id) end
	table.sort(o)
	local s, d = {}, {}
	for i = 1, MAX_BONUS_SLOTS do s[i] = slots[i] or "" end
	for i = 1, MAX_DECOR_SLOTS do d[i] = decor[i] or "" end
	return { owned = o, slots = s, decor = d, notice = noticePending }
end

--- data = saved table (nil on saves from before this build). saveExisted = the guild save
--- existed: an old save then gets the welcome gift + notice once (row 97). Brand-new players
--- never reach Import (GuildMenuService.Import returns early with no data).
function FurnitureService.Import(data: any, saveExisted: boolean?)
	owned, slots, decor, noticePending = {}, {}, {}, false
	if type(data) == "table" then
		for _, id in (type(data.owned) == "table" and data.owned or {}) do
			if FurnitureData.Get(id) then owned[id] = true end
		end
		local seen: { [string]: boolean } = {}
		if type(data.slots) == "table" then
			for i = 1, MAX_BONUS_SLOTS do
				local id = data.slots[i]
				local p = FurnitureData.Get(id)
				if p and owned[p.id] and not p.looksOnly and not seen[p.id] then slots[i] = p.id; seen[p.id] = true end
			end
		end
		if type(data.decor) == "table" then
			for i = 1, MAX_DECOR_SLOTS do
				local id = data.decor[i]
				local p = FurnitureData.Get(id)
				if p and owned[p.id] and p.looksOnly and not seen[p.id] then decor[i] = p.id; seen[p.id] = true end
			end
		end
		noticePending = data.notice == true
	elseif saveExisted then
		for i, id in WELCOME_GIFT do
			owned[id] = true
			slots[i] = id
		end
		noticePending = true
		print("[FurnitureService] Old save: welcome gift Straw Cot + Scribe's Desk placed, notice pending")
	end
	recompute()
end

-- Dev only (Main DevDungeon op "furn", memory-mode saves only): give or take a piece for live tests.
function FurnitureService.DevSetOwned(id: any, own: boolean): boolean
	local p = FurnitureData.Get(id)
	if not p then return false end
	if own then owned[p.id] = true else
		owned[p.id] = nil
		for i, v in pairs(slots) do if v == p.id then slots[i] = nil end end
		for i, v in pairs(decor) do if v == p.id then decor[i] = nil end end -- W1: wall decorations too
	end
	changed()
	return true
end

return FurnitureService

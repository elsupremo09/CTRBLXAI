--!strict
-- DungeonRelics.lua
-- CTRBLXAI | Dungeon relics (build step 8, 2026-11-14; project_rules 271/275). Split out of
-- DungeonService to keep it under 1000 lines. Server-only. No require of DungeonService (no cycle):
-- DungeonService calls DungeonRelics.Bind(ctx) with stateOf / persist.

local DungeonRules = require(script.Parent:WaitForChild("DungeonRules"))

local R = {}
local C: any = nil
function R.Bind(ctx: any) C = ctx end

--------------------------------------------------
-- RELICS (Dungeon build step 8; project_rules 271). Seeded per room (run seed + room id + source), one
-- roll per room (relicRolled, saved), so a rejoin can't re-roll. Run-only: gone when the run ends.
--------------------------------------------------

local function relicSeed(run: any, roomId: string, source: string): number
	local h = 0
	for i = 1, #roomId do h = (h * 31 + string.byte(roomId, i)) % 1000003 end
	return ((run.sseed or run.card.seed) * 17 + h * 101 + string.byte(source, 1) * 7 + 401) % 2147483647
end

local function heldSet(run: any): { [string]: boolean }
	local s: { [string]: boolean } = {}
	for _, id in run.relics do s[id] = true end
	return s
end

--- Random curse for a Major relic (relics v2, rule 271): 20% seeded, from the curse pool, not held, never
--- for a relic with a fixed pair (War Banner). Returns a curse id or nil.
local function rollCurse(run: any, id: string?, seed: number, exclude: string?): string?
	local d = id and DungeonRules.RelicDef(id)
	if not d or d.kind ~= "Major" or DungeonRules.Data.RelicCursePairs[id :: string] then return nil end
	local rng = Random.new(seed % 2147483647)
	if rng:NextNumber() * 100 >= DungeonRules.Data.RelicCurseChancePct then return nil end
	local pool = {}
	for _, cid in DungeonRules.Data.RelicCursePool do
		if not table.find(run.relics, cid) and cid ~= exclude then table.insert(pool, cid) end
	end
	return if #pool > 0 then pool[rng:NextInteger(1, #pool)] else nil
end
R.RollCurse = rollCurse

--- Roll (once) and grant the room's relic. source = "T" | "E" | "B" | "V". Returns the relic id or nil.
--- A Major that rolls a curse is NOT given yet: run.curseOffer waits for Take both / Leave both.
function R.Grant(run: any, roomId: string, source: string): string?
	if run.relicRolled[roomId] then return nil end
	run.relicRolled[roomId] = true
	local seed = relicSeed(run, roomId, source)
	local id = DungeonRules.RollRelic(seed, source, run.card.facilityLevel, heldSet(run), nil,
		{ partySize = #(run.party or {}) }) -- Fog mutator retired 2026-11-15; War Banner needs 8+ (relics v2)
	if not id then return nil end
	local curse = rollCurse(run, id, seed + 104729)
	if curse then
		run.curseOffer = { id = id, curse = curse }
		print(`[DungeonRelics] Cursed relic offered | {id} + {curse}`)
		return id
	end
	R.Give(run, id, source == "B")
	return id
end

--- Answer the cursed-relic popup: take = true gives both, false leaves both. Idempotent.
function R.AnswerCurse(playerId: string, take: any): (boolean, any)
	local run = C.stateOf(playerId).run
	local o = run and run.curseOffer
	if not o then return false, "No relic to take" end
	run.curseOffer = nil
	if take == true then
		R.Give(run, o.id, false, o.curse)
		run.relicFound = nil -- the curse popup already showed it
	else
		print(`[DungeonRelics] Cursed relic left | {o.id} + {o.curse}`)
	end
	C.persist()
	return true, { took = take == true }
end

--- Add a held relic (+ its curse pair) and queue the "Relic found" popup. extraCurse = a random curse taken with it.
function R.Give(run: any, id: string, boss: boolean, extraCurse: string?)
	do
		table.insert(run.relics, id)
		-- Curse pair (rule 271): a Major relic with a curse brings it too (taking the relic = taking both).
		local curse = DungeonRules.Data.RelicCursePairs[id] or extraCurse
		if curse and not table.find(run.relics, curse) then table.insert(run.relics, curse) end
		run.relicFound = { id = id, boss = boss, curse = curse }
		print(`[DungeonRelics] Relic found | {id} | boss {boss} | {#run.relics} held`)
	end
end

--------------------------------------------------
-- BOSS PICK (rule 271, user ruling 2026-11-15 12:21 PM): at each Boss the player picks 1 of 2:
-- a Boss relic or a normal relic. Rolled once when the party enters the boss room (seeded, saved).
-- Until Boss-type relics (kind "Boss") are built, the Boss option comes from the current Boss pool
-- (src "B"); the normal option is a different relic from the same table.
--------------------------------------------------
local function hasBossKind(): boolean
	for _, rl in DungeonRules.Data.Relics do if rl.kind == "Boss" then return true end end
	return false
end

function R.RollBossPick(run: any)
	if run.bossPick or run.relicRolled["boss"] then return end
	local held = heldSet(run)
	local seed = relicSeed(run, "boss", "B")
	local ps = #(run.party or {})
	local a = DungeonRules.RollRelic(seed, "B", run.card.facilityLevel, held, nil,
		{ partySize = ps, kind = if hasBossKind() then "Boss" else nil })
	local ex = {}
	if a then ex[a] = true end
	-- Option b: a normal relic with the Boss 25% chance of +1 rarity (rule 271; auto-accepted 12:38 PM).
	local b = DungeonRules.RollRelic(seed + 7919, "T", run.card.facilityLevel, held, nil, { partySize = ps, exclude = ex, noChance = true, tierBump = true })
	if not a and not b then run.relicRolled["boss"] = true return end
	-- A Major option b may carry a random curse; it's shown on the pick screen, picking it takes both.
	run.bossPick = { a = a, b = b, cb = rollCurse(run, b, seed + 15485863) }
end

--- Player picks option "a" (Boss relic) or "b" (normal relic). Idempotent.
function R.PickBossRelic(playerId: string, which: any): (boolean, any)
	local run = C.stateOf(playerId).run
	if not run or run.at ~= "boss" then return false, "No Boss relic to pick" end
	local p = run.bossPick
	if not p then return false, "No Boss relic to pick" end
	local id = if which == "a" then p.a elseif which == "b" then p.b else nil
	if not id then return false, "Invalid request" end
	run.bossPick = nil
	run.relicRolled["boss"] = true
	R.Give(run, id, true, if which == "b" then p.cb else nil)
	run.relicFound = nil -- the pick screen already showed it
	C.persist()
	return true, { id = id }
end

function R.HasRelic(playerId: string, relicId: string): boolean
	local run = C.stateOf(playerId).run
	if not run then return false end
	for _, id in run.relics do if id == relicId then return run.relicUsed[id] ~= true end end
	return false
end

--- Held, unused relic ids for the active run ({} when no run).
function R.GetRelics(playerId: string): { string }
	local run = C.stateOf(playerId).run
	local out: { string } = {}
	if not run then return out end
	for _, id in run.relics do if not run.relicUsed[id] then table.insert(out, id) end end
	return out
end

--- Spend a once-per-run relic (RL-09 Second Wind).
function R.MarkRelicUsed(playerId: string, relicId: string): boolean
	local run = C.stateOf(playerId).run
	if not run or not R.HasRelic(playerId, relicId) then return false end
	run.relicUsed[relicId] = true
	C.persist()
	return true
end

--- Boss relic: given when the boss battle STARTS (user confirmed 2026-11-14 10:32 AM). Idempotent.
function R.GrantBossRelic(playerId: string): string?
	local run = C.stateOf(playerId).run
	if not run or run.at ~= "boss" or run.cleared.boss then return nil end
	-- Boss pick not answered (e.g. old client / fight launched first): give option a (Boss relic).
	if not run.bossPick and not run.relicRolled["boss"] then R.RollBossPick(run) end
	local p = run.bossPick
	if not p then return nil end
	run.bossPick = nil
	run.relicRolled["boss"] = true
	local id = p.a or p.b
	if id then R.Give(run, id, true, if p.a then nil else p.cb) end
	C.persist()
	return id
end

--- Event relic (good outcome only, R x0.5). Called by DungeonRooms after a choice. Gambler's Table
--- (EV-08) never gives a relic (rule 271).
function R.GrantEventRelic(playerId: string, eventId: string): string?
	local run = C.stateOf(playerId).run
	if not run or not run.at or eventId == "EV-08" then return nil end
	return R.Grant(run, run.at, "V")
end

--- Dev test hook only (Main DevDungeon op "relic", DevAccess-gated): add a held relic.
function R.DevGiveRelic(playerId: string, relicId: string): boolean
	local run = C.stateOf(playerId).run
	if not run or not DungeonRules.RelicDef(relicId) or table.find(run.relics, relicId) then return false end
	table.insert(run.relics, relicId)
	local curse = DungeonRules.Data.RelicCursePairs[relicId]
	if curse and not table.find(run.relics, curse) then table.insert(run.relics, curse) end
	C.persist()
	return true
end

--- The client read the "Relic found" popup: clear it.
function R.AckRelic(playerId: string)
	local run = C.stateOf(playerId).run
	if run and run.relicFound then run.relicFound = nil; C.persist() end
end

return table.freeze(R)

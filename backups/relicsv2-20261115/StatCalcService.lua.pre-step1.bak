--!strict
-- StatCalcService.lua
-- CTRBLXAI | One shared calculation per unit stat (server-only). Built 2026-10-28.
--
-- WHY: the Info panels (Loadout Info tab, in-battle unit inspector) showed only the BASE
-- stat block (derivedStats, built from primary stats), while battle code in other files
-- added gear / race / trait / doctrine / weapon / status bonuses on top. Panels and battle
-- disagreed (e.g. Traveler Boots +2 Move never shown). Each stat below is computed in ONE
-- function; battle code and both panels call it, so they cannot drift apart again.
--
-- Modes:
--   "battle"    exactly what the battle uses right now, including situational armor bonuses
--               (FT-011 first Move +3, FT-012 second Move +2). Used by battle code only.
--   "current"   in-battle inspector: permanent values + active buffs/debuffs and active
--               battle states. Situational armor bonuses are left out.
--   "permanent" Loadout screen: base + gear + race + traits + doctrine + weapon. No statuses
--               or temporary states (a hub unit may still carry stale statuses or per-turn
--               fields from its last battle; this mode never reads them).
--
-- derivedStats stays the base block (plus the always-on gear folds EquipmentService does).
-- BuildDisplay returns a COPY for the panels and never mutates the unit.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConstants = require(ReplicatedStorage:WaitForChild("CTRBLXAI"):WaitForChild("Shared"):WaitForChild("GameConstants"))
local StatusService = require(script.Parent.StatusService)
local TraitEffectService = require(script.Parent.TraitEffectService)
local RacePassiveService = require(script.Parent.RacePassiveService)
local ArmorPassiveService = require(script.Parent.ArmorPassiveService)
local WeaponPassiveService = require(script.Parent.WeaponPassiveService)
local DoctrinePassiveService = require(script.Parent.DoctrinePassiveService)

local StatCalcService = {}

local BASE_MOVEMENT_RANGE = 3

local function derivedOf(unit: any): any
	return (unit and unit.derivedStats) or {}
end

local function statOf(unit: any, key: string): number
	local s = unit and unit.effectiveStats
	return (s and s[key]) or 10
end

local function round1(x: number): number
	return math.round(x * 10) / 10
end

local function round3(x: number): number
	return math.round(x * 1000) / 1000
end

-- Movement Range. Returns the total and the parts (for the battle log breakdown).
function StatCalcService.GetMovementRangeParts(unit: any, mode: string): (number, any)
	local d = derivedOf(unit)
	local parts = {
		base = d.movementRange or (BASE_MOVEMENT_RANGE + math.floor(statOf(unit, "AGI") / 60)),
		race = RacePassiveService.GetMovementRangeModifier(unit),
		armor = ArmorPassiveService.GetMovementRangeBonus(unit, mode ~= "battle"),
		trait = TraitEffectService.GetMovementRangeModifier(unit),
		status = 0,
		imposed = 0,
	}
	if mode ~= "permanent" then
		parts.status = StatusService.GetMovementRangeModifier(unit)
		parts.imposed = ArmorPassiveService.GetImposedMoveRangePenalty(unit)
			+ DoctrinePassiveService.GetMovementReduction(unit) -- Gunner Suppressive Fire -1 (2026-10-28)
			+ ((unit._amphibiousDry == true) and -1 or 0)  -- Amphibious tag: began turn off water (2026-10-29)
			+ (tonumber(unit._dgMoveBonus) or 0)  -- Dungeon RL-20 Seven-League Boots, battle-only (2026-11-15)
	end
	local total = math.max(1, parts.base + parts.race + parts.armor + parts.trait + parts.status + parts.imposed)
	return total, parts
end

function StatCalcService.GetMovementRange(unit: any, mode: string): number
	local total = StatCalcService.GetMovementRangeParts(unit, mode)
	return total
end

function StatCalcService.GetJump(unit: any, mode: string): number
	local d = derivedOf(unit)
	local total = (d.jump or (1 + math.floor(statOf(unit, "DEX") / 60)))
		+ RacePassiveService.GetJumpModifier(unit)
		+ ArmorPassiveService.GetJumpBonus(unit)
		+ TraitEffectService.GetJumpModifier(unit)
	if mode ~= "permanent" then
		total += StatusService.GetJumpModifier(unit)
	end
	return total
end

-- Effective Stability (resists push). Battle: DisplacementService.ResolvePush and the push
-- preview. Base = VIT + traits + PAS-014 (folded into derivedStats by EquipmentService).
-- ignoreGuard (2026-10-29): GL-012 Crushing Vambraces push ignores Guard-based defences.
function StatCalcService.GetStability(unit: any, mode: string, ignoreGuard: any): number
	local s = derivedOf(unit).stability
	if s == nil then
		s = math.floor(statOf(unit, "VIT") / 60)
	end
	if mode == "permanent" then
		return s
	end
	-- Status Stability buffs (Hold the Line +2, War Cry +1, device auras).
	s = math.max(0, s + StatusService.GetStabilityModifier(unit))
	-- BD-004 Anchor Mail: Stability +3 while Guarding.
	if not ignoreGuard and StatusService.HasStatus(unit, "Guard") then
		s += ArmorPassiveService.GetGuardStabilityBonus(unit)
	end
	-- FT-003 Heavy March Boots: +1 per tile moved, until the wearer's next turn.
	s += ArmorPassiveService.GetMarchStabilityBonus(unit)
	-- Vanguard Bulwark: Stability +1 while a standing ally is within range 2 (2026-10-28).
	s += DoctrinePassiveService.GetStabilityModifier(unit, StatusService.GetAuraUnits())
	return s
end

-- Force as shown on the panels (the stat tooltip defines Force as push strength): base
-- (STR + traits + PAS-013) + the always-on Push Force gloves (GL-001 +1, GL-002 +3).
-- Situational glove bonuses (ally / object targets) are never included; GL-018's per-tile
-- bonus only counts in "current" mode. Battle push and knockback assemble their own force
-- per action from derivedStats.force + GetPushForceBonus(context).
function StatCalcService.GetForce(unit: any, mode: string): number
	local f = derivedOf(unit).force or (1 + math.floor(statOf(unit, "STR") / 60))
	return f + ArmorPassiveService.GetPushForceBonus(unit, { permanentOnly = (mode == "permanent") })
end

-- Precision, in percent (same units as derivedStats.precision). Battle: CombatResolver
-- calcHitQuality = CalcPrecision(DEX) + trait + gear, Blind x0.50.
function StatCalcService.GetPrecision(unit: any, mode: string): number
	local p = (derivedOf(unit).precision or 0) + TraitEffectService.GetPrecisionModifier(unit) * 100
	if mode ~= "permanent" and StatusService.HasStatus(unit, "Blind") then
		p *= 0.5
	end
	return round1(p)
end

-- Evasiveness, in percent. Battle: CalcEvasiveness(AGI) + trait + gear + weapon Evasion,
-- plus the FT-009 Retreat window and Evasion Surge while active.
function StatCalcService.GetEvasiveness(unit: any, mode: string): number
	local trait = TraitEffectService.GetEvasivenessModifier(unit)
	if mode == "permanent" then
		-- Dodger / Sitting Duck per-move evasion only lasts until the next turn.
		trait -= (unit and unit._traitMoveEvasion) or 0
	end
	local e = (derivedOf(unit).evasiveness or 0) + trait * 100 + WeaponPassiveService.GetEvasivenessBonus(unit) * 100
		+ DoctrinePassiveService.GetEvasivenessModifier(unit) * 100 -- Duelist +10% (2026-10-28)
	if mode ~= "permanent" then
		e += ArmorPassiveService.GetRetreatEvasivenessBonus(unit) * 100
		if ((unit and unit._evasionSurgeStacks) or 0) > 0 then
			e += 30
		end
	end
	return round1(e)
end

-- Skill Potency as a multiplier (1.0 = baseline). Battle: INT potency (+gear) x doctrine x
-- (1 + trait) x weapon SkillPotency. Element-tag race boosts (Holy/Dark skills) are per-skill
-- and not included.
function StatCalcService.GetSkillPotency(unit: any, mode: string): number
	local sp = (derivedOf(unit).skillPotency or 1)
		* DoctrinePassiveService.GetSkillPotencyModifier(unit)
		* (1 + TraitEffectService.GetSkillPotencyModifier(unit))
		* WeaponPassiveService.GetSkillDamageMultiplier(unit)
	return round3(sp)
end

-- Heal Efficiency (healing RECEIVED), multiplier. Battle: CalcHealEfficiency(VIT) x trait
-- healing-received; anti-heal debuffs (Festering Wound) apply on top while active.
function StatCalcService.GetHealEfficiency(unit: any, mode: string): number
	-- GetHealingReceivedMult now includes the healing-received traits (2026-10-29); permanent mode
	-- shows the trait only.
	local h = (derivedOf(unit).healEfficiency or 1)
	if mode ~= "permanent" then
		h *= StatusService.GetHealingReceivedMult(unit)
	else
		h *= TraitEffectService.GetHealingReceivedModifier(unit)
	end
	return round3(h)
end

-- Channel Speed, as percent reduction of channel time. Battle: CalcChannelTime(base, DEX)
-- x trait channel multiplier. Negative = channels take longer than base.
function StatCalcService.GetChannelReduction(unit: any, mode: string): number
	local base = (derivedOf(unit).channelReduction or 0) / 100
	local mult = (1 - base) * TraitEffectService.GetChannelTimeMultiplier(unit)
	return round1((1 - mult) * 100)
end

-- Modified Base RT. Battle: StatusService.GetModifiedBaseRt (own base + armor WT, x status
-- RT multipliers, x trait base-RT). Permanent leaves out the status multipliers.
function StatCalcService.GetBaseRt(unit: any, mode: string): number
	return StatusService.GetModifiedBaseRt(unit, mode == "permanent")
end

-- Basic Attack RT (moved here from CommandService.calcBasicAttackBaseRt, which now calls it).
-- DB: round(Modified Base RT x 0.10) + Effective Weapon WT. Traits: Basics / Heavy Basics
-- scale the weapon-WT part; Dual Strike x2 on the total. Temporary: Frenzy scales the base-RT
-- part only (developer decision 2026-09-26); Frozen x2 on everything.
function StatCalcService.GetBasicAttackRt(unit: any, mode: string): number
	local permanent = (mode == "permanent")
	local modBaseRt = StatusService.GetModifiedBaseRt(unit, permanent)
	local effectiveWt = GameConstants.CalcEffectiveWt(unit.weaponWt or 0, statOf(unit, "STR"))
	-- Dual wield (DB project_rules 64): ONE shared base component + the effective reduced WT of
	-- BOTH weapons. (Break is synced into dualWieldActive at turn start / rebuild.) 2026-10-28.
	if unit.dualWieldActive and unit.offWeapon then
		effectiveWt += GameConstants.CalcEffectiveWt(unit.offWeapon.wt or 0, statOf(unit, "STR"))
	end
	local wtMult = TraitEffectService.GetBasicAttackWtMultiplier(unit)
	if wtMult ~= 1 and effectiveWt > 0 then
		effectiveWt *= wtMult
	end
	local baseComponent = math.round(modBaseRt * GameConstants.BASIC_ATTACK_RT_FACTOR)
	if not permanent then
		local frenzyDef = GameConstants.STATUSES.Frenzy
		if frenzyDef and frenzyDef.basicAttackRtMult and StatusService.HasStatus(unit, "Frenzy") then
			baseComponent = baseComponent * frenzyDef.basicAttackRtMult
		end
	end
	local rt = math.round(baseComponent) + math.round(effectiveWt)
	rt = math.round(rt * TraitEffectService.GetBasicAttackRtMultiplier(unit))
	-- Duelist Single-Weapon Mastery: Basic Attack RT -15% (equipment-based, both modes). 2026-10-28.
	rt = math.round(rt * DoctrinePassiveService.GetBasicAttackRtModifier(unit))
	if not permanent then
		rt = math.round(rt * StatusService.GetAllRtMultiplier(unit))
	end
	return rt
end

-- Starting RT (one-time, at initial deployment). DB core_stats id 54: round(Modified Base RT
-- x (1 - 0.30 x LUK / (100 + LUK)) x trait Starting-RT %) once, then the Player Initiative
-- Edge last, for player-roster units only. Main (players) and EnemyGenerator call this.
function StatCalcService.GetStartingRt(unit: any, mode: string): number
	local modBaseRt = StatusService.GetModifiedBaseRt(unit, mode == "permanent")
	local luk = statOf(unit, "LUK")
	local lukFactor = 1 - 0.30 * luk / (100 + luk)
	local rt = math.round(modBaseRt * lukFactor * TraitEffectService.GetStartingRtMultiplier(unit))
	if unit.side == "Player" and unit.controller == "Player" then
		rt = GameConstants.ApplyPlayerInitiativeEdge(rt)
	end
	return rt
end

local function buildDisplay(unit: any, mode: string): any
	local out = table.clone(unit.derivedStats)
	out.movementRange = StatCalcService.GetMovementRange(unit, mode)
	out.jump = StatCalcService.GetJump(unit, mode)
	out.force = StatCalcService.GetForce(unit, mode)
	out.stability = StatCalcService.GetStability(unit, mode)
	out.precision = StatCalcService.GetPrecision(unit, mode)
	out.evasiveness = StatCalcService.GetEvasiveness(unit, mode)
	out.skillPotency = StatCalcService.GetSkillPotency(unit, mode)
	out.healEfficiency = StatCalcService.GetHealEfficiency(unit, mode)
	out.channelReduction = StatCalcService.GetChannelReduction(unit, mode)
	out.baseRt = StatCalcService.GetBaseRt(unit, mode)
	out.basicAttackRt = StatCalcService.GetBasicAttackRt(unit, mode)
	out.startingRt = StatCalcService.GetStartingRt(unit, mode)
	if mode ~= "permanent" then
		-- Res Up / Res Down statuses and the Ward Totem aura (same function the battle uses).
		out.debuffResist = round3(StatusService.GetDebuffResist(unit))
	end
	-- Max HP / MP live on the unit (they include armor HP/MP and Hardy / Frail traits).
	if unit.maxHp then
		out.maxHp = unit.maxHp
	end
	if unit.maxMp then
		out.maxMp = unit.maxMp
	end
	return out
end

-- Panel copy of derivedStats with every displayed value from the functions above.
-- mode: "current" (in-battle inspector) or "permanent" (Loadout). Never mutates the unit.
-- A unit the getters cannot handle falls back to its raw derivedStats (never breaks a payload).
function StatCalcService.BuildDisplay(unit: any, mode: string): any
	if not (unit and type(unit.derivedStats) == "table") then
		return unit and unit.derivedStats
	end
	local ok, result = pcall(buildDisplay, unit, mode)
	if ok then
		return result
	end
	warn(`[StatCalcService] BuildDisplay failed for {tostring(unit.name)}: {tostring(result)}`)
	return unit.derivedStats
end

return StatCalcService

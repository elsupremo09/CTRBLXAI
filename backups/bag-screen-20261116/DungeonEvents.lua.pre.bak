--!strict
-- DungeonEvents.lua
-- CTRBLXAI | Dungeon Event rooms (Dungeon build step 7a, 2026-11-14; project_rules 258 / 272).
-- Server-only (ARC-001/003). Pure-ish: picks the event for a room (seeded, no repeats in a run,
-- weighted by the facility good/bad odds; mixed counts as Good) and resolves a choice into an
-- effect list that DungeonService applies. All numbers live in DungeonRules.Data.Ev (DAT-001).
-- Seeded results (Gambler's Table, Sealed Door, the event pick) use run seed + room position, so
-- quitting and rejoining can never change them (project_rules 272).

local DungeonRules = require(script.Parent:WaitForChild("DungeonRules"))
local D = DungeonRules.Data
local E = D.Ev

local DungeonEvents = {}

local function seedOf(runSeed: number, row: number, col: number, salt: number): number
	return (math.floor(runSeed) * 197 + row * 6007 + col * 911 + salt * 53 + 29) % 2147483647
end

--- Event id for a room. `seen` = ids already played this run (carries across stages, rule 277). No
--- repeats until every event was seen. `hasKin` = the party has a race/doctrine for EV-11 (nil = true).
function DungeonEvents.Pick(runSeed: number, row: number, col: number, facilityLevel: number, seen: { [string]: boolean }, hasKin: boolean?): string
	local rng = Random.new(seedOf(runSeed, row, col, 1))
	local goodPct = DungeonRules.Level(facilityLevel).eventGoodPct
	local wantGood = rng:NextNumber() * 100 < goodPct
	local all, fresh, freshAny = {}, {}, {}
	for _, ev in D.Events do
		if ev.needsKin and hasKin == false then continue end -- EV-11 only with kin in the party
		table.insert(all, ev)
		if not seen[ev.id] then
			table.insert(freshAny, ev)
			if ev.good == wantGood then table.insert(fresh, ev) end
		end
	end
	local pool = if #fresh > 0 then fresh elseif #freshAny > 0 then freshAny else all
	return pool[rng:NextInteger(1, #pool)].id
end

-- Choices per event (keys are sent to the client; labels are the approved draft text, client side).
DungeonEvents.Choices = table.freeze({
	["EV-01"] = { "open", "leave" },
	["EV-02"] = { "drink", "flask", "move" },
	["EV-03"] = { "buy", "no" },
	["EV-04"] = { "pouch", "bury" },
	["EV-05"] = { "offer", "walk" },
	["EV-06"] = { "offer", "refuse" },
	["EV-07"] = { "break", "leave" },
	["EV-08"] = { "bet", "walk" },
	["EV-09"] = { "run", "shield" },
	["EV-10"] = { "hand", "fight" },
	["EV-11"] = { "pray", "move" },
	["EV-12"] = { "hand", "keep" },
	["EV-13"] = { "m2c", "c2m", "g2m", "leave" },
	["EV-14"] = { "rest", "search" },
	["EV-15"] = { "reforge", "leave" },
	["EV-16"] = { "reshape", "leave" }, -- Altar of Change (2026-11-15 10:08 AM)
})

local function valid(id: string, choice: string): boolean
	local cs = DungeonEvents.Choices[id]
	if not cs then return false end
	for _, c in cs do if c == choice then return true end end
	return false
end

--- Resolve a choice into effects (DungeonService applies them; amounts never come from the client).
--- Effect kinds: { k = "rolls", n } gear/card rolls into the bag at the current drop rate;
--- { k = "bagGold", n }; { k = "bagMat", id, n } (normal material); { k = "heal", pct };
--- { k = "revive", pct }; { k = "hurtAll", pct }; { k = "hurtTop", pct }; { k = "realGold", n } (+/-);
--- { k = "shrine", bonus } (old saved Lucky Shrine rooms only); { k = "loseBagGoldPct", pct } (legacy);
--- { k = "fight", played = "Battle" | "Elite" }; { k = "nothing" }.
--- Silver step 2 (rules 272 / 278): { k = "silver", n } (+ purse); { k = "silverPay", n } (paid first,
--- all-or-nothing); { k = "loseSilverPct", pct }; { k = "refill", pct } (silver refill %); trade give = "silver".
--- Returns ok, effects | error. `ctx` = { hasKO: boolean, realGold: number, silver: number }.
function DungeonEvents.Resolve(id: string, choice: string, runSeed: number, row: number, col: number, ctx: any): (boolean, any)
	if not valid(id, choice) then return false, "Invalid choice" end
	local fx: { any } = {}
	if id == "EV-01" then
		if choice == "open" then table.insert(fx, { k = "rolls", n = E.CacheRolls }) end
	elseif id == "EV-02" then
		if choice == "drink" then table.insert(fx, { k = "heal", pct = E.SpringHealPct })
		elseif choice == "flask" then
			if not ctx.hasKO then return false, "Invalid choice" end
			table.insert(fx, { k = "revive", pct = E.FlaskRevivePct })
		end
	elseif id == "EV-03" then
		if choice == "buy" then table.insert(fx, { k = "refill", pct = E.PeddlerRefillPct }) end -- 40% silver (rule 278)
	elseif id == "EV-04" then
		if choice == "pouch" then table.insert(fx, { k = "silver", n = E.PouchSilver }) -- +30 silver (rule 272)
		else table.insert(fx, { k = "bagMat", id = "mercury", n = E.BuryMercury }) end
	elseif id == "EV-05" then
		if choice == "offer" then
			if (ctx.realGold or 0) < E.ShrineCost then return false, "Not enough gold" end
			table.insert(fx, { k = "realGold", n = -E.ShrineCost })
			table.insert(fx, { k = "shrine", bonus = E.ShrineBonus })
		end
	elseif id == "EV-06" then
		if choice == "offer" then
			table.insert(fx, { k = "hurtAll", pct = E.AltarHurtPct })
			table.insert(fx, { k = "rolls", n = E.AltarRolls })
		end
	elseif id == "EV-07" then
		if choice == "break" then
			local roll = Random.new(seedOf(runSeed, row, col, 7)):NextNumber() * 100
			if roll < E.DoorTreasurePct then
				table.insert(fx, { k = "rolls", n = E.DoorRolls })
				table.insert(fx, { k = "silver", n = E.DoorSilver }) -- +40 silver (rule 272)
			else
				table.insert(fx, { k = "fight", played = "Elite" })
			end
		end
	elseif id == "EV-08" then
		if choice == "bet" then
			if (ctx.silver or 0) < E.GambleBetSilver then return false, "Not enough silver" end
			local win = Random.new(seedOf(runSeed, row, col, 8)):NextNumber() * 100 < E.GambleWinPct
			-- Silver step 2 (rule 272): bet 20 silver; win = 40 back (net +20), lose = the 20.
			table.insert(fx, { k = "silverPay", n = E.GambleBetSilver })
			if win then table.insert(fx, { k = "silver", n = E.GamblePayoutSilver }) end
		end
	elseif id == "EV-09" then
		if choice == "run" then table.insert(fx, { k = "hurtAll", pct = E.TunnelAllPct })
		else table.insert(fx, { k = "hurtTop", pct = E.TunnelOnePct }) end
	elseif id == "EV-10" then
		if choice == "hand" then table.insert(fx, { k = "loseSilverPct", pct = E.CutpurseSilverPct }) -- 25% of silver (rule 272)
		else table.insert(fx, { k = "fight", played = "Battle" }) end
	-- EV-11..16 (rule 272, approved 2026-11-15). ctx.kin = the room's seeded kin pick (see KinFor).
	elseif id == "EV-11" then
		if choice == "pray" then
			local kin = ctx.kin
			if not kin then return false, "Invalid choice" end
			if kin.kind == "race" then
				table.insert(fx, { k = "kinHeal", raceId = kin.id, pct = E.KinHealPct })
				table.insert(fx, { k = "rolls", n = E.KinRolls })
			else
				table.insert(fx, { k = "doctrineBuff", doctrineId = kin.id, pct = E.DoctrineStatPct })
			end
		end
	elseif id == "EV-12" then
		if choice == "hand" then
			if type(ctx.gearId) ~= "string" then return false, "Invalid choice" end
			table.insert(fx, { k = "smith", gearId = ctx.gearId })
		end
	elseif id == "EV-13" then
		if choice == "m2c" then table.insert(fx, { k = "trade", give = "mercury", giveN = E.BarterMercuryForCrystal, get = "crystals", getN = 1 })
		elseif choice == "c2m" then table.insert(fx, { k = "trade", give = "crystals", giveN = 1, get = "mercury", getN = E.BarterCrystalForMercury })
		elseif choice == "g2m" then table.insert(fx, { k = "trade", give = "silver", giveN = E.BarterSilverForMercury, get = "mercury", getN = 1 }) end -- 40 silver -> 1 mercury into the Bag (rule 272)
	elseif id == "EV-14" then -- Campfire (USER RULING 2026-11-15 10:01 AM): two separate choices, pick ONE
		if choice == "rest" then
			table.insert(fx, { k = "heal", pct = E.CampHealPct })
			if ctx.hasKO then table.insert(fx, { k = "reviveAll", pct = E.CampRevivePct }) end
		else table.insert(fx, { k = "campRefill" }) end
	elseif id == "EV-15" then
		if choice == "reforge" then
			if type(ctx.gearId) ~= "string" then return false, "Invalid choice" end
			table.insert(fx, { k = "forge", gearId = ctx.gearId })
		end
	elseif id == "EV-16" then -- Altar of Change: the swap itself is applied by DungeonRooms.ChooseAltar
		if choice == "reshape" then return false, "Invalid choice" end
	end
	if #fx == 0 then table.insert(fx, { k = "nothing" }) end
	return true, fx
end

--- EV-11: the room's seeded kin pick from what the party has. races / doctrines = lists of ids in
--- the party (sorted by the caller). 50/50 seeded race or doctrine (draft); nil if the party has neither.
function DungeonEvents.KinFor(runSeed: number, row: number, col: number, races: { string }, doctrines: { string }): any
	local rng = Random.new(seedOf(runSeed, row, col, 11))
	local useDoc = rng:NextNumber() < 0.5
	if useDoc and #doctrines == 0 then useDoc = false end
	if not useDoc and #races == 0 then useDoc = #doctrines > 0 end
	local list = if useDoc then doctrines else races
	if #list == 0 then return nil end
	return { kind = if useDoc then "doctrine" else "race", id = list[rng:NextInteger(1, #list)] }
end

--- EV-16 Altar of Change: seeded Random for one unit + one trait slot in this room (stage seed + room +
--- unit + kind), so the 3 replacement options never change on a rejoin. The caller rolls with TraitRoller.
function DungeonEvents.AltarRng(runSeed: number, row: number, col: number, unitId: string, kind: string): Random
	local h = 0
	for i = 1, #unitId do h = (h * 31 + string.byte(unitId, i)) % 1000003 end
	local salt = 160 + (if kind == "perk" then 1 else 2)
	return Random.new((seedOf(runSeed, row, col, salt) + h * 17) % 2147483647)
end

return table.freeze(DungeonEvents)

--!strict
-- DungeonBagPanel.lua
-- CTRBLXAI | Dungeon Bag screen, full-Bag popup and the EV-17 Courier's Rest picker (silver/Bag redesign
-- steps 4-5, 2026-11-16; project_rules 264 / 272 / 279; text = approved rule 275 lines SB-05, SB-11,
-- SB-13..SB-20, SB-26..SB-34, ids in comments). Display + input only (ARC-001 / SEC-002): the client sends
-- ids and choices; the server (DungeonAction BagView / BagChoice / CourierSend) checks and applies everything.
-- The Courier "Move on" choice stays in DungeonEventPanel (EventChoose).

local uiFolder = script.Parent
local Theme: any = (require :: any)(uiFolder:WaitForChild("Theme", 10))
local GuildScreen: any = (require :: any)(uiFolder:WaitForChild("GuildScreen", 10))

local Bag = {}

export type Ctx = {
	gui: Instance,
	act: (data: { [string]: any }) -> any?,
	onChanged: () -> (),            -- something changed on the server: re-render the map
	lastError: (() -> string?)?,    -- last server refusal text
	extraLines: { any }?,           -- Bag screen: summary + relic lines from DungeonScreen ({ text, size?, color?, bold? })
	onBack: (() -> ())?,            -- Courier picker Back: the event choices again
}

local TAG_TEXT = { bought = "Bought — always kept", home = "From home — always kept" } -- SB-19 / SB-20
local ROW_H = 44 -- touch target

local overlay: Instance? = nil
local lastCtx: Ctx? = nil
local selected: string? = nil -- full-Bag popup: the Bag item picked to throw away (row id)
local taps: { [string]: () -> () } = {} -- the open overlay's tap actions by name (test hook = the same path as a tap)

local function close()
	if overlay then overlay:Destroy() overlay = nil end
end

local function ts(): number return math.max(10, Theme.Text.Small()) end
local function body(): number return math.max(10, Theme.Text.Body()) end

local function text(parent: Instance?, s: string, size: number, color: Color3, bold: boolean?): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.BorderSizePixel = 0
	l.Font = if bold then Theme.Font.PrimaryBold else Theme.Font.Primary
	l.TextSize = math.max(10, size)
	l.TextColor3 = color
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextWrapped = true
	l.Text = s
	l.Size = UDim2.new(1, 0, 0, 0)
	l.AutomaticSize = Enum.AutomaticSize.Y
	l.ZIndex = 22
	l.Parent = parent
	return l
end

local function shell(name: string): (TextButton, Frame)
	close()
	taps = {}
	local o = Instance.new("TextButton")
	o.Name = name
	o.Text = ""
	o.AutoButtonColor = false
	o.Modal = true
	o.Size = UDim2.fromScale(1, 1)
	o.BackgroundColor3 = Color3.new(0, 0, 0)
	o.BackgroundTransparency = 0.4
	o.BorderSizePixel = 0
	o.ZIndex = 20
	local box = Instance.new("Frame")
	box.Name = "Box"
	box.AnchorPoint = Vector2.new(0.5, 0.5)
	box.Position = UDim2.fromScale(0.5, 0.5)
	box.Size = UDim2.new(0.86, 0, 0, 0)
	box.AutomaticSize = Enum.AutomaticSize.Y
	box.BackgroundColor3 = Theme.Colors.PanelRaised
	box.BorderSizePixel = 0
	box.ZIndex = 21
	local maxW = Instance.new("UISizeConstraint")
	maxW.MaxSize = Vector2.new(500, math.huge)
	maxW.Parent = box
	local cr = Instance.new("UICorner")
	cr.CornerRadius = Theme.CornerRadius.md
	cr.Parent = box
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 12)
	pad.PaddingRight = UDim.new(0, 12)
	pad.PaddingTop = UDim.new(0, 8)
	pad.PaddingBottom = UDim.new(0, 8)
	pad.Parent = box
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 4)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = box
	box.Parent = o
	return o, box
end

-- Scroll list sized to the screen (phones: ~45% of the height, never under 2 rows).
local function listBox(box: Frame, order: number, gui: Instance): ScrollingFrame
	local h = 200
	local g = gui :: any
	if g and g.AbsoluteSize then h = math.clamp(math.floor(g.AbsoluteSize.Y * 0.45), ROW_H * 2 + 8, 260) end
	local sf = Instance.new("ScrollingFrame")
	sf.Name = "List"
	sf.BackgroundTransparency = 1
	sf.BorderSizePixel = 0
	sf.Size = UDim2.new(1, 0, 0, h)
	sf.ScrollBarThickness = 4
	sf.ScrollingDirection = Enum.ScrollingDirection.Y
	sf.AutomaticCanvasSize = Enum.AutomaticSize.Y
	sf.CanvasSize = UDim2.new()
	sf.LayoutOrder = order
	sf.ZIndex = 22
	local ll = Instance.new("UIListLayout")
	ll.Padding = UDim.new(0, 3)
	ll.SortOrder = Enum.SortOrder.LayoutOrder
	ll.Parent = sf
	sf.Parent = box
	return sf
end

local function buttonRow(box: Frame, order: number): Frame
	local row = Instance.new("Frame")
	row.Name = "Buttons"
	row.Size = UDim2.new(1, 0, 0, 0)
	row.AutomaticSize = Enum.AutomaticSize.Y
	row.BackgroundTransparency = 1
	row.BorderSizePixel = 0
	row.LayoutOrder = order
	local rl = Instance.new("UIListLayout")
	rl.FillDirection = Enum.FillDirection.Horizontal
	rl.HorizontalAlignment = Enum.HorizontalAlignment.Right
	rl.VerticalAlignment = Enum.VerticalAlignment.Center
	rl.Wraps = true
	rl.Padding = UDim.new(0, 6)
	rl.SortOrder = Enum.SortOrder.LayoutOrder
	rl.Parent = row
	row.Parent = box
	return row
end

local function iconBtn(row: Instance, kind: string, order: number, onTap: () -> ())
	local b = Theme.MakeIconButton(nil, kind, onTap, { name = "Btn_" .. kind, size = UDim2.fromOffset(GuildScreen.ROW_H, GuildScreen.ROW_H) })
	taps["Btn_" .. kind] = onTap
	b.LayoutOrder = order
	b.Parent = row
end

local function barBtn(row: Instance, label: string, style: string, order: number, onTap: () -> ())
	local b = Theme.MakeBarButton(nil, label, style, onTap, { name = "Btn_" .. order, minHeight = GuildScreen.ROW_H })
	if style ~= "Disabled" then taps["Btn_" .. order] = onTap end
	b.LayoutOrder = order
	b.Parent = row
end

-- "×3", "×3 (1/4, 2/4)" for opened copies; gear: nothing.
local function countText(e: any): string
	if e.kind == "gold" then return "" end
	if e.kind == "gear" then return "" end
	local s = `×{e.n or 1}`
	if type(e.opened) == "table" and #e.opened > 0 and e.max then
		local parts = {}
		for _, c in e.opened do table.insert(parts, `{c}/{e.max}`) end
		s ..= ` ({table.concat(parts, ", ")})`
	end
	return s
end

local function rowId(e: any): string
	return if e.kind == "gear" then "g:" .. tostring(e.id) else (e.kind .. ":" .. tostring(e.key))
end

-- One 44 px row: icon, name (rarity colour), count, tag line. onTap = selectable row.
local function itemRow(parent: Instance, e: any, order: number, isSel: boolean, onTap: (() -> ())?)
	local r: GuiObject
	if onTap then
		local b = Instance.new("TextButton")
		b.Text = ""
		b.AutoButtonColor = false
		b.Activated:Connect(onTap)
		taps["Row_" .. order] = onTap
		r = b
	else
		r = Instance.new("Frame")
	end
	r.Name = "Row_" .. order
	r.Size = UDim2.new(1, -6, 0, ROW_H)
	r.BackgroundColor3 = if isSel then Theme.Colors.Surface else Theme.Colors.Panel
	r.BackgroundTransparency = if isSel then 0.1 else 0.5
	r.BorderSizePixel = 0
	r.LayoutOrder = order
	r.ZIndex = 22
	local cr = Instance.new("UICorner")
	cr.CornerRadius = UDim.new(0, 6)
	cr.Parent = r
	if isSel then
		local s = Instance.new("UIStroke")
		s.Color = Theme.Colors.TextGold
		s.Thickness = 2
		s.Parent = r
	end
	local x = 6
	if type(e.icon) == "string" and string.find(e.icon, "rbxassetid://") then
		local img = Instance.new("ImageLabel")
		img.BackgroundTransparency = 1
		img.Image = e.icon
		img.ScaleType = Enum.ScaleType.Fit
		img.Size = UDim2.fromOffset(32, 32)
		img.Position = UDim2.new(0, 6, 0.5, -16)
		img.ZIndex = 23
		img.Parent = r
		x = 44
	end
	local nameColor = if e.rarity then Theme.GetRarityColor(e.rarity) else Theme.Colors.TextPrimary
	local tag = e.tag and TAG_TEXT[e.tag]
	local nm = text(nil, tostring(e.name or "?"), body(), nameColor, true)
	nm.AutomaticSize = Enum.AutomaticSize.None
	nm.TextWrapped = false
	nm.TextTruncate = Enum.TextTruncate.AtEnd
	nm.Size = UDim2.new(1, -(x + 70), 0, if tag then 20 else ROW_H)
	nm.Position = UDim2.fromOffset(x, if tag then 3 else 0)
	nm.ZIndex = 23
	nm.Parent = r
	if tag then
		local tl = text(nil, tag, ts(), Theme.Colors.Success, false)
		tl.AutomaticSize = Enum.AutomaticSize.None
		tl.TextWrapped = false
		tl.TextTruncate = Enum.TextTruncate.AtEnd
		tl.Size = UDim2.new(1, -(x + 8), 0, 16)
		tl.Position = UDim2.fromOffset(x, 23)
		tl.ZIndex = 23
		tl.Parent = r
	end
	local c = countText(e)
	if c ~= "" then
		local cl = text(nil, c, ts(), Theme.Colors.TextSecondary, false)
		cl.AutomaticSize = Enum.AutomaticSize.None
		cl.TextWrapped = false
		cl.TextXAlignment = Enum.TextXAlignment.Right
		cl.Size = UDim2.new(0, 66, 0, if tag then 20 else ROW_H)
		cl.Position = UDim2.new(1, -72, 0, if tag then 3 else 0)
		cl.ZIndex = 23
		cl.Parent = r
	end
	r.Parent = parent
end

local function slotsOf(st: any): (number, number)
	local bs = st and st.run and st.run.bagSlots
	return (bs and bs.used) or 0, (bs and bs.cap) or 0
end

--------------------------------------------------
-- BAG SCREEN
--------------------------------------------------

--- The Bag screen: every Bag item with its tag, what was sent home, then the summary / relic lines.
function Bag.Open(ctx: Ctx)
	lastCtx = ctx
	local res = ctx.act({ action = "BagView" })
	local bl = res and res.bagList
	if not bl then return end
	local o, box = shell("BagScreen")
	local used, cap = slotsOf(res)
	local t = text(box, `Bag {used} / {cap}`, Theme.Text.Heading(), Theme.Colors.TextGold, true) -- SB-11
	t.LayoutOrder = 1
	local sf = listBox(box, 2, ctx.gui)
	local order = 0
	for _, e in bl.items or {} do order += 1 itemRow(sf, e, order, false, nil) end
	if #(bl.sent or {}) > 0 then
		order += 1
		local h = text(sf, "Sent home (safe)", body(), Theme.Colors.Success, true) -- SB-34
		h.LayoutOrder = order
		for _, e in bl.sent do
			order += 1
			if e.kind == "gold" then
				local g = text(sf, `Gold {e.n}`, body(), Theme.Colors.TextPrimary) -- DG gold line format
				g.LayoutOrder = order
			else itemRow(sf, e, order, false, nil) end
		end
	end
	-- Furniture found this run, waiting to come home (furniture step 3; approved line 6, guild_facilities 100).
	local ff = res and res.run and res.run.furniture
	for _, f in (ff and ff.found) or {} do
		order += 1
		local fl = text(sf, `{tostring(f.name)} comes home with your loot.`, body(), Theme.Colors.TextPrimary)
		fl.LayoutOrder = order
	end
	for _, l in ctx.extraLines or {} do
		order += 1
		local lbl = text(sf, tostring(l[1]), l[2] or body(), l[3] or Theme.Colors.TextPrimary, l[4])
		lbl.LayoutOrder = order
	end
	iconBtn(buttonRow(box, 100), "Back", 1, close)
	o.Parent = ctx.gui -- parent last (NET-004)
	overlay = o
end

--------------------------------------------------
-- FULL-BAG POPUP (rule 279: Keep it = pick a Bag item to throw away for good, or Leave it)
--------------------------------------------------

local renderFull: (ctx: Ctx) -> () = function() end

local function afterChoice(ctx: Ctx, res: any)
	if not res then -- refused: the popup stays (the server error is in the status line)
		renderFull(ctx)
		return
	end
	selected = nil
	local bs = res.run and res.run.bagSlots
	if bs and #(bs.held or {}) > 0 then renderFull(ctx) return end
	close()
	ctx.onChanged()
end

local function confirmThrow(ctx: Ctx, e: any)
	local o, box = shell("BagThrowConfirm")
	local l = text(box, `Throw away {tostring(e.name or "?")}? It's gone for good.`, body(), Theme.Colors.TextPrimary, true) -- SB-17
	l.LayoutOrder = 1
	if e.tag == "bought" then
		local w = text(box, "You paid for this. Throw it away anyway?", body(), Theme.Colors.Danger, true) -- SB-18
		w.LayoutOrder = 2
	end
	local row = buttonRow(box, 100)
	iconBtn(row, "Back", 1, function() renderFull(ctx) end)
	iconBtn(row, "Confirm", 2, function()
		local discard = if e.kind == "gear" then { gear = e.id } else { card = e.key }
		afterChoice(ctx, ctx.act({ action = "BagChoice", keep = true, discard = discard }))
	end)
	o.Parent = ctx.gui
	overlay = o
end

renderFull = function(ctx: Ctx)
	lastCtx = ctx
	local res = ctx.act({ action = "BagView" })
	local bl = res and res.bagList
	local held = bl and bl.held and bl.held[1]
	if not held then close() ctx.onChanged() return end
	local used, cap = slotsOf(res)
	local room = cap - used > 0
	local o, box = shell("BagFull")
	local t = text(box, "Your bag is full", Theme.Text.Heading(), Theme.Colors.TextGold, true) -- SB-13
	t.LayoutOrder = 1
	local b = text(box, "Pick something to throw away, or leave the new item.", body(), Theme.Colors.TextPrimary) -- SB-14
	b.LayoutOrder = 2
	itemRow(box, held, 3, true, nil) -- the new item, next to the Bag
	local cnt = text(box, `Bag {used} / {cap}`, ts(), Theme.Colors.TextSecondary, true) -- SB-11
	cnt.LayoutOrder = 4
	local sf = listBox(box, 5, ctx.gui)
	local pick: any = nil
	local order = 0
	for _, e in bl.items or {} do
		if e.tag ~= "home" and not e.home then -- home items are always kept: they can't be thrown away
			order += 1
			local id = rowId(e)
			if id == selected then pick = e end
			itemRow(sf, e, order, id == selected, function() selected = if selected == id then nil else id renderFull(ctx) end)
		end
	end
	local row = buttonRow(box, 100)
	barBtn(row, "Leave it", "Secondary", 1, function() -- SB-16
		afterChoice(ctx, ctx.act({ action = "BagChoice", keep = false }))
	end)
	barBtn(row, "Keep it", if room or pick then "Primary" else "Disabled", 2, function() -- SB-15
		if room then afterChoice(ctx, ctx.act({ action = "BagChoice", keep = true }))
		elseif pick then confirmThrow(ctx, pick) end
	end)
	o.Parent = ctx.gui
	overlay = o
end

--- Show the full-Bag popup while loot waits (the run waits for the pick; no Back).
function Bag.OpenFull(ctx: Ctx)
	selected = nil
	renderFull(ctx)
end

--------------------------------------------------
-- EV-17 COURIER'S REST PICKER (rule 272)
--------------------------------------------------

local cSel: { [string]: boolean } = {}
local cGold = false
local cNormal = false

local renderCourier: (ctx: Ctx, ev: any, note: string?) -> () = function() end

local function picksOf(opts: any): (any, number)
	local p = { gear = {}, cards = {}, mats = {}, gold = cGold, normal = cNormal }
	local slots = 0
	for _, e in opts.items or {} do
		local id = rowId(e)
		if e.kind ~= "normal" and cSel[id] then
			slots += e.slots or 1
			if e.kind == "gear" then table.insert(p.gear, e.id)
			elseif e.kind == "card" then table.insert(p.cards, e.key)
			elseif e.kind == "mat" then table.insert(p.mats, e.key) end
		end
	end
	return p, slots
end

local function courierResult(ctx: Ctx, lines: { any })
	local o, box = shell("CourierResult")
	local t = text(box, "Courier's Rest", Theme.Text.Heading(), Theme.Colors.TextGold, true) -- SB-26
	t.LayoutOrder = 1
	local order = 1
	for _, l in lines do
		order += 1
		if l.k == "courier" then
			text(box, "Sent home! They'll be waiting for you.", body(), Theme.Colors.Success, true).LayoutOrder = order -- SB-33
		elseif l.k == "silver" and l.n < 0 then
			text(box, `−{-l.n} silver`, body(), Theme.Colors.TextGold, true).LayoutOrder = order -- SB-05
		end
	end
	iconBtn(buttonRow(box, 100), "Back", 1, function() close() ctx.onChanged() end)
	o.Parent = ctx.gui
	overlay = o
end

local function confirmSend(ctx: Ctx, ev: any, opts: any, err: string?)
	local p, slots = picksOf(opts)
	local cost = slots * (opts.perSlot or 5)
	local o, box = shell("CourierConfirm")
	text(box, `Send {slots} items home for {cost} silver? You can't use them again this run.`, body(), Theme.Colors.TextPrimary, true).LayoutOrder = 1 -- SB-32
	if err then text(box, err, body(), Theme.Colors.Danger, true).LayoutOrder = 2 end
	local row = buttonRow(box, 100)
	iconBtn(row, "Back", 1, function() renderCourier(ctx, ev) end)
	iconBtn(row, "Confirm", 2, function()
		local res = ctx.act({ action = "CourierSend", picks = p })
		if res and res.eventResult then
			cSel, cGold, cNormal = {}, false, false
			courierResult(ctx, res.eventResult.lines or {})
			return
		end
		confirmSend(ctx, ev, opts, if ctx.lastError then ctx.lastError() else nil)
	end)
	o.Parent = ctx.gui
	overlay = o
end

renderCourier = function(ctx: Ctx, ev: any, note: string?)
	lastCtx = ctx
	local opts = ev and ev.courier
	if not opts then return end
	local o, box = shell("CourierPick")
	text(box, "Courier's Rest", Theme.Text.Heading(), Theme.Colors.TextGold, true).LayoutOrder = 1 -- SB-26
	text(box, `Pick up to {opts.pack} items · {opts.perSlot} silver each`, body(), Theme.Colors.TextPrimary, true).LayoutOrder = 2 -- SB-30
	text(box, `Silver {opts.silver or 0}`, ts(), Theme.Colors.TextGold, true).LayoutOrder = 3 -- SB-01
	local _, slots = picksOf(opts)
	local sf = listBox(box, 4, ctx.gui)
	local order = 0
	if (opts.gold or 0) > 0 then
		order += 1
		itemRow(sf, { kind = "gold", name = `Send gold: {opts.gold} (free)` }, order, cGold, function() -- SB-31
			cGold = not cGold renderCourier(ctx, ev) end)
	end
	for _, e in opts.items or {} do
		order += 1
		local id = rowId(e)
		local isSel = if e.kind == "normal" then cNormal else cSel[id] == true
		itemRow(sf, e, order, isSel, function()
			if e.kind == "normal" then cNormal = not cNormal -- normal materials go together, free (rule 272)
			elseif cSel[id] then cSel[id] = nil
			elseif slots + (e.slots or 1) <= (opts.pack or 0) then cSel[id] = true
			else return end -- pack is full: the tap does nothing
			renderCourier(ctx, ev)
		end)
	end
	if note then text(box, note, body(), Theme.Colors.Danger, true).LayoutOrder = 5 end
	local row = buttonRow(box, 100)
	iconBtn(row, "Back", 1, function()
		cSel, cGold, cNormal = {}, false, false
		close()
		if ctx.onBack then ctx.onBack() end
	end)
	local any = slots > 0 or cGold or cNormal
	barBtn(row, "Send items home", if any then "Primary" else "Disabled", 2, function() confirmSend(ctx, ev, opts) end) -- SB-28
	o.Parent = ctx.gui
	overlay = o
end

--- EV-17: open the picker for the current Courier's Rest (ev = EventState eventRoom with .courier).
function Bag.OpenCourier(ctx: Ctx, ev: any)
	cSel, cGold, cNormal = {}, false, false
	renderCourier(ctx, ev)
end

Bag.Close = close
function Bag.IsOpen(): boolean return overlay ~= nil end

-- Test hooks (simulated taps don't register): the same paths as the taps.
Bag._Test = table.freeze({
	overlayName = function() return overlay and overlay.Name or nil end,
	-- tap a button / row of the open overlay by name: "Btn_Back", "Btn_Confirm", "Btn_1", "Btn_2", "Row_3" ...
	tap = function(name: string): boolean
		local f = taps[name]
		if not f then return false end
		f()
		return true
	end,
	names = function() local out = {} for k in taps do table.insert(out, k) end table.sort(out) return out end,
})

return table.freeze(Bag)

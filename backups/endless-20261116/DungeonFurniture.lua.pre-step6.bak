--!strict
-- DungeonFurniture.lua
-- CTRBLXAI | Guild Hall furniture found in the Dungeon.
-- v5 build STEP 3 (2026-11-16, docs\CTRBLXAI.db guild_facilities 109 + project_rules 264/277, USER RULING
-- 7:44 / 7:47 PM; text guild_facilities 112 approved 8:07 PM). Replaces the step-3 (3:40 PM) room drops:
--   * ELITE: one roll per Elite win (incl. "?" rooms that become Elites), chance by Dungeon facility level
--     (20% L1 ... 35% L10). Rarity Common 45 / Uncommon 35 / Rare 17 / Epic 3; at stage 1 the Epic weight
--     moves to Rare. Piece = one of the 9 rolled types (equal), then one piece of that type.
--   * BOSS: every stage boss win gives exactly 1 rolled piece, OUTSIDE the 3-a-day boss limit (Main calls
--     BossDrop for every won dungeon boss). Rarity row by stage (1 / 2 / 3 / 4-5 / 6+); Medium bosses use
--     the next stage's row, Hard two stages deeper (Simulator fix 3). Pool = 9 rolled types + Tome Stack +
--     Gilded Chest (equal); duplicates allowed (Gilded Chest is fixed, so not offered again once owned).
--   * Treasure rooms, Events and quest bosses no longer drop furniture.
--   * Guild Hall gates (row 104) apply (locked roll -> highest open rarity); Oak Bed +1 step first.
--     Fortune, the growing drop multiplier and the Elite+Boss loot bonus never touch these rolls.
--   * A found piece is a ROLLED piece { id, r, l, st = stage, b = from stage boss } with NO uid (the uid is
--     given when it comes home: FurnitureService.GrantDrop). LOOT with NO Bag slot: home on a full-loot exit
--     (Boss / Rest leave), lost on wipeout or early escape (rule 264). The stage tag (st, b) is kept for the
--     endless stage-4+ wipe rule (step 6). Courier's Rest sends found pieces home free with any send.
-- Pure on the run table (run.dgFurn, saved by DungeonSave). No require of DungeonService (no cycle).
-- Hooks (Main wires FurnitureService): isOwned, getGuildHallLevel; nil-safe (ARC-006).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local FurnitureData = require(ReplicatedStorage:WaitForChild("Content"):WaitForChild("FurnitureData"))
local FurnitureRoll = require(script.Parent:WaitForChild("FurnitureRoll"))
local FurnitureSaveV2 = require(script.Parent:WaitForChild("FurnitureSaveV2"))
local V4: any = FurnitureData.V4
local SRC: any = V4.Sources

local F = {}

local MAX_LIST = 256 -- save sanity bound per list (found / sent); 64 -> 256 for endless runs (step 5, Tester WARN-C)
local TYPE_ORDER = table.freeze({ "Bed", "Plant", "Bookshelf", "DeskCandles", "TrainingGear", "AgilityCourse", "Target", "WeaponRack", "ArmourStand" })

-- Pieces of each rolled type (boss-signature pieces only come from bosses).
local BY_TYPE: { [string]: { string } } = {}
for _, p in V4.Pieces do
	if p.type and p.source ~= "BossDrop" then
		BY_TYPE[p.type] = BY_TYPE[p.type] or {}
		table.insert(BY_TYPE[p.type], p.id)
	end
end

type Entry = { id: string, r: string, l: { any }, st: number, b: boolean? }

local hooks: { isOwned: ((string) -> boolean)?, getGuildHallLevel: (() -> number)? } = {}
function F.SetHooks(h: any) hooks = if type(h) == "table" then h else {} end

local function ensure(run: any): any
	local st = run.dgFurn
	if type(st) ~= "table" then
		st = { found = {}, sent = {}, rolled = {}, popup = nil }
		run.dgFurn = st
	end
	return st
end

local function stageKey(run: any, roomId: string): string
	return tostring(run.stage or 1) .. ":" .. roomId
end

local function seedOf(run: any, roomId: string, source: string): number
	local h = 0
	for i = 1, #roomId do h = (h * 31 + string.byte(roomId, i)) % 1000003 end
	return ((run.sseed or run.card.seed or 1) * 23 + h * 131 + string.byte(source, 1) * 11 + (run.stage or 1) * 977 + 907) % 2147483647
end

local function owned(id: string): boolean
	local fn = hooks.isOwned
	if not fn then return false end
	local ok, v = pcall(fn, id)
	return ok and v == true
end

local function ghLevel(): number
	local fn = hooks.getGuildHallLevel
	if not fn then return 1 end
	local ok, v = pcall(fn)
	return if ok then math.clamp(math.floor(tonumber(v) or 1), 1, 10) else 1
end

local function inRun(st: any, id: string): boolean
	for _, list in { st.found, st.sent } do
		for _, e in list do if e.id == id then return true end end
	end
	return false
end

--- Rarity weights for an Elite piece at this stage.
local function eliteWeights(stage: number): { [string]: number }
	local w = SRC.EliteWeights
	if stage <= 1 and SRC.EliteStage1EpicToRare then
		return { Common = w.Common, Uncommon = w.Uncommon, Rare = w.Rare + w.Epic, Epic = 0 }
	end
	return { Common = w.Common, Uncommon = w.Uncommon, Rare = w.Rare, Epic = w.Epic }
end

--- Boss rarity row: stage 1 / 2 / 3 / 4-5 / 6+, after the difficulty shift (Medium +1, Hard +2 stages).
function F.BossRowIndex(stage: number, difficulty: number): number
	local s = math.max(1, math.floor(tonumber(stage) or 1)) + (SRC.DifficultyStageShift[math.floor(tonumber(difficulty) or 2)] or 0)
	if s <= 3 then return s end
	if s <= 5 then return 4 end
	return 5
end

local function rollEntry(rng: Random, id: string, weights: { [string]: number }, stage: number, boss: boolean): Entry?
	local p = V4.Get(id)
	if not p then return nil end
	local gh = ghLevel()
	local rar: string? = nil
	if not (p.fixed or p.looksOnly) then rar = FurnitureRoll.RollRarityFrom(rng, weights, gh, p.rarityStepBonus) end
	local inst = FurnitureRoll.RollInstance(id, if boss then "boss" else "dungeon", rng, rar, function() return "run" end, function() return gh end)
	if not inst then return nil end
	return { id = id, r = inst.rarity, l = FurnitureSaveV2.ExportLines(inst.lines), st = stage, b = if boss then true else nil }
end

local function pickTypePiece(rng: Random): string
	local list = BY_TYPE[TYPE_ORDER[rng:NextInteger(1, #TYPE_ORDER)]]
	return list[rng:NextInteger(1, #list)]
end

local function addFound(run: any, e: Entry)
	local st = ensure(run)
	table.insert(st.found, e)
	st.popup = { id = e.id, r = e.r }
	local p = V4.Get(e.id)
	print(`[DungeonFurniture] Furniture found | {e.id} {p and p.name or "?"} ({e.r}) | stage {e.st}{if e.b then " boss" else ""} | {#st.found} this run`)
end

--- Elite win (once per room per stage). source must be "E"; Treasure ("T") and Event ("V") drops are
--- retired by v5 and return nil.
function F.Roll(run: any, roomId: any, source: string): Entry?
	if type(run) ~= "table" or type(roomId) ~= "string" or source ~= "E" then return nil end
	local st = ensure(run)
	local key = stageKey(run, roomId)
	if st.rolled[key] then return nil end
	st.rolled[key] = true
	local lv = math.clamp(math.floor(tonumber(run.card and run.card.facilityLevel) or 1), 1, #SRC.EliteChance)
	local rng = Random.new(seedOf(run, roomId, source))
	if rng:NextNumber() >= SRC.EliteChance[lv] then return nil end
	local stage = math.max(1, math.floor(tonumber(run.stage) or 1))
	local e = rollEntry(rng, pickTypePiece(rng), eliteWeights(stage), stage, false)
	if e then addFound(run, e) end
	return e
end

--- Stage boss win: exactly 1 piece, once per stage (outside the 3-a-day boss limit).
function F.BossDrop(run: any): Entry?
	if type(run) ~= "table" then return nil end
	local st = ensure(run)
	local stage = math.max(1, math.floor(tonumber(run.stage) or 1))
	local key = tostring(stage) .. ":boss"
	if st.rolled[key] then return nil end
	st.rolled[key] = true
	local rng = Random.new(seedOf(run, "boss", "B"))
	local opts: { string } = {}
	for _ in TYPE_ORDER do table.insert(opts, "") end -- "" = a rolled-type piece
	for _, id in SRC.BossSignaturePieces do
		local p = V4.Get(id)
		if p and not (p.fixed and (owned(id) or inRun(st, id))) then table.insert(opts, id) end
	end
	local o = opts[rng:NextInteger(1, #opts)]
	local id = if o == "" then pickTypePiece(rng) else o
	local row = SRC.BossRows[F.BossRowIndex(stage, run.card and run.card.difficulty)]
	local e = rollEntry(rng, id, row, stage, true)
	if e then addFound(run, e) end
	return e
end

--- Courier's Rest (default): every found piece goes home with any send, free, no slot.
function F.SendAll(run: any): number
	local st = run and run.dgFurn
	if type(st) ~= "table" or #st.found == 0 then return 0 end
	local n = #st.found
	for _, e in st.found do table.insert(st.sent, e) end
	st.found = {}
	print(`[DungeonFurniture] Sent home with the Courier | {n} piece(s)`)
	return n
end

--- Run end: sent pieces always come home; found pieces only on a full-loot exit (rule 264).
--- outcome.kept.furniture = rolled entries (FurnitureService.GrantDrop gives each one a uid).
function F.OnRunEnd(run: any, outcome: any, kind: string)
	local st = run and run.dgFurn
	if type(st) ~= "table" or type(outcome) ~= "table" or type(outcome.kept) ~= "table" then return end
	local keep = kind == "Boss" or kind == "EscapeNode"
	local kept, lost = {}, {}
	for _, e in st.sent do table.insert(kept, e) end
	for _, e in st.found do table.insert(if keep then kept else lost, e) end
	outcome.kept.furniture = kept
	if type(outcome.lost) == "table" then outcome.lost.furniture = lost end
	if #kept + #lost > 0 then
		print(`[DungeonFurniture] Run end ({kind}) | furniture home {#kept} | lost {#lost}`)
	end
	run.dgFurn = nil
end

local function shownRarity(r: any): string?
	return if type(r) == "string" and V4.Rarities[r] then r else nil
end

--- Screen view: { found = { { id, name, rarity } }, popup = name?, popupRarity = rarity? }.
function F.View(run: any): any
	local st = run and run.dgFurn
	if type(st) ~= "table" then return nil end
	local found = {}
	for _, e in st.found do
		local p = V4.Get(e.id)
		table.insert(found, { id = e.id, name = p and p.name or e.id, rarity = shownRarity(e.r) })
	end
	local pp = st.popup and V4.Get(st.popup.id)
	if #found == 0 and not pp then return nil end
	return { found = found, popup = pp and pp.name or nil, popupRarity = if pp then shownRarity(st.popup.r) else nil }
end

--- The client showed "Furniture found: {name} ({rarity})!": forget the popup.
function F.Ack(run: any)
	local st = run and run.dgFurn
	if type(st) == "table" then st.popup = nil end
end

--------------------------------------------------
-- SAVE (DungeonSave)
--------------------------------------------------

function F.Export(run: any): any
	local st = run and run.dgFurn
	if type(st) ~= "table" then return nil end
	local rolled = {}
	for k in st.rolled do table.insert(rolled, k) end
	table.sort(rolled)
	local function copy(list: { any }): { any }
		local out = {}
		for _, e in list do table.insert(out, { id = e.id, r = e.r, l = e.l, st = e.st, b = e.b }) end
		return out
	end
	return { v = 2, found = copy(st.found), sent = copy(st.sent), rolled = rolled,
		popup = if st.popup then { id = st.popup.id, r = st.popup.r } else nil }
end

-- One saved entry. A plain piece id (runs saved before v5 step 3) is kept as { id } with no lines:
-- FurnitureService.GrantDrop rolls it when it comes home (stage-1 Elite weights, plan OPEN-2 default).
local function cleanEntry(e: any): Entry?
	local legacyId: any = if type(e) == "string" then e elseif type(e) == "table" and type(e.l) ~= "table" then e.id else nil
	if legacyId ~= nil then
		local lp = V4.Get(legacyId)
		if not lp then return nil end
		if not (lp.fixed or lp.looksOnly) then -- not rolled yet: rolled on the way home (GrantDrop)
			local stg0 = if type(e) == "table" then tonumber(e.st) else nil
			return { id = legacyId, r = "None", l = nil :: any, st = if stg0 and stg0 >= 1 and stg0 <= 999 and stg0 % 1 == 0 then stg0 else 1,
				b = if type(e) == "table" and e.b == true then true else nil }
		end
		e = { id = legacyId, l = {} }
	end
	if type(e) ~= "table" then return nil end
	local id, rar, lines = FurnitureSaveV2.CleanEntry(e)
	if not (id and rar and lines) then return nil end
	local stg = tonumber(e.st)
	stg = if stg and stg == stg and stg % 1 == 0 and stg >= 1 and stg <= 999 then stg else 1
	return { id = id, r = rar, l = FurnitureSaveV2.ExportLines(lines), st = stg :: number, b = if e.b == true then true else nil }
end

local function entryList(t: any): { Entry }
	local out: { Entry } = {}
	if type(t) ~= "table" then return out end
	for _, raw in t do
		if #out >= MAX_LIST then break end
		local e = cleanEntry(raw)
		if e then table.insert(out, e) end
	end
	return out
end

function F.Import(run: any, d: any)
	run.dgFurn = nil
	if type(d) ~= "table" then return end -- old saves: nothing found
	local st = { found = entryList(d.found), sent = entryList(d.sent), rolled = {}, popup = nil }
	for _, k in (if type(d.rolled) == "table" then d.rolled else {}) do
		if type(k) == "string" and #k <= 32 then st.rolled[k] = true end
	end
	local pp = d.popup
	if type(pp) == "string" and V4.Get(pp) then
		st.popup = { id = pp, r = nil }
	elseif type(pp) == "table" and V4.Get(pp.id) then
		st.popup = { id = pp.id, r = shownRarity(pp.r) }
	end
	run.dgFurn = st
end

-- Dev only (Main DevDungeon op "furn drop", DevAccess-gated, memory-mode only): force a found piece,
-- rolled like an Elite piece of the current stage.
function F.DevFound(run: any, id: any): boolean
	if type(run) ~= "table" or not V4.Get(id) then return false end
	local stage = math.max(1, math.floor(tonumber(run.stage) or 1))
	local e = rollEntry(Random.new(), id, eliteWeights(stage), stage, false)
	if not e then return false end
	addFound(run, e)
	return true
end

-- Test hook (module copies only; pure): roll an Elite / boss piece with a given seed, never stored.
function F.TestRoll(seed: number, kind: string, stage: number, difficulty: number, facilityLevel: number): (boolean, Entry?)
	local rng = Random.new(seed)
	if kind == "E" then
		local lv = math.clamp(math.floor(facilityLevel or 1), 1, #SRC.EliteChance)
		if rng:NextNumber() >= SRC.EliteChance[lv] then return false, nil end
		return true, rollEntry(rng, pickTypePiece(rng), eliteWeights(stage), stage, false)
	end
	local opts: { string } = {}
	for _ in TYPE_ORDER do table.insert(opts, "") end
	for _, id in SRC.BossSignaturePieces do table.insert(opts, id) end
	local o = opts[rng:NextInteger(1, #opts)]
	local id = if o == "" then pickTypePiece(rng) else o
	return true, rollEntry(rng, id, SRC.BossRows[F.BossRowIndex(stage, difficulty)], stage, true)
end

return table.freeze(F)

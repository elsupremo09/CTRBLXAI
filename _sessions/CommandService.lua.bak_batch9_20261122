						end
					end
				end
				effectResult = { effectType = "TileEffect", amount = n,
					description = string.format("%s affected %d tile(s)", consumableDef.name, n) }
				print(string.format("[CommandService] ITEM TILE-EFFECT [%s] | %s | %s | %d tile(s)",

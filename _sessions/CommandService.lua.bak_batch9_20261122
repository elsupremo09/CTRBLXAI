-- PURE BUFF helpers (2026-10-07: Hold the Line / Coordinated Advance / War Cry).
-- Power-0 skills whose intent is a status on the caster or allies. Applied
-- directly (no ResolveSkill) so a buff never runs the damage path against a
-- friendly unit (BUG-004 class). Allies = same side only (recruited Neutrals and
-- enemies excluded).
--------------------------------------------------
local function isPureBuffSkill(skillDef: any)
	return (skillDef.power or 0) == 0 and not skillDef.inheritStr
		and not skillDef.isHealing and not skillDef.isShield
		and (skillDef.appliesStatus ~= nil or skillDef.appliesStatuses ~= nil)
end

-- Card-tag helper: true when the skill's card shows `tagName`.
local function hasCardTag(skillDef: any, tagName: string): boolean
	for _, tag in ipairs(skillDef.tags or {}) do
		if tag == tagName then return true end
	end
	return false
end

-- "Caster Area" (DB Target_Rules, ruling 2026-10-26): centered on the caster and affects
-- every unit in the area, any side (the user's "either side" ruling applied to an area).
local function isCasterArea(skillDef: any): boolean
	return skillDef.targetRules == "Caster Area"
end

-- Cleave skills whose card hits every unit in the arc, allies too (USER RULING 2026-11-08 3:32 PM:
-- Decimating Swing, flag cleaveHitsAnySide in GameConstants). Every unit pass, the hit preview and
-- the Stormbringer count pass this to GetCleaveTargets so they all pick the same units. Other Cleave
-- skills (Sweeping Cut) and weapon Cleave keep enemy-only flank tiles. The caster is never included.
local function cleaveAnySide(skillDef: any): boolean
	return skillDef ~= nil and skillDef.cleaveHitsAnySide == true
end

-- Caster-centred aura (War Cry: "Caster Area", Circle3; legacy "Self, Allies").
local function isPureBuffAura(skillDef: any)
	return isPureBuffSkill(skillDef)
		and (skillDef.targetRules == "Self, Allies" or skillDef.targetRules == "Self (Aura)"
			or isCasterArea(skillDef))
		and skillDef.aoePattern ~= nil and skillDef.aoePattern ~= "InheritWeapon"
end

local function auraTargets(state: any, caster: any, skillDef: any)
	local radius = tonumber(tostring(skillDef.aoePattern):match("%d+")) or 1
	-- "Caster Area" affects every unit in the area, any side (ruling 2026-10-26), except skills marked
	-- alliesOnly: War Cry (user ruling 2026-10-28) buffs only the caster's side.
	local anySide = isCasterArea(skillDef) and not skillDef.alliesOnly
	local list = {}
	for _, u in ipairs(state.units) do
		if u.isAlive and (anySide or u.side == caster.side)
			and math.max(math.abs((u.tileX or 0) - caster.tileX), math.abs((u.tileY or 0) - caster.tileY)) <= radius then
			table.insert(list, u)
		end
	end
	return list
end

-- SHARED RESOLVE (AUG-SHARED-RESOLVE, DB card): a supported self-buff goes to every standing ally,
-- caster included, at any range. Allies = same side, alive, not a map object. True only when the
-- augment is attached AND fits the skill (Buff, Self, Not Stance; checked by AugmentCompatibility).
local function usesSharedResolve(caster: any, skillDef: any): boolean
	return skillDef ~= nil and skillDef.targetRules == "Self" and isPureBuffSkill(skillDef)
		and AugmentEffectService.HasSharedResolve ~= nil
		and AugmentEffectService.HasSharedResolve(caster, skillDef.id)
end

local function sharedResolveTargets(state: any, caster: any): { any }
	local list = { caster }
	for _, u in ipairs(state.units) do
		if u.isAlive and u.id ~= caster.id and u.side == caster.side
			and not u.isGroundTarget and not u.isObject then
			table.insert(list, u)
		end
	end
	return list
end

-- Units a cast HELPED, for Support augments ("apply <buff> to the target", DB cards 2026-10-28):
-- Shared Resolve -> every standing ally; auras -> the aura's units; self skills -> the caster; area
-- skills -> living units in the area; single target -> that unit (also a revived one). Units this
-- cast damaged (the reaction-window hit list) and item devices are left out.
local function skillSupportTargets(caster: any, skillDef: any, target: any, state: any, hitList: any): { any }
	local hit = {}
	for _, v in ipairs(hitList or {}) do
		hit[v] = true
	end
	local list, seen = {}, {}
	local function add(u)
		if u and u.isAlive and not u.isGroundTarget and not u.isItemDevice and not hit[u] and not seen[u] then
			seen[u] = true
			table.insert(list, u)
		end
	end
	if usesSharedResolve(caster, skillDef) then
		for _, u in ipairs(sharedResolveTargets(state, caster)) do add(u) end
	elseif isPureBuffAura(skillDef) then
		for _, u in ipairs(auraTargets(state, caster, skillDef)) do add(u) end
	elseif skillDef.isShield and skillDef.aoePattern then
		-- Area shields (Bulwark Field) cover the same units the shield branch did (radius from caster).
		for _, u in ipairs(auraTargets(state, caster, skillDef)) do add(u) end
	elseif skillDef.isHealing and hasCardTag(skillDef, "Direct Damage")
		and skillDef.aoePattern ~= nil and not isUnitAnchoredPattern(skillDef) then
		-- Area drain (Siphon Pulse): it damages its area and heals the CASTER, so only the caster is
		-- helped. Units in the area (incl. Undead it healed or units hit for 0) never get the caster's
		-- buff (user OK 2026-10-28, UAT D5). Same test as the area-drain resolution branch.
		add(caster)
	elseif target and target.tileX then
		-- Area checked BEFORE the self case: Caster Area skills (Consecrate, Sanctify) target the
		-- caster's own tile but cover the whole area (UAT 2026-10-28 D1). Same elevation (+/-2) and
		-- blocked-line rules as the area heal, so the buff reaches exactly the units it reached (D3).
		local tiles = skillAffectedTiles(caster, skillDef, target.tileX, target.tileY)
		if #tiles > 1 then
			local cElev = GameConstants.GetElevation(target.tileX, target.tileY)
			for _, t in ipairs(tiles) do
				if math.abs(GameConstants.GetElevation(t.x, t.y) - cElev) <= 2
					and not TargetingService.IsAOEBlocked(target.tileX, target.tileY, t.x, t.y) then
					for _, u in ipairs(state.units) do
						-- alliesOnly area heals (Consecrate, Sanctify; 2026-11-08) helped only their allies.
						if u.tileX == t.x and u.tileY == t.y and not u.isObject
							and (not skillDef.alliesOnly or u.side == caster.side) then add(u) end
					end
				end
			end
		elseif not target.isGroundTarget then
			add(target)
		else
			for _, u in ipairs(state.units) do
				if u.tileX == target.tileX and u.tileY == target.tileY then add(u) end
			end
		end
	elseif skillDef.targetRules == "Self" then
		add(caster)
	end
	return list
end

-- Applies the skill's status(es) to each target; returns AOE-shaped entries
-- ({ target, outcome = { finalDamage = 0, appliesStatus } }) for Main's broadcast.
local function applyPureBuff(caster: any, skillDef: any, targets: any)
	local entries = {}
	for _, u in ipairs(targets) do
		local applied = nil
		-- MP effects (2026-10-07): Mana Surge / Meditate self restore round(MaxMP x f);
		-- Meditate on an ally transfers min(caster MP, ally missing MP, round(caster
		-- MaxMP x f)) from caster to ally. Clamped, never negative.
		if u.id == caster.id and skillDef.selfMpRestoreFraction then
			local gain = math.round((caster.maxMp or 0) * skillDef.selfMpRestoreFraction)
			caster.currentMp = math.min(caster.maxMp or 0, (caster.currentMp or 0) + gain)
			print(`[CommandService] {skillDef.name}: {caster.name} restores MP -> {caster.currentMp}/{caster.maxMp}`)
		elseif u.id ~= caster.id and skillDef.allyMpTransferFraction then
			local missing = math.max(0, (u.maxMp or 0) - (u.currentMp or 0))
			local amount = math.max(0, math.min(caster.currentMp or 0, missing,
				math.round((caster.maxMp or 0) * skillDef.allyMpTransferFraction)))
			caster.currentMp = (caster.currentMp or 0) - amount
			u.currentMp = (u.currentMp or 0) + amount
			print(`[CommandService] {skillDef.name}: {caster.name} transfers {amount} MP to {u.name}`)
			if BattleVisualBroadcaster.UnitStateChanged then BattleVisualBroadcaster.UnitStateChanged(caster) end
		end
		if skillDef.appliesStatus then
			StatusService.ApplyStatus(u, skillDef.appliesStatus, caster.id, nil, skillDef.statusDurationCt)
			applied = skillDef.appliesStatus
		end
		if skillDef.appliesStatuses then
			for _, sid in ipairs(skillDef.appliesStatuses) do
				StatusService.ApplyStatus(u, sid, caster.id, nil, skillDef.statusDurationCt)
				applied = applied or sid
			end
		end
		if BattleVisualBroadcaster.UnitStateChanged then
			BattleVisualBroadcaster.UnitStateChanged(u)
		end
		table.insert(entries, { target = u, outcome = { finalDamage = 0, appliesStatus = applied } })
	end
	return entries
end


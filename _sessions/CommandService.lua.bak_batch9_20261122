-- AUGMENT RT MULTIPLIER (e.g. Shared Resolve "RT Cost ×2.00"). One place, used by both RT charge
-- sites and by the turn prompt / skill card so the shown RT always matches what is charged.
--------------------------------------------------
function CommandService.GetAugmentRtMultiplier(unit: any, skillId: any): number
	if not (unit and skillId and AugmentEffectService.GetRtCostMultiplier) then
		return 1
	end
	return AugmentEffectService.GetRtCostMultiplier(unit, skillId)
end

--------------------------------------------------
-- SKILL MP COST (2026-10-07, level-based; project_rules 43 / frameworks 8)
-- ONE place that prices a cast, used by validation, commit, the turn prompt,
-- the inspector and the AI so they can never disagree (DAT-001):
--   base   = round(Base + Growth x (ESL - 1)) from the skill's DB formula
--            (GameConstants.CalcSkillMpCost; flat mpCost if no formula)
--   x race x trait x doctrine x augment MP modifiers, rounded ONCE
--   + Mana Burn extra round(Max MP x 0.20) (DB: "Total MP Spent = Skill MP Cost
--     + Extra") added after rounding.
-- Returns (totalMpCost, manaBurnExtra).
-- NOTE: the augment multiplier is now applied at COMMIT too. Before this, only
-- validation applied it, so augment MP surcharges/discounts were never charged.
--------------------------------------------------
function CommandService.GetSkillMpCost(actor: any, skillDef: any, skillId: any)
	if type(skillDef) ~= "table" or type(actor) ~= "table" then return 0, 0 end
	local sid = skillId or skillDef.id
	local mult = RacePassiveService.GetMpCostModifier(actor)
		* TraitEffectService.GetMpCostModifier(actor) -- Economist / Spendthrift
		-- Arcanist first-Skill flag: _docArcanistUsedSkill (set by OnSkillResolved, reset at turn start).
		-- Was _docFirstSkillUsed, which nothing ever set, so every Skill got the -25%. 2026-10-28.
		* DoctrinePassiveService.GetMpCostModifier(actor, actor._docArcanistUsedSkill ~= true)
		* AugmentEffectService.GetMpCostMultiplier(actor, sid)
	local mpCost = GameConstants.CalcSkillMpCost(actor, skillDef, mult)
	local manaBurnExtra = 0
	if StatusService.HasStatus(actor, "Mana Burn") then
		manaBurnExtra = math.round((actor.maxMp or 20) * 0.20)
	end
	return mpCost + manaBurnExtra, manaBurnExtra
end

-- Public summon wrapper for augment effects (2026-10-24): lets AugmentEffectService's
-- OnSkillComplete (Decoy/Turret Spawn) spawn next to the caster without reaching the local
-- spawnSummonFor. Minimal skillDef carries only the id (spawnSummonFor keys profiles by id);
-- nil target => nearest free tile to the caster. Injected via AugmentEffectService.SetSummonHandler.
function CommandService.SpawnAugmentSummon(actor: any, summonSkillId: any, state: any): boolean
	if not (actor and summonSkillId and state) then return false end
	local ok = spawnSummonFor(actor, { id = summonSkillId }, nil, state)
	return ok ~= false
end

-- HP / Blood Casting augments (2026-10-25). Resource-conversion casting:
--   HP Casting   — pays the skill's MP cost with HP instead (2 HP per 1 MP), no MP spent.
--   Blood Casting — pays the normal MP cost PLUS 3 HP per 1 MP (potency handled separately).
-- DESIGN DEFAULT (flagged, not authored): a cast may NOT reduce the caster below 1 HP — if the
-- HP cost can't be paid while staying >=1 HP, the cast is blocked exactly like insufficient MP
-- (no suicide-casting). CanPayCastCost validates (no mutation); PayCastCost spends. Both detect
-- the augment via AugmentEffectService.GetAugmentsForSkill; neither augment present = normal MP.
local function _castPayModes(actor: any, skillDef: any): (boolean, boolean)
	local hp, blood = false, false
	if skillDef and skillDef.id and AugmentEffectService.GetAugmentsForSkill then
		for _, a in ipairs(AugmentEffectService.GetAugmentsForSkill(actor, skillDef.id)) do
			if a == "AUG-HP-CASTING" then hp = true elseif a == "AUG-BLOOD-CASTING" then blood = true end
		end
	end
	return hp, blood
end

function CommandService.CanPayCastCost(actor: any, skillDef: any, mpCost: any): (boolean, string?)
	if CommandService.IsHpCostBlockedSkill(actor, skillDef) then
		return false, `{actor.name or "Unit"} is at 15% HP or less and can't use {skillDef.name or "this skill"}.`
	end
	local hp, blood = _castPayModes(actor, skillDef)
	if hp then
		local need = (mpCost or 0) * 2
		if (actor.currentHp or 0) - need < 1 then
			return false, (actor.name or "Unit") .. " lacks the HP to cast with HP Casting."
		end
		return true
	end
	if not UnitSchema.HasEnoughMp(actor, mpCost) then
		return false, (actor.name or "Unit") .. " does not have enough MP."
	end
	if blood then
		local need = (mpCost or 0) * 3
		if (actor.currentHp or 0) - need < 1 then
			return false, (actor.name or "Unit") .. " lacks the HP to cast with Blood Casting."
		end
	end
	return true
end

-- AREA / SPLASH HITS ON OBJECTS (project_rules 250, USER RULING 2026-11-07 10:53 PM). Run once per
-- completed skill action, AFTER its unit hits and tile effects. A DAMAGING skill hits every object on
-- the tiles it strikes besides a tile it already hit directly:
--   * tile-area patterns (Circle / Cross / Line / Cone / Ring / Spread / Impact / Adjacent tiles /
--     Aura ...): every struck pattern tile, centre included, a blocker's own tile included;
--   * unit-anchored shapes (Cleave, weapon-inherited ImpactSplash / Line2 / Cleave / Adjacent): the
--     splash tiles beside the primary;
--   * pattern augments on a single-target strike (Impact Splash, Line Projection, Piercing Shot,
--     Wide Arc; instant casts only, same as the unit pass): their extra tiles.
-- Chain and Bounce jump unit to unit and strike no area. Healing, shield, buff, summon, placing,
-- repair and revive skills never hit objects. One hit per object for the whole action.
-- Wasp Nest ruling (objects_encounters 124, 2026-11-07 11:05 PM): a Venom attack (Toxic Needle) is not
-- a Poison-element kill on a map object - ApplyObjectHit lands one normal hit instead.
local function skillAppliesVenom(skillDef: any): boolean
	if not skillDef then return false end
	if skillDef.appliesStatus == "Venom" then return true end
	for _, s in ipairs(skillDef.appliesStatuses or {}) do
		if s == "Venom" then return true end
	end
	return false
end

local function isDamagingSkillForObjects(actor: any, skillDef: any): boolean
	if not skillDef or skillDef.isShield or (skillDef.power or 0) <= 0 then return false end
	if skillDef.isHealing and not hasCardTag(skillDef, "Direct Damage") then return false end
	if skillDef.isSummon or skillDef.createsObject or skillDef.repairsObject or skillDef.isRevive
		or skillDef.raisesCorpses or skillDef.isPurify or skillDef.targetRules == "Self" then
		return false
	end
	if isPureBuffAura(skillDef) or usesSharedResolve(actor, skillDef) then return false end
	return true
end

local function splashObjectsForSkill(state: any, actor: any, skillDef: any, target: any, withAugments: boolean)
	if not (state and actor and skillDef and target and target.tileX and target.tileY) then return end
	if not isDamagingSkillForObjects(actor, skillDef) then return end
	local p = skillDef.aoePattern
	-- D6 (re-UAT 2026-11-08): only a WEAPON pattern (InheritWeapon) uses the weapon-style tiles beside
	-- the target. A skill's own aoePattern uses the same tiles as its unit pass (GetAOETargetTiles), so
	-- a skill "Adjacent" (Venom Burst) hits all 8 tiles around the target, not the 2 flank tiles.
	local fromWeapon = p == "InheritWeapon"
	if fromWeapon then p = actor.weaponPattern end
	local primaryUnit = if target.isGroundTarget then nil else target
	local tiles = {}
	if type(p) == "string" and p ~= "Single" and string.sub(p, 1, 5) ~= "Chain" then
		if p == "Cleave" or (fromWeapon and (p == "Adjacent" or p == "ImpactSplash" or p == "Line2" or p == "Line3")) then
			tiles = TargetingService.GetSplashTilesBeside(actor, p, target.tileX, target.tileY, primaryUnit)
		else
			tiles = TargetingService.GetAreaObjectTiles(p, actor, target.tileX, target.tileY, _mapWidth, _mapHeight)
		end
	end
	if withAugments and (p == nil or p == "Single") and primaryUnit and not actor._skillFizzled
		and skillDef.id and AugmentEffectService.GetAugmentsForSkill then
		local mode = nil
		for _, a in ipairs(AugmentEffectService.GetAugmentsForSkill(actor, skillDef.id)) do
			if a == "AUG-IMPACT-SPLASH" then mode = "splash" break
			elseif a == "AUG-LINE-PROJECTION" or a == "AUG-PIERCING-SHOT" then mode = "line" break
			elseif a == "AUG-WIDE-ARC" then mode = "arc" break
			elseif a == "AUG-BOUNCE-SHOT" then break
			end
		end
		if mode then
			tiles = TargetingService.GetSplashTilesBeside(actor, mode, target.tileX, target.tileY, primaryUnit)
		end
	end
	if #tiles == 0 then return end
	local elem = CombatResolver.ExtractSkillElement(skillDef) or "Physical"
	ObjectEffectService.HitObjectsOnTiles(state, tiles, actor, elem, {}, skillAppliesVenom(skillDef))
end

-- Doctrine post-skill bookkeeping (2026-10-28): Ascetic MP restore, Sentinel / Shieldbearer charge
-- consumption, Monk same-target count, Elementalist last element, Paladin Divine Aegis, Arcanist /
-- Trickster once-per-turn flags. Called once per completed skill on every resolution path.
-- Doctrine cast context (2026-10-28), set once when a skill starts resolving and cleared by
-- doctrineAfterSkill: Stormbringer counts the units the cast will hit; Plague Doctor needs the
-- cast element so its Dark-skill debuffs can ignore 15% Debuff Resistance.
local function countSkillHits(actor: any, skillDef: any, target: any, units: any): number
	local p = skillDef.aoePattern
	if not (target and target.tileX and target.tileY) or p == nil or p == "Single" then return 1 end
	local n = 0
	if p == "Cleave" then
		for _, u in ipairs(TargetingService.GetCleaveTargets(actor, target, units, cleaveAnySide(skillDef))) do
			if u.isAlive then n += 1 end
		end
	elseif string.sub(p, 1, 5) == "Chain" then
		local maxTargets = tonumber(string.match(p, "%d+")) or 3
		for _, u in ipairs(TargetingService.GetChainTargets(target, units, actor.side, maxTargets, 2)) do
			if u.isAlive then n += 1 end
		end
	elseif p == "InheritWeapon" then
		local wp = actor.weaponPattern
		local list = if wp and wp ~= "Single" then weaponPatternTargets(actor, target, units, wp) else nil
		if list then
			for _, e in ipairs(list) do
				if e.unit and e.unit.isAlive then n += 1 end
			end
		else
			n = 1
		end
	else
		local tiles = TargetingService.GetAOETargetTiles(p, actor, target.tileX, target.tileY, _mapWidth, _mapHeight)
		local centerElev = GameConstants.GetElevation(target.tileX, target.tileY)
		for _, tile in ipairs(tiles or {}) do
			if math.abs(GameConstants.GetElevation(tile.tileX, tile.tileY) - centerElev) <= 2
				and not TargetingService.IsAOEBlocked(target.tileX, target.tileY, tile.tileX, tile.tileY) then
				for _, u in ipairs(units) do
					if u.isAlive and u.tileX == tile.tileX and u.tileY == tile.tileY and u.id ~= actor.id then n += 1 end
				end
			end
		end
	end
	return math.max(1, n)
end

local function doctrineBeginCast(actor: any, skillDef: any, target: any, state: any)
	if not (actor and skillDef) then return end
	local _, element = DoctrinePassiveService.BuildSkillContext(skillDef, 0)
	-- Plague Doctor Virulence: "Dark-tagged debuffs" -- a skill that CARRIES the Dark tag counts even
	-- when Dark is not its first element tag (Festering Wound: Poison, Dark). Checklist fix 2026-10-29.
	if actor.doctrineId == "DOC-PLAGUE-DOCTOR" then
		for _, _t in ipairs(skillDef.tags or {}) do
			if _t == "Dark" then element = "Dark" break end
		end
	end
	actor._docCastElement = element
	actor._docCastingSkill = true  -- Geomancer: terrain made now comes from a Skill (2026-10-29)
	actor._docCastTargetCount = nil
	if actor.doctrineId == "DOC-STORMBRINGER" and state and state.units then
		local ok, n = pcall(countSkillHits, actor, skillDef, target, state.units)
		actor._docCastTargetCount = if ok then n else 1
	end
end

local function doctrineAfterSkill(actor: any, target: any, skillDef: any, mpCost: any, deferred: any)
	if actor then
		actor._docCastingSkill = nil
		actor._docCastElement = nil
		actor._docCastTargetCount = nil
	end
	if not (actor and actor.isAlive and skillDef) then return end
	local hpCast = _castPayModes(actor, skillDef)
	local ctx, element = DoctrinePassiveService.BuildSkillContext(skillDef, if hpCast then 0 else mpCost)
	ctx.deferred = deferred == true -- channeled activation: once-per-turn flags were marked at commit
	DoctrinePassiveService.OnSkillResolved(actor, target, element, ctx)
end

function CommandService.PayCastCost(actor: any, skillDef: any, mpCost: any)
	-- Blood Price HP cost (2026-11-08): plain HP change, floor 1 HP; logged with its own cause label.
	local hpCost = CommandService.GetHpCastCost(actor, skillDef)
	if hpCost > 0 then
		local before = actor.currentHp or 1
		actor.currentHp = math.max(1, before - hpCost)
		if BattleVisualBroadcaster.UnitStateChanged then BattleVisualBroadcaster.UnitStateChanged(actor, skillDef.name or "Blood Price") end
		print(`[CommandService] HP COST [{skillDef.name or skillDef.id}] | {actor.name} pays {before - actor.currentHp} HP ({before} -> {actor.currentHp})`)
	end
	local hp, blood = _castPayModes(actor, skillDef)
	if hp then
		local need = (mpCost or 0) * 2
		if need > 0 then actor.currentHp = math.max(1, (actor.currentHp or 1) - need) end
		-- Cause label so the battle log attributes the HP cost (was an 'uncaused hpLoss' warn, sweep 2026-11-06).
		if BattleVisualBroadcaster.UnitStateChanged then BattleVisualBroadcaster.UnitStateChanged(actor, "HP Casting") end
		return
	end
	UnitSchema.SpendMp(actor, mpCost)
	if blood then
		local need = (mpCost or 0) * 3
		if need > 0 then actor.currentHp = math.max(1, (actor.currentHp or 1) - need) end
		if BattleVisualBroadcaster.UnitStateChanged then BattleVisualBroadcaster.UnitStateChanged(actor, "Blood Casting") end
	end
end

-- LEAP STRIKE landing (Dragon Dive; DB SKL-DRAGON-DIVE): after the hit the caster lands on the
-- target tile. If that tile is still occupied (target survived) or blocked, it lands on the nearest
-- free tile next to it (closest to the caster). No free tile = stays put. Not a Move action.
local function landLeapStrike(caster: any, tileX: any, tileY: any, state: any)
	if not (caster and caster.isAlive and tileX and tileY and state and state.units) then
		return
	end
	if caster.tileX == tileX and caster.tileY == tileY then
		return
	end
	local function isFree(x: number, y: number): boolean
		if x < 1 or x > _mapWidth or y < 1 or y > _mapHeight or GameConstants.IsBlocked(x, y) then
			return false
		end
		for _, u in ipairs(state.units) do
			if u.isAlive and u.id ~= caster.id and u.tileX == x and u.tileY == y then
				return false
			end
		end
		return true
	end
	local landX, landY = nil, nil
	if isFree(tileX, tileY) then
		landX, landY = tileX, tileY
	else
		local bestDist, bestSq = math.huge, math.huge
		for dy = -1, 1 do
			for dx = -1, 1 do
				local cx, cy = tileX + dx, tileY + dy
				if (dx ~= 0 or dy ~= 0) and isFree(cx, cy) then
					local d = math.max(math.abs(caster.tileX - cx), math.abs(caster.tileY - cy))
					local sq = (caster.tileX - cx) ^ 2 + (caster.tileY - cy) ^ 2
					if d < bestDist or (d == bestDist and sq < bestSq) then
						landX, landY, bestDist, bestSq = cx, cy, d, sq
					end
				end
			end
		end
	end
	if landX then
		-- Dodger / Sitting Duck (DB "per tile traveled, using skill or by move"), 2026-10-29.
		TraitEffectService.AccumulateMoveEvasion(caster, math.max(math.abs(landX - caster.tileX), math.abs(landY - caster.tileY)))
		caster.tileX, caster.tileY = landX, landY
		BattleVisualBroadcaster.UnitMoved(caster)
		applyLandingEntry(caster, state)
		print(string.format("[CommandService] LEAP STRIKE | %s lands at (%d,%d)", caster.name, landX, landY))
	else
		print(string.format("[CommandService] LEAP STRIKE | %s found no free landing tile near (%d,%d); stays put",
			caster.name, tileX, tileY))
	end
end

-- DUAL heal/damage single-target skill (Dark Restoration; DB SKL-DARK-RESTORATION): it heals the
-- caster or an Undead ally; any other unit takes Dark damage (Dark vs Undead heals per normal rules).
local function isDualHealDamage(skillDef: any): boolean
	return skillDef.isHealing == true and skillDef.aoePattern == nil and hasCardTag(skillDef, "Direct Damage")
end

local function dualHealsTarget(caster: any, target: any): boolean
	return target.id == caster.id or (target.side == caster.side and CombatResolver.IsUndead(target))
end

-- OFFENSIVE ACTION (DB elements_statuses Hide: "Revealed by attack/skill/offensive action"). Used by
-- both resolution paths for the Hide reveal and the counter gate, so they always agree:
--   * Dark Restoration: offensive only when it took its damage branch (not a heal on self/Undead ally)
--   * any skill whose card shows "Direct Damage" or "Debuff"
--   * a non-Buff/Healing/Shield skill used on a hostile unit (e.g. Steal)
-- Self buffs (Vanishing Step, Battle Fury, stances) are NOT offensive, so casting Hide keeps it.
local function isOffensiveCast(caster: any, skillDef: any, target: any): boolean
	local onUnit = target ~= nil and not target.isGroundTarget and target.id ~= nil
	if isDualHealDamage(skillDef) then
		return onUnit and not dualHealsTarget(caster, target)
	end
	-- Shields are never offensive, even Retribution Shell (its damage only fires when the shield
	-- breaks, from the attacker's hit). UAT 2026-10-27 D1.
	if skillDef.isShield or hasCardTag(skillDef, "Shield") then
		return false
	end
	if hasCardTag(skillDef, "Direct Damage") or hasCardTag(skillDef, "Debuff") then
		return true
	end
	if onUnit and target.side ~= caster.side and target.id ~= caster.id
		and not (hasCardTag(skillDef, "Buff") or hasCardTag(skillDef, "Healing") or hasCardTag(skillDef, "Shield")) then
		return true
	end
	return false
end

-- Damage side of a dual skill. Dark Restoration power follows its card:
-- (12 + 0.30L + 0.35INT + Weapon Damage x 0.35) x Skill Potency, then normal defense/element rules.
local function resolveDualDamage(caster: any, target: any, skillDef: any, state: any): (any, number, any)
	local dmgDef = table.clone(skillDef)
	dmgDef.isHealing = false
	if skillDef.id == "SKL-DARK-RESTORATION" then
		dmgDef.flatPower = CombatResolver.EstimateDarkRestorationPower(caster)  -- same card power as its heal
	end
	local wasAlive = target.isAlive
	local outcome = CombatResolver.ResolveSkill(caster, target, dmgDef)
	local dealt, statusApplied = CombatResolver.ApplyOutcome(outcome, target, caster)
	dealt = dealt or outcome.finalDamage or outcome.finalHealing or 0
	if wasAlive and not target.isAlive then
		trySpawnSoulEcho(caster, skillDef, target, dealt, state)
	end
	return outcome, dealt, statusApplied
end

--------------------------------------------------
-- SKILL HIT PREVIEW (2026-10-30, user request: damage preview for tile-aimed skills, areas included)
-- Read-only: lists every unit a skill would affect if cast on (tileX, tileY) right now, with the
-- predicted amount. Uses only the pure calculators (CombatResolver.ResolveSkill / ResolveHealing /
-- EstimateShield never write to units; every consume step -- Evasion Surge charges, Countermeasure
-- blocks, Reprisal -- lives in ApplyOutcome, which is never called here). Follows the instant-path
-- dispatch order in ValidateAndCommit with the SAME hit-list helpers, so preview and real hit pick
-- the same units. Channeled skills are previewed as if cast now (area skills hit the area, so a unit
-- that walks out before the channel lands is not hit). Hide protects: a hidden enemy is never listed
-- (it is still hit for real). MIRRORS -- keep in sync when these change: the commit-time cast clones
-- (Mana Surge, Blood Casting, Concentrated Effect, Chain Support, Evasion Surge), the instant
-- dispatch branches, and the single-target pattern augments. Known estimate: multi-hit skills
-- (Storm Barrage, Rapid Assault...) are shown as hits x one hit and flagged approx.
--------------------------------------------------
local function previewCastDef(actor: any, skillDef: any): any
	local def = skillDef
	local augs = {}
	if def.id and AugmentEffectService.GetAugmentsForSkill then
		augs = AugmentEffectService.GetAugmentsForSkill(actor, def.id) or {}
	end
	local function hasAug(augId: string): boolean
		for _, a in ipairs(augs) do
			if a == augId then return true end
		end
		return false
	end
	local function potencyScaled(d: any): boolean
		return (d.power or 0) > 0 or d.isHealing == true or d.isShield == true
	end
	if def.id ~= "DOC-ARCANIST-01" and StatusService.HasStatus(actor, "Mana Surge") and potencyScaled(def) then
		local c = table.clone(def)
		c.potencyBonusMult = (def.potencyBonusMult or 1) * ((GameConstants.STATUSES["Mana Surge"] or {}).potencyBonusMult or 1.10)
		def = c
	end
	local _hp, blood = _castPayModes(actor, def)
	if blood and potencyScaled(def) then
		local c = table.clone(def)
		c.potencyBonusMult = (def.potencyBonusMult or 1) * 1.10
		def = c
	end
	if hasAug("AUG-CONCENTRATED-EFFECT") and def.aoePattern ~= nil
		and (def.aoePattern ~= "InheritWeapon" or (actor.weaponPattern or "Single") ~= "Single") then
		local c = table.clone(def)
		c.aoePattern = nil
		c.potencyBonusMult = (def.potencyBonusMult or 1) * 1.25
		def = c
	end
	if hasAug("AUG-CHAIN-SUPPORT") and (def.aoePattern == nil or def.aoePattern == "InheritWeapon")
		and (def.power or 0) > 0 and not def.isHealing and not def.isShield then
		local c = table.clone(def)
		c.aoePattern = "Chain3"
		c.chainFalloff = 0.75
		def = c
	end
	if hasAug("AUG-EVASION-SURGE") and (def.power or 0) > 0 and not def.isHealing and not def.isShield then
		local c = table.clone(def)
		c.potencyBonusMult = (def.potencyBonusMult or 1) * 0.85
		def = c
	end
	return def, augs
end

-- Body of the preview (who is hit, for how much). The public CommandService.PreviewSkillHits below
-- wraps it and adds each unit's turn delay (2026-11-08 7:14 PM).
local function previewSkillHitsBase(state: any, actor: any, baseDef: any, tileX: number, tileY: number): { any }
	local entries = {}
	if not (state and state.units and actor and baseDef and tileX and tileY) then
		return entries
	end
	-- LUNGE (2026-11-08): the hit lands from the tile the caster steps onto, so preview it from there.
	-- The caster is placed there only for this read-only calculation and put straight back (no yield).
	if baseDef.stepsToTargetFirst and not actor._lungePreviewing then
		local step = CommandService.LungeStepTile(actor, { tileX = tileX, tileY = tileY }, state)
		if not step then
			return entries  -- no tile to step onto: the cast would be refused
		end
		local homeX, homeY = actor.tileX, actor.tileY
		actor._lungePreviewing = true
		actor.tileX, actor.tileY = step.x, step.y
		local okPrev, res = pcall(CommandService.PreviewSkillHits, state, actor, baseDef, tileX, tileY)
		actor.tileX, actor.tileY = homeX, homeY
		actor._lungePreviewing = nil
		if not okPrev then
			error(res, 0)
		end
		return res
	end
	local skillDef, augs = previewCastDef(actor, baseDef)
	local units = state.units
	local p = skillDef.aoePattern
	local statusIds = {}
	if skillDef.appliesStatus then table.insert(statusIds, skillDef.appliesStatus) end
	for _, sid in ipairs(skillDef.appliesStatuses or {}) do table.insert(statusIds, sid) end
	-- Rule 252 rider status (Movement Slow: Static Field / Fissure Line) shows like any status.
	if skillDef.riderStatus then table.insert(statusIds, skillDef.riderStatus) end
	local healStatusIds = if skillDef.healAppliesStatus then { skillDef.healAppliesStatus } else {}
	-- Statuses one unit would get, minus a main status it will not receive: Glacial Wave's Frozen
	-- needs Wet already (appliesStatusRequires); Voltaic Chain's Pinned lands on the last link only.
	local function statusesWithout(dropMain: boolean): any
		if not dropMain or not skillDef.appliesStatus then return nil end
		local out = {}
		for _, sid in ipairs(statusIds) do
			if sid ~= skillDef.appliesStatus then table.insert(out, sid) end
		end
		return out
	end

	local byId = {}
	local function add(u: any, kind: string, amount: number?, approx: boolean?, statusOverride: any?)
		if not u then return end
		-- Hide protects: never reveal a hidden enemy through the preview.
		if u.side ~= actor.side and StatusService.HasStatus(u, "Hide") then return end
		local amt = math.max(0, math.round(amount or 0))
		local e = byId[u.id]
		if e then
			if e.kind ~= kind then return end
			e.amount += amt
		else
			e = {
				unitId = u.id, name = u.name, side = u.side, kind = kind, amount = amt,
				hpBefore = u.currentHp or 0, maxHp = u.maxHp or (u.currentHp or 0),
				statuses = statusOverride or (if kind == "healing" then healStatusIds else statusIds),
			}
			byId[u.id] = e
			table.insert(entries, e)
		end
		if approx then e.approx = true end
		if e.kind == "damage" then
			e.hpAfter = math.max(0, e.hpBefore - e.amount)
		elseif e.kind == "healing" then
			e.hpAfter = math.min(e.maxHp, e.hpBefore + e.amount)
		else
			e.hpAfter = e.hpBefore
		end
	end
	-- One ResolveSkill hit (x mult, x nHits). Undead reversal comes back as Healing.
	local function hitWith(u: any, def: any, mult: number?, nHits: number?, dropMainStatus: boolean?)
		local n = nHits or 1
		local o = CombatResolver.ResolveSkill(actor, u, def)
		local so = statusesWithout(dropMainStatus == true
			or (def.appliesStatusRequires ~= nil and def.appliesStatus ~= nil and o.appliesStatus == nil))
		if o.type == "Healing" then
			-- Dark vs Undead heal shown with the same falloff as damage (user ruling 2026-11-06).
			add(u, "healing", math.max(0, math.round((o.finalHealing or 0) * (mult or 1))) * n, n > 1)
		elseif (def.power or 0) == 0 and (o.finalDamage or 0) == 0 then
			add(u, "status", 0, nil, so)
		else
			local per = math.max(0, math.round((o.finalDamage or 0) * (mult or 1)))
			-- BUG-110: each hit that reduces HP (after shields, W2) on a Bleeding target adds the
			-- Bleed bonus (same helper as ApplyOutcome; 0 for non-physical hits).
			local bleed = CombatResolver.PredictBleedBonus(u, actor, o.element, per, n)
			add(u, "damage", per * n + bleed, n > 1, so)
		end
	end
	local function healWith(u: any)
		local o = CombatResolver.ResolveHealing(actor, u, skillDef)
		if o.finalHealing ~= nil then
			add(u, "healing", o.finalHealing)
		else
			add(u, "damage", o.finalDamage or 0)  -- Undead healing reversal
		end
	end
	-- Tile-area units: same elevation (+/-2) and BlocksAOE rules as every area branch.
	local function areaUnits(includeCaster: boolean): { any }
		local list = {}
		local tiles = TargetingService.GetAOETargetTiles(p, actor, tileX, tileY, _mapWidth, _mapHeight)
		local centerElev = GameConstants.GetElevation(tileX, tileY)
		for _, tile in ipairs(tiles or {}) do
			if math.abs(GameConstants.GetElevation(tile.tileX, tile.tileY) - centerElev) <= 2
				and not TargetingService.IsAOEBlocked(tileX, tileY, tile.tileX, tile.tileY) then
				for _, u in ipairs(units) do
					if u.isAlive and not u.isGroundTarget and u.tileX == tile.tileX and u.tileY == tile.tileY
						and (includeCaster or u.id ~= actor.id) then
						table.insert(list, u)
					end
				end
			end
		end
		return list
	end

	local tgt = findLiveTileOccupant(state, tileX, tileY)
	local anchored = isUnitAnchoredPattern(skillDef)
	local nHits = skillHitCount(actor, skillDef)

	-- No unit is struck by these (spawn / place / repair / corpse-only).
	if skillDef.raisesCorpses or skillDef.isSummon or skillDef.createsObject
		or skillDef.repairsObject or skillDef.isRevive then
		return entries
	end
	if skillDef.isShield then
		local mainHand = actor.equipmentSlots and actor.equipmentSlots.MainHand
		local skillLevelL = (mainHand and mainHand.itemLevel) or 1
		if p then
			local radius = tonumber(tostring(p):match("%d+")) or 2
			local anySide = isCasterArea(skillDef) and not skillDef.alliesOnly  -- Bulwark Field: allies only
			for _, u in ipairs(units) do
				if u.isAlive and (anySide or u.side == actor.side)
					and math.max(math.abs((u.tileX or 0) - actor.tileX), math.abs((u.tileY or 0) - actor.tileY)) <= radius then
					add(u, "shield", CombatResolver.EstimateShield(actor, skillDef, skillLevelL))
				end
			end
		elseif tgt then
			add(tgt, "shield", CombatResolver.EstimateShield(actor, skillDef, skillLevelL))
		end
		return entries
	end
	if skillDef.isHealing and hasCardTag(skillDef, "Direct Damage") and p ~= nil and not anchored then
		for _, u in ipairs(areaUnits(false)) do hitWith(u, skillDef, 1, 1) end  -- area drain
		return entries
	end
	if skillDef.isHealing and not hasCardTag(skillDef, "Direct Damage") and p ~= nil and not anchored then
		for _, u in ipairs(areaUnits(true)) do
			-- alliesOnly (Consecrate, Sanctify; 2026-11-08): enemies in the area are not shown / not healed.
			if not skillDef.alliesOnly or u.side == actor.side then healWith(u) end
		end  -- area heal (caster included)
		return entries
	end
	-- Life Link (2026-11-08): makes a link, heals nobody now.
	if skillDef.isLifeLink then
		if tgt and tgt.id ~= actor.id and tgt.side == actor.side then add(tgt, "status", 0, nil, {}) end
		return entries
	end
	-- Unit-anchored skill on an empty tile: terrain/object reaction only, no unit is hit.
	if anchored and not tgt then
		return entries
	end
	if isDualHealDamage(skillDef) and tgt and not dualHealsTarget(actor, tgt) then
		local d = table.clone(skillDef)
		d.isHealing = false
		if skillDef.id == "SKL-DARK-RESTORATION" then
			d.flatPower = CombatResolver.EstimateDarkRestorationPower(actor)
		end
		hitWith(tgt, d, 1, 1)
		return entries
	end
	if skillDef.isHealing then
		if tgt then healWith(tgt) end
		return entries
	end
	if isPureBuffAura(skillDef) then
		for _, u in ipairs(auraTargets(state, actor, skillDef)) do add(u, "status", 0) end
		return entries
	end
	if p == "Cleave" then
		for _, u in ipairs(TargetingService.GetCleaveTargets(actor, tgt, units, cleaveAnySide(skillDef))) do
			if u.isAlive then hitWith(u, skillDef, 1, 1) end
		end
		return entries
	end
	if p and string.sub(p, 1, 5) == "Chain" then
		local maxTargets = tonumber(string.match(p, "%d+")) or 3
		local falloff = 1.0
		local rate = skillDef.chainFalloff or 0.80
		local chainList = TargetingService.GetChainTargets(tgt, units, actor.side, maxTargets, 2)
		for idx, u in ipairs(chainList) do
			if u.isAlive then
				-- Voltaic Chain: Pinned shown on the last link only (statusLastChainOnly).
				hitWith(u, skillDef, falloff, 1, skillDef.statusLastChainOnly == true and idx ~= #chainList)
				falloff *= rate
			end
		end
		return entries
	end
	if p and p ~= "InheritWeapon" then
		for _, u in ipairs(areaUnits(false)) do hitWith(u, skillDef, 1, 1) end
		return entries
	end
	if p == "InheritWeapon" and (actor.weaponPattern or "Single") ~= "Single" then
		local list = weaponPatternTargets(actor, tgt, units, actor.weaponPattern)
		for _, e in ipairs(list or {}) do
			if e.unit and e.unit.isAlive then hitWith(e.unit, skillDef, e.dmgMult or 1, nHits) end
		end
		return entries
	end
	-- Single-target branches (same order as the instant path).
	if not tgt then
		return entries
	end
	if skillDef.isPurify then
		add(tgt, "status", 0, nil, { "Purified" })
		return entries
	end
	if skillDef.relocatesAllyAdjacent and tgt.side == actor.side and tgt.id ~= actor.id then
		add(tgt, "status", 0)
		return entries
	end
	if usesSharedResolve(actor, skillDef) then
		for _, u in ipairs(sharedResolveTargets(state, actor)) do add(u, "status", 0) end
		return entries
	end
	if skillDef.targetRules == "Self" or tgt.id == actor.id then
		add(actor, "status", 0)
		return entries
	end
	if skillDef.swapWithTarget and tgt.side == actor.side then
		add(tgt, "status", 0)
		return entries
	end
	if (tgt.side == actor.side or (hasCardTag(skillDef, "Buff") and not hasCardTag(skillDef, "Debuff")))
		and (skillDef.power or 0) == 0 and (skillDef.appliesStatus or skillDef.appliesStatuses) then
		add(tgt, "status", 0)  -- ally / any-side buff
		return entries
	end
	hitWith(tgt, skillDef, 1, nHits)
	-- Single-target pattern augments add secondary hits. Instant casts only: the channeled
	-- resolver (ActivateChanneledSkill) does not run them.
	local hasChannel = (skillDef.channelTime or 0) > 0
	if not hasChannel and (skillDef.power or 0) > 0 and not skillDef.isHealing and not skillDef.isShield then
		local mode, mult = nil, nil
		for _, a in ipairs(augs) do
			if a == "AUG-IMPACT-SPLASH" then mode, mult = "splash", 0.50 break
			elseif a == "AUG-LINE-PROJECTION" then mode, mult = "line", 0.75 break
			elseif a == "AUG-PIERCING-SHOT" then mode, mult = "line", 0.60 break
			elseif a == "AUG-WIDE-ARC" then mode, mult = "arc", 0.40 break
			elseif a == "AUG-BOUNCE-SHOT" then mode, mult = "bounce", 0.50 break
			end
		end
		local extra = {}
		if mode == "splash" then
			for _, e in ipairs(TargetingService.GetImpactSplashTargets(actor, tgt, units)) do
				if e.unit and e.unit.id ~= tgt.id then table.insert(extra, e.unit) end
			end
		elseif mode == "line" then
			for _, e in ipairs(TargetingService.GetLine2Targets(actor, tgt, units)) do
				if e.unit and e.unit.id ~= tgt.id then table.insert(extra, e.unit) end
			end
		elseif mode == "arc" then
			for _, u in ipairs(TargetingService.GetCleaveTargets(actor, tgt, units, true)) do
				if u.id ~= tgt.id then table.insert(extra, u) end
			end
		elseif mode == "bounce" then
			local best, bestD = nil, math.huge
			for _, u in ipairs(units) do
				if u.isAlive and u.side ~= actor.side and u.side ~= "Neutral" and not u.isGroundTarget
					and u.id ~= tgt.id and u.tileX then
					local d = math.max(math.abs(u.tileX - tgt.tileX), math.abs((u.tileY or 0) - (tgt.tileY or 0)))
					if d <= 3 and d < bestD then best, bestD = u, d end
				end
			end
			if best then table.insert(extra, best) end
		end
		for _, u in ipairs(extra) do
			if u.isAlive then hitWith(u, skillDef, mult, 1) end
		end
	end
	return entries
end

-- SKILL HIT PREVIEW turn delay (USER RULING 2026-11-08 7:14 PM: the hit preview shows the same
-- numbers as the real hit). For skills with an authored area turn delay (the rule-252 rider skills)
-- each listed unit gets rtDelay = what the real hit adds: same formula (skillActualRtDelay) and the
-- same main / side split as applyAreaRiders (main = the unit on the aimed tile). No rtDelay for the
-- caster, shield entries, or a unit the hit would KO (the real hit gives them none). Every other
-- skill's entries are unchanged. Read-only, like the body.
function CommandService.PreviewSkillHits(state: any, actor: any, baseDef: any, tileX: number, tileY: number): { any }
	local entries = previewSkillHitsBase(state, actor, baseDef, tileX, tileY)
	if #entries == 0 or not (state and state.units and actor and baseDef) then
		return entries
	end
	local skillDef = previewCastDef(actor, baseDef)
	if not (skillDef.riderDelayWeaponMult or skillDef.riderDelayFlat) then
		return entries
	end
	local byUnitId = {}
	for _, u in ipairs(state.units) do
		if u.id then
			byUnitId[u.id] = u
		end
	end
	local mainId = if skillDef.riderDelaySideFrac
		then riderMainUnitId(state, { tileX = tileX, tileY = tileY, isGroundTarget = true })
		else nil
	for _, e in ipairs(entries) do
		local u = byUnitId[e.unitId]
		if u and u.id ~= actor.id and not u.isObject and e.kind ~= "shield"
			and not (e.kind == "damage" and (e.hpAfter or 1) <= 0) then
			local d = skillActualRtDelay(actor, u, skillDef, riderSideDelayMult(skillDef, u, mainId))
			e.rtDelay = if d > 0 then d else nil
		end
	end
	return entries
end


-- LOADOUT REPLICATOR (UTI-020): put every copied slot back to the Replicator. Accepts a list or
-- a dictionary of units (state.units / Main's playerUnits). Called at battle end before the save.
function CommandService.RevertReplicatedItems(units: any)
	for _, u in pairs(units or {}) do
		for _, s in pairs((type(u) == "table" and u.consumableSlots) or {}) do
			local o = type(s) == "table" and s._replicatorOrig or nil
			if o then
				s.consumableId, s.currentCharges, s.maxCharges, s.name = o.consumableId, o.currentCharges, o.maxCharges, o.name
				s._replicatorOrig = nil
			end
		end
	end
end

-- Save-safe consumable slots: a replicated slot is written as the Replicator it really is.
-- Returns the same table when nothing is replicated.
function CommandService.SaveableConsumableSlots(slots: any): any
	if type(slots) ~= "table" then return slots end
	local any = false
	for _, s in pairs(slots) do
		if type(s) == "table" and s._replicatorOrig then any = true break end
	end
	if not any then return slots end
	local out = {}
	for k, s in pairs(slots) do
		if type(s) == "table" and s._replicatorOrig then
			local o = s._replicatorOrig
			local c = table.clone(s)
			c.consumableId, c.currentCharges, c.maxCharges, c.name = o.consumableId, o.currentCharges, o.maxCharges, o.name
			c._replicatorOrig = nil
			out[k] = c
		else
			out[k] = s
		end
	end
	return out
end

-- Job 3 (USER RULING 2026-11-09 12:04 AM, rule 255): a channelled single-target skill whose reach is melee:
-- fixed range 1 (Crushing Advance, Field Dressing, Feinting Flurry, Overwhelming Blow, Mug) or weapon range
-- with a melee weapon (no projectile type: Shatter Point, Rapid Assault, Precise Disarm, Execution Stroke on a
-- Single-pattern weapon). Steal keeps its own rear-tile check; leaps / dashes / steps move the caster
-- themselves; revives and summons keep their own rules.
--- Is this skill cast deferred (channel, or a zero-channel skill with an activation wait that
--- ActivateChanneledSkill resolves)? Single source for the commit announce and the channel setup.
--- Returns activationCt (before zeroing), hasChannel, deferZeroChannel.
local function skillDeferral(actor: any, skillDef: any): (number, boolean, boolean)
	if not skillDef then return 0, false, false end
	-- ACTIVATION TIME (2026-10-07): authored per skill in Content.SkillData, not
	-- DEX-reduced (frameworks 10/37). A channeled skill waits channel + activation.
	-- A ZERO-channel skill with activation > 0 is deferred only when its kind is one
	-- the deferred resolver (ActivateChanneledSkill) already handles in full:
	-- shield, summon, heal, or an area pattern (not weapon-inherited). Other
	-- zero-channel skills (single-target strikes with counters/RT delay/charge,
	-- swaps, self-buffs) stay instant until that resolver supports them.
	-- Flash-Caster / Laggy Caster (P/F-079): skill delay x0.75 / x1.25.
	local activationCt = math.round(GameConstants.GetSkillActivationTime(skillDef.id) * TraitEffectService.GetSkillDelayMultiplier(actor))
	local hasChannel = (skillDef.channelTime and skillDef.channelTime > 0) == true
	local deferZeroChannel = ((not hasChannel) and activationCt > 0
		and (skillDef.isShield or skillDef.isSummon or skillDef.isHealing or skillDef.swapWithTarget
			or (skillDef.aoePattern ~= nil and skillDef.aoePattern ~= "InheritWeapon")
			or skillDef.createsObject ~= nil)
		and not skillDef.isCharge) and true or false
	return activationCt, hasChannel, deferZeroChannel
end

local function isMeleeReachChannel(unit: any, skillDef: any): boolean
	if skillDef.id == "SKL-STEAL" or skillDef.isLeapStrike or skillDef.leapsAdjacent
		or skillDef.stepsToTargetFirst or skillDef.isRevive or skillDef.isSummon then
		return false
	end
	local p = skillDef.aoePattern
	-- USER RULING 2026-11-09 10:44 AM: a weapon-pattern skill (Execution Stroke, Storm Barrage) on a reach weapon
	-- whose pattern is not next to the caster (Spear Line2) neither follows nor stays put: it fizzles like a
	-- Single weapon when the moved caster is out of reach. Cleave / Adjacent keep the Job 4 follow rule.
	local wp = unit.weaponPattern or "Single"
	local single = p == nil or p == "Single" or (p == "InheritWeapon" and wp ~= "Cleave" and wp ~= "Adjacent")
	if not single then
		return false
	end
	if skillDef.range == 1 then
		return true
	end
	return skillDef.range == -1 and unit.weaponProjectileType == nil
end

function CommandService.ActivateChanneledSkill(state: any, unit: any): (boolean, any)
	unit._skillFizzled = false
	if not unit.isChanneling or not unit.channelingData then
		return false, "Unit is not channeling."
	end
	if state and state.units and AugmentEffectService.SetBattleUnits then
		AugmentEffectService.SetBattleUnits(state.units)
		_augKnockState = state
		if CombatResolver.BeginResolution then CombatResolver.BeginResolution() end  -- Countermeasure: one block per resolution
	end

	local data     = unit.channelingData
	local skillDef: any = data.skillDef
	local target: any   = data.target
	local mpCost   = data.mpCost or 0
	-- Self skills (Mana Surge) resolve on the caster even if no target was stored.
	if not target and skillDef and skillDef.targetRules == "Self" then target = unit end

	-- Clear channeling state first (regardless of outcome)
	unit.isChanneling   = false
	unit.channelingData = nil
	unit.channelRt      = nil
	unit.channelResolveCt = nil
	unit.channelPhase   = nil
	unit.pendingActivationCt = nil

	-- Rulings R8 (handoff 2, 2026-11-09; USER RULING 2026-11-08 11:52 PM, decision 139 / rule 255): a
	-- CASTER-CENTRED channel follows a caster that was pushed (or otherwise moved) during the wait. The aim
	-- keeps its direction and distance from the caster and is re-anchored on the caster's tile now; whoever
	-- stands on that tile is the main target (empty tile = empty-tile cast, as for any aimed tile).
	-- Caster-centred = Cleave arc (Decimating Swing), caster-origin Line / Cone, "Caster Area". Tile-aimed
	-- skills (area on a picked tile, Chain, leaps, summons, traps) and single-target skills are unchanged.
	-- A channel committed without casterX / aimX (before this build) resolves as before.
	if target and target ~= unit and skillDef and data.casterX and data.aimX
		and (unit.tileX ~= data.casterX or unit.tileY ~= data.casterY) then
		local p = skillDef.aoePattern
		local offX = data.aimX - data.casterX
		local offY = data.aimY - data.casterY
		local casterCentred = not skillDef.isLeapStrike and (isCasterArea(skillDef)
			or ((offX ~= 0 or offY ~= 0) and (p == "Cleave"
				or (type(p) == "string" and (string.sub(p, 1, 4) == "Line" or string.sub(p, 1, 4) == "Cone"))))
			-- Job 4 (USER RULING 2026-11-09 10:42 AM, rule 255): a weapon-pattern skill (Execution Stroke, Storm
			-- Barrage) follows too when the weapon's pattern sits next to the caster: a Cleave / Adjacent weapon
			-- aimed at an adjacent tile. Any other weapon pattern stays on its aimed tile.
			or (p == "InheritWeapon" and (unit.weaponPattern == "Cleave" or unit.weaponPattern == "Adjacent")
				and math.max(math.abs(offX), math.abs(offY)) == 1))
		if casterCentred then
			local fromX, fromY = target.tileX, target.tileY
			if isCasterArea(skillDef) then
				target = unit
			else
				local stepX = if offX > 0 then 1 elseif offX < 0 then -1 else 0
				local stepY = if offY > 0 then 1 elseif offY < 0 then -1 else 0
				local ax = unit.tileX + offX
				local ay = unit.tileY + offY
				local function onMap(x: number, y: number): boolean
					return x >= 1 and y >= 1 and x <= _mapWidth and y <= _mapHeight
				end
				-- Past the map edge: shorten the reach toward the caster (same direction) until it fits.
				for _ = 1, math.max(math.abs(offX), math.abs(offY)) do
					if onMap(ax, ay) then break end
					if math.abs(ax - unit.tileX) > 1 then ax -= stepX end
					if math.abs(ay - unit.tileY) > 1 then ay -= stepY end
				end
				if not onMap(ax, ay) then
					print(string.format("[CommandService] Channel FIZZLE | %s | [%s] -- moved to the map edge, aim off the map",
						unit.name, skillDef.name or skillDef.id))
					return false, "No room to strike after being moved."
				end
				target = findLiveTileOccupant(state, ax, ay)
					or { id = "_ground_target", name = "Ground", tileX = ax, tileY = ay, isGroundTarget = true }
			end
			print(string.format("[CommandService] Channel FOLLOW | %s | [%s] caster moved (%d,%d)->(%d,%d) | aim (%s,%s)->(%d,%d) %s",
				unit.name, skillDef.name or skillDef.id, data.casterX, data.casterY, unit.tileX, unit.tileY,
				tostring(fromX), tostring(fromY), target.tileX, target.tileY, tostring(target.name)))
		end
		-- Job 2 (USER RULING 2026-11-09 12:04 AM, rule 255): a tile-origin line (Fissure Line) is tile-aimed: it
		-- stays on its picked tile AND keeps the direction it was committed in (from where the caster stood),
		-- not the moved caster's tile. BattleTurnController clears this after the release.
		if type(p) == "string" and string.sub(p, 1, 8) == "TileLine" then
			unit._tileLineFromX = data.casterX
			unit._tileLineFromY = data.casterY
			print(string.format("[CommandService] Channel STAYS | %s | [%s] caster moved (%d,%d)->(%d,%d) | line stays on (%d,%d), committed direction kept",
				unit.name, skillDef.name or skillDef.id, data.casterX, data.casterY, unit.tileX, unit.tileY, data.aimX, data.aimY))
		end
	end

	-- SUMMON skill (channeled Decoy/Turret/Ward Totem). Resolve the summon spawn
	-- here, BEFORE the target-alive fizzle below: the channel target is a stat-less
	-- Empty-Tile marker (target.isAlive == nil) which would otherwise be read as a
	-- dead target and fizzle. MP was already validated at commit; spend it, announce,
	-- then spawn. No damage, no rewards; recast replaces the caster's prior summon.
	if skillDef and skillDef.isSummon then
		if not CommandService.CanPayCastCost(unit, skillDef, mpCost) then
			print(string.format(
				"[CommandService] Channel FIZZLE | %s | [%s] — MP insufficient (%d/%d needed)",
				unit.name, skillDef.name or skillDef.id, unit.currentMp, mpCost))
			return false, "MP insufficient at activation."
		end
		CommandService.PayCastCost(unit, skillDef, mpCost)
		-- Channel release animation (2026-10-28 F-1): early branch, so it carries its own hint.
		BattleVisualBroadcaster.ActionAnnounced(unit, skillDef.name or skillDef.id or "Summon",
			if (skillDef.channelTime or 0) > 0 then "BigSpell" else nil, { skillId = skillDef.id })
		local ok, info = spawnSummonFor(unit, skillDef, target, state)
		doctrineAfterSkill(unit, target, skillDef, mpCost, true)
		-- D3 (2026-11-07): a cast completed inside a Soul Well pays its HP on this early return too.
		if skillDef and skillDef.soulWellHpCost and ObjectEffectService.SoulWellBacklash then
			ObjectEffectService.SoulWellBacklash(unit, skillDef)
		end
		return ok, ok and info or { type = "Summon", failed = true, reason = info }
	end

	-- OBJECT-PLACING skill resolved after a cast delay (2026-10-24): trap-deploy skills
	-- (Set Bear/Spike/Snare Trap, Set Land Mine) and any createsObject ground skill that
	-- defers via activationTime. Mirrors the isSummon early block — runs BEFORE the
	-- target-alive fizzle because the target is a stat-less Empty-Tile marker. MP was
	-- validated at commit; spend it, announce, then place the object STAMPED with the
	-- caster side so ObjectEffectService gates the trap to enemy-only triggering.
	if skillDef and skillDef.createsObject then
		if not CommandService.CanPayCastCost(unit, skillDef, mpCost) then
			return false, "MP insufficient at activation."
		end
		if not (target and target.tileX and target.tileY) then
			return false, "Object skill: no tile at activation."
		end
		CommandService.PayCastCost(unit, skillDef, mpCost)
		BattleVisualBroadcaster.ActionAnnounced(unit, skillDef.name or skillDef.id or "Deploy",
			if (skillDef.channelTime or 0) > 0 then "BigSpell" else nil, { skillId = skillDef.id })  -- 2026-10-28 F-1
		local inst = ObjectEffectService.PlaceObjectInstance(state, skillDef.createsObject, target.tileX, target.tileY, unit.side, unit.id)
		print(string.format("[CommandService] Channel ACTIVATE [%s] PLACE %s | %s at (%s,%s) | owner=%s | MP:%d",
			skillDef.name or skillDef.id, tostring(skillDef.createsObject), unit.name,
			tostring(target.tileX), tostring(target.tileY), tostring(unit.side), mpCost))
		doctrineAfterSkill(unit, target, skillDef, mpCost, true)
		-- D3 (2026-11-07): a cast completed inside a Soul Well pays its HP on this early return too.
		if skillDef and skillDef.soulWellHpCost and ObjectEffectService.SoulWellBacklash then
			ObjectEffectService.SoulWellBacklash(unit, skillDef)
		end
		return inst ~= nil, { type = "ObjectPlaced", objectType = skillDef.createsObject, placed = inst ~= nil, skillName = skillDef.name }
	end

	-- REPAIR (Artificer, SKL-REPAIR, 2026-10-26): channeled object-repair utility. Runs BEFORE the
	-- target-alive fizzle below (the target is a stat-less Ground marker). The skill is aimed with the
	-- "Ground, including occupied Ground" rule, so target.tileX/tileY is the tile the player clicked;
	-- we fully restore the breakable object sitting there (resets its hits-to-destroy to max). No damage.
	if skillDef and skillDef.repairsObject then
		if not CommandService.CanPayCastCost(unit, skillDef, mpCost) then
			return false, "MP insufficient at activation."
		end
		if not (target and target.tileX and target.tileY) then
			return false, "Repair: no tile at activation."
		end
		CommandService.PayCastCost(unit, skillDef, mpCost)
		BattleVisualBroadcaster.ActionAnnounced(unit, skillDef.name or skillDef.id or "Repair",
			if (skillDef.channelTime or 0) > 0 then "BigSpell" else nil, { skillId = skillDef.id })  -- 2026-10-28 F-1
		-- Item devices too (DB: "Repair (SKL-REPAIR) resets remaining hits to 3"), 2026-10-26.
		local repaired = repairAtTile(state, target.tileX, target.tileY, false)
		print(string.format("[CommandService] Channel ACTIVATE [Repair] | %s repaired object at (%s,%s) -> %s | MP:%d",
			unit.name, tostring(target.tileX), tostring(target.tileY), tostring(repaired), mpCost))
		doctrineAfterSkill(unit, target, skillDef, mpCost, true)
		-- D3 (2026-11-07): a cast completed inside a Soul Well pays its HP on this early return too.
		if skillDef and skillDef.soulWellHpCost and ObjectEffectService.SoulWellBacklash then
			ObjectEffectService.SoulWellBacklash(unit, skillDef)
		end
		return true, { type = "Repair", repaired = repaired, skillName = skillDef.name }
	end

	-- INTERACT RESUSCITATE (channeled KO'd-ally revive). Runs BEFORE the
	-- target-alive fizzle below, because for a revive the target is SUPPOSED
	-- to be KO'd. Resolves at the 200 CT (or headgear-reduced) deadline.
	if data.interactResolve == "reviveAlly" then
		if not target then
			return false, "Revive target missing at activation."
		end
		if target.isAlive then
			-- Already revived some other way during the channel — no-op.
			return false, target.name .. " is no longer KO'd."
		end
		-- Rises on the nearest free tile if a living unit now stands on the body (2026-10-28).
		local _rx, _ry, _rMoved = UnitSchema.FindReviveTile(target, state.units, _mapWidth, _mapHeight)
		if not _rx then
			return false, target.name .. " has no free tile to rise on."
		end
		target.tileX, target.tileY = _rx, _ry
		local frac = data.reviveHpFrac or 0.05
		target.isAlive   = true
		UnitSchema.ClearChannelState(target)  -- never return holding a pre-death channel
		target._revivedThisBattle = true  -- kill-credit rule: revived units never trigger kill augments
		-- Perks & Flaws revive modifiers (2026-10-23): Slow to Recover halves revive HP;
		-- Resilient adds +20% max HP; Undying Will flaw forces exactly 1 HP (overrides all).
		local maxHp = target.maxHp or 1
		local reviveHp
		if TraitEffectService.HasReviveAtOneHp(target) then
			reviveHp = 1
		else
			local effFrac = frac * TraitEffectService.GetReviveHpMultiplier(target)
				+ TraitEffectService.GetReviveHpBonusFraction(target)
			reviveHp = math.max(1, math.ceil(maxHp * effFrac))
			reviveHp = math.min(reviveHp, maxHp)
		end
		target.currentHp = reviveHp
		StatusService.WeakenVenomOnHeal(target)  -- a revive weakens Venom like a heal (user ruling 2026-10-26)
		target.remainingRt = target.startingRt or 400
		BattleVisualBroadcaster.ActionAnnounced(unit, "Resuscitate")
		if _rMoved then
			BattleVisualBroadcaster.UnitMoved(target)
		end
		BattleVisualBroadcaster.UnitStateChanged(target)
		print(string.format(
			"[CommandService] INTERACT REVIVE RESOLVE | %s resuscitates %s at %d/%d HP",
			unit.name, target.name, target.currentHp, target.maxHp or 0
		))
		BattleVisualBroadcaster.Log("ko", `{unit.name} resuscitates {target.name} ({target.currentHp}/{target.maxHp or 0} HP).`, target.id)
		-- D3 (2026-11-07): a cast completed inside a Soul Well pays its HP on this early return too.
		if skillDef and skillDef.soulWellHpCost and ObjectEffectService.SoulWellBacklash then
			ObjectEffectService.SoulWellBacklash(unit, skillDef)
		end
		return true, { type = "Resuscitate", target = target, hp = target.currentHp }
	end

	-- Check if target is still alive (for offensive/healing skills). Ground-tile
	-- markers (isGroundTarget) are not units and never 'die' -- they resolve on the
	-- committed tile (2026-10-07 activation-time build; previously a channeled ground
	-- skill's stat-less marker read as a dead target and fizzled).
	-- Revive skills (Battlefield Triage) are SUPPOSED to target a dead unit; their own branch fizzles
	-- only if the target was already revived mid-channel (UAT 2026-10-28 D-1).
	if target and not target.isGroundTarget and not target.isAlive and not (skillDef and skillDef.isRevive) then
		print(string.format(
			"[CommandService] Channel FIZZLE | %s | [%s] — target %s is dead",
			unit.name, skillDef.name or skillDef.id, target.name
		))
		return false, "Target died during channel."
	end

	-- Steal (SKL-STEAL) execution re-check (2026-10-24): the caster must STILL be on the
	-- target's exact rear tile at resolve. Pushed off, or the target turned to face them,
	-- during the channel => fizzle (turn already spent at commit; MP refunded, like every
	-- other fizzle path above). Good counterplay, set on purpose.
	if skillDef and skillDef.id == "SKL-STEAL" then
		if not target or not GameConstants.IsCasterBehindTarget(unit, target) then
			print(string.format("[CommandService] Channel FIZZLE | %s | [Steal] — no longer behind target", unit.name))
			return false, "No longer behind the target."
		end
	end

	-- Tile-occupant resolution at activation (crash fix 2026-10-26). A channeled SINGLE-target
	-- skill can carry the stat-less ground marker: an empty tile at commit, an AI ground-aimed
	-- cast, or an area skill collapsed to single-target by Concentrated Effect. Channels resolve
	-- on the committed tile, so whoever stands there NOW takes the hit. An empty tile gets only
	-- the terrain reaction (handled in the dispatch below). The marker must never reach
	-- ResolveSkill/ResolveHealing/ResolveShield (they read target.effectiveStats).
	local _emptyTileCast = false
	if target and target.isGroundTarget and skillDef
		and isUnitAnchoredPattern(skillDef)  -- incl. Cleave / Chain / weapon shapes (BUG-057 fix 2)
		and not skillDef.isSummon and not skillDef.createsObject and not skillDef.repairsObject
		and (skillDef.isLeapStrike or not RacePassiveService.IsMovementSkill(skillDef)) then
		local occupant = findLiveTileOccupant(state, target.tileX, target.tileY)
		if occupant then
			target = occupant
		else
			_emptyTileCast = true
		end
	end

	-- Job 3 (USER RULING 2026-11-09 12:04 AM, rule 255): a melee single-target channel whose caster was moved
	-- during the wait (push, pull, swap, teleport) fizzles if its target is now out of reach. Same reach rule as
	-- the cast (shared range formula + melee height limit), same pattern as the Steal re-check above: it returns
	-- before the cost is paid, so no MP is spent (the turn was already spent at commit).
	if target and target ~= unit and target.tileX and skillDef and data.casterX
		and (unit.tileX ~= data.casterX or unit.tileY ~= data.casterY)
		and isMeleeReachChannel(unit, skillDef) then
		local maxR, minR, baseR = GameConstants.CalcSkillRange(unit, skillDef,
			RacePassiveService.GetSkillRangeModifier(unit, skillDef)
				+ WeaponPassiveService.GetSkillRangeBonus(unit, skillDef)
				+ DoctrinePassiveService.GetProjectileRangeModifier(unit, skillDef.projectileType or (skillDef.range == -1 and unit.weaponProjectileType or nil)))
		local dist = math.max(math.abs(target.tileX - unit.tileX), math.abs(target.tileY - unit.tileY))
		if dist > maxR or dist < minR or not TargetingService.IsMeleeElevationLegal(unit, target, baseR) then
			print(string.format("[CommandService] Channel FIZZLE | %s | [%s] -- caster moved (%d,%d)->(%d,%d), target %s out of reach (dist %d, reach %d-%d)",
				unit.name, skillDef.name or skillDef.id, data.casterX, data.casterY, unit.tileX, unit.tileY,
				tostring(target.name), dist, minR, maxR))
			return false, "Target out of reach after being moved."
		end
	end

	-- PINNED / PHASE LOCKED DURING THE WAIT (USER RULING 2026-11-08 6:59 PM): a skill that moves the
	-- caster (Dragon Dive and any other leap / dash / step skill with a channel or activation wait) is
	-- cancelled when the wait ends if the caster is now Pinned or Phase Locked. The cost is paid only at
	-- activation, so returning here before payment refunds it (MP and any HP cost). Same rules the cast
	-- itself checks (IsPinBlockedSkill / IsRelocationBlockedSkill): teleports and swaps ignore Pinned.
	if skillDef and (CommandService.IsPinBlockedSkill(unit, skillDef) or CommandService.IsRelocationBlockedSkill(unit, skillDef)) then
		local why = if CommandService.IsPinBlockedSkill(unit, skillDef) then "Pinned" else "Phase Locked"
		print(string.format(
			"[CommandService] Channel CANCEL | %s | [%s] — caster is %s, move cancelled, cost refunded",
			unit.name, skillDef.name or skillDef.id, why
		))
		return false, `{why}: move cancelled, cost refunded`
	end

	-- Check cast affordability at activation (MP, or HP for HP/Blood Casting) — else fizzle
	if not CommandService.CanPayCastCost(unit, skillDef, mpCost) then
		print(string.format(
			"[CommandService] Channel FIZZLE | %s | [%s] — MP insufficient (%d/%d needed)",
			unit.name, skillDef.name or skillDef.id, unit.currentMp, mpCost
		))
		return false, "MP insufficient at activation."
	end

	-- Channel fires now: announce the skill over the caster.
	BattleVisualBroadcaster.ActionAnnounced(unit, skillDef.name or skillDef.id or "Skill",
		if (skillDef.channelTime or 0) > 0 then "BigSpell" else nil, { skillId = skillDef.id })  -- channel release animation (2026-10-28)

	-- SPEND the cast cost now (MP, or HP for HP/Blood Casting)
	CommandService.PayCastCost(unit, skillDef, mpCost)
	doctrineBeginCast(unit, skillDef, target, state) -- Stormbringer / Plague Doctor cast context

	-- TWO-TIMER MODEL: the caster's RT was ALREADY charged at channel-commit time
	-- (base + skill RT cost via AccrueRt + EndTurn in ValidateAndCommit). Activation
	-- now runs in the ChannelResolve phase where NO turn is open, so calling AccrueRt
	-- here would fail its TurnOpen assert (the crash we hit). No RT is charged at
	-- activation — the skill was fully paid for on commit.

	-- Resolve the skill
	local result = {}
	-- Reaction window (TRG-004): record every unit this channeled skill hits.
	local _reactionHits = beginReactionWindow(unit)

	if _emptyTileCast then
		-- EMPTY-TILE resolution: nothing to hit. Apply the authored tile effect and the skill
		-- element's terrain reaction (same as the instant ground branch); no damage, no status.
		if skillDef.createsTileEffect and _tileEffectService then
			_tileEffectService.ApplyTileEffect(target.tileX, target.tileY, skillDef.createsTileEffect, unit.id)
		end
		local elem = CombatResolver.ExtractSkillElement(skillDef)
		-- Tile targeting includes objects (ruling 2026-10-26): a damaging skill aimed at a
		-- tile holding a breakable object lands one hit on it, exactly like a basic attack on
		-- the object (ApplyObjectHit: 1 hit, element instant-kill tags apply). No-op otherwise.
		if (skillDef.power or 0) > 0 and not skillDef.isHealing and not skillDef.isShield then
			local objHit = ObjectEffectService.ApplyObjectHit(state, target.tileX, target.tileY, 1, elem or "Physical", nil, unit, skillAppliesVenom(skillDef))
			if objHit ~= "not-found" then
				print(`[CommandService] Channel ACTIVATE [{skillDef.name or skillDef.id}] hits object at ({target.tileX},{target.tileY}) -> {tostring(objHit)}`)
			end
		end
		if elem and elem ~= "Physical" and _tileEffectService and _tileEffectService.ResolveElementOnTile then
			_tileEffectService.ResolveElementOnTile(target.tileX, target.tileY, elem, unit.id, state.units)
		end
		result.type      = "GroundReaction"
		result.skillName = skillDef.name
		result.tileX     = target.tileX
		result.tileY     = target.tileY
		print(string.format(
			"[CommandService] Channel ACTIVATE [%s] | %s -> empty tile (%d,%d) | reaction:%s | MP:%d",
			skillDef.name or skillDef.id, unit.name, target.tileX, target.tileY,
			tostring(elem), mpCost
		))

	-- RESTOCK (Chemist, SKL-RESTOCK): channeled self utility — refill 1 use charge to
	-- each equipped consumable (capped at its max). No damage/status. 2026-10-20.
	elseif skillDef.raisesCorpses then
		-- Raise Dead (Chaos Necromancer) completes its 300 channel: every corpse rises at once.
		local count = raiseCorpses(unit, skillDef, state)
		result.type      = "AOE"
		result.targets   = {}
		result.totalDmg  = 0
		result.hitCount  = count
		result.skillName = skillDef.name
		print(string.format("[CommandService] Channel ACTIVATE [%s] | %s raised %d", skillDef.name, unit.name, count))

	elseif skillDef.id == "SKL-RESTOCK" then
		local refilled = 0
		for _, slot in pairs(unit.consumableSlots or {}) do
			if slot and slot.consumableId then
				local maxC = slot.maxCharges or 0
				local cur = slot.currentCharges or 0
				if cur < maxC then
					slot.currentCharges = math.min(maxC, cur + 1)
					refilled = refilled + 1
				end
			end
		end
		result.type = "Restock"
		result.refilled = refilled
		result.skillName = skillDef.name
		print(string.format("[CommandService] Channel ACTIVATE [Restock] | %s refilled %d consumable(s) | MP:%d",
			unit.name, refilled, mpCost))

	elseif skillDef.id == "SKL-STEAL" then
		-- STEAL RESOLVE (2026-10-24): the slot was validated at commit and rode the channel
		-- (data.stolenSlot). Re-check it is still populated, then REAL-THEFT it: Unequip
		-- strips it from the victim AND rebuilds their stats (lost defense/passives apply
		-- immediately), tag it stolen, and stash it on the battle state for victory loot
		-- (kept only on a win). Both hands are never in STEALABLE_SLOTS, so never a weapon.
		local slot = data.stolenSlot
		local legal = false
		for _, s in ipairs(GameConstants.GetStealableSlots(target)) do
			if s == slot then legal = true break end
		end
		if not legal then
			result.type = "Steal"; result.failed = true; result.skillName = skillDef.name
			print(string.format("[CommandService] Steal RESOLVE | %s -> %s | slot gone, nothing taken",
				unit.name, target.name))
		else
			local okU, removed = EquipmentService.Unequip(target, slot)
			if okU and removed then
				removed.stolen = true
				state.stolenItems = state.stolenItems or {}
				table.insert(state.stolenItems, removed)
				result.type = "Steal"; result.target = target; result.slot = slot
				result.stolenItem = removed; result.skillName = skillDef.name
				BattleVisualBroadcaster.UnitStateChanged(target)
				print(string.format("[CommandService] Steal RESOLVE | %s stole %s (%s) from %s",
					unit.name, removed.instanceId or "?", slot, target.name))
				BattleVisualBroadcaster.Log("steal", `{unit.name} steals {slot} from {target.name}.`, target.id)
				-- Thief Fortune Hand (user ruling 2026-10-28): + gold equal to the Thief's level.
				local _sg = DoctrinePassiveService.GetStealGold(unit)
				if _sg > 0 then
					state.stealGold = (state.stealGold or 0) + _sg
					BattleVisualBroadcaster.Log("steal", `{unit.name} also pockets {_sg} gold.`, target.id)
				end
			else
				result.type = "Steal"; result.failed = true; result.skillName = skillDef.name
			end
		end

	elseif skillDef.isPurify and target and not target.isGroundTarget then
		-- Purifying Form is channeled (200 CT), so it always resolves here. Same effect as the
		-- instant branch: remove one real debuff, grant Purified. Any side (tile targeting).
		-- Previously missing, so the cast fell through to single-target damage (UAT 2026-10-26).
		local purged = StatusService.RemoveRandomDebuff(target)
		StatusService.ApplyStatus(target, "Purified", unit.id)
		if BattleVisualBroadcaster.UnitStateChanged then
			BattleVisualBroadcaster.UnitStateChanged(target)
		end
		result.type      = "Purify"
		result.target    = target
		result.removed   = purged
		result.skillName = skillDef.name
		print(string.format("[CommandService] Channel ACTIVATE [%s] PURIFY | %s -> %s | purged:%s +Purified | MP:%d",
			skillDef.name or skillDef.id, unit.name, target.name, tostring(purged), mpCost))

	elseif skillDef.isShield then
		-- SHIELD GRANT (channeled resolution: Vital Barrier, Bastion Projection,
		-- Bulwark Field, Retribution Shell) — shield subsystem 2026-10-05. Mirrors
		-- the isHealing channeled branch: compute the authored shield amount
		-- (CombatResolver.ResolveShield, keyed to skill id) and GRANT it via the
		-- existing StatusService.ApplyShield API (ApplyShieldOutcome). Deals NO
		-- attack damage. Routed FIRST so a 0-power shield skill never falls through
		-- to the damage branches. L = Effective Skill Level = caster main-hand item
		-- level (same source the channel-commit RT used).
		local shMainHand = unit.equipmentSlots and unit.equipmentSlots.MainHand
		local shSkillLevel = (shMainHand and shMainHand.itemLevel) or 1
		if skillDef.aoePattern then
			-- Bulwark Field (Self, Allies, caster-origin Circle radius 2): grant an
			-- INDEPENDENT shield instance to the caster + every living ally within the
			-- caster-origin Chebyshev radius parsed from the pattern. Each ally's
			-- amount is computed from that ally-as-recipient? No — the recipe scales
			-- with the CASTER's stats/weapon (the caster projects the field), so the
			-- caster is passed as the shield source for every grant.
			local radius = tonumber(tostring(skillDef.aoePattern):match("%d+")) or 2
			local granted = 0
			-- "Caster Area" shields every unit in the field, any side (ruling 2026-10-26), except
			-- alliesOnly skills: Bulwark Field (USER RULING 2026-11-08 3:51 PM) shields allies only.
			local shieldAnySide = isCasterArea(skillDef) and not skillDef.alliesOnly
			for _, u in ipairs(state.units) do
				if u.isAlive and (shieldAnySide or u.side == unit.side)
					and math.max(math.abs((u.tileX or 0) - unit.tileX), math.abs((u.tileY or 0) - unit.tileY)) <= radius then
					local outcome = CombatResolver.ResolveShield(unit, u, skillDef, shSkillLevel)
					CombatResolver.ApplyShieldOutcome(outcome, u)
					granted = granted + 1
				end
			end
			result.type      = "Shield"
			result.alliesShielded = granted
			result.skillName = skillDef.name
			print(string.format(
				"[CommandService] Channel ACTIVATE [%s] AOE SHIELD | %s | allies shielded:%d | MP:%d",
				skillDef.name, unit.name, granted, mpCost
			))
		else
			local outcome = CombatResolver.ResolveShield(unit, target, skillDef, shSkillLevel)
			CombatResolver.ApplyShieldOutcome(outcome, target)
			result.type      = "Shield"
			result.target    = target
			result.shieldHp  = outcome.shieldHp
			result.skillName = skillDef.name
			print(string.format(
				"[CommandService] Channel ACTIVATE [%s] SHIELD | %s -> %s | Shield:%d | MP:%d",
				skillDef.name, unit.name, target.name, outcome.shieldHp, mpCost
			))
		end

	elseif skillDef.isRevive then
		-- Revive skill (channeled path, e.g. Battlefield Triage 100 CT). Must precede
		-- the isHealing branch (revive skills also carry isHealing for VFX). Target was
		-- validated KO'd at commitment; it may have been revived another way mid-channel.
		if not target or target.isAlive then
			result.type = "Revive"
			result.skillName = skillDef.name
			unit._skillFizzled = true  -- nobody rose: no once-per-cast augment effects (UAT 2026-10-28 N4)
			print(string.format("[CommandService] REVIVE FIZZLE | %s | %s no longer KO'd",
				unit.name, target and target.name or "target"))
		else
			local hp = resolveReviveCast(unit, target, skillDef, state)
			result.type     = "Revive"
			result.target   = target
			result.healing  = hp
			result.skillName = skillDef.name
		end

	elseif skillDef.isLifeLink then
		-- LIFE LINK (USER RULING 2026-11-08, channelled 100 CT): a lasting 2000 CT heal-share link to the
		-- target ally (LifeLinkService) -- no heal now. Self / enemy / KO'd target = fizzle.
		local linked = (target ~= nil and not target.isGroundTarget and target.id ~= unit.id
			and target.side == unit.side and LifeLinkService.Create(state, unit, target, skillDef)) == true
		if not linked then unit._skillFizzled = true end
		result.type      = "AOE"
		result.targets   = if linked then { { target = target, outcome = { finalDamage = 0 } } } else {}
		result.totalDmg  = 0
		result.hitCount  = if linked then 1 else 0
		result.skillName = skillDef.name
		print(string.format("[CommandService] Channel ACTIVATE [%s] LIFE LINK | %s -> %s | linked:%s | MP:%d",
			skillDef.name or skillDef.id, unit.name, target and target.name or "?", tostring(linked), mpCost))

	elseif skillDef.isHealing and hasCardTag(skillDef, "Direct Damage")
		and skillDef.aoePattern ~= nil and not isUnitAnchoredPattern(skillDef) and target and target.tileX then
		-- AREA LIFEDRAIN (Siphon Pulse, channeled): damage the area, caster heals from it.
		local entries, totalDmg, drainHeal = resolveAreaDrain(unit, skillDef, target.tileX, target.tileY, state)
		result.type      = "AreaHealing"
		result.targets   = entries
		result.skillName = skillDef.name
		print(string.format("[CommandService] Channel ACTIVATE [%s] AREA DRAIN | %s | units:%d | Dmg:%d | Drain heal:%d | MP:%d",
			skillDef.name or skillDef.id, unit.name, #entries, totalDmg, drainHeal, mpCost))

	elseif skillDef.isHealing and not hasCardTag(skillDef, "Direct Damage")
		and skillDef.aoePattern ~= nil and not isUnitAnchoredPattern(skillDef)
		and target and target.tileX then
		-- AREA HEAL (Mending Rain, channeled): every unit in the pattern, any side. Fixes the
		-- empty-tile crash (marker passed to ResolveHealing) and the old one-unit-only heal.
		local entries = resolveAreaHealing(unit, skillDef, target.tileX, target.tileY, state)
		result.type      = "AreaHealing"
		result.targets   = entries
		result.skillName = skillDef.name
		print(string.format("[CommandService] Channel ACTIVATE [%s] AREA HEAL | %s at (%d,%d) | units:%d | MP:%d",
			skillDef.name or skillDef.id, unit.name, target.tileX, target.tileY, #entries, mpCost))

	elseif isDualHealDamage(skillDef) and target and not target.isGroundTarget
		and not dualHealsTarget(unit, target) then
		-- Dark Restoration on anyone but the caster or an Undead ally: Dark damage (card), not a heal.
		local outcome, dealt, statusApplied = resolveDualDamage(unit, target, skillDef, state)
		local isDamage = outcome.type == "Damage"
		result.type          = if isDamage then "Damage" else "Healing"
		result.target        = target
		result.damage        = if isDamage then dealt else 0
		result.healing       = if isDamage then 0 else dealt
		result.statusApplied = statusApplied
		result.skillName     = skillDef.name
		print(string.format("[CommandService] Channel ACTIVATE [%s] DARK | %s -> %s | %s:%d | MP:%d",
			skillDef.name or skillDef.id, unit.name, target.name, if isDamage then "Dmg" else "Heal", dealt, mpCost))

	elseif skillDef.isHealing then
		local outcome = CombatResolver.ResolveHealing(unit, target, skillDef)
		local actual = CombatResolver.ApplyOutcome(outcome, target, unit)
		if outcome.finalHealing ~= nil then
			applyHealRider(unit, target, skillDef)
		end
		result.type     = "Healing"
		result.target   = target
		result.healing  = actual
		result.skillName = skillDef.name

		print(string.format(
			"[CommandService] Channel ACTIVATE [%s] | %s -> %s | Heal:%d | MP:%d",
			skillDef.name, unit.name, target.name, actual, mpCost
		))

	elseif skillDef.swapWithTarget and target and not target.isGroundTarget then
		-- Delayed Phantom Exchange: swap with the selected ally at activation.
		local _swapDist = math.max(math.abs(target.tileX - unit.tileX), math.abs(target.tileY - unit.tileY))
		local swapped = applySwap(unit, target)
		if swapped then
			-- Dodger / Sitting Duck: the caster travelled using a skill (DB "using skill or by move").
			TraitEffectService.AccumulateMoveEvasion(unit, _swapDist)
			applyLandingEntry(unit, state)
			applyLandingEntry(target, state)
		end
		result.type      = "AOE"
		result.targets   = { { target = target, outcome = { finalDamage = 0 } } }
		result.totalDmg  = 0
		result.hitCount  = swapped and 1 or 0
		result.skillName = skillDef.name
		print(string.format("[CommandService] Channel ACTIVATE [%s] SWAP | %s <-> %s | ok:%s | MP:%d",
			skillDef.name, unit.name, target.name, tostring(swapped), mpCost))

	elseif usesSharedResolve(unit, skillDef) then
		-- Shared Resolve (channeled, e.g. Mana Surge): the self-buff goes to every standing ally.
		-- Mana Surge's MP restore stays on the caster only (it is not a buff; applyPureBuff rule).
		local entries = applyPureBuff(unit, skillDef, sharedResolveTargets(state, unit))
		result.type      = "AOE"
		result.targets   = entries
		result.totalDmg  = 0
		result.hitCount  = #entries
		result.skillName = skillDef.name
		print(string.format("[CommandService] Channel ACTIVATE [%s] SHARED RESOLVE | %s | allies buffed:%d | MP:%d",
			skillDef.name, unit.name, #entries, mpCost))

	elseif isPureBuffAura(skillDef) then
		-- War Cry (channeled): caster + same-side allies within the Circle radius.
		local entries = applyPureBuff(unit, skillDef, auraTargets(state, unit, skillDef))
		result.type      = "AOE"
		result.targets   = entries
		result.totalDmg  = 0
		result.hitCount  = #entries
		result.skillName = skillDef.name
		print(string.format(
			"[CommandService] Channel ACTIVATE [%s] AURA BUFF | %s | allies buffed:%d | MP:%d",
			skillDef.name, unit.name, #entries, mpCost
		))

	-- Buff-tagged skills may be cast on ANY side (ruling 2026-10-26); debuffs on a foe keep the
	-- normal hit path below (resistance/reaction rules).
	elseif isPureBuffSkill(skillDef) and target and not target.isGroundTarget
		and (target.side == unit.side
			or (hasCardTag(skillDef, "Buff") and not hasCardTag(skillDef, "Debuff"))) then
		-- Channeled self/ally buff (Coordinated Advance): status only, no damage path.
		local entries = applyPureBuff(unit, skillDef, { target })
		result.type      = "AOE"
		result.targets   = entries
		result.totalDmg  = 0
		result.hitCount  = #entries
		result.skillName = skillDef.name
		print(string.format(
			"[CommandService] Channel ACTIVATE [%s] BUFF | %s -> %s | MP:%d",
			skillDef.name, unit.name, target.name, mpCost
		))

	elseif skillDef.aoePattern == "Cleave" then
		local targets = TargetingService.GetCleaveTargets(unit, target, state.units, cleaveAnySide(skillDef))
		local totalDmg = 0
		local hitCount = 0
		local allOutcomes = {}
		for _, t in ipairs(targets) do
			if t.isAlive then
				local outcome = CombatResolver.ResolveSkill(unit, t, skillDef)
				CombatResolver.ApplyOutcome(outcome, t, unit)
				totalDmg = totalDmg + (outcome.finalDamage or 0)  -- nil on absorb/heal outcomes (sweep 2026-11-06)
				hitCount = hitCount + 1
				table.insert(allOutcomes, { target = t, outcome = outcome })
			end
		end
		applyAreaRiders(state, unit, skillDef, riderHitsFromOutcomes(allOutcomes), target)  -- rule 252 (2026-11-08); target = main for the delay split
		result.type      = "AOE"
		result.targets   = allOutcomes
		result.totalDmg  = totalDmg
		result.hitCount  = hitCount
		result.skillName = skillDef.name

		print(string.format(
			"[CommandService] Channel ACTIVATE [%s] AOE | %s | Hits:%d | Dmg:%d | MP:%d",
			skillDef.name, unit.name, hitCount, totalDmg, mpCost
		))

	elseif skillDef.aoePattern and skillDef.aoePattern:sub(1,5) == "Chain" then
		-- Chain AOE: jump from target to target with damage falloff
		local maxTargets = tonumber(skillDef.aoePattern:match("%d+")) or 3
		local chainTargets = TargetingService.GetChainTargets(
			target, state.units, unit.side, maxTargets, 2
		)
		local totalDmg = 0
		local hitCount = 0
		local falloff = 1.0
		local falloffRate = skillDef.chainFalloff or 0.80
		local allOutcomes = {}
		for _chainIdx, u in ipairs(chainTargets) do
			if u.isAlive then
				local outcome = CombatResolver.ResolveSkill(unit, u, skillDef)
				-- Voltaic Chain: Pinned on the LAST target of the chain only (DB Effects, rule 252).
				if skillDef.statusLastChainOnly and _chainIdx ~= #chainTargets then outcome.appliesStatus = nil end
				if outcome.finalDamage then outcome.finalDamage = math.max(0, math.round(outcome.finalDamage * falloff)) elseif outcome.finalHealing then outcome.finalHealing = math.max(0, math.round(outcome.finalHealing * falloff)) end -- Dark vs Undead heal is reduced the same way as damage (user ruling 2026-11-06)
				outcome.isAOE = true
				CombatResolver.ApplyOutcome(outcome, u, unit)
				totalDmg = totalDmg + (outcome.finalDamage or 0)  -- nil on absorb/heal outcomes (sweep 2026-11-06)
				hitCount = hitCount + 1
				table.insert(allOutcomes, { target = u, outcome = outcome })
				falloff = falloff * falloffRate
			end
		end
		applyAreaRiders(state, unit, skillDef, riderHitsFromOutcomes(allOutcomes))  -- rule 252 (2026-11-08)
		result.type      = "AOE"
		result.targets   = allOutcomes
		result.totalDmg  = totalDmg
		result.hitCount  = hitCount
		result.skillName = skillDef.name
		print(string.format(
			"[CommandService] Channel ACTIVATE [%s] Chain(%d/%d) | %s | Hits:%d | Dmg:%d | MP:%d",
			skillDef.name, hitCount, maxTargets, unit.name, hitCount, totalDmg, mpCost
		))

	elseif skillDef.aoePattern == "InheritWeapon" and (unit.weaponPattern or "Single") ~= "Single" then
		-- Channeled weapon-shaped skill (Execution Stroke, Storm Barrage) with an area weapon: same
		-- targets as the instant path. Previously fell into the tile-pattern branch, which does not
		-- know "InheritWeapon", so it hit nothing (UAT 2026-10-26 P-1).
		local aoeTargets = weaponPatternTargets(unit, target, state.units, unit.weaponPattern) or {}
		local totalDmg, hitCount, allOutcomes = 0, 0, {}
		-- Multi-hit weapon-shaped skill (Storm Barrage, 3 hits, 2026-10-28): the weapon pattern repeats.
		local _nHits = skillHitCount(unit, skillDef)
		for _hitN = 1, _nHits do
		for _, entry in ipairs(aoeTargets) do
			if entry.unit.isAlive then
				local outcome = CombatResolver.ResolveSkill(unit, entry.unit, skillDef)
				if outcome.finalDamage then outcome.finalDamage = math.max(0, math.round(outcome.finalDamage * entry.dmgMult)) elseif outcome.finalHealing then outcome.finalHealing = math.max(0, math.round(outcome.finalHealing * entry.dmgMult)) end -- Dark vs Undead heal is reduced the same way as damage (user ruling 2026-11-06)
				if entry.dmgMult < 1.0 then outcome.isAOE = true end
				CombatResolver.ApplyOutcome(outcome, entry.unit, unit)
				totalDmg = totalDmg + (outcome.finalDamage or 0)  -- nil on absorb/heal outcomes (sweep 2026-11-06)
				hitCount = hitCount + 1
				table.insert(allOutcomes, { target = entry.unit, outcome = outcome })
				if not entry.unit.isAlive then
					trySpawnSoulEcho(unit, skillDef, entry.unit, outcome.finalDamage or 0, state)
				end
				-- Multi-hit (Storm Barrage): each hit applies its own RT delay to the primary target
				-- (x0.25, last hit x0.50). Single-hit weapon-shaped skills unchanged. 2026-10-28.
				if _nHits > 1 and entry.unit == target then
					applySkillPostHit(state, unit, target, skillDef, outcome.finalDamage or 0,
						(_hitN == _nHits and skillDef.lastHitRtDelayMult) or skillDef.hitRtDelayMult or 1)
				end
			end
		end
		end  -- multi-hit repeats
		result.type      = "AOE"
		result.targets   = allOutcomes
		result.totalDmg  = totalDmg
		result.hitCount  = hitCount
		result.skillName = skillDef.name
		print(string.format("[CommandService] Channel ACTIVATE [%s] Inherit[%s] | %s | Hits:%d | Dmg:%d | MP:%d",
			skillDef.name or skillDef.id, tostring(unit.weaponPattern), unit.name, hitCount, totalDmg, mpCost))

	elseif skillDef.aoePattern and skillDef.aoePattern ~= "Cleave" and skillDef.aoePattern ~= "InheritWeapon" then
		-- Generic AOE: tile-based pattern resolution (InheritWeapon with a Single weapon falls to
		-- the single-target branch below)
		local aoeTiles = TargetingService.GetAOETargetTiles(
			skillDef.aoePattern, unit,
			target.tileX, target.tileY,
			_mapWidth, _mapHeight
		)
		local totalDmg = 0
		local hitCount = 0
		local allOutcomes = {}
		-- AOE elevation filter: ±2 from center tile (DB default)
		local centerElev = GameConstants.GetElevation(target.tileX, target.tileY)
		-- AOE is indiscriminate by default (DB: friendly fire rule)
		for _, tile in ipairs(aoeTiles) do
			local tileElev = GameConstants.GetElevation(tile.tileX, tile.tileY)
			if math.abs(tileElev - centerElev) <= 2 then  -- ±2 elevation limit
			-- BlocksAOE: Center Spread AOE does not pass through BlocksAOE objects
			if not TargetingService.IsAOEBlocked(target.tileX, target.tileY, tile.tileX, tile.tileY) then
			  for _, u in ipairs(state.units) do
				if u.isAlive and u.tileX == tile.tileX and u.tileY == tile.tileY
					and u.id ~= unit.id then  -- never hit self unless targetRules includes Self
					-- Indiscriminate by default: hit both sides
					local outcome = CombatResolver.ResolveSkill(unit, u, skillDef)
					outcome.isAOE = true
					CombatResolver.ApplyOutcome(outcome, u, unit)
					totalDmg = totalDmg + (outcome.finalDamage or 0)  -- nil on absorb/heal outcomes (sweep 2026-11-06)
					hitCount = hitCount + 1
					table.insert(allOutcomes, { target = u, outcome = outcome })
				end
				end
			  end
			end
			end
		applyAreaRiders(state, unit, skillDef, riderHitsFromOutcomes(allOutcomes), target)  -- rule 252 (2026-11-08); target tile = main (Dragon Dive landing)
		result.type      = "AOE"
		result.targets   = allOutcomes
		result.totalDmg  = totalDmg
		result.hitCount  = hitCount
		result.skillName = skillDef.name
		print(string.format(
			"[CommandService] Channel ACTIVATE [%s] AOE(%s) | %s | Hits:%d | Dmg:%d | MP:%d",
			skillDef.name, skillDef.aoePattern, unit.name, hitCount, totalDmg, mpCost
		))

		-- WIND CLEARS CLOUDS (user ruling 2026-10-27): a Wind area skill blows clouds off every
		-- tile it covers, occupied or not (same elevation / BlocksAOE limits as the hits).
		if CombatResolver.ExtractSkillElement(skillDef) == "Wind" and _tileEffectService
			and _tileEffectService.WindClearsCloud then
			for _, tile in ipairs(aoeTiles) do
				if math.abs(GameConstants.GetElevation(tile.tileX, tile.tileY) - centerElev) <= 2
					and not TargetingService.IsAOEBlocked(target.tileX, target.tileY, tile.tileX, tile.tileY) then
					_tileEffectService.WindClearsCloud(tile.tileX, tile.tileY, unit.id)
				end
			end
		end

		-- Skill→tile effect bridge (channeling activation)
		if skillDef.createsTileEffect and _tileEffectService then
			for _, tile in ipairs(aoeTiles) do
				local tileElev = GameConstants.GetElevation(tile.tileX, tile.tileY)
				if math.abs(tileElev - centerElev) <= 2
					and not TargetingService.IsAOEBlocked(target.tileX, target.tileY, tile.tileX, tile.tileY) then
					_tileEffectService.ApplyTileEffect(
						tile.tileX, tile.tileY, skillDef.createsTileEffect, unit.id
					)
				end
			end
		end

	else
		-- Single target damage (multi-hit skills resolve each hit, 2026-10-28)
		local outcome: any, _actualDmg: any, statusApplied: any
		local _multiHit = skillHitCount(unit, skillDef) > 1
		if _multiHit then
			_actualDmg, outcome, statusApplied = resolveMultiHitSkill(state, unit, target, skillDef)
		else
			outcome = CombatResolver.ResolveSkill(unit, target, skillDef)
			_actualDmg, statusApplied = CombatResolver.ApplyOutcome(outcome, target, unit)
		end
		unit._skillFizzled = CombatResolver.WasLastHitBlocked ~= nil and CombatResolver.WasLastHitBlocked(target) == true
		-- Same post-hit effects as the instant path (RT delay, skill knockback).
		if not _multiHit then
			applySkillPostHit(state, unit, target, skillDef, _actualDmg or outcome.finalDamage or 0)
		end
		result.type          = "Damage"
		result.target        = target
		result.damage        = outcome.finalDamage
		result.statusApplied = statusApplied
		result.skillName     = skillDef.name

		print(string.format(
			"[CommandService] Channel ACTIVATE [%s] | %s -> %s | Dmg:%d | MP:%d%s",
			skillDef.name, unit.name, target.name,
			outcome.finalDamage, mpCost,
			statusApplied and (" | +" .. statusApplied) or ""
		))
	end

	-- Rule 250 (2026-11-08): area / splash hits on map objects, once per channelled action, after the
	-- unit hits and tile effects. Pattern augments are instant-only (same as the unit pass). An
	-- empty-tile cast struck only its own tile (hit above), like the units.
	if not _emptyTileCast then
		splashObjectsForSkill(state, unit, skillDef, target, false)
	end

	-- Leap strike (Dragon Dive): the caster lands after the hit and before any reaction, so a counter
	-- measures reach from the landing tile (same order as the instant path).
	if skillDef and skillDef.isLeapStrike and target and target.tileX then
		landLeapStrike(unit, target.tileX, target.tileY, state)
	end

	-- Reactions for CHANNELED skills (DB TRG-004: evaluated when the skill EXECUTES): every unit the
	-- skill hit for direct damage > 0, primary or splash, may react once. Then an offensive action
	-- reveals a Hidden caster, after the hit so its +0.50 Hit Quality bonus already applied.
	local _hitAFoe = hitHostile(_reactionHits, unit)
	resolveReactions(_reactionHits, unit, state)
	if skillDef and (isOffensiveCast(unit, skillDef, target) or _hitAFoe) and StatusService.HasStatus(unit, "Hide") then
		StatusService.RemoveStatus(unit, "Hide")
		print(string.format("[CommandService] %s Hide dispelled (offensive channeled skill)", unit.name))
	end

	-- Doctrine post-skill bookkeeping (channeled main path).
	doctrineAfterSkill(unit, target, skillDef, mpCost, true)

	-- Soul Well backlash (2026-11-07): the per-cast copy made at commit carries the HP cost.
	if skillDef and skillDef.soulWellHpCost and ObjectEffectService.SoulWellBacklash then
		ObjectEffectService.SoulWellBacklash(unit, skillDef)
	end

	-- Augment OnSkillComplete (2026-10-24): once-per-cast augment hook for the CHANNELED
	-- resolution path (Decoy/Turret spawn, Scatter/Vortex AOE displacement). Center = the
	-- channel's target tile. nil-safe; no-op when the skill carries no augments. Skipped if the
	-- caster died during resolution (e.g. a trap on its landing tile): no spawns for a dead caster.
	if skillDef and skillDef.id and unit.isAlive and not unit._skillFizzled then
		local _scAug = AugmentEffectService.GetAugmentsForSkill(unit, skillDef.id)
		if _scAug and #_scAug > 0 then
			AugmentEffectService.OnSkillComplete(unit, skillDef, _scAug, {
				state = state,
				centerX = target and target.tileX,
				centerY = target and target.tileY,
				affectedTiles = skillAffectedTiles(unit, skillDef, target and target.tileX, target and target.tileY),
				supportTargets = skillSupportTargets(unit, skillDef, target, state, _reactionHits),
				hitUnits = _reactionHits,  -- this cast's damaged units (Scatter / Vortex Strike, 2026-11-08)
			})
		end
	end

	return true, result
end


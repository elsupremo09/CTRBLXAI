--------------------------------------------------
-- CHARGE LANDING (shared: used by both the preview in the turn prompt AND the
-- actual commit, so they can never diverge). A charge skill repositions the
-- actor to the best empty tile adjacent (Chebyshev 1) to the target before
-- damage: closest to the actor, tie-broken by lowest Euclidean² (straightest
-- line). Returns {x,y} or nil (already adjacent / no legal tile).
--------------------------------------------------
function CommandService.ComputeChargeLanding(actor: any, target: any, state: any)
	if not (actor and target) then return nil end
	local dist = math.max(math.abs(actor.tileX - target.tileX), math.abs(actor.tileY - target.tileY))
	if dist <= 1 then return nil end  -- already adjacent; no move
	local bestTile: any, bestDist, bestDistSq = nil, 999, 999
	for dy = -1, 1 do
		for dx = -1, 1 do
			if dx ~= 0 or dy ~= 0 then
				local cx = target.tileX + dx
				local cy = target.tileY + dy
				if cx >= 1 and cx <= _mapWidth and cy >= 1 and cy <= _mapHeight
					and not GameConstants.IsBlocked(cx, cy) then
					local occupied = false
					if state and state.units then
						for _, u in ipairs(state.units) do
							if u.isAlive and u.tileX == cx and u.tileY == cy then occupied = true; break end
						end
					end
					if not occupied then
						local dCheb = math.max(math.abs(actor.tileX - cx), math.abs(actor.tileY - cy))
						local dSq = (actor.tileX - cx)^2 + (actor.tileY - cy)^2
						if dCheb < bestDist or (dCheb == bestDist and dSq < bestDistSq) then
							bestDist = dCheb
							bestDistSq = dSq
							bestTile = { x = cx, y = cy }
						end
					end
				end
			end
		end
	end
	return bestTile
end

-- SKYFALL LANCE (DB SKL-SKYFALL-LANCE) shared rules, used by validation, the AI, the turn prompt
-- and resolution so all four always agree:
--   CanLeapTo   -> already adjacent, or a free landing tile exists next to the target
--   LeapLanding -> the tile the caster strikes from (nil = stays where it is, already adjacent)
--   LeapDamageDef -> the skill with +20% damage when striking from higher tile elevation
function CommandService.LeapLanding(actor: any, target: any, state: any)
	return CommandService.ComputeChargeLanding(actor, target, state)
end

function CommandService.CanLeapTo(actor: any, target: any, state: any): boolean
	if not (actor and target and target.tileX and actor.tileX) then return false end
	local d = math.max(math.abs(actor.tileX - target.tileX), math.abs(actor.tileY - target.tileY))
	return d <= 1 or CommandService.ComputeChargeLanding(actor, target, state) ~= nil
end

-- LUNGE / RECOIL SHOT tiles (USER RULINGS 2026-11-08 5:07 PM + 6:59 PM, skill rows SKL-LUNGE /
-- SKL-RECOIL-SHOT). Shared by validation, the turn prompt, the hit preview, the AI and resolution so all
-- of them agree. A tile works only if it is on the map, not a wall / object, not impassable, not deep
-- water or a chasm, has no living unit on it, and the height step is within the caster's normal
-- WALKING limits (agent default 2026-11-08, vetoable: rise up to Jump, drop up to Jump + 2, via
-- TargetingService.GetWalkJumpLimits; Flight ignores height, as when walking). A diagonal step between two
-- blocked corners is refused, as when walking (TargetingService.IsDiagonalStepSealed). Never fall damage.
local DIAGONAL_SPLIT = math.tan(math.rad(22.5))  -- Recoil hop: closer to straight than this = straight

local function selfStepTileOk(actor: any, fromX: number, fromY: number, toX: number, toY: number, state: any): boolean
	if toX < 1 or toY < 1 or toX > _mapWidth or toY > _mapHeight then return false end
	if GameConstants.IsBlocked(toX, toY) or GameConstants.IsImpassableTerrain(toX, toY) then return false end
	if GameConstants.IsChasmFloor(toX, toY) or GameConstants.GetTerrainId(toX, toY) == "Deep Water" then return false end
	local units = (state and state.units) or {}
	for _, u in ipairs(units) do
		if u.isAlive and u ~= actor and u.tileX == toX and u.tileY == toY then return false end
	end
	if not StatusService.HasStatus(actor, "Flight") then
		local rise = GameConstants.GetElevation(toX, toY) - GameConstants.GetElevation(fromX, fromY)
		local upLimit, downLimit = TargetingService.GetWalkJumpLimits(actor)
		if rise > upLimit or -rise > downLimit then return false end
	end
	if TargetingService.IsDiagonalStepSealed(actor, units, fromX, fromY, toX, toY) then return false end
	return true
end

local function stepSign(n: number): number
	return if n > 0 then 1 elseif n < 0 then -1 else 0
end

-- Lunge: the target must be exactly 2 tiles away; the step tile is next to both. In line (straight or
-- diagonal) there is one such tile. Off line there are two: the straight one first, then the diagonal.
-- nil = no tile works (the cast is refused before any cost is paid).
function CommandService.LungeStepTile(actor: any, target: any, state: any): any
	if not (actor and target and actor.tileX and target.tileX) then return nil end
	-- Pinned / Phase Locked: no step tile (same check as RecoilHopTile, 2026-11-08 Studio note 5), so the
	-- hit preview stops showing one. Validation already refuses the cast earlier with the Pinned / Phase Lock reason.
	if StatusService.HasStatus(actor, "Pinned") or StatusService.IsRelocationLocked(actor) then return nil end
	local dx, dy = target.tileX - actor.tileX, target.tileY - actor.tileY
	local adx, ady = math.abs(dx), math.abs(dy)
	if math.max(adx, ady) ~= 2 then return nil end
	local sx, sy = stepSign(dx), stepSign(dy)
	local options
	if adx == ady or adx == 0 or ady == 0 then
		options = { { x = actor.tileX + sx, y = actor.tileY + sy } }
	elseif adx == 2 then
		options = { { x = actor.tileX + sx, y = actor.tileY }, { x = actor.tileX + sx, y = actor.tileY + sy } }
	else
		options = { { x = actor.tileX, y = actor.tileY + sy }, { x = actor.tileX + sx, y = actor.tileY + sy } }
	end
	for _, o in ipairs(options) do
		if selfStepTileOk(actor, actor.tileX, actor.tileY, o.x, o.y, state) then return o end
	end
	return nil
end

-- Recoil Shot: 1 tile straight away from the target, the closest of the 8 directions (ties go to the
-- straight one). nil = no hop (Pinned / Phase Locked, or that one tile doesn't work; the shot still counts).
function CommandService.RecoilHopTile(actor: any, target: any, state: any): any
	if not (actor and target and actor.tileX and target.tileX) then return nil end
	if StatusService.HasStatus(actor, "Pinned") or StatusService.IsRelocationLocked(actor) then return nil end
	local vx, vy = actor.tileX - target.tileX, actor.tileY - target.tileY
	if vx == 0 and vy == 0 then return nil end
	local ax, ay = math.abs(vx), math.abs(vy)
	local hx, hy
	if ay <= ax * DIAGONAL_SPLIT then
		hx, hy = stepSign(vx), 0
	elseif ax <= ay * DIAGONAL_SPLIT then
		hx, hy = 0, stepSign(vy)
	else
		hx, hy = stepSign(vx), stepSign(vy)
	end
	local tx, ty = actor.tileX + hx, actor.tileY + hy
	if selfStepTileOk(actor, actor.tileX, actor.tileY, tx, ty, state) then
		return { x = tx, y = ty }
	end
	return nil
end

-- Redirect / validation check for skills that move the caster to strike (Skyfall Lance landing, Lunge
-- step): true when the skill doesn't move the caster, or the move works against `t`.
local function strikeMoveTargetOk(actor: any, skillDef: any, t: any, state: any): boolean
	if not (skillDef and type(t) == "table" and t.tileX) then return true end
	if skillDef.leapsAdjacent and not t.isGroundTarget then
		return CommandService.CanLeapTo(actor, t, state)
	end
	if skillDef.stepsToTargetFirst then
		return CommandService.LungeStepTile(actor, t, state) ~= nil
	end
	return true
end

function CommandService.LeapDamageDef(skillDef: any, fromX: number, fromY: number, target: any): any
	if GameConstants.GetElevation(fromX, fromY) > GameConstants.GetElevation(target.tileX, target.tileY) then
		local hd = table.clone(skillDef)
		hd.potencyBonusMult = (skillDef.potencyBonusMult or 1) * 1.20
		return hd, true
	end
	return skillDef, false
end

-- Straight-line tile path from (fromX,fromY) to (toX,toY), inclusive of the
-- landing tile, EXCLUSIVE of the start. Bresenham-style diagonal walk (matches
-- the 'legal straight path' the charge traverses). For the client path visual.
function CommandService.ComputeChargePath(fromX: any, fromY: any, toX: any, toY: any)
	local path = {}
	local x, y = fromX, fromY
	local guard = 0
	while (x ~= toX or y ~= toY) and guard < 64 do
		guard = guard + 1
		local sx = (toX > x) and 1 or (toX < x) and -1 or 0
		local sy = (toY > y) and 1 or (toY < y) and -1 or 0
		x = x + sx
		y = y + sy
		local terrain = GameConstants.GetTerrainId and GameConstants.GetTerrainId(x, y) or nil
		table.insert(path, { tileX = x, tileY = y, terrain = terrain })
	end
	return path
end
--------------------------------------------------
-- RT CALCULATION
--------------------------------------------------

local function calcMoveRt(actor: any, tilesMoving: any)
	local modBaseRt = StatusService.GetModifiedBaseRt(actor)
	local perTile = modBaseRt * MOVE_RT_FACTOR
	-- AGI reduces Movement RT (DB movement_targeting id 8): x (1 - AGI/(200+AGI)).
	local agi = (actor.effectiveStats and actor.effectiveStats.AGI) or 10
	local agiFactor = 1 - agi / (200 + agi)
	-- Frozen: all RT costs ×2. Wet: movement RT ×1.25.
	local frozenMult = StatusService.GetAllRtMultiplier(actor)
	local wetMult    = StatusService.GetMovementRtMultiplier(actor)
	-- Perks & Flaws: Fleet Runner -25% "additive to Agi bonus" / Plodding +25% "subtracted from AGI
	-- bonus" (DB P/F-080): folded INTO the AGI factor, not multiplied on top (fix 2026-10-29).
	agiFactor = math.max(0, agiFactor + (TraitEffectService.GetMoveRtMultiplier(actor) - 1))
	local traitMoveMult = 1
	-- Armor (Feet) base Movement RT multiplier: FT-002 Windrunner x0.75, FT-012 Relay second-move
	-- x0.50, FT-015 Portal Treads teleport x2. (Rescue/Kick x2 are applied contextually at commit.)
	local armorMoveMult = ArmorPassiveService.GetMoveRtModifier(actor)
	-- Phase Lock: Portal Treads walk normally, so their teleport RT x2 does not apply either.
	if ArmorPassiveService.IsMoveTypeTeleport(actor) and StatusService.IsRelocationLocked(actor) then
		armorMoveMult = 1.0
	end
	return math.round(perTile * tilesMoving * agiFactor * frozenMult * wetMult * traitMoveMult * armorMoveMult)
end

-- Destination terrain crossCost RT for a grounded mover (0 when the terrain has none).
-- DAT-001 (2026-11-21): ONE formula shared by the Move commit and GetMoveRtPreview.
local function calcCrossCostRt(actor: any, terrainData: any): number
	if terrainData and terrainData.crossCost and terrainData.crossCost > 0 then
		return math.round(terrainData.crossCost * StatusService.GetModifiedBaseRt(actor) * GameConstants.MOVE_RT_FACTOR)
	end
	return 0
end

-- BUG-PT-02 (2026-11-21): RT a Move to this candidate tile will add, for the turn prompt's move
-- preview. Uses the SAME pieces the Move commit charges (calcMoveRt, Rescue/Kick extra rtCost,
-- destination crossCost for a grounded unit) so the preview can never drift from the server
-- (DAT-001, ARC-001). The client used the raw path cost (tiles) as RT before, e.g. 384 vs 443.
-- Trap stops / tile reactions mid-walk are not knowable in advance and are not included.
function CommandService.GetMoveRtPreview(actor: any, tile: any): number
	if type(actor) ~= "table" or type(tile) ~= "table" then return 0 end
	local rtCost = calcMoveRt(actor, tile.pathCost or 0)
	local total = rtCost
	-- FT-018 Rescue Spurs / FT-019 Kick Boots: the commit accrues one more rtCost (RT x2).
	if (tile.isRescue and ArmorPassiveService.GetMoveRescueConfig(actor))
		or (tile.isKick and ArmorPassiveService.GetMoveKickConfig(actor)) then
		total += rtCost
	end
	-- Destination crossCost (grounded units only; Flight bypasses terrain cross effects).
	if not StatusService.HasStatus(actor, "Flight") and tile.tileX and tile.tileY then
		total += calcCrossCostRt(actor, GameConstants.GetTerrainData(tile.tileX, tile.tileY))
	end
	return total
end

local function calcBasicAttackBaseRt(actor: any)
	-- Moved to StatCalcService.GetBasicAttackRt (2026-10-28) so the Info panels and the turn
	-- prompt use the exact same calculation: round(Modified Base RT x 0.10) + Effective Weapon WT,
	-- Basics / Heavy Basics, Dual Strike x2, Frenzy (base-RT part), Frozen x2.
	return StatCalcService.GetBasicAttackRt(actor, "battle")
end

-- Shared Push setup (2026-10-28). The Push / PushObject commands AND the turn-prompt push preview
-- (BattleTurnController via CommandService.GetPushPreview / GetObjectPushForce) use these, so the
-- targets and stop tiles a player can pick always match what the push can actually do. Before this
-- the preview used base Force and plain range only, which blocked glove bonuses for players.

-- Pull / swap conversion: race override (Android) wins; else GL-005 Butcher's Gloves becomes a Pull
-- (min range 2, extended range), GL-017 Grappler's Wraps becomes a swap unless a lock blocks it.
local function getPushOverride(actor: any, target: any): (any, boolean, boolean)
	local pushOverride = RacePassiveService.GetPushOverride(actor)
	local grapplerSwap = false
	local swapBlocked = false
	if not pushOverride then
		local conv = ArmorPassiveService.GetPushConversionConfig(actor)
		if conv and conv.mode == "Pull" then
			pushOverride = {
				reverseDirection = true,
				minDistance = conv.minRange or 2,
				maxDistance = 1 + (conv.rangeBonus or 0),
				label = "Pull",
			}
		elseif conv and conv.mode == "Swap" then
			-- D5 fix (2026-10-27): no swap when either unit is teleport-locked (Gravity Pylon aura,
			-- Phase Locked) or the pusher is relocation-locked -- the Push stays a normal push.
			if StatusService.IsRelocationLocked(actor) or StatusService.IsTeleportLocked(actor)
				or StatusService.IsTeleportLocked(target) then
				swapBlocked = true
			else
				grapplerSwap = true
			end
		end
	end
	return pushOverride, grapplerSwap, swapBlocked
end

-- Push range (Chebyshev): override range (or 1) + GL-004 Longarm Bracers +1.
local function getPushRange(actor: any, pushOverride: any): (number, number)
	local maxDist = (pushOverride and pushOverride.maxDistance or 1) + ArmorPassiveService.GetPushRangeBonus(actor)
	local minDist = pushOverride and pushOverride.minDistance or 1
	return minDist, maxDist
end

-- Push Force: derived Force + race override bonus + glove Push Force (GL-001/002/006/008/018, by
-- context) and, for GL-021 Initiator's free push, x0.5 (min 1). Does not mark the free push used.
-- GL-014 Chain-Push Bracers (DB: "If pushed object collides with another movable object/unit,
-- transfer remaining Force to collided target"). One transfer to whatever stands on (colX, colY): a
-- unit (shoved with its own collision / fall damage) or a movable object (objects take no damage).
-- Never the acting unit itself, never re-chains. Shared by the unit Push and the object Push (2026-10-29).
local function chainPushTransfer(state: any, actor: any, colX: number, colY: number, remaining: number, dir: any)
	if remaining <= 0 then return end
	for _, u in ipairs(state.units) do
		if u.isAlive and u.tileX == colX and u.tileY == colY then
			if u.id == actor.id then return end  -- a pull into the user never chains (2026-10-26)
			local cres = DisplacementService.ResolvePush(actor, u, remaining, dir,
				GameConstants.KNOCKBACK_SOURCE_MODIFIERS.GlobalPush, state.units, nil, false)
			if cres and cres.pushed then
				u.tileX = cres.finalTileX
				u.tileY = cres.finalTileY
				local chainDmg = 0
				if cres.wallCollision and cres.wallCollision.damage and cres.wallCollision.damage > 0 then chainDmg = chainDmg + cres.wallCollision.damage end
				if cres.fallDamage and cres.fallDamage > 0 then chainDmg = chainDmg + cres.fallDamage end
				if chainDmg > 0 then UnitSchema.ApplyDamage(u, chainDmg, "push") end
				applyForcedEntryEffects(u, cres)
				if BattleVisualBroadcaster.UnitPushed then BattleVisualBroadcaster.UnitPushed(actor, u, cres) end
				print(string.format("[CommandService] Chain-Push: %s transfers %d force to %s", actor.name, remaining, u.name))
			end
			return
		end
	end
	local ores = ObjectEffectService.PushObject(state, colX, colY, dir.dx, dir.dy, remaining)
	if type(ores) == "table" then
		print(string.format("[CommandService] Chain-Push: %s transfers %d force to the object at (%d,%d)",
			actor.name, remaining, colX, colY))
	end
end

local function getPushForce(actor: any, pushOverride: any, pushContext: any, freeCfg: any): number
	local force = 1
	if actor.derivedStats and actor.derivedStats.force then
		force = actor.derivedStats.force
	end
	if pushOverride and pushOverride.forceBonus then
		force = force + pushOverride.forceBonus
	end
	force = force + ArmorPassiveService.GetPushForceBonus(actor, pushContext)
	if freeCfg then
		force = math.max(freeCfg.minForce or 1, math.floor(force * (freeCfg.forceMultiplier or 0.5)))
	end
	return force
end

-- Turn-prompt preview for pushing a UNIT. nil when the target is out of push range. Otherwise the
-- max distance the push can travel plus the ray the target moves along (start tile + direction),
-- so the client highlights the right tiles for a normal push, a Pull, or a Grappler swap-throw.
function CommandService.GetPushPreview(actor: any, target: any): any
	if not (actor and target and actor.tileX and target.tileX) then return nil end
	local pushOverride, grapplerSwap = getPushOverride(actor, target)
	local minDist, maxDist = getPushRange(actor, pushOverride)
	local dist = math.max(math.abs(actor.tileX - target.tileX), math.abs(actor.tileY - target.tileY))
	if dist > maxDist or dist < minDist then return nil end
	local freeCfg = ArmorPassiveService.GetFreePushConfig(actor)
	local pushContext = { isAlly = (target.side == actor.side), isObject = false, isFreePush = (freeCfg ~= nil) }
	local force = getPushForce(actor, pushOverride, pushContext, freeCfg)
	local _crushCfg = ArmorPassiveService.GetPushCollisionConfig(actor)
	local maxPush = DisplacementService.CalcPushDistance(target, force, false, ArmorPassiveService.GetPushStabilityIgnore(actor),
		_crushCfg ~= nil and _crushCfg.type == "Crush" and _crushCfg.ignoreGuard == true)  -- GL-012 preview matches the push
	local d = DisplacementService.GetPushDirection(actor, target)
	local _arcCfg = ArmorPassiveService.GetPushArcConfig(actor)
	-- GL-013 Vector Gloves (DB "For adjacent targets, choose any legal outward direction (not just
	-- directly away)", 2026-10-29): every direction that moves an ADJACENT target farther from the
	-- user (Chebyshev 2 after one step). Not for pulls or Grappler swaps.
	local _vectorDirs = nil
	if dist == 1 and not grapplerSwap and not (pushOverride and pushOverride.reverseDirection)
		and ArmorPassiveService.CanPushChooseDirection(actor) then
		_vectorDirs = {}
		for vdx = -1, 1 do
			for vdy = -1, 1 do
				if (vdx ~= 0 or vdy ~= 0) and math.max(math.abs(target.tileX + vdx - actor.tileX),
					math.abs(target.tileY + vdy - actor.tileY)) == 2 then
					table.insert(_vectorDirs, { dx = vdx, dy = vdy })
				end
			end
		end
	end
	local preview = {
		maxPushDistance = maxPush,
		fromX = target.tileX, fromY = target.tileY,
		dirX = d.dx, dirY = d.dy,
		isPull = false, isSwap = false,
		isArc = _arcCfg ~= nil and _arcCfg.arcProjectile == true,  -- GL-015: landing tiles skip obstacles
		vectorDirs = _vectorDirs,  -- GL-013: choosable push directions (nil = straight away only)
	}
	if grapplerSwap then
		-- Swap first, then the target is thrown from the actor's current tile, away from the actor's new spot.
		preview.fromX, preview.fromY = actor.tileX, actor.tileY
		preview.dirX, preview.dirY = -d.dx, -d.dy
		preview.isSwap = true
	elseif pushOverride and pushOverride.reverseDirection then
		preview.dirX, preview.dirY = -d.dx, -d.dy
		preview.isPull = true
	end
	return preview
end

-- Object push setup, shared by the PushObject command and the turn-prompt preview (2026-10-28).
-- User ruling 2026-10-28: GL-004 Longarm Bracers (+1 range) and GL-005 Butcher's Gloves (Pull, min
-- range 2) apply to objects too, same as units. GL-017 Grappler's swap does NOT apply to objects.
-- Returns minDist, maxDist, force, isPull. Force: race bonus + GL-008 Siege Bracers +3 etc.
local function getObjectPushSetup(actor: any): (number, number, number, boolean)
	local pushOverride = getPushOverride(actor, nil)
	local minDist, maxDist = getPushRange(actor, pushOverride)
	-- GL-021 Initiator's Grips: while the free first push is still available, the preview shows its
	-- halved Force (the command applies the same, 2026-10-29).
	local freeCfg = ArmorPassiveService.GetFreePushConfig(actor)
	local force = getPushForce(actor, pushOverride, { isAlly = false, isObject = true, isFreePush = freeCfg ~= nil }, freeCfg)
	return minDist, maxDist, force, (pushOverride ~= nil and pushOverride.reverseDirection == true)
end

function CommandService.GetObjectPushSetup(actor: any): (number, number, number, boolean)
	return getObjectPushSetup(actor)
end

function CommandService.GetObjectPushForce(actor: any): number
	local _, _, force = getObjectPushSetup(actor)
	return force
end

--------------------------------------------------
-- COUNTER-ATTACK (Riposte Stance / Counter Stance reaction)
--
-- When a unit holding the CounterStance buff is hit by a DIRECT attack from an
-- attacker within its own equipped-weapon basic-attack reach, it immediately
-- strikes back with a basic attack (respecting weapon pattern incl. Cleave).
--
-- Design (user decisions 2026-09-28):
--   - No count limit: counters every eligible hit for the buff's duration.
--   - Balancer: each counter ADDS the defender's basic-attack RT to its
--     remainingRt (pushes its next turn out) — no AP, no action-RT.
--   - Reach = defender's basic-attack reach (ranged min-range, spear reach,
--     etc.), reusing GetAttackCandidates so it matches normal attacks exactly.
--   - Friendly fire allowed (cleave counter hits whatever is in the arc).
--   - RECURSION GUARD: a counter is flagged isCounter and NEVER triggers a
--     counter of its own (checked by the caller before calling this).
--------------------------------------------------

function CommandService.TriggerCounterIfEligible(defender: any, attacker: any, state: any, wasCounter: any, wasAOE: any, dealtDamage: any)
	-- Guard 0: only an attack that dealt DIRECT DAMAGE provokes a counter (USER
	-- RULING 2026-10-03). Basic Attacks always deal damage; damaging skills of ANY
	-- pattern qualify; zero-damage / pure-status / debuff-only skills (Steal,
	-- Silence, etc.) and hits fully absorbed to 0 do NOT provoke. `dealtDamage`
	-- nil defaults to true for back-compat with the basic-attack call path.
	if dealtDamage == false then return false end
	-- Guard 1: never let a counter (or AOE splash) trigger another counter.
	if wasCounter or wasAOE then return false end
	-- Guard 2: both units must be live and real, and not self.
	if not defender or not attacker then return false end
	if not defender.isAlive or not attacker.isAlive then return false end
	if defender.id == attacker.id then return false end
	-- Guard 2a: the quest-goal Capture target never counter-attacks (it avoids engaging; step 6
	-- follow-up to step-5 Tester WARN-2). Its other reactions are refused in CombatResolver.ApplyOutcome.
	if defender.isCaptureTarget then return false end
	-- Guard 2b: enemy-only (DB trigger rule TRG-004). An ally striking the
	-- stance holder (friendly fire, mind-control, etc.) must NOT provoke a counter.
	if attacker.side == defender.side then return false end
	-- Guard 3: defender must actually hold the stance.
	if not StatusService.HasStatus(defender, "CounterStance") then return false end

	-- Reach check: is the attacker a unit the defender could basic-attack right
	-- now? GetAttackCandidates already bundles weapon max range, min range, LoS,
	-- and elevation legality — the single source of truth for "my weapon can hit
	-- that tile". This makes the counter respect ranged min-range, spear reach,
	-- etc. exactly like a normal attack.
	local reachable = TargetingService.GetAttackCandidates(
		defender, state.units, (defender.weaponMaxRange or 1)
			+ DoctrinePassiveService.GetProjectileRangeModifier(defender, defender.weaponProjectileType) -- Ranger
	)
	local inReach = false
	for _, u in ipairs(reachable) do
		if u.id == attacker.id then inReach = true; break end
	end
	if not inReach then return false end

	-- Counter power multiplier: skills stamp their own value on the status
	-- instance (Riposte 0.85, Counter Stance 0.60); fall back to the status def.
	local inst = StatusService.HasStatus(defender, "CounterStance")
	local mult = (inst and inst.counterPowerMult)
		or (GameConstants.STATUSES.CounterStance and GameConstants.STATUSES.CounterStance.counterPowerMult)
		or 0.85

	local weaponDamage = defender.weaponDamage or 10
	local weaponPattern = defender.weaponPattern or "Single"

	-- Resolve the counter as a basic attack, reusing the weapon-pattern logic
	-- from the Attack commit path. Every counter hit is flagged isCounter so
	-- ApplyOutcome / the caller will not spawn a further counter.
	-- RAKE on counters (batch 8, 2026-11-22; weapons_equipment 163): a Claws counter resolves the same
	-- hits as the Attack branch through the same helper (WeaponPassiveService.GetRakeHits + the
	-- ResolveBasicAttack hitMult / noRiders opts; DAT-001, no copy of the numbers). Statuses ride only
	-- the first hit that deals damage; the Bleed bonus is per hit (ApplyOutcome, BUG-110).
	local _rkHits, _rkMult = WeaponPassiveService.GetRakeHits(defender)
	local _baOpts: any = nil
	local function resolveCounterHit(victim: any, dmgMult: any): number
		if not victim.isAlive then return 0 end
		local outcome = CombatResolver.ResolveBasicAttack(defender, victim, weaponDamage, _baOpts)
		outcome.isCounter = true
		outcome.finalDamage = math.max(0, math.round((outcome.finalDamage or 0) * mult * (dmgMult or 1.0)))
		if outcome.type == "Healing" and outcome.finalHealing then outcome.finalHealing = math.max(0, math.round(outcome.finalHealing * mult * (dmgMult or 1.0))) end -- Dark vs Undead heal reduced like damage (user ruling 2026-11-06)
		if (dmgMult or 1.0) < 1.0 then outcome.isAOE = true end
		CombatResolver.ApplyOutcome(outcome, victim, defender)
		BattleVisualBroadcaster.UnitStateChanged(victim)
		return if outcome.type == "Damage" then (outcome.finalDamage or 0) else 0
	end

	print(string.format("[CommandService] COUNTER | %s ripostes %s (x%.2f, %s)",
		defender.name, attacker.name, mult, weaponPattern))

	local _rkRidersDone = false
	local _counterHitsResolved = 0  -- Rake: the counter RT Delay below is delivered once per resolved hit (row 163)
	for _rk = 1, _rkHits do
		if _rk > 1 and not attacker.isAlive then break end
		_baOpts = if _rkHits > 1 then { hitMult = _rkMult, noRiders = _rkRidersDone } else nil
		local _passDmg = 0
		if weaponPattern == "Cleave" or weaponPattern == "Adjacent" then
			local cleave = TargetingService.GetCleaveTargets(defender, attacker, state.units)
			for _, u in ipairs(cleave) do
				_passDmg += resolveCounterHit(u, (u.id == attacker.id) and 1.0 or 0.5)
			end
		elseif weaponPattern == "ImpactSplash" then
			local splash = TargetingService.GetImpactSplashTargets(defender, attacker, state.units)
			for _, entry in ipairs(splash) do
				_passDmg += resolveCounterHit(entry.unit, entry.dmgMult)
			end
		elseif weaponPattern == "Line2" or weaponPattern == "Line3" then
			local line = TargetingService.GetWeaponLineTargets(weaponPattern, defender, attacker, state.units)
			for _, entry in ipairs(line) do
				_passDmg += resolveCounterHit(entry.unit, entry.dmgMult or 1.0)
			end
		else
			_passDmg += resolveCounterHit(attacker, 1.0)
		end
		_counterHitsResolved = _rk
		if _rkHits > 1 then
			if _passDmg > 0 then _rkRidersDone = true end
			print(string.format("[CommandService] COUNTER Rake hit %d/%d: %s -> %s (x%.2f)", _rk, _rkHits, defender.name, attacker.name, _rkMult))
		end
	end
	_baOpts = nil

	-- Rule 250 (2026-11-08): a counter's weapon splash also hits map objects beside the attacker.
	if weaponPattern ~= "Single" and attacker.tileX then
		ObjectEffectService.HitObjectsOnTiles(state,
			TargetingService.GetSplashTilesBeside(defender, weaponPattern, attacker.tileX, attacker.tileY, attacker),
			defender, defender.weaponElement or "Physical", {})
	end

	-- BALANCER: each counter delays the defender's next turn by its basic-attack RT.
	local counterRt = calcBasicAttackBaseRt(defender)
	defender.remainingRt = (defender.remainingRt or 0) + counterRt
	print(string.format("[CommandService] COUNTER RT | %s next turn +%d RT (now %d)",
		defender.name, counterRt, defender.remainingRt))
	BattleVisualBroadcaster.UnitStateChanged(defender)
	BattleVisualBroadcaster.Log("rt", `{defender.name} counterattacks; own next turn +{counterRt} RT.`, defender.id)

	-- Weapon RT Delay to the ATTACKER (DB: Riposte 50% / Counter Stance 30% of the
	-- defender's Weapon RT Delay). Separate from the counter damage — an extra
	-- turn-order setback on whoever provoked the counter. VIT-resisted, exactly
	-- like a normal basic attack's RT delay.
	local rtDelayMult = (inst and inst.counterRtDelayMult) or 0
	local rawDelay = GameConstants.CalcRtDelayBonus(defender.weaponRtDelay or 0, (defender.effectiveStats and defender.effectiveStats.STR) or 10) * rtDelayMult
	-- Juggernaut / Duelist: delivered Weapon RT Delay +15% (2026-10-28).
	rawDelay = rawDelay * DoctrinePassiveService.GetWeaponRtDelayModifier(defender)
	-- Time Locker / Time Freed / Timeline Sovereign: counter RT delay is RT delay caused (re-check 2026-10-29).
	rawDelay = rawDelay * TraitEffectService.GetRtDelayInflictMultiplier(defender)
	if rawDelay > 0 and attacker.isAlive then
		local atkVit = attacker.effectiveStats and attacker.effectiveStats.VIT or 10
		local delay = GameConstants.CalcRtDelayResistance(math.round(rawDelay), atkVit, (attacker.gearDerived and attacker.gearDerived.rtDelayResist or 1))
		-- Rake (row 163, batch 8): one resisted delay per resolved hit, like the Attack branch (1 without Rake).
		delay = math.max(0, delay) * math.max(1, _counterHitsResolved)
		attacker.remainingRt = (attacker.remainingRt or 0) + delay
		print(string.format("[CommandService] COUNTER RT-DELAY | %s +%d RT (x%.2f weapon delay)",
			attacker.name, math.max(0, delay), rtDelayMult))
		BattleVisualBroadcaster.Log("rt", `{attacker.name} is delayed +{math.max(0, delay)} RT by the counter.`, attacker.id)
		BattleVisualBroadcaster.UnitStateChanged(attacker)
	end
	return true
end

--------------------------------------------------
-- ITEM TARGET VALIDATION
--
-- Validates that a consumable item's target satisfies the
-- targetRules from ConsumableData. Range is Chebyshev distance.
--------------------------------------------------

local function validateItemTarget(actor: any, target: any, consumableDef: any): (boolean, any)
	local rules = consumableDef.targetRules or "Self"
	-- ARTIFICER — Applied Artifice: Consumable Item Maximum Range +1 (2026-10-20).
	local range = (consumableDef.range or 0) + DoctrinePassiveService.GetConsumableRangeBonus(actor)
		+ ArmorPassiveService.GetItemRangeBonus(actor)  -- AC Accessory: Item Maximum Range +2 (0 default)
		+ ItemEffectService.GetTrapRangeBonus(actor, consumableDef)  -- AC-012 Trapmaker's Roll: Trap items +3

	-- Self / Self-origin: must target self (or no explicit target needed)
	if rules == "Self" then
		if not target or target.id ~= actor.id then
			return false, "This item can only target yourself."
		end
		return true, nil
	end

	if rules == "Self-origin" or rules == "Self and Allies" then
		-- Self-centered AOE: user is the implicit center. A Line / Cone aim tile (user
		-- ruling 2) must lie within the aim range (2026-10-26 UAT finding).
		local aim = ItemEffectService.GetItemAimRange(actor, consumableDef)
		if aim and target and target.tileX then
			local d = math.max(math.abs(actor.tileX - target.tileX), math.abs(actor.tileY - target.tileY))
			if d > math.max(range, aim) then
				return false, "Target is out of range."
			end
		elseif not aim and type(target) == "table" and target.tileX
			and (target.tileX ~= actor.tileX or target.tileY ~= actor.tileY) then
			-- Server range check (audit fix 2026-10-27, War Cry Horn / Rally Array): a self-centred
			-- area item is always centred on the user. A tapped tile (an item-range bonus lets the
			-- client offer nearby tiles) is snapped back to the user's own tile; a different unit
			-- sent as the target is refused.
			if target.id ~= nil and target.id ~= actor.id then
				return false, "This item is centred on you."
			end
			target.tileX, target.tileY = actor.tileX, actor.tileY
		end
		return true, nil
	end

	-- Battlefield / Global: no target needed (whole-battle effect, e.g. weather beacons).
	-- The effect handler reads battle state directly; nothing to position or range-check.
	if rules == "Battlefield" or rules == "Global" then
		return true, nil
	end

	-- KO Ally: special — target must be dead. Widened 2026-10-24: a KO'd ENEMY is
	-- also a valid revive target (returns on the enemy side; feeds the Torture
	-- objective + enables recruit-a-revived-enemy). Allies still revivable too.
	if rules == "KO Ally" then
		if not target then
			return false, "This item requires a KO'd target."
		end
		if target.isAlive then
			return false, "This item can only target a KO'd unit."
		end
		local dist = math.max(
			math.abs(actor.tileX - (target.tileX or 0)),
			math.abs(actor.tileY - (target.tileY or 0))
		)
		if dist > range then
			return false, "Target is out of range."
		end
		return true, nil
	end

	-- Ground / Tile targeting: target is a coordinate table { tileX, tileY }.
	-- Empty Tile (deployables / emitters) and Self to Empty Tile (teleport) pick a tile
	-- the same way (2026-10-26); the teleport's reach comes from its pattern formula.
	if rules == "Self to Empty Tile" then
		range = math.max(range, ItemEffectService.GetItemAimRange(actor, consumableDef) or 0)
	end
	if rules == "Ground" or rules == "Tile" or rules == "Enemy or Ground"
		or rules == "Empty Tile" or rules == "Self to Empty Tile"
		or rules == "Owned Deployable"  -- Object Recall: tap the destination tile
		or rules == "Mechanical Object"  -- Maintenance Tool: tap the device / gadget
		or rules == "Breakable Terrain"  -- Excavation Drill: tap the tile
		or rules == "Gap Endpoints"  -- Bridge Projector: tap the gap
		or rules == "Object or Unit" then  -- Breaching Drill: tap the tile
		if not target then
			return false, "This item requires a target location."
		end
		local tx = target.tileX or 0
		local ty = target.tileY or 0
		local dist = math.max(
			math.abs(actor.tileX - tx),
			math.abs(actor.tileY - ty)
		)
		if dist > range then
			return false, "Target is out of range."
		end
		return true, nil
	end

	-- All remaining rules require a living unit target
	if not target then
		return false, "This item requires a target."
	end
	-- Any-side unit rules (Kinetic Ram, Grapple Cable, Exchange Device: "Ally or Enemy")
	-- never target the user themself.
	if (rules == "Unit or Object" or rules == "Ally or Enemy" or rules == "Enemy or Ally") and target.id == actor.id then
		return false, "This item cannot target yourself."
	end
	-- Holy Water (DAM-009 "Enemy or Ally"): an enemy target must be Undead (nothing else
	-- would happen to it), refused here before any cost is paid.
	if rules == "Enemy or Ally" and target.side ~= actor.side
		and not (CombatResolver.IsUndead and CombatResolver.IsUndead(target)) then
		return false, "Only Undead enemies or allies can be targeted."
	end
	if not target.isAlive then
		return false, "Target is defeated."
	end

	-- Chebyshev range check
	local dist = math.max(
		math.abs(actor.tileX - (target.tileX or 0)),
		math.abs(actor.tileY - (target.tileY or 0))
	)
	if dist > range then
		return false, "Target is out of range."
	end

	-- All-tile widening (2026-10-24): ally-only / enemy-only consumables accept a
	-- target of ANY side (heal/buff an enemy, damage-item an ally). Hide still
	-- protects; the bare "Ally" rule keeps its not-self restriction. Mirrors the
	-- skill path. isAlive + range were already checked above.
	if TargetingService.IsWidenedItemRule(rules) then
		if StatusService.HasStatus(target, "Hide") then
			return false, "Target is hidden."
		end
		if rules == "Ally" and target.id == actor.id then
			return false, "This item can only target an ally (not yourself)."
		end
	elseif rules == "Self or Ally" then
		if target.side ~= actor.side then
			return false, "This item can only target yourself or an ally."
		end
	elseif rules == "Ally" or rules == "Ally or Object" then
		-- "Ally or Object" (Recovery Winch, 2026-10-26): ally units only for now; pulling an
		-- object is not built (objects have no move path).
		if target.side ~= actor.side or target.id == actor.id then
			return false, "This item can only target an ally (not yourself)."
		end
	elseif rules == "Enemy" or rules == "Enemy Unit" then
		if target.side == actor.side then
			return false, "This item can only target an enemy."
		end
	elseif rules == "Any Unit" then
		-- Any living unit is valid (isAlive already checked above)
	elseif rules == "Mechanical Unit/Object" then
		-- Magnetic Snare (2026-10-26): a Mechanical-race unit of either side, not yourself.
		-- Objects are not supported yet.
		if target.id == actor.id then
			return false, "This item cannot target yourself."
		end
		if not (CombatResolver.HasRaceTag and CombatResolver.HasRaceTag(target, "Mechanical")) then
			return false, "This item only works on Mechanical units."
		end
	end

	return true, nil
end

--------------------------------------------------
-- ITEM EFFECT RESOLUTION
--
-- Parses effectFormula from ConsumableData and applies the
-- immediate effect. Returns a result table for broadcasting.
--
-- Supported categories:
--   A) HP Recovery   — "Restore N% ... Max HP"
--   B) MP Recovery   — "Restore N% ... Max MP"
--   C) Status Cure   — "Remove [status] and [status]"
--   D) Direct Damage  — "Deal [element] damage equal to N% Weapon Attack Power"
--   E) Status Apply   — "Apply [status] for N turns"
--   F) Unimplemented  — anything else (logged, skipped)
--
-- NOTE: AI item usage would hook into CommandService.GetItemCandidates
-- (not yet implemented — see Main.server.lua AI turn logic).
--------------------------------------------------

local function resolveItemEffect(user: any, target: any, consumableDef: any, allUnits: any, state: any)
	-- Delegated to ItemEffectService (2026-10-26): a single, data-driven dispatcher that
	-- routes each consumable to the system already owning that effect. The former 6-pattern
	-- inline parser lived here and silently no-op'd 116 of 140 items; that logic now lives
	-- (migrated verbatim) in ItemEffectService, alongside the new handlers.
	return ItemEffectService.Resolve(user, target, consumableDef, allUnits, { mapWidth = _mapWidth, mapHeight = _mapHeight, state = state })
end
--------------------------------------------------
-- REVIVE SKILL RESOLUTION (2026-10-24)
--
-- Shared by the instant and channeled skill-resolution branches. Brings a KO'd
-- target back to life at skillDef.reviveHpPct% Max HP, scaled by the caster's
-- Skill Potency (skills-only stat; GameConstants.CalcSkillPotency — single source)
-- and the target's Perks & Flaws revive modifiers (same as Interact/potion revive).
-- Phoenix Rite extras: cleanseWound removes one wound-family status (Bleed/Raptured/
-- Wounded); reviveLowRt brings the unit back ready to act soon. Enemy revive is
-- allowed (target keeps its own side) and feeds the Torture objective.
local function applyReviveSkill(caster: any, target: any, skillDef: any, state: any, hpScale: number?): number
	-- hpScale: extra units revived by a spreading augment get a share of the main revive (ruling 2026-10-28).
	local pct = (skillDef.reviveHpPct or 5) / 100 * (hpScale or 1)
	local maxHp = target.maxHp or 1
	local reviveHp
	if TraitEffectService.HasReviveAtOneHp(target) then
		reviveHp = 1
	else
		local casterInt = (caster.effectiveStats and caster.effectiveStats.INT) or 10
		local potency = GameConstants.CalcSkillPotency(casterInt)
		local effFrac = pct * potency * TraitEffectService.GetReviveHpMultiplier(target)
			+ TraitEffectService.GetReviveHpBonusFraction(target)
		reviveHp = math.max(1, math.ceil(maxHp * effFrac))
		reviveHp = math.min(reviveHp, maxHp)
	end
	target.isAlive     = true
	UnitSchema.ClearChannelState(target)  -- never return holding a pre-death channel
	target._revivedThisBattle = true  -- kill-credit rule: revived units never trigger kill augments
	target.currentHp   = reviveHp
	StatusService.WeakenVenomOnHeal(target)  -- a revive weakens Venom like a heal (user ruling 2026-10-26)
	target.remainingRt = skillDef.reviveLowRt and 150 or (target.startingRt or 400)
	if skillDef.cleanseWound then
		for _, s in ipairs({ "Wounded", "Raptured", "Bleed" }) do
			if StatusService.HasStatus(target, s) then
				StatusService.RemoveStatus(target, s)
				break
			end
		end
	end
	-- Torture objective: reviving a KO'd ENEMY (returns on its own side) counts.
	if state and target.side ~= caster.side then
		ObjectiveService.RecordEvent(state, "enemiesRevived", 1)
	end
	if BattleVisualBroadcaster and BattleVisualBroadcaster.UnitStateChanged then
		BattleVisualBroadcaster.UnitStateChanged(target)
	end
	print(string.format("[CommandService] REVIVE SKILL [%s] | %s revives %s at %d/%d HP%s",
		skillDef.name or skillDef.id, caster.name, target.name, reviveHp, maxHp,
		(target.side ~= caster.side) and " (ENEMY revive)" or ""))
	return reviveHp
end

--------------------------------------------------
-- RAISE DEAD (Chaos Necromancer, USER RULING 2026-10-27). Corpses = fallen units on the caster's side
-- that are real units (not summons, not objects, not units that left the map), never raised before.
--------------------------------------------------
local UNDEAD_IMMUNE_STATUSES = { "Poison", "Venom", "Bleed", "Raptured", "Wounded" }

local function raisableCorpses(caster: any, units: any): { any }
	local list = {}
	for _, u in ipairs(units or {}) do
		if not u.isAlive and u.side == caster.side and u.id ~= caster.id
			and not u.isSummon and not u.isObject and not u.isGroundTarget and not u.leftMap
			and not u._raisedAsUndead and u.tileX and u.tileY then
			table.insert(list, u)
		end
	end
	-- Stable order (deterministic tile assignment when corpses compete for space).
	table.sort(list, function(a, b) return tostring(a.id) < tostring(b.id) end)
	return list
end

function CommandService.CountRaisableCorpses(caster: any, units: any): number
	if not caster then return 0 end
	return #raisableCorpses(caster, units)
end

-- Nearest free tile to (x, y): on the map, not blocked, no living unit. Searches rings out to 3.
local function nearestFreeTile(state: any, x: number, y: number): (number?, number?)
	-- Shared revive-tile rule (UnitSchema.FindFreeTileNear): on the map, not blocked, impassable or a
	-- chasm floor, no living unit; rings out to 3.
	return UnitSchema.FindFreeTileNear(state.units, x, y, _mapWidth, _mapHeight)
end

-- SPREADING REVIVES (USER RULING 2026-10-28; DB skills Battlefield Triage / Phoenix Rite): Chain Support,
-- Line Projection and Impact Splash also revive extra KO'd units on the SAME SIDE as the main target.
-- Extra HP = the main revive's HP fraction x the falloff: Chain 75% per jump (max 2 jumps, jump range 2,
-- elevation +/-2, no unit twice), Line 75% for the unit directly behind the target, Splash 50% on each of
-- the 4 cardinal tiles (elevation +/-2). Each extra follows the normal revive rules (applyReviveSkill).
local SPREAD_REVIVE_MODES = {
	["AUG-CHAIN-SUPPORT"] = "chain",
	["AUG-LINE-PROJECTION"] = "line",
	["AUG-IMPACT-SPLASH"] = "splash",
}

local function isRevivableCorpse(u: any, side: any): boolean
	return u ~= nil and not u.isAlive and u.side == side and not u.isSummon and not u.isGroundTarget
		and not u.leftMap and u.tileX ~= nil and u.tileY ~= nil
end

-- Extra units a spreading augment reaches, worked out from where the bodies lie before anyone rises.
local function spreadReviveTargets(caster: any, main: any, skillDef: any, state: any): ({ any }, string?)
	local mode = nil
	for _, augId in ipairs(AugmentEffectService.GetAugmentsForSkill(caster, skillDef.id) or {}) do
		mode = SPREAD_REVIVE_MODES[augId]
		if mode then break end  -- Pattern augments conflict with each other: the first one applies
	end
	if not mode then
		return {}, nil
	end
	local side = main.side
	local out = {}
	local seen = { [main.id] = true }
	local function elevOk(ax, ay, bx, by)
		return math.abs(GameConstants.GetElevation(ax, ay) - GameConstants.GetElevation(bx, by)) <= 2
	end
	local function addCorpsesAt(x, y, scale)
		local list = {}
		for _, u in ipairs(state.units) do
			if not seen[u.id] and isRevivableCorpse(u, side) and u.tileX == x and u.tileY == y then
				table.insert(list, u)
			end
		end
		table.sort(list, function(a, b) return tostring(a.id) < tostring(b.id) end)
		for _, u in ipairs(list) do
			seen[u.id] = true
			table.insert(out, { unit = u, scale = scale })
		end
	end
	if mode == "chain" then
		local cur, scale = main, 1
		for _ = 1, 2 do
			local best, bestD = nil, math.huge
			for _, u in ipairs(state.units) do
				if not seen[u.id] and isRevivableCorpse(u, side) then
					local d = math.max(math.abs(u.tileX - cur.tileX), math.abs(u.tileY - cur.tileY))
					if d <= 2 and elevOk(cur.tileX, cur.tileY, u.tileX, u.tileY)
						and (d < bestD or (d == bestD and best and tostring(u.id) < tostring(best.id))) then
						best, bestD = u, d
					end
				end
			end
			if not best then break end
			scale = scale * 0.75
			seen[best.id] = true
			table.insert(out, { unit = best, scale = scale })
			cur = best
		end
	elseif mode == "line" then
		local dx = if main.tileX > caster.tileX then 1 elseif main.tileX < caster.tileX then -1 else 0
		local dy = if main.tileY > caster.tileY then 1 elseif main.tileY < caster.tileY then -1 else 0
		if dx ~= 0 or dy ~= 0 then
			local bx, by = main.tileX + dx, main.tileY + dy
			if elevOk(main.tileX, main.tileY, bx, by) then
				addCorpsesAt(bx, by, 0.75)
			end
		end
	else
		for _, d in ipairs({ { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } }) do
			local x, y = main.tileX + d[1], main.tileY + d[2]
			if elevOk(main.tileX, main.tileY, x, y) then
				addCorpsesAt(x, y, 0.50)
			end
		end
	end
	return out, mode
end

-- A unit about to rise stays on its tile, or moves to the nearest free tile within 3 when a living
-- unit now stands there (same rule as Raise Dead). Returns ok, moved. ok = false: no free tile.
local function placeForRevive(u: any, state: any): (boolean, boolean)
	for _, o in ipairs(state.units) do
		if o.isAlive and o ~= u and o.tileX == u.tileX and o.tileY == u.tileY then
			local tx, ty = nearestFreeTile(state, u.tileX, u.tileY)
			if not tx then
				return false, false
			end
			u.tileX, u.tileY = tx, ty
			return true, true
		end
	end
	return true, false
end

-- Revive skill cast (Battlefield Triage, Phoenix Rite): the chosen unit, then any extra units its
-- spreading augment reaches. Returns the chosen unit's revive HP (0 = could not rise) and the extras.
local function resolveReviveCast(caster: any, target: any, skillDef: any, state: any): (number, number)
	local extras, mode = spreadReviveTargets(caster, target, skillDef, state)
	local ok, moved = placeForRevive(target, state)
	if not ok then
		warn(`[CommandService] REVIVE FIZZLE | {target.name} has no free tile to rise on`)
		caster._skillFizzled = true  -- nobody rose: no once-per-cast augment effects
		return 0, 0
	end
	if moved then
		BattleVisualBroadcaster.UnitMoved(target)
	end
	local hp = applyReviveSkill(caster, target, skillDef, state)
	local count = 0
	for _, e in ipairs(extras) do
		local u = e.unit
		if not u.isAlive then
			local okE, movedE = placeForRevive(u, state)
			if okE then
				if movedE then
					BattleVisualBroadcaster.UnitMoved(u)
				end
				applyReviveSkill(caster, u, skillDef, state, e.scale)
				count = count + 1
			else
				print(`[CommandService] SPREAD REVIVE | {u.name} has no free tile; stays down`)
			end
		end
	end
	if mode then
		print(`[CommandService] SPREAD REVIVE [{mode}] | {caster.name} also revives {count} unit(s)`)
	end
	return hp, count
end

-- Raises every corpse at once: 25% Max HP, Undead status, counts as revived. A corpse whose tile is
-- taken rises on the nearest free tile; with no free tile within 3 it stays down. Returns the count.
local function raiseCorpses(caster: any, skillDef: any, state: any): number
	local pct = (skillDef.reviveHpPct or 25) / 100
	local raised = 0
	for _, u in ipairs(raisableCorpses(caster, state.units)) do
		local tx, ty = nearestFreeTile(state, u.tileX, u.tileY)
		if tx then
			local moved = (tx ~= u.tileX or ty ~= u.tileY)
			u.tileX, u.tileY = tx, ty
			u.isAlive = true
			UnitSchema.ClearChannelState(u)  -- never return holding a pre-death channel
			u._revivedThisBattle = true  -- kill-credit rule: revived units never trigger kill augments
			u._raisedAsUndead = true
			u.currentHp = UnitSchema.ReviveHp(u, pct)  -- revive traits apply (re-check 2026-10-29)
			u.remainingRt = u.startingRt or 400
			-- Undead are immune to these; a corpse carrying one loses it on rising.
			for _, sid in ipairs(UNDEAD_IMMUNE_STATUSES) do
				if StatusService.HasStatus(u, sid) then
					StatusService.RemoveStatus(u, sid)
				end
			end
			StatusService.ApplyStatus(u, "Undead", caster.id)
			if moved then
				BattleVisualBroadcaster.UnitMoved(u)
			end
			BattleVisualBroadcaster.StatusApplied(u, "Undead", nil, nil)
			if BattleVisualBroadcaster.UnitStateChanged then
				BattleVisualBroadcaster.UnitStateChanged(u)
			end
			raised = raised + 1
			print(string.format("[CommandService] RAISE DEAD | %s raises %s at %d/%d HP (%d,%d)%s",
				caster.name, u.name, u.currentHp, u.maxHp or 0, tx, ty, moved and " (moved: tile taken)" or ""))
		else
			warn(`[CommandService] RAISE DEAD | no free tile near {u.name}; it stays down`)
		end
	end
	-- Once per battle (user ruling). Only spent when something actually rose, so a channel that
	-- finds no corpse it can raise (e.g. a Zombie got up on its own) can be tried again later.
	if raised > 0 then
		caster._corpsesRaised = true
		BattleVisualBroadcaster.Log("ko", `{caster.name} raises {raised} fallen as Undead.`, caster.id)
	end
	return raised
end


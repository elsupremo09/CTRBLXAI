			addRow(`Your guild's renown grows! Renown Rank {tonumber(rn.rankAfter) or rn.rankUps[#rn.rankUps]}`,
				Theme.Colors.TextGold, Theme.Font.PrimaryBold, Theme.Text.Small(), 16)

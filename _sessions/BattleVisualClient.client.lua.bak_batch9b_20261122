local TILE_SIZE = 5
local MAP_WIDTH, MAP_HEIGHT = 30, 20
local MAP_OFFSET_X = -75
local MAP_OFFSET_Z = -50
local BATTLE_OFFSET_X, BATTLE_OFFSET_Y = 0, 0

local elevationMap = nil
-- Temporary roads (ENV-019, 2026-10-27): ["x,y"] = move-cost cut. Read by the tile inspector.
local roadCuts = {}
-- Move-cost penalties (ENV-003, 2026-10-27): ["x,y"] = extra cost. Read by the tile inspector.
local moveCostAdds = {}

local function getElevation(tx, ty)
	if elevationMap then local r = elevationMap[ty]; if r then return r[tx] or 1 end end; return 1
end
local function tileSurfaceY(elev) return GameConstants.TileSurfaceY(elev) end
local R15_STAND_OFFSET_DEFAULT = 2.35  -- fallback if HipHeight can't be read
local function tileToWorld(tx, ty)
	return Vector3.new(MAP_OFFSET_X + (tx - 0.5) * TILE_SIZE, tileSurfaceY(getElevation(tx, ty)) + 1, MAP_OFFSET_Z + (ty - 0.5) * TILE_SIZE)
end
local function _tileToWorldR15(tx, ty, hipHeight)
	-- Returns the HRP center position for an R15 model standing on this tile.
	-- hipHeight = distance from feet (tile surface) to HRP center.
	local offset = hipHeight or R15_STAND_OFFSET_DEFAULT
	return Vector3.new(MAP_OFFSET_X + (tx - 0.5) * TILE_SIZE, tileSurfaceY(getElevation(tx, ty)) + offset, MAP_OFFSET_Z + (ty - 0.5) * TILE_SIZE)
end

-- TILE / OBJECT PART CACHE (user 2026-11-18 4:38 PM, battle heat fix 3; PRF-001 event-driven,
-- PRF-004 tracked connections). The hover, tap, grounding and object rays used to call
-- mapFolder:GetChildren() and rebuild a fresh filter list EVERY time (600+ children on a 30x20
-- map, 60x/s for hover). Now one list per map: rebuilt lazily only when the map folder changes
-- or a child is added/removed (ChildAdded/ChildRemoved mark it dirty). Same filters as before:
-- tiles = BaseParts with IsTemplateTile, objects = children named MapObjModel_*.
local _tileCache = { folder = nil :: Instance?, dirty = true, tiles = {}, objects = {}, byName = {}, conns = {} }
local function _tileCacheBind(folder: Instance?)
	for _, c in ipairs(_tileCache.conns) do c:Disconnect() end
	_tileCache.conns = {}
	_tileCache.folder = folder
	_tileCache.dirty = true
	if folder then
		local function mark() _tileCache.dirty = true end
		table.insert(_tileCache.conns, folder.ChildAdded:Connect(mark))
		table.insert(_tileCache.conns, folder.ChildRemoved:Connect(mark))
	end
end
local function getMapPartCache()
	local mf = workspace:FindFirstChild("TemplateViewerMap")
	if mf ~= _tileCache.folder then _tileCacheBind(mf) end
	if _tileCache.dirty then
		_tileCache.dirty = false
		local tiles, objects, byName = {}, {}, {}
		if mf then
			for _, c in ipairs(mf:GetChildren()) do
				if c:IsA("BasePart") and c:GetAttribute("IsTemplateTile") then
					table.insert(tiles, c)
					byName[c.Name] = c
				elseif string.sub(c.Name, 1, 12) == "MapObjModel_" then
					table.insert(objects, c)
				end
			end
		end
		_tileCache.tiles, _tileCache.objects, _tileCache.byName = tiles, objects, byName
	end
	return _tileCache
end
-- O(1) tile lookup by template coords (Tile_%02d_%02d), nil if missing.
local function getCachedTile(tx: number, ty: number): BasePart?
	local tp = getMapPartCache().byName[string.format("Tile_%02d_%02d", tx, ty)]
	if tp and tp.Parent then return tp end
	return nil
end

-- Raycast down to the ACTUAL rendered ground at a tile center. Roblox Terrain
-- voxels quantize to a ~4-stud grid, so the visible surface can sit up to ~2
-- studs above the flat tile-Part top (tileSurfaceY). Placing feet at
-- tileSurfaceY buries the unit in the voxel hill after a move. This returns
-- the true surface Y; falls back to grid math on a ray miss.
-- Excludes overlays that float above ground (TileHighlights frames/pads,
-- GridOverlay), unit models, and battle visuals — but KEEPS TemplateViewerMap
-- so man-made SurfaceGui-terrain tiles (no voxel fill) still register.
local function groundSurfaceY(tx, ty)
	local wx = MAP_OFFSET_X + (tx - 0.5) * TILE_SIZE
	local wz = MAP_OFFSET_Z + (ty - 0.5) * TILE_SIZE
	local rp = RaycastParams.new()
	-- FLOOR-FINDER HARDENING (2026-10-23): the floor ray used to be a BLOCKLIST (hit
	-- anything EXCEPT a few named folders + MapObjModel_* objects), so any OTHER query-able
	-- thing standing on or overhanging a tile -- a tall neighbouring ridge-spike, a
	-- billboard, a prop, anything added later -- could be accepted as "the floor" and lift
	-- (or sink) the unit. A blocklist can never cover every case. Flip it to an ALLOWLIST:
	-- only ACTUAL terrain tiles (the IsTemplateTile parts) count as ground. Nothing on top
	-- of a tile can ever be mistaken for the surface again -- closes the whole float/bury
	-- class, not one map's instance. (Replaces the Oct 5 MapObjModel_ exclude, now moot.)
	local tileParts = getMapPartCache().tiles -- cached per map (battle heat fix 3)
	if #tileParts > 0 then
		rp.FilterType = Enum.RaycastFilterType.Include
		rp.FilterDescendantsInstances = tileParts
		local res = workspace:Raycast(Vector3.new(wx, 200, wz), Vector3.new(0, -400, 0), rp)
		if res then return res.Position.Y, res.Instance end
	end
	-- Ray missed a real tile (or the map folder wasn't ready): fall back to grid math.
	-- Logged so a persistent float/bury during testing points here instead of being silent.
	warn(string.format("[Ground] No terrain tile under (%d,%d) -- using grid-height fallback.", tx, ty))
	return tileSurfaceY(getElevation(tx, ty)), nil
end

-- R15 world position grounded to the real terrain surface (see groundSurfaceY).
local function tileToWorldR15Grounded(tx, ty, hipHeight)
	local offset = hipHeight or R15_STAND_OFFSET_DEFAULT
	return Vector3.new(MAP_OFFSET_X + (tx - 0.5) * TILE_SIZE, groundSurfaceY(tx, ty) + offset, MAP_OFFSET_Z + (ty - 0.5) * TILE_SIZE)
end

-- Grounded twin of tileToWorld (surface + 1) for the cylinder fallback token.
local function tileToWorldGrounded(tx, ty)
	return Vector3.new(MAP_OFFSET_X + (tx - 0.5) * TILE_SIZE, groundSurfaceY(tx, ty) + 1, MAP_OFFSET_Z + (ty - 0.5) * TILE_SIZE)
end

-- DEPLOYMENT-PHASE GROUNDING (2026-10-20): during deployment the SERVER places
-- unit models with flat tile math (GameConstants.TileSurfaceY), which is correct
-- on flat SurfaceGui tiles but CANNOT see VOXEL terrain (Grassland / Deep Water /
-- Shallow Water) whose rendered surface sits a couple studs higher — so units on
-- voxel tiles spawn buried during deployment. Only the client can raycast the real
-- rendered surface (groundSurfaceY), and only the client runs the pivot-gap feet
-- correction (GameConstants.GroundModelPivotCFrame). This helper applies BOTH to an
-- already-spawned model, found by its "Unit_<id>" name under workspace.UnitModels.
-- It reuses the exact grounding the battle-start spawn path uses (no new math) so
-- every phase grounds identically. Returns true once the model is found+grounded,
-- false if it hasn't replicated to the client yet (caller may retry).
local function groundDeployedUnitModel(unitId, tileX, tileY)
	if not (unitId and tileX and tileY) then return false end
	local umf = workspace:FindFirstChild("UnitModels")
	if not umf then return false end
	local model = umf:FindFirstChild("Unit_" .. unitId)
	if not model then return false end
	local anchor = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")
	if not anchor then return false end
	local feetY = groundSurfaceY(tileX, tileY)
	local wx = MAP_OFFSET_X + (tileX - 0.5) * TILE_SIZE
	local wz = MAP_OFFSET_Z + (tileY - 0.5) * TILE_SIZE
	-- FACING-PRESERVE FIX (2026-10-21): grounding must change only HEIGHT, never
	-- rotation. Passing nil here reset the model to identity rotation and wiped the
	-- center-facing the SERVER baked in at placement (regression that broke unit
	-- facing in deployment). Pass the model's CURRENT pivot as the facing arg so
	-- GroundModelPivotCFrame keeps the existing rotation and only re-seats the feet.
	model:PivotTo(GameConstants.GroundModelPivotCFrame(model, wx, feetY, wz, model:GetPivot()))
	anchor.Anchored = true
	return true
end

-- Ground now; if the model hasn't replicated yet, retry briefly. Not fatal if it
-- never appears during deployment — the battle-start spawn path grounds every model
-- again anyway; this only makes them sit correctly DURING deployment too.
local function groundDeployedUnitModelWhenReady(unitId, tileX, tileY)
	if groundDeployedUnitModel(unitId, tileX, tileY) then return end
	task.spawn(function()
		for _ = 1, 10 do           -- up to ~3s (10 x 0.3s)
			task.wait(0.3)
			if groundDeployedUnitModel(unitId, tileX, tileY) then return end
		end
	end)
end

-- WATERFALL SPLASH: scan the terrain grid and place a persistent "Splashing Water"
-- VFX on each waterfall BASE tile — a water tile that has a cardinally-adjacent
-- water neighbour at a HIGHER elevation (i.e. water falls onto it). The splash
-- sits on the base tile's surface, nudged toward the higher neighbour so it reads
-- as the point where the fall lands. Uses the SAME water rule as the server-side
-- waterfall fill (both waters count), so splashes line up with the water sheets.
-- Client-side + visual-only; cleared and rebuilt on every MapDataSync.
local WATERFALL_WATER = { ["Deep Water"] = true, ["Shallow Water"] = true }
local function placeWaterfallSplashes()
	if not VFXController or not VFXController.AddWaterfallSplash then return end
	pcall(VFXController.ClearWaterfallSplashes)
	local reg = VFXController.GetRegistry and VFXController.GetRegistry() or nil
	local assetName = reg and reg.Waterfall or "Splashing Water"
	local dirs = { {1,0}, {-1,0}, {0,1}, {0,-1} }
	-- A splash only appears at a REAL waterfall: the higher water neighbour must be
	-- at least this many elevation levels above the lower water tile. A 1-2 level
	-- water step still shows the connecting water sheet (server-side) but NO splash,
	-- so gently-sloped pools don't spam splashes everywhere — only genuine drops.
	local WATERFALL_MIN_DROP = 3
	for ty = 1, MAP_HEIGHT do
		for tx = 1, MAP_WIDTH do
			local tId = GameConstants.GetTerrainId(tx, ty)
			if WATERFALL_WATER[tId] then
				local selfElev = getElevation(tx, ty)
				-- Find a cardinal water neighbour that is higher by a real DROP
				-- (>= WATERFALL_MIN_DROP levels) — i.e. water genuinely falls onto me.
				local nudgeX, nudgeZ, found = 0, 0, false
				for _, d in ipairs(dirs) do
					local nx, ny = tx + d[1], ty + d[2]
					local nId = GameConstants.GetTerrainId(nx, ny)
					if nId and WATERFALL_WATER[nId] and (getElevation(nx, ny) - selfElev) >= WATERFALL_MIN_DROP then
						found = true
						-- Nudge toward the higher neighbour (where the fall lands).
						nudgeX = nudgeX + d[1]
						nudgeZ = nudgeZ + d[2]
					end
				end
				if found then
					local base = tileToWorld(tx, ty)  -- base tile surface (+1)
					local pos = base + Vector3.new(nudgeX * (TILE_SIZE * 0.35), 0, nudgeZ * (TILE_SIZE * 0.35))
					pcall(VFXController.AddWaterfallSplash, tx, ty, assetName, pos)
				end
			end
		end
	end
end
local function templateToBattle(x, y)
	local bx, by = x - BATTLE_OFFSET_X, y - BATTLE_OFFSET_Y
	if bx >= 1 and bx <= MAP_WIDTH and by >= 1 and by <= MAP_HEIGHT then return bx, by end
	return nil, nil
end


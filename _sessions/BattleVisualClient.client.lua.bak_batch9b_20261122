BattleEvents.BattleStarted.OnClientEvent:Connect(function(data)
	if SoundController then SoundController.StopAllChannels() end
	-- Goal tracker (step 8): the first push can arrive before the HUD / unit tokens exist.
	if goalData then
		if BattleHUD.SetGoal then BattleHUD.SetGoal(goalData) end
		task.defer(applyGoalTags, goalData)
	end
	UnitAnimController.StartFidgets()  -- random alternate idles for every unit (2026-10-28)
	if VFXController and VFXController.ClearAllTileEffects then pcall(VFXController.ClearAllTileEffects) end
	table.clear(activeTileEffects)
	if BattleHUD.SetActiveEvent then BattleHUD.SetActiveEvent(nil) end
	-- Supply playable battlefield bounds to camera (8×8 battle grid)
	-- NOTE: Future procedural maps must supply these dynamically.
	CameraController.SetBattlefieldBounds({
		minX = MAP_OFFSET_X,
		maxX = MAP_OFFSET_X + MAP_WIDTH * TILE_SIZE,
		minZ = MAP_OFFSET_Z,
		maxZ = MAP_OFFSET_Z + MAP_HEIGHT * TILE_SIZE,
		tileSize = TILE_SIZE,
		source = "battle_client",
	})

	-- Enter battle control mode (disable default controls, hide character)
	-- Pass center of battle grid as initial focus
	local centerX = MAP_OFFSET_X + (MAP_WIDTH * TILE_SIZE) / 2
	local centerZ = MAP_OFFSET_Z + (MAP_HEIGHT * TILE_SIZE) / 2
	CameraController.EnterBattle(Vector3.new(centerX, 0, centerZ))

	-- Collapse TemplateInspector panels during battle
	if type(_G.CTRBLXAI_SetInspectorCollapsed) == "function" then
		_G.CTRBLXAI_SetInspectorCollapsed(true)
	end

	createDevCameraPanel()

	BattleHUD.Cleanup()
	bp = { state = "Idle", actor = nil, target = nil, skill = nil, preview = nil, tile = nil, inspectedEntityId = nil }
	for _, c in ipairs(visualFolder:GetChildren()) do c:Destroy() end
	battleActive = true -- hover loop on for this battle (battle heat fix 2)
	for _, l in pairs(actionLabels) do if l.gui then l.gui:Destroy() end end
	unitTokens = {}; elevationMap = data.elevationMap
	roadCuts = {}  -- new battle: no roads yet (UAT DEFECT-1, 2026-10-27)
	moveCostAdds = {}  -- new battle: no slowed tiles yet
	actionLabels = {}
	for _, lp in pairs(debuffLoops) do destroyDebuffLoop(lp) end -- reused clones (battle heat fix 4)
	debuffLoops = {}
	for uid in pairs(persistentLoops) do stopAllPersistentLoops(uid) end
	persistentLoops = {}
	-- SLICE 3 (2026-10-22): CARRY the deployment records across into battle and UPDATE
	-- them with the authoritative battle values (facing, turn order, final stats) instead
	-- of wiping unitData and rebuilding from scratch. The battle packet (data.units) wins
	-- on every field it carries; unitData then points at the ONE shared record so both
	-- phases share a single unit object. Models are already reused by spawnToken. This is
	-- the "build once, carry across, update -- don't rebuild" switch.
	local seenIds = {}
	for _, unit in ipairs(data.units) do
		seenIds[unit.id] = true
		UnitRecords.Update(unit.id, unit)             -- battle values layered onto the carried record
		unitData[unit.id] = UnitRecords.Get(unit.id)  -- one shared record object across phases
		spawnToken(unit)
		updateHpBar(unit.id, unit.currentHp, unit.maxHp)
		updateMpBar(unit.id, unit.currentMp or 0, unit.maxMp or 0)
	end
	-- We no longer wipe unitData, so drop any unit NOT in this battle (e.g. benched during
	-- deployment, or left over from a prior match) to avoid stale entries lingering.
	for id in pairs(unitData) do
		if not seenIds[id] then unitData[id] = nil end
	end
	for id in pairs(UnitRecords.GetAll()) do
		if not seenIds[id] then UnitRecords.Remove(id) end
	end
	-- VFX: init post-processing + clear stale highlights
	local mf = workspace:FindFirstChild("TemplateViewerMap")
	local biome = mf and mf:GetAttribute("BiomeId") or "Plains"
	if VFXController then pcall(VFXController.Init, biome); pcall(VFXController.ClearAllHighlights) end
	-- Camera: locked until the first player prompt; the goal POI intro plays first (user 2026-11-18).
	setCamLock(true)
	table.clear(goalFocusKeys)
	table.clear(_camSafety.goalRetried)
	table.clear(_camSafety.introFocused)
	if BattleCinematic then BattleCinematic.Cancel() end
	task.defer(function() if goalData then maybeFocusGoal(goalData) end end)
	-- Start-of-battle event units (user 2026-11-18 6:10 PM): units a battlefield event placed before
	-- the battle join the opening sequence AFTER the goal shots (deferred after it), one 1.5 s shot
	-- per event name (its units framed together); the banner shows the existing event name.
	local evUnits = data and data.eventUnits
	if BattleCinematic and type(evUnits) == "table" and #evUnits > 0 then
		task.defer(function()
			if not battleActive then return end
			local order: { string } = {}
			local byName: { [string]: { any } } = {}
			for _, e in ipairs(evUnits) do
				local nm = type(e) == "table" and e.eventName
				if type(nm) == "string" and nm ~= "" and e.id ~= nil and unitTokens[e.id] then
					if not byName[nm] then byName[nm] = {}; table.insert(order, nm) end
					table.insert(byName[nm], e.id)
					_camSafety.introFocused[e.id] = true
				end
			end
			for _, nm in ipairs(order) do
				BattleCinematic.QueueUnits(byName[nm], nm, GOAL_FOCUS_SECONDS)
			end
		end)
	end
end)

-- Reinforcement: a single unit entered the battle mid-fight. Build its token

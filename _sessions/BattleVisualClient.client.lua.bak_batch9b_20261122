-- Shield indicator (2026-10-23). Server fires ShieldChanged on grant / absorb /
-- break / decay (BattleVisualBroadcaster.ShieldChanged, carrying the absolute
-- shieldTotal). A small cyan number on the HP bar shows the current pool; it
-- lazy-creates on first use from existing token refs (no change to the unit-spawn
-- path) and hides when the pool is empty. Floating flourishes mark grant (+SHIELD)
-- and break (SHIELD BROKE), matching the GUARD/SKIPPED house style. nil-safe.
BattleEvents.ShieldChanged.OnClientEvent:Connect(function(data)
	if not data or not data.unitId then return end
	local t = unitTokens[data.unitId]
	if not t or not t.fill then return end
	local total = data.shieldTotal or 0

	-- Lazy-create the pill once, parented to the HP background (t.fill's parent).
	local pill = t.shieldPill
	if not pill then
		local hpBg = t.fill.Parent
		if not hpBg then return end
		pill = Instance.new("TextLabel")
		pill.Name = "ShieldPill"
		pill.AnchorPoint = Vector2.new(1, 0.5)
		pill.Position = UDim2.new(1, -1, 0.5, 0)
		pill.Size = UDim2.fromOffset(18, 8)
		pill.BackgroundTransparency = 1
		pill.Font = Theme.Font.PrimaryBold
		pill.TextSize = 8
		pill.TextColor3 = Theme.Colors.Info
		pill.TextXAlignment = Enum.TextXAlignment.Right
		pill.TextStrokeColor3 = Color3.new(0, 0, 0)
		pill.TextStrokeTransparency = 0
		pill.ZIndex = 4
		pill.Parent = hpBg
		t.shieldPill = pill
	end

	if total > 0 then
		pill.Text = "[" .. tostring(total) .. "]"
		pill.Visible = true
	else
		pill.Visible = false
	end

	-- Floating flourishes for the moments that matter.
	if t.part then
		if data.reason == "grant" and (data.delta or 0) > 0 then
			showStatusText(t.part.Position, "+SHIELD " .. tostring(data.delta), Theme.Colors.Info)
		elseif data.reason == "break" then
			showStatusText(t.part.Position, "SHIELD BROKE", Theme.Colors.Warning)
		end
	end
end)

-- Action announce. Server fires on every AP commit.
-- Name banner (user 2026-11-18 6:21 PM, layout B, no pause): skills, specials (doctrine skills)
-- and items show their name (text only) in the shared upper-centre banner (BattleCinematic.ShowAction);
-- items a little smaller. Basic actions: Move / Guard / Wait show nothing; Basic Attack, Push and
-- the other built-in labels (Interact, Resuscitate, Misdirection, Getaway) keep the small label
-- above the unit's head (~2 s).
local HIDDEN_BASIC_LABELS = { Move = true, Guard = true, Wait = true }
BattleEvents.ActionAnnounced.OnClientEvent:Connect(function(data)
	if not data or not data.unitId then return end
	local kind = data.kind
	if kind == "skill" or kind == "special" or kind == "item" then
		clearActionLabel(data.unitId)
		if BattleCinematic and BattleCinematic.ShowAction then
			-- Text only (user 2026-11-18 7:44 PM): no skill / item icon, no side-colour outline.
			BattleCinematic.ShowAction(data.label, { small = kind == "item" })
		else
			showActionAnnounce(data.unitId, data.label) -- module missing: old head label
		end
	elseif kind == "channel" then
		-- A channel / activation wait begins: nothing shown; the banner plays when it goes off (2026-11-18).
	elseif not HIDDEN_BASIC_LABELS[data.label or ""] then
		showActionAnnounce(data.unitId, data.label)
	end
	-- Any announced action counts as activity (restarts the Thinking timer), and some carry
	-- their own animation: Push / Interact / Open Treasure / Big Spell (2026-10-28).
	UnitAnimController.NoteActivity(data.unitId)
	if data.animKind then
		local _t = unitTokens[data.unitId]
		if _t then playUnitAnim(_t, data.animKind) end
	end
end)


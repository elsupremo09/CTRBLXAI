-- Safety release for the commit lock (Tester WARN 1). A rejected command is re-prompted by the
-- server (BattleTurnController runPlayerTurn loop -> PlayerTurnPrompt), which unlocks. If nothing
-- changes the lock (no TurnStarted / prompt / battle end) and no action event arrives for ~6 s,
-- unlock with a warning. Never during an enemy turn or while a cinematic shot is queued/playing.
_camSafety.arm = function()
	local mySerial = _camSafety.serial
	local t0 = os.clock()
	task.delay(6, function()
		while _camSafety.serial == mySerial and battleActive and os.clock() - t0 < 60 do
			local au = activeUnitId and unitData[activeUnitId]
			local enemyTurn = au ~= nil and au.side ~= nil and au.side ~= "Player"
			local cineBusy = BattleCinematic ~= nil and BattleCinematic.IsBusy()
			local quiet = os.clock() - (_camSafety.lastAction or 0) >= 6
			if quiet and not enemyTurn and not cineBusy then
				warn("[BVC] camera lock safety release")
				setCamLock(false)
				return
			end
			task.wait(1)
		end
	end)
end

-- Assigns into the forward-declared `commitCommand` local (see above).
function commitCommand(command)
	clearHighlights(); isPlayerTurn = false; inputMode = nil; selectedSkill = nil; selectedItem = nil; aimTarget = nil
	setCamLock(true) -- the action resolves: camera locked until the next prompt
	_camSafety.arm()
	bp.state = "Resolving"; BattleHUD.Render(bp)
	BattleEvents.PlayerCommand:FireServer(command)
end

-- PICK-LIST ITEMS (user ruling 1, 2026-10-26). An item whose prompt entry carries
-- `choices` (fixed list from the server) or choiceKind == "targetBuff" (Blessing
-- Projector: the picked target's dispellable buffs) shows a list on the existing item
-- list screen before committing; the picked value is sent as command.choice. Items
-- without choices commit straight away, exactly as before.
-- AC-020 Masterwork Toolchain (2026-10-29): after the first Item and its target are chosen, offer
-- the second Items that have a legal target there (server re-checks). "Use alone" commits as before.
local function commitWithBundle(item, cmd, onBack)
	local opts = {}
	local tx, ty = cmd.tileX, cmd.tileY
	if cmd.targetId and unitData[cmd.targetId] then
		tx, ty = unitData[cmd.targetId].tileX, unitData[cmd.targetId].tileY
	end
	for _, b in ipairs((item and item.bundleOptions) or {}) do
		local ok = false
		if cmd.targetId then
			if b.selfTarget and cmd.targetId == currentPrompt.unitId then ok = true end
			for _, t in ipairs(b.targets or {}) do
				if t.id == cmd.targetId then ok = true break end
			end
		end
		if not ok and b.groundTarget and tx and ty then
			local ax = storedActorData and storedActorData.tileX or currentPrompt.tileX or 0
			local ay = storedActorData and storedActorData.tileY or currentPrompt.tileY or 0
			ok = math.max(math.abs(tx - ax), math.abs(ty - ay)) <= (b.range or 0)
		end
		if ok then table.insert(opts, b) end
	end
	if #opts == 0 then
		commitCommand(cmd)
		return
	end
	local entries = {
		{ id = "_alone", name = (item.name or "Item") .. " alone", rtCost = item.rtCost or 0, enabled = true,
			onPress = function() commitCommand(cmd) end },
	}
	for _, b in ipairs(opts) do
		table.insert(entries, {
			id = "_bundle_" .. tostring(b.slotIndex),
			name = "+ " .. tostring(b.name) .. " (bundle)",
			rtCost = (item.rtCost or 0) + math.round((b.rtCost or 0) * 0.5),
			enabled = true,
			onPress = function()
				local c = table.clone(cmd)
				c.bundleSlotIndex = b.slotIndex
				commitCommand(c)
			end,
		})
	end
	local prevBack = storedActorData.onBack
	storedActorData.itemEntries = entries
	storedActorData.onBack = function()
		storedActorData.onBack = prevBack
		if onBack then onBack() end
	end
	bp.state = "ItemSelection"; BattleHUD.Render(bp)
end

function commitItem(item, cmd, onBack)
	local opts = nil
	if item and item.choices and #item.choices > 0 then
		opts = item.choices
	elseif item and item.choiceKind == "targetBuff" and cmd.targetId then
		opts = {}
		local u = unitData[cmd.targetId]
		local defs = (GameConstants and GameConstants.STATUSES) or {}
		for _, st in ipairs((u and u.statuses) or {}) do
			local d = defs[st.id]
			if d and d.kind == "Buff" and d.dispellable == true then
				table.insert(opts, st.id)
			end
		end
	end
	if not opts or #opts == 0 then
		commitWithBundle(item, cmd, onBack)
		return
	end
	local entries = {}
	for _, choice in ipairs(opts) do
		table.insert(entries, {
			id = choice,
			name = tostring(choice),
			rtCost = (item and item.rtCost) or 0,
			enabled = true,
			onPress = function()
				local c = table.clone(cmd)
				c.choice = choice
				commitCommand(c)
			end,
		})
	end
	local prevBack = storedActorData.onBack
	storedActorData.itemEntries = entries
	storedActorData.onBack = function()
		storedActorData.onBack = prevBack
		if onBack then onBack() end
	end
	bp.state = "ItemSelection"; BattleHUD.Render(bp)
end

local function cancelToTargeting()
	aimTarget = nil
	bp.target = nil
	bp.preview = nil
	-- Re-highlight valid targets
	if inputMode == "move" then
		clearHighlights()
		for _, tile in ipairs(currentPrompt.moveCandidates) do createTileHighlight(tile.tileX, tile.tileY, "move") end
	elseif inputMode == "attack" then
		clearHighlights()
		for _, t in ipairs(currentPrompt.attackTargets) do createTileHighlight(t.tileX, t.tileY, "target") end
	elseif inputMode == "skill" and selectedSkill then
		clearHighlights()
		local c = skillTargetColor(selectedSkill)
		if selectedSkill.groundTarget then
			-- Ground skills (e.g. Meteor Marker) highlight a RANGE box around the
			-- caster, not the .targets marker — mirror enterSkillSelection so back-out
			-- re-shows the range instead of just the caster tile.
			local gr = selectedSkill.computedRange or 5
			local minR = selectedSkill.computedMinRange or 0  -- skip tiles inside weapon min range (2026-10-30)
			for dy = -gr, gr do
				for dx = -gr, gr do
					if math.max(math.abs(dx), math.abs(dy)) >= minR then
						createTileHighlight((storedActorData.tileX or 0) + dx, (storedActorData.tileY or 0) + dy, c, 0.5)
					end
				end
			end
		else
			for _, t in ipairs(selectedSkill.targets) do createTileHighlight(t.tileX, t.tileY, c, 0.5) end
		end
	elseif inputMode == "item" and selectedItem then
		clearHighlights()
		local c = itemTargetColor(selectedItem)
		if selectedItem.groundTarget then
			local gr = selectedItem.range or 0
			for dy = -gr, gr do
				for dx = -gr, gr do
					createTileHighlight((storedActorData.tileX or 0) + dx, (storedActorData.tileY or 0) + dy, c, 0.5)
				end
			end
		else
			for _, t in ipairs(selectedItem.targets or {}) do createTileHighlight(t.tileX, t.tileY, c, 0.5) end
		end
	elseif inputMode == "interact" then
		clearHighlights()
		for _, t in ipairs(currentPrompt.interactTargets or {}) do createTileHighlight(t.tileX, t.tileY, SKILL_COLOR_UTIL, 0.45) end
	elseif inputMode == "push" then
		clearHighlights()
		for _, t in ipairs(currentPrompt.pushTargets or {}) do createTileHighlight(t.tileX, t.tileY, SKILL_COLOR_UTIL, 0.45) end
	elseif inputMode == "push_distance" and pushTargetSel then
		clearHighlights()
		createTileHighlight(pushTargetSel.tileX, pushTargetSel.tileY, "selected")
		for _, lt in ipairs(pushLandingTiles or {}) do createTileHighlight(lt.tileX, lt.tileY, SKILL_COLOR_UTIL, 0.45) end
	end
	bp.state = "TargetSelection"; BattleHUD.Render(bp)
end


BattleEvents.UnitPushed.OnClientEvent:Connect(function(data)
	local targetToken = unitTokens[data.targetId]
	local pusherToken = unitTokens[data.pusherId]

	-- Update local unit data position
	if unitData[data.targetId] then
		unitData[data.targetId].tileX = data.finalTileX
		unitData[data.targetId].tileY = data.finalTileY
	end

	-- Animate target moving to new position
	if targetToken and data.pushed then
		-- GROUNDING FIX (2026-10-19): a push lands the unit on its destination tile,
		-- which may be a different elevation (shoved off a ledge / into a pit). Ground
		-- it the SAME way the move handler does — not the old flat `tileToWorld` +
		-- fixed +1, which left pivot-gap R15 rigs (Froc, Orc, Dwarf, ...) buried until
		-- their next move. Branch R15 vs cylinder exactly like UnitMoved:
		--   R15     -> tileToWorldR15Grounded (groundSurfaceY + bbox-based hipHeight),
		--              upright, keep current facing (NO 90-degree roll — that tipped
		--              the model on its side; the roll is a cylinder-only pose).
		--   cylinder-> tileToWorldGrounded + the 90-degree lying-cylinder roll.
		if targetToken.model then
			local destPos = tileToWorldR15Grounded(data.finalTileX, data.finalTileY, targetToken.hipHeight)
			local rot = targetToken.part.CFrame - targetToken.part.CFrame.Position  -- preserve facing
			TweenService:Create(targetToken.part,
				TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
				{ CFrame = CFrame.new(destPos) * rot }
			):Play()
		else
			local destPos = tileToWorldGrounded(data.finalTileX, data.finalTileY)
			TweenService:Create(targetToken.part,
				TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
				{ CFrame = CFrame.new(destPos) * CFrame.Angles(0, 0, math.rad(90)) }
			):Play()
		end
	end

	-- Show push text + damage floats
	if pusherToken then
		showFloatingText(pusherToken.part.Position, "PUSH", Color3.fromRGB(255, 180, 40), 1.1)
	end
	local totalDmg = (data.wallDamage or 0) + (data.fallDamage or 0)
	if totalDmg > 0 and targetToken then
		showFloatingText(targetToken.part.Position, "-" .. totalDmg, Color3.fromRGB(255, 100, 40))
		updateHpBar(data.targetId, data.targetHp, data.targetMaxHp)
	end
	-- Push / wall / fall KO (2026-10-30): a push sends no defeat event, so show the KO here.
	-- showUnitKO runs once per KO, so a later defeat event for the same unit is ignored.
	if targetToken and data.targetHp ~= nil and data.targetHp <= 0 then
		if unitData[data.targetId] then unitData[data.targetId].currentHp = 0 end
		showUnitKO(data.targetId)
	end
	-- The unit the target was shoved into: update its HP bar, and show its KO if it died.
	if data.collidedId and data.collidedHp ~= nil and unitTokens[data.collidedId] then
		local cu = unitData[data.collidedId]
		if cu then cu.currentHp = data.collidedHp end
		updateHpBar(data.collidedId, data.collidedHp, cu and cu.maxHp or nil)
		if data.collidedHp <= 0 then showUnitKO(data.collidedId) end
	end
end)


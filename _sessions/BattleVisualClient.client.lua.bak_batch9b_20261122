	local function closeRewardDetail()
		if detailFrame then detailFrame:Destroy(); detailFrame = nil end
		if detailGui then detailGui:Destroy(); detailGui = nil end
	end

	for idx, item in ipairs(rewards) do
		local rc = Theme.GetRarityColor(item.rarity)
		local iconId = item.icon or HAND_ICONS[item.handClass]
		local card = Theme.MakeItemTile({
			parent = lootGrid,
			accentColor = rc,
			cellW = LOOT_CELL_W,
			icon = if iconId and string.find(iconId, "rbxassetid://") then iconId else nil,
			iconText = string.sub(item.name or "?", 1, 1),
			name = item.name or "?",
			layoutOrder = idx,
			portrait = true,
		})
		-- Level label top-left like Loadout gear tiles; cards / consumables show none (as in the Loadout).
		if not item.isCard then
			local lvText = "Lv." .. tostring(item.itemLevel or 1)
			if InventoryControls then InventoryControls.MakeLevelLabel(card, lvText) end
		end
		-- STOLEN / BONUS / CHEST tags (approved, 2026-10-24 / 10-28 / 11-01): top-right, stacked,
		-- drawn like the Loadout NEW marker (small coloured box, badge text size).
		local tagRow = 0
		local function addLootTag(text: string, bg: Color3, fg: Color3)
			local ts = Theme.Text.Badge()
			local w = Theme.MeasureText(text, ts, Theme.Font.PrimaryBold).X + 6
			local tag = Instance.new("TextLabel")
			tag.Size = UDim2.fromOffset(w, math.max(12, ts + 2))
			tag.AnchorPoint = Vector2.new(1, 0)
			tag.Position = UDim2.new(1, -2, 0, 2 + tagRow * 14)
			tag.BackgroundColor3 = bg
			tag.BorderSizePixel = 0
			tag.Font = Theme.Font.PrimaryBold
			tag.TextSize = ts
			tag.TextColor3 = fg
			tag.Text = text
			tag.ZIndex = 4
			Instance.new("UICorner", tag).CornerRadius = UDim.new(0, 2)
			tag.Parent = card
			tagRow += 1
		end
		if item.stolen then addLootTag("STOLEN", Theme.Colors.Danger, Color3.new(1, 1, 1)) end
		if item.objectiveReward then addLootTag("BONUS", Theme.Colors.TextGold, Color3.new(0, 0, 0)) end
		if item.chestReward then addLootTag("CHEST", Theme.Colors.Info, Color3.new(1, 1, 1)) end

		-- Click -> detail view
		card.Activated:Connect(function()
			closeRewardDetail()

			-- Build detail panel (left side, like loadout detail)
			-- Detail overlay: separate ScreenGui with higher DisplayOrder
			detailGui = Instance.new("ScreenGui")
			detailGui.Name = "LootDetailOverlay"
			detailGui.ResetOnSpawn = false
			detailGui.DisplayOrder = 93
			detailGui.Parent = player:WaitForChild("PlayerGui")

			detailFrame = Theme.MakePanel("LootDetail",
				UDim2.new(0.55, 0, 0.90, 0),
				UDim2.new(0, 6, 0.5, 0),
				Vector2.new(0, 0.5),
				detailGui)
			detailFrame.ClipsDescendants = true

			-- Tap outside the detail panel closes it (user 2026-11-10). Full-screen invisible
			-- catcher BEHIND the panel (created first = drawn under; panel is Active, so a tap
			-- on the panel never reaches it).
			local outside = Instance.new("TextButton")
			outside.Name = "OutsideCatcher"
			outside.Size = UDim2.fromScale(1, 1)
			outside.BackgroundTransparency = 1
			outside.Text = ""
			outside.AutoButtonColor = false
			outside.ZIndex = 0
			outside.Parent = detailGui
			outside.Activated:Connect(closeRewardDetail)

			local dp = Instance.new("UIPadding", detailFrame)
			dp.PaddingTop = UDim.new(0, 10)
			dp.PaddingLeft = UDim.new(0, 12)
			dp.PaddingRight = UDim.new(0, 12)
			dp.PaddingBottom = UDim.new(0, 10)

			if item.isCard then
				-- Card / consumable detail (2026-11-18, user): the same layout as gear and the Loadout
				-- consumable detail -- shared header (portrait tile, name, tags, description), divider,
				-- then "label: value" rows. Existing labels only; no new wording.
				local rc = Theme.GetRarityColor(item.rarity)
				local CARD_TYPE_LABEL = {
					SkillCard = "Skill Card", AugmentCard = "Augment Card",
					Doctrine = "Doctrine", Consumable = "Consumable",
				}
				local catLabel = CARD_TYPE_LABEL[item.category] or "Card"
				local def: any = nil
				if item.category == "Consumable" and item.cardId then
					local content = ReplicatedStorage:FindFirstChild("Content")
					local mod = content and content:FindFirstChild("ConsumableData")
					if mod then
						local okD, CD = pcall(require, mod)
						if okD and CD and CD.GetById then def = CD.GetById(item.cardId) end
					end
				end
				local tags = { item.rarity or "Common", catLabel }
				if item.category == "Consumable" and item.conCategory then table.insert(tags, tostring(item.conCategory)) end
				if item.category == "SkillCard" and item.element then table.insert(tags, tostring(item.element)) end
				local hdrH = LoadoutScreen.BuildDetailHeader(detailFrame, {
					iconText = string.sub(item.name or "?", 1, 1),
					iconImage = (item.icon and string.find(item.icon, "rbxassetid://")) and item.icon or nil,
					iconBg = rc, iconBgTransparency = 0.75,
					iconColor = Theme.Colors.TextPrimary, iconStrokeColor = rc,
					name = item.name or "Unknown",
					tags = tags,
					description = item.desc or "",
				})
				local div = Instance.new("Frame")
				div.Size = UDim2.new(1, 0, 0, 1)
				div.Position = UDim2.new(0, 0, 0, hdrH)
				div.BackgroundColor3 = Theme.Colors.Border
				div.BorderSizePixel = 0
				div.Parent = detailFrame
				-- Rows scroll below the header so a long list never runs off a phone-sized panel.
				local rowsArea = Instance.new("ScrollingFrame")
				rowsArea.Name = "DetailRows"
				rowsArea.Size = UDim2.new(1, 0, 1, -(hdrH + 6))
				rowsArea.Position = UDim2.new(0, 0, 0, hdrH + 6)

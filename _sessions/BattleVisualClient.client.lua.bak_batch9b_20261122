-- Forward declaration: commitCommand is defined further below (after the
-- targeting helpers), but self-target Preview closures inside
-- enterActionSelection reference it before that point. Declaring the local
-- here ensures every closure captures the same upvalue (not a nil global).
local commitCommand
local commitItem  -- pick-list wrapper (defined after commitCommand)

-- SKILL HIT PREVIEW (2026-10-30): once a tile-aimed (or caster-area / self) skill opens its preview,
-- ask the server who the skill would hit and for how much, then fill the preview in. Read-only; the
-- command sent on Execute is unchanged. A newer click, Back, or another preview discards a late
-- answer (token + skill + tile check).
local hitPreviewToken = nil
local function requestSkillHitPreview(skillId, tx, ty)
	local token = {}
	hitPreviewToken = token
	task.spawn(function()
		local ok, res = pcall(function()
			return BattleEvents.PreviewSkillHits:InvokeServer(skillId, tx, ty)
		end)
		if hitPreviewToken ~= token then return end
		if not ok then
			warn("[BattleVisualClient] Skill hit preview failed: " .. tostring(res))
			return
		end
		if type(res) ~= "table" or not res.ok or type(res.entries) ~= "table" then return end
		local p = bp.preview
		if bp.state ~= "Preview" or not p or p._hitSkillId ~= skillId or p._hitTileX ~= tx or p._hitTileY ~= ty then
			return
		end
		-- Lunge step / Recoil Shot hop (D1 fix 2026-11-08): in tile-aim mode the server answer carries the
		-- tile the caster would end on for the aimed tile. Draw it like the unit-click path: white path,
		-- yellow end tile, aimed tile kept in the skill colour. No end tile in the answer = nothing extra.
		if selectedSkill and selectedSkill.id == skillId and selectedSkill.showsLandingTile
			and type(res.landingTileX) == "number" and type(res.landingTileY) == "number"
		then
			if type(res.chargePath) == "table" then
				renderMovePath(res.chargePath, res.landingTileX, res.landingTileY)
			end
			createTileHighlight(res.landingTileX, res.landingTileY, "selected")  -- end tile = yellow
			createTileHighlight(tx, ty, skillTargetColor(selectedSkill), 0.4)    -- aimed tile keeps skill colour
		end
		local entries = res.entries
		p.hits = entries
		p.hitsResolved = true
		local e = entries[1]
		if #entries == 1 and (e.kind == "damage" or e.kind == "healing") then
			-- One unit: fill the classic single-target layout.
			local tgtData = unitData[e.unitId]
			p.targetName = e.name
			p.targetSide = e.side
			p.targetHpBefore = e.hpBefore
			p.targetHpAfter = e.hpAfter
			p.estimatedDamage = e.amount
			p.isHealing = e.kind == "healing"
			p.hitApprox = e.approx
			local sid = e.statuses and e.statuses[1]
			if sid then
				p.statusEffect = sid
				local sdef = GameConstants.STATUSES and GameConstants.STATUSES[sid]
				p.statusDuration = sdef and sdef.duration or 0
			end
			if e.kind == "damage" then
				-- Same RT delay estimate as the unit-click preview (VIT x gear, broadcast by the server).
				local wDelay = (currentPrompt and currentPrompt.weaponRtDelay) or 0
				p.targetRtDelay = (tgtData and tgtData.derivedStats and tgtData.derivedStats.rtDelayResist)
					and math.round(wDelay * tgtData.derivedStats.rtDelayResist)
					or GameConstants.CalcRtDelayResistance(wDelay, tgtData and tgtData.stats and tgtData.stats.VIT or 10)
			end
			-- Server-worked turn delay for this unit (2026-11-08 7:14 PM, area turn delay skills such as
			-- Dragon Dive / Decimating Swing): same number the real hit adds, so it wins over the estimate.
			if type(e.rtDelay) == "number" then
				p.targetRtDelay = e.rtDelay
			end
			p.hits = nil
		end
		BattleHUD.Render(bp)
	end)
end

local function enterActionSelection()
	if not currentPrompt then return end
	local prompt = currentPrompt
	inputMode = nil; selectedSkill = nil; clearHighlights()

	local moveEnabled = prompt.moveCandidates and #prompt.moveCandidates > 0
	local atkEnabled = prompt.attackTargets and #prompt.attackTargets > 0
	local hasSkills = prompt.skills and #prompt.skills > 0

	local function enterSkillSelection()
		inputMode = nil; selectedSkill = nil; clearHighlights()
		local entries = {}
		for _, skill in ipairs(prompt.skills or {}) do
			local canUse = skill.canUse and (
				skill.selfTarget
				or skill.groundTarget
				or (skill.targets and #skill.targets > 0)
			)
			table.insert(entries, {
				id = skill.id, name = skill.name, mpCost = skill.mpCost or 0, rtCost = skill.rtCost or 0,
				enabled = canUse,
				onPress = function()
					-- SELF-TARGET: auto-commit immediately, no tile selection
					if skill.selfTarget then
						selectedSkill = skill; inputMode = nil; clearHighlights()
						-- Self-target skills skip tile selection, so highlight the caster's
						-- OWN tile (colored by the skill's classifier: self-buff→green,
						-- self-utility→yellow, etc.) so there's still a frame during preview.
						createTileHighlight(storedActorData.tileX or 0, storedActorData.tileY or 0, skillTargetColor(skill), 0.4)
						local skillRtCost = skill.rtCost or 60
						local isChannel = skill.channelTime and skill.channelTime > 0
						bp.skill = {
							name = skill.name, skillId = skill.id, tags = table.concat(skill.tags or {}, ", "),
							mpCost = skill.mpCost, rtCost = skill.rtCost, range = skill.range,
							pattern = skill.pattern, channelTime = skill.channelTime,
							effects = skill.description or "",
						}
						bp.preview = {
							actionType = "Skill", skillName = skill.name, skillId = skill.id,
							description = skill.description or "",
							actorName = prompt.unitName,
							actorMpBefore = prompt.currentMp, actorMpAfter = (prompt.currentMp or 0) - (skill.mpCost or 0),
							actorApBefore = prompt.currentAp, actorApAfter = (prompt.currentAp or 1) - 1,
							actorRtAfter = skillRtCost + (prompt.unitBaseRt or 400) + (prompt.turnRtAccrued or 0),
							targetName = prompt.unitName .. " (Self)",
							_hitSkillId = skill.id, _hitTileX = storedActorData.tileX or 0, _hitTileY = storedActorData.tileY or 0,
							channelTime = isChannel and skill.channelTime or nil,
							onConfirm = function() commitCommand({ actionType = "Skill", skillId = skill.id, targetId = prompt.unitId }) end,
							onBack = enterSkillSelection,
						}
						bp.state = "Preview"; BattleHUD.Render(bp)
						requestSkillHitPreview(skill.id, storedActorData.tileX or 0, storedActorData.tileY or 0)
						return
					end
					selectedSkill = skill; inputMode = "skill"; clearHighlights()
					bp.skill = {
						name = skill.name, skillId = skill.id, tags = table.concat(skill.tags or {}, ", "),
						mpCost = skill.mpCost, rtCost = skill.rtCost, range = skill.range,
						pattern = skill.pattern, channelTime = skill.channelTime,
						effects = skill.description or "",
					}
					local pRt = (skill.rtCost or 60) + (prompt.unitBaseRt or 400) + (prompt.turnRtAccrued or 0)
					local pEv = skill.channelTime and skill.channelTime > 0 and { name = skill.name, side = "Player", rt = skill.channelTime } or nil
					updateTimeline(timelineSnapshot, prompt.unitId, pRt, pEv)
					local c = skillTargetColor(skill)
					if skill.groundTarget then
						-- Ground targeting: highlight all tiles in range (reuse move highlight pattern)
						local gr = skill.computedRange or 5
						local minR = skill.computedMinRange or 0  -- skip tiles inside weapon min range (2026-10-30)
						for dy = -gr, gr do
							for dx = -gr, gr do
								if math.max(math.abs(dx), math.abs(dy)) >= minR then
									createTileHighlight((storedActorData.tileX or 0) + dx, (storedActorData.tileY or 0) + dy, c, 0.5)
								end
							end
						end
					else
						for _, t in ipairs(skill.targets) do createTileHighlight(t.tileX, t.tileY, c, 0.5) end
					end
					storedActorData.onBack = enterSkillSelection
					bp.state = "TargetSelection"; BattleHUD.Render(bp)
				end,
			})
		end
		storedActorData.skillEntries = entries
		storedActorData.onBack = enterActionSelection
		bp.state = "SkillSelection"; BattleHUD.Render(bp)
	end

	local function enterItemSelection()
		inputMode = nil; selectedSkill = nil; selectedItem = nil; clearHighlights()
		local entries = {}
		for _, item in ipairs(prompt.consumableSlots or {}) do
			local canUse = (item.currentCharges or 0) > 0 and (
				item.selfTarget
				or item.groundTarget
				or (item.targets and #item.targets > 0)
			)
			table.insert(entries, {
				id = item.slotIndex, consumableId = item.consumableId,
				name = string.format("%s (%d/%d)", item.name, item.currentCharges or 0, item.maxCharges or 0),
				rtCost = item.rtCost or 0,
				enabled = canUse,
				onPress = function()
					-- SELF-TARGET: preview then auto-commit on self
					if item.selfTarget then
						selectedItem = item; inputMode = nil; clearHighlights()
						-- Self-target items skip tile selection, so highlight the caster's
						-- OWN tile (light green = heal/beneficial) so there's still a frame.
						createTileHighlight(storedActorData.tileX or 0, storedActorData.tileY or 0, SKILL_COLOR_HEAL, 0.4)
						bp.preview = {
							actionType = "Item",
							skillName = item.name, consumableId = item.consumableId,
							actorName = prompt.unitName,
							actorApBefore = prompt.currentAp,
							actorApAfter = (prompt.currentAp or 1) - 1,
							actorRtAfter = (item.rtCost or 80) + (prompt.unitBaseRt or 400) + (prompt.turnRtAccrued or 0),
							targetName = prompt.unitName .. " (Self)",
							isHealing = item.isHealing or false,
							description = item.displayText or item.effectFormula or "Item description placeholder.",
							onConfirm = function()
								commitItem(item, { actionType = "Item", itemSlotIndex = item.slotIndex, targetId = prompt.unitId }, enterItemSelection)
							end,
							onBack = enterItemSelection,
						}
						bp.state = "Preview"; BattleHUD.Render(bp)
						return
					end
					-- UNIT or GROUND target: enter target selection
					selectedItem = item; inputMode = "item"; clearHighlights()
					local pRt = (item.rtCost or 80) + (prompt.unitBaseRt or 400) + (prompt.turnRtAccrued or 0)
					updateTimeline(timelineSnapshot, prompt.unitId, pRt)
					-- Show the item's description panel during targeting (like skills).
					bp.skill = { name = item.name or "Item", consumableId = item.consumableId, tags = item.category or "",
						mpCost = 0, rtCost = item.rtCost or 0, range = item.range or 0,
						pattern = item.pattern or "Single", effects = item.displayText or item.effectFormula or "Item description placeholder." }
					local c = itemTargetColor(item)
					if item.groundTarget then
						local gr = item.range or 0
						for dy = -gr, gr do
							for dx = -gr, gr do
								createTileHighlight((storedActorData.tileX or 0) + dx, (storedActorData.tileY or 0) + dy, c, 0.5)
							end
						end
					else
						for _, t in ipairs(item.targets or {}) do createTileHighlight(t.tileX, t.tileY, c, 0.5) end
					end
					storedActorData.onBack = enterItemSelection
					bp.state = "TargetSelection"; BattleHUD.Render(bp)
				end,
			})
		end
		storedActorData.itemEntries = entries
		storedActorData.onBack = enterActionSelection
		bp.state = "ItemSelection"; BattleHUD.Render(bp)
	end

	-- 4x2 grid: Attack, Skill, Move, Item, Guard, Interact, Wait, Stance
	local actions = {
		{ id="Move", text="Move", enabled=moveEnabled,
			reason=(prompt.moveBlockedReason or "No tiles in range to move to"), onPress=function()
			inputMode = "move"; selectedSkill = nil; clearHighlights()
			pcall(function() require(ReplicatedStorage:WaitForChild("CTRBLXAI", 10):WaitForChild("UI", 10):WaitForChild("TipController", 10)).Trigger("TIP-BAT-02") end) -- new-player tip (first move)
			-- BUG-083 (2026-11-21): no client RT formula (DAT-001). Preview the cheapest move the
			-- server priced (moveCandidates[i].rtCost = CommandService.GetMoveRtPreview); picking a
			-- tile then shows that tile's own rtCost (BUG-076).
			local minMoveRt = nil
			for _, mc in ipairs(prompt.moveCandidates or {}) do
				if type(mc.rtCost) == "number" and (minMoveRt == nil or mc.rtCost < minMoveRt) then minMoveRt = mc.rtCost end
			end
			local pRt = (minMoveRt or 0) + (prompt.unitBaseRt or 400) + (prompt.turnRtAccrued or 0)
			updateTimeline(timelineSnapshot, prompt.unitId, pRt)
			for _, tile in ipairs(prompt.moveCandidates) do createTileHighlight(tile.tileX, tile.tileY, "move") end
			storedActorData.onBack = enterActionSelection
			-- Show an action description panel during targeting (like skills/attack).
			bp.skill = { name = "Move", tags = "", mpCost = 0, rtCost = 0, range = 0, pattern = "",
				effects = "Move to a highlighted tile. RT scales with distance and terrain." }
			bp.state = "TargetSelection"; BattleHUD.Render(bp)
		end },
		{ id="Commands", text="Commands", enabled=true, isSubmenu=true, subActions={
			{ id="Attack", text="Attack", enabled=atkEnabled,
				reason=(prompt.attackBlockedReason or "No target in attack range"), onPress=function()  -- BUG-PT-08
				inputMode = "attack"; selectedSkill = nil; clearHighlights()
				bp.skill = { name="Basic Attack", tags="Physical",
					mpCost=0, rtCost=prompt.attackRt or 0, range=((prompt.weaponMinRange or 1) ~= (prompt.weaponRange or 1)) and ((prompt.weaponMinRange or 1).."-"..(prompt.weaponRange or 1)) or (prompt.weaponRange or 1), pattern="Single", -- BUG-087 server range
					effects="Weapon Dmg: "..(prompt.weaponDamage or 0).." | RT Delay: "..(prompt.weaponRtDelay or 0) }
				local pRt = (prompt.attackRt or 80) + (prompt.unitBaseRt or 400) + (prompt.turnRtAccrued or 0)
				updateTimeline(timelineSnapshot, prompt.unitId, pRt)
				local c = SKILL_COLOR_DMG  -- basic attack = direct damage = red
				for _, t in ipairs(prompt.attackTargets) do createTileHighlight(t.tileX, t.tileY, c, 0.5) end
				storedActorData.onBack = enterActionSelection
				bp.state = "TargetSelection"; BattleHUD.Render(bp)
			end },
			{ id="Interact", text="Interact",
				enabled = (prompt.interactAvailable == true),
				reason = "Nothing to interact with nearby",
				onPress = function()
					inputMode = "interact"; selectedSkill = nil; clearHighlights()
					local previewRt = (prompt.unitBaseRt or 400) + (prompt.turnRtAccrued or 0)
					updateTimeline(timelineSnapshot, prompt.unitId, previewRt)
					-- Highlight every Interact candidate tile (recruit/ally/revive/object).
					for _, t in ipairs(prompt.interactTargets or {}) do
						createTileHighlight(t.tileX, t.tileY, SKILL_COLOR_UTIL, 0.45)
					end
					bp.skill = { name = "Interact", tags = "Utility", mpCost = 0,
						rtCost = 0, range = 1, pattern = "Single",
						effects = "Interact with an adjacent target: recruit a near-dead enemy, speed up an ally, revive a KO'd ally, or activate a map object." }
					storedActorData.onBack = enterActionSelection
					bp.state = "TargetSelection"; BattleHUD.Render(bp)
				end },
			{ id="Push", text="Push", enabled=#(prompt.pushTargets or {}) > 0,
				reason="No one adjacent to push", onPress=function()
				inputMode = "push"; selectedSkill = nil; clearHighlights()
				local previewRt = (prompt.pushRt or 40) + (prompt.unitBaseRt or 400)
				updateTimeline(timelineSnapshot, prompt.unitId, previewRt)
				for _, t in ipairs(prompt.pushTargets or {}) do
					createTileHighlight(t.tileX, t.tileY, SKILL_COLOR_UTIL, 0.45)  -- push = repositioning = yellow
				end
				bp.skill = { name = "Push", tags = "Utility", mpCost = 0, rtCost = prompt.pushRt or 40,
					range = 1, pattern = "Single", effects = "Shove an adjacent target one tile away." }
				storedActorData.onBack = enterActionSelection
				bp.state = "TargetSelection"; BattleHUD.Render(bp)
			end },
			{ id="Guard", text="Guard", enabled=not prompt.guardUsed,
				reason="Already guarded this turn", onPress=function()
				clearHighlights(); isPlayerTurn = false; inputMode = nil; setCamLock(true)
				if _camSafety.arm then _camSafety.arm() end
				bp.state = "Resolving"; BattleHUD.Render(bp)
				BattleEvents.PlayerCommand:FireServer({ actionType = "Guard" })
			end },
		}},
		{ id="Skill", text="Skills", enabled=hasSkills,
			reason="No skills available", onPress=enterSkillSelection },
		{ id="Item", text="Items", enabled=(prompt.consumableSlots and #prompt.consumableSlots > 0),
			reason="No items to use", onPress=enterItemSelection },
		-- UNDO (2026-10-17): reverse the most recent clean Move/Guard, newest first.
		-- Availability + grayed reason come from the server (prompt.undoAvailable /
		-- prompt.undoReason) — the client never decides eligibility. Styled like the
		-- sibling top-level buttons (grays out when unavailable). Firing Undo keeps
		-- the player on their turn: the server reverses state and re-prompts, which
		-- refreshes AP/RT and this menu — so we do NOT flip to Resolving here.
		{ id="Undo", text="Undo", enabled=(prompt.undoAvailable == true),
			reason=(prompt.undoReason or "Nothing to undo"), onPress=function()
			clearHighlights(); inputMode = nil; selectedSkill = nil
			BattleEvents.PlayerCommand:FireServer({ actionType = "Undo" })
		end },
		{ id="Wait", text="Wait", enabled=true, onPress=function()
			clearHighlights(); isPlayerTurn = false; inputMode = nil; setCamLock(true)
			if _camSafety.arm then _camSafety.arm() end
			bp.state = "Resolving"; BattleHUD.Render(bp)
			BattleEvents.PlayerCommand:FireServer({ actionType = "Wait" })
		end },
	}

	-- Get actor tile info
	local actorUnit = unitData[prompt.unitId]
	local actorTileX = actorUnit and actorUnit.tileX or 0
	local actorTileY = actorUnit and actorUnit.tileY or 0
	local actorElev = getElevation(actorTileX, actorTileY)

	storedActorData = {
		id = prompt.unitId, name = prompt.unitName, side = prompt.unitSide or "Player",
		currentHp = prompt.currentHp, maxHp = prompt.maxHp,
		currentMp = prompt.currentMp, maxMp = prompt.maxMp,
		currentAp = prompt.currentAp, maxAp = prompt.maxAp or 2,
		remainingRt = (prompt.unitBaseRt or 400) + (prompt.turnRtAccrued or 0),
		doctrine = prompt.doctrine or "",
		level = prompt.level,
		race = prompt.race or nil,
		tileX = actorTileX, tileY = actorTileY, elevation = actorElev,
		statuses = actorUnit and actorUnit.statuses or {},
		-- Player's own face: the active-unit panel reads d.portraitAssetId the same
		-- way the enemy-turn path does. Pulled from unitData (populated by BattleStarted's
		-- serializeUnit, which carries portraitAssetId for every side). Without this the
		-- player active panel fell back to the initials box. (2026-10-15)
		portraitAssetId = actorUnit and actorUnit.portraitAssetId or nil,
		actions = actions,
	}
	bp.actor = storedActorData
	bp.skill = nil
	bp.target = nil
	bp.preview = nil

	bp.state = "ActionSelection"; BattleHUD.Render(bp)
	-- Pass base RT so ghost shows where unit will be if they end turn now
	updateTimeline(timelineSnapshot, prompt.unitId, (prompt.unitBaseRt or 400) + (prompt.turnRtAccrued or 0))
end

--------------------------------------------------
-- TILE SELECTION
--------------------------------------------------

local mapFolder = workspace:FindFirstChild("TemplateViewerMap")  -- nil until quest map renders; updated in MapDataSync handler

-- Find the invisible tile Part for a given battle coordinate.
-- Used by Highlight-based tile indicators (no floating Parts needed).
local function _getTilePart(bx, by)
	if not mapFolder then return nil end
	local tx, ty = bx + BATTLE_OFFSET_X, by + BATTLE_OFFSET_Y
	local name = string.format("Tile_%02d_%02d", tx, ty)
	return mapFolder:FindFirstChild(name)
end


-- Resolve any instance inside a map-object clone (Model OR single Part named
-- MapObjModel_*) to the tile Part the object stands on. nil if not an object.
local function resolveObjectTile(inst: Instance?): BasePart?
	-- Delegates to the shared TileResolver so battle and deployment resolve a tapped
	-- tile/object/blocker through ONE primitive (BUG-047 convergence, 2026-10-16). The
	-- shared resolver is a superset of the old MapObjModel_-only logic: it also resolves
	-- blockers (Blocker_<x>_<y>) directly to their own tile. If the module failed to
	-- load, return nil and let getTileUnderMouse fall through to its tile-parts raycast
	-- (unchanged) -- battle is never worse than before.
	if TileResolver then
		return TileResolver.ResolveTilePart(inst, mapFolder)
	end
	return nil
end

-- Touch/ray path: if the ray hits a map object BEFORE any tile, use the object's tile.
local function rayObjectTile(origin: Vector3, dir: Vector3): BasePart?
	if not mapFolder then return nil end
	local objs = getMapPartCache().objects -- cached per map (battle heat fix 3)
	if #objs == 0 then return nil end
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Include
	rp.FilterDescendantsInstances = objs
	local r = workspace:Raycast(origin, dir, rp)
	return r and resolveObjectTile(r.Instance) or nil
end

local function getTileUnderMouse()
	-- Click-pads first: thin invisible pads coincident with tile highlights.
	-- They do not occlude neighbors, so the pad hit is the tile the player
	-- sees under the cursor (removes elevation parallax offset).
	local cam0 = workspace.CurrentCamera
	if cam0 and TileHL then
		local padFolder = TileHL.GetPadFolder()
		if padFolder then
			local rpp = RaycastParams.new()
			rpp.FilterType = Enum.RaycastFilterType.Include
			rpp.FilterDescendantsInstances = { padFolder }
			local ray0 = cam0:ScreenPointToRay(mouse.X, mouse.Y)
			local pres = workspace:Raycast(ray0.Origin, ray0.Direction * 500, rpp)
			if pres and pres.Instance then return pres.Instance end
		end
	end
	local target = mouse.Target
	if target and target:IsA("BasePart") and target:GetAttribute("IsTemplateTile") then return target end
	-- Click landed on a map object (Model or single Part): use the object's tile.
	local objTile = resolveObjectTile(target)
	if objTile then return objTile end
	-- Fallback: mouse hit terrain voxels, grid lines, highlight walls, or a
	-- non-tile Part. Use camera:ScreenPointToRay with Include filter for ONLY
	-- tile Parts (not the whole mapFolder — grid lines are also in there and
	-- would intercept the ray before reaching tiles).
	local cam = workspace.CurrentCamera
	if cam and mapFolder then
		local rp = RaycastParams.new()
		rp.FilterType = Enum.RaycastFilterType.Include
		rp.FilterDescendantsInstances = getMapPartCache().tiles -- cached per map (battle heat fix 3)
		local ray = cam:ScreenPointToRay(mouse.X, mouse.Y)
		local res = workspace:Raycast(ray.Origin, ray.Direction * 500, rp)
		if res and res.Instance then return res.Instance end
	end
	-- FINAL FALLBACK (2026-10-26): a TALL map object (e.g. Ice Throne) can defeat both
	-- paths above -- resolveObjectTile may not resolve it, and the tile-only ray can sail
	-- OVER the object's own tile to a tile behind it (or off a map edge to nothing), so the
	-- click silently resolves to nothing and no inspector opens. If the click hit SOMETHING
	-- solid (mouse.Target set), convert the WORLD XZ of that hit point -- which is directly
	-- above the object's tile -- straight to a tile. Height-proof: whatever stands on the
	-- tile can't change which tile the point is over. Guarded by `target` so an empty-space
	-- click (ray to sky -> far mouse.Hit) can never resolve to a bogus tile.
	if target and mapFolder and mouse.Hit then
		local hp = mouse.Hit.Position
		local tx = math.floor((hp.X - MAP_OFFSET_X) / TILE_SIZE) + 1
		local ty = math.floor((hp.Z - MAP_OFFSET_Z) / TILE_SIZE) + 1
		if tx >= 1 and tx <= MAP_WIDTH and ty >= 1 and ty <= MAP_HEIGHT then
			local tp = getCachedTile(tx, ty) or mapFolder:FindFirstChild(string.format("Tile_%02d_%02d", tx, ty))
			if tp and tp:IsA("BasePart") then return tp end
		end
	end
	return nil
end

local function tileToBattle(part)
	if not part then return nil, nil end
	local x, y = part:GetAttribute("X"), part:GetAttribute("Y")
	if x and y then return templateToBattle(x, y) end
	return nil, nil
end


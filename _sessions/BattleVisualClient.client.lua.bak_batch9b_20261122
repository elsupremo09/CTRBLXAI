-- Tile info data for the bottom tile panel (bp.tile). Shared by a tile click and by a new
-- turn (BUG-PT-03, 2026-11-21: the panel kept the previous unit's tile when a turn started).
local function buildTileInfoData(bx, by)
	-- Find occupant for tile info
	local occupantName = nil
	for uid, data in pairs(unitData) do
		if data.tileX == bx and data.tileY == by and data.isAlive ~= false then
			occupantName = data.name
			break
		end
	end

	-- Always update tile info
	local terrainId = GameConstants.GetTerrainId(bx, by)
	local elevation = getElevation(bx, by)
	local moveCost = GameConstants.GetTerrainCost(bx, by)
	-- A temporary road lowers the cost, never below a normal step (same rule as the server).
	local _cut = roadCuts[bx .. "," .. by]
	if _cut and _cut > 0 and moveCost > 1 then moveCost = math.max(1, moveCost - _cut) end
	moveCost += (moveCostAdds[bx .. "," .. by] or 0)  -- same order as the server path cost
	-- Look up map object at this tile
	-- The server keeps an OBJECT-ONLY tag on each tile ("MapObject", set by MapRenderer on map
	-- build, placement, move and removal), so it is the live answer. "ObjectName" is NOT used:
	-- unit moves also write it (Tester F1 2026-10-27). The client's map-start object list is only
	-- a fallback for a tile Part that is not loaded (it is never updated when objects break or
	-- move). Hidden enemy traps are never drawn, so they never tag a tile.
	local objectName = nil
	local _tp = _getTilePart(bx, by)
	if _tp then
		local _tag = _tp:GetAttribute("MapObject")
		if type(_tag) == "string" and _tag ~= "" and _tag ~= "None" then
			objectName = _tag
		end
	else
		objectName = GameConstants.GetObjectAt(bx, by)
	end

	return {
		x = bx,
		y = by,
		terrainName = terrainId,
		elevation = elevation,
		moveCost = moveCost,
		coords = string.format("(%d, %d)", bx, by),
		occupantName = occupantName,
		objectName = objectName,
		effect = (_G.CTRBLXAI_GetTileEffect and _G.CTRBLXAI_GetTileEffect(bx, by)) or nil,
	}
end


local function processTileClick(bx, by, skipFacingPick)
	-- BUG-093: outside a battle (after BattleEnded / finishResult ran BattleHUD.Cleanup) the map
	-- tiles are still clickable under the guild menu, and BattleHUD.Render below re-creates the
	-- whole BattleHUD ScreenGui (ensureRoot). Inspection is only valid during deployment
	-- (DeploymentPhase -> BattleStarted) or an active battle (BattleStarted -> BattleEnded).
	if not battleActive and not _G.CTRBLXAI_DeploymentActive then
		return
	end
	-- Facing tile pick (rule 257): while a FacingPrompt is open, a tap on one of its highlighted
	-- tiles picks that direction and nothing else happens (no inspector update). Any other tile
	-- falls through to normal inspection. Same tap path as Move/skill aim (mouse + touch pads).
	-- skipFacingPick: the timeline portrait tap reuses this function; it must never pick a facing.
	if facingTilePick and not skipFacingPick then
		local pickDir = facingTilePick.tiles[bx .. "," .. by]
		if pickDir then
			facingTilePick.choose(pickDir)
			return
		end
	end

	-- During deployment: allow tile inspection but skip combat flow.
	-- BattleHUD view mode provides tile + object info during placement.

	bp.tile = buildTileInfoData(bx, by)
	local objectName = bp.tile.objectName
	BattleHUD.Render(bp)
	
	-- Inspect unit by clicking — works in ALL states.
	-- KO'd units stay inspectable. Gather EVERY unit on the tile (alive first,
	-- then KO'd, stable by id) so the inspector can cycle between them.
	local clickedUnit = false
	local tileUnits = {}
	for uid, data in pairs(unitData) do
		if data.tileX == bx and data.tileY == by then
			table.insert(tileUnits, data)
		end
	end
	table.sort(tileUnits, function(a, b)
		local aAlive = a.isAlive ~= false
		local bAlive = b.isAlive ~= false
		if aAlive ~= bAlive then return aAlive end
		return tostring(a.id) < tostring(b.id)
	end)
	local primary = tileUnits[1]
	if primary then
		clickedUnit = true
		-- Combat targeting still keys off the LIVING occupant only.
		if primary.isAlive ~= false then
			bp.inspectedEntityId = primary.id
			bp.target = primary
			BattleHUD.Render(bp)
		else
			-- Only KO'd units here: drop any stale selection from an earlier click.
			bp.inspectedEntityId = nil
		end
		-- Show the tapped unit in the unit panel. The detailed inspector window opens
		-- ONLY from a portrait tap (auto-open was a bug, removed 2026-10-07).
		BattleHUD.SetSelection({ kind = "unit", data = primary })
		local ids = {}
		for _, u in ipairs(tileUnits) do table.insert(ids, u.id) end
		_G.CTRBLXAI_TileUnitIds = ids  -- cycle list for the portrait-opened inspector
	end
	-- F1 fix (2026-10-04): clicking an EMPTY tile clears the stale unit selection so
	-- the newest click decides the dev-tool target (bp.tile holds the clicked tile).
	if not clickedUnit then
		bp.inspectedEntityId = nil
	end
	-- Map object (no unit on the tile): show it in the unit panel.
	if not clickedUnit and objectName and objectName ~= "None" then
		BattleHUD.SetSelection({ kind = "object", name = objectName, x = bx, y = by, hp = (_G.CTRBLXAI_GetObjectHp and _G.CTRBLXAI_GetObjectHp(bx, by)) or nil })
	elseif not clickedUnit then
		BattleHUD.ClearSelection()  -- empty tile: panel goes back to the acting unit
	end
	-- White spinning marker on the inspected tile. On a unit, it follows the unit's body.
	local _mk = primary and unitTokens[primary.id]
	if TileHL and TileHL.SetInspectMarker then pcall(TileHL.SetInspectMarker, bx, by, _mk and _mk.part or nil) end
	
	-- View mode or deployment: tile + unit info updated above, skip combat flow
	if _G.CTRBLXAI_DeploymentActive then return end

	if not isPlayerTurn or not inputMode then return end
	
	local state = bp.state
	
	-- If in Preview state, clicking elsewhere cancels back to targeting
	if state == "Preview" then
		cancelToTargeting()
		return
	end
	
	-- TargetSelection: find valid target
	if state == "TargetSelection" then
		if inputMode == "move" then
			for _, tile in ipairs(currentPrompt.moveCandidates) do
				if tile.tileX == bx and tile.tileY == by then
					aimTarget = tile
				-- Keep move-range highlights, layer path on top
				-- Mark the selected destination tile as "selected" (yellow)
				-- so it stands out from the blue move-range tiles
				createTileHighlight(bx, by, "selected")
					clearMovePath()
					renderMovePath(tile.path, bx, by)
					-- Attack range reachable FROM this destination (red), fetched
					-- ON DEMAND for just this tile (payload reduction, 2026-10-17).
					-- Stamp the tile we're asking about; the async response only
					-- renders if it still matches the player's current selection.
					clearAttackRange()
					pendingAtkRangeTile = { x = bx, y = by }
					BattleEvents.AttackRangeRequest:FireServer({ tileX = bx, tileY = by })
					-- Build path hazard list for preview panel
					local pathHazards = {}
					for _, step in ipairs(tile.path or {}) do
						local h = PATH_HAZARDS[step.terrain]
						if h then
							table.insert(pathHazards, {
								tileX = step.tileX, tileY = step.tileY,
								terrain = step.terrain, warn = h.warn,
							})
						end
					end
					-- Also check destination terrain
					local destH = PATH_HAZARDS[tile.terrain]
					if destH then
						table.insert(pathHazards, { tileX = bx, tileY = by, terrain = tile.terrain, warn = destH.warn })
					end
					-- BUG-PT-02: server-computed Move RT for this tile (same code the Move commit
					-- charges). pathCost is the tile count, not RT, so it is never used as RT here.
					local moveRt = tile.rtCost or 0
					bp.preview = {
						actionType = "Move",
						actorName = currentPrompt.unitName,
						fromTile = string.format("(%d,%d)", storedActorData.tileX or 0, storedActorData.tileY or 0),
						toTile = string.format("(%d,%d)", bx, by),
						destTerrain = tile.terrain or "Clear",
						pathLength = #(tile.path or {}) + 1,
						pathHazards = pathHazards,
						actorApBefore = currentPrompt.currentAp, actorApAfter = (currentPrompt.currentAp or 1) - 1,
						actorRtAfter = moveRt + (currentPrompt.unitBaseRt or 400) + (currentPrompt.turnRtAccrued or 0),
						onConfirm = function() commitCommand({ actionType = "Move", tileX = bx, tileY = by, pathCost = tile.pathCost }) end,
						onBack = function() clearMovePath(); cancelToTargeting() end,
					}
					bp.state = "Preview"; BattleHUD.Render(bp)
					return
				end
			end
		elseif inputMode == "attack" then
			for _, t in ipairs(currentPrompt.attackTargets) do
				if t.tileX == bx and t.tileY == by then
					if t.kind == "object" then
						-- OBS Phase 2c-B: attack an OBS blocker object. bp.target stays nil
						-- (BattleHUD Preview tolerates nil, same as the object push picker).
						aimTarget = t; clearHighlights()
						createTileHighlight(bx, by, "selected")
						bp.target = nil
						bp.preview = {
							actionType = "Attack",
							actorName = currentPrompt.unitName,
							actorApBefore = currentPrompt.currentAp, actorApAfter = (currentPrompt.currentAp or 1) - 1,
							actorRtAfter = (currentPrompt.attackRt or 80) + (currentPrompt.unitBaseRt or 400) + (currentPrompt.turnRtAccrued or 0),
							targetName = t.name,
							description = "Attack " .. (t.name or "object"),
							onConfirm = function() commitCommand({ actionType = "Attack", targetId = t.id }) end,
							onBack = cancelToTargeting,
						}
						bp.state = "Preview"; BattleHUD.Render(bp)
						return
					end
					aimTarget = t; clearHighlights()
					createTileHighlight(bx, by, "selected")
					bp.target = unitData[t.id]
					local tgtData = unitData[t.id]
					bp.preview = {
						actionType = "Attack",
						actorName = currentPrompt.unitName,
						actorMpBefore = currentPrompt.currentMp, actorMpAfter = currentPrompt.currentMp, -- no MP cost
						actorApBefore = currentPrompt.currentAp, actorApAfter = (currentPrompt.currentAp or 1) - 1,
						actorRtAfter = (currentPrompt.attackRt or 80) + (currentPrompt.unitBaseRt or 400) + (currentPrompt.turnRtAccrued or 0),
						targetName = t.name,
						targetHpBefore = tgtData and tgtData.currentHp or 0,
						targetHpAfter = tgtData and math.max(0, (tgtData.currentHp or 0) - (t.predicted or 0)) or 0,
						estimatedDamage = t.predicted or 0,
						-- Gear RT Delay Resistance (2026-10-23): derivedStats.rtDelayResist (broadcast by
						-- the server) already folds VIT resist x gear RT-resist, so the preview matches the
						-- authoritative server value. Falls back to the VIT-only formula if derivedStats is absent.
						-- Rake (2026-11-21): one resisted RT Delay per hit; the server sends rtDelayHits (nil = 1).
						targetRtDelay = ((tgtData and tgtData.derivedStats and tgtData.derivedStats.rtDelayResist)
							and math.round((currentPrompt.weaponRtDelay or 0) * tgtData.derivedStats.rtDelayResist)
							or GameConstants.CalcRtDelayResistance(currentPrompt.weaponRtDelay or 0, tgtData and tgtData.stats and tgtData.stats.VIT or 10))
							* (t.rtDelayHits or 1),
						statusEffect = "None",
						-- Server prediction extras (CombatResolver.PredictBasicAttack): Rake hit count, on-hit
						-- statuses (Lashed / Blunted ...), Rebound target + damage. Shown as-is, no client math.
						attackHitCount = t.hitCount,
						attackStatuses = t.statuses,
						attackStatusTurns = t.statusTurns,
						reboundName = t.reboundName,
						reboundDamage = t.reboundPredicted,
						onConfirm = function() commitCommand({ actionType = "Attack", targetId = t.id }) end,
						onBack = cancelToTargeting,
					}
					bp.state = "Preview"; BattleHUD.Render(bp)
					return
				end
			end
		elseif inputMode == "skill" and selectedSkill then
			-- GROUND TARGETING: any tile click in range is valid
			if selectedSkill.groundTarget then
				local gr = selectedSkill.computedRange or 5
				local actX = storedActorData.tileX or 0
				local actY = storedActorData.tileY or 0
				local dist = math.max(math.abs(bx - actX), math.abs(by - actY))
				-- Inside the weapon minimum range (2026-10-30): the server would refuse this tile, so
				-- ignore the click entirely (do not fall through to unit matching).
				if dist < (selectedSkill.computedMinRange or 0) then return end
				if dist <= gr then
					aimTarget = { tileX = bx, tileY = by }; clearHighlights()
					createTileHighlight(bx, by, "selected")
					local skillRtCost = selectedSkill.rtCost or 60
					local isChannel = selectedSkill.channelTime and selectedSkill.channelTime > 0
					bp.preview = {
						actionType = "Skill",
						skillName = selectedSkill.name, skillId = selectedSkill.id,
						skillTags = bp.skill and bp.skill.tags or nil,
						actorName = currentPrompt.unitName,
						actorMpBefore = currentPrompt.currentMp,
						actorMpAfter = (currentPrompt.currentMp or 0) - (selectedSkill.mpCost or 0),
						actorApBefore = currentPrompt.currentAp,
						actorApAfter = (currentPrompt.currentAp or 1) - 1,
						actorRtAfter = skillRtCost + (currentPrompt.unitBaseRt or 400) + (currentPrompt.turnRtAccrued or 0),
						targetName = string.format("Ground (%d,%d)", bx, by),
						_hitSkillId = selectedSkill.id, _hitTileX = bx, _hitTileY = by,
						channelTime = isChannel and selectedSkill.channelTime or nil,
						channelResolveCt = isChannel and (currentBattleCt or 0) + (selectedSkill.channelTime or 0) or nil,
						onConfirm = function()
							commitCommand({ actionType = "Skill", skillId = selectedSkill.id, tileX = bx, tileY = by })
						end,
						onBack = cancelToTargeting,
					}
					bp.state = "Preview"; BattleHUD.Render(bp)
					requestSkillHitPreview(selectedSkill.id, bx, by)
					return
				end
			end
			-- UNIT TARGETING: match clicked tile to a candidate unit
			for _, t in ipairs(selectedSkill.targets or {}) do
				if t.tileX == bx and t.tileY == by then
					aimTarget = t; clearHighlights()
					-- CHARGE skills (damage + movement): keep the TARGET tile in the
					-- skill's damage color (red), highlight the server-computed LANDING
					-- tile in yellow, and draw the straight charge PATH in the white/
					-- blooming move-path visual. Non-charge skills keep the plain
					-- yellow 'selected' confirmation highlight on the target.
					-- Lunge step / Recoil Shot hop (2026-11-08) show their end tile the same way.
					if (selectedSkill.isCharge or selectedSkill.leapsAdjacent or selectedSkill.showsLandingTile) and t.landingTileX then
						-- Draw the white charge PATH first (its destination paints the
						-- landing tile gold), THEN overpaint the landing tile yellow and
						-- the target tile red — so those two win the in-place recolor.
						if t.chargePath then renderMovePath(t.chargePath, t.landingTileX, t.landingTileY) end
						createTileHighlight(t.landingTileX, t.landingTileY, "selected")     -- landing = yellow (last = wins)
						createTileHighlight(bx, by, skillTargetColor(selectedSkill), 0.4)  -- target stays red
					else
						createTileHighlight(bx, by, "selected")
					end
					bp.target = unitData[t.id]
					local statusEff = selectedSkill.appliesStatus or "None"
					local statusDur = 0
					if statusEff ~= "None" and GameConstants.STATUSES and GameConstants.STATUSES[statusEff] then
						statusDur = GameConstants.STATUSES[statusEff].duration or 0
					end
					local isHeal = (t.predType == "healing")
					local tgtData = unitData[t.id]
					local tgtHpBefore = tgtData and tgtData.currentHp or 0
					local tgtMaxHp = tgtData and tgtData.maxHp or tgtHpBefore
					local tgtHpAfter
					if isHeal then
						tgtHpAfter = math.min(tgtMaxHp, tgtHpBefore + (t.predicted or 0))
					else
						tgtHpAfter = math.max(0, tgtHpBefore - (t.predicted or 0))
					end
					local skillRtCost = selectedSkill.rtCost or 60
					local isChannel = selectedSkill.channelTime and selectedSkill.channelTime > 0
					bp.preview = {
						actionType = "Skill",
						skillName = selectedSkill.name, skillId = selectedSkill.id,
						skillTags = bp.skill and bp.skill.tags or nil,
						actorName = currentPrompt.unitName,
						actorMpBefore = currentPrompt.currentMp,
						actorMpAfter = (currentPrompt.currentMp or 0) - (selectedSkill.mpCost or 0),
						actorApBefore = currentPrompt.currentAp,
						actorApAfter = (currentPrompt.currentAp or 1) - 1,
						actorRtAfter = skillRtCost + (currentPrompt.unitBaseRt or 400) + (currentPrompt.turnRtAccrued or 0),
						targetName = t.name,
						targetHpBefore = tgtHpBefore,
						targetHpAfter = tgtHpAfter,
						estimatedDamage = t.predicted or 0,
						isHealing = isHeal,
						-- Gear RT Delay Resistance (2026-10-23): use the combined derivedStats.rtDelayResist
						-- (VIT x gear) the server broadcasts; VIT-only formula is the fallback. Heals: no delay.
						targetRtDelay = (not isHeal) and ((tgtData and tgtData.derivedStats and tgtData.derivedStats.rtDelayResist)
							and math.round((currentPrompt.weaponRtDelay or 0) * tgtData.derivedStats.rtDelayResist)
							or GameConstants.CalcRtDelayResistance(currentPrompt.weaponRtDelay or 0, tgtData and tgtData.stats and tgtData.stats.VIT or 10)) or 0,
						statusEffect = statusEff,
						statusDuration = statusDur,
						channelTime = isChannel and selectedSkill.channelTime or nil,
						channelResolveCt = isChannel and (currentBattleCt or 0) + (selectedSkill.channelTime or 0) or nil,
						onConfirm = function()
							commitCommand({ actionType = "Skill", skillId = selectedSkill.id, targetId = t.id })
						end,
						onBack = cancelToTargeting,
					}
					bp.state = "Preview"; BattleHUD.Render(bp)
					return
				end
			end

		elseif inputMode == "interact" then
			-- Click an Interact candidate tile → Preview → commit. One stage:
			-- the server re-validates the kind + target and dispatches the native.
			-- Several options on one tile (e.g. Activate or Refresh): tapping the tile again picks the
			-- next one (2026-10-29).
			local _onTile = {}
			for _, it in ipairs(currentPrompt.interactTargets or {}) do
				if it.tileX == bx and it.tileY == by then table.insert(_onTile, it) end
			end
			local _pick = 1
			if #_onTile > 1 and aimTarget and aimTarget._ikIdx and aimTarget.tileX == bx and aimTarget.tileY == by then
				_pick = (aimTarget._ikIdx % #_onTile) + 1
			end
			for _ikI, t in ipairs(_onTile) do
				if _ikI == _pick then
					t._ikIdx = _ikI
					aimTarget = t; clearHighlights()
					createTileHighlight(bx, by, "selected")
					if t.id then bp.target = unitData[t.id] end
					local desc
					if t.interactKind == "recruitEnemy" then
						desc = "Recruit " .. (t.name or "enemy") .. " — becomes a neutral ally."
						-- Capacity + dismiss cost note (user 2026-11-10).
						if t.rosterCapacity then
							desc ..= ` Units {t.rosterCount or 0}/{t.rosterCapacity} after battle: {(t.rosterCount or 0) + 1}/{t.rosterCapacity}.`
						end
					elseif t.interactKind == "allyRtHelp" then
						desc = "Aid " .. (t.name or "ally") .. " — cut their current RT by 35%."
					elseif t.interactKind == "reviveAlly" then
						desc = "Resuscitate " .. (t.name or "ally") .. " (channeled) — revives at low HP."
					elseif t.interactKind == "mapObject" then
						desc = "Activate " .. (t.name or "object") .. "."
					elseif t.interactKind == "disarmTrap" then
						desc = "Disarm the " .. (t.name or "trap") .. " (and every trap next to you)."
					elseif t.interactKind == "neutralizeHazard" then
						desc = "Neutralize the " .. (t.name or "hazard") .. " on this tile for good."
					elseif t.interactKind == "mechanistRefresh" then
						desc = "Refresh " .. (t.name or "it") .. ": +1 charge, or +500 CT if it has no charges to restore."
					else
						desc = "Interact with " .. (t.name or "target") .. "."
					end
					if #_onTile > 1 then desc = desc .. " (Tap the tile again for another option.)" end
					bp.preview = {
						actionType = "Interact",
						actorName = currentPrompt.unitName,
						actorApBefore = currentPrompt.currentAp, actorApAfter = (currentPrompt.currentAp or 1) - 1,
						actorRtAfter = (t.rtPreview or 0) + (currentPrompt.unitBaseRt or 400) + (currentPrompt.turnRtAccrued or 0),
						targetName = t.name,
						description = desc,
						onConfirm = function()
							commitCommand({
								actionType = "Interact",
								interactKind = t.interactKind,
								targetId = t.id,
								objectId = t.objectId,
								tileX = t.tileX, tileY = t.tileY,
							})
						end,
						onBack = cancelToTargeting,
					}
					bp.state = "Preview"; BattleHUD.Render(bp)
					return
				end
			end

		elseif inputMode == "push" then
			-- Stage 1: choose push TARGET. Then enter distance sub-stage (pick stop tile 1..max).
			for _, t in ipairs(currentPrompt.pushTargets or {}) do
				if t.tileX == bx and t.tileY == by then
					if t.kind == "object" then
						-- OBS Phase 2c-E2: object push commits at full force-driven distance
						-- (no stop sub-stage; server PushObject computes max(0,Force-3)).
						-- bp.target stays nil for objects (BattleHUD Preview tolerates nil).
						aimTarget = t; clearHighlights()
						createTileHighlight(bx, by, "selected")
						bp.target = nil
						bp.preview = {
							actionType = "Push",
							actorName = currentPrompt.unitName,
							actorApBefore = currentPrompt.currentAp, actorApAfter = (currentPrompt.currentAp or 1) - 1,
							actorRtAfter = (currentPrompt.pushRt or 40) + (currentPrompt.unitBaseRt or 400) + (currentPrompt.turnRtAccrued or 0),
							targetName = t.name,
							description = (if t.isPull then "Pull " else "Push ") .. (t.name or "object"),
							onConfirm = function() commitCommand({ actionType = "Push", targetId = t.id }) end,
							onBack = cancelToTargeting,
						}
						bp.state = "Preview"; BattleHUD.Render(bp)
						return
					end
					pushTargetSel = t
					local actX = storedActorData and storedActorData.tileX or currentPrompt.tileX or 0
					local actY = storedActorData and storedActorData.tileY or currentPrompt.tileY or 0
					if t.vectorDirs and #t.vectorDirs > 0 then
						-- GL-013 Vector Gloves: landing tiles along every outward direction (2026-10-29).
						pushLandingTiles = {}
						for _, vd in ipairs(t.vectorDirs) do
							for _, vt in ipairs(computePushLandingTiles(actX, actY, t.tileX, t.tileY, t.maxPushDistance or 0,
								vd.dx, vd.dy, t.tileX, t.tileY, t.isArc)) do
								vt.dirX, vt.dirY = vd.dx, vd.dy
								table.insert(pushLandingTiles, vt)
							end
						end
					else
						pushLandingTiles = computePushLandingTiles(actX, actY, t.tileX, t.tileY, t.maxPushDistance or 0,
							t.pushDirX, t.pushDirY, t.pushFromX, t.pushFromY, t.isArc)
					end
					if #pushLandingTiles == 0 then
						-- No reachable clear tile (blocked/resisted). Preserve legacy: commit full push.
						aimTarget = t; clearHighlights()
						createTileHighlight(bx, by, "selected")
						bp.target = unitData[t.id]
						bp.preview = {
							actionType = "Push",
							actorName = currentPrompt.unitName,
							actorApBefore = currentPrompt.currentAp, actorApAfter = (currentPrompt.currentAp or 1) - 1,
							actorRtAfter = (currentPrompt.pushRt or 40) + (currentPrompt.unitBaseRt or 400) + (currentPrompt.turnRtAccrued or 0),
							targetName = t.name,
							description = "Push " .. (t.name or "target") .. " (blocked — collision)",
							onConfirm = function() commitCommand({ actionType = "Push", targetId = t.id }) end,
							onBack = cancelToTargeting,
						}
						bp.state = "Preview"; BattleHUD.Render(bp)
						return
					end
					-- Enter distance sub-stage: highlight the target + legal landing tiles.
					inputMode = "push_distance"
					clearHighlights()
					createTileHighlight(t.tileX, t.tileY, "selected")
					for _, lt in ipairs(pushLandingTiles) do
						createTileHighlight(lt.tileX, lt.tileY, SKILL_COLOR_UTIL, 0.45)
					end
					bp.state = "TargetSelection"; BattleHUD.Render(bp)
					return
				end
			end
		elseif inputMode == "push_distance" and pushTargetSel then
			-- Stage 2: choose the STOP tile along the fixed away-ray (distance 1..max).
			for _, lt in ipairs(pushLandingTiles or {}) do
				if lt.tileX == bx and lt.tileY == by then
					local t = pushTargetSel
					local chosenDist = lt.distance
					aimTarget = t; clearHighlights()
					createTileHighlight(t.tileX, t.tileY, "selected")
					createTileHighlight(bx, by, SKILL_COLOR_UTIL, 0.25)
					bp.target = unitData[t.id]
					bp.preview = {
						actionType = "Push",
						actorName = currentPrompt.unitName,
						actorApBefore = currentPrompt.currentAp, actorApAfter = (currentPrompt.currentAp or 1) - 1,
						actorRtAfter = (currentPrompt.pushRt or 40) + (currentPrompt.unitBaseRt or 400) + (currentPrompt.turnRtAccrued or 0),
						targetName = t.name,
						description = if t.isPull
							then string.format("Pull %s %d tile%s closer", t.name or "target", chosenDist, chosenDist == 1 and "" or "s")
							elseif t.isSwap
							then string.format("Swap with %s, then throw %d tile%s", t.name or "target", chosenDist, chosenDist == 1 and "" or "s")
							else string.format("Push %s %d tile%s away", t.name or "target", chosenDist, chosenDist == 1 and "" or "s"),
						onConfirm = function() commitCommand({ actionType = "Push", targetId = t.id, pushDistance = chosenDist,
							pushDirX = lt.dirX, pushDirY = lt.dirY }) end,  -- GL-013 chosen direction (nil = straight away)
						onBack = function()
							inputMode = "push"; pushLandingTiles = nil; pushTargetSel = nil
							cancelToTargeting()
						end,
					}
					bp.state = "Preview"; BattleHUD.Render(bp)
					return
				end
			end
		elseif inputMode == "item" and selectedItem then
			-- GROUND TARGETING: any tile click in range is valid
			if selectedItem.groundTarget then
				local gr = selectedItem.range or 0
				local actX = storedActorData.tileX or 0
				local actY = storedActorData.tileY or 0
				local dist = math.max(math.abs(bx - actX), math.abs(by - actY))
				if dist <= gr then
					aimTarget = { tileX = bx, tileY = by }; clearHighlights()
					createTileHighlight(bx, by, "selected")
					bp.preview = {
						actionType = "Item",
						skillName = selectedItem.name, consumableId = selectedItem.consumableId,
						actorName = currentPrompt.unitName,
						actorApBefore = currentPrompt.currentAp,
						actorApAfter = (currentPrompt.currentAp or 1) - 1,
						actorRtAfter = (selectedItem.rtCost or 80) + (currentPrompt.unitBaseRt or 400) + (currentPrompt.turnRtAccrued or 0),
						targetName = string.format("Ground (%d,%d)", bx, by),
						description = selectedItem.displayText or selectedItem.effectFormula or "Item description placeholder.",
						onConfirm = function()
							commitItem(selectedItem, { actionType = "Item", itemSlotIndex = selectedItem.slotIndex, tileX = bx, tileY = by }, cancelToTargeting)
						end,
						onBack = cancelToTargeting,
					}
					bp.state = "Preview"; BattleHUD.Render(bp)
					return
				end
			end
			-- UNIT TARGETING: match clicked tile to a candidate unit
			for _, t in ipairs(selectedItem.targets or {}) do
				if t.tileX == bx and t.tileY == by then
					aimTarget = t; clearHighlights()
					createTileHighlight(bx, by, "selected")
					bp.target = unitData[t.id]
					local _tgtData = unitData[t.id]
					bp.preview = {
						actionType = "Item",
						skillName = selectedItem.name, consumableId = selectedItem.consumableId,
						actorName = currentPrompt.unitName,
						actorApBefore = currentPrompt.currentAp,
						actorApAfter = (currentPrompt.currentAp or 1) - 1,
						actorRtAfter = (selectedItem.rtCost or 80) + (currentPrompt.unitBaseRt or 400) + (currentPrompt.turnRtAccrued or 0),
						targetName = t.name,
						isHealing = selectedItem.isHealing or false,
						description = selectedItem.displayText or selectedItem.effectFormula or "Item description placeholder.",
						onConfirm = function()
							commitItem(selectedItem, { actionType = "Item", itemSlotIndex = selectedItem.slotIndex, targetId = t.id }, cancelToTargeting)
						end,
						onBack = cancelToTargeting,
					}
					bp.state = "Preview"; BattleHUD.Render(bp)
					return
				end
			end
		end
	end
end


-- TILE SELECTION: Mouse (immediate on click) + Touch (deferred to tap intent)
UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
	-- Guard: ignore clicks consumed by GUI buttons/panels
	if gameProcessedEvent then return end
	-- MERGE (2026-10-23): BVC's single tap-handler now drives inspection in BOTH phases
	-- (deployment + battle). The old "bail during deployment" guard is gone -- DeploymentUI
	-- no longer runs its own inspect path, so there is no second handler to fight. The
	-- IsOverUI check below (now including the DeployStrip roster) stops a tap on the
	-- portrait strip from leaking to the map, and processTileClick still skips the combat
	-- flow during deployment via its own `if _G.CTRBLXAI_DeploymentActive then return` lower down.
	-- Only handle MOUSE left click here. Touch is handled by tap intent below.
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end

	-- Additional guard: check if mouse is over a visible HUD panel
	if CameraController.IsOverUI(input.Position) then return end

	local tilePart = getTileUnderMouse()
	local bx, by = tileToBattle(tilePart)
	if not bx then return end

	processTileClick(bx, by)
end)

--------------------------------------------------
-- TOUCH TAP POLLING
-- Checks each frame for a completed tap from CameraController.
-- On tap, raycasts from the tap screen position to find a tile.
--------------------------------------------------

game:GetService("RunService").Heartbeat:Connect(function()
	local tapPos = CameraController.ConsumeTapIntent()
	if not tapPos then return end
	-- MERGE (2026-10-23): taps now drive inspection in BOTH phases. The old deployment bail
	-- is gone (DeploymentUI no longer runs a rival inspect path). This touch path never had
	-- a UI guard, so add one: skip taps over any HUD panel INCLUDING the DeployStrip roster,
	-- so a tap on a portrait never leaks through to the map behind it (mobile-safe).
	if CameraController.IsOverUI(tapPos) then return end

	-- Raycast from tap position to find tile
	local cam = workspace.CurrentCamera
	if not cam then return end
	local ray = cam:ScreenPointToRay(tapPos.X, tapPos.Y)
	-- Click-pads first (parallax-immune); fall back to tile Parts.
	if TileHL then
		local padFolder = TileHL.GetPadFolder()
		if padFolder then
			local rpp = RaycastParams.new()
			rpp.FilterType = Enum.RaycastFilterType.Include
			rpp.FilterDescendantsInstances = { padFolder }
			local pres = workspace:Raycast(ray.Origin, ray.Direction * 500, rpp)
			if pres and pres.Instance then
				local pbx, pby = tileToBattle(pres.Instance)
				if pbx then processTileClick(pbx, pby); return end
			end
		end
	end
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Include
	rayParams.FilterDescendantsInstances = if mapFolder then getMapPartCache().tiles else {} -- cached per map (battle heat fix 3)
	local result = workspace:Raycast(ray.Origin, ray.Direction * 500, rayParams)
	local tilePart = result and result.Instance or nil
	-- A tall map object in front of the tile wins (tap selects the object's tile).
	local objTile = rayObjectTile(ray.Origin, ray.Direction * 500)
	if objTile then
		local objHit = workspace:Raycast(ray.Origin, ray.Direction * 500, (function()
			local p = RaycastParams.new(); p.FilterType = Enum.RaycastFilterType.Include
			p.FilterDescendantsInstances = getMapPartCache().objects -- cached per map (battle heat fix 3)
			return p
		end)())
		if objHit and (not result or (objHit.Position - ray.Origin).Magnitude < (result.Position - ray.Origin).Magnitude) then
			tilePart = objTile
		end
	end
	-- FINAL FALLBACK (2026-10-26): mirror the mouse-path fix for TALL map objects (e.g. Ice
	-- Throne). If every path above left tilePart nil -- rayObjectTile missed AND the tile-only
	-- ray sailed OVER the object's own tile -- raycast for ANY solid hit under the tap and
	-- convert its world XZ straight to a tile. Height-proof: whatever stands on the tile can't
	-- change which tile the point is over. Excludes unit models / VFX / overlays so it reads
	-- the world surface, not a unit. Runs ONLY when every path above failed, so tap targeting
	-- (move/attack) is unchanged.
	if not tilePart and mapFolder then
		local rpAny = RaycastParams.new()
		rpAny.FilterType = Enum.RaycastFilterType.Exclude
		local ex = {}
		for _, name in { "UnitModels", "BattleVisuals", "DeploymentParts", "GridOverlay", "TileHighlights" } do
			local f = workspace:FindFirstChild(name)
			if f then table.insert(ex, f) end
		end
		rpAny.FilterDescendantsInstances = ex
		local anyHit = workspace:Raycast(ray.Origin, ray.Direction * 500, rpAny)
		if anyHit then
			local hp = anyHit.Position
			local tx = math.floor((hp.X - MAP_OFFSET_X) / TILE_SIZE) + 1
			local ty = math.floor((hp.Z - MAP_OFFSET_Z) / TILE_SIZE) + 1
			if tx >= 1 and tx <= MAP_WIDTH and ty >= 1 and ty <= MAP_HEIGHT then
				local tp = getCachedTile(tx, ty) or mapFolder:FindFirstChild(string.format("Tile_%02d_%02d", tx, ty))
				if tp and tp:IsA("BasePart") then tilePart = tp end
			end
		end
	end
	if not tilePart then return end

	local bx, by = tileToBattle(tilePart)
	if not bx then return end

	processTileClick(bx, by)
end)

--------------------------------------------------
-- HOVER TOOLTIP (shows unit name/HP on mouse hover)
--------------------------------------------------

local lastHoveredUnitId = nil

-- Battle heat fix 2 (user 2026-11-18 4:38 PM, PRF-001): skip entirely with no mouse (phones:
-- a hover tooltip can't show) or outside a battle; on desktop re-check only when the mouse or
-- the camera moved, plus a 0.25 s backstop so a unit walking under a still cursor still shows.
local _hoverLastX, _hoverLastY, _hoverLastCam, _hoverLastAt = nil, nil, nil, 0
game:GetService("RunService").RenderStepped:Connect(function()
	if not battleActive or not UserInputService.MouseEnabled or not next(unitData) then
		if lastHoveredUnitId then
			lastHoveredUnitId = nil
			BattleHUD.HideTooltip()
		end
		return
	end
	do
		local cam = workspace.CurrentCamera
		local camCf = cam and cam.CFrame
		local now = os.clock()
		if mouse.X == _hoverLastX and mouse.Y == _hoverLastY and camCf == _hoverLastCam
			and (now - _hoverLastAt) < 0.25 then
			return
		end
		_hoverLastX, _hoverLastY, _hoverLastCam, _hoverLastAt = mouse.X, mouse.Y, camCf, now
	end

	-- Check what tile is under the mouse
	local tilePart = getTileUnderMouse()
	if not tilePart then
		if lastHoveredUnitId then
			lastHoveredUnitId = nil
			BattleHUD.HideTooltip()
		end
		return
	end

	local bx, by = tileToBattle(tilePart)
	if not bx then
		if lastHoveredUnitId then
			lastHoveredUnitId = nil
			BattleHUD.HideTooltip()
		end
		return
	end

	-- Find unit on this tile
	local hoveredUnit = nil
	for _, data in pairs(unitData) do
		if data.tileX == bx and data.tileY == by and data.isAlive ~= false then
			hoveredUnit = data
			break
		end
	end

	if hoveredUnit then
		-- Don't show tooltip for the unit we're already inspecting
		if hoveredUnit.id == bp.inspectedEntityId then
			if lastHoveredUnitId then
				lastHoveredUnitId = nil
				BattleHUD.HideTooltip()
			end
			return
		end
		if hoveredUnit.id ~= lastHoveredUnitId then
			lastHoveredUnitId = hoveredUnit.id
			local hpText = string.format("HP %d/%d", hoveredUnit.currentHp or 0, hoveredUnit.maxHp or 0)
			local mpText = string.format("MP %d/%d", hoveredUnit.currentMp or 0, hoveredUnit.maxMp or 0)
			local sideColor = hoveredUnit.side == "Player" and Theme.Colors.Success or Theme.Colors.Danger
			local tooltipLines = {
				{ text = hpText, color = Theme.Colors.TextPrimary },
				{ text = mpText, color = Theme.Colors.TextSecondary },
			}
			-- Add status effects
			if hoveredUnit.statuses and #hoveredUnit.statuses > 0 then
				local statusParts = {}
				for _, s in ipairs(hoveredUnit.statuses) do
					local name = s.id or s.name or "?"
					local turns = s.remainingTurns and ("(" .. s.remainingTurns .. ")") or ""
					table.insert(statusParts, name .. turns)
				end
				table.insert(tooltipLines, { text = table.concat(statusParts, " "), color = Theme.Colors.Warning })
			end
			BattleHUD.ShowTooltip({
				title = hoveredUnit.name or "Unit",
				portrait = string.sub(hoveredUnit.name or "?", 1, 2),
				portraitColor = sideColor,
				lines = tooltipLines,
				position = UDim2.new(0, mouse.X + 16, 0, mouse.Y - 10),
				anchorPoint = Vector2.new(0, 1),
				maxWidth = 160,
			})
		end
	else
		if lastHoveredUnitId then
			lastHoveredUnitId = nil
			BattleHUD.HideTooltip()
		end
	end
end)



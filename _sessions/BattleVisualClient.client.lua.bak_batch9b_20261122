-- Deployment idle (2026-10-17): DeploymentUI reuses the server R15 models during the
-- deployment phase (they don't pass through spawnToken, so they'd stand stiff). This
-- plays the SAME random desynced idle used in battle on a raw model, so deployment units
-- breathe too. Self-contained (no token table): plays the base Idle (AnimationRegistry), loops it at
-- 0.85x-1.15x speed, and starts it at a random point in the loop. Returns the track (or
-- nil for a model with no Humanoid/Animator). Safe to call repeatedly; it won't stack.
_G.CTRBLXAI_PlayDeployIdle = function(model)
	if not model then return nil end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum then return nil end
	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then animator = Instance.new("Animator"); animator.Parent = hum end
	if model:GetAttribute("DeployIdlePlaying") then return nil end  -- don't double-start
	local ok, track = pcall(function()
		local anim = Instance.new("Animation")
		anim.AnimationId = pickIdleId()
		return animator:LoadAnimation(anim)
	end)
	if not ok or not track then return nil end
	track.Looped = true
	track:Play(0.3)
	track:AdjustSpeed(_idleRng:NextNumber(0.85, 1.15))
	model:SetAttribute("DeployIdlePlaying", true)
	task.spawn(function()
		local tries = 0
		while track.Length <= 0 and tries < 30 do task.wait(0.1); tries += 1 end
		if track.Length > 0 and track.IsPlaying then
			track.TimePosition = _idleRng:NextNumber(0, track.Length)
		end
	end)
	return track
end

-- OBS Phase 2c-0: object state change (break / HP decrement / move). Server fires
-- ObjectChanged{ x, y, newHp? | destroyed? | moved? } from ObjectEffectService.ApplyObjectHit.
-- Keep per-tile live HP for the inspector; on destroy drop our own blocker so
-- GetObjectAt / LoS / tile inspection treat the opened tile as empty (the server
-- already removed the authoritative blocker + replicated the visual).
local objectHpByTile: {[string]: number} = {}
_G.CTRBLXAI_GetObjectHp = function(x, y) return objectHpByTile[`{x},{y}`] end
BattleEvents.ObjectChanged.OnClientEvent:Connect(function(data)
	if type(data) ~= "table" then return end
	local x, y = data.x, data.y
	if type(x) ~= "number" or type(y) ~= "number" then return end
	local key = `{x},{y}`
	if data.destroyed then
		objectHpByTile[key] = nil
		if GameConstants.RemoveBlockerAt then pcall(GameConstants.RemoveBlockerAt, x, y) end
		local sel = BattleHUD.GetSelection and BattleHUD.GetSelection()
		if sel and sel.kind == "object" and sel.x == x and sel.y == y then
			BattleHUD.ClearSelection()
		end
		if _G.CTRBLXAI_NotifyObjectChanged then _G.CTRBLXAI_NotifyObjectChanged(x, y, nil, true) end
	elseif type(data.newHp) == "number" then
		objectHpByTile[key] = data.newHp
		local sel = BattleHUD.GetSelection and BattleHUD.GetSelection()
		if sel and sel.kind == "object" and sel.x == x and sel.y == y then
			BattleHUD.SetSelection({ kind = "object", name = sel.name, x = x, y = y, hp = data.newHp })
		end
		if _G.CTRBLXAI_NotifyObjectChanged then _G.CTRBLXAI_NotifyObjectChanged(x, y, data.newHp, false) end
	elseif type(data.moved) == "table" then
		-- OBS Phase 2c-E: a pushed object relocated. The server already moved the
		-- authoritative blocker + replicated the visual; we relocate our local blocker
		-- cache (old tile opens, new tile blocks) and the live-HP cache so client-side
		-- move/LoS prediction and the inspector stay correct until the next snapshot.
		local m = data.moved
		local fx, fy, tx, ty = m.fromX, m.fromY, m.toX, m.toY
		if type(fx) == "number" and type(fy) == "number"
			and type(tx) == "number" and type(ty) == "number" then
			local fromKey = `{fx},{fy}`
			local toKey = `{tx},{ty}`
			objectHpByTile[toKey] = m.hp or objectHpByTile[fromKey]
			objectHpByTile[fromKey] = nil
			if GameConstants.RemoveBlockerAt then pcall(GameConstants.RemoveBlockerAt, fx, fy) end
			if GameConstants.BLOCKERS then
				table.insert(GameConstants.BLOCKERS, {
					tileX = tx, tileY = ty, objectType = m.objType,
					tags = { "BlocksAOE", "BlocksLoS" }, height = m.height,
				})
			end
			local sel = BattleHUD.GetSelection and BattleHUD.GetSelection()
			if sel and sel.kind == "object" and sel.x == fx and sel.y == fy then
				BattleHUD.SetSelection({ kind = "object", name = sel.name, x = tx, y = ty, hp = objectHpByTile[toKey] })
			end
			-- Modal was anchored to the old tile; close it (the compact card re-points above).
			if _G.CTRBLXAI_NotifyObjectChanged then _G.CTRBLXAI_NotifyObjectChanged(fx, fy, nil, true) end
		end
	elseif type(data.objType) == "string" then
		-- A3 (2026-10-28): a disguised object was unmasked; the server sends its now-true
		-- display type only AFTER unmask. Refresh an open compact card + inspector modal.
		local sel = BattleHUD.GetSelection and BattleHUD.GetSelection()
		if sel and sel.kind == "object" and sel.x == x and sel.y == y then
			BattleHUD.SetSelection({ kind = "object", name = data.objType, x = x, y = y, hp = objectHpByTile[key] })
		end
		if _G.CTRBLXAI_NotifyObjectChanged then _G.CTRBLXAI_NotifyObjectChanged(x, y, nil, false, data.objType) end
	end
end)

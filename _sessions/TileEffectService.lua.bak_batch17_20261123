-- APPLY / REMOVE
--------------------------------------------------

function TileEffectService.ApplyTileEffect(tileX, tileY, effectId, ownerId, allUnits, skipTransform, durationCtOverride)
	-- durationCtOverride (optional, 2026-10-26): item-authored lifetime for the placed
	-- effect (e.g. Fog Machine Steam 1600 CT). nil = the effect's own durationCt.
	-- skipTransform (optional): do not run the base-terrain element transform for
	-- this placement. Used when a permanent floor effect is (re)seeded, and when the
	-- incoming packet was consumed by reacting with a tile's base floor effect
	-- (TRG-013 one-pass: Fire that ignites Vines does not ALSO turn the Grassland
	-- floor to Sand — map_gen_rules row 67).
	if allUnits then _allUnits = allUnits end
	if tileX < 1 or tileX > _mapWidth or tileY < 1 or tileY > _mapHeight then return end
	-- Perks & Flaws — Stable Land (P-114, 2026-10-23): if a unit occupying this tile has the
	-- Stable Land perk, block any NEW tile-effect application while it stands here. (Existing
	-- effects are untouched — they were already present; this only prevents new ones.) Uses
	-- the cached live unit list. Deferred require avoids a load-time cycle.
	if _allUnits then
		for _, u in ipairs(_allUnits) do
			if u.isAlive and u.tileX == tileX and u.tileY == tileY then
				local _tes = (require :: any)(script.Parent.TraitEffectService)
				if _tes.HasStableLand and _tes.HasStableLand(u) then
					print(string.format("[TileEffectService] Stable Land: %s blocks %s on its tile (%d,%d)",
						u.name or "?", tostring(effectId), tileX, tileY))
					return
				end
			end
		end
	end

	local def = GameConstants.TILE_EFFECTS[effectId]
	if not def then
		print(string.format("[TileEffectService] Unknown effect: %s", tostring(effectId)))
		return
	end
	-- USER RULINGS 2026-11-06: every tile effect skips blocked tiles (map-authored floor
	-- seeding is exempt — it is map data, not a placement).
	if ownerId ~= "floor" and not TileEffectService.IsOpenEffectTile(tileX, tileY) then
		-- Wasp Nest (objects_encounters row 124, 2026-11-07): a Poison Cloud created on or spreading
		-- onto its (blocked) tile destroys it instead (Poison instant kill, no sting). Other objects
		-- are untouched. The cloud is still not placed there (rule 246).
		if effectId == "Poison Cloud" and _objectHitCb and GameConstants.GetObjectAt
			and GameConstants.GetObjectAt(tileX, tileY) == "Wasp Nest" then
			_objectHitCb(tileX, tileY, "Poison")
		end
		print(string.format("[TileEffectService] %s skipped at (%d,%d) - blocked tile", tostring(effectId), tileX, tileY))
		blockedTileGroundChange(tileX, tileY, effectId, skipTransform, durationCtOverride, ownerId)
		return
	end

	local key = tileKey(tileX, tileY)
	local existing = effects[key]
	-- A real placement on a tile whose ground was burning out of sight (its blocker has since
	-- gone): that hidden burn ends early, so the terrain is spared (rule 141).
	if _hiddenBurnOut[key] then
		_hiddenBurnOut[key] = nil
		print(string.format("[TileEffectService] Hidden burn at (%d,%d) ended by %s - terrain SPARED",
			tileX, tileY, tostring(effectId)))
	end

	-- Check element reaction with existing effect
	if existing then
		local reacted, resultId = resolveReaction(existing.id, def.element)
		-- F2 (2026-11-08): a container release on this tile does not react with the action that
		-- broke it (e.g. that Fire Bolt's own Burning on the crate's new Poison Cloud).
		if reacted and _elementGuard[key] then
			print(string.format("[TileEffectService] %s on %s at (%d,%d) skipped - container release guard (no reaction)",
				tostring(effectId), tostring(existing.id), tileX, tileY))
			return
		end
		if reacted then
			print(string.format(
				"[TileEffectService] Reaction: %s + %s → %s at (%d,%d)",
				existing.id, effectId, tostring(resultId), tileX, tileY
			))
			local consumedByFloor = (baseFloor[key] ~= nil and baseFloor[key] == existing.id)
			-- Remove existing
			TileEffectService.RemoveTileEffect(tileX, tileY)

			-- Apply result if not nil (nil = both cleared)
			if resultId and resultId ~= "Explosion" then
				TileEffectService.ApplyTileEffect(tileX, tileY, resultId, ownerId, allUnits, consumedByFloor)
			end
			-- Explosion: source tile effect (Oily/Poison Cloud) already removed above.
			-- Queue an explosion event (TRG-011). The generic explosion carries NO
			-- blanket HP damage — damagePayload is per-source (nil here = reaction-
			-- triggered, tile-lowering + terrain-chain only; barrel bombs pass a payload).
			if resultId == "Explosion" then
				-- Reaction-triggered explosion: diamond r1, NO HP payload (tile-lowering +
				-- terrain-chain only). allUnits threaded so collapse occupant effects fire.
				TileEffectService.QueueExplosion(tileX, tileY, 0, ownerId, nil, allUnits, "diamond")
			end
			-- Tile left bare by the reaction (nil / Explosion result): floor returns.
			if not effects[key] then
				tryReinstateFloor(tileX, tileY)
			end
			return
		end

		-- No reaction: new effect replaces old (a fireproofed tile keeps what it has)
		if effectId == "Burning" and (_firebreak[key] or 0) > 0 then
			print(string.format("[TileEffectService] Firebreak at (%d,%d) blocks Burning", tileX, tileY))
			return
		end
		TileEffectService.RemoveTileEffect(tileX, tileY)
	end

	-- Firebreak (narrowed user ruling 2026-10-27): a fireproofed tile cannot CATCH fire, but
	-- Fire's reactions with what is already on the tile (above) still happen.
	if effectId == "Burning" and (_firebreak[key] or 0) > 0 then
		print(string.format("[TileEffectService] Firebreak at (%d,%d) blocks Burning", tileX, tileY))
		return
	end

	-- Place new effect
	-- Geomancer Terrain Mastery via the shared helper. The tile is marked so its +20% damage
	-- applies to that terrain only (checklist fix 2026-10-29).
	local _placedCt, _geoSkillTerrain = geomancerTerrainDuration(ownerId, durationCtOverride or def.durationCt or 900)
	effects[key] = {
		id          = effectId,
		remainingCt = _placedCt,
		ownerId     = ownerId,
		geoSkillTerrain = _geoSkillTerrain or nil,
		tickAccum   = 0,
		tileX       = tileX,
		tileY       = tileY,
	}
	-- D1 (2026-11-07): placed by an explosion's breaking hit on an object -> that blast won't chain it.
	if _blastFresh then _blastFresh[key] = true end
	-- F2 (2026-11-08): placed by a container release -> guarded for the rest of the action that broke it.
	if _releaseGuardOn then _elementGuard[key] = true end

	print(string.format(
		"[TileEffectService] Applied %s at (%d,%d) | Duration: %d CT | Owner: %s",
		effectId, tileX, tileY, _placedCt, tostring(ownerId)
	))

	-- Terrain transformation: element vs base terrain (Fire on Grassland → Sand)
	-- (protected span tiles are exempt inside GameConstants.TransformTerrain)
	if not skipTransform then
		-- PHASE 1 (burn-then-transform): if this element on this bare flammable base
		-- would transform (Fire on Grassland/Clover/Wooden Floor), DEFER it until the
		-- just-placed Burning ends. Record the pending transform; do NOT mutate terrain
		-- now. Everything else (Sand→Molten, Mud/Swamp→Rocky, Ice, Metal, Water→…)
		-- transforms INSTANTLY as before.
		if effectId == "Burning" and isDeferredFlammableTransform(tileX, tileY, def.element) then
			_deferredTransform[key] = def.element
			print(string.format(
				"[TileEffectService] Transform DEFERRED at (%d,%d): %s burns first, base changes on burn-out",
				tileX, tileY, def.element))
		else
			transformAndBroadcast(tileX, tileY, def.element)
		end
	end

	if _bvb and _bvb.TileEffectApplied then
		-- Battle Log Coverage: a floor re-establish (ownerId "floor") is background -> no line.
		local _logCause = if ownerId == "floor" then nil else tostring(effectId)
		_bvb.TileEffectApplied(tileX, tileY, effectId, _placedCt, _logCause)
	end
end

function TileEffectService.RemoveTileEffect(tileX, tileY)
	local key = tileKey(tileX, tileY)
	local eff = effects[key]
	if eff then
		print(string.format("[TileEffectService] Removed %s from (%d,%d)", eff.id, tileX, tileY))
		effects[key] = nil
		-- PHASE 1: generic removal = EARLY EXTINGUISH (reaction/dispel/cleanse, e.g.
		-- Water→Steam before expiry). A deferred burn-out transform is CANCELLED here —
		-- the terrain is SPARED (rule 141). Natural expiry goes through ProcessCtTick
		-- instead, which fires the transform.
		if _deferredTransform[key] ~= nil then
			_deferredTransform[key] = nil
			print(string.format(
				"[TileEffectService] Burn extinguished EARLY at (%d,%d) — terrain SPARED (no transform)",
				tileX, tileY))
		end
		if _bvb and _bvb.TileEffectRemoved then
			_bvb.TileEffectRemoved(tileX, tileY, eff.id)
		end
	end
end

function TileEffectService.GetTileEffect(tileX, tileY)
	return effects[tileKey(tileX, tileY)]
end

-- Lay a temporary road on a tile (ENV-019). Re-laying keeps the longer time.
function TileEffectService.SetRoad(tileX, tileY, durationCt, cut)
	if tileX < 1 or tileX > _mapWidth or tileY < 1 or tileY > _mapHeight then return end
	local key = tileKey(tileX, tileY)
	local cur = _road[key]
	_road[key] = { ct = math.max((cur and cur.ct) or 0, durationCt or 0), cut = math.max((cur and cur.cut) or 0, cut or 1) }
	if _bvb and _bvb.RoadChanged then _bvb.RoadChanged(tileX, tileY, _road[key].cut) end
end
-- Slow a tile (ENV-003). Re-applying keeps the longer time and the bigger penalty.
function TileEffectService.SetMoveCostZone(tileX, tileY, durationCt, add)
	if tileX < 1 or tileX > _mapWidth or tileY < 1 or tileY > _mapHeight then return end
	if (durationCt or 0) <= 0 or (add or 0) <= 0 then return end
	local key = tileKey(tileX, tileY)
	local cur = _costZone[key]
	_costZone[key] = { ct = math.max((cur and cur.ct) or 0, durationCt), add = math.max((cur and cur.add) or 0, add) }
	if _bvb and _bvb.MoveCostChanged then _bvb.MoveCostChanged(tileX, tileY, _costZone[key].add) end
end
-- Extra movement cost on this tile from a move-cost zone (0 = none).
function TileEffectService.GetMoveCostAdd(tileX, tileY)
	local z = _costZone[tileKey(tileX, tileY)]
	return (z and z.ct > 0) and z.add or 0
end
-- Movement-cost reduction from a road on this tile (0 = none).
function TileEffectService.GetRoadCut(tileX, tileY)
	local r = _road[tileKey(tileX, tileY)]
	return (r and r.ct > 0) and r.cut or 0
end

-- Is this tile fireproofed by a Firebreak (ENV-015)? Read by StatusService (Burn immunity,
-- half Fire damage), CombatResolver and WeatherService.
function TileEffectService.IsFirebreak(tileX, tileY)
	return (_firebreak[tileKey(tileX, tileY)] or 0) > 0
end

-- Guard a tile against Burning for durationCt (ENV-015). Re-guarding keeps the longer time.
function TileEffectService.SetFirebreak(tileX, tileY, durationCt)
	if tileX < 1 or tileX > _mapWidth or tileY < 1 or tileY > _mapHeight then return end
	local key = tileKey(tileX, tileY)
	_firebreak[key] = math.max(_firebreak[key] or 0, durationCt or 0)
end

-- Apply a RANDOM standard tile effect to a tile (Perks & Flaws — Unstable Footing F-114,
-- 2026-10-23). Picks deterministically from the standard surface/hazard pool using a seed
-- derived from the tile + owner, so replays are reproducible. Routed through ApplyTileEffect
-- (so the Stable Land guard, element reactions, and bounds checks all still apply). No-op if
-- the pool somehow has no valid effect.
local UNSTABLE_FOOTING_POOL = { "Burning", "Oily", "Poison Cloud", "Static Cloud", "Steam", "Wet", "Vines" }
function TileEffectService.ApplyRandomTileEffect(tileX, tileY, ownerId)
	if tileX < 1 or tileX > _mapWidth or tileY < 1 or tileY > _mapHeight then return end
	-- Deterministic pick (no combat RNG divergence): seed from tile + owner id digits.
	local seed = tileX * 73856093 + tileY * 19349663
		+ (tonumber(string.match(tostring(ownerId or "0"), "%d+")) or 0)
	local idx = (Random.new(seed):NextInteger(1, #UNSTABLE_FOOTING_POOL))
	local effectId = UNSTABLE_FOOTING_POOL[idx]
	if not effectId or not GameConstants.TILE_EFFECTS[effectId] then return end
	print(string.format("[TileEffectService] Unstable Footing: random %s on (%d,%d)", effectId, tileX, tileY))
	TileEffectService.ApplyTileEffect(tileX, tileY, effectId, ownerId)
end

function TileEffectService.GetAllEffects()
	return effects
end

--------------------------------------------------
-- CT TICK — called from BattleCoordinator.AdvanceClock
--
-- Decrements remaining CT on all effects.
-- Fires periodic tick damage on effects with tickCt.
-- TRG-012: Each source processed once per interval.
--------------------------------------------------

function TileEffectService.ProcessCtTick(ctElapsed, allUnits)
	if allUnits then _allUnits = allUnits end
	-- Container break guards only last for the command that broke the container (2026-11-07).
	table.clear(_elementGuard)
	-- Firebreak guards count down on the battle clock.
	for k, ct in pairs(_firebreak) do
		local left = ct - (ctElapsed or 0)
		_firebreak[k] = (left > 0) and left or nil
	end
	-- Hidden burns under blocked tiles: natural burn-out fires the base transform, exactly as
	-- a visible Burning's natural expiry does (floor-effect tiles stay exempt, rule 143).
	for k, hb in pairs(_hiddenBurnOut) do
		hb.ct = hb.ct - (ctElapsed or 0)
		if hb.ct <= 0 then
			_hiddenBurnOut[k] = nil
			local hx, hy = string.match(k, "^(%-?%d+),(%-?%d+)$")
			hx, hy = tonumber(hx), tonumber(hy)
			if hx and hy and baseFloor[k] == nil then
				print(string.format("[TileEffectService] Hidden burn-out at (%d,%d) - base transforms", hx, hy))
				transformAndBroadcast(hx, hy, hb.element)
			end
		end
	end
	-- Move-cost zones too.
	for k, z in pairs(_costZone) do
		z.ct = z.ct - (ctElapsed or 0)
		if z.ct <= 0 then
			_costZone[k] = nil
			local zx, zy = string.match(k, "^(%-?%d+),(%-?%d+)$")
			if zx and _bvb and _bvb.MoveCostChanged then _bvb.MoveCostChanged(tonumber(zx), tonumber(zy), 0) end
		end
	end
	-- Roads too.
	for k, r in pairs(_road) do
		r.ct = r.ct - (ctElapsed or 0)
		if r.ct <= 0 then
			_road[k] = nil
			local rx, ry = string.match(k, "^(%-?%d+),(%-?%d+)$")
			if rx and _bvb and _bvb.RoadChanged then _bvb.RoadChanged(tonumber(rx), tonumber(ry), 0) end
		end
	end
	local toRemove = {}

	for key, eff in pairs(effects) do
		local def = GameConstants.TILE_EFFECTS[eff.id]
		if not def then
			table.insert(toRemove, key)
		else
			-- Unlimited-duration effects (durationCt = -1: Oily, Tar Pit, Vines) never decay.
			local unlimited = (eff.remainingCt == -1)  -- an item's own time (Oil Sprayer 1200 CT) counts down (audit fix 2026-10-27)
			-- Decrement duration (skip for unlimited)
			if not unlimited then
				eff.remainingCt = eff.remainingCt - ctElapsed
			end
			if not unlimited and eff.remainingCt <= 0 then
				table.insert(toRemove, key)
			else
				-- Periodic tick damage
				if def.tickCt and def.tickCt > 0 then
					eff.tickAccum = eff.tickAccum + ctElapsed
					while eff.tickAccum >= def.tickCt do
						eff.tickAccum = eff.tickAccum - def.tickCt
						-- Find unit on this tile
						if allUnits then
							for _, u in ipairs(allUnits) do
								if u.isAlive and u.tileX == eff.tileX and u.tileY == eff.tileY then
									local damage = math.round(u.maxHp * (def.tickDamage or 0.15))
									-- Geomancer Terrain Mastery: terrain damage from the owner's terrain +20%.
									if eff.ownerId and eff.geoSkillTerrain then  -- Geomancer skill terrain only (2026-10-29)
										for _, _ou in ipairs(allUnits) do
											if _ou.id == eff.ownerId then
												damage = math.round(damage * (require :: any)(script.Parent.DoctrinePassiveService).GetTerrainDamageModifier(_ou))
												break
											end
										end
									end
									-- Firebreak zone: Fire damage halved (user ruling 2026-10-27).
									if def.tickElement == "Fire" and (_firebreak[tileKey(u.tileX, u.tileY)] or 0) > 0 then
										damage = math.round(damage * 0.5)
									end
									damage = math.round(damage * hazardTakenMult(u))  -- Goblin Cunning
									if damage > 0 and not guardHazardImmune(u) then
										local _shown0 = GameConstants.CapUnitDamage(u, damage)  -- 1 for a 3-hit gadget
										u.currentHp = math.max(0, u.currentHp - _shown0)
									if u.currentHp <= 0 then
										u.isAlive = false
										-- Power of Nature objective: terrain-effect (burning/hazard tile) KO.
										u._killCause = u._killCause or "terrain"
									end
										print(string.format(
											"[TileEffectService] %s tick: %s takes %d %s damage at (%d,%d) | HP: %d/%d",
											eff.id, u.name, damage, def.tickElement or "?",
											eff.tileX, eff.tileY, u.currentHp, u.maxHp
										))
										if _bvb and _bvb.DotDamage then
											_bvb.DotDamage(u, eff.id, _shown0)
										end
									end
								end
							end
						end
					end
				end
			end
		end
	end

	-- Remove expired effects
	for _, key in ipairs(toRemove) do
		local eff = effects[key]
		if eff then
			print(string.format("[TileEffectService] %s expired at (%d,%d)", eff.id, eff.tileX, eff.tileY))
			if _bvb and _bvb.TileEffectRemoved then
				_bvb.TileEffectRemoved(eff.tileX, eff.tileY, eff.id)
			end
			effects[key] = nil
			-- PHASE 1: NATURAL EXPIRY — if a burn-out transform was deferred on this
			-- tile, fire it NOW (Grassland/Clover→Sand, Wooden Floor→Clear). Done BEFORE
			-- tryReinstateFloor so a non-floor tile becomes its transformed terrain,
			-- while a floor-effect tile is exempted inside fireDeferredTransform and the
			-- floor then re-establishes below.
			fireDeferredTransform(key, eff.tileX, eff.tileY)
			-- Transient effect gone: a permanent chasm-floor effect returns if the
			-- ground still allows it (map_gen_rules row 67).
			tryReinstateFloor(eff.tileX, eff.tileY)
		end
	end
end


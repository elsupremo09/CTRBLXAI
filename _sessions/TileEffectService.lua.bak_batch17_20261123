-- True when ownerId belongs to a PLAYER-side unit in the live list — used to count
-- only PLAYER-initiated terrain changes (spec: exclude non-player-initiated effects).
local function isPlayerOwner(ownerId)
	if not ownerId or not _allUnits then return false end
	for _, u in ipairs(_allUnits) do
		if u.id == ownerId then return u.side == "Player" end
	end
	return false
end

-- PHASE 1 (2026-10-21, project_rules 140-143 'Terrain Fire Reaction'): burn-then-
-- transform. When Fire creates Burning on a BARE FLAMMABLE base terrain, the base
-- transform is DEFERRED until the Burning ENDS. _deferredTransform[tileKey] = element
-- records a pending transform. It fires on NATURAL EXPIRY (ProcessCtTick toRemove)
-- and is CLEARED WITHOUT transforming on EARLY EXTINGUISH (RemoveTileEffect), so a
-- doused tile is spared. Tiles carrying a permanent floor effect (baseFloor: Vines /
-- Tar Pit) are exempt — they never transform on burn-out (rule 143).
local _deferredTransform = {}
-- BLOCKED-TILE GROUND CHANGE (USER RULING 2026-11-06 4:04 PM): a tile effect aimed at a
-- blocked tile (wall / solid object / impassable) is NOT placed, but the ground underneath
-- still changes as if it had landed. Fire on a bare flammable base burns out of sight and
-- transforms on its natural burn-out time. [tileKey] = { element = "Fire", ct = remaining CT }.
-- No visible effect, no damage/status, no reaction partner, never a spread source.
local _hiddenBurnOut = {}

local function tileKey(x, y) return x .. "," .. y end

-- CONTAINER BREAK GUARD (2026-11-07, objects_encounters 112-114 / project_rules 249): what a
-- container releases does NOT react with the action that broke it. F2 (2026-11-08): the guard
-- covers EVERY tile the release landed on (SetReleaseGuard marks them while the release is laid)
-- for the WHOLE action - the attacker's own element/tile reactions later in that action, effect-on-
-- effect reactions, Wind clearing and the explosion chain all skip a guarded tile. CommandService
-- clears the guards when an action starts and when it ends (ClearElementGuards), and the battle
-- clock clears any leftover (ProcessCtTick), so later actions react normally (D2 kept).
-- [tileKey] = true.
local _elementGuard = {}
function TileEffectService.GuardTileFromElement(tileX, tileY)
	_elementGuard[tileKey(tileX, tileY)] = true
end
function TileEffectService.ClearElementGuards()
	table.clear(_elementGuard)
end
-- While true, every tile effect ApplyTileEffect places is guarded (a container release being laid).
-- Returns the previous value so the caller can restore it.
local _releaseGuardOn = false
function TileEffectService.SetReleaseGuard(on)
	local prev = _releaseGuardOn
	_releaseGuardOn = on == true
	return prev
end
-- EXPLOSION BREAKING HIT (fix D1, 2026-11-07): while an explosion event hits the object on one of
-- its tiles, every tile effect that hit creates (a broken Toxic Crate's Poison Cloud) is noted
-- here, and that same explosion event does not chain through it. Later blasts and later Fire
-- react normally. [tileKey] = true while an explosion object hit runs; nil otherwise.
local _blastFresh: any = nil

-- PER-TILE BASE FLOOR-EFFECT SLOT (map_gen_rules row 67 'Chasm-Floor Effect
-- Permanence', Slice 5 2026-10-02). baseFloor[tileKey] = effectId of the PERMANENT
-- floor effect generation placed on a chasm floor (Vines on Plains/Forest, Tar Pit
-- on Castle). While a transient effect (Burning from Fire, Steam, Wet, ...) sits on
-- the tile the floor effect is suppressed; when the tile becomes bare again the
-- base effect RE-ESTABLISHES if the terrain still allows it (Vines need Organic
-- ground, Tar Pit needs Solid ground). If the terrain no longer allows it the slot
-- is cleared — the loss is permanent. Terrain transforms of the floor itself
-- (Quicksand->Mud, Molten->Rocky, Deep Water->Ice) are permanent and never revert.
local baseFloor = {}

-- Terrain tag a floor effect needs in order to exist / re-establish.
local FLOOR_EFFECT_REQUIRED_TAG = {
	Vines     = "Organic",  -- terrain_effects Vines: "Cannot exist on incompatible terrain"
	["Tar Pit"] = "Solid",
}

local function terrainHasTag(tileX, tileY, tag)
	local terrainId = GameConstants.GetTerrainId(tileX, tileY)
	local tDef = GameConstants.TERRAIN_TYPES[terrainId]
	if not tDef or not tDef.tags then return false end
	for _, t in ipairs(tDef.tags) do
		if t == tag then return true end
	end
	return false
end

local function floorEffectCompatible(tileX, tileY, effectId)
	local need = FLOOR_EFFECT_REQUIRED_TAG[effectId]
	if not need then return true end
	return terrainHasTag(tileX, tileY, need)
end

-- Re-establish a tile's base floor effect if the tile is bare. Returns true if applied.
local function tryReinstateFloor(tileX, tileY)
	local key = tileKey(tileX, tileY)
	local baseId = baseFloor[key]
	if not baseId or effects[key] then return false end
	if not floorEffectCompatible(tileX, tileY, baseId) then
		baseFloor[key] = nil
		print(string.format(
			"[TileEffectService] Floor %s at (%d,%d) LOST permanently — terrain %s no longer compatible",
			baseId, tileX, tileY, tostring(GameConstants.GetTerrainId(tileX, tileY))))
		return false
	end
	print(string.format("[TileEffectService] Floor %s RE-ESTABLISHED at (%d,%d)", baseId, tileX, tileY))
	TileEffectService.ApplyTileEffect(tileX, tileY, baseId, "floor", nil, true)
	return true
end


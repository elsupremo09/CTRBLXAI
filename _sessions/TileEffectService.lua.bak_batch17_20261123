--------------------------------------------------
-- ELEMENT REACTIONS
-- When a new effect is applied to a tile that already has an effect,
-- the two may react to produce a third effect (or clear both).
--
-- TRG-013: One pass per incoming packet. Later-stage transformation
-- does not return same packet to earlier stage.
--------------------------------------------------

local REACTIONS = {
	-- existing effect → incoming element → result. `false` = the effect is simply cleared.
	-- (A Lua `nil` value is NOT stored in a table, so the old "Wind = nil" entries never
	-- existed and Wind cleared nothing. Fixed 2026-10-27, user ruling: Wind clears clouds.)
	Burning = { Water = "Steam",   Ice = "Steam"    },
	-- Electric on Wet -> Static Cloud (terrain_effects Wet row / GameConstants, ruling 2026-09-29; F1 2026-11-08).
	Wet     = { Fire  = "Steam",   Ice = "Frozen", Electric = "Static Cloud" },
	Frozen  = { Fire  = "Wet"                       },
	-- WIND CLEARS CLOUDS (user ruling 2026-10-27): Steam (also what fog/smoke items place),
	-- Static Cloud and Poison Cloud are blown away. Wind never explodes Poison Cloud.
	Steam   = { Electric = "Static Cloud", Wind = false },
	["Static Cloud"] = { Wind = false                },
	["Poison Cloud"] = { Fire = "Explosion", Wind = false },
	-- terrain_effects rows 29/30 (+ GameConstants.TILE_EFFECTS reactions): Fire ignites.
	Vines            = { Fire = "Burning"            },
	["Tar Pit"]      = { Fire = "Burning"            },
}

local function resolveReaction(existingId, incomingElement)
	local reactions = REACTIONS[existingId]
	if reactions and reactions[incomingElement] ~= nil then
		local r = reactions[incomingElement]
		if r == false then return true, nil end  -- reacted, effect cleared
		return true, r  -- reacted, result effect
	end
	return false, nil  -- no reaction
end

-- PHASE 1 — is (x,y) a BARE flammable base terrain that DEFERS its Fire transform?
-- True only for terrains tagged Flammable whose transformations[Fire] is set
-- (Grassland, Clover Field, Wooden Floor). Non-flammable transformable terrain
-- (Sand→Molten, Mud/Swamp→Rocky, Ice, Metal) returns false → stays instant.
local function isDeferredFlammableTransform(tileX, tileY, element)
	if element ~= "Fire" then return false end
	local terrainId = GameConstants.GetTerrainId(tileX, tileY)
	local def = GameConstants.TERRAIN_TYPES[terrainId]
	if not def or not def.tags or not def.transformations then return false end
	if not def.transformations.Fire then return false end
	for _, t in ipairs(def.tags) do
		if t == "Flammable" then return true end
	end
	return false
end

-- VOXEL_KEEP origin set (mirrors MapRenderer's VOXEL_KEEP). These terrains render
-- as server-side Roblox Terrain VOXEL columns (workspace.Terrain:FillBlock), not as
-- a textured tile Part. The CLIENT cannot clear voxels (workspace.Terrain is
-- server-only), so when one of these transforms to a non-voxel terrain a client
-- re-skin alone leaves the old voxel column visible on top of the re-skinned Part.
-- See transformAndBroadcast VOXEL-NUANCE note below (BUG-002 / RULE-010).
local VOXEL_KEEP_ORIGIN = {
	Grassland        = true,
	["Deep Water"]    = true,
	["Shallow Water"] = true,
}

-- TERRAIN TRANSFORM + BROADCAST (BUG-002 fix 2026-10-22).
-- Single choke-point for EVERY mid-battle base-terrain transform. Captures the
-- ORIGIN terrain id BEFORE transforming, runs GameConstants.TransformTerrain, and
-- when the terrain actually changed, broadcasts TerrainChanged({x,y,terrainId}) so
-- the client re-skins the tile (previously invisible: TransformTerrain mutated
-- TERRAIN_MAP with no client signal). Returns (changed, newId) — callers that use
-- the `changed` return (ResolveElementOnTile) keep working. _bvb is the already-held
-- BattleVisualBroadcaster reference (no new dependency). nil-safe like siblings.
local function transformAndBroadcast(tileX, tileY, element)
	local originTerrain = GameConstants.GetTerrainId(tileX, tileY)
	local changed, newId = GameConstants.TransformTerrain(tileX, tileY, element)
	if changed and newId then
		if _bvb and _bvb.TerrainChanged then
			-- Battle Log Coverage: cause = the element (grouped "Fire: 2 tiles became Sand.")
			_bvb.TerrainChanged(tileX, tileY, newId, nil, element and tostring(element) or nil)
		end
		-- VOXEL-NUANCE (RULE-010): if the ORIGIN was a VOXEL_KEEP terrain (rendered as a
		-- server Roblox-Terrain voxel column) and the new terrain is NOT voxel-kept, the
		-- client re-skin cannot clear the old voxel column (workspace.Terrain is
		-- server-only), so the stale column stays visible over the re-skinned Part. The
		-- per-tile server voxel clear is NOT safely reachable from TileEffectService:
		-- this module holds no mapFolder / MapRenderer handle (only _bvb), the task
		-- forbids adding a new dependency, and every existing MapRenderer voxel helper
		-- (ClearVoxelsForPerTile / ClearVoxelsHideTiles / SetViewMode) calls
		-- workspace.Terrain:Clear() which wipes the WHOLE map's voxels, not one column.
		-- MapRenderer.ReshapeTile exists for single-tile runtime edits but only recolors
		-- the Part + sets its Terrain attribute; it does NOT clear that tile's voxel
		-- column. FLAGGED FOLLOW-UP (RULE-011, no fake clear): extend
		-- MapRenderer.ReshapeTile to clear the single tile's voxel column (a localized
		-- workspace.Terrain:FillBlock(<tile region>, Enum.Material.Air) at that tile's
		-- X/Z/elevation) and call it from the transform path via a Main-wired closure
		-- over the live mapFolder (same injection pattern as SetObjectRenderer), so the
		-- re-skinned Part shows underneath. Until then the broadcast + re-skin are fully
		-- live for NON-voxel origins (Sand->Molten, Mud/Swamp->Rocky, Holy/Dark on
		-- non-voxel terrain, etc.); voxel-origin transforms re-skin the hidden Part but
		-- the voxel column remains until the clear above lands.
		if VOXEL_KEEP_ORIGIN[originTerrain] and not VOXEL_KEEP_ORIGIN[newId] then
			-- BUG-002 GAP 2 FIX (2026-10-22): the prior FOLLOW-UP is now DONE. Clear just
			-- this one tile's voxel column via the Main-injected _voxelClearer (closure over
			-- the live mapFolder -> MapRenderer.ClearTileVoxelColumn, a LOCALIZED
			-- FillBlock(..., Air) over only this tile's region, NEVER workspace.Terrain:Clear()
			-- which would wipe the whole map). nil-safe: if the clearer is not wired we fall
			-- back to the prior flag warn (re-skin still fires; only the column remains).
			if _voxelClearer then
				_voxelClearer(tileX, tileY)
				print(string.format(
					"[TileEffectService] TerrainChanged (%d,%d): %s -> %s cleared stale VOXEL_KEEP voxel column",
					tileX, tileY, tostring(originTerrain), tostring(newId)))
			else
				warn(string.format(
					"[TileEffectService] TerrainChanged (%d,%d): %s -> %s is a VOXEL_KEEP origin; "
					.. "client re-skins the tile Part but the server voxel column is NOT cleared "
					.. "(no voxel-clear wired here). FOLLOW-UP: wire TileEffectService.SetVoxelClearer "
					.. "from Main so the stale voxel column is cleared.",
					tileX, tileY, tostring(originTerrain), tostring(newId)))
			end
		end
	end
	return changed, newId
end

-- DIRECT TERRAIN SET + BROADCAST (BUG-002 GAP 1 fix, 2026-10-22). Mid-battle sites
-- that set a terrain id DIRECTLY (not through GameConstants.TransformTerrain) must
-- still signal the client so the re-skin happens. This writes the new terrain via
-- GameConstants.SetTerrainId then fires _bvb.TerrainChanged (nil-safe, the same
-- already-held BattleVisualBroadcaster reference the rest of this module uses).
-- Explosion crack (Rocky@>=8 -> Cracked Ground) routes through here. Runtime-only
-- (explosion) path, never map-gen, so the broadcast never fires at map build time.
-- Unlike transformAndBroadcast this is NOT a voxel-origin path (Rocky/Cracked are
-- not VOXEL_KEEP), so no voxel-clear is needed.
-- cause (optional, 2026-10-28): battle-log label (e.g. "The explosion").
local function setTerrainAndBroadcast(tileX, tileY, terrainId, cause)
	GameConstants.SetTerrainId(tileX, tileY, terrainId)
	if _bvb and _bvb.TerrainChanged then
		_bvb.TerrainChanged(tileX, tileY, terrainId, nil, cause)
	end
end

-- PUBLIC wrapper (2026-10-26) so other server systems (consumable terrain-transform
-- items) can set a tile's terrain AND re-skin it on the client through the SAME path
-- the tile-effect system uses — no duplicated broadcast logic. Also clears the tile's
-- voxel column when leaving a water terrain (so the water block disappears), reusing
-- the Main-injected _voxelClearer exactly as the effect-transform path does. Returns
-- true when the terrain actually changed.
local WATER_TERRAINS = { ["Shallow Water"] = true, ["Deep Water"] = true }
function TileEffectService.TransformTileTerrain(tileX, tileY, terrainId)
	local before = GameConstants.GetTerrainId(tileX, tileY)
	if before == terrainId then return false end
	setTerrainAndBroadcast(tileX, tileY, terrainId)
	-- Leaving water -> clear the standing water voxel column (visual parity with the
	-- weather dry-up path). Entering water is handled by the client re-skin.
	if WATER_TERRAINS[before] and not WATER_TERRAINS[terrainId] and _voxelClearer then
		_voxelClearer(tileX, tileY)
	end
	return true
end

-- PHASE 1 — fire a tile's DEFERRED base transform (called on NATURAL Burning expiry).
-- Honors the floor-effect exemption (rule 143): a tile with a permanent floor effect
-- (baseFloor) never transforms — it is left for tryReinstateFloor to restore.
local function fireDeferredTransform(key, tileX, tileY)
	local element = _deferredTransform[key]
	_deferredTransform[key] = nil
	if not element then return end
	if baseFloor[key] ~= nil then
		-- Floor-effect exemption: base stays; floor re-establishes via tryReinstateFloor.
		print(string.format(
			"[TileEffectService] Burn-out transform SKIPPED at (%d,%d) — permanent floor effect (%s) exempt",
			tileX, tileY, tostring(baseFloor[key])))
		return
	end
	transformAndBroadcast(tileX, tileY, element)
end

--------------------------------------------------
-- OPEN-TILE PLACEMENT (USER RULINGS 2026-11-06)
--------------------------------------------------
-- No tile effect is ever placed on a blocked tile: walls / solid objects
-- (GameConstants.BLOCKERS — OBS blockers, Ballista/Catapult engines, …) or impassable
-- terrain. First ruled for clouds / Steam / gas (1:55 PM), then extended to EVERY tile
-- effect (2:44 PM: Burning, Wet, Frozen, Oily, Darkened Ground, Holy Ground, Tar Pit,
-- Vines, …). One check shared by every placement path (items, devices, skills,
-- augments, objects, weather, reactions, Burning spread) and by Strong Wind Poison
-- Cloud drift. Map-authored floor seeding (owner "floor") is exempt — it is map data.
function TileEffectService.IsOpenEffectTile(x, y)
	if x < 1 or x > _mapWidth or y < 1 or y > _mapHeight then return false end
	if GameConstants.IsBlocked and GameConstants.IsBlocked(x, y) then return false end
	if GameConstants.IsImpassableTerrain and GameConstants.IsImpassableTerrain(x, y) then return false end
	return true
end

-- Ground side ONLY of a placement on a blocked tile (USER RULING 2026-11-06 4:04 PM). Mirrors
-- the normal path's terrain step: honours skipTransform, Firebreak, the floor-effect exemption
-- (rule 143) and burn-then-transform (rules 140-142: Fire on bare Grassland / Clover / Wooden
-- Floor defers to burn-out; everything else transforms at once). An effect already sitting on
-- the tile from before the object arrived is left as it is (ruling), so the ground is not touched.
-- Geomancer Terrain Mastery (2026-10-28): owner's terrain +1 turn (+400 CT, the project's
-- turn->CT step). Unit owners only (floor / tile / trap owners never match a unit id).
-- DB: only terrain a Geomancer creates with a SKILL counts (not its basic attacks or items).
-- Returns (durationCt, geoSkillTerrain). ONE helper shared by the visible placement and the
-- hidden burn under a blocked tile, so both last exactly as long (USER RULING 2026-11-06 4:30 PM).
local function geomancerTerrainDuration(ownerId, baseCt)
	local ct, geo = baseCt, false
	if ownerId and _allUnits then
		for _, _ou in ipairs(_allUnits) do
			if _ou.id == ownerId then
				local _dps = (require :: any)(script.Parent.DoctrinePassiveService)
				if _dps.IsCastingSkill(_ou) then
					local _add = _dps.GetTerrainDurationModifier(_ou)
					if _add ~= 0 then
						-- An unlimited effect (-1) stays unlimited (re-check 2026-10-29).
						if ct ~= -1 then ct = ct + _add * 400 end
						geo = true
					end
				end
				break
			end
		end
	end
	return ct, geo
end

local function blockedTileGroundChange(tileX, tileY, effectId, skipTransform, durationCtOverride, ownerId)
	local def = GameConstants.TILE_EFFECTS[effectId]
	if not def then return end
	local key = tileKey(tileX, tileY)
	local pending = _hiddenBurnOut[key]
	if pending then
		-- The ground is burning out of sight. Treat the incoming element like it met Burning:
		-- the burn ends EARLY, so the terrain is spared (rule 141); a reaction result then
		-- changes the ground in its own right, a non-reacting effect replaces the burn.
		_hiddenBurnOut[key] = nil
		print(string.format(
			"[TileEffectService] Hidden burn under blocked tile (%d,%d) ended early by %s - terrain SPARED",
			tileX, tileY, tostring(effectId)))
		local reacted, resultId = resolveReaction("Burning", def.element)
		if reacted then
			if resultId and resultId ~= "Explosion" then
				blockedTileGroundChange(tileX, tileY, resultId, false, nil, ownerId)
			end
			return
		end
	elseif effects[key] then
		return
	end
	if skipTransform then return end
	if baseFloor[key] ~= nil then return end
	if effectId == "Burning" and (_firebreak[key] or 0) > 0 then return end
	if effectId == "Burning" and isDeferredFlammableTransform(tileX, tileY, def.element) then
		-- Same lifetime as the visible fire would get, incl. Geomancer Terrain Mastery.
		local ct = geomancerTerrainDuration(ownerId, durationCtOverride or def.durationCt or 900)
		if ct ~= -1 then
			_hiddenBurnOut[key] = { element = def.element, ct = ct }
			print(string.format(
				"[TileEffectService] Ground under blocked tile (%d,%d) burns out of sight - base changes in %d CT",
				tileX, tileY, ct))
		end
	else
		local changed = transformAndBroadcast(tileX, tileY, def.element)
		if changed then
			print(string.format("[TileEffectService] Ground under blocked tile (%d,%d) changed by %s",
				tileX, tileY, tostring(effectId)))
		end
	end
end


--!strict
-- DungeonBattleHooks — every dungeon-only step of a battle, in one place (refactor 2026-11-15).
-- Moved VERBATIM out of Main.server.lua (no behavior change). Main calls one entry point per
-- battle phase; services only READ the per-unit "_dg*" stamps written here (stamp contract below).
--
-- Phases (in call order):
--   ApplyBattleStart(ctx)  -> relics, secondWind   battle start: Boss relic grant + all relic stamps
--   ApplyFortune(pid, dungeonBattle, base)          Expedition Fortune with RL-06 / RL-45 (called twice)
--   ApplyVanguard(ctx)                              after deploy: RL-42 first deployed unit
--   ApplyMapRelics(ctx)                             after objects spawn: RL-23 chest / RL-24 Mimic
--   SnapshotLoot(pid, isDungeon, cards)             before rewards: balance / items / cards
--   ClearBattleEndStamps(units)                     before HP save: drop battle-only stamps + HP bonus
--   ApplyAfterWin(ctx)                              after HP save: RL-09 used / RL-11 / RL-12
--   ApplyBenchRecovery(ctx)                         after ApplyAfterWin: 15% HP/MP to party units that sat out a won battle (rule 280)
--   CollectRunBag(ctx)                              after rewards: move this battle's loot into the run bag + room silver (rule 278)
--
-- Stamp contract (written here, read elsewhere — keep both sides in sync):
--   _dgDamageTakenMult, _dgDealtMult, _dgDefMult, _dgBaseRtAdd, _dgImmune, _dgWardReady  -> StatusService
--   _dgEliteDmgMult, _dgPrecBonus                    -> CombatResolver (+StatCalcService for precision)
--   _dgMoveBonus, _dgJumpAdd, _dgStabBonus           -> StatCalcService
--   _dgStatBuff, _dgStrRelic, _dgSkillRange, _dgDiscBonus, battleMaxHpBonusPct -> EquipmentService
--   _dgCastMult, _dgScholar, _dgRangeBonus           -> TraitEffectService
--   _dgApBonus -> BattleCoordinator · _dgKinMult -> EnemyGenerator · _dgWeatherMult -> WeatherService
--   _dgSecondWind -> RacePassiveService · _dgBootsRt / _dgHpBonusAdded / _dgUndeadRelic -> this module + Main initiative
-- Data (numbers, weapon groups, curse pairs) lives in DungeonRules.Data.Relic (DAT-001).

local Game = script.Parent
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DungeonRules            = require(Game:WaitForChild("DungeonRules"))
local DungeonService          = require(Game:WaitForChild("DungeonService"))
local DungeonRemotes          = require(Game:WaitForChild("DungeonRemotes"))
local EquipmentService        = require(Game:WaitForChild("EquipmentService"))
local StatusService           = require(Game:WaitForChild("StatusService"))
local ObjectEffectService     = require(Game:WaitForChild("ObjectEffectService"))
local PersistentStateService  = require(Game:WaitForChild("PersistentStateService"))
local CurrencyService         = require(Game:WaitForChild("CurrencyService"))
local InventoryService        = require(Game:WaitForChild("InventoryService"))
local RewardService           = require(Game:WaitForChild("RewardService"))
local BattleVisualBroadcaster = require(Game:WaitForChild("BattleVisualBroadcaster"))

local DoctrineData  = require(ReplicatedStorage:WaitForChild("Content"):WaitForChild("DoctrineData"))
local TerrainData   = require(ReplicatedStorage:WaitForChild("Content"):WaitForChild("TerrainData"))
local GameConstants = require(ReplicatedStorage:WaitForChild("CTRBLXAI"):WaitForChild("Shared"):WaitForChild("GameConstants"))
local BattleEvents  = require(ReplicatedStorage:WaitForChild("CTRBLXAI"):WaitForChild("Remotes"):WaitForChild("BattleEvents"))

local DungeonBattleHooks = {}

-- DEPTH BONUS (endless step 5, project_rules 281): on stages 4+ every enemy gets +8% Max HP and +4%
-- Attack and Defense per stage after 3 (additive, no cap; Elites / Bosses the same; never AP / RT /
-- Movement). Attack = damage dealt (_dgDealtMult), Defense = _dgDefMult, Max HP = battleMaxHpBonusPct
-- (survives every rebuild). Set at battle start; mid-battle arrivals get it through EnemyGenerator.
-- Summons and Neutral units are skipped. Runs before Black Lantern / Withering Mist (they stack on top).
local _depthHp, _depthAtk = 0, 0
local function applyDepth(u: any)
	if u.side ~= "Enemy" or u.isSummon or u._dgDepthApplied then return end
	if _depthHp <= 0 and _depthAtk <= 0 then return end
	u._dgDepthApplied = true
	if _depthAtk > 0 then
		local m = 1 + _depthAtk / 100
		u._dgDealtMult = (u._dgDealtMult or 1) * m
		u._dgDefMult = (u._dgDefMult or 1) * m
	end
	if _depthHp > 0 then
		local before = u.maxHp or 0
		u.battleMaxHpBonusPct = (tonumber(u.battleMaxHpBonusPct) or 0) + _depthHp / 100
		EquipmentService.RebuildUnitStats(u)
		if u.isAlive ~= false then
			u.currentHp = math.min(u.maxHp or 0, (u.currentHp or 0) + math.max(0, (u.maxHp or 0) - before))
		end
	end
end

-- Battle start. ctx = { playerId, quest, units, party, dungeonBattle }. Returns the held-relic set and RL-09 state.
function DungeonBattleHooks.ApplyBattleStart(ctx: any): ({ [string]: boolean }, any)
	local PLAYER_ID, selectedQuest, allUnitsList, dungeonParty, dungeonBattle = ctx.playerId, ctx.quest, ctx.units, ctx.party, ctx.dungeonBattle
	-- DUNGEON RELICS (build step 8, 2026-11-14; project_rules 271). The Boss relic is given as the boss
	-- fight STARTS (user confirmed 10:32 AM), then every held relic is stamped on the dungeon party for
	-- THIS battle only (cleared at battle end / next battle). Nothing applies outside dungeon battles.
	local dgRelics: { [string]: boolean } = {}
	local dgSecondWind: any = nil
	local dgStacks: { [string]: number } = {} -- step 6: depth curse stacks (RL-61..65 add up)
	_depthHp, _depthAtk = 0, 0 -- Depth bonus off unless this is a stage 4+ dungeon battle (rule 281)
	if dungeonBattle then
		if selectedQuest and selectedQuest.dungeonPlayed == "Boss" then
			local okR, rid = pcall(DungeonService.GrantBossRelic, PLAYER_ID)
			if not okR then warn("[Main] Boss relic failed: " .. tostring(rid)) end
		end
		for _, id in DungeonService.GetRelics(PLAYER_ID) do dgRelics[id] = true end
		if DungeonService.CurseStacks then dgStacks = DungeonService.CurseStacks(PLAYER_ID) end
		local R = DungeonRules.Data.Relic
		if dgRelics["RL-09"] then dgSecondWind = { used = false, hpPct = R.SecondWindHpPct } end
		for _, u in ipairs(allUnitsList) do
			if u.side == "Player" and table.find(dungeonParty or {}, u.id) then
				local hpPct = (if dgRelics["RL-01"] then R.HeartstoneHpPct else 0) + (if dgRelics["RL-15"] then R.CrownHpPct else 0)
					- (if dgRelics["RL-46"] then R.GlassHpPct else 0) -- RL-46 Glass Crown: Max HP -10% (relics v2)
					- (dgStacks["RL-61"] or 0) * R.ThinAirHpPct -- RL-61 Thinning Air (step 6): -5% Max HP per stack, same no-free-heal path
				hpPct = math.max(hpPct, -90) -- step 6 fix W3: stacked HP curses never take Max HP below 10% of normal
				if hpPct ~= 0 then
					local before = u.maxHp or 0
					local start = u.currentHp or 0 -- before the rebuild (a lower Glass Crown max would cap it first)
					u.battleMaxHpBonusPct = hpPct / 100
					EquipmentService.RebuildUnitStats(u)
					if u.isAlive then
						u.currentHp = math.min(u.maxHp, start + math.max(0, u.maxHp - before))
						u._dgHpBonusAdded = u.currentHp - start -- taken back at battle end (no free heal, rule 266); < 0 = given back
					end
				end
				local dmg = 1 - ((if dgRelics["RL-10"] then R.IronDamagePct else 0) + (if dgRelics["RL-15"] then R.CrownDamagePct else 0)) / 100
				u._dgDamageTakenMult = if dmg < 1 then dmg else nil
				u._dgWeatherMult = if dgRelics["RL-07"] then 1 - R.CloakWeatherPct / 100 else nil
				u._dgEliteDmgMult = if dgRelics["RL-13"] then 1 + R.BannerDamagePct / 100 else nil
				u._dgWardReady = if dgRelics["RL-14"] then true else nil
				u._dgSecondWind = dgSecondWind
				u._dgBootsRt = if dgRelics["RL-04"] then R.BootsRt else nil
			else
				u._dgDamageTakenMult, u._dgWeatherMult, u._dgEliteDmgMult, u._dgWardReady, u._dgSecondWind, u._dgBootsRt = nil, nil, nil, nil, nil, nil
			end
		end
		-- RL-05 Refill Satchel: at battle start, ONE equipped consumable in the party (not full) gains +1
		-- charge. Seeded per run room; the lowest-charge slot first (agent default).
		if dgRelics["RL-05"] then
			local best: any, bestU: any = nil, nil
			for _, u in ipairs(allUnitsList) do
				if u.side == "Player" and table.find(dungeonParty or {}, u.id) then
					for _, s in pairs(u.consumableSlots or {}) do
						if s and s.consumableId and (s.currentCharges or 0) < (s.maxCharges or 0) and (not best or (s.currentCharges or 0) < (best.currentCharges or 0)) then best, bestU = s, u end
					end
				end
			end
			if best then
				best.currentCharges = math.min(best.maxCharges, (best.currentCharges or 0) + R.SatchelCharges)
				print(string.format("[Main] Refill Satchel: %s %s +%d charge", bestU and bestU.name or "?", tostring(best.consumableId), R.SatchelCharges))
			end
		end
		local n = 0 for _ in dgRelics do n += 1 end
		if n > 0 then print(string.format("[Main] Dungeon relics this battle: %d", n)) end
		-- EV-11 doctrine buff for this battle (stages build 2026-11-15, rule 272). EV-16 mutators retired 10:01 AM.
		local dbuff = DungeonService.TakeNextBattleBuff(PLAYER_ID)
		for _, u in ipairs(allUnitsList) do
			u._dgStatBuff = nil
			if u.side == "Player" and table.find(dungeonParty or {}, u.id) then
				if dbuff and u.doctrineId == dbuff.doctrineId then
					-- the doctrine's main stat = its largest positive stat package entry (agent default)
					local pkg = (DoctrineData[u.doctrineId] or {}).statPackage or {}
					local best: string?, bv: number = nil, 0
					for _, s in ipairs({ "STR", "AGI", "INT", "VIT", "DEX", "LUK" }) do
						if (pkg[s] or 0) > bv then best, bv = s, pkg[s] end
					end
					if best then u._dgStatBuff = { stat = best, pct = dbuff.pct } end
				end
				if u._dgStatBuff then EquipmentService.RebuildUnitStats(u) end
			end
		end
		-- RL-16..RL-22 (stages part 3, 2026-11-15, rule 271): battle-only stamps on the dungeon party (and,
		-- for War Banner, +Defense on the enemies). Cleared at the start of every battle and before HP save.
		for _, u in ipairs(allUnitsList) do
			u._dgStrRelic, u._dgApBonus, u._dgDealtMult, u._dgMoveBonus, u._dgDefMult, u._dgUndeadRelic = nil, nil, nil, nil, nil, nil
			if u.side == "Player" and table.find(dungeonParty or {}, u.id) then
				if dgRelics["RL-16"] then u._dgStrRelic = { flat = R.OgreStrFlat, pct = R.OgreStrPct } end
				if dgRelics["RL-19"] then u._dgApBonus = R.OathApBonus; u._dgDealtMult = 1 - R.OathDamagePct / 100 end
				if dgRelics["RL-20"] then u._dgMoveBonus = R.LeagueMoveBonus end
				if u._dgStrRelic then EquipmentService.RebuildUnitStats(u) end
				-- RL-21 Featherfall Crest: permanent Flight for this battle (same as the Flying race tag).
				if dgRelics["RL-21"] and u.isAlive then
					if not StatusService.HasStatus(u, "Flight") then StatusService.ApplyStatus(u, "Flight", "Relic") end
					local fi: any = StatusService.HasStatus(u, "Flight")
					if type(fi) == "table" then fi.remainingTurns = nil; fi.remainingCt = nil; fi.permanent = true end
				end
				-- RL-22 Lich's Phylactery: the Undead status for this battle (Dark heals, Holy x2, Poison/Bleed immune).
				if dgRelics["RL-22"] and u.isAlive and not StatusService.HasStatus(u, "Undead") then
					StatusService.ApplyStatus(u, "Undead", "Relic")
					u._dgUndeadRelic = true
				end
				-- RL-18 Leaden Shackles (curse): Slow timed in CT (2000 CT) instead of its usual 3 turns.
				if dgRelics["RL-18"] and u.isAlive then
					StatusService.ApplyStatus(u, "Slow", "Curse") -- "Curse": Warding Sigil / Debuff Resistance can't block it (rule 271)
					local si: any = StatusService.HasStatus(u, "Slow")
					if type(si) == "table" then si.remainingTurns = nil; si.remainingCt = R.ShacklesSlowCt end
				end
			elseif u.side == "Enemy" and dgRelics["RL-17"] then -- enemies only, not neutral (auto-accepted 12:38 PM)
				u._dgDefMult = 1 + R.BannerEnemyDefPct / 100 -- War Banner: enemies +10% Defense
			end
		end
		-- Depth bonus (endless step 5, rule 281): after the War Banner stamp (it sets, Depth multiplies).
		do
			local stage = tonumber((dungeonBattle and dungeonBattle.dungeonStage) or (selectedQuest and selectedQuest.dungeonStage)) or 1
			_depthHp, _depthAtk = DungeonRules.DepthBonus(stage)
			for _, u in ipairs(allUnitsList) do
				u._dgDepthApplied = nil
				applyDepth(u)
			end
			if _depthHp > 0 or _depthAtk > 0 then
				print(`[Main] Depth bonus stage {stage}: enemies +{_depthHp}% Max HP, +{_depthAtk}% Attack and Defense`)
			end
		end
		-- RL-25..RL-60 (relics v2, 2026-11-15; Simulator v11 numbers). Battle-only stamps, cleared at the start of
		-- every battle and before HP save. "Creeds" hit every unit with that weapon, foes too.
		local rng = Random.new()
		local hexDebuff = if dgRelics["RL-32"] then R.HexDebuffs[rng:NextInteger(1, #R.HexDebuffs)] else nil
		local immune: { [string]: boolean } = {}
		for rid, list in (R.Immunities :: any) do if dgRelics[rid] then for _, s in list do immune[s] = true end end end
		local anyImmune = next(immune) ~= nil
		for _, u in ipairs(allUnitsList) do
			u._dgRangeBonus, u._dgStabBonus, u._dgJumpAdd, u._dgBaseRtAdd, u._dgPrecBonus, u._dgImmune, u._dgKinMult, u._dgSkillRange, u._dgDiscBonus = nil, nil, nil, nil, nil, nil, nil, nil, nil
			u._dgCastMult, u._dgScholar = nil, nil -- RL-48 / RL-51 (relic step 2)
			local inParty = u.side == "Player" and table.find(dungeonParty or {}, u.id) ~= nil
			local wid = u.equipmentSlots and u.equipmentSlots.MainHand and u.equipmentSlots.MainHand.baseArchetypeId
			local range = 0
			if wid and dgRelics["RL-49"] and R.SpearWeapons[wid] then range += R.CreedRange end
			if wid and dgRelics["RL-50"] and R.BowWeapons[wid] then range += R.CreedRange end
			if wid and dgRelics["RL-52"] and R.SwordWeapons[wid] then u._dgPrecBonus = R.DuelistPrecision end
			if wid and dgRelics["RL-51"] and R.StaffWeapons[wid] then u._dgScholar = R.ScholarMpPct end -- Scholar's Creed: MP each turn (TraitEffectService.OnTurnStart)
			if inParty then
				if dgRelics["RL-25"] then range += R.LongshotRange end
				if dgRelics["RL-43"] then range += R.ChainsPartyRange end
				if dgRelics["RL-26"] then u._dgStabBonus = R.StabilityBonus end
				if dgRelics["RL-57"] then u._dgJumpAdd = R.LeadenJump end
				if dgRelics["RL-54"] then u._dgBaseRtAdd = -R.SwiftRt end
				if dgRelics["RL-48"] then u._dgCastMult = 1 - R.SageCastPct / 100 end -- Sage's Hourglass: channel + post-cast RT x0.65
				if dgRelics["RL-41"] then u._dgKinMult = R.KinSummonHpMult end
				if anyImmune then u._dgImmune = immune end
				if dgRelics["RL-46"] then u._dgMoveBonus = (u._dgMoveBonus or 0) + R.GlassMoveBonus end
				local dealt = (if dgRelics["RL-45"] then 1 + R.ReaverDamagePct / 100 else 1) * (if dgRelics["RL-46"] then 1 + R.GlassDamagePct / 100 else 1)
					* math.max(0.1, 1 - (dgStacks["RL-62"] or 0) * R.DulledDamagePct / 100) -- RL-62 Dulled Steel (step 6): -4% per stack
				if dealt ~= 1 then u._dgDealtMult = (u._dgDealtMult or 1) * dealt end
				if dgRelics["RL-44"] then u._dgDamageTakenMult = (u._dgDamageTakenMult or 1) * (1 + R.TyrantDamageTakenPct / 100) end
				if (dgStacks["RL-63"] or 0) > 0 then u._dgDamageTakenMult = (u._dgDamageTakenMult or 1) * (1 + dgStacks["RL-63"] * R.BrittleTakenPct / 100) end -- RL-63 Brittle Guard (step 6)
				if dgRelics["RL-53"] then u._dgDefMult = (u._dgDefMult or 1) * (1 + R.IronSkinDefPct / 100) end
				if dgRelics["RL-27"] or dgRelics["RL-56"] or dgRelics["RL-67"] then
					u._dgSkillRange = if dgRelics["RL-27"] then R.FarFocusRange else nil
					-- RL-67 Dimming Light (step 6): -1 Discovery Radius (EquipmentService keeps it >= 1); a curse, outside the furniture cap
					local disc = (if dgRelics["RL-56"] then R.StargazerRadius else 0) - (if dgRelics["RL-67"] then R.DimRadius else 0)
					u._dgDiscBonus = if disc ~= 0 then disc else nil
					EquipmentService.RebuildUnitStats(u)
				end
				-- RL-28/29/30/33/58 (HP, MP, charges, Totem buff) moved to ApplyVanguard: deployed units only (fix 2026-11-15).
			elseif u.side == "Enemy" and u.isAlive then
				if dgRelics["RL-43"] then u._dgMoveBonus = (u._dgMoveBonus or 0) + R.ChainsEnemyMove end
				if dgRelics["RL-44"] then u._dgBaseRtAdd = R.TyrantEnemyRt end
				if dgRelics["RL-60"] then -- Black Lantern: +10% Max HP (enemies are not saved)
					-- BUG-220 (batch 18b, Tester W2): kept as a battle-only Max HP bonus read by every stat rebuild (same as the
					-- boss bonus, EnemyGenerator), so a later rebuild (Weakened, Break, any stat status) no longer drops it.
					-- BUG-225 (batch 18c, Tester F1): multiplicative with the boss / depth bonus already in battleMaxHpBonusPct,
					-- so a boss is Elite x 2 x 1.1 (2.2x) again, not x 2.1. The stamp is kept, so later rebuilds still keep it.
					local before = u.maxHp or 0
					u.battleMaxHpBonusPct = (1 + (tonumber(u.battleMaxHpBonusPct) or 0)) * (1 + R.LanternHpPct / 100) - 1
					EquipmentService.RebuildUnitStats(u)
					u.currentHp = math.min(u.maxHp, (u.currentHp or 0) + (u.maxHp - before))
				end
				if dgRelics["RL-31"] then -- Withering Mist: lose 10% current HP (Boss 5%), never below 1
					local pct = if u.enemyType == "Boss" or u.isBoss then R.MistBossHpPct else R.MistHpPct
					u.currentHp = math.max(1, (u.currentHp or 0) - math.floor((u.currentHp or 0) * pct / 100))
				end
				if hexDebuff then StatusService.ApplyStatus(u, hexDebuff, "Relic") end
			end
			if range ~= 0 then
				-- Range never drops below 1 (RL-43 "min 1").
				u._dgRangeBonus = math.max(1 - (u.weaponMaxRange or 1), range)
			end
		end
		if hexDebuff then print(`[Main] Relic statuses: hex {tostring(hexDebuff)}`) end
	else
		for _, u in ipairs(allUnitsList) do
			if u.side == "Player" then
				u._dgDamageTakenMult, u._dgWeatherMult, u._dgEliteDmgMult, u._dgWardReady, u._dgSecondWind, u._dgBootsRt = nil, nil, nil, nil, nil, nil
			end
			u._dgStatBuff = nil -- EV-11 stamp (EV-16 mutator stamps retired 2026-11-15)
			u._dgStrRelic, u._dgApBonus, u._dgDealtMult, u._dgMoveBonus, u._dgDefMult, u._dgUndeadRelic = nil, nil, nil, nil, nil, nil -- RL-16..22
			u._dgRangeBonus, u._dgStabBonus, u._dgJumpAdd, u._dgBaseRtAdd, u._dgPrecBonus, u._dgImmune, u._dgKinMult, u._dgSkillRange, u._dgDiscBonus = nil, nil, nil, nil, nil, nil, nil, nil, nil -- RL-25..60
			u._dgCastMult, u._dgScholar = nil, nil -- RL-48 / RL-51 (relic step 2)
		end
	end
	return dgRelics, dgSecondWind
end

-- RL-64 Restless Dead (endless step 6, rule 282): +1 Grunt per stack (max +3) in NORMAL dungeon battles only
-- (not Elite / Boss rooms). Called by Main when the dungeon room quest is chosen, before enemies spawn.
function DungeonBattleHooks.ApplyRestlessDead(playerId: string, quest: any)
	if type(quest) ~= "table" or not quest.isDungeon or quest.dungeonPlayed ~= "Battle" then return end
	local n = math.min(DungeonRules.Data.Relic.RestlessMax, (DungeonService.CurseStacks and DungeonService.CurseStacks(playerId) or {})["RL-64"] or 0)
	if n <= 0 or type(quest.enemyTypes) ~= "table" then return end
	local grunt: any = nil
	for _, et in quest.enemyTypes do if et.type == "Grunt" then grunt = et break end end
	if grunt then grunt.count += n
	else table.insert(quest.enemyTypes, { type = "Grunt", level = quest.recommendedLvl or 1, count = n }) end
	quest.enemyCount = (tonumber(quest.enemyCount) or 0) + n
	print(`[Main] Restless Dead: +{n} enemy`)
end

-- Depth bonus for mid-battle enemy arrivals (reinforcements, a woken Mimic, event enemies).
do
	local okEG, EG = pcall(function() return require(Game:WaitForChild("EnemyGenerator")) end)
	if okEG and EG and EG.AddArrivalHook then EG.AddArrivalHook("depth", applyDepth) end
end

-- Expedition Fortune for this battle: base + RL-06 Lucky Charm. RL-45 Reaver's Pact no longer lowers
-- Fortune: it costs 35% silver instead (option A, USER RULINGS 2026-11-15 7:54 PM; DungeonSilver).
function DungeonBattleHooks.ApplyFortune(playerId: string, dungeonBattle: any, base: number)
	RewardService.SetExpeditionFortune(base
		+ (if dungeonBattle and DungeonService.HasRelic(playerId, "RL-06") then DungeonRules.Data.Relic.CharmFortune else 0)) -- RL-06 Lucky Charm (step 8)
end

-- After deployment. ctx = { dungeonBattle, relics, deployOrder, deployed, party }.
function DungeonBattleHooks.ApplyVanguard(ctx: any)
	local dungeonBattle, dgRelics, deployOrder, deployPlayerUnits, dungeonParty = ctx.dungeonBattle, ctx.relics, ctx.deployOrder, ctx.deployed, ctx.party
	-- Deployed party units only (fix 2026-11-15, was the whole party before deployment): RL-29 Blood Well HP,
	-- RL-28 Mana Well / RL-58 Hunger MP, RL-33 Lucky Totem buff, RL-30 Bottomless Satchel charges.
	if dungeonBattle then
		local R = DungeonRules.Data.Relic
		local totemBuff = if dgRelics["RL-33"] then R.TotemBuffs[Random.new():NextInteger(1, #R.TotemBuffs)] else nil
		if totemBuff then print(`[Main] Relic statuses: totem {tostring(totemBuff)}`) end
		for _, u in ipairs(deployPlayerUnits or {}) do
			if table.find(dungeonParty or {}, u.id) then
				if u.isAlive then
					if dgRelics["RL-29"] then u.currentHp = math.min(u.maxHp, (u.currentHp or 0) + math.floor((u.maxHp or 0) * R.BloodWellHpPct / 100)) end
					local mpPct = (if dgRelics["RL-28"] then R.ManaWellMpPct else 0) - (if dgRelics["RL-58"] then R.HungerMpPct else 0)
					if mpPct ~= 0 and (u.maxMp or 0) > 0 then
						u.currentMp = math.clamp((u.currentMp or 0) + math.floor(u.maxMp * mpPct / 100), 0, u.maxMp)
					end
					if totemBuff then StatusService.ApplyStatus(u, totemBuff, "Relic") end
				end
				if dgRelics["RL-30"] then
					for _, s in pairs(u.consumableSlots or {}) do
						if s and s.consumableId and (s.maxCharges or 0) > 0 then s.currentCharges = math.min(s.maxCharges, (s.currentCharges or 0) + R.BottomlessCharges) end
					end
				end
			end
		end
	end
	-- RL-42 Vanguard Oath (relic step 2): the first unit deployed this battle has +50% Max HP, battle only.
	-- Same no-free-heal path as Heartstone: the added HP is taken back at battle end (_dgHpBonusAdded).
	if dungeonBattle and dgRelics["RL-42"] and deployOrder[1] then
		for _, u in ipairs(deployPlayerUnits) do
			if u.id == deployOrder[1] and u.isAlive and table.find(dungeonParty or {}, u.id) then
				local before, start = u.maxHp or 0, u.currentHp or 0
				u.battleMaxHpBonusPct = (u.battleMaxHpBonusPct or 0) + DungeonRules.Data.Relic.VanguardHpPct / 100
				EquipmentService.RebuildUnitStats(u)
				u.currentHp = math.min(u.maxHp, start + math.max(0, u.maxHp - before))
				u._dgHpBonusAdded = (u._dgHpBonusAdded or 0) + (u.currentHp - start)
				if BattleVisualBroadcaster.UnitStateChanged then BattleVisualBroadcaster.UnitStateChanged(u, "Relic") end
				print(`[Main] Vanguard Oath | {u.name} Max HP {before} -> {u.maxHp}`)
				break
			end
		end
	end
end

-- After map objects are seeded. ctx = { dungeonBattle, relics, state, map, mapWidth, mapHeight }.
function DungeonBattleHooks.ApplyMapRelics(ctx: any)
	local dungeonBattle, dgRelics, state, generatedMap, MAP_WIDTH, MAP_HEIGHT = ctx.dungeonBattle, ctx.relics, ctx.state, ctx.map, ctx.mapWidth, ctx.mapHeight
	-- RL-23 Prospector's Map / RL-24 Mimic's Bargain (relic step 2, dungeon only). Seeded from the map seed.
	-- The extra chest uses the normal chest reward path: the growing drop rate never multiplies it (rule 271).
	if dungeonBattle and (dgRelics["RL-23"] or dgRelics["RL-24"]) then
		local okP, errP = pcall(function()
			local prng = Random.new((((generatedMap and generatedMap.seed) or 0) + 70607) % 2147483647)
			if dgRelics["RL-23"] then
				local taken: { [number]: boolean } = {}
				for _, o in ipairs(state.objects) do taken[o.y * 100000 + o.x] = true end
				for _, u in ipairs(state.units or {}) do if u.isAlive and u.tileX then taken[u.tileY * 100000 + u.tileX] = true end end
				for _, z in { generatedMap.deploymentZones and generatedMap.deploymentZones.player, generatedMap.deploymentZones and generatedMap.deploymentZones.enemy } do
					for _, a in ipairs(z or {}) do if a.x and a.y then taken[a.y * 100000 + a.x] = true end end
				end
				local function open(x: number, y: number): boolean
					if x < 1 or y < 1 or x > MAP_WIDTH or y > MAP_HEIGHT or taken[y * 100000 + x] then return false end
					local tid = generatedMap.terrainGrid and generatedMap.terrainGrid[y] and generatedMap.terrainGrid[y][x]
					local td = tid and TerrainData.Types[tid]
					return td ~= nil and td.passable ~= false
				end
				-- A neighbour only counts if a base-Jump unit can step between it and the chest tile
				-- (same elevation rule as TargetingService: |height step| <= Jump; base Jump = 1).
				local function reach(x: number, y: number, nx: number, ny: number): boolean
					return open(nx, ny) and math.abs(GameConstants.GetElevation(nx, ny) - GameConstants.GetElevation(x, y)) <= 1
				end
				local cands: { any } = {}
				for y = 1, MAP_HEIGHT do
					for x = 1, MAP_WIDTH do
						-- Open ground only (3+ of 4 neighbours open AND reachable), so the solid chest never plugs a 1-wide lane.
						if open(x, y) then
							local n = (if reach(x, y, x + 1, y) then 1 else 0) + (if reach(x, y, x - 1, y) then 1 else 0) + (if reach(x, y, x, y + 1) then 1 else 0) + (if reach(x, y, x, y - 1) then 1 else 0)
							if n >= 3 then table.insert(cands, { x = x, y = y }) end
						end
					end
				end
				if #cands > 0 then
					local c = cands[prng:NextInteger(1, #cands)]
					local inst: any = ObjectEffectService.PlaceObjectInstance(state, "Treasure Chest", c.x, c.y)
					if inst then inst.spawned = nil; inst.relicChest = true end -- counts as a map chest (Salvager etc.)
					print(`[Main] Prospector's Map | extra chest at ({c.x},{c.y}) {inst and "placed" or "refused"}`)
				else
					warn("[Main] Prospector's Map: no free tile for the extra chest")
				end
			end
			if dgRelics["RL-24"] then
				local chests: { any } = {}
				for _, o in ipairs(state.objects) do if o.type == "Treasure Chest" and not o.hidden then table.insert(chests, o) end end
				if #chests > 0 then
					local o = chests[prng:NextInteger(1, #chests)]
					o.type = "Mimic" -- disguised as a Treasure Chest until woken (ObjectEffectService.DISGUISES)
					ObjectEffectService.InitObjectHp(state) -- battle start: re-seed hp so the Mimic gets its own durability
					if GameConstants.OBJECT_MAP and GameConstants.OBJECT_MAP[o.y] then GameConstants.OBJECT_MAP[o.y][o.x] = "Mimic" end
					for _, b in ipairs(GameConstants.BLOCKERS or {}) do if b.tileX == o.x and b.tileY == o.y then b.objectType = "Mimic" end end
					print(`[Main] Mimic's Bargain | chest at ({o.x},{o.y}) is a Mimic`)
				end
			end
		end)
		if not okP then warn("[Main] Prospector/Mimic relic failed: " .. tostring(errP)) end
		-- Re-send the inspector's map data so the RL-23 chest is listed (display types only: Mimic stays a chest).
		local okS, errS = pcall(function()
			local _og, _bl = ObjectEffectService.SanitizeMapSync(GameConstants.OBJECT_MAP, GameConstants.BLOCKERS)
			BattleEvents.MapDataSync:FireAllClients({
				terrainGrid = generatedMap.terrainGrid, elevationGrid = generatedMap.elevationGrid,
				objectGrid = _og, blockers = _bl, mapWidth = MAP_WIDTH, mapHeight = MAP_HEIGHT,
			})
		end)
		if not okS then warn("[Main] Prospector/Mimic map re-sync failed: " .. tostring(errS)) end
	end
end

-- Before any post-battle credit: what the player had, so this battle's pay can be moved into the run bag.
function DungeonBattleHooks.SnapshotLoot(PLAYER_ID: string, isDungeonBattle: boolean, cardInventory: any): (any, { [string]: boolean }, any)
	local dgBalanceBefore: any = if isDungeonBattle then CurrencyService.GetBalance(PLAYER_ID) else nil
	local dgItemsBefore: { [string]: boolean } = {}
	local dgCardsBefore: any = nil
	if isDungeonBattle then
		for id in pairs(InventoryService.ExportInventory(PLAYER_ID)) do dgItemsBefore[id] = true end
		dgCardsBefore = { skillCards = table.clone(cardInventory.skillCards), augmentCards = table.clone(cardInventory.augmentCards),
			consumables = table.clone(cardInventory.consumables) }
	end
	return dgBalanceBefore, dgItemsBefore, dgCardsBefore
end

-- Dungeon party units that sat out this battle (silver step 1 fix 2026-11-15). ApplyBattleStart stamps the
-- whole party BEFORE deployment, and undeployed units are then removed from the battle list, so their
-- stamps (incl. the RL-01 / RL-15 / RL-46 Max HP bonus) were never cleared: the base rebuild then kept the
-- bonus Max HP and gave the bonus HP for free. Passed to ClearBattleEndStamps so they are cleared too.
function DungeonBattleHooks.BenchedParty(dungeonBattle: any, party: any, allUnitsList: { any }, playerUnits: any): { any }
	local out: { any } = {}
	if not dungeonBattle then return out end
	local inBattle: { [any]: boolean } = {}
	for _, u in ipairs(allUnitsList) do inBattle[u] = true end
	for _, id in ipairs(party or {}) do
		local u = playerUnits[id]
		if u and not inBattle[u] then table.insert(out, u) end
	end
	return out
end

-- Before HP/MP are saved: drop the battle-only stamps and take back the relic Max HP bonus.
-- benched (optional): BenchedParty() units, cleared the same way.
function DungeonBattleHooks.ClearBattleEndStamps(battleUnits: { any }, benched: { any }?)
	local allUnitsList: { any } = battleUnits
	if benched and #benched > 0 then
		allUnitsList = table.clone(battleUnits)
		for _, u in benched do table.insert(allUnitsList, u) end
	end
	-- EV-11 battle-only stamp (stages build 2026-11-15) is dropped before HP/MP are saved.
	for _, u in ipairs(allUnitsList) do
		if u._dgStatBuff or u._dgStrRelic or u._dgSkillRange or u._dgDiscBonus then
			u._dgStatBuff = nil
			u._dgStrRelic = nil -- RL-16 Ogre's Belt is battle-only too (2026-11-15)
			u._dgSkillRange, u._dgDiscBonus = nil, nil -- RL-27 / RL-56 (relics v2)
			if u.side == "Player" then EquipmentService.RebuildUnitStats(u) end
		end
		u._dgApBonus, u._dgDealtMult, u._dgMoveBonus, u._dgDefMult, u._dgUndeadRelic = nil, nil, nil, nil, nil
		u._dgRangeBonus, u._dgStabBonus, u._dgJumpAdd, u._dgBaseRtAdd, u._dgPrecBonus, u._dgImmune, u._dgKinMult = nil, nil, nil, nil, nil, nil, nil -- RL-25..60
		u._dgCastMult, u._dgScholar = nil, nil -- RL-48 / RL-51 (relic step 2)
	end
	-- Dungeon relics (step 8): the battle-only Max HP bonus (RL-01 / RL-15) is dropped before HP is saved.
	for _, u in ipairs(allUnitsList) do
		if u.battleMaxHpBonusPct then
			local liveHp = u.currentHp or 0 -- before the rebuild caps it at the normal max
			u.battleMaxHpBonusPct = nil
			EquipmentService.RebuildUnitStats(u)
			-- Take back the HP the bonus added at battle start (fix 2026-11-15): KO stays KO, alive floors at 1.
			local added = u._dgHpBonusAdded or 0
			u._dgHpBonusAdded = nil
			if added ~= 0 and u.isAlive and liveHp > 0 then -- added < 0: RL-46 Glass Crown HP given back
				u.currentHp = math.clamp(liveHp - added, 1, u.maxHp or 1)
			end
		end
	end
end

-- After HP is saved. ctx = { playerId, isDungeonBattle, isQualifyingVictory, secondWind, party, playerUnits }.
function DungeonBattleHooks.ApplyAfterWin(ctx: any)
	local PLAYER_ID, isDungeonBattle, isQualifyingVictory, dgSecondWind, dungeonParty, playerUnits = ctx.playerId, ctx.isDungeonBattle, ctx.isQualifyingVictory, ctx.secondWind, ctx.party, ctx.playerUnits
	-- Dungeon relics after a WON dungeon battle (step 8, rule 271): RL-09 used up if it fired; RL-11 Mana
	-- Font +10% Max MP to the party; RL-12 Field Medic's Kit +15% Max HP to the living party unit with the
	-- lowest HP (ties: first in party order). Persistent state only, before KO clearing / recovery skip.
	if isDungeonBattle then
		if dgSecondWind and dgSecondWind.used then DungeonService.MarkRelicUsed(PLAYER_ID, "RL-09") end
		if isQualifyingVictory then
			local R = DungeonRules.Data.Relic
			if DungeonService.HasRelic(PLAYER_ID, "RL-11") then
				for _, id in ipairs(dungeonParty or {}) do
					local ps: any = PersistentStateService.GetUnitState(PLAYER_ID, id)
					if ps and not ps.isKO then ps.currentMp = math.min(ps.maxMp, ps.currentMp + math.ceil(ps.maxMp * R.FontMpPct / 100)) end
				end
			end
			if DungeonService.HasRelic(PLAYER_ID, "RL-12") then
				local low: any, lowHp: number = nil, math.huge
				for _, id in ipairs(dungeonParty or {}) do
					local ps: any = PersistentStateService.GetUnitState(PLAYER_ID, id)
					if ps and not ps.isKO and ps.currentHp < ps.maxHp and ps.currentHp < lowHp then low, lowHp = ps, ps.currentHp end
				end
				if low then low.currentHp = math.min(low.maxHp, low.currentHp + math.ceil(low.maxHp * R.MedicHpPct / 100)) end
			end
			for _, id in ipairs(dungeonParty or {}) do
				local u: any, ps: any = playerUnits[id], PersistentStateService.GetUnitState(PLAYER_ID, id)
				if u and ps then u.currentHp = math.min(ps.currentHp, u.maxHp or ps.currentHp); u.currentMp = math.min(ps.currentMp, u.maxMp or ps.currentMp) end
			end
		end
	end
end

-- After ApplyAfterWin. ctx = { playerId, isDungeonBattle, isQualifyingVictory, party, units, playerUnits }.
-- BENCH RECOVERY (USER RULINGS 2026-11-15 7:54 PM, project_rules 280; silver step 1): after a WON dungeon
-- battle, party units that were NOT deployed recover 15% of Max HP and Max MP (rounded up, capped at full).
-- KO units stay KO. Units sent home are not in the party. A unit brought in at a Rest / stage start is
-- not bench-ready until it has been in the party for one battle. Nothing after a wipeout (the run ends).
-- Deployed = player roster units still in the battle list (undeployed ones are removed at deploy).
function DungeonBattleHooks.ApplyBenchRecovery(ctx: any)
	if not ctx.isDungeonBattle then return end
	local ready: any = DungeonService.BenchReady(ctx.playerId)
	if not ready then return end
	local party: { string } = ctx.party or {}
	if ctx.isQualifyingVictory then
		local deployed: { [string]: boolean } = {}
		for _, u in ipairs(ctx.units or {}) do
			if u.side == "Player" and ctx.playerUnits[u.id] then deployed[u.id] = true end
		end
		local pct = DungeonRules.Data.BenchRecoveryPct
		for _, id in ipairs(party) do
			if not deployed[id] and ready[id] then
				local ps: any = PersistentStateService.GetUnitState(ctx.playerId, id)
				if ps and not ps.isKO and (ps.currentHp < ps.maxHp or ps.currentMp < ps.maxMp) then -- full units: nothing to do
					local hp0, mp0 = ps.currentHp, ps.currentMp
					ps.currentHp = math.min(ps.maxHp, ps.currentHp + math.ceil(ps.maxHp * pct / 100))
					ps.currentMp = math.min(ps.maxMp, ps.currentMp + math.ceil(ps.maxMp * pct / 100))
					local u: any = ctx.playerUnits[id]
					if u then u.currentHp = math.min(ps.currentHp, u.maxHp or ps.currentHp); u.currentMp = math.min(ps.currentMp, u.maxMp or ps.currentMp) end
					print(`[DungeonBattleHooks] Bench recovery | {u and u.name or id} HP {hp0} -> {ps.currentHp}/{ps.maxHp}, MP {mp0} -> {ps.currentMp}/{ps.maxMp}`)
				end
			end
		end
	end
	for _, id in ipairs(party) do ready[id] = true end -- everyone in the party now has a battle behind them
end

-- After rewards. ctx = { playerId, isDungeonBattle, quest, isQualifyingVictory, balanceBefore, itemsBefore, cardsBefore, bossFixed, cardInventory }.
function DungeonBattleHooks.CollectRunBag(ctx: any)
	local PLAYER_ID, isDungeonBattle, activeQuest, isQualifyingVictory = ctx.playerId, ctx.isDungeonBattle, ctx.quest, ctx.isQualifyingVictory
	local dgBalanceBefore, dgItemsBefore, dgCardsBefore, dgBossFixed, cardInventory = ctx.balanceBefore, ctx.itemsBefore, ctx.cardsBefore, ctx.bossFixed, ctx.cardInventory
	-- DUNGEON RUN BAG (build step 3; project_rules 263/264). Everything this room battle paid (gold,
	-- materials, gear, cards) comes back out of the balance / inventory into the run bag, to be
	-- kept or lost when the run ends (paid out in step 4). Unit EXP was granted above and is always
	-- kept. Materials: Normal room = normalMats, Elite room = eliteMats, Boss room = bossMats
	-- (x the growing multiplier; gold, normal and Elite materials are not multiplied).
	if isDungeonBattle then
		local okBag, errBag = pcall(function()
			local after: any = CurrencyService.GetBalance(PLAYER_ID)
			local gold = math.max(0, (after.gold or 0) - (dgBalanceBefore.gold or 0))
			local mats = DungeonService.MaterialDelta(dgBalanceBefore, after)
			local cost: any = { gold = gold, gems = {} }
			for k, v in pairs(mats) do
				if k == "mercury" or k == "crystals" or k == "sulfur" then cost[k] = v
				else cost.gems[string.sub(k, 5)] = v end
			end
			CurrencyService.Debit(PLAYER_ID, cost)
			if gold > 0 then DungeonService.AddLoot(PLAYER_ID, "gold", gold) end
			local played = activeQuest.dungeonPlayed
			local kind = if played == "Boss" then "bossMats" elseif played == "Elite" then "eliteMats" else "normalMats"
			local mult = if kind == "bossMats" then (tonumber(activeQuest.dungeonDropMult) or 1) else 1
			for k, v in pairs(mats) do
				-- The boss grant (3 mercury, 5 crystals, sulfur, 1 rune gem) is a fixed reward: x1.
				local fixed = 0
				if kind == "bossMats" and dgBossFixed then
					fixed = if k == "gem:" .. tostring(dgBossFixed.gem) then 1 else (tonumber(dgBossFixed[k]) or 0)
					fixed = math.min(fixed, v)
					if fixed > 0 then DungeonService.AddLoot(PLAYER_ID, kind, k, fixed) end
					v -= fixed
				end
				-- Same rounding as the gear rolls: the fraction is a chance of one more (project_rules 263).
				local want = v * mult
				local q = math.floor(want) + (if mult ~= 1 and Random.new():NextNumber() < want % 1 then 1 else 0)
				if q > 0 then DungeonService.AddLoot(PLAYER_ID, kind, k, q) end
			end
			local moved = 0
			for id, item in pairs(InventoryService.ExportInventory(PLAYER_ID)) do
				if not dgItemsBefore[id] then
					InventoryService.RemoveItem(PLAYER_ID, id)
					DungeonService.AddLoot(PLAYER_ID, "gearItem", item)
					moved += 1
				end
			end
			local cardsMoved = 0
			for _, cat in ipairs({ "skillCards", "augmentCards", "consumables" }) do
				for id, q in pairs(cardInventory[cat]) do
					local gain = (tonumber(q) or 0) - (tonumber(dgCardsBefore[cat][id]) or 0)
					if gain > 0 then
						local left = q - gain
						cardInventory[cat][id] = if left > 0 then left else nil
						DungeonService.AddLoot(PLAYER_ID, "cards", cat .. ":" .. tostring(id), gain)
						cardsMoved += gain
					end
				end
			end
			print(string.format("[PostBattle] Dungeon bag +%d gold, %d gear, %d card(s), materials -> %s (x%.2f)",
				gold, moved, cardsMoved, kind, mult))
			if isQualifyingVictory then
				local okC, res = DungeonService.MarkNodeCleared(PLAYER_ID, activeQuest.dungeonNodeId)
				if not okC then warn("[PostBattle] Dungeon room not marked cleared: " .. tostring(res)) end
				if okC then DungeonService.EarnSilver(PLAYER_ID, activeQuest.dungeonPlayed) end -- silver (rule 278): before any run end, so the Boss pays too
				-- Stages (rule 277): a stage boss waits for Go deeper / Go home; the last allowed stage boss
				-- ends the run, all loot home (project_rules 264).
				if okC and activeQuest.dungeonPlayed == "Boss" then
					local okE, out = DungeonService.OnBossWin(PLAYER_ID)
					if okE then DungeonRemotes.SetLastResult(out)
					else warn("[PostBattle] Dungeon boss end not recorded: " .. tostring(out)) end
				end
			elseif ctx.escaped == true then
				-- In-battle Escape (project_rules 285 O6 / 264, 2026-11-18): the dungeon's early Escape.
				-- The run fails, the whole Bag is lost; EXP, 75% of the run gold and normal materials kept.
				local okX, resX = DungeonService.EndRun(PLAYER_ID, "EarlyEscape")
				if not okX then
					-- e.g. the run waits on a full-Bag pick (rule 279): end it as a wipeout instead.
					warn("[PostBattle] Dungeon early escape refused (" .. tostring(resX) .. "): ending as a wipeout")
					okX, resX = DungeonService.EndRun(PLAYER_ID, "Wipeout")
				end
				if okX then DungeonRemotes.SetLastResult(resX)
				else warn("[PostBattle] Dungeon escape not recorded: " .. tostring(resX)) end
			else
				-- Full party KO: the run ends as a wipeout. Paid out in step 4.
				local okW, res = DungeonService.EndRun(PLAYER_ID, "Wipeout")
				if okW then DungeonRemotes.SetLastResult(res)
				else warn("[PostBattle] Dungeon wipeout not recorded: " .. tostring(res)) end
			end
		end)
		if not okBag then warn("[PostBattle] Dungeon run bag failed: " .. tostring(errBag)) end
	end
end

return DungeonBattleHooks

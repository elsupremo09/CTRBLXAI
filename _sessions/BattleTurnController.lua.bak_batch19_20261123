-- In-battle Escape (project_rules 285 O2, 2026-11-18): true only while a player unit's turn prompt
-- is open (inside waitForPlayerCommand). Not during animations, the enemy turn, or the facing /
-- tile / steal / choice pickers (those run after the command arrived, when _previewUnit is nil).
function BattleTurnController.IsAwaitingPlayerCommand(): boolean
	return _previewUnit ~= nil and _previewUnit.side == "Player" and _previewUnit.isAlive == true
end

-- Battle already decided (dev Instant Win/Lose sets the phase straight to BattleOver, 2026-11-09).
-- The player prompt waits below (facing, siege direction/tile, steal and choice lists) have no
-- timeout by design, so they also stop once this is true; otherwise the battle never reached
-- Victory/Defeat while a player prompt was open. Normal play never ends a battle mid-prompt.
local function battleDecided(): boolean
	return state ~= nil and BattleCoordinator.GetPhase(state) == "BattleOver"
end

local function checkChannelInterrupt(unit, statusId)
	if unit.isChanneling and StatusService.IsChannelDisruptor(statusId) then
		-- Activation phase is uninterruptible (2026-10-07): InterruptChanneling
		-- returns false then, and the channel visual must keep running.
		if BattleCoordinator.InterruptChanneling(unit, statusId .. " applied") then
			BattleVisualBroadcaster.ChannelEnded(unit)
			BattleVisualBroadcaster.Log("channel", `{unit.name}\'s channel is interrupted by {statusId}.`, unit.id)
			return true
		end
	end
	return false
end


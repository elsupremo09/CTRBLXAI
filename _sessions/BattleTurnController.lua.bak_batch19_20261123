-- Steal slot pick (2026-10-24): prompt-and-wait like promptTargetTile. Fires the
-- server-authored list of the target's stealable slots to the player and blocks until
-- they tap one; validates the reply against that list. Single-player (first player).
local function promptStealSlot(unit, target, slots)
	local playerObj = Players:GetPlayers()[1]
	if not playerObj then return slots[1] end
	BattleEvents.StealPrompt:FireClient(playerObj, {
		casterId = unit.id, targetId = target.id, targetName = target.name, slots = slots,
	})
	local chosen, responded = nil, false
	local conn
	conn = BattleEvents.StealChoice.OnServerEvent:Connect(function(player, data)
		if player == playerObj and data and data.casterId == unit.id then
			for _, legal in ipairs(slots) do
				if legal == data.slot then chosen = data.slot break end
			end
			if chosen then responded = true end
		end
	end)
	while not responded and not battleDecided() do task.wait(0.1) end
	if conn then conn:Disconnect() end
	return chosen  -- nil when the battle ended first: callers treat it as no pick
end

-- Object choice pick (2026-11-06, Forge: Ballista / Catapult / Cancel). Reuses the steal pick
-- list (StealPrompt with a title -> StealChoice), the same way the Quartermaster list does.
-- The reply is accepted only if it is one of the offered options (SEC-001). Single-player.
local function promptObjectChoice(unit, title, options)
	local playerObj = Players:GetPlayers()[1]
	if not playerObj or type(options) ~= "table" or #options == 0 then return nil end
	BattleEvents.StealPrompt:FireClient(playerObj, {
		casterId = unit.id, targetId = unit.id, targetName = unit.name, slots = options, title = title,
	})
	local chosen, responded = nil, false
	local conn
	conn = BattleEvents.StealChoice.OnServerEvent:Connect(function(player, data)
		if player == playerObj and type(data) == "table" and data.casterId == unit.id then
			for _, legal in ipairs(options) do
				if legal == data.slot then chosen = legal break end
			end
			if chosen then responded = true end
		end
	end)
	while not responded and not battleDecided() do task.wait(0.1) end
	if conn then conn:Disconnect() end
	return chosen  -- nil when the battle ended first: callers treat it as no pick
end
if ObjectEffectService.SetChoicePrompter then
	ObjectEffectService.SetChoicePrompter(promptObjectChoice)
end

local function executePlayerCommand(unit, command)
	local actionType = command.actionType

	if actionType == "Wait" then
		-- Player forfeits remaining AP — offer facing choice
		promptPlayerFacing(unit, Players:GetPlayers()[1])
		CommandService.ValidateAndCommit(state, unit.id, "Wait", nil)
		return { actionType = "Wait", unit = unit }
	end

	if actionType == "Guard" then
		local ok, reason = CommandService.ValidateAndCommit(state, unit.id, "Guard", nil)
		if ok then
			-- Rule 257 (2026-11-10): offer the facing choice ONLY when this Guard ends the turn, i.e. the
			-- runPlayerTurn loop will not ask this unit for another command (same test as its loop condition).
			-- AP, a Quick Draw or a free Push still left: no prompt, the unit keeps acting.
			local turnContinues = BattleCoordinator.GetPhase(state) == "TurnOpen"
				and ((unit.currentAp or 0) > 0 or CommandService.IsQuickDrawReady(unit) or CommandService.IsFreePushReady(unit))
			if not turnContinues and unit.isAlive then
				promptPlayerFacing(unit, Players:GetPlayers()[1])
			end
			return { actionType = "Guard", unit = unit }
		else
			warn("[Main] Guard rejected: " .. (reason or "unknown"))
			return nil
		end
	end

	if actionType == "Undo" then
		-- Reverse the most recent reversible Move/Guard (server-authoritative).
		-- On success we return nil so the turn loop simply re-prompts the SAME
		-- unit — AP, RT and the action menu all refresh from the fresh prompt,
		-- exactly like the rejected-command path. The reversal's own visual
		-- broadcasts (UnitMoved / StatusExpired / UnitStateChanged) already fired
		-- inside UndoLastAction, so there is no action to append or broadcast here.
		local ok, reason = CommandService.UndoLastAction(state, unit.id)
		if not ok then
			warn("[Main] Undo rejected: " .. (reason or "unknown"))
		end
		return nil
	end

	if actionType == "Push" then
		-- OBS Phase 2c-E2: object push (targetId "obj:x,y") routes to the object path;
		-- the unit push below is byte-unchanged.
		if type(command.targetId) == "string" and string.sub(command.targetId, 1, 4) == "obj:" then
			local sx, sy = string.match(command.targetId, "^obj:(%-?%d+),(%-?%d+)$")
			local ox, oy = tonumber(sx), tonumber(sy)
			if not (ox and oy) then warn("[Main] Object push: bad target id"); return nil end
			local ok, reason = CommandService.ValidateAndCommit(state, unit.id, "PushObject", { objX = ox, objY = oy })
			if ok and CommandService.WasActionVoided(unit) then return nil end  -- BUG-132: lethal Wounded, no push
			if ok then
				return { actionType = "Push", unit = unit, objectPush = true }
			else
				warn("[Main] Object push rejected: " .. (reason or "unknown"))
				return nil
			end
		end
		-- Find the target unit by ID
		local target = nil
		for _, u in ipairs(state.units) do
			if u.id == command.targetId then target = u; break end
		end
		if not target then
			warn("[Main] Push: target not found")
			return nil
		end
		local oldTargetX, oldTargetY = target.tileX, target.tileY
		-- Distance control: player may request a stop distance (1..max). nil = full (legacy).
		local pushSelection = { target = target, pushDistance = command.pushDistance }
		-- GL-013 Vector Gloves: chosen direction (validated server-side in CommandService).
		if type(command.pushDirX) == "number" and type(command.pushDirY) == "number" then
			pushSelection.pushDir = { dx = command.pushDirX, dy = command.pushDirY }
		end
		local ok, reason = CommandService.ValidateAndCommit(state, unit.id, "Push", pushSelection)
		if ok and CommandService.WasActionVoided(unit) then return nil end  -- BUG-132: lethal Wounded, no push
		if ok then
			return { actionType = "Push", unit = unit, target = target,
				oldTargetX = oldTargetX, oldTargetY = oldTargetY }
		else
			warn("[Main] Push rejected: " .. (reason or "unknown"))
			return nil
		end
	end

	if actionType == "Interact" then
		-- INTERACT (Slice 4 framework). Client sends { actionType="Interact",
		-- interactKind, targetId (unit) | objectId (map object) }. The command
		-- service re-validates the candidate and dispatches the native effect.
		local selection = {
			interactKind = command.interactKind,
			targetId     = command.targetId,
			objectId     = command.objectId,
			tileX        = tonumber(command.tileX),  -- tile targets (HD-014, 2026-10-29)
			tileY        = tonumber(command.tileY),
		}
		-- Capture pre-state for the apply side (recruit flips side → occupancy
		-- label must refresh, like Push updates occupancy after displacement).
		local tgt = nil
		if command.targetId then
			for _, u in ipairs(state.units) do
				if u.id == command.targetId then tgt = u; break end
			end
		end
		local oldSide = tgt and tgt.side or nil
		local ok, reason = CommandService.ValidateAndCommit(state, unit.id, "Interact", selection)
		if ok and CommandService.WasActionVoided(unit) then return nil end  -- BUG-132: lethal Wounded, no interact
		if ok then
			return {
				actionType   = "Interact",
				unit         = unit,
				target       = tgt,
				interactKind = command.interactKind,
				oldSide      = oldSide,
			}
		else
			warn("[Main] Interact rejected: " .. (reason or "unknown"))
			return nil
		end
	end

	if actionType == "Move" then
		local selection = { tileX = command.tileX, tileY = command.tileY, pathCost = command.pathCost }
		local oldX, oldY = unit.tileX, unit.tileY
		local ok, reason = CommandService.ValidateAndCommit(state, unit.id, "Move", selection)
		if ok then
			return { actionType = "Move", unit = unit, oldTileX = oldX, oldTileY = oldY }
		else
			warn("[Main] Player move rejected: " .. (reason or "unknown"))
			return nil
		end
	end

	if actionType == "Attack" then
		-- OBS Phase 2c-B: object attack (targetId "obj:x,y") routes to the object path;
		-- the unit attack below is byte-unchanged.
		if type(command.targetId) == "string" and string.sub(command.targetId, 1, 4) == "obj:" then
			local sx, sy = string.match(command.targetId, "^obj:(%-?%d+),(%-?%d+)$")
			local ox, oy = tonumber(sx), tonumber(sy)
			if not (ox and oy) then warn("[Main] Object attack: bad target id"); return nil end
			local ok, reason = CommandService.ValidateAndCommit(state, unit.id, "AttackObject", { objX = ox, objY = oy })
			if ok and CommandService.WasActionVoided(unit) then return nil end  -- BUG-132: lethal Wounded, no attack
			if ok then
				return { actionType = "Attack", unit = unit, objectAttack = true }
			else
				-- BUG-085: no [Main] warn here; CommandService.ValidateAndCommit already logs
				-- "[CommandService] Attack rejected: <reason>" once for Attack / AttackObject (LOG-001).
				return nil
			end
		end
		-- Find the target unit by ID
		local target = nil
		for _, u in ipairs(state.units) do
			if u.id == command.targetId then
				target = u
				break
			end
		end
		if not target then
			warn("[Main] Player attack: target not found")
			return nil
		end

		local hpBefore = target.currentHp
		local rtBefore = target.remainingRt
		local _stBefore = takeStatusSnapshot(target)  -- BUG-185: what the attack really applies
		local _revivesBefore = target._reviveCount or 0  -- BUG-143: KO + revive inside this attack
		local _aliveBefore = target.isAlive == true
		clearStatCapLoss()  -- BUG-219
		local ok, reason = CommandService.ValidateAndCommit(state, unit.id, "Attack", target)
		if ok and CommandService.WasActionVoided(unit) then return nil end  -- BUG-126: lethal Wounded, no attack
		if ok then
			-- BUG-185 (batch 15): only a status this attack really applied (shared rule). "+Sleep" was shown on a
			-- unit the log had just called immune to Sleep (count of instances, last one).
			local newStatus = newlyAppliedStatus(target, _stBefore, nil, unit.id)
			local rtAdded = target.remainingRt - rtBefore
			-- BUG-143 (BUG-HUNT-15): knocked out and revived in the same commit (Rescue Beacon) = the hit took
			-- all of hpBefore and the KO is logged, then the revive line; it is not a negative-damage hit.
			local _revivedHere = _aliveBefore and (target._reviveCount or 0) ~= _revivesBefore
			-- BUG-219 (Tester W1): HP lost to a Max HP cap (a stat status this attack applied) is not hit damage.
			local _atkDmg = hpBefore - target.currentHp
			if (target._statCapLoss or 0) > 0 then _atkDmg = math.max(0, _atkDmg - target._statCapLoss) end
			clearStatCapLoss()
			return {
				actionType    = "Attack",
				unit          = unit,
				target        = target,
				damage        = if _revivedHere then hpBefore else _atkDmg,
				statusApplied = newStatus,
				rtDelay       = rtAdded > 0 and rtAdded or nil,
				targetHpAfter = if _revivedHere then 0 else nil,
				targetKoHere  = if _revivedHere then true else nil,
				revivedHere   = if _revivedHere then true else nil,
			}
		else
			-- BUG-085: no [Main] warn here; CommandService.ValidateAndCommit already logs
			-- "[CommandService] Attack rejected: <reason>" once for Attack / AttackObject (LOG-001).
			return nil
		end
	end

	if actionType == "Skill" then
		local target = nil
		local skillDef = CommandService.GetSkill(command.skillId)
		if not skillDef then
			warn("[Main] Player skill: unknown skill " .. tostring(command.skillId))
			return nil
		end
		local _tr = skillDef.targetRules or "Enemy Unit"

		if command.tileX and command.tileY and not command.targetId then
			-- All-tile widening (Option A, 2026-10-24): a widened skill clicked on a
			-- tile resolves against the tile's OCCUPANT when one is present (living,
			-- non-hidden), so damage/heal + terrain reaction run through the normal
			-- unit path. Hidden occupants are not targetable (Hide protects). An empty
			-- tile falls through to the ground marker (terrain reaction fires in the
			-- CommandService ground branch).
			if TargetingService.IsWidenedSkill(skillDef) then
				for _, u in ipairs(state.units) do
					if u.isAlive and u.tileX == command.tileX and u.tileY == command.tileY
						and not StatusService.HasStatus(u, "Hide") then
						target = u
						break
					end
				end
			end
			if not target then
				-- Ground targeting: create a virtual target with tile coords
				target = {
					tileX = command.tileX,
					tileY = command.tileY,
					isGroundTarget = true,
					isAlive = true,
					name = string.format("Ground(%d,%d)", command.tileX, command.tileY),
					id = "_ground_" .. command.tileX .. "_" .. command.tileY,
				}
				print(string.format("[Main] Skill ground target: (%d,%d)", command.tileX, command.tileY))
			end
		else
			-- Unit targeting: find by ID
			for _, u in ipairs(state.units) do
				if u.id == command.targetId then
					target = u
					break
				end
			end
		end
		if not target then
			warn("[Main] Player skill: target not found (targetId=" .. tostring(command.targetId) .. ")")
			return nil
		end

		-- Snapshot ALL units' HP/RT before commit (for AOE detection)
		local hpSnapshot = {}
		local rtSnapshot = {}
		local statusSnapshot = {}
		local burnSnapshot = {}
		local reviveSnapshot = {}  -- BUG-143: revive counter, alive units only (KO + revive in this cast)
		for _, u in ipairs(state.units) do
			hpSnapshot[u.id] = u.currentHp
			rtSnapshot[u.id] = u.remainingRt
			statusSnapshot[u.id] = takeStatusSnapshot(u)  -- BUG-185: instances + stamps, not a count
			if u.isAlive then
				reviveSnapshot[u.id] = u._reviveCount or 0
			end
			-- Snapshot burn stored value for accumulation detection
			local burnInst = StatusService.HasStatus(u, "Burn")
			burnSnapshot[u.id] = burnInst and burnInst.storedBurn or 0
		end

		-- Steal (SKL-STEAL) slot pick (2026-10-24): ask which non-weapon piece to take
		-- before committing (server-authored list of the target's stealable slots). The
		-- chosen slot rides on the selection into ValidateAndCommit and onto the channel.
		local stealSlot = nil
		if command.skillId == "SKL-STEAL" then
			local sslots = GameConstants.GetStealableSlots(target)
			if #sslots == 0 then return end
			stealSlot = promptStealSlot(unit, target, sslots)
			if not stealSlot then return end
		end
		local selection = { target = target, skillId = command.skillId, stealSlot = stealSlot }

		-- BUG-139 (BUG-HUNT-08): record which units this skill really hit (CombatResolver.ApplyOutcome),
		-- so side effects of the cast (a set-off Land Mine / explosion chain / Collapse) are not listed
		-- as hits of the skill below.
		clearStatCapLoss()  -- BUG-219
		CombatResolver.BeginHitCapture()
		-- BUG-146 (Tester batch 10 A2): the commit runs in pcall so the hit capture is ALWAYS closed, even when
		-- the commit throws (an open capture would keep recording every later ApplyOutcome). The error is then
		-- raised again unchanged (level 0 = original message), so callers see the same failure as before.
		local _commitOk, ok, reason = pcall(CommandService.ValidateAndCommit, state, unit.id, "Skill", selection)
		local _skillHitIds = CombatResolver.EndHitCapture()
		if not _commitOk then
			BattleVisualBroadcaster.HoldPushes(false)  -- BUG-152 (A5): never leave pushes held on a re-raise
			error(ok, 0)
		end
		if ok and CommandService.WasActionVoided(unit) then return nil end  -- BUG-126: lethal Wounded, no cast
		if ok then
			-- Detect ALL units that were affected (for AOE skills)
			local results = {}
			for _, u in ipairs(state.units) do
				local prevHp = hpSnapshot[u.id] or u.currentHp
				local hpDiff = prevHp - u.currentHp
				-- BUG-219 (Tester W1): HP lost to a Max HP cap (a stat status of this cast) is not hit damage.
				if hpDiff > 0 and (u._statCapLoss or 0) > 0 then hpDiff = math.max(0, hpDiff - u._statCapLoss) end
				-- BUG-185 (batch 15): only a status this cast really applied (new, or refreshed / stacked /
				-- accumulated), preferring the skill's own status. The old fallback named appliesStatus whenever
				-- the unit had it, even when this cast's application was refused (immune).
				local newStatus = newlyAppliedStatus(u, statusSnapshot[u.id], skillDef.appliesStatus, unit.id)
				-- 2026-11-09: the caster's OWN HP change on a skill aimed at someone else (Blood Price / HP
				-- Casting cost, Lifesteal / Vitality Surge heal) is not a hit on the caster. When clients were
				-- already sent that change under its own cause, don't list the caster as a target too (it
				-- logged "Hero uses Blood Price on Hero: -23 HP" as a second line for the HP cost).
				-- B3 (Studio 2026-11-09): a Shield the caster gains from its own skill aimed at someone else is an
				-- augment / passive reward (e.g. Barrier on Hit). ShieldChanged already sent and logged it with its
				-- cause ("gained a 1 shield (Barrier on Hit)"), so it is not a hit on the caster: listing it here
				-- added "Mage uses Sweeping Cut on Mage: -0 HP, +Shield" and "Mage gains Shield" as two more lines.
				if newStatus == "Shield" and u == unit and u ~= target then
					newStatus = nil
				end
				local _casterSelfChangeShown = u == unit and u ~= target and not newStatus
					and BattleVisualBroadcaster.IsHpShown(u)
				-- BUG-139 (BUG-HUNT-08): a unit the skill never hit (not the aimed unit, not the caster, not in
				-- the hit capture) whose whole HP change already went out under its own cause (explosion,
				-- Collapse, trap) is a side effect, not a skill hit. It was logged as "Mage uses Fire Bolt on
				-- Sentry Turret: -2 HP, target RT +100" (the RT was the Collapse +50 rule, not Fire Bolt).
				-- Status-only changes (hpDiff 0: area shields / buffs) are unchanged.
				local _sideEffectShown = hpDiff ~= 0 and u ~= target and u ~= unit and not _skillHitIds[u.id]
					and BattleVisualBroadcaster.IsHpShown(u)
				if (hpDiff ~= 0 or newStatus) and not _casterSelfChangeShown and not _sideEffectShown then
					local rtAdded = u.remainingRt - (rtSnapshot[u.id] or 0)
					-- BUG-143 (BUG-HUNT-15): KO'd and revived inside this cast = a KO hit for all its old HP,
					-- then the revive line (held for it); not a heal.
					local _revivedHere = reviveSnapshot[u.id] ~= nil and (u._reviveCount or 0) ~= reviveSnapshot[u.id]
					local _hitHp = if _revivedHere then (hpSnapshot[u.id] or 0) else hpDiff
					table.insert(results, {
						actionType    = "Skill",
						unit          = unit,
						target        = u,
						skillName     = skillDef.name,
						damage        = math.max(0, _hitHp),
						healing       = math.max(0, -_hitHp),
						statusApplied = newStatus,
						isChanneling  = unit.isChanneling,
						rtDelay       = rtAdded > 0 and rtAdded or nil,
						targetHpAfter = if _revivedHere then 0 else nil,
						targetKoHere  = if _revivedHere then true else nil,
						revivedHere   = if _revivedHere then true else nil,
					})
				end
			end
			clearStatCapLoss()  -- BUG-219

			-- Caster animation (2026-10-28, W-6): pick ONE kind for the whole cast and attach it
			-- to the FIRST result only; every other target's event carries "None". The server
			-- spaces multi-target broadcasts 0.8-1.2 s apart, longer than the client's 0.5 s
			-- action lock, so per-result kinds replayed the caster animation once per target.
			-- Self-buff vs cast is judged on the cast's own target, not on each struck unit.
			do
				local _anyDamage = false
				for _, r in ipairs(results) do
					if (r.damage or 0) > 0 then _anyDamage = true; break end
				end
				local _castKind = skillAnimKind(skillDef, unit, target, _anyDamage)
				for i, r in ipairs(results) do
					r.animKind = if i == 1 then _castKind else "None"
				end
			end

			-- Return first result (broadcastActions handles one at a time)
			-- But we need to return ALL results for AOE
			if #results == 1 then
				return results[1]
			elseif #results > 1 then
				-- Return a special multi-hit result
				return { actionType = "MultiHit", actions = results }
			else
				-- No visible change (e.g. channel commit)
				return {
					actionType   = "Skill",
					unit         = unit,
					target       = target,
					skillName    = skillDef.name,
					damage       = 0,
					healing      = 0,
					isChanneling = unit.isChanneling,
					animKind     = skillAnimKind(skillDef, unit, target, false),
				}
			end
		else
			warn("[Main] Player skill rejected: " .. (reason or "unknown"))
			return nil
		end
	end

	if actionType == "Item" then
		local slotIndex = command.itemSlotIndex
		if not slotIndex then
			warn("[Main] Player item: no itemSlotIndex")
			return nil
		end
		local slot = unit.consumableSlots and unit.consumableSlots[slotIndex]
		if not slot or not slot.consumableId then
			warn("[Main] Player item: empty slot " .. tostring(slotIndex))
			return nil
		end
		local consDef = ConsumableData.GetById(slot.consumableId)
		local itemName = consDef and consDef.name or "Item"

		-- Resolve target: ground tile (virtual) or unit by id
		local target = nil
		if command.tileX and command.tileY and not command.targetId then
			target = {
				tileX = command.tileX,
				tileY = command.tileY,
				isGroundTarget = true,
				isAlive = true,
				name = string.format("Ground(%d,%d)", command.tileX, command.tileY),
				id = "_ground_" .. command.tileX .. "_" .. command.tileY,
			}
		else
			for _, u in ipairs(state.units) do
				if u.id == command.targetId then
					target = u
					break
				end
			end
		end
		if not target then
			warn("[Main] Player item: target not found (targetId=" .. tostring(command.targetId) .. ")")
			return nil
		end

		-- Snapshot target state for result reporting
		local hpBefore = target.currentHp or 0
		local mpBefore = target.currentMp or 0
		local _itemStBefore = takeStatusSnapshot(target)  -- BUG-185: what the item really applies

		-- choice: picked value for pick-list items (string only; validated server-side).
		local selection = { itemSlotIndex = slotIndex, target = target,
			choice = (type(command.choice) == "string") and command.choice or nil,
			-- AC-020 Masterwork Toolchain second Item (checked server-side before any cost).
			bundleSlotIndex = (type(command.bundleSlotIndex) == "number") and command.bundleSlotIndex or nil }
		-- Tile-occupancy refresh (2026-10-26): items can now move the user and/or the
		-- target (push, pull, swap, teleport). Snapshot both tiles, re-label after commit.
		local _moved = {}
		-- (2026-10-26) every living unit: area pushes (Gale Engine, Repulsion Device) can move
		-- several units in one item use.
		for _, mu in ipairs(state.units) do
			if mu and mu.isAlive and not mu.isGroundTarget and mu.tileX then
				table.insert(_moved, { u = mu, x = mu.tileX, y = mu.tileY })
			end
		end
		-- This user's live devices before the use (a new device replaces the old one).
		local _devicesBefore = {}
		for _, du in ipairs(state.units) do
			if du.isAlive and du.isItemDevice and du.summonOwnerId == unit.id then
				table.insert(_devicesBefore, { u = du, x = du.tileX, y = du.tileY })
			end
		end
		clearStatCapLoss()  -- BUG-229
		local ok, reason = CommandService.ValidateAndCommit(state, unit.id, "Item", selection)
		if ok and CommandService.WasActionVoided(unit) then return nil end  -- BUG-132: lethal Wounded, no item
		if ok then
			-- D-1 fix (UAT 2026-10-26): two passes. Clear every vacated tile FIRST, then
			-- label every new tile, so a swap (each unit lands on the other's old tile)
			-- does not wipe the label the first unit just received.
			for _, mv in ipairs(_moved) do
				if mv.u.tileX ~= mv.x or mv.u.tileY ~= mv.y then
					clearTileOccupant(mv.x, mv.y)
				end
			end
			for _, mv in ipairs(_moved) do
				if (mv.u.tileX ~= mv.x or mv.u.tileY ~= mv.y) and mv.u.isAlive then
					setTileOccupant(mv.u.tileX, mv.u.tileY, mv.u.name, "Unit (" .. mv.u.side .. ")", "Blocking")
				end
			end
			-- Item devices (2026-10-26): a placed turret / drone / decoy / pylon occupies the
			-- picked tile; label it like any unit. A replaced older device is no longer alive:
			-- clear its old tile first.
			-- (also covers Object Recall: a moved device's old tile is cleared)
			for _, dv in ipairs(_devicesBefore) do
				if not dv.u.isAlive or dv.u.tileX ~= dv.x or dv.u.tileY ~= dv.y then
					clearTileOccupant(dv.x, dv.y)
				end
			end
			if target.isGroundTarget then
				for _, du in ipairs(state.units) do
					if du.isAlive and du.isItemDevice and du.tileX == target.tileX and du.tileY == target.tileY then
						setTileOccupant(du.tileX, du.tileY, du.name, "Unit (" .. du.side .. ")", "Blocking")
					end
				end
			end
			local hpDelta = (target.currentHp or 0) - hpBefore
			-- BUG-229 (batch 18c, Tester A1 on BUG-219): HP lost to a Max HP cap (a stat status this item applied) is not
			-- item damage; StatusService logs it on its own "Max HP drops" line. Same rule as Attack / Skill / AI.
			if hpDelta < 0 and (target._statCapLoss or 0) > 0 then hpDelta = math.min(0, hpDelta + target._statCapLoss) end
			clearStatCapLoss()
			local mpDelta = (target.currentMp or 0) - mpBefore
			local newStatus = newlyAppliedStatus(target, _itemStBefore, nil, unit.id)  -- BUG-185: shared rule
			local amount = 0
			if hpDelta ~= 0 then
				amount = math.abs(hpDelta)
			elseif mpDelta ~= 0 then
				amount = math.abs(mpDelta)
			end
			return {
				actionType    = "Item",
				unit          = unit,
				target        = target,
				itemName      = itemName,
				amount        = amount,
				statusApplied = newStatus,
			}
		else
			warn("[Main] Player item rejected: " .. (reason or "unknown"))
			-- D-4 (UAT 2026-10-26): show the reason in the battle log, not only server Output.
			if reason then
				BattleVisualBroadcaster.Log("info", `{itemName}: {reason}`, unit.id)
			end
			return nil
		end
	end

	warn("[Main] Unknown player command: " .. tostring(actionType))
	return nil
end


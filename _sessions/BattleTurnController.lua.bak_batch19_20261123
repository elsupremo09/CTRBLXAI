-- LUNGE tile-aim (D1 fix 2026-11-08): a player's Lunge aims at a tile, and its target list is one ground
-- marker on the caster's own tile. The marker is offered only when at least one on-map tile exactly 2 away
-- has a legal step tile (same CommandService.LungeStepTile that validation uses), so Lunge greys out when
-- nothing can be lunged at. The tile actually aimed at is still checked by validation before any cost.
-- BUG-185 (batch 15): ONE rule for the "+<status>" on a hit line: only a status this command really applied.
-- takeStatusSnapshot(u) records the unit's status instances (table identity) and their duration / stack / stored
-- value before the command; newlyAppliedStatus(u, before, preferId) then returns:
--   * preferId (the skill's own appliesStatus) when that status is a NEW instance or one the command refreshed,
--     stacked or accumulated (its stamp changed);
--   * otherwise the FIRST new instance added by the command whose source is the acting unit (actorId; the skill's
--     own status lands before augment / passive riders, so a first Counter Stance read "+Recharge"). A status
--     the unit gave itself because of the hit (Sleep Immunity after being woken) is not the attacker's;
--   * nil when nothing was applied. A status the unit already had and was refused for (Petrified, Sleep
--     Immunity, Wardweave Robe) keeps its old instance and stamp, so it is not listed (BUG-174 recurrence:
--     Rainfall Zone on a Petrified unit that already had Wet read "+Wet" and "gains Wet (4 turns)").
-- Used by every hit-line builder here (player Attack / Skill / Item, AI commits, channel releases).
local function statusStamp(inst: any): string
	return `{tostring(inst.remainingTurns)}|{tostring(inst.remainingCt)}|{tostring(inst.stacks)}|{tostring(inst.storedBurn)}`
end
-- BUG-219 (batch 18b, Tester W1): HP a stat-status rebuild capped during a command (StatusService.syncStatStatus
-- records it as u._statCapLoss and logs its own "Max HP drops" line). Cleared before each commit and after its
-- hit lines are built, so it is never counted as hit damage.
local function clearStatCapLoss()
	for _, u in ipairs((state and state.units) or {}) do u._statCapLoss = nil end
end
local function takeStatusSnapshot(u: any): { [any]: string }
	local snap = {}
	if u and u.statusInstances then
		for _, inst in ipairs(u.statusInstances) do snap[inst] = statusStamp(inst) end
	end
	return snap
end
local function newlyAppliedStatus(u: any, before: any, preferId: string?, actorId: any): string?
	if not (u and u.statusInstances and before) then return nil end
	if preferId then
		for _, inst in ipairs(u.statusInstances) do
			if inst.id == preferId and (before[inst] == nil or before[inst] ~= statusStamp(inst)) then
				return preferId
			end
		end
	end
	for _, inst in ipairs(u.statusInstances) do
		if before[inst] == nil and (actorId == nil or inst.sourceUnitId == actorId) then return inst.id end
	end
	return nil
end

local function hasLungeAimTile(unit: any): boolean
	for dy = -2, 2 do
		for dx = -2, 2 do
			local tx, ty = unit.tileX + dx, unit.tileY + dy
			if math.max(math.abs(dx), math.abs(dy)) == 2
				and tx >= 1 and ty >= 1 and tx <= (MAP_WIDTH or tx) and ty <= (MAP_HEIGHT or ty)
				and CommandService.LungeStepTile(unit, { tileX = tx, tileY = ty }, state) ~= nil
			then
				return true
			end
		end
	end
	return false
end

local function buildTurnPrompt(unit)
	-- Timeline data: all alive units sorted by remainingRt (who acts soonest)
	local timeline = {}
	for _, u in ipairs(state.units) do
		if u.isAlive then
			table.insert(timeline, {
				id          = u.id,
				name        = u.name,
				side        = u.side,
				remainingRt = u.remainingRt,
				currentHp   = u.currentHp,
				maxHp       = u.maxHp,
				isActive    = (u.id == unit.id), -- mark the actual active unit
				isChanneling = u.isChanneling or false,
				channelRt   = u.channelRt or 0,
				-- TWO-TIMER: remaining channel time = fixed deadline minus current CT, so the
				-- client places the channel event at the correct timeline position (independent
				-- of the caster's own RT entry).
				channelRemaining = math.max(0, (u.channelResolveCt or 0) - state.ct),
				channelPhase = u.channelPhase, -- "Channel" | "Activation" (2026-10-07)
				channeledSkillName = u.channelingData and u.channelingData.skillDef and u.channelingData.skillDef.name or nil,
				channeledSkillIcon = u.channelingData and u.channelingData.skillDef and u.channelingData.skillDef.icon or nil,
				channeledSkillId = u.channelingData and u.channelingData.skillDef and u.channelingData.skillDef.id or nil, -- turn-order skill portrait (2026-11-18)
			})
		end
	end
	table.sort(timeline, function(a, b) return a.remainingRt < b.remainingRt end)

	_promptSkillInfo = {}  -- skill hit preview: refreshed with every prompt (2026-10-30)
	local skills = {}
	for _, sid in ipairs(unit.skillIds or {}) do
		local def = CommandService.GetSkill(sid)
		if def then
			-- Level-based MP (2026-10-07): same pricing the server charges (CommandService.GetSkillMpCost).
			local promptMpCost = CommandService.GetSkillMpCost(unit, def, def.id)
			local canUse = UnitSchema.HasEnoughMp(unit, promptMpCost)
				and not CommandService.IsRelocationBlockedSkill(unit, def)  -- Phase Lock (2026-10-27)
				and not CommandService.IsPinBlockedSkill(unit, def)  -- Pinned: no leap/dash/step skills (rule 253, 2026-11-08)
				and not CommandService.IsDualWieldBlockedSkill(unit, def)  -- Dual Wield exclusive (2026-10-28)
				and not CommandService.IsHpCostBlockedSkill(unit, def)  -- Blood Price at <= 15% HP (2026-11-08)
				-- BUG-119 (BUG-HUNT-24): Silence (blocks.Skills) / Stun-type (blocks.All) -- the SAME
				-- canonical check the commit uses (STEP 3b StatusService.IsActionBlocked), like the
				-- Move / Attack gates below (PT-08). The skill list then shows its normal grayed entry.
				and not StatusService.IsActionBlocked(unit, "Skill")
			local candidates, computedRange = TargetingService.GetSkillCandidates(unit, state.units, def)
			-- Weapon minimum range (2026-10-30): same shared formula the server validates with
			-- (CalcSkillRange 2nd return = weapon min for weapon-range skills, else 0; it does not
			-- depend on the range modifiers). Sent to the client so tile-click skills stop offering
			-- tiles the server would refuse as "inside weapon min range".
			local _, computedMinRange = GameConstants.CalcSkillRange(unit, def, 0)
			-- TAUNT (2026-10-27): debuff / damage skills may only target the taunter.
			candidates = StatusService.FilterTauntCandidates(unit, def, candidates, state.units, computedRange)
			local isGroundTarget = false
			local isSelfTarget = false
			local tr = def.targetRules or "Enemy Unit"
			if tr == "Self" or tr == "Self (Aura)" or tr == "Ally Tile (centered on caster)"
				or tr == "Caster Area"
				or (tr == "Self, Allies" and (def.range or 0) == 0)
			then
				isSelfTarget = true
			end
			local targetIds = {}
			for _, c in ipairs(candidates) do
				-- Steal (SKL-STEAL) gating (2026-10-24): a legal steal target is one the
				-- caster is DIRECTLY BEHIND (exact rear tile) who also has >=1 stealable
				-- non-weapon piece. Filtering here empties the list when none qualify, so
				-- the skill auto-grays on the client (which needs targets > 0 to enable it).
				if def.id == "SKL-STEAL" and not (
					GameConstants.IsCasterBehindTarget(unit, c)
					and #GameConstants.GetStealableSlots(c) > 0
				) then
					continue
				end
				-- Skyfall Lance: hide targets with no free landing tile (validation would reject them).
				-- BUG-183 (batch 14c): Reckless Charge (isCharge) too - same CanLeapTo check, so the prompt
				-- (and its preview) only offers targets the charge can reach melee range of.
				if (def.leapsAdjacent or def.isCharge) and not c.isGroundTarget and not CommandService.CanLeapTo(unit, c, state) then
					continue
				end
				-- Lunge (2026-11-08): only targets exactly 2 tiles away with a free tile to step onto.
				-- A player's tile-aim marker sits on the caster's own tile, so it passes when any tile
				-- 2 away can be lunged at (D1 fix 2026-11-08); AI unit targets are checked as before.
				if def.stepsToTargetFirst then
					if c.isGroundTarget then
						if not hasLungeAimTile(unit) then
							continue
						end
					elseif not CommandService.LungeStepTile(unit, c, state) then
						continue
					end
				end
				if c.isGroundTarget then
					isGroundTarget = true
					-- Ground target: no predicted damage, just a marker
					table.insert(targetIds, {
						id = "_ground_target", name = "Ground",
						tileX = c.tileX, tileY = c.tileY,
						predicted = 0, predType = "damage",
						isGroundTarget = true,
					})
				else
					local predicted = 0
					local predType = "damage"
					if def.isHealing then
						local healResult = CombatResolver.ResolveHealing(unit, c, def)
						predicted = healResult.finalHealing or 0
						predType = "healing"
					else
						-- Skyfall Lance / charges strike from their landing tile, so predict from there:
						-- the caster is placed on that tile only for this calculation and put straight
						-- back (no yield in between; nothing is broadcast). Every position factor
						-- (facing, elevation, high ground, terrain) then matches the real hit.
						local previewDef = def
						local land = nil
						if def.leapsAdjacent then
							land = CommandService.LeapLanding(unit, c, state)
						elseif def.isCharge and c.isAlive then
							land = CommandService.ComputeChargeLanding(unit, c, state)
						elseif def.stepsToTargetFirst then
							land = CommandService.LungeStepTile(unit, c, state)  -- Lunge hits from its step tile
						end
						local homeX, homeY = unit.tileX, unit.tileY
						if land then
							unit.tileX, unit.tileY = land.x, land.y
						end
						if def.leapsAdjacent then
							previewDef = CommandService.LeapDamageDef(def, unit.tileX, unit.tileY, c)
						end
						local okPrev, dmgResult = pcall(CombatResolver.ResolveSkill, unit, c, previewDef)
						unit.tileX, unit.tileY = homeX, homeY
						if not okPrev then
							error(dmgResult, 0)
						end
						predicted = dmgResult.finalDamage or 0
						-- BUG-110: a physical hit on a Bleeding target also deals the Bleed bonus
						-- (same helper as the real hit, CombatResolver.ApplyOutcome).
						-- W2: only when the hit reduces HP after shields.
						if dmgResult.type == "Damage" and predicted > 0 then
							predicted = predicted + CombatResolver.PredictBleedBonus(c, unit, dmgResult.element, predicted, 1)
						end
					end
					local tEntry = {
						id        = c.id,
						name      = c.name,
						tileX     = c.tileX,
						tileY     = c.tileY,
						predicted = predicted,
						predType  = predType,
					}
					-- CHARGE preview: server computes the landing tile + straight path
					-- (shared with the actual commit logic) so the client can highlight
					-- the caster's landing (yellow) and the path (white) at confirmation.
					if def.isCharge or def.leapsAdjacent then
						-- BUG-120: a leap shows the same landing its resolution uses (LeapLanding).
						local landing = if def.leapsAdjacent then CommandService.LeapLanding(unit, c, state)
							else CommandService.ComputeChargeLanding(unit, c, state)
						if landing then
							tEntry.landingTileX = landing.x
							tEntry.landingTileY = landing.y
							tEntry.chargePath = CommandService.ComputeChargePath(unit.tileX, unit.tileY, landing.x, landing.y)
						end
					elseif def.stepsToTargetFirst or def.hopsBackAfter then
						-- Lunge step / Recoil Shot hop (2026-11-08): show the tile the caster will end on.
						local landing = if def.stepsToTargetFirst then CommandService.LungeStepTile(unit, c, state)
							else CommandService.RecoilHopTile(unit, c, state)
						if landing then
							tEntry.landingTileX = landing.x
							tEntry.landingTileY = landing.y
							tEntry.chargePath = CommandService.ComputeChargePath(unit.tileX, unit.tileY, landing.x, landing.y)
						end
					end
					table.insert(targetIds, tEntry)
				end
			end

			-- Skill hit preview (2026-10-30): remember what this prompt offered for the preview check.
			-- BUG-118 (BUG-HUNT-14): a unit-target skill that is not widened previews only on a tile
			-- holding one of the units this prompt offered (the commit refuses a bare tile for it).
			local _unitOnly = (not isGroundTarget) and (not isSelfTarget)
				and (not TargetingService.IsWidenedSkill(def)) and TargetingService.IsUnitOnlyTargetRule(tr)
			local _targetTiles = nil
			if _unitOnly then
				_targetTiles = {}
				for _, t in ipairs(targetIds) do
					if t.tileX and t.tileY then _targetTiles[t.tileX .. "," .. t.tileY] = true end
				end
			end
			_promptSkillInfo[def.id] = {
				range = computedRange or (def.range or 1),
				minRange = computedMinRange or 0,
				selfTarget = isSelfTarget,
				targetTiles = _targetTiles,
			}
			table.insert(skills, {
				id          = def.id,
				name        = def.name,
				willEndTurn = (def.channelTime or 0) > 0, -- warn player: channeling ends turn
				mpCost      = promptMpCost,
				range       = def.range or 1,
				-- BUG-157 (HUNT-20): the skill's real shape, via the shared weapon/skill label table.
				pattern     = WeaponData.GetSkillPatternLabel(def.aoePattern or def.pattern, unit.weaponPattern),
				targetRules = def.targetRules or "Enemy Unit",
				isHealing   = def.isHealing or false,
				isCharge    = def.isCharge or false,
				leapsAdjacent = def.leapsAdjacent or false,  -- Skyfall Lance: show its landing tile like a charge
				showsLandingTile = (def.stepsToTargetFirst or def.hopsBackAfter) == true,  -- Lunge / Recoil Shot end tile
				channelTime = def.channelTime or 0,
				canUse      = canUse,
				targets     = targetIds,
				tags        = def.tags or {},
				groundTarget = isGroundTarget,
				selfTarget   = isSelfTarget,
				computedRange = computedRange or (def.range or 1),
				computedMinRange = computedMinRange or 0,  -- weapon min range (2026-10-30)
				-- rtCost shown MUST match the charge path (CommandService): fixed/level skills
				-- use their authored cost; weapon-WT skills use (base component + weapon WT) × N.
				rtCost      = (function()
					local lvl = (unit.equipmentSlots and unit.equipmentSlots.MainHand and unit.equipmentSlots.MainHand.itemLevel) or 1
					local augRt = CommandService.GetAugmentRtMultiplier(unit, def.id)  -- e.g. Shared Resolve x2
					local fx = GameConstants.CalcFixedSkillRt(def.id, lvl)
					if fx then return math.round(fx * augRt) end
					if def.rtMult then
						local baseComp = StatusService.GetModifiedBaseRt(unit) * GameConstants.BASIC_ATTACK_RT_FACTOR
						local wWt = GameConstants.CalcEffectiveWt(unit.weaponWt or 10, (unit.effectiveStats or {}).STR or 10)
						if def.dualWieldRt and unit.dualWieldActive and unit.offWeapon then  -- Dual-Wield BA RT
							wWt += GameConstants.CalcEffectiveWt(unit.offWeapon.wt or 0, (unit.effectiveStats or {}).STR or 10)
						end
						-- Same rounding order as the charge (CommandService): skill RT first, then the augment x.
						return math.round(math.round((baseComp + wWt) * def.rtMult) * augRt)
					end
					return math.round((def.rtCost or 60) * augRt)
				end)(),
				power       = def.power or 0,
				appliesStatus = def.appliesStatus or nil,
				description = skillCardText(def),  -- full card text (SkillData), auto-text only as fallback
			})
		end
	end

	local moveTiles = TargetingService.GetMoveCandidates(unit, state.units, MAP_WIDTH, MAP_HEIGHT)
	if unit.isSummon and unit.canMove == false then moveTiles = {} end  -- immobile summon (Turret/Totem/Decoy)
	-- Status-based movement block (e.g. Pinned from Vines): if a status forbids Move,
	-- send ZERO move tiles so the client grays the Move button, and pass the reason for
	-- its tooltip. Uses the SAME canonical check the commit path uses (StatusService.
	-- IsActionBlocked), so the button state always matches what the server would accept
	-- -- no more "43 moves offered, every one rejected". (2026-10-22)
	local moveBlocked, moveBlockReason = StatusService.IsActionBlocked(unit, "Move")
	if moveBlocked then moveTiles = {} end
	local moveCandidates = {}
	for _, tile in ipairs(moveTiles) do
		table.insert(moveCandidates, {
			tileX    = tile.tileX,
			tileY    = tile.tileY,
			pathCost = tile.pathCost,
			-- BUG-PT-02: the RT this Move will add, from the same server code the Move commit
			-- charges (CommandService.GetMoveRtPreview). The client shows it as-is.
			rtCost   = CommandService.GetMoveRtPreview(unit, tile),
			terrain  = tile.terrain,
			path     = tile.path,
		})
	end

	-- Weapon + Ranger reach from the same server formula the commits use (BUG-082).
	local attackCandidates = TargetingService.GetAttackCandidates(unit, state.units,
		CommandService.GetBasicAttackBaseRange(unit))
	-- BUG-PT-08 (2026-11-21): a status that forbids the Basic Attack (Disarmed; Stun / Sleep /
	-- Petrify / Knock-out block everything) can arrive MID-TURN (trap, counter, reaction). The
	-- commit refuses it at STEP 3b (StatusService.IsActionBlocked), but the prompt still listed
	-- every target, so the attack bounced and the same prompt came back. Same canonical check as
	-- the commit, per kind (unit Attack / AttackObject), like the Move gate above (2026-10-22).
	local attackBlocked, attackBlockReason = StatusService.IsActionBlocked(unit, "Attack")
	-- BUG-080: IsActionBlocked now maps blocks.BasicAttack to "AttackObject" too, so a Disarmed
	-- unit gets no object targets either -- same answer the AttackObject commit (STEP 3b) gives.
	local objectAttackBlocked = StatusService.IsActionBlocked(unit, "AttackObject")
	if attackBlocked then attackCandidates = {} end
	local attackTargets = {}
	for _, c in ipairs(attackCandidates) do
		-- Pre-calculate predicted basic attack damage for aim phase. Same prediction the AI and the
		-- Attack commit use (2026-11-21): Rake total over its hits (+ RT Delay per hit), on-hit statuses
		-- (Lashed / Blunted / Frozen ...) and the Rebound hit on the adjacent enemy (ARC-001, DAT-001).
		local pred = CombatResolver.PredictBasicAttack(unit, c, unit.weaponDamage or 10, state.units)
		table.insert(attackTargets, {
			id        = c.id,
			name      = c.name,
			tileX     = c.tileX,
			tileY     = c.tileY,
			predicted = pred.damage or 0,
			hitCount  = if (pred.hits or 1) > 1 then pred.hits else nil,
			rtDelayHits = if (pred.rtDelayHits or 1) > 1 then pred.rtDelayHits else nil,
			statuses  = if #pred.statuses > 0 then pred.statuses else nil,
			statusTurns = if #pred.statuses > 0 then pred.statusTurns else nil,
			reboundId = pred.rebound and pred.rebound.unit.id or nil,
			reboundName = pred.rebound and pred.rebound.unit.name or nil,
			reboundPredicted = pred.rebound and pred.rebound.damage or nil,
		})
	end

	-- OBS Phase 2c-B: breakable blocker-prop OBS objects are also BASIC-ATTACK targets
	-- (map_gen_rules row 82). Same range/LoS/elevation gates as unit attacks (shared
	-- TargetingService logic); the Ad Billboard is excluded (unbreakable, rows 85/93).
	-- The unit attack loop above is unchanged.
	if TargetingService.GetAttackableObjectTargets and not objectAttackBlocked then
		-- BUG-082: same base reach as the AttackObject commit (weapon + Ranger; race/trait added inside).
		for _, oc in ipairs(TargetingService.GetAttackableObjectTargets(unit, state.units,
			CommandService.GetBasicAttackBaseRange(unit), state)) do
			table.insert(attackTargets, oc)
		end
	end

	-- Push targets (2026-10-28): every unit in push range, with the push distance and the ray it moves
	-- along, from CommandService.GetPushPreview -- the SAME range / Force / Stability / pull-swap rules
	-- the Push command uses (glove Push Force, GL-004 Longarm range, GL-005 Butcher's Pull min range 2,
	-- GL-021 Initiator x0.5, GL-001 stability ignore, Fortress Plate, Grounding Harness). Before this the
	-- preview used base Force and plain range, so those glove bonuses never reached players.
	local pushTargets = {}
	for _, c in ipairs(state.units) do
		if c.isAlive and c.id ~= unit.id then
			local pv = CommandService.GetPushPreview(unit, c)
			if pv then
				table.insert(pushTargets, {
					id = c.id, name = c.name, tileX = c.tileX, tileY = c.tileY,
					maxPushDistance = pv.maxPushDistance, side = c.side,
					pushFromX = pv.fromX, pushFromY = pv.fromY, pushDirX = pv.dirX, pushDirY = pv.dirY,
					isPull = pv.isPull, isSwap = pv.isSwap,
					isArc = pv.isArc,  -- GL-015 Throwing Gloves (2026-10-29)
					vectorDirs = pv.vectorDirs,  -- GL-013 Vector Gloves (2026-10-29)
				})
			end
		end
	end

	-- Objects: same range / force / pull as the PushObject command (2026-10-28): race override,
	-- GL-004 Longarm +1 range, GL-005 Butcher's Pull (min range 2), GL-008 Siege +3 force.
	local pushMinDist, pushMaxDist, pusherForce, objIsPull = CommandService.GetObjectPushSetup(unit)

	-- OBS Phase 2c-E2: breakable blocker-prop OBS objects are also pushable (map_gen_rules
	-- row 83); billboards (immovable) are excluded by the helper. Unit loop above is unchanged.
	if ObjectEffectService.GetPushableObjectTargets then
		for _, oc in ipairs(ObjectEffectService.GetPushableObjectTargets(state, unit, pushMinDist, pushMaxDist, pusherForce)) do
			oc.isPull = objIsPull
			table.insert(pushTargets, oc)
		end
	end

	-- Consumable items: usable slots only (has item + charges > 0), with
	-- targeting metadata so the client can mirror the Skill flow.
	local consumableItems = {}
	for idx = 1, (unit.consumableSlotCount or 3) do
		local slotData = unit.consumableSlots and unit.consumableSlots[idx]
		if slotData and slotData.consumableId and CommandService.ItemSlotHasCharge(state.units, unit, slotData) then  -- AC-019 pool
			local consDef = ConsumableData.GetById(slotData.consumableId)
			-- Parked items (DB Status PARKED, user 2026-10-27) never show in battle.
			if consDef and not consDef.parked then
				local tr = consDef.targetRules or "Self"
				local formula = consDef.effectFormula or ""
				-- ARTIFICER — Applied Artifice: Consumable Item Maximum Range +1. Mirrors the
				-- server gate (CommandService.validateItemTarget) so the client can SELECT the
				-- farther tile; server remains the final authority. (2026-10-21)
				local itemRange = (consDef.range or 0) + DoctrinePassiveService.GetConsumableRangeBonus(unit)
					+ ItemEffectService.GetTrapRangeBonus(unit, consDef)  -- AC-012 Trapmaker's Roll (mirrors server)
					+ ArmorPassiveService.GetItemRangeBonus(unit)  -- AC Accessory Item Range +2 (server already adds it; menu now matches)
				-- Aim range (user ruling 2, 2026-10-26): Self-origin Line/Cone items and the
				-- teleport pick a tile even though their authored range is 0.
				local aimRange = ItemEffectService.GetItemAimRange(unit, consDef)
				if aimRange then itemRange = math.max(itemRange, aimRange) end
				-- BUG-128 (BUG-HUNT-20, 2026-11-22): a self-centred area item with no aim tile (Rally Array,
				-- consumable_items Range 0 / Self-origin) is always centred on the user (CommandService snaps
				-- the tile back). Item-range bonuses made the prompt offer range 2 tiles; offer the user's own tile.
				if tr == "Self-origin" and not aimRange then itemRange = 0 end

				-- Classify targeting mode from targetRules
				-- Battlefield / Global items (weather beacons) need no target: confirm like Self.
				-- "Self and Allies" (REC-020) is centred on the user: confirm like Self.
				local isSelf   = (tr == "Self" or tr == "Battlefield" or tr == "Global" or tr == "Self and Allies")
				-- Empty Tile (deployables / emitters) and the teleport pick a tile (2026-10-26).
				local isGround = (tr == "Ground" or tr == "Tile" or tr == "Enemy or Ground"
					or tr == "Self-origin"
					or tr == "Empty Tile" or tr == "Self to Empty Tile"
					or tr == "Owned Deployable"  -- Object Recall: device from the list, then a tile
					or tr == "Mechanical Object"  -- Maintenance Tool: tap the device / gadget
					or tr == "Breakable Terrain"  -- Excavation Drill: tap the tile
					or tr == "Gap Endpoints"  -- Bridge Projector: tap the gap
					or tr == "Object or Unit")  -- Breaching Drill: tap the tile
				local isAllyTarget  = (tr == "Self or Ally" or tr == "Ally" or tr == "Ally or Object")
				local isEnemyTarget = (tr == "Enemy" or tr == "Enemy Unit")
				-- Any-side unit items (Kinetic Ram / Grapple, Exchange Device), never the user.
				local isAnyTarget   = (tr == "Any Unit" or tr == "Unit or Object" or tr == "Ally or Enemy" or tr == "Enemy or Ally")
				-- Revive items ("KO Ally"): offer KO'd units. Widened 2026-10-24 to
				-- offer any-side corpses (ally = original use; enemy = revive-to-
				-- enemy / Torture). Server validateItemTarget enforces must-be-dead.
				local isKOTarget = (tr == "KO Ally")
				-- All-tile widening (2026-10-24): ally-only / enemy-only CONSUMABLES
				-- widen to offer a unit of ANY side (heal/buff an enemy, damage-item an
				-- ally). Hide still protects. Mirrors the skill path (IsWidenedSkill).
				local isWidenedItem = TargetingService.IsWidenedItemRule(tr)

				local isHealing = formula:match("Restore%s+%d+%%.-Max HP") ~= nil

				-- Build unit-target candidates by side + Chebyshev range
				local itemTargets = {}
				if isAllyTarget or isEnemyTarget or isAnyTarget or isWidenedItem then
					for _, c in ipairs(state.units) do
						if c.isAlive and not StatusService.HasStatus(c, "Hide") then
							local sameSide = (c.side == unit.side)
							local includeAlly  = isAllyTarget and sameSide
							local includeEnemy = isEnemyTarget and (not sameSide)
							local includeAny   = isAnyTarget
							-- Widened: any side is includable (self-exclusion for the bare
							-- "Ally" rule is preserved below, consistent with ally-not-self).
							local includeWidened = isWidenedItem
							-- "Ally" excludes self; "Self or Ally"/"Any" include self
							if isAllyTarget and (tr == "Ally" or tr == "Ally or Object") and c.id == unit.id then
								includeAlly = false
							end
							if isWidenedItem and tr == "Ally" and c.id == unit.id then
								includeWidened = false
							end
							if (tr == "Unit or Object" or tr == "Ally or Enemy" or tr == "Enemy or Ally") and c.id == unit.id then
								includeAny = false
							end
							if includeAlly or includeEnemy or includeAny or includeWidened then
								local dist = math.max(
									math.abs(c.tileX - unit.tileX),
									math.abs(c.tileY - unit.tileY)
								)
								if dist <= itemRange then
									table.insert(itemTargets, {
										id = c.id, name = c.name,
										tileX = c.tileX, tileY = c.tileY,
									})
								end
							end
						end
					end
				end
				-- KO-target items: offer DEAD units of any side within range (no Hide
				-- filter — corpses are not hidden). Client highlights these tiles.
				if isKOTarget then
					for _, c in ipairs(state.units) do
						if (not c.isAlive) and not c.isSummon then
							local dist = math.max(
								math.abs(c.tileX - unit.tileX),
								math.abs(c.tileY - unit.tileY)
							)
							if dist <= itemRange then
								table.insert(itemTargets, {
									id = c.id, name = c.name,
									tileX = c.tileX, tileY = c.tileY,
								})
							end
						end
					end
				end

				-- Magnetic Snare (2026-10-26): Mechanical-race units of either side, not the user.
				if tr == "Mechanical Unit/Object" then
					for _, c in ipairs(state.units) do
						if c.isAlive and c.id ~= unit.id and not StatusService.HasStatus(c, "Hide")
							and CombatResolver.HasRaceTag and CombatResolver.HasRaceTag(c, "Mechanical") then
							local dist = math.max(math.abs(c.tileX - unit.tileX), math.abs(c.tileY - unit.tileY))
							if dist <= itemRange then
								table.insert(itemTargets, { id = c.id, name = c.name, tileX = c.tileX, tileY = c.tileY })
							end
						end
					end
				end

				table.insert(consumableItems, {
					slotIndex     = idx,
					consumableId  = slotData.consumableId,
					name          = consDef.name or "Unknown",
					currentCharges = slotData.currentCharges,
					maxCharges    = slotData.maxCharges or consDef.maxCharges or 0,
					rtCost        = consDef.rtCost or 80,
					range         = itemRange,
					targetRules   = tr,
					pattern       = consDef.pattern or "Single",
					effectFormula = formula,
					-- Player-facing text (display only, never parsed). nil until authored in DB
					-- (consumable_items.Display_Text); client keeps its fallback. 2026-10-30.
					displayText   = consDef.displayText,
					category      = consDef.category or "",
					isHealing     = isHealing,
					selfTarget    = isSelf,
					groundTarget  = isGround,
					targets       = itemTargets,
					-- Pick-list (user ruling 1, 2026-10-26): fixed choices, or "targetBuff"
					-- (client lists the picked target's dispellable buffs).
					choices       = ItemEffectService.GetItemChoices(consDef, unit, state),
					choiceKind    = ItemEffectService.GetItemChoiceKind(consDef),
				})
				-- AC-014 Bomber Ring (2026-10-29): every item is a bomb -- pick any tile within bomb
				-- range; the preview shows the small cross (Impact 1). Mirrors the server rule.
				local _bombRange = CommandService.GetBomberRange(unit)
				if _bombRange then
					local _e = consumableItems[#consumableItems]
					_e.targetRules   = "Ground"
					_e.range         = _bombRange
					_e.pattern       = "Impact 1"
					_e.rtCost        = 110
					_e.effectFormula = `Bomber Ring: thrown as a bomb. Physical Power {CommandService.GetBomberPower(unit)} to every unit on the small cross.`
					-- Bomber Ring replaces the item's effect, so its own text is shown (2026-10-30).
					_e.displayText   = _e.effectFormula
					_e.isHealing     = false
					_e.selfTarget    = false
					_e.groundTarget  = true
					_e.targets       = {}
					_e.choices       = nil
					_e.choiceKind    = nil
				end
			end
		end
	end

	-- INTERACT candidates (Slice 4 — Interact Command framework). Classified
	-- server-side by native kind; the client labels each and only ungrays the
	-- Interact button when at least one candidate exists (Button Availability
	-- Policy). RT previews are a percentage of Modified Base RT per native kind.
	local interactCands = TargetingService.GetInteractCandidates(unit, state.units, state)
	local ObjectDataForInteract = require(game:GetService("ReplicatedStorage"):WaitForChild("Content"):WaitForChild("ObjectData"))
	local modBaseRtForInteract = StatusService.GetModifiedBaseRt(unit)
	local interactTargets = {}
	-- Roster capacity (2026-11-10): count recruits already won this battle too, so the
	-- Recruit option disappears once the roster would be full.
	local _rosterCap = GuildMenuService.GetRosterCapacity and GuildMenuService.GetRosterCapacity() or nil
	local _rosterNow = GuildMenuService.GetRosterCount and GuildMenuService.GetRosterCount() or 0
	for _, u in ipairs(state.units) do
		if u.recruited and not u.adoptedToRoster then _rosterNow += 1 end
	end
	for _, c in ipairs(interactCands) do
		if c.interactKind == "recruitEnemy" and _rosterCap and _rosterNow >= _rosterCap then
			continue -- roster full: no Recruit option
		end
		-- Per-kind RT preview (native percentages; headgear may reduce later).
		local rtPct = 0.10
		local label = "Interact"
		if c.interactKind == "allyRtHelp" then
			rtPct = 0.50; label = "Aid (−35% RT)"
		elseif c.interactKind == "reviveAlly" then
			rtPct = 0.30; label = "Resuscitate (channel)"
		elseif c.interactKind == "recruitEnemy" then
			rtPct = 0.10; label = if _rosterCap then `Recruit ({_rosterNow}/{_rosterCap})` else "Recruit"
		elseif c.interactKind == "captureTarget" then
			rtPct = 0.10; label = "Capture"  -- quest goal Capture (game_flow 41 approved text, step 5)
		elseif c.interactKind == "mapObject" then
			rtPct = 0.10; label = "Activate"
		elseif c.interactKind == "neutralizeHazard" then
			rtPct = 0.10; label = "Neutralize hazard"  -- HD-014 (2026-10-29)
		elseif c.interactKind == "disarmTrap" then
			rtPct = 0.10; label = "Disarm trap"  -- HD-010 (2026-10-29)
		elseif c.interactKind == "mechanistRefresh" then
			rtPct = 0.10; label = "Refresh"  -- HD-015 (2026-10-29)
		end
		local rtPreview = math.round(modBaseRtForInteract * rtPct)
		-- Quest goal Activate object (step 8): players see the approved name "Ancient Mechanism"
		-- (game_flow 41), never the reused Obelisk type.
		local shownName = c.name
		if c.interactKind == "mapObject" and c.objectId ~= nil then
			for _, o in pairs(state.objects or {}) do
				if type(o) == "table" and o.id == c.objectId and o.isGoalObject then
					shownName = "Ancient Mechanism"
					break
				end
			end
		end
		if c.interactKind == "mapObject" then
			-- Displayed type (Mimic disguise) so the RT preview matches what the player sees.
			local od = ObjectDataForInteract.Objects and ObjectDataForInteract.Objects[c.displayType or c.archetypeId]
			if od and od.activation == "Interact (Free)" then
				rtPreview = 0
			elseif od and od.interactRT then
				rtPreview = od.interactRT
			end
		end
		table.insert(interactTargets, {
			interactKind = c.interactKind,
			id           = c.id,            -- unit targets
			objectId     = c.objectId,      -- map-object targets
			name         = shownName,
			tileX        = c.tileX,
			tileY        = c.tileY,
			label        = label,
			rtPreview    = rtPreview,
			rosterCount  = if c.interactKind == "recruitEnemy" then _rosterNow else nil,
			rosterCapacity = if c.interactKind == "recruitEnemy" then _rosterCap else nil,
		})
	end

	-- AC-020 Masterwork Toolchain (2026-10-29): which other Items each Item can be bundled with. The
	-- client offers only those with a legal target on the first Item's chosen target.
	do
		local _bySlot = {}
		for _, e in ipairs(consumableItems) do _bySlot[e.slotIndex] = e end
		for _, e in ipairs(consumableItems) do
			local opts = {}
			for _, bi in ipairs(CommandService.GetBundleOptions(unit, e.slotIndex)) do
				local be = _bySlot[bi]
				if be then
					table.insert(opts, { slotIndex = bi, name = be.name, rtCost = be.rtCost,
						targets = be.targets, selfTarget = be.selfTarget, groundTarget = be.groundTarget,
						range = be.range })
				end
			end
			if #opts > 0 then e.bundleOptions = opts end
		end
	end

	-- QUICK DRAW (2026-10-29): out of AP with the bonus Basic Attack on offer -> only Attack (or end
	-- the turn) is possible, so every other option is emptied / grayed. The server enforces it.
	local quickDrawOffer = (unit.currentAp or 0) <= 0 and CommandService.IsQuickDrawReady(unit)
	-- GL-021 Initiator's Grips (re-check 2026-10-29): at 0 AP the free Push may still be on offer.
	local freePushOffer = (unit.currentAp or 0) <= 0 and CommandService.IsFreePushReady(unit)
	if quickDrawOffer or freePushOffer then
		skills = {}
		moveCandidates = {}
		consumableItems = {}
		interactTargets = {}
		if not freePushOffer then pushTargets = {} end
		if not quickDrawOffer then attackTargets = {} end
	end

	return {
		quickDrawOffer = quickDrawOffer,
		unitId         = unit.id,
		unitName       = unit.name,
		unitSide       = unit.side,
		currentAp      = unit.currentAp,
		currentMp      = unit.currentMp,
		maxMp          = unit.maxMp,
		currentHp      = unit.currentHp,
		maxHp          = unit.maxHp,
		guardUsed      = unit.guardUsedThisTurn or quickDrawOffer or freePushOffer or false,
		tileX          = unit.tileX,
		tileY          = unit.tileY,
		skills         = skills,
		moveCandidates = moveCandidates,
		-- Grayed-Move tooltip reason when a status blocks movement (nil when movement
		-- is allowed). Mirrors the undoReason pattern below. (2026-10-22)
		moveBlockedReason = moveBlocked and moveBlockReason or nil,
		attackTargets  = attackTargets,
		-- BUG-PT-08: grayed-Attack tooltip reason when a status blocks the Basic Attack (same
		-- pattern as moveBlockedReason; the text is the commit's own refusal reason).
		attackBlockedReason = attackBlocked and attackBlockReason or nil,
		-- UNDO (2026-10-17): availability + grayed-button reason for the top-level
		-- Undo command. Server owns the rule (SEC-002); client only renders the
		-- state. Available when the newest reversible action for THIS unit exists
		-- and triggered no reaction. undoReason feeds the disabled-button tooltip.
		undoAvailable  = (function()
			local e = BattleCoordinator.PeekUndo(state)
			return e ~= nil and e.actorId == unit.id and e.reaction ~= true
		end)(),
		undoReason     = (function()
			local e = BattleCoordinator.PeekUndo(state)
			if not e or e.actorId ~= unit.id then return "Nothing to undo" end
			if e.reaction then return "Can't undo — that move caused a reaction" end
			return nil
		end)(),
		pushTargets    = pushTargets,
		consumableSlots = consumableItems,
		interactTargets = interactTargets,
		interactAvailable = (#interactTargets > 0),
		pushRt         = math.round(StatusService.GetModifiedBaseRt(unit) * GameConstants.GUARD_RT_BASE_FACTOR),
		timeline       = timeline,
		currentCt      = state.ct,
		-- RT cost data so client can preview turn order shifts
		unitBaseRt = StatusService.GetModifiedBaseRt(unit),
		turnRtAccrued = state.turnRtAccrued or 0,
		-- Same Basic Attack RT the attack charges (StatCalcService, 2026-10-28): includes traits,
		-- Dual Strike, Frenzy and Frozen (the old inline formula left them out).
		attackRt   = StatCalcService.GetBasicAttackRt(unit, "battle"),
		waitRt     = math.round(
			StatusService.GetModifiedBaseRt(unit) * GameConstants.REST_RT_MULTIPLIER
		),
		-- BUG-087: Basic Attack card range = the reach GetAttackCandidates allows (weapon + Ranger via
		-- CommandService.GetBasicAttackBaseRange, + race/trait as TargetingService adds). Display only.
		weaponMinRange = unit.weaponMinRange or 1,
		weaponRange    = CommandService.GetBasicAttackBaseRange(unit)
			+ RacePassiveService.GetRangeModifier(unit) + TraitEffectService.GetAttackRangeModifier(unit),
		weaponRtDelay = unit.weaponRtDelay or 0,
		weaponDamage  = unit.weaponDamage or 10,
		-- Unit identity (for active unit panel display)
		level    = unit.level or 1,
		race     = unit.raceId and RaceData.GetRace(unit.raceId)
			and RaceData.GetRace(unit.raceId).name or nil,
		doctrine = unit.doctrineId and DoctrineData[unit.doctrineId]
			and DoctrineData[unit.doctrineId].name or "",
		-- BUG-137 (Tester UAT batch 9b, carried note): the ONE AP rule (GameConstants.GetTurnAp: Boss 3,
		-- else 2, + RL-19 _dgApBonus), so the prompt's max AP matches the AP the unit really got (DAT-001).
		maxAp    = GameConstants.GetTurnAp(unit),
	}
end

--------------------------------------------------
-- PLAYER TURN: Wait for player command
--
-- Sends prompt, then yields until the client fires PlayerCommand.
-- Returns the command payload or nil on timeout.
--------------------------------------------------

local PLAYER_TURN_TIMEOUT = 120 -- seconds

pendingCommand = nil
commandReceived = Instance.new("BindableEvent")

BattleEvents.PlayerCommand.OnServerEvent:Connect(function(player, command)
	-- Accept commands from any connected player (single-player for now)
	pendingCommand = command
	commandReceived:Fire()
end)

local function waitForPlayerCommand(unit, playerObj)
	-- Send prompt to client
	local prompt = buildTurnPrompt(unit)
	-- BUG-154: the reason code of this unit's last refused command (nil when none), shown once by the
	-- client (GameConstants.REJECT_TEXT). One short string on the prompt this player already gets (NET-003).
	prompt.rej = CommandService.TakeRejectCode(unit.id)
	_previewUnit = unit  -- skill hit preview answers for this unit only (2026-10-30)
	print(string.format(
		"[Main] Sending PlayerTurnPrompt to %s for %s (AP:%d, Skills:%d, Moves:%d)",
		playerObj.Name, unit.name, unit.currentAp, #prompt.skills, #prompt.moveCandidates
	))
	BattleEvents.PlayerTurnPrompt:FireClient(playerObj, prompt)
	BattleEvents.EscapeState:FireClient(playerObj, { allowed = true }) -- Escape tappable while this prompt is open (O2)

	-- Wait for response
	pendingCommand = nil
	local startTime = tick()

	while not pendingCommand do
		local elapsed = tick() - startTime
		if elapsed > PLAYER_TURN_TIMEOUT then
			print("[Main] Player turn TIMEOUT — auto-waiting.")
			_previewUnit = nil
			BattleEvents.EscapeState:FireClient(playerObj, { allowed = false })
			return { actionType = "Wait" }
		end
		commandReceived.Event:Wait()
	end

	local cmd = pendingCommand
	pendingCommand = nil
	_previewUnit = nil
	BattleEvents.EscapeState:FireClient(playerObj, { allowed = false }) -- command in: Escape dims until the next prompt
	return cmd
end

-- SKILL HIT PREVIEW (2026-10-30): read-only "who does this hit, and for how much" for the tile the
-- player is aiming a skill at. Answers only for the unit awaiting a command, one of its own skills,
-- and a tile inside the range the prompt offered (SEC-001: type, range and ownership checked; light
-- rate limit). Never changes game state; the command the player sends on Execute is unchanged.
BattleEvents.PreviewSkillHits.OnServerInvoke = function(plr: any, skillId: any, tileX: any, tileY: any)
	if player and plr ~= player then return { ok = false } end
	if typeof(skillId) ~= "string" or typeof(tileX) ~= "number" or typeof(tileY) ~= "number" then
		return { ok = false }
	end
	local unit = _previewUnit
	if not (unit and unit.isAlive and state and state.units) then return { ok = false } end
	local info = _promptSkillInfo[skillId]
	if not info then return { ok = false } end  -- not one of this unit's offered skills
	tileX, tileY = math.floor(tileX), math.floor(tileY)
	if MAP_WIDTH and MAP_HEIGHT and (tileX < 1 or tileY < 1 or tileX > MAP_WIDTH or tileY > MAP_HEIGHT) then
		return { ok = false }
	end
	local dist = math.max(math.abs(tileX - (unit.tileX or 0)), math.abs(tileY - (unit.tileY or 0)))
	if info.selfTarget then
		if dist ~= 0 then return { ok = false } end
	elseif dist > info.range or dist < info.minRange then
		return { ok = false }
	end
	-- BUG-118 (BUG-HUNT-14): unit-target skill aimed at a tile with no offered target -> no preview.
	if info.targetTiles and not info.targetTiles[tileX .. "," .. tileY] then
		return { ok = false }
	end
	local now = os.clock()
	if now - _lastPreviewClock < 0.05 then return { ok = false, reason = "busy" } end
	_lastPreviewClock = now
	local def = CommandService.GetSkill(skillId)
	if not def then return { ok = false } end
	local ok, entries = pcall(CommandService.PreviewSkillHits, state, unit, def, tileX, tileY)
	if not ok then
		warn("[BattleTurnController] PreviewSkillHits failed for " .. skillId .. ": " .. tostring(entries))
		return { ok = false }
	end
	local result = { ok = true, skillId = skillId, tileX = tileX, tileY = tileY, entries = entries }
	-- Lunge step / Recoil Shot hop (D1 fix 2026-11-08): the tile the caster would end on for THIS aimed tile,
	-- from the same server functions validation and resolution use, so player tile-aim mode can light it
	-- yellow (ARC-001: the client never works the tile out itself). No end tile = nothing extra is drawn.
	if def.stepsToTargetFirst or def.hopsBackAfter then
		local aimed = { tileX = tileX, tileY = tileY }
		local landing = if def.stepsToTargetFirst then CommandService.LungeStepTile(unit, aimed, state)
			else CommandService.RecoilHopTile(unit, aimed, state)
		if landing then
			result.landingTileX = landing.x
			result.landingTileY = landing.y
			result.chargePath = CommandService.ComputeChargePath(unit.tileX, unit.tileY, landing.x, landing.y)
		end
	end
	return result
end

-- TURN-ORDER CHANNEL PEEK (2026-11-10): read-only details of a channel / delayed skill shown in the
-- turn order (caster, skill, target, predicted hits). The entry is already public on the timeline;
-- this adds only what the cast will do. SEC-001: player + type checked, rate limited, no state change.
local _lastPeekClock = 0
BattleEvents.PeekChannel.OnServerInvoke = function(plr: any, casterId: any)
	if player and plr ~= player then return { ok = false } end
	if typeof(casterId) ~= "string" or #casterId > 64 then return { ok = false } end
	local now = os.clock()
	if now - _lastPeekClock < 0.1 then return { ok = false, reason = "busy" } end
	_lastPeekClock = now
	if not (state and state.units) then return { ok = false } end
	local caster
	for _, u in ipairs(state.units) do
		if u.id == casterId then caster = u; break end
	end
	local data = caster and caster.isAlive and caster.isChanneling and caster.channelingData
	if not (data and data.skillDef) then return { ok = false } end
	local castDef = data.skillDef
	local target = data.target
	local result = {
		ok = true,
		casterName = caster.name,
		casterSide = caster.side,
		skillName = castDef.name or "Skill",
		description = castDef.description,
		phase = caster.channelPhase,
		targetName = if target and target ~= caster then target.name elseif target == caster then "Self" else nil,
		targetSide = target and target.side or nil,
	}
	-- Predicted hits on the aimed tile, from the same server preview the aiming UI uses. Base def
	-- (not the stored cast def) so the cast modifiers are not applied twice. Prediction = state NOW;
	-- it can change before the skill lands (units move, HP changes).
	local aimX = data.aimX or (target and target.tileX)
	local aimY = data.aimY or (target and target.tileY)
	local baseDef = castDef.id and CommandService.GetSkill(castDef.id) or nil
	if baseDef and aimX and aimY then
		local okPrev, entries = pcall(CommandService.PreviewSkillHits, state, caster, baseDef, aimX, aimY)
		if okPrev and type(entries) == "table" then
			result.hits = entries
		else
			warn("[BattleTurnController] PeekChannel preview failed for " .. tostring(castDef.id) .. ": " .. tostring(entries))
		end
	end
	return result
end


-- HANDLE CHANNELING ACTIVATION
--------------------------------------------------

local function handleChannelingActivation(activeUnit)
	-- Treasure Hunter "Getaway" (project_rules 231): NPC-only escape channel. Completing it
	-- removes the NPC with its held loot (lost). Resolved here, not in the skill pipeline
	-- (no damage / MP / target), then the shared channel state is cleared as usual.
	if activeUnit.channelingData and activeUnit.channelingData.interactResolve == "hunterGetaway" then
		UnitSchema.ClearChannelState(activeUnit)
		BattleVisualBroadcaster.ChannelEnded(activeUnit)
		-- Release animation (2026-10-28 ruling: Getaway plays like a channel spell). The NPC is
		-- removed right after, so hold briefly (wall-clock only, no CT) to let Big Spell show.
		BattleVisualBroadcaster.ActionAnnounced(activeUnit, "Getaway", "BigSpell")
		task.wait(GETAWAY_RELEASE_PAUSE_SEC)
		BattlefieldEventService.HunterGetawayComplete(activeUnit)
		return {}
	end

	-- Grab skill name before activation clears channeling data
	local channeledSkillName = activeUnit.channelingData
		and activeUnit.channelingData.skillDef
		and (activeUnit.channelingData.skillDef.name or activeUnit.channelingData.skillDef.id)
		or "Unknown"

	local channeledDef = activeUnit.channelingData and activeUnit.channelingData.skillDef
	-- BUG-174 / BUG-185 (batch 15): every unit's statuses before the release, so a "+<status>" below is only
	-- shown when this release really applied it (shared newlyAppliedStatus rule).
	local _chStBefore = {}
	for _, u in ipairs(state.units) do _chStBefore[u] = takeStatusSnapshot(u) end
	-- Job 1 (2026-11-09): hold the release's push / collision visuals until its hits are shown.
	BattleVisualBroadcaster.HoldPushes(true)
	local success, result = CommandService.ActivateChanneledSkill(state, activeUnit)
	BattleVisualBroadcaster.HoldPushes(false)
	-- Job 2 (2026-11-09): the committed-direction override of a tile-origin line (Fissure Line) ends with the cast.
	activeUnit._tileLineFromX = nil
	activeUnit._tileLineFromY = nil
	local actions = {}

	if not success then
		-- Fizzle: target died, MP insufficient, etc.
		-- The reason is text only; a refused object placement returns a table (log showed "table: ...").
		local _reason = if type(result) == "string" then result
			elseif type(result) == "table" and result.placed == false then "the tile is taken"
			elseif type(result) == "table" and type(result.reason) == "string" then result.reason
			else "fizzled"
		BattleVisualBroadcaster.ChannelFizzled(activeUnit, channeledSkillName, _reason)
	elseif result then
		BattleVisualBroadcaster.ChannelEnded(activeUnit)
		-- Resuscitate logs its own detailed line in CommandService (no duplicate).
		if result.type ~= "Resuscitate" then
			if channeledDef and channeledDef.raisesCorpses and (result.hitCount or 0) == 0 then
				-- Raise Dead found no corpse with room to rise; it is not used up (tries again later).
				BattleVisualBroadcaster.Log("channel", `{activeUnit.name}\'s {channeledSkillName or "Raise Dead"} finds no corpse that can rise.`, activeUnit.id)
			else
				BattleVisualBroadcaster.Log("channel", `{activeUnit.name}\'s {channeledSkillName or "skill"} lands.`, activeUnit.id)
			end
		end
		if result.type == "Healing" then
			table.insert(actions, {
				actionType = "Skill", unit = activeUnit, target = result.target,
				skillName = result.skillName, healing = result.healing, damage = 0,
			})
		elseif result.type == "AreaHealing" then
			for _, entry in ipairs(result.targets or {}) do
				table.insert(actions, {
					actionType = "Skill", unit = activeUnit, target = entry.target,
					skillName = result.skillName, healing = entry.healing or 0, damage = entry.damage or 0,
				})
			end
		elseif result.type == "AOE" then
			for _, entry in ipairs(result.targets or {}) do
				-- BUG-141 (BUG-HUNT-26 / BUG-HUNT-13): log the HP the hit really removed (ApplyOutcome's
				-- return: after shields, the 1-per-hit gadget counter, the KO floor), not the rolled
				-- damage. Entries without `dealt` (buffs, swaps, links) keep the old value.
				local _dealt = if entry.dealt ~= nil and entry.outcome and entry.outcome.type == "Damage"
					then entry.dealt else entry.outcome.finalDamage
				-- BUG-174 (batch 14): "+<status>" only when the unit really has it. outcome.appliesStatus is
				-- what the skill tries to apply, so a unit just logged as immune (Petrified / Wardweave Robe)
				-- read "uses Rainfall Zone on X: -0 HP, +Wet".
				-- BUG-174 recurrence (batch 15): HasStatus alone was not enough - a Petrified unit that ALREADY had
				-- Wet (from an earlier enemy Rainfall) was refused this Wet but still read "+Wet" and then "gains
				-- Wet (4 turns)". Now the status must have been newly applied / refreshed by THIS release.
				local _st = entry.outcome.appliesStatus
				if _st and not (entry.target
					and newlyAppliedStatus(entry.target, _chStBefore[entry.target], _st, activeUnit.id) == _st) then
					_st = nil
				end
				table.insert(actions, {
					actionType = "Skill", unit = activeUnit, target = entry.target,
					skillName = result.skillName, damage = _dealt,
					healing = 0, statusApplied = _st,
				})
			end
		elseif result.type == "Damage" then
			table.insert(actions, {
				actionType = "Skill", unit = activeUnit, target = result.target,
				skillName = result.skillName, damage = result.damage,
				-- BUG-185 (batch 15): same rule - only a status this release really applied.
				healing = 0, statusApplied = if result.statusApplied and result.target
					and newlyAppliedStatus(result.target, _chStBefore[result.target], result.statusApplied, activeUnit.id) == result.statusApplied
					then result.statusApplied else nil,
				-- BUG-169 (batch 13): HP right after the hit, before its knockback / wall hit (Overwhelming Blow
				-- logged "-120 HP (45/316)", the HP after the later -11 wall hit). nil = live HP, as before.
				targetHpAfter = result.targetHpAfter,
			})
		end
	end

	-- TWO-TIMER MODEL: do NOT end a turn here. Channel resolution is driven by the
	-- channel deadline (ChannelResolve phase), not by the caster's turn. Phase is
	-- managed by BattleCoordinator.ResolveChannelDeadline in the main loop.

	return actions
end

BattleTurnController.broadcastActions = broadcastActions
BattleTurnController.handleChannelingActivation = handleChannelingActivation
BattleTurnController.runPlayerTurn = runPlayerTurn
BattleTurnController.runAiTurn = runAiTurn

return BattleTurnController
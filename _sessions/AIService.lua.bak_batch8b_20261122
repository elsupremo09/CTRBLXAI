--------------------------------------------------

local function enumerateSkillEntries(unit: any, allUnits: any)
	local skills = {}
	for _, sid in ipairs(unit.skillIds or {}) do
		local def = _CommandService and _CommandService.GetSkill(sid)
		-- Raise Dead has its own priority rule in DecideAction; never scored as a normal skill.
		if def and def.raisesCorpses then
			def = nil
		end
		-- Phase Lock (2026-10-27): never score a relocating skill the unit cannot use.
		if def and _CommandService and _CommandService.IsRelocationBlockedSkill
			and _CommandService.IsRelocationBlockedSkill(unit, def) then
			def = nil
		end
		-- Pinned (rule 253, 2026-11-08): never plan a leap / dash / step skill while Pinned.
		if def and _CommandService and _CommandService.IsPinBlockedSkill
			and _CommandService.IsPinBlockedSkill(unit, def) then
			def = nil
		end
		-- Dual Wield exclusive skills need dual wield active (2026-10-28).
		if def and _CommandService and _CommandService.IsDualWieldBlockedSkill
			and _CommandService.IsDualWieldBlockedSkill(unit, def) then
			def = nil
		end
		-- Blood Price (2026-11-08): never planned at 15% HP or less (validation would reject it).
		if def and _CommandService and _CommandService.IsHpCostBlockedSkill
			and _CommandService.IsHpCostBlockedSkill(unit, def) then
			def = nil
		end
		if def and _UnitSchema and _UnitSchema.HasEnoughMp(unit, skillMpCost(unit, def)) then
			local candidates, candRange = _TargetingService.GetSkillCandidates(unit, allUnits, def)
			-- TAUNT (2026-10-27): debuff / damage skills may only target the taunter.
			if _StatusService and _StatusService.FilterTauntCandidates then
				candidates = _StatusService.FilterTauntCandidates(unit, def, candidates, allUnits, candRange)
			end
			-- Skyfall Lance: only targets the caster can land next to (same rule as validation), so the
			-- AI never picks a cast that is rejected and loses the rest of its turn (UAT 2026-10-27 S-2).
			if candidates and def.leapsAdjacent and _CommandService.CanLeapTo then
				local kept = {}
				local leapState = { units = allUnits }
				for _, c in ipairs(candidates) do
					if c.isGroundTarget or _CommandService.CanLeapTo(unit, c, leapState) then
						table.insert(kept, c)
					end
				end
				candidates = kept
			end
			-- Lunge (2026-11-08): only targets exactly 2 tiles away with a free step tile (same rule as
			-- validation), so the AI never plans a cast that is refused.
			if candidates and def.stepsToTargetFirst and _CommandService.LungeStepTile then
				local kept = {}
				local lungeState = { units = allUnits }
				for _, c in ipairs(candidates) do
					if _CommandService.LungeStepTile(unit, c, lungeState) then
						table.insert(kept, c)
					end
				end
				candidates = kept
			end
			if candidates and #candidates > 0 then
				table.insert(skills, { def = def, candidates = candidates })
			end
		end
	end
	return skills
end


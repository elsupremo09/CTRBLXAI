-- QUICK DRAW (Quiver, 2026-10-29): the unit is out of AP and may make one bonus Basic Attack for
-- MP. Pick the best-scoring basic attack in reach (same scorecard as a normal attack); nil = decline.
function AIService.DecideQuickDrawAttack(unit: any, allUnits: any): any
	if not unit.isAlive or not _TargetingService then return nil end
	if unit.isCaptureTarget then return nil end -- quest goal Capture: the target never attacks (step 5)
	local personality = resolvePersonality(unit, allUnits)
	local dials = DIALS[personality] or DIALS[DEFAULT_PERSONALITY]
	local best, bestScore = nil, 0
	for _, t in ipairs(_TargetingService.GetAttackCandidates(unit, allUnits, unit.weaponMaxRange or 1) or {}) do
		local s = scoreAttack(unit, t, dials, allUnits)
		if s > bestScore then best, bestScore = t, s end
	end
	if not best then return nil end
	return { actionType = "Attack", selection = best, skillName = nil,
		score = bestScore, rtEstimate = 0, tile = nil, targetName = best.name }
end

function AIService.DecideAction(unit: any, allUnits: any, mapW: any, mapH: any, state: any): any
	if not unit.isAlive or (unit.currentAp or 0) <= 0 then return nil end

	local personality = resolvePersonality(unit, allUnits)
	local dials = DIALS[personality] or DIALS[DEFAULT_PERSONALITY]
	local nearest, nearestDist = findNearestEnemy(unit, allUnits)
	if not nearest then return nil end  -- no players left

	-- CHAOS NECROMANCER (user ruling 2026-10-27): its first priority is to channel Raise Dead once
	-- there is at least one corpse to raise. Once per battle; validation refuses any repeat.
	if unit.raisesCorpses and not unit._corpsesRaised and _CommandService
		and not (_StatusService and _StatusService.IsActionBlocked
			and _StatusService.IsActionBlocked(unit, "Skill"))  -- Silenced: act normally this turn
		and _CommandService.CountRaisableCorpses
		and _CommandService.CountRaisableCorpses(unit, allUnits) > 0 then
		local raiseDef = _CommandService.GetSkill("EVT-RAISE-DEAD")
		if raiseDef then
			return { actionType = "Skill",
				selection = { target = unit, skillId = raiseDef.id },
				skillName = raiseDef.name, score = W.ALLY_HELP,
				rtEstimate = 0, tile = nil, targetName = unit.name }
		end
	end

	local moveTiles = _TargetingService.GetMoveCandidates(unit, allUnits, mapW, mapH) or {}

	-- QUEST GOAL Capture (game_flow 41, build step 5 2026-11-17, USER 7:25 PM): the capture target
	-- avoids engaging. A scoring layer on this same brain: it never attacks, casts or uses items; it
	-- moves to the reachable tile that keeps it farthest from hostile units (fewest that could hit it,
	-- no hazards), and ends its turn when no tile is strictly better than where it stands.
	if unit.isCaptureTarget then
		local function minHostileDist(tx: any, ty: any): number
			local best = math.huge
			for _, u in ipairs(allUnits) do
				if u.isAlive and isHostileTo(unit, u) and u.tileX then
					local d = chebyshev(tx, ty, u.tileX, u.tileY)
					if d < best then best = d end
				end
			end
			return best
		end
		local function evadeScore(tx: any, ty: any, pathCost: any): number
			local s = math.min(minHostileDist(tx, ty), 30) * 10 - exposureAt(unit, tx, ty, allUnits) * 15
			if isTileHazardous(tx, ty) then s -= 100 end
			return s - (tonumber(pathCost) or 0) * 0.1
		end
		local bestTile: any, bestScore = nil, evadeScore(unit.tileX, unit.tileY, 0)
		for _, tile in ipairs(moveTiles) do
			local s = evadeScore(tile.tileX, tile.tileY, tile.pathCost)
			if s > bestScore + 0.5 then bestTile, bestScore = tile, s end
		end
		if bestTile then
			return { actionType = "Move", selection = bestTile, skillName = nil,
				score = W.MOVE_TOWARD, rtEstimate = 0, tile = bestTile,
				targetName = string.format("(%d,%d)", bestTile.tileX, bestTile.tileY) }
		end
		return nil -- nothing better: end the turn (never attacks)
	end

	-- QUEST GOAL Activate leash (game_flow 41, build step 7 2026-11-17): while the Activate object is
	-- unused, an Enemy-side unit never ENDS a move more than `leash` tiles (Chebyshev) from it. A unit
	-- outside that radius moves toward it first (true walking distance, same flood fill as the gap
	-- close). Inside, every move option this turn is limited to tiles within the radius, so attacks on
	-- anything in range still happen. A Taunt can't pull a unit past the leash (agent default: the
	-- leash wins, so the goal object can't be left unguarded by taunting). Skills that move the caster
	-- are not limited here (logged limitation).
	local leashed = false
	do
		local qg = state and state.questGoal
		local lr = tonumber((QuestGoalData.Goals :: any).Activate.leash) or 0
		if qg and qg.id == "Activate" and qg.tile and not qg.activated and unit.side == "Enemy" and lr > 0 then
			local ox, oy = qg.tile.x, qg.tile.y
			local here = chebyshev(unit.tileX, unit.tileY, ox, oy)
			-- User ruling 2026-11-17 10:32 PM: outside the radius, a unit with a Player-side target in
			-- attack range from where it stands attacks first (normal action choice below); only with
			-- nothing to hit does it head back. Either way it never ends a move farther out than here.
			local canHitNow = false
			if here > lr then
				local inRange = _TargetingService.GetAttackCandidates(unit, allUnits, unit.weaponMaxRange or 1) or {}
				for _, t in ipairs(inRange) do
					if t and t.isAlive ~= false and t.side and isHostileTo(unit, t) then canHitNow = true break end
				end
			end
			if here > lr and not canHitNow then
				local field = _TargetingService.ComputeDistanceField(ox, oy, mapW, mapH, unit)
				local function od(tx: any, ty: any): number
					local v = field[tostring(tx) .. "," .. tostring(ty)]
					if v ~= nil then return v end
					return chebyshev(tx, ty, ox, oy) + 1000
				end
				local cur = od(unit.tileX, unit.tileY)
				local best: any, bestS = nil, -math.huge
				for _, tile in ipairs(moveTiles) do
					local d = od(tile.tileX, tile.tileY)
					if d < cur then
						local s = -d * 10 - (tile.pathCost or 0) * 0.1
						if isTileHazardous(tile.tileX, tile.tileY) then s -= 100 end
						if s > bestS then best, bestS = tile, s end
					end
				end
				if best then
					return { actionType = "Move", selection = best, skillName = nil,
						score = W.MOVE_TOWARD, rtEstimate = 0, tile = best,
						targetName = string.format("leash (%d,%d)", best.tileX, best.tileY) }
				end
				-- Can't get closer this turn: act normally from here, but never step farther away.
				local kept = {}
				for _, tile in ipairs(moveTiles) do
					if chebyshev(tile.tileX, tile.tileY, ox, oy) <= here then table.insert(kept, tile) end
				end
				moveTiles = kept
			elseif here > lr then
				-- Has a target in range: act normally, but never step farther from the object.
				local kept = {}
				for _, tile in ipairs(moveTiles) do
					if chebyshev(tile.tileX, tile.tileY, ox, oy) <= here then table.insert(kept, tile) end
				end
				moveTiles = kept
			else
				local kept = {}
				for _, tile in ipairs(moveTiles) do
					if chebyshev(tile.tileX, tile.tileY, ox, oy) <= lr then table.insert(kept, tile) end
				end
				moveTiles = kept
			end
			leashed = true
		end
	end

	-- QUEST GOAL Prevent (user ruling 2026-11-17 10:32 PM): ordinary (non-runner) Enemy units never end a
	-- move on the goal tile while any runner is still running, so they can't block the runners.
	-- Runners and Player-side units are unaffected.
	do
		local qg = state and state.questGoal
		if qg and qg.id == "Prevent" and qg.tile and unit.side == "Enemy" and not unit.isRunner then
			local running = false
			for _, u in ipairs(allUnits) do
				if u.isRunner and u.isAlive and not u.reachedGoal and u.side == "Enemy" then running = true break end
			end
			if running then
				local gx, gy = qg.tile.x, qg.tile.y
				local kept = {}
				for _, tile in ipairs(moveTiles) do
					if not (tile.tileX == gx and tile.tileY == gy) then table.insert(kept, tile) end
				end
				moveTiles = kept
			end
		end
	end

	local attackTargets = _TargetingService.GetAttackCandidates(unit, allUnits, unit.weaponMaxRange or 1) or {}
	local skillEntries = enumerateSkillEntries(unit, allUnits)
	-- TAUNT (user ruling 2026-10-27): a Taunted unit closes in on its taunter (attack and
	-- skill candidates are already limited to the taunter).
	local _taunter = _StatusService and _StatusService.GetTaunter and _StatusService.GetTaunter(unit, allUnits)
	if _taunter then
		nearest = _taunter
		nearestDist = chebyshev(unit.tileX, unit.tileY, _taunter.tileX, _taunter.tileY)
	end
	-- QUEST GOAL Protect (step 6): the gap-close move heads for the Guild Courier instead of the
	-- nearest Player unit when it is at most aiMoveSlack tiles farther. Only the advance target
	-- changes (threat / kiting checks still use the nearest unit), and a Taunt still wins.
	local advanceTo: any = nearest
	if not _taunter then
		local slack = tonumber((QuestGoalData.Goals :: any).Protect.aiMoveSlack) or 0
		if slack > 0 then
			for _, u in ipairs(allUnits) do
				if u.isAlive and u.isProtectNpc and u.tileX and isHostileTo(unit, u) then
					if chebyshev(unit.tileX, unit.tileY, u.tileX, u.tileY) <= nearestDist + slack then
						advanceTo = u
					end
					break
				end
			end
		end
	end

	-- QUEST GOAL Prevent (game_flow 41, build step 7 2026-11-17): a runner is a scoring layer on this
	-- same brain. Every turn it takes the reachable tile that gets it closest to the goal tile (true
	-- walking distance), i.e. its full movement toward the tile. Only when no tile gets it closer (the
	-- way is blocked, or it has no movement left) does it hit an adjacent blocker (its best basic
	-- attack on a hostile next to it); failing that it tries to open a route through a blocker object,
	-- else it ends its turn (no stall: nothing is retried). A Taunt still wins (agent default: a
	-- Taunted runner fights its taunter like any unit).
	do
		local qg = state and state.questGoal
		if unit.isRunner and not _taunter and qg and qg.id == "Prevent" and qg.tile then
			local gx, gy = qg.tile.x, qg.tile.y
			local field = _TargetingService.ComputeDistanceField(gx, gy, mapW, mapH, unit)
			local function gd(tx: any, ty: any): number
				local v = field[tostring(tx) .. "," .. tostring(ty)]
				if v ~= nil then return v end
				return chebyshev(tx, ty, gx, gy) + 1000
			end
			local cur = gd(unit.tileX, unit.tileY)
			local best: any, bestS = nil, -math.huge
			for _, tile in ipairs(moveTiles) do
				local d = gd(tile.tileX, tile.tileY)
				if d < cur then
					local s = -d * 10 - (tile.pathCost or 0) * 0.1
					if isTileHazardous(tile.tileX, tile.tileY) then s -= 15 end
					if s > bestS then best, bestS = tile, s end
				end
			end
			if best then
				return { actionType = "Move", selection = best, skillName = nil,
					score = W.MOVE_TOWARD, rtEstimate = 0, tile = best,
					targetName = string.format("run (%d,%d)", best.tileX, best.tileY) }
			end
			local tgt: any, tScore = nil, -math.huge
			for _, t in ipairs(attackTargets) do
				if t.tileX and chebyshev(unit.tileX, unit.tileY, t.tileX, t.tileY) == 1 then
					local s = scoreAttack(unit, t, dials, allUnits)
					if s > tScore then tgt, tScore = t, s end
				end
			end
			if tgt then
				return { actionType = "Attack", selection = tgt, skillName = nil,
					score = tScore, rtEstimate = 0, tile = nil, targetName = tgt.name }
			end
			local obs = AIService.ConsiderObsBreak(unit, allUnits, state, dials)
			if obs then return obs end
			return nil
		end
	end

	----------------------------------------------------------------
	-- Helper: best move tile toward the nearest player (gap close).
	----------------------------------------------------------------
	local function bestMoveToward(): any
		-- PATH-AWARE ADVANCE (true-distance rewrite 2026-10-16).
		-- GetMoveCandidates already returns ONLY tiles this unit can actually reach
		-- this turn (it routes around walls/water/gaps and through allies). The job
		-- here is to pick WHICH reachable tile best closes the gap to the player.
		--
		-- OLD (broken): ranked tiles by chebyshev() straight-line distance to the
		-- player. Straight-line ignores barriers, so when deep water / a wall / a gap
		-- separated the enemy from the player, the "closest-looking" tile was a
		-- dead-end pocket against the barrier. The enemy stepped into it every turn
		-- and never routed around (user report Oct 16 2026).
		--
		-- NEW: measure TRUE walking distance to the player around the terrain, using a
		-- flood-fill from the player's tile (TargetingService.ComputeDistanceField).
		-- A tile on the far side of a barrier now has a genuinely LARGER true distance,
		-- so the tile that actually leads around the barrier (toward the bridge /
		-- chokepoint) wins. Falls back to straight-line only for tiles the field cannot
		-- reach (no walkable route to the player at all), so behavior is never worse.
		local distField = _TargetingService.ComputeDistanceField(advanceTo.tileX, advanceTo.tileY, mapW, mapH, unit) -- BUG-086: honor this unit's climb limits
		local function trueDist(tx: any, ty: any): any
			local v = distField[tostring(tx) .. "," .. tostring(ty)]
			if v ~= nil then return v end
			-- No walkable route to the player from here: fall back to straight-line so
			-- the tile is still comparable (and always worse than any routed tile).
			return chebyshev(tx, ty, advanceTo.tileX, advanceTo.tileY) + 1000
		end
		local curDist = trueDist(unit.tileX, unit.tileY)
		local best: any, bestScore = nil, -math.huge
		for _, tile in ipairs(moveTiles) do
			local d = trueDist(tile.tileX, tile.tileY)
			-- Progress reward: how many steps of TRUE distance closer than standing
			-- still (negative for a tile that is farther around the terrain). Weighted
			-- heavily so any genuine advance beats a lateral/backward tile.
			local progress = curDist - d
			local s = progress * 10 - d
			if isTileHazardous(tile.tileX, tile.tileY) then s = s - 100 end
			s = s - (tile.pathCost or 0) * 0.1
			-- CROSSFIRE-AWARE FOOTSTEP (added 2026-10-16, user design "tie-breaker only,
			-- never costs aggression"): among advance tiles of SIMILAR progress, lean
			-- toward the one where fewer player units can hit us next turn. This is a
			-- pure-reposition path (no attack attached), so it never reduces aggression:
			-- a plain gap-close is the only thing being ranked here. The penalty is
			-- scaled by the unit's EXISTING personality self-danger dial (Aggressive/
			-- Berserker ~0 → ignores danger and charges; Defender/Support > 1 → steps
			-- more carefully). The weight (2 per exposing unit) is deliberately small
			-- relative to the progress term (10 per step closer) so a tile that is
			-- genuinely closer to the target ALWAYS beats a safer-but-farther tile —
			-- danger only decides between tiles that make about the same progress.
			local exposure = exposureAt(unit, tile.tileX, tile.tileY, allUnits)
			s = s - exposure * 2 * (dials.selfDanger or 0)
			-- HIGH-GROUND FOOTSTEP (added 2026-10-16, user design "pure tie-breaker —
			-- never trade progress for terrain"): among advance tiles of SIMILAR
			-- progress, lean toward higher ground, because the game rewards attacking
			-- from above (GameConstants.GetPositionalModifier: +10% damage per elevation
			-- level the attacker stands above the defender). A higher approach tile sets
			-- up a HARDER hit next turn — this serves the bait-and-KO design (more
			-- damage), it is NOT self-preservation.
			--
			-- HARD GUARANTEE (never trade progress for terrain): the whole terrain term
			-- is CAPPED at TERRAIN_TIEBREAK_MAX (4), which is strictly less than the
			-- progress weight (10 per true-step closer). Elevation on CTRBLXAI maps can
			-- reach ~20 on ridge tops, so an uncapped `elev * k` term could rival a step
			-- of progress and let a unit hang back for a tall tile — the cap makes that
			-- impossible: even the tallest tile adds at most 4, so a tile even one step
			-- closer always outranks any higher-but-farther tile. 0.4 per level reaches
			-- the cap at 10 levels of height; below that it scales smoothly. On flat
			-- approaches every tile scores equal here, so this changes nothing; it only
			-- matters where real height lies along the path. Never adds value to Guard/Wait.
			local tileElev = GameConstants.GetElevation(tile.tileX, tile.tileY)
			s = s + math.min(tileElev * 0.4, TERRAIN_TIEBREAK_MAX)
			if s > bestScore then bestScore = s; best = tile end
		end
		if best then
			-- Diagnostic: if the best reachable tile does NOT reduce distance, the
			-- unit is boxed in by allies/terrain — surface it instead of silently
			-- appearing to "freeze" (it is stuck, not crashed).
			local bestDist = trueDist(best.tileX, best.tileY)
			if bestDist >= curDist then
				print(string.format(
					"[AIService] %s cannot advance (boxed): best reachable tile (%d,%d) dist=%d >= current dist=%d — taking best available",
					unit.name, best.tileX, best.tileY, bestDist, curDist))
				-- Activate leash (step 7): a leashed unit with no closer tile inside the radius holds
				-- its ground instead of shuffling sideways or breaking a route out of the radius.
				if leashed then return nil end
				-- Last resort: boxed with no progress — try opening a route by breaking
				-- a blocker-prop OBS object (one-shot solo, or multi-hit if the team can
				-- break it this round). Only replaces the futile move if it finds one.
				local obs = AIService.ConsiderObsBreak(unit, allUnits, state, dials)
				if obs then return obs end
			end
			return { actionType = "Move", selection = best, skillName = nil,
				score = W.MOVE_TOWARD, rtEstimate = 0, tile = best,
				targetName = string.format("(%d,%d)", best.tileX, best.tileY) }
		end
		-- No reachable empty tile at all (fully surrounded): genuinely nothing to do.
		print(string.format(
			"[AIService] %s has NO reachable move tile (fully boxed in) — will Guard/Wait",
			unit.name))
		if leashed then return nil end -- Activate leash (step 7): hold inside the radius
		-- Last resort before giving up: a fully-boxed unit may still open a route
		-- by breaking an in-range OBS object (same worth-it rules as above).
		local obsFB = AIService.ConsiderObsBreak(unit, allUnits, state, dials)
		if obsFB then return obsFB end
		return nil
	end

	----------------------------------------------------------------
	-- Best consumable action right now (items are a normal scored option).
	-- Returns a committable Item action or nil. Uses scoreItem() per slot.
	----------------------------------------------------------------
	local function bestItemAction(u: any, units: any, d: any)
		if not u.consumableSlots then return nil end
		-- AC-014 Bomber Ring (2026-10-29): every item is a bomb (small cross, friendly fire), so the
		-- normal per-item scoring would be wrong (it could "heal" an ally with a bomb). Aim at an enemy
		-- whose cross holds no ally; score = estimated damage to everyone it catches.
		local _bombRange = _CommandService and _CommandService.GetBomberRange and _CommandService.GetBomberRange(u)
		if _bombRange then
			local bombSlot = nil
			for idx = 1, (u.consumableSlotCount or 3) do
				local sl = u.consumableSlots[idx]
				local cd = sl and sl.consumableId and ConsumableData.GetById(sl.consumableId)
				if cd and not cd.parked and _CommandService.ItemSlotHasCharge(units, u, sl) then bombSlot = idx break end  -- AC-019 pool
			end
			if not bombSlot then return nil end
			local power = _CommandService.GetBomberPower(u)
			local bestS, bestT = 0, nil
			for _, c in ipairs(units) do
				if c.isAlive and c.side ~= u.side and c.tileX
					and not (_StatusService and _StatusService.HasStatus(c, "Hide"))
					and chebyshev(u.tileX, u.tileY, c.tileX, c.tileY) <= _bombRange then
					local s, friendly = 0, false
					for _, v in ipairs(units) do
						if v.isAlive and v ~= u and v.tileX
							and math.abs(v.tileX - c.tileX) + math.abs(v.tileY - c.tileY) <= 1 then
							if v.side == u.side then friendly = true break end
							s += (power / math.max(1, v.maxHp or 1)) * W.DAMAGE_PCT * d.damage
							if power >= (v.currentHp or 0) then s += W.KILL_BONUS end
						end
					end
					if not friendly and s > bestS then bestS, bestT = s, c end
				end
			end
			if not bestT then return nil end
			return {
				actionType = "Item",
				selection = { target = bestT, itemSlotIndex = bombSlot },
				skillName = nil, score = bestS, rtEstimate = 0, tile = nil,
				targetName = bestT.name or "tile",
			}
		end
		local bestScore, bestSlot, bestTarget = 0, nil, nil
		for idx = 1, (u.consumableSlotCount or 3) do
			local slot = u.consumableSlots[idx]
			if slot and slot.consumableId and ((slot.currentCharges or 0) > 0
				or (_CommandService and _CommandService.ItemSlotHasCharge(units, u, slot))) then  -- AC-019 pool
				local consDef = ConsumableData.GetById(slot.consumableId)
				if consDef then
					local s, tgt = scoreItem(u, idx, consDef, units, d)
					if tgt and s > bestScore then
						bestScore = s; bestSlot = idx; bestTarget = tgt
					end
				end
			end
		end
		if bestSlot and bestTarget then
			-- Pass the real UNIT OBJECT as target (NOT a coordinate). CommandService
			-- validateItemTarget/resolveItemEffect require a unit (.id for "Self",
			-- .side/.isAlive for ally rules, .maxHp/.maxMp for the heal/MP math).
			-- A bare {tileX,tileY} was rejected → item never committed (Defect #1).
			return {
				actionType = "Item",
				selection = { target = bestTarget, itemSlotIndex = bestSlot },
				skillName = nil, score = bestScore, rtEstimate = 0, tile = nil,
				targetName = bestTarget.name or "self",
			}
		end
		return nil
	end

	----------------------------------------------------------------
	-- (1) BATTLE DISTANCE: farther than 6 tiles → close gap (ignore personality).
	--     Pushed-away recovery: if HP/MP < 35%, recover first.
	----------------------------------------------------------------
	if nearestDist > BATTLE_DISTANCE then
		local hpPct = unit.currentHp / math.max(1, unit.maxHp)
		local mpPct = unit.currentMp / math.max(1, unit.maxMp)
		if hpPct < LOW_RESOURCE_PCT or mpPct < LOW_RESOURCE_PCT then
			-- Pushed-away recovery: if a recovery item is worth using now, use it
			-- before re-engaging. bestItemAction scans equipped consumables.
			local itemAction = bestItemAction(unit, allUnits, dials)
			if itemAction then return itemAction end
		end
		return bestMoveToward()
	end

	----------------------------------------------------------------
	-- (2) KO OVERRIDE: any single action that KOs a player → take it.
	----------------------------------------------------------------
	local koAction: any, koScore = nil, -math.huge
	for _, target in ipairs(attackTargets) do
		local _, predicted = scoreAttack(unit, target, dials, allUnits)
		if predicted >= target.currentHp then
			if predicted > koScore then
				koScore = predicted
				koAction = { actionType = "Attack", selection = target, skillName = nil,
					score = W.KILL_BONUS + predicted, rtEstimate = 0, tile = nil, targetName = target.name }
			end
		end
	end
	for _, entry in ipairs(skillEntries) do
		if not entry.def.isHealing then
			for _, target in ipairs(entry.candidates) do
				-- Skip ground/tile markers: no .side/.currentHp, can't be a KO target.
				if not target.isGroundTarget and isHostileTo(unit, target) then
					local _, predicted = scoreSkill(unit, entry.def, target, dials, allUnits)
					if predicted >= target.currentHp and predicted > koScore then
						koScore = predicted
						koAction = { actionType = "Skill",
							selection = { target = target, skillId = entry.def.id },
							skillName = entry.def.name, score = W.KILL_BONUS + predicted,
							rtEstimate = entry.def.mpCost or 0, tile = nil, targetName = target.name }
					end
				end
			end
		end
	end
	if koAction then return koAction end

	----------------------------------------------------------------
	-- (2b) DEFENDER SELF-HEAL (enemy_ai_personalities rule 4, added 2026-10-18):
	-- "If own HP < 35%, uses a skill or item to self-heal." Prioritized here,
	-- AFTER the KO-override (a guaranteed kill still comes first) but BEFORE normal
	-- scoring, because a hurt Defender's Guard score otherwise outranks a self-heal
	-- and it would guard instead of healing (violating rule 4). Mirrors the
	-- pushed-away recovery pattern. Defender-only; only under LOW_RESOURCE_PCT (35%);
	-- only returns if an actual recovery/self-heal is available, otherwise falls
	-- through to normal scoring (never forces a heal that does not exist). Additive:
	-- changes no other personality and no non-Defender path.
	if personality == "Defender" then
		local hpPct = unit.currentHp / math.max(1, unit.maxHp)
		if hpPct < LOW_RESOURCE_PCT then
			-- (a) a recovery consumable (same primitive as pushed-away recovery).
			local itemAction = bestItemAction(unit, allUnits, dials)
			if itemAction then return itemAction end
			-- (b) a self-targeting healing skill, if the Defender carries one.
			for _, entry in ipairs(skillEntries) do
				if entry.def.isHealing then
					for _, cand in ipairs(entry.candidates) do
						if cand.id == unit.id then
							return { actionType = "Skill",
								selection = { target = unit, skillId = entry.def.id },
								skillName = entry.def.name, score = W.ALLY_HELP,
								rtEstimate = entry.def.mpCost or 0, tile = nil,
								targetName = unit.name }
						end
					end
				end
			end
		end
	end

	----------------------------------------------------------------
	-- (3) ENGAGEMENT STAGING — Aggressive/Skirmisher/Controller only.
	--     Within battle distance but alone (no ally within 3): don't dive.
	--     EXCEPTION (user rule, Sep 28 2026): if the battle is ALREADY ENGAGED —
	--     any other allied enemy is within BATTLE_DISTANCE of a player — then a lone
	--     diver treats it as safe to engage even with no ally within staging range.
	--     The fight is already joined, so a straggler should not hang back.
	----------------------------------------------------------------
	local staging = (personality == "Aggressive" or personality == "Skirmisher" or personality == "Controller")
	if staging
		and countAlliesInRange(unit, allUnits, ALLY_STAGING_RANGE) == 0
		and not battleAlreadyEngaged(unit, allUnits) then
		if isRangedUnit(unit) then
			-- ranged: attack if a target is in range; else move to get in range; else guard
			if #attackTargets > 0 then
				-- fall through to normal scoring (it will pick the attack)
			else
				local mv = bestMoveToward()
				if mv then return mv end
				return { actionType = "Guard", selection = nil, skillName = nil,
					score = scoreGuard(unit, dials), rtEstimate = 0, targetName = "self" }
			end
		else
			-- melee alone (fix Sep 28 2026): the "don't dive alone" rule (19) exists so
			-- a lone melee diver does not suicide-rush the player GROUP — it does NOT
			-- mean stand still. The old code unconditionally returned Guard here, so a
			-- melee unit separated from its group (e.g. clogged out of formation)
			-- Guarded in place turn after turn and looked frozen (observed: Grunt 2/7
			-- parked 6-7 turns). Instead, REGROUP: move toward the nearest ally to
			-- rejoin formation; if there is no ally to regroup with, hold with Guard.
			local nearestAllyTile, nearestAllyDist = nil, math.huge
			for _, u in ipairs(allUnits) do
				if u.isAlive and u.side == unit.side and u.id ~= unit.id then
					local d = chebyshev(unit.tileX, unit.tileY, u.tileX, u.tileY)
					if d < nearestAllyDist then nearestAllyDist = d; nearestAllyTile = u end
				end
			end
			if nearestAllyTile then
				-- Pick the reachable tile that gets closest to the nearest ally.
				-- TRUE-DISTANCE REGROUP (2026-10-16): same barrier-aware fix applied to
				-- player-advance. The old ranking used straight-line chebyshev(tile ->
				-- ally), which — exactly like the player-advance bug — steered a
				-- separated melee unit into a dead-end pocket against deep water / a wall
				-- / a gap when the ally was on the far side of it, so it never actually
				-- rejoined formation. Now rank reachable tiles by TRUE walking distance to
				-- the ally (flood-fill around barriers), falling back to straight-line only
				-- for tiles with no walkable route to the ally.
				local allyField = _TargetingService.ComputeDistanceField(nearestAllyTile.tileX, nearestAllyTile.tileY, mapW, mapH, unit)
				local function allyDist(tx: any, ty: any): any
					local v = allyField[tostring(tx) .. "," .. tostring(ty)]
					if v ~= nil then return v end
					return chebyshev(tx, ty, nearestAllyTile.tileX, nearestAllyTile.tileY) + 1000
				end
				local curToAlly = allyDist(unit.tileX, unit.tileY)
				local regroupBest, regroupScore = nil, -math.huge
				for _, tile in ipairs(moveTiles) do
					local d = allyDist(tile.tileX, tile.tileY)
					local s = (curToAlly - d) * 10 - d
					if isTileHazardous(tile.tileX, tile.tileY) then s = s - 100 end
					s = s - (tile.pathCost or 0) * 0.1
					if s > regroupScore then regroupScore = s; regroupBest = tile end
				end
				if regroupBest then
					print(string.format("[AIService] %s (%s) regrouping toward ally at (%d,%d)",
						unit.name, personality, nearestAllyTile.tileX, nearestAllyTile.tileY))
					return { actionType = "Move", selection = regroupBest, skillName = nil,
						score = W.MOVE_TOWARD, rtEstimate = 0, tile = regroupBest,
						targetName = string.format("regroup (%d,%d)", regroupBest.tileX, regroupBest.tileY) }
				end
			end
			-- No ally to regroup with (or no reachable tile): hold position.
			return { actionType = "Guard", selection = nil, skillName = nil,
				score = scoreGuard(unit, dials), rtEstimate = 0, targetName = "self" }
		end
	end

	----------------------------------------------------------------
	-- (4+5) SCORE ALL LEGAL OPTIONS via scorecard × dials; pick best.
	----------------------------------------------------------------
	local candidates = {}

	for _, target in ipairs(attackTargets) do
		local s = scoreAttack(unit, target, dials, allUnits)
		table.insert(candidates, { actionType = "Attack", selection = target, skillName = nil,
			score = s, rtEstimate = 0, tile = nil, targetName = target.name })
	end

	-- OFFENSIVE PUSH (enemy_ai_personalities rule 25, added 2026-10-17): "value pushing
	-- a target into a hazard tile or off a ledge (fall damage), scored on the total
	-- resulting damage." For each ADJACENT hostile, dry-run the real push resolver to
	-- predict where the shove lands them and how much damage it deals, then score the
	-- push as that damage on the SAME scorecard as a normal attack — so a push only wins
	-- when it out-damages the unit's best swing (e.g. a shove into lava or off a cliff),
	-- and an off-ledge / lethal landing scores as a KILL. Any personality may use it.
	--
	-- Prediction is faithful, not reinvented: it mirrors CommandService's Push exactly —
	-- force = actor.derivedStats.force (default 1), direction via GetPushDirection, and
	-- _DisplacementService.ResolvePush (which is PURE — it returns finalTileX/Y,
	-- fallDamage, wallCollision WITHOUT moving anyone; the commit step applies position).
	-- fall + collision damage come straight from the resolver. A hazardous LANDING tile
	-- (trap/quicksand/lava) is valued as a strong positive signal via isTileHazardous —
	-- the exact per-hazard runtime damage is owned by the tile-effect system, so the
	-- VALUATION of a hazard landing is an estimate (the push itself still resolves
	-- correctly); only the AI's scoring of its worth is approximate. Flagged for Studio.
	-- Guardrails: only ADDS a candidate (never lowers an attack), only pushes hostiles,
	-- KO-override still fires first, and a zero-displacement push is never proposed.
	if _DisplacementService and _DisplacementService.ResolvePush and _DisplacementService.GetPushDirection then
		for _, foe in ipairs(allUnits) do
			if foe.isAlive and isHostileTo(unit, foe)
				and chebyshev(unit.tileX, unit.tileY, foe.tileX, foe.tileY) == 1 then
				local force = 1
				if unit.derivedStats and unit.derivedStats.force then
					force = unit.derivedStats.force
				end
				local direction = _DisplacementService.GetPushDirection(unit, foe)
				local ok, result = pcall(function()
					return _DisplacementService.ResolvePush(
						unit, foe, force, direction,
						GameConstants.KNOCKBACK_SOURCE_MODIFIERS.GlobalPush,
						allUnits, nil)
				end)
				if ok and result and result.pushed then
					-- Damage the resolver itself predicts (fall + wall collision).
					local predicted = (result.fallDamage or 0)
					if result.wallCollision and result.wallCollision.collidedUnitDamage then
						predicted = predicted + result.wallCollision.collidedUnitDamage
					end
					-- Hazard LANDING signal: if the shove ends the target on a hazard tile,
					-- that is a valuable outcome whose exact damage is tile-effect-owned.
					-- Value it as a sizeable fraction of the target's max HP so a hazard
					-- shove competes with (and often beats) a plain attack, without
					-- fabricating a precise hazard-damage number.
					local landsOnHazard = isTileHazardous(result.finalTileX, result.finalTileY)
					local hazardSignal = landsOnHazard and (0.4 * (foe.maxHp or 1)) or 0
					local totalDmg = predicted + hazardSignal
					if totalDmg > 0 then
						local dmgPct = totalDmg / math.max(1, foe.maxHp)
						local pscore = dmgPct * W.DAMAGE_PCT * dials.damage
						-- Lethal shove (fall/collision alone kills, or a chasm off-ledge
						-- landing): score as a KILL, same as a lethal attack.
						if (result.fallDamage or 0) + (result.wallCollision and result.wallCollision.collidedUnitDamage or 0) >= (foe.currentHp or math.huge) then
							pscore = pscore + W.KILL_BONUS
						end
						table.insert(candidates, {
							actionType = "Push", selection = foe, skillName = nil,
							score = pscore, rtEstimate = 0, tile = nil,
							targetName = string.format("push %s", foe.name),
						})
					end
				end
			end
		end
	end

	for _, entry in ipairs(skillEntries) do
		for _, target in ipairs(entry.candidates) do
			local s = scoreSkill(unit, entry.def, target, dials, allUnits)
			table.insert(candidates, { actionType = "Skill",
				selection = { target = target, skillId = entry.def.id },
				skillName = entry.def.name, score = s,
				rtEstimate = entry.def.mpCost or 0, tile = nil, targetName = target.name })
		end
	end

	-- Guard (fallback)
	if not unit.guardUsedThisTurn then
		table.insert(candidates, { actionType = "Guard", selection = nil, skillName = nil,
			score = scoreGuard(unit, dials), rtEstimate = 0, tile = nil, targetName = "self" })
	end

	-- DEFENDER SCREENING MOVE (enemy_ai_personalities rule 4: "moving to positions
	-- that block line of sight to vulnerable allies"). Defender personality only.
	-- For each reachable tile, score it by how many shooter->vulnerable-ally sight
	-- lines the Defender's body would block from there (screenValueAt). This gives a
	-- Defender a protective action to choose over merely Guarding (rule 24 wants a
	-- better-than-Guard option when one exists), and realizes the "block LoS to
	-- vulnerable allies" clause of its locked role. Valued via the Defender's allyHelp
	-- dial so it reads as protection; the KO-override earlier still fires first (a
	-- Defender still takes a guaranteed kill), and this only ADDS a Move candidate —
	-- it never lowers any attack's score, so it cannot reduce aggression.
	if personality == "Defender" then
		local bestScreenTile, bestScreenScore = nil, 0
		for _, tile in ipairs(moveTiles) do
			local blocks = screenValueAt(unit, tile.tileX, tile.tileY, allUnits)
			if blocks > 0 then
				-- Each blocked sight line is worth a share of ALLY_HELP scaled by the
				-- Defender's allyHelp dial. Small hazard/pathCost discouragement reused.
				local s = blocks * W.ALLY_HELP * 0.5 * (dials.allyHelp or 1)
				if isTileHazardous(tile.tileX, tile.tileY) then s = s - 100 end
				s = s - (tile.pathCost or 0) * 0.1
				if s > bestScreenScore then bestScreenScore = s; bestScreenTile = tile end
			end
		end
		if bestScreenTile then
			table.insert(candidates, {
				actionType = "Move", selection = bestScreenTile, skillName = nil,
				score = bestScreenScore, rtEstimate = 0, tile = bestScreenTile,
				targetName = string.format("screen (%d,%d)", bestScreenTile.tileX, bestScreenTile.tileY),
			})
		end
	end

	-- SUPPORT "MOVE BEHIND DEFENDERS" (enemy_ai_personalities rule 5). Support
	-- personality only. Among reachable tiles, prefer one that sits behind an allied
	-- Defender relative to the nearest player (behindDefenderValueAt). This ADDS a
	-- positioning Move option so a Support with nothing better to do tucks in behind
	-- the frontline instead of standing exposed. It never lowers any other option:
	-- the KO-override fires first, and a needed HEAL (Support's real job, rule 5)
	-- scores through its very high allyHelp dial and will outscore this modest
	-- repositioning when an ally actually needs help — so this only governs the
	-- "no one to heal, nothing to attack" case, exactly where rule 5 wants Support
	-- repositioning behind cover.
	if personality == "Support" then
		local bestHideTile, bestHideScore = nil, 0
		for _, tile in ipairs(moveTiles) do
			local v = behindDefenderValueAt(unit, tile.tileX, tile.tileY, nearest, allUnits)
			if v > 0 then
				local s = v * (dials.selfDanger or 1)
				if isTileHazardous(tile.tileX, tile.tileY) then s = s - 100 end
				s = s - (tile.pathCost or 0) * 0.1
				if s > bestHideScore then bestHideScore = s; bestHideTile = tile end
			end
		end
		if bestHideTile then
			table.insert(candidates, {
				actionType = "Move", selection = bestHideTile, skillName = nil,
				score = bestHideScore, rtEstimate = 0, tile = bestHideTile,
				targetName = string.format("cover (%d,%d)", bestHideTile.tileX, bestHideTile.tileY),
			})
		end
	end

	-- Consumable/item use as a normal scored option (decision: items are a
	-- normal choice). Support heals allies here; Aggressive only when it wins.
	local itemAction = bestItemAction(unit, allUnits, dials)
	if itemAction then
		table.insert(candidates, itemAction)
	end

	-- Skirmisher anti-tunnel-vision (rule 26): before chasing a low-HP KO target,
	-- verify remaining AP lets us BOTH move to AND hit it THIS turn. We approximate
	-- "hit this turn" as: a legal move tile puts the target within weapon range,
	-- and we still have AP left to attack after moving (currentAp >= 2). If the
	-- ideal (lowest-HP) target is NOT reachable-and-hittable, we do NOT chase it —
	-- we let normal scoring pick the best target we CAN actually hit.
	if personality == "Skirmisher" and #attackTargets == 0 and (unit.currentAp or 0) >= 2 then
		local wpnRange = unit.weaponMaxRange or 1
		-- lowest-HP enemy that some move tile brings into weapon range this turn
		local bestKO, bestKOHp, bestKOTile = nil, math.huge, nil
		for _, u in ipairs(allUnits) do
			if u.isAlive and isHostileTo(unit, u) then
				for _, tile in ipairs(moveTiles) do
					if chebyshev(tile.tileX, tile.tileY, u.tileX, u.tileY) <= wpnRange then
						if u.currentHp < bestKOHp then
							bestKOHp = u.currentHp; bestKO = u; bestKOTile = tile
						end
						break
					end
				end
			end
		end
		if bestKO and bestKOTile then
			-- Reachable + hittable: move to set up the kill. Borrow the KO/attack value.
			table.insert(candidates, {
				actionType = "Move", selection = bestKOTile, skillName = nil,
				score = W.KILL_BONUS * 0.5 + (1 - bestKOHp / math.max(1, bestKO.maxHp)) * W.LOW_HP_FOCUS * dials.lowHpFocus,
				rtEstimate = 0, tile = bestKOTile,
				targetName = string.format("setup-KO %s", bestKO.name),
			})
		end
	end

	-- Backstab reposition (rule 15) — Aggressive & Skirmisher only. Evaluate moving
	-- to a tile in a target's BACK arc for the facing precision bonus, and compare
	-- that improved-hit value against just attacking now. Only considers move tiles
	-- adjacent to the target (melee backstab); ranged units skip (they already hold
	-- range). Bounded: only checks the current in-range attack targets.
	if (personality == "Aggressive" or personality == "Skirmisher")
		and not isRangedUnit(unit) and (unit.currentAp or 0) >= 2 then
		for _, target in ipairs(attackTargets) do
			local bestTile, bestBonus = nil, 0
			for _, tile in ipairs(moveTiles) do
				if chebyshev(tile.tileX, tile.tileY, target.tileX, target.tileY) == 1 then
					local zone = GameConstants.GetFacingZone(tile.tileX, tile.tileY, target.tileX, target.tileY, target.facing)
					local bonus = GameConstants.GetFacingPrecisionBonus(zone)
					if bonus > bestBonus then bestBonus = bonus; bestTile = tile end
				end
			end
			-- Only propose if repositioning yields a real precision gain (back/side arc).
			if bestTile and bestBonus > 0 then
				local baseScore = scoreAttack(unit, target, dials, allUnits)
				table.insert(candidates, {
					actionType = "Move", selection = bestTile, skillName = nil,
					score = baseScore * (1 + bestBonus),  -- borrow the improved attack it sets up
					rtEstimate = 0, tile = bestTile,
					targetName = string.format("backstab %s", target.name),
				})
			end
		end
	end

	-- GENERAL ONE-STEP LOOK-AHEAD (added 2026-10-16): "a move is worth the attack it
	-- sets up." For EVERY personality (not just Skirmisher's lowest-HP setup-KO case),
	-- consider moving to a reachable tile FROM WHICH the unit could immediately attack
	-- an enemy this same turn, and value that move by the best such attack (via the
	-- shared scoreAttack, so it competes fairly with direct-attack candidates already
	-- in the list). This stops a unit from wasting its turn shuffling forward without
	-- lining up a hit when a reachable tile would have let it move AND strike.
	--
	-- Fidelity: a tile "enables an attack" on an enemy only when the same gates
	-- GetAttackCandidates uses are met FROM THAT TILE — Chebyshev within weapon range,
	-- at or beyond weapon min-range, and clear line of sight (reused via the public
	-- _TargetingService.HasLineOfSight; no targeting logic is reinvented here).
	-- Bounded: requires AP >= 2 (move + attack in one turn), and only iterates
	-- reachable move tiles x living enemies, so cost stays within the AI budget.
	if (unit.currentAp or 0) >= 2 then
		local wpnMax = unit.weaponMaxRange or 1
		local wpnMin = unit.weaponMinRange or 1
		for _, tile in ipairs(moveTiles) do
			local bestFromTile, bestFromScore = nil, -math.huge
			for _, foe in ipairs(allUnits) do
				if foe.isAlive and isHostileTo(unit, foe) then
					local dist = chebyshev(tile.tileX, tile.tileY, foe.tileX, foe.tileY)
					if dist <= wpnMax and dist >= wpnMin then
						local los = _TargetingService.HasLineOfSight(
							tile.tileX, tile.tileY, foe.tileX, foe.tileY,
							allUnits, GameConstants.GetElevation(tile.tileX, tile.tileY),
							unit.weaponProjectileType, unit.side)
						if los then
							-- Value the attack as if the unit were standing on this tile.
							local savedX, savedY = unit.tileX, unit.tileY
							unit.tileX, unit.tileY = tile.tileX, tile.tileY
							local s = scoreAttack(unit, foe, dials, allUnits)
							unit.tileX, unit.tileY = savedX, savedY
							if s > bestFromScore then bestFromScore = s; bestFromTile = foe end
						end
					end
				end
			end
			if bestFromTile then
				-- Slightly discount vs. attacking from where we already stand (a direct
				-- attack this turn is strictly better than move-then-attack when both hit
				-- the same target), so a standing attack wins ties but a setup move still
				-- beats a plain gap-close.
				if isTileHazardous(tile.tileX, tile.tileY) then bestFromScore = bestFromScore - 100 end
				table.insert(candidates, {
					actionType = "Move", selection = tile, skillName = nil,
					score = bestFromScore * 0.95, rtEstimate = 0, tile = tile,
					targetName = string.format("setup-attack %s (%d,%d)", bestFromTile.name, tile.tileX, tile.tileY),
				})
			end
		end
	end

	-- Look-ahead move: a move borrows the score of the best attack it enables.
	-- Simplified: if no attack is currently possible, score a gap-closing move by
	-- how much closer it gets us (melee) / whether it opens a shot (ranged).
	if #attackTargets == 0 then
		local mv = bestMoveToward()
		if mv then
			-- borrow: closer to a target is worth a fraction of an attack
			mv.score = W.MOVE_TOWARD + (1 / math.max(1, nearestDist)) * W.DAMAGE_PCT * dials.damage
			table.insert(candidates, mv)
		end
	end

	-- Wait (always available, always lowest)
	table.insert(candidates, { actionType = "Wait", selection = nil, skillName = nil,
		score = W.WAIT_SCORE, rtEstimate = 0, tile = nil, targetName = "wait" })

	-- Pick highest score. Tie-break: lower RT estimate, then safer resulting tile.
	table.sort(candidates, function(a: any, b: any)
		if math.abs(a.score - b.score) > 0.001 then
			return a.score > b.score
		end
		if (a.rtEstimate or 0) ~= (b.rtEstimate or 0) then
			return (a.rtEstimate or 0) < (b.rtEstimate or 0)
		end
		local ax = a.tile and exposureAt(unit, a.tile.tileX, a.tile.tileY, allUnits) or 0
		local bx = b.tile and exposureAt(unit, b.tile.tileX, b.tile.tileY, allUnits) or 0
		return ax < bx
	end)

	local best = candidates[1]
	if best then
		print(string.format("[AIService] %s (%s) -> %s (%s) score=%.1f",
			unit.name, personality, best.actionType, tostring(best.targetName), best.score))
	end
	return best
end

--------------------------------------------------
-- COMPATIBILITY SHIM
-- Old callers used PlanTurn(...) -> action list. The per-AP turn loop should
-- call DecideAction directly; this shim returns a single-action list so any
-- stray caller still works during the transition.
--------------------------------------------------
function AIService.PlanTurn(unit: any, allUnits: any, mapW: any, mapH: any)
	local action = AIService.DecideAction(unit, allUnits, mapW, mapH)
	if not action then return {} end
	return { action }
end

return AIService

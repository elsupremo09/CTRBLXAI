-- Count living allies (same side, excluding self) within range.
local function countAlliesInRange(unit: any, allUnits: any, range: any)
	local count = 0
	for _, u in ipairs(allUnits) do
		if u.isAlive and u.side == unit.side and u.id ~= unit.id then
			if chebyshev(unit.tileX, unit.tileY, u.tileX, u.tileY) <= range then
				count = count + 1
			end
		end
	end
	return count
end

-- Battle-already-engaged check (added Sep 28 2026, user rule):
-- Returns true if ANY other unit on the acting unit's side is within
-- BATTLE_DISTANCE of ANY enemy (player) unit — i.e. the fight is already joined
-- somewhere. A lone diver may then engage even with no ally within staging range,
-- since it is no longer the one initiating a solo dive. Excludes the acting unit
-- itself so its own proximity does not count as "someone else engaged".
local function battleAlreadyEngaged(unit: any, allUnits: any)
	for _, ally in ipairs(allUnits) do
		if ally.isAlive and ally.side == unit.side and ally.id ~= unit.id then
			for _, foe in ipairs(allUnits) do
				if foe.isAlive and isHostileTo(unit, foe) then
					if chebyshev(ally.tileX, ally.tileY, foe.tileX, foe.tileY) <= BATTLE_DISTANCE then
						return true
					end
				end
			end
		end
	end
	return false
end

-- Count living enemies still standing on a side.
local function countLivingSide(allUnits: any, side: any)
	local n = 0
	for _, u in ipairs(allUnits) do
		if u.isAlive and u.side == side then n = n + 1 end
	end
	return n
end

-- Resolve a unit's personality from its doctrine, with the
-- last-enemy-standing override (sole survivor fights Aggressive).
local function resolvePersonality(unit: any, allUnits: any)
	if countLivingSide(allUnits, unit.side) <= 1 then
		return "Aggressive"
	end
	local p = DOCTRINE_PERSONALITY[unit.doctrineId or ""]
	return p or DEFAULT_PERSONALITY
end

-- Coarse role of a player unit (for profiling-based decisions).
local function _profileRole(u: any)
	local p = DOCTRINE_PERSONALITY[u.doctrineId or ""]
	return ROLE_BY_PERSONALITY[p or ""] or "dealer"
end

local function isRangedUnit(unit: any)
	return (unit.weaponMaxRange or 1) > RANGED_THRESHOLD
end

-- Does target already carry this status (skip redundant re-apply)?
local function hasActiveStatus(target: any, statusId: any)
	if not statusId or not _StatusService then return false end
	return _StatusService.HasStatus(target, statusId) ~= nil
end

-- How many player units could hit `unit` if it ends on (tx,ty)? (self-danger)
local function exposureAt(unit: any, tx: any, ty: any, allUnits: any)
	local count = 0
	for _, u in ipairs(allUnits) do
		if u.isAlive and isHostileTo(unit, u) then
			local range = u.weaponMaxRange or 1
			if chebyshev(tx, ty, u.tileX, u.tileY) <= range then
				count = count + 1
			end
		end
	end
	return count
end

-- Is tile (px,py) ON the straight segment between (ax,ay) and (bx,by)? Used by the
-- Defender screen test: a Defender standing on the sight line between a shooter and
-- a vulnerable ally interposes its body. Walks the Bresenham line from a->b and
-- returns true if (px,py) is one of the interior cells (endpoints excluded — the
-- shooter and ally tiles are not screening positions).
local function _tileOnSegment(px: any, py: any, ax: any, ay: any, bx: any, by: any): boolean
	if (px == ax and py == ay) or (px == bx and py == by) then return false end
	local dx = math.abs(bx - ax)
	local dy = math.abs(by - ay)
	local sx = ax < bx and 1 or -1
	local sy = ay < by and 1 or -1
	local err = dx - dy
	local cx, cy = ax, ay
	while true do
		if cx == bx and cy == by then return false end
		local e2 = 2 * err
		if e2 > -dy then err = err - dy; cx = cx + sx end
		if e2 < dx then err = err + dx; cy = cy + sy end
		if cx == px and cy == py then return true end
	end
end

-- DEFENDER SCREENING (enemy_ai_personalities rule 4: "moving to positions that
-- block line of sight to vulnerable allies"). Judges how much standing on tile
-- (tx,ty) would PROTECT the Defender's vulnerable backline allies by interposing
-- its body on the sight line between a threatening player and that ally.
--
-- "Vulnerable ally" = a living same-side unit (not self) that is a soft backliner:
-- a Support/Controller by role (the healers/casters rule 4 wants shielded) OR any
-- ally currently below 50% HP. "Threatening player" = a living hostile whose weapon
-- could reach the ally if it had LoS (so screening actually denies a real shot).
--
-- Returns a count of (player, ally) sight lines this tile would newly BLOCK: the
-- player has LoS to the ally now (from the player's tile), and placing the Defender
-- on (tx,ty) sits on that line so the Defender's body breaks it. Reuses the public
-- _TargetingService.HasLineOfSight — no LoS logic reinvented. The acting Defender is
-- excluded from the board when testing "LoS now" so we measure the tile's own effect.
local function screenValueAt(self: any, tx: any, ty: any, allUnits: any): any
	if not _TargetingService or not _TargetingService.HasLineOfSight then return 0 end
	-- Build the ally list (vulnerable backliners) and the hostile list once.
	local blocked = 0
	for _, ally in ipairs(allUnits) do
		if ally.isAlive and ally.side == self.side and ally.id ~= self.id then
			local role = _profileRole(ally)
			local lowHp = (ally.currentHp / math.max(1, ally.maxHp)) < 0.5
			-- Vulnerable = a Support-role backliner (the healer/caster rule 4 wants
			-- shielded) OR any ally currently below half HP.
			local vulnerable = (role == "support") or lowHp
			if vulnerable then
				for _, foe in ipairs(allUnits) do
					if foe.isAlive and isHostileTo(self, foe) then
						-- Does this player currently threaten the ally (range) AND see it?
						local foeRange = foe.weaponMaxRange or 1
						local foeToAlly = chebyshev(foe.tileX, foe.tileY, ally.tileX, ally.tileY)
						if foeToAlly <= foeRange + 1 then
							local seesNow = _TargetingService.HasLineOfSight(
								foe.tileX, foe.tileY, ally.tileX, ally.tileY,
								allUnits, GameConstants.GetElevation(foe.tileX, foe.tileY),
								foe.weaponProjectileType, foe.side)
							-- Would the Defender standing on (tx,ty) sit on that sight line?
							-- Approximate "on the line" by: the tile is collinear-ish between
							-- them, i.e. it is no farther from either endpoint than they are
							-- from each other, and blocks the straight path. We test it
							-- directly: place a virtual occupant is overkill; instead check the
							-- tile lies between foe and ally on the Bresenham line by seeing if
							-- it is within 1 tile of that segment at a mid point.
							if seesNow and _tileOnSegment(tx, ty, foe.tileX, foe.tileY, ally.tileX, ally.tileY) then
								blocked = blocked + 1
							end
						end
					end
				end
			end
		end
	end
	return blocked
end

-- SUPPORT POSITIONING (enemy_ai_personalities rule 5: Support "prioritizes moving
-- behind Defenders"). Scores how good tile (tx,ty) is as a Support hiding spot:
-- a tile is "behind a Defender" when a living allied Defender sits BETWEEN that tile
-- and the nearest player — i.e. the Defender is closer to the threat than the tile,
-- and roughly on the line from the tile to that player, so the Defender's body is
-- interposed. Pairs with the Defender screening behavior (Defender blocks the lane;
-- Support tucks in behind it).
--
-- Returns a numeric score (0 = not behind any Defender). Higher when a Defender is
-- well-interposed AND the tile is low-exposure (fewer players can hit it). Reuses
-- _tileOnSegment (shared geometry), _profileRole (to find Defender allies), and
-- exposureAt (safety). The acting Support is `self`; `nearestPlayer` is passed in so
-- the helper does not recompute it per tile.
local function behindDefenderValueAt(self: any, tx: any, ty: any, nearestPlayer: any, allUnits: any): any
	if not nearestPlayer then return 0 end
	local best = 0
	for _, ally in ipairs(allUnits) do
		if ally.isAlive and ally.side == self.side and ally.id ~= self.id
			and _profileRole(ally) == "defender" then
			-- Defender must be between the tile and the player: closer to the player
			-- than the tile is, and on the sight line from the tile to the player.
			local tileToPlayer = chebyshev(tx, ty, nearestPlayer.tileX, nearestPlayer.tileY)
			local defToPlayer  = chebyshev(ally.tileX, ally.tileY, nearestPlayer.tileX, nearestPlayer.tileY)
			if defToPlayer < tileToPlayer
				and _tileOnSegment(ally.tileX, ally.tileY, tx, ty, nearestPlayer.tileX, nearestPlayer.tileY) then
				-- Behind this Defender. Value it, minus a small exposure penalty so the
				-- Support prefers the safest covered tile.
				local exposure = exposureAt(self, tx, ty, allUnits)
				local v = 10 - exposure * 2
				if v > best then best = v end
			end
		end
	end
	return best
end


local function makeText(parent: Instance?, text: string, size: number, color: Color3, bold: boolean?): TextLabel
	local lbl = Instance.new("TextLabel")
	lbl.BackgroundTransparency = 1
	lbl.BorderSizePixel = 0
	lbl.Font = if bold then Theme.Font.PrimaryBold else Theme.Font.Primary
	lbl.TextSize = size
	lbl.TextColor3 = color
	lbl.TextWrapped = true
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.TextYAlignment = Enum.TextYAlignment.Center
	lbl.Text = text
	lbl.ZIndex = 2
	lbl.TextScaled = true
	local fit = Instance.new("UITextSizeConstraint")
	fit.MaxTextSize = size
	fit.MinTextSize = math.min(size, 10) -- 10 px phone floor
	fit.Parent = lbl
	lbl.Parent = parent
	return lbl
end

local function ts(): number return math.max(10, Theme.Text.Small()) end
local function body(): number return math.max(10, Theme.Text.Body()) end

local function corner(parent: Instance, r: UDim?)
	local c = Instance.new("UICorner")
	c.CornerRadius = r or Theme.CornerRadius.sm
	c.Parent = parent
end

local function stroke(parent: Instance, color: Color3, th: number)
	local s = Instance.new("UIStroke")
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Color = color
	s.Thickness = th
	s.Parent = parent
end

local function closeOverlay()
	MerchantPanel.Close(); EventPanel.Close(); PartyPanel.Close(); BagPanel.Close()
	if FacilityInfo then FacilityInfo.Close() end -- ? guide
	MapView.Preview(nil) -- peek preview off (2026-11-17 10:50 AM)
	if overlay then
		overlay:Destroy()
		overlay = nil
	end
	heldCheck() -- deferred: a popup opened right after this wins; otherwise waiting loot shows its pick
end

-- Modal box: lines = { { text, size?, color?, bold? } }; buttons = { { text? | icon?, style?, onTap } }.
local function popup(name: string, lines: { any }, buttons: { any })
	if not screen then return end
	closeOverlay()
	overlayTaps = {}
	-- Shared guild popup box, below the Roblox top bar (2026-11-17 style fix).
	local o, box = GuildScreen.MakeModalBox(name, { maxW = 460, widthScale = 0.8, pad = 14 })
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 4)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = box
	for i, l in lines do
		local lbl = makeText(nil, l[1], l[2] or body(), l[3] or Theme.Colors.TextPrimary, l[4])
		lbl.TextScaled = false
		lbl.TextSize = l[2] or body()
		lbl.Size = UDim2.new(1, 0, 0, 0)
		lbl.AutomaticSize = Enum.AutomaticSize.Y
		lbl.LayoutOrder = i
		lbl.ZIndex = 21
		lbl.Parent = box
	end
	local row = Instance.new("Frame")
	row.Name = "Buttons"
	row.Size = UDim2.new(1, 0, 0, GuildScreen.ROW_H)
	row.BackgroundTransparency = 1
	row.BorderSizePixel = 0
	row.LayoutOrder = 100
	local rl = Instance.new("UIListLayout")
	rl.FillDirection = Enum.FillDirection.Horizontal
	rl.HorizontalAlignment = Enum.HorizontalAlignment.Right
	rl.VerticalAlignment = Enum.VerticalAlignment.Center
	rl.Padding = UDim.new(0, 6)
	rl.SortOrder = Enum.SortOrder.LayoutOrder
	rl.Parent = row
	for i, bt in buttons do
		local b: any
		if bt.icon then
			b = Theme.MakeIconButton(nil, bt.icon, bt.onTap, {
				name = "Btn_" .. bt.icon, size = UDim2.fromOffset(GuildScreen.ROW_H, GuildScreen.ROW_H) })
		else
			b = Theme.MakeBarButton(nil, bt.text, bt.style or "Primary", bt.onTap, {
				name = "Btn_" .. tostring(i), minHeight = GuildScreen.ROW_H })
		end
		b.LayoutOrder = i
		b.Parent = row
		overlayTaps[i] = bt.onTap
	end
	row.Parent = box
	o.Parent = screen.Gui -- parent last (NET-004)
	overlay = o
end

local function act(data: { [string]: any }): any?
	local c = ctx
	if not c then return nil end
	local res = c.action(data)
	if res then
		st = res
		if screen then screen.SetStatus("") end
		heldCheck()
	end
	return res
end

local function nodeOf(id: string?): any
	if not st or not st.run or not id then return nil end
	for _, n in st.run.nodes do
		if n.id == id then return n end
	end
	return nil
end

local function isCleared(id: string): boolean
	if not st or not st.run then return false end
	for _, c in st.run.cleared do
		if c == id then return true end
	end
	return false
end

-- Shown / effective room type: a Mystery that was entered acts as what it became.
local function shownType(n: any): string
	return (n and (n.resolved or n.type)) or "Battle"
end

